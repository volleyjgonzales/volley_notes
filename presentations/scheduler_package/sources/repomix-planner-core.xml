#include "planner_core/schedule_events.hpp"

#include <interfaces/msg/tray_pose_set_manually.hpp>
#include <vrc_interfaces/msg/vrc_state.hpp>

namespace volley {

BoolStringPair ApplyBayCommand(
    const BayCommandMsg& command, unsigned int bay_id, volley::DiscreteGarageState& state) {
  BayStateChangedMsg bay_state_changed {};
  bay_state_changed.bay_id = bay_id;

  auto bay_opt = state.GetBay(bay_id);
  if(!bay_opt.has_value()) {
    return std::make_pair(
        false, std::to_string(volley::BayId(bay_id)) + " does not exist in the discrete garage state!");
  }

  switch(command.command_type) {
  case BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT: {
    bay_state_changed.state_curr = BayReportMsg::STATE_READY_TO_RETRIEVE;
    bay_state_changed.state_next = BayReportMsg::STATE_READY_TO_INSERT;
    return state.OnEvent(bay_state_changed);
  }
  case BayCommandMsg::COMMAND_TYPE_PROCESS_RETRIEVE: {
    auto tray_opt = state.GetTrayOnNode(bay_id);
    if(!tray_opt.has_value()) {
      return std::make_pair(false, "No tray on bay node " + std::to_string(bay_id) +
                                       " so cannot remove payload during process retrieve");
    }

    auto payload_opt = state.GetPayload(tray_opt->payload_id);

    if(!payload_opt) {
      return std::make_pair(false, "Payload " + std::to_string(tray_opt->payload_id) + " On t" +
                                       std::to_string(tray_opt->id) + " doesn't exist in discrete state");
    }

    // After processing a retrieve the bay state will be in Ready to Insert
    bay_state_changed.state_curr = BayReportMsg::STATE_READY_TO_RETRIEVE;
    bay_state_changed.state_next = BayReportMsg::STATE_READY_TO_INSERT;
    auto [success, message] = state.OnEvent(bay_state_changed);
    if(!success) {
      return std::make_pair(success, message);
    }

    PayloadExistenceChangedMsg payload_existence_changed {};
    payload_existence_changed.added = false;
    payload_existence_changed.payload_id = tray_opt->payload_id.bytes;
    payload_existence_changed.tray_id = tray_opt->id;
    payload_existence_changed.mass = payload_opt->payload.mass;
    payload_existence_changed.length_m = payload_opt->payload.length_m;
    payload_existence_changed.width_m = payload_opt->payload.width_m;
    payload_existence_changed.height_m = payload_opt->payload.height_m;
    payload_existence_changed.ev_charge_requested = payload_opt->payload.ev_charge_requested;
    payload_existence_changed.reciprocal_to_tray = payload_opt->reciprocal_to_tray;

    return state.OnEvent(payload_existence_changed);
  }
  case BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE: {
    if(bay_opt->state == BayReportMsg::STATE_READY_TO_INSERT) {
      bay_state_changed.state_curr = BayReportMsg::STATE_READY_TO_INSERT;
    }
    else if(bay_opt->state == BayReportMsg::STATE_VEHICLE_INSERTED) {
      bay_state_changed.state_curr = BayReportMsg::STATE_VEHICLE_INSERTED;
    }
    else {
      return std::make_pair(
          false, "Bay " + std::to_string(bay_id) + " is not in a state that can transition to retrieve");
    }
    bay_state_changed.state_next = BayReportMsg::STATE_READY_TO_RETRIEVE;
    return state.OnEvent(bay_state_changed);
  }
  default:
    break;
  }
  return std::make_pair(
      false, "Failed to apply BayCommand for " + std::to_string(volley::BayId(bay_id)) +
                 " to DiscreteGarageState: Unknown BayCommand type: " + std::to_string(command.command_type));
}

// AgvMove

AgvMove::AgvMove(
    unsigned int job_index, const std::variant<AgvLiftChangedMsg, AgvPoseChangedMsg>& discrete_change) :
    ScheduleEvent(ScheduleEventType::AGV_MOVE, job_index), discrete_change_(discrete_change) {
}

BoolStringPair AgvMove::ApplyTo(volley::DiscreteGarageState& state) const {
  return std::visit(
      [this, &state](auto&& arg) -> BoolStringPair { return state.OnEvent(arg); }, discrete_change_);
}

uint16_t AgvMove::GetAgvId() const {
  return std::visit([](auto&& arg) -> uint16_t { return arg.agv_id; }, discrete_change_);
}

std::optional<GaragePoseMsg> AgvMove::GetSrc() const {
  if(std::holds_alternative<AgvLiftChangedMsg>(discrete_change_)) {
    return std::nullopt;
  }
  auto pose_change = std::get<AgvPoseChangedMsg>(discrete_change_);
  return volley::ConstructGaragePose(pose_change.node_id_curr, pose_change.heading_curr);
}

std::optional<GaragePoseMsg> AgvMove::GetDest() const {
  if(std::holds_alternative<AgvLiftChangedMsg>(discrete_change_)) {
    return std::nullopt;
  }
  auto pose_change = std::get<AgvPoseChangedMsg>(discrete_change_);
  return volley::ConstructGaragePose(pose_change.node_id_next, pose_change.heading_next);
}

// TrayMove

TrayMove::TrayMove(unsigned int job_index) : ScheduleEvent(ScheduleEventType::TRAY_MOVE, job_index) {
}

std::string TrayMove::ToString() const {
  std::string result = ScheduleEvent::ToString();
  result += " Tray ID: ";
  result += (tray_id_ ? std::to_string(*tray_id_) : "Unassigned");
  result += " Dest: ";
  result += (dest_ ? std::to_string(*dest_) : "Unassigned");
  result += " Agv ID: ";
  result += (agv_id_ ? std::to_string(*agv_id_) : "Unassigned");
  return result;
}

BoolStringPair TrayMove::ApplyTo(volley::DiscreteGarageState& state) const {
  if(!GetTrayId().has_value()) {
    // Not sure what to do here yet, there will be a tray at the dest but we don't know
    // which one yet.
    // This is fine for now, but might cause issues with blocking tray calculations
    // for independent tray moves or reasoning about the bay states since there will
    // not be a tray in the bay in the discrete state
    return std::make_pair(true, "");
    // return std::make_pair(false, "Tray ID not set in TrayMove!");
  }
  if(!GetDest().has_value()) {
    // TODO(Gunther): Right now we're removing it, instead we should set it
    // to an invalid pose (or a pose of (0@0)) to indicate that it could be anywhere,
    // but still allow future tasks to see its existence and its payload.
    // Doesn't always matter for tray assignments, since it won't be applied before
    // being assigned

    if(state.GetTray(*GetTrayId())->payload_id != volley::kEmptyGuid) {
      auto payload = state.GetPayload(state.GetTray(GetTrayId().value())->payload_id).value();

      auto payload_existence_changed = volley::Reverse(volley::GetAddEvent(payload));

      auto [success, msg] = state.OnEvent(payload_existence_changed);
      if(!success) {
        return std::make_pair(false, "Failed to remove payload " + std::to_string(payload.payload.id) +
                                         " from DiscreteGarageState: " + msg);
      }
    }

    auto tray_existence_changed =
        volley::Reverse(volley::GetAddEvent(state.GetTray(GetTrayId().value()).value()));

    return state.OnEvent(tray_existence_changed);
  }

  // Move the blocking tray to 0@0. This should really just happen in job planning
  auto blocking_tray_opt = state.GetTrayOnNode(GetDest()->node_id);
  if(blocking_tray_opt.has_value() && GetTrayId().value() != blocking_tray_opt->id) {
    auto blocking_tray = blocking_tray_opt.value();

    interfaces::msg::TrayPoseSetManually tray_pose_changed {};
    tray_pose_changed.tray_id = blocking_tray.id;
    tray_pose_changed.node_id_curr = blocking_tray.pose.node_id;
    tray_pose_changed.heading_curr = blocking_tray.pose.heading;
    tray_pose_changed.node_id_next = 0;
    tray_pose_changed.heading_next = 0;
    // TODO(someone) if a later step of this function fails then we should undo this change.
    // Probably doesn't matter though for how we are using it now
    auto [success, message] = state.OnEvent(tray_pose_changed);
    if(!success) {
      return std::make_pair(success, "Couldn't move blocking tray to 0@0.  " + message);
    }
  }

  // If we don't have an AGV ID, then we are moving the tray magically
  // otherwise, applying and AGV pose change event will move the AGV and the
  // tray
  auto tray_opt = state.GetTray(GetTrayId().value());
  if(!GetAgvId()) {
    if(!tray_opt.has_value()) {
      return std::make_pair(false,
          std::to_string(volley::TrayId(*GetTrayId())) + " does not exist in the discrete garage state!");
    }

    interfaces::msg::TrayPoseSetManually tray_pose_changed {};
    tray_pose_changed.tray_id = tray_opt->id;
    tray_pose_changed.node_id_curr = tray_opt->pose.node_id;
    tray_pose_changed.heading_curr = tray_opt->pose.heading;
    tray_pose_changed.node_id_next = GetDest()->node_id;
    tray_pose_changed.heading_next = GetDest()->heading;
    return state.OnEvent(tray_pose_changed);
  }

  auto agv_opt = state.GetAgv(GetAgvId().value());
  if(!agv_opt.has_value()) {
    return std::make_pair(false,
        std::to_string(volley::AgvId(GetAgvId().value())) + " does not exist in the discrete garage state!");
  }

  if(!volley::IsAngleOrReciprocal(tray_opt->pose, agv_opt->pose)) {
    return std::make_pair(false, "Tray move has assigned AGV but AGV is not at tray pose!");
  }

  if(!agv_opt->lift) {
    return std::make_pair(false, "Tray move has assigned AGV but AGV is not lifted!");
  }

  if(agv_opt->tray_id != GetTrayId().value()) {
    return std::make_pair(false, "Tray move has assigned AGV a" + std::to_string(GetAgvId().value()) +
                                     " but it is not carrying t" + std::to_string(GetTrayId().value()));
  }

  int agv_heading_offset = (tray_opt->pose.heading == agv_opt->pose.heading) ? 0 : 180;

  AgvPoseChangedMsg agv_pose_changed {};
  agv_pose_changed.agv_id = GetAgvId().value();
  agv_pose_changed.node_id_curr = agv_opt->pose.node_id;
  agv_pose_changed.heading_curr = agv_opt->pose.heading;
  agv_pose_changed.node_id_next = GetDest()->node_id;
  agv_pose_changed.heading_next = static_cast<int16_t>(volley::Wrap(GetDest()->heading + agv_heading_offset));

  auto [success, msg] = state.OnEvent(agv_pose_changed);

  if(!success) {
    return std::make_pair(false, "Failed to move  a" + std::to_string(GetAgvId().value()) +
                                     " carrying tray " + std::to_string(GetTrayId().value()) + " to " +
                                     std::to_string(GetDest().value()) + " in DiscreteGarageState: " + msg);
  }

  // TODO(Gunther): Deal with lift states, ie if the agv is lifted, lower it after moving it

  return std::make_pair(true, "");
}

// BayTransition

BayTransition::BayTransition(
    unsigned int job_index, const DiscreteBayStateMsg& src_state, const BayCommandMsg& command) :
    ScheduleEvent(ScheduleEventType::BAY_TRANSITION, job_index), src_state_(src_state), command_(command) {
}

BoolStringPair BayTransition::ApplyTo(volley::DiscreteGarageState& state) const {
  // Make sure the source state matches the discrete bay state in the discrete garage state before
  // applying
  auto bay_opt = state.GetBay(src_state_.id);
  if(!bay_opt.has_value()) {
    return std::make_pair(false,
        std::to_string(volley::BayId(src_state_.id)) + " does not exist in the discrete garage state!");
  }
  if(bay_opt->state != src_state_.state) {
    return std::make_pair(
        false, "Not applying BayTransition: bay states do not match! Src: " + std::to_string(src_state_) +
                   " |Current state: " + std::to_string(bay_opt.value()));
  }

  return ApplyBayCommand(command_, src_state_.id, state);
}

// VecsTransition

VecsTransition::VecsTransition(unsigned int job_index, const VecsStateChangedMsg& state_change) :
    ScheduleEvent(ScheduleEventType::VECS_TRANSITION, job_index), state_change_(state_change) {
}

BoolStringPair VecsTransition::ApplyTo(volley::DiscreteGarageState& state) const {
  return state.OnEvent(state_change_);
}

// VrcTransition

VrcTransition::VrcTransition(unsigned int job_index, const VrcStateChangedMsg& state_change,
    uint32_t from_vrc_node_id, uint32_t to_vrc_node_id) :
    ScheduleEvent(ScheduleEventType::VRC_TRANSITION, job_index),
    state_change_(state_change),
    from_vrc_node_id_(from_vrc_node_id),
    to_vrc_node_id_(to_vrc_node_id) {
}

BoolStringPair VrcTransition::ApplyTo(volley::DiscreteGarageState& state) const {
  // Step 1: IDLE → MOVING (VRC cannot go from IDLE to IDLE at a different floor directly)
  VrcStateChangedMsg step1;
  step1.current_discrete_state = state_change_.current_discrete_state;
  step1.next_discrete_state = state_change_.current_discrete_state;
  step1.next_discrete_state.state.value = vrc_interfaces::msg::VrcState::STATE_MOVING;
  step1.next_discrete_state.requested_floor = state_change_.next_discrete_state.current_floor;
  auto [s1, m1] = state.OnEvent(step1);
  if(!s1) {
    return {false, "VrcTransition (IDLE->MOVING): " + m1};
  }

  // Step 2: MOVING → IDLE at new floor
  VrcStateChangedMsg step2;
  step2.current_discrete_state = step1.next_discrete_state;
  step2.next_discrete_state = state_change_.next_discrete_state;
  auto [s2, m2] = state.OnEvent(step2);
  if(!s2) {
    return {false, "VrcTransition (MOVING->IDLE): " + m2};
  }

  // Teleport any AGV at from_vrc_node_id to to_vrc_node_id
  std::vector<uint16_t> agvs_at_vrc;
  for(const auto& [agv_id, agv] : state.GetAgvs()) {
    if(agv.pose.node_id == from_vrc_node_id_) {
      agvs_at_vrc.push_back(agv_id);
    }
  }
  for(uint16_t agv_id : agvs_at_vrc) {
    auto agv = state.GetAgv(agv_id).value();
    AgvPoseChangedMsg pose_change;
    pose_change.agv_id = agv_id;
    pose_change.node_id_curr = from_vrc_node_id_;
    pose_change.heading_curr = agv.pose.heading;
    pose_change.node_id_next = to_vrc_node_id_;
    pose_change.heading_next = agv.pose.heading;
    auto [s3, m3] = state.OnEvent(pose_change);
    if(!s3) {
      return {false, std::format("VrcTransition AGV teleport for a{}: {}", std::to_string(agv_id), m3)};
    }
  }

  // Teleport remaining trays riding the VRC on their own
  // A tray carried by an AGV is moved by the AgvPoseChangedMsg handling
  std::vector<uint16_t> trays_at_vrc;
  for(const auto& [tray_id, tray] : state.GetTrays()) {
    if(tray.pose.node_id == from_vrc_node_id_) {
      trays_at_vrc.push_back(tray_id);
    }
  }
  for(uint16_t tray_id : trays_at_vrc) {
    auto tray = state.GetTray(tray_id).value();
    TrayPoseSetManuallyMsg pose_change;
    pose_change.tray_id = tray_id;
    pose_change.node_id_curr = from_vrc_node_id_;
    pose_change.heading_curr = tray.pose.heading;
    pose_change.node_id_next = to_vrc_node_id_;
    pose_change.heading_next = tray.pose.heading;
    auto [s4, m4] = state.OnEvent(pose_change);
    if(!s4) {
      return {false, std::format("VrcTransition tray teleport for t{}: {}", std::to_string(tray_id), m4)};
    }
  }

  return {true, ""};
}

