#include "planner_core/event_dag.hpp"

namespace volley {

stdx::Result ScheduleEventDag::ApplyEventsTo(volley::DiscreteGarageState& state) const {
  const auto events = GetEventsInTopologicalOrder();
  if(!events.has_value()) {
    return stdx::Unexpected("The graph must be a DAG.");
  }
  for(const auto& event : *events) {
    if(const auto [success, error] = event->ApplyTo(state); !success) {
      return stdx::Unexpected("Event " + std::to_string(*event) + ": " + error);
    }
  }
  return {};
}

std::optional<std::vector<ScheduleEventSPtr>> ScheduleEventDag::GetEventsInTopologicalOrder() const {
  const auto ordering = GetTopologicalOrdering();
  if(!ordering.has_value()) {
    return std::nullopt;
  }
  std::vector<ScheduleEventSPtr> events;
  events.reserve(ordering->size());
  for(const auto vertex : *ordering) {
    events.push_back(GetEvent(vertex));
  }
  return events;
}

std::vector<ScheduleEventSPtr> ScheduleEventDag::GetLeafEvents() const {
  std::vector<ScheduleEventSPtr> leaf_events;
  for(const auto& vertex : GetLeafVertices()) {
    leaf_events.push_back(GetEvent(vertex));
  }
  return leaf_events;
}

std::vector<ScheduleEventSPtr> ScheduleEventDag::GetRootEvents() const {
  std::vector<ScheduleEventSPtr> root_events;
  for(const auto& vertex : GetRootVertices()) {
    root_events.push_back(GetEvent(vertex));
  }
  std::sort(root_events.begin(), root_events.end(),
      [](const ScheduleEventSPtr& left, const ScheduleEventSPtr& right) {
        return left->GetJobIndex() < right->GetJobIndex();
      });
  return root_events;
}

std::optional<std::vector<ScheduleEventDag::Vertex>> ScheduleEventDag::GetTopologicalOrdering() const {
  std::vector<Vertex> ordering;

  // Min-heap on job index: of the vertices ready at each step, the earliest job's comes first.
  const auto later_job_first = [this](Vertex left, Vertex right) {
    return GetEvent(left)->GetJobIndex() > GetEvent(right)->GetJobIndex();
  };
  std::priority_queue<Vertex, std::vector<Vertex>, decltype(later_job_first)> ready_vertices(later_job_first);

  std::unordered_map<Vertex, size_t> unvisited_parent_count;
  for(const auto& vertex : boost::make_iterator_range(GetVertices())) {
    unvisited_parent_count.insert({vertex, boost::in_degree(vertex, GetBaseGraph())});
    if(boost::in_degree(vertex, GetBaseGraph()) == 0) {
      ready_vertices.push(vertex);
    }
  }

  while(!ready_vertices.empty()) {
    const Vertex vertex = ready_vertices.top();
    ready_vertices.pop();
    ordering.push_back(vertex);
    for(const auto& edge : boost::make_iterator_range(GetOutEdges(vertex))) {
      const Vertex child = GetTargetVertex(edge);
      if(--unvisited_parent_count[child] == 0) {
        ready_vertices.push(child);
      }
    }
  }

  // A cycle leaves its vertices unvisited.
  if(ordering.size() != NumVertices()) {
    return std::nullopt;
  }
  return ordering;
}

}  // namespace volley
