#pragma once

#include <algorithm>
#include <boost/graph/adjacency_list.hpp>
#include <boost/graph/graphviz.hpp>
#include <boost/graph/topological_sort.hpp>
#include <common_ros/print_graph.hpp>
#include <interfaces/msg/action_node.hpp>
#include <interfaces/msg/bay_command.hpp>
#include <interfaces/msg/vecs_command.hpp>
#include <queue>
#include <sstream>
#include <stdx/expected.hpp>
#include <unordered_map>
#include <unordered_set>

#include "planner_core/schedule_events.hpp"

namespace volley {

// A dependency is an edge parent -> child.
template <typename T>
class Dag {
public:
  using Graph = boost::adjacency_list<boost::vecS, boost::vecS, boost::bidirectionalS, std::shared_ptr<T>>;
  using Vertex = typename Graph::vertex_descriptor;
  using Edge = typename Graph::edge_descriptor;
  using Iterator = typename Graph::vertex_iterator;

  Dag() = default;
  virtual ~Dag() = default;
  Dag(Dag const&) = default;
  Dag& operator=(Dag const&) = default;
  Dag(Dag&&) = default;
  Dag& operator=(Dag&&) = default;

  unsigned int NumVertices() const { return boost::num_vertices(graph_); }
  unsigned int NumEdges() const { return boost::num_edges(graph_); }

  bool Has(const std::shared_ptr<T>& node) const { return vertex_by_node_.contains(node); }
  bool HasVertex(const Vertex& vertex) const { return vertex < NumVertices(); }

  bool HasDependency(const std::shared_ptr<T>& parent, const std::shared_ptr<T>& child) const {
    if(!Has(parent) || !Has(child)) {
      return false;
    }
    return boost::edge(vertex_by_node_.at(parent), vertex_by_node_.at(child), graph_).second;
  }
  bool HasDependency(const Vertex& parent, const Vertex& child) const {
    if(!HasVertex(parent) || !HasVertex(child)) {
      return false;
    }
    return boost::edge(parent, child, graph_).second;
  }

  /// Throws std::invalid_argument for a vertex not in the graph.
  std::shared_ptr<T> GetNode(const Vertex& vertex) const {
    if(!HasVertex(vertex)) {
      throw std::invalid_argument("Vertex does not exist: " + std::to_string(vertex));
    }
    return graph_[vertex];
  }
  std::optional<Vertex> GetVertex(const std::shared_ptr<T>& node) const {
    if(!Has(node)) {
      return std::nullopt;
    }
    return vertex_by_node_.at(node);
  }

  Vertex GetSourceVertex(const Edge& edge) const { return boost::source(edge, graph_); }
  Vertex GetTargetVertex(const Edge& edge) const { return boost::target(edge, graph_); }

  const Graph& GetBaseGraph() const { return graph_; }

  // Every vertex after it moves down by one, so vertices held by the caller are invalid afterwards.
  void Remove(const std::shared_ptr<T>& node) {
    const auto vertex_opt = GetVertex(node);
    if(!vertex_opt.has_value()) {
      return;
    }
    const Vertex vertex = vertex_opt.value();
    boost::clear_vertex(vertex, graph_);
    for(auto& [other_node, other_vertex] : vertex_by_node_) {
      if(other_vertex > vertex) {
        --other_vertex;
      }
    }
    boost::remove_vertex(vertex, graph_);
    vertex_by_node_.erase(node);
  }

  std::pair<Iterator, Iterator> GetVertices() const { return boost::vertices(graph_); }

  std::pair<typename Graph::in_edge_iterator, typename Graph::in_edge_iterator> GetInEdges(
      const Vertex& vertex) const {
    if(!HasVertex(vertex)) {
      throw std::invalid_argument("Vertex does not exist: " + std::to_string(vertex));
    }
    return boost::in_edges(vertex, graph_);
  }
  std::pair<typename Graph::out_edge_iterator, typename Graph::out_edge_iterator> GetOutEdges(
      const Vertex& vertex) const {
    if(!HasVertex(vertex)) {
      throw std::invalid_argument("Vertex does not exist: " + std::to_string(vertex));
    }
    return boost::out_edges(vertex, graph_);
  }

  std::optional<Vertex> Add(const std::shared_ptr<T>& node) {
#pragma GCC diagnostic push
// GCC reports boost::optional storage as maybe uninitialized:
// https://github.com/boostorg/function/issues/27, https://gcc.gnu.org/bugzilla/show_bug.cgi?id=106922
#pragma GCC diagnostic ignored "-Wmaybe-uninitialized"
    if(Has(node)) {
      return std::nullopt;
    }
    const Vertex vertex = boost::add_vertex(node, graph_);
    vertex_by_node_[node] = vertex;
    return vertex;
#pragma GCC diagnostic pop
  }

  bool AddDependency(const std::shared_ptr<T>& parent, const std::shared_ptr<T>& child) {
    if(!Has(parent) || !Has(child)) {
      return false;
    }
    return AddDependency(vertex_by_node_.at(parent), vertex_by_node_.at(child));
  }
  bool AddDependency(const Vertex& parent, const Vertex& child) {
    if(!HasVertex(parent) || !HasVertex(child) || HasDependency(parent, child)) {
      return false;
    }
    boost::add_edge(parent, child, graph_);
    return true;
  }

  bool WouldCreateCycle(const Vertex& parent, const Vertex& child) const {
    if(!HasVertex(parent) || !HasVertex(child)) {
      return false;
    }
    if(parent == child) {
      return true;
    }
    std::unordered_set<Vertex> visited {child};
    std::queue<Vertex> to_visit;
    to_visit.push(child);
    while(!to_visit.empty()) {
      const Vertex vertex = to_visit.front();
      to_visit.pop();
      for(const auto& edge : boost::make_iterator_range(boost::out_edges(vertex, graph_))) {
        const Vertex next = boost::target(edge, graph_);
        if(next == parent) {
          return true;
        }
        if(visited.insert(next).second) {
          to_visit.push(next);
        }
      }
    }
    return false;
  }
  bool WouldCreateCycle(const std::shared_ptr<T>& parent, const std::shared_ptr<T>& child) const {
    if(!Has(parent) || !Has(child)) {
      return false;
    }
    return WouldCreateCycle(vertex_by_node_.at(parent), vertex_by_node_.at(child));
  }

  bool Replace(const std::shared_ptr<T>& old_node, const std::shared_ptr<T>& new_node) {
    const auto vertex_opt = GetVertex(old_node);
    if(!vertex_opt.has_value()) {
      return false;
    }
    graph_[vertex_opt.value()] = new_node;
    vertex_by_node_.erase(old_node);
    vertex_by_node_[new_node] = vertex_opt.value();
    return true;
  }

  std::vector<std::shared_ptr<T>> GetChildren(const std::shared_ptr<T>& node) const {
    const auto vertex_opt = GetVertex(node);
    return vertex_opt.has_value() ? GetChildren(vertex_opt.value()) : std::vector<std::shared_ptr<T>> {};
  }
  std::vector<std::shared_ptr<T>> GetChildren(const Vertex& vertex) const {
    std::vector<std::shared_ptr<T>> children;
    if(!HasVertex(vertex)) {
      return children;
    }
    for(const auto& edge : boost::make_iterator_range(boost::out_edges(vertex, graph_))) {
      children.push_back(graph_[boost::target(edge, graph_)]);
    }
    return children;
  }

  std::vector<std::shared_ptr<T>> GetParents(const std::shared_ptr<T>& node) const {
    const auto vertex_opt = GetVertex(node);
    return vertex_opt.has_value() ? GetParents(vertex_opt.value()) : std::vector<std::shared_ptr<T>> {};
  }
  std::vector<std::shared_ptr<T>> GetParents(const Vertex& vertex) const {
    std::vector<std::shared_ptr<T>> parents;
    if(!HasVertex(vertex)) {
      return parents;
    }
    for(const auto& edge : boost::make_iterator_range(boost::in_edges(vertex, graph_))) {
      parents.push_back(graph_[boost::source(edge, graph_)]);
    }
    return parents;
  }

  std::vector<Vertex> GetLeafVertices() const {
    std::vector<Vertex> leaves;
    for(const auto& vertex : boost::make_iterator_range(GetVertices())) {
      if(boost::out_degree(vertex, graph_) == 0) {
        leaves.push_back(vertex);
      }
    }
    return leaves;
  }

  std::vector<Vertex> GetRootVertices() const {
    std::vector<Vertex> roots;
    for(const auto& vertex : boost::make_iterator_range(GetVertices())) {
      if(boost::in_degree(vertex, graph_) == 0) {
        roots.push_back(vertex);
      }
    }
    return roots;
  }

  virtual std::optional<std::vector<Vertex>> GetTopologicalOrdering() const {
    std::vector<Vertex> ordering;
    try {
      // NOLINTNEXTLINE
      boost::topological_sort(graph_, std::back_inserter(ordering));
      std::reverse(ordering.begin(), ordering.end());
    }
    catch(const std::exception&) {
      return std::nullopt;
    }
    return ordering;
  }

  [[nodiscard]] stdx::Result RemoveRedundantEdges() {
    const auto ordering_opt = GetTopologicalOrdering();
    if(!ordering_opt.has_value()) {
      return stdx::Unexpected("The graph must be a DAG.");
    }
    const auto& ordering = ordering_opt.value();
    const size_t vertex_count = NumVertices();

    std::vector<size_t> position(vertex_count);
    for(size_t index = 0; index < vertex_count; ++index) {
      position[ordering[index]] = index;
    }
    // reachable[a][b]: b can be reached from a. Filled from the last vertex of the ordering back.
    std::vector<std::vector<bool>> reachable(vertex_count, std::vector<bool>(vertex_count, false));
    for(auto it = ordering.rbegin(); it != ordering.rend(); ++it) {
      const Vertex vertex = *it;
      for(const auto& edge : boost::make_iterator_range(boost::out_edges(vertex, graph_))) {
        const Vertex child = boost::target(edge, graph_);
        reachable[vertex][child] = true;
        for(size_t other = 0; other < vertex_count; ++other) {
          if(reachable[child][other]) {
            reachable[vertex][other] = true;
          }
        }
      }
    }

    std::vector<Edge> redundant_edges;
    for(const auto& edge : boost::make_iterator_range(boost::edges(graph_))) {
      const Vertex parent = boost::source(edge, graph_);
      const Vertex child = boost::target(edge, graph_);
      for(const auto& other_edge : boost::make_iterator_range(boost::out_edges(parent, graph_))) {
        const Vertex sibling = boost::target(other_edge, graph_);
        if(other_edge != edge && position[sibling] < position[child] && reachable[sibling][child]) {
          redundant_edges.push_back(edge);
          break;
        }
      }
    }
    for(const Edge& edge : redundant_edges) {
      boost::remove_edge(edge, graph_);
    }
    return {};
  }

  void PrintGraph(const std::string& label, rclcpp::Logger logger = rclcpp::get_logger("")) const {
    const char* color = "\033[1;93m";  // High Intensity Yellow
    volley::PrintGraph(label, ToDotFormatString(), logger, color);
  }

protected:
  Graph graph_;
  std::unordered_map<std::shared_ptr<T>, Vertex> vertex_by_node_;

private:
  std::string ToDotFormatString() const {
    const auto graph_writer = [](std::ostream& out) { out << "  rankdir=LR;\n"; };
    const auto vertex_writer = [this](std::ostream& out, const Vertex& vertex) {
      out << " [label=\"" << DotLabel(*graph_[vertex]) << "\"]";
    };
    const auto edge_writer = [](std::ostream&, const Edge&) { };
    std::ostringstream dot;
    boost::write_graphviz(dot, graph_, vertex_writer, edge_writer, graph_writer);
    return dot.str();
  }

  static std::string DotLabel(const interfaces::msg::BayCommand& command) {
    switch(command.command_type) {
    case interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_INSERT:
      return "toInsrt";
    case interfaces::msg::BayCommand::COMMAND_TYPE_PROCESS_RETRIEVE:
      return "PrcsRtrv";
    case interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_RETRIEVE:
      return "toRtrv";
    default:
      return "Unknown BayCommand type: " + std::to_string(command.command_type);
    }
  }
  static std::string DotLabel(const interfaces::msg::VecsCommand& command) {
    switch(command.command_type) {
    case interfaces::msg::VecsCommand::COMMAND_TYPE_START_CHARGING:
      return "Startcharging";
    case interfaces::msg::VecsCommand::COMMAND_TYPE_STOP_CHARGING:
      return "Stopcharging";
    default:
      return "Unknown VecsCommand type: " + std::to_string(command.command_type);
    }
  }
  static std::string DotLabel(const interfaces::msg::ActionNode& node) {
    switch(node.type) {
    case interfaces::msg::ActionNode::TYPE_AGV_COMMAND:
      return std::to_string(volley::AgvId(node.agv_id)) + " ->" +
             std::to_string(node.agv_command.dst.pose.node_id);
    case interfaces::msg::ActionNode::TYPE_BAY_COMMAND:
      return std::to_string(volley::BayId(node.bay_id)) + " " + DotLabel(node.bay_command);
    case interfaces::msg::ActionNode::TYPE_VECS_COMMAND:
      return std::to_string(volley::VecsId(node.vecs_id)) + " " + DotLabel(node.vecs_command);
    case interfaces::msg::ActionNode::TYPE_VRC_COMMAND:
      return std::to_string(volley::VrcId(node.vrc_id)) + " floor->" +
             std::to_string(node.vrc_command.requested_floor);
    default:
      return "Unknown: " + std::to_string(node.type);
    }
  }
  static std::string DotLabel(const volley::ScheduleEvent& event) {
    const auto job_index = std::to_string(event.GetJobIndex());
    switch(event.GetType()) {
    case ScheduleEventType::AGV_MOVE:
      return job_index + "AM";
    case ScheduleEventType::BAY_TRANSITION:
      return job_index + "BT";
    case ScheduleEventType::TRAY_MOVE:
      return job_index + "TM";
    case ScheduleEventType::VECS_TRANSITION:
      return job_index + "VT";
    case ScheduleEventType::VRC_TRANSITION:
      return job_index + "VRT";
    default:
      return job_index + "Unknown event type ";
    }
  }
};

class ScheduleEventDag : public Dag<ScheduleEvent> {
public:
  [[nodiscard]] stdx::Result ApplyEventsTo(volley::DiscreteGarageState& state) const;

  bool AddEvent(const ScheduleEventSPtr& event) { return Add(event).has_value(); }
  ScheduleEventSPtr GetEvent(const Vertex& vertex) const { return GetNode(vertex); }

  std::optional<std::vector<ScheduleEventSPtr>> GetEventsInTopologicalOrder() const;

  std::vector<ScheduleEventSPtr> GetLeafEvents() const;
  std::vector<ScheduleEventSPtr> GetRootEvents() const;

  std::optional<std::vector<Vertex>> GetTopologicalOrdering() const override;
};

}  // namespace volley
