#pragma once
#include <common/enum.hpp>
#include <common/types.hpp>
#include <common_ros/discrete_garage_state.hpp>
#include <common_ros/print_utils.hpp>
#include <interfaces/msg/agv_lift_changed.hpp>
#include <interfaces/msg/agv_pose_changed.hpp>
#include <interfaces/msg/bay_command.hpp>
#include <interfaces/msg/discrete_bay_state.hpp>
#include <interfaces/msg/garage_entity_id.hpp>
#include <interfaces/msg/garage_pose.hpp>
#include <interfaces/msg/vecs_state_changed.hpp>
#include <interfaces/msg/vrc_state_changed.hpp>
#include <optional>
#include <string>
#include <variant>

namespace volley {

BoolStringPair ApplyBayCommand(
    const interfaces::msg::BayCommand& command, unsigned int bay_id, volley::DiscreteGarageState& state);

enum class ScheduleEventType : uint8_t {
  AGV_MOVE = 1,
  BAY_TRANSITION = 2,
  TRAY_MOVE = 3,
  VECS_TRANSITION = 4,
  VRC_TRANSITION = 5,
};

class ScheduleEvent {
private:
  ScheduleEvent& operator=(ScheduleEvent const&) = default;
  ScheduleEvent& operator=(ScheduleEvent&&) = default;

public:
  explicit ScheduleEvent(ScheduleEventType type, unsigned int job_index) :
      type_(type), job_index_(job_index) { }

  ScheduleEvent() = delete;
  virtual ~ScheduleEvent() = default;
  ScheduleEvent(ScheduleEvent&&) = default;
  ScheduleEvent(ScheduleEvent const&) = default;

  virtual BoolStringPair ApplyTo(volley::DiscreteGarageState& state) const = 0;
  virtual std::optional<interfaces::msg::GarageEntityId> GetGarageEntityId() const = 0;
  unsigned int GetJobIndex() const { return job_index_; }
  ScheduleEventType GetType() const { return type_; }

  virtual std::string ToString() const {
    return "Task ID: " + std::to_string(GetJobIndex()) + " " + common::EnumNameString(GetType());
  }

private:
  ScheduleEventType type_;
  unsigned int job_index_;
};

using ScheduleEventSPtr = std::shared_ptr<ScheduleEvent>;

class AgvMove : public ScheduleEvent {
public:
  explicit AgvMove(unsigned int job_index,
      const std::variant<interfaces::msg::AgvLiftChanged, interfaces::msg::AgvPoseChanged>& change);

  const std::variant<interfaces::msg::AgvLiftChanged, interfaces::msg::AgvPoseChanged>& GetDiscreteChange()
      const {
    return discrete_change_;
  }

  uint16_t GetAgvId() const;

  std::optional<interfaces::msg::GarageEntityId> GetGarageEntityId() const override {
    return volley::AgvId(GetAgvId());
  }

  std::optional<interfaces::msg::GaragePose> GetSrc() const;
  std::optional<interfaces::msg::GaragePose> GetDest() const;

  std::string ToString() const override {
    std::string result = ScheduleEvent::ToString();
    result += " Agv ID: ";
    result += std::to_string(GetAgvId());
    std::visit(
        [&result](auto&& arg) { result += " Discrete Change: " + std::to_string(arg); }, discrete_change_);
    return result;
  }

  BoolStringPair ApplyTo(volley::DiscreteGarageState& state) const override;

private:
  std::variant<interfaces::msg::AgvLiftChanged, interfaces::msg::AgvPoseChanged> discrete_change_;
};

// Tray assignment fills in the tray and the destination, AGV assignment the AGV.
class TrayMove : public ScheduleEvent {
public:
  explicit TrayMove(unsigned int job_index);

  std::optional<uint16_t> GetTrayId() const { return tray_id_; }
  void SetTrayId(uint16_t id) { tray_id_ = id; }

  std::optional<interfaces::msg::GarageEntityId> GetGarageEntityId() const override {
    if(tray_id_) {
      return volley::TrayId(GetTrayId().value());
    }
    return std::nullopt;
  }

  std::optional<interfaces::msg::GaragePose> GetDest() const { return dest_; }
  void SetDest(interfaces::msg::GaragePose dest) { dest_ = dest; }

  std::optional<uint16_t> GetAgvId() const { return agv_id_; }
  void SetAgvId(uint16_t id) { agv_id_ = id; }

  BoolStringPair ApplyTo(volley::DiscreteGarageState& state) const override;

  std::string ToString() const override;

private:
  std::optional<uint16_t> tray_id_;
  std::optional<uint16_t> agv_id_;
  std::optional<interfaces::msg::GaragePose> dest_;
};

class BayTransition : public ScheduleEvent {
public:
  explicit BayTransition(unsigned int job_index, const interfaces::msg::DiscreteBayState& src_state,
      const interfaces::msg::BayCommand& command);

  const interfaces::msg::DiscreteBayState& GetSourceState() const { return src_state_; }
  const interfaces::msg::BayCommand& GetCommand() const { return command_; }
  uint16_t GetBayId() const { return src_state_.id; }

  std::optional<interfaces::msg::GarageEntityId> GetGarageEntityId() const override {
    return volley::BayId(GetBayId());
  }

  BoolStringPair ApplyTo(volley::DiscreteGarageState& state) const override;

  std::string ToString() const override {
    std::string result = ScheduleEvent::ToString();
    result += " Bay Id: " + std::to_string(GetBayId());
    result += " State: " + std::to_string(src_state_.state);
    result += " Command: " + std::to_string(command_.command_type);
    return result;
  }

private:
  interfaces::msg::DiscreteBayState src_state_;
  interfaces::msg::BayCommand command_;
};

class VecsTransition : public ScheduleEvent {
public:
  explicit VecsTransition(unsigned int job_index, const interfaces::msg::VecsStateChanged& state_change);

  const interfaces::msg::VecsStateChanged& GetStateChange() const { return state_change_; }
  uint16_t GetVecsId() const { return state_change_.vecs_id; }
  std::optional<interfaces::msg::GarageEntityId> GetGarageEntityId() const override {
    return volley::VecsId(GetVecsId());
  }

  BoolStringPair ApplyTo(volley::DiscreteGarageState& state) const override;

  std::string ToString() const override {
    std::string result = ScheduleEvent::ToString();
    result += " Vecs " + std::to_string(GetVecsId());
    result += " Current state: " + std::to_string(state_change_.state_curr);
    result += " Next state: " + std::to_string(state_change_.state_next);
    return result;
  }

private:
  interfaces::msg::VecsStateChanged state_change_;
};

class VrcTransition : public ScheduleEvent {
public:
  explicit VrcTransition(unsigned int job_index, const interfaces::msg::VrcStateChanged& state_change,
      uint32_t from_vrc_node_id, uint32_t to_vrc_node_id);

  const interfaces::msg::VrcStateChanged& GetStateChange() const { return state_change_; }
  uint16_t GetVrcId() const { return state_change_.current_discrete_state.id; }

  std::optional<interfaces::msg::GarageEntityId> GetGarageEntityId() const override {
    return volley::VrcId(GetVrcId());
  }

  // Two steps: IDLE to MOVING, then MOVING to IDLE at the new floor, with the entities on board.
  BoolStringPair ApplyTo(volley::DiscreteGarageState& state) const override;

  std::string ToString() const override {
    std::string result = ScheduleEvent::ToString();
    result += " Vrc " + std::to_string(GetVrcId());
    result += " floor " + std::to_string(state_change_.current_discrete_state.current_floor);
    result += " -> " + std::to_string(state_change_.next_discrete_state.current_floor);
    return result;
  }

private:
  interfaces::msg::VrcStateChanged state_change_;
  uint32_t from_vrc_node_id_;
  uint32_t to_vrc_node_id_;
};

}  // namespace volley

