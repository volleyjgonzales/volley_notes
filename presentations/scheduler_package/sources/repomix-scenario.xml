from abc import ABC, abstractmethod
import dataclasses
from typing import Callable
from rclpy.client import Client
from rclpy.clock import Clock
from rclpy.task import Future
from rclpy.timer import Timer
from common_py.general_utils import guid_to_string
from interfaces.msg import DiscreteGarageState, DispatchReport, SchedulerJob
from interfaces.srv import SimEvent
from sim_metrics.csv_metrics_utils import SimEventMetrics
@dataclasses.dataclass
class EventContext:
    sim_event_client: Client
    create_timer: Callable[[float, Callable], Timer]
    get_clock: Callable[[], Clock]
    retrieve_req_payload_ids: set[str]
    discrete_garage_state: DiscreteGarageState | None = None
    dispatch_report: DispatchReport | None = None
class EventBase(ABC):
    NAME: str
    UPDATE_TIMER_PERIOD_SEC: float = 1.0
    def __init__(
        self, event_id: int, context: EventContext, job_type: int | None = None
    ):
        self.id: int = event_id
        self._context: EventContext = context
        self._wait_for_job_completion: bool = False
        self._event_handled: bool = False
        self._job_finished: bool = False
        self._job_tracker: SchedulerJobTracker | None = (
            SchedulerJobTracker(context, job_type) if job_type is not None else None
        )
        self._metrics: SimEventMetrics | None = (
            SimEventMetrics(self.NAME, self._context.get_clock().now().nanoseconds)
            if job_type is not None
            else None
        )
        self._update_timer: Timer | None = None
        self._sim_event_future: Future | None = None
        self._sim_event_response: SimEvent.Response | None = None
        self._sim_event_failed: bool = False
        self._has_logged_job: bool = False
        self._has_logged_wait_for_job: bool = False
        self._has_logged_wait_for_event: bool = False
    @abstractmethod
    def _execute(self, event_yaml: dict) -> None: ...
    @abstractmethod
    def _is_event_handled(self) -> bool: ...
    def execute(self, event_yaml: dict) -> None:
        starting_event_msg: str = f"Starting event {self.id}: '{self.NAME}'"
        print(f"\n{starting_event_msg}")
        print("-" * len(starting_event_msg))
        self._update_timer = self._context.create_timer(
            self.UPDATE_TIMER_PERIOD_SEC, self._update
        )
        self._wait_for_job_completion = event_yaml.get("wait_for_job_completion", False)
        self._execute(event_yaml)
    def is_event_handled(self) -> bool:
        return self._event_handled
    def has_job_finished(self) -> bool:
        return self._job_finished
    def did_job_error(self) -> bool:
        if self._job_tracker is None:
            return False
        finished_job = self._job_tracker.get_finished_job()
        return (
            finished_job is not None and finished_job.state == SchedulerJob.STATE_ERROR
        )
    def get_metrics(self) -> SimEventMetrics | None:
        return self._metrics
    def _send_sim_event_request(self, request: SimEvent.Request) -> None:
        self._sim_event_future = self._context.sim_event_client.call_async(request)
    def _poll_sim_event_response(self) -> SimEvent.Response | None:
        if self._sim_event_response is not None:
            return self._sim_event_response
        if self._sim_event_future is None or not self._sim_event_future.done():
            return None
        self._sim_event_response = self._sim_event_future.result()
        if self._sim_event_response is None:
            return None
        if not self._sim_event_response.success:
            print(
                f"Failed to request {self.NAME} sim event: "
                f"{self._sim_event_response.message}"
            )
            self._sim_event_failed = True
        else:
            print(f"Successfully requested {self.NAME} sim event")
        return self._sim_event_response
    def _is_sim_event_response_ready(self) -> bool:
        return self._poll_sim_event_response() is not None
    def _update(self) -> None:
        if self._event_handled and self._job_finished:
            if self._update_timer is not None:
                self._update_timer.cancel()
            return
        # Update _event_handled and _job_finished statuses but only if it is False
        # (no need to check once True)
        self._event_handled = self._event_handled or self._update_event_handled()
        self._job_finished = self._job_finished or self._update_job_finished()
    def _update_event_handled(self) -> bool:
        if not self._is_event_handled():
            if not self._has_logged_wait_for_event:
                self._has_logged_wait_for_event = True
                print(f"Waiting for event {self.id} to be handled")
            return False
        if self._job_tracker is None:
            return True
        tracked_job_guid: str | None = (
            self._job_tracker.get_tracked_job_guid()
            if self._job_tracker.has_new_job_appeared()
            else None
        )
        if tracked_job_guid is None:
            return False
        # Log tracked job for event if we haven't already
        if not self._has_logged_job:
            self._has_logged_job = True
            print(
                f"  Event {self.id} detected new job [guid={self._job_tracker.get_tracked_job_guid()}]"
            )
        if self._wait_for_job_completion:
            if not self._has_logged_wait_for_job:
                self._has_logged_wait_for_job = True
                print(
                    f"Waiting for event {self.id} job to finish [guid={self._job_tracker.get_tracked_job_guid()}]"
                )
            return self._job_tracker.has_job_finished()
        # We have a tracked job and are not waiting for completion, so the event can be
        # considered as handled
        return True
    def _update_job_finished(self) -> bool:
        if self._job_tracker is None:
            return True
        self._job_tracker.update()
        finished_job: SchedulerJob | None = self._job_tracker.get_finished_job()
        if finished_job is not None:
            print(
                f"  Event {self.id} job has finished [guid={self._job_tracker.get_tracked_job_guid()}]"
            )
            if self._metrics:
                self._metrics.update(finished_job)
            return True
        return False
class SchedulerJobTracker:
    """
    Tracks the SchedulerJob created by an event. Captures a snapshot of pre-existing
    jobs of a given type before the event is triggered, then identifies the first new
    job of that type to appear in the dispatch report as belonging to the event.
    """
    def __init__(self, context: EventContext, job_type: int):
        self._context: EventContext = context
        self._job_type: int = job_type
        self._pre_existing_guids: set[str] = set()
        self._tracked_guid: str | None = None
        self._finished_job: SchedulerJob | None = None
        self._snapshot_existing_jobs()
    def has_new_job_appeared(self) -> bool:
        return self._tracked_guid is not None
    def has_job_finished(self) -> bool:
        return self._finished_job is not None
    def get_tracked_job_guid(self) -> str | None:
        return self._tracked_guid
    def get_finished_job(self) -> SchedulerJob | None:
        return self._finished_job
    def update(self) -> None:
        # No need to update if we don't have a dispatch_report or if we already have a
        # _tracked_guid and _finished_job
        if self._context.dispatch_report is None:
            return
        if (self._tracked_guid is not None) and (self._finished_job is not None):
            return
        for job in self._context.dispatch_report.jobs:
            # Skip job if the type does not match our expected job type
            if job.type != self._job_type:
                continue
            guid = guid_to_string(job.guid)
            # Update _tracked_guid if job GUID is new
            if (self._tracked_guid is None) and (guid not in self._pre_existing_guids):
                self._tracked_guid = guid
            # Update _finished_job if we are tracking a job GUID and that job is no
            # longer executing
            if (
                (self._tracked_guid is not None)
                and (guid == self._tracked_guid)
                and (self._finished_job is None)
                and (
                    job.state in [SchedulerJob.STATE_SUCCESS, SchedulerJob.STATE_ERROR]
                )
            ):
                self._finished_job = job
    def _snapshot_existing_jobs(self) -> None:
        if self._context.dispatch_report is None:
            return
        for job in self._context.dispatch_report.jobs:
            if job.type == self._job_type:
                self._pre_existing_guids.add(guid_to_string(job.guid))
</file>

