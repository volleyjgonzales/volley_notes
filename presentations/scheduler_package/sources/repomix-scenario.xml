<file path="scenario/exercise_sim_events.py">
"""
Tool for exercising sim events
"""
import argparse
import os
from pathlib import Path
import rclpy
from rclpy.node import Node
import subprocess
import sys
from common_py.scenario import load_scenario_by_name
from interfaces.msg import (
    DiscreteGarageState,
    DispatchReport,
)
from interfaces.srv import SimEvent
from scenario.events import (
    EventContext,
    EventBase,
    MoveAgvEvent,
    MoveTrayEvent,
    PatronArrivalEvent,
    ReparkTrayEvent,
    RetrieveRequestEvent,
    SleepEvent,
)
from sim_metrics.csv_metrics_utils import SimEventMetrics, SimMetricsWriter
# ROS quality of service profile for best effort subscriptions
QOS_BEST_EFFORT = rclpy.qos.QoSProfile(
    history=rclpy.qos.QoSHistoryPolicy.KEEP_LAST,
    depth=1,
    reliability=rclpy.qos.QoSReliabilityPolicy.BEST_EFFORT,
    durability=rclpy.qos.QoSDurabilityPolicy.VOLATILE,
)
class EventFactory:
    # pylint: disable=too-few-public-methods
    """
    Factory class used to construct specific Event objects based on type name
    """
    _REGISTRY: dict[str, type[EventBase]] = {
        MoveAgvEvent.NAME: MoveAgvEvent,
        MoveTrayEvent.NAME: MoveTrayEvent,
        PatronArrivalEvent.NAME: PatronArrivalEvent,
        ReparkTrayEvent.NAME: ReparkTrayEvent,
        RetrieveRequestEvent.NAME: RetrieveRequestEvent,
        SleepEvent.NAME: SleepEvent,
    }
    @staticmethod
    def create(event_id: int, event_type: str, context: EventContext) -> EventBase:
        event_cls = EventFactory._REGISTRY.get(event_type)
        if event_cls is None:
            raise ValueError(f"Unknown event type: {event_type}")
        return event_cls(event_id, context)
class ExerciseSimEventsNode(Node):
    """
    ROS node that exercises the sim events
    """
    def __init__(self, name: str, events: dict):
        super().__init__(name)
        # A future that stores the execution status of this node. It should only be
        # marked as finished when this node is complete and the simulation can end
        self.executing: rclpy.Future[bool] = rclpy.Future()
        # A list of all events parsed from the events file
        self._all_event_yamls: list[dict] = load_scenario_by_name(events)["events"]
        # All events that have been started
        self._handled_events: list[EventBase] = []
        # Main timer that processes the events on each cycle
        self._check_events_timer = self.create_timer(1, self._check_events)
        # A service client for requesting that sim events get enqueued by the simulator
        self._sim_event_client = self.create_client(
            SimEvent, "/sim/enqueue_garage_event"
        )
        # Subscriber to the discrete garage state to track bay statuses
        self._discrete_garage_state_subscriber = self.create_subscription(
            DiscreteGarageState,
            "/central/discrete_garage_state",
            self._discrete_garage_state_callback,
            QOS_BEST_EFFORT,
        )
        # Subscriber to dispatch report to track when dispatcher is running
        self._dispatch_report_subscriber = self.create_subscription(
            DispatchReport,
            "/central/report",
            self._dispatch_report_callback,
            QOS_BEST_EFFORT,
        )
        # Context to share with all EventBase objects
        self._event_context = EventContext(
            sim_event_client=self._sim_event_client,
            create_timer=self.create_timer,
            get_clock=self.get_clock,
            retrieve_req_payload_ids=set(),
            discrete_garage_state=None,
            dispatch_report=None,
        )
        # Wait for sim event service to exist before starting
        if not self._sim_event_client.wait_for_service(timeout_sec=300):
            print("Timeout waiting for sim event service")
            self.executing.set_result(False)
    def write_metrics(self, output_path: Path):
        """
        Write metrics from all events to a CSV file
        """
        metrics_writer = SimMetricsWriter(output_path)
        for event in self._handled_events:
            metrics: SimEventMetrics | None = event.get_metrics()
            if metrics is not None:
                metrics_writer.events.append(metrics)
        metrics_writer.write_csv()
    def _start_next_event(self) -> None:
        """
        Gets the next event from the YAML, construct it, and executes it
        """
        event_num: int = len(self._handled_events)
        event_yaml: dict = self._all_event_yamls[event_num]
        event_id = event_num + 1
        event: EventBase = EventFactory.create(
            event_id, event_yaml["type"], self._event_context
        )
        event.execute(event_yaml)
        self._handled_events.append(event)
    def _check_events(self):
        """
        Checks the status of the active event and, if finished, starts the next event
        """
        # If we just started up (no active event), wait until the dispatcher is running
        if len(self._handled_events) == 0:
            ready_to_start = (
                (self._event_context.discrete_garage_state is not None)
                and (self._event_context.dispatch_report is not None)
                and (
                    self._event_context.dispatch_report.status
                    == DispatchReport.STATUS_RUNNING
                )
            )
            if ready_to_start:
                self._start_next_event()
            else:
                print("Waiting for dispatcher to start running")
            return
        # Still waiting for current event; check again on next cycle
        if not self._handled_events[-1].is_event_handled():
            return
        # All events have been fired; wait for pending jobs to complete before exiting
        if len(self._handled_events) == len(self._all_event_yamls):
            if all(event.has_job_finished() for event in self._handled_events):
                failed_events_or_none = [
                    e for e in self._handled_events if e.did_job_error()
                ]
                if failed_events_or_none:
                    print(
                        f"{len(failed_events_or_none)} event(s) finished with an error: "
                        + ", ".join(str(e.id) for e in failed_events_or_none)
                    )
                self.executing.set_result(len(failed_events_or_none) == 0)
            return
        # There are more events to handle so start the next event
        self._start_next_event()
    def _discrete_garage_state_callback(self, msg: DiscreteGarageState):
        self._event_context.discrete_garage_state = msg
    def _dispatch_report_callback(self, msg: DispatchReport):
        self._event_context.dispatch_report = msg
def end_simulation():
    """Sends a SIGINT to all running ROS nodes except this process."""
    try:
        subprocess.run(
            f'pgrep -f "ros-args" | grep -v {os.getpid()} | awk \'{{print "kill -2 " $1}}\' | sh',
            shell=True,
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception as e:
        print(f"Error while killing simulation process: {e}")
# Script arguments
parser = argparse.ArgumentParser()
parser.add_argument("-l", "--layout", help="Layout name", type=str, required=True)
parser.add_argument(
    "-e", "--events", help="Scenario file name with events", type=str, required=True
)
parser.add_argument(
    "-o",
    "--output",
    help="Output filename containing metrics",
    type=str,
    required=False,
    default="/tmp/sim_results/events_summary.csv",
)
def main():
    """ROS executable entry function."""
    success = False
    try:
        args = parser.parse_args()
        rclpy.init()
        print(
            f"Exercising sim events with layout {args.layout} and events {args.events}"
        )
        node = ExerciseSimEventsNode("sim_event_exerciser", args.events)
        rclpy.spin_until_future_complete(node, node.executing)
        success = node.executing.result()
        node.write_metrics(Path(args.output))
        print("Ending simulation...")
        end_simulation()
    except Exception as e:
        print(f"Exception while exercising sim events: {e}")
        sys.exit(1)
    sys.exit(0 if success else 1)
if __name__ == "__main__":
    main()
</file>

