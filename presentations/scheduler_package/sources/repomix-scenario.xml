<file path="scenario/events/retrieve_request_event.py">
import random
from common_py.general_utils import guid_to_string, parse_guid
from interfaces.msg import SchedulerJob
from interfaces.srv import SimEvent
from .event_base import EventContext, EventBase
class RetrieveRequestEvent(EventBase):
    NAME = "retrieve_request"
    def __init__(self, event_id: int, context: EventContext):
        super().__init__(event_id, context, SchedulerJob.TYPE_RETRIEVE)
    def _execute(self, event_yaml: dict) -> None:
        request = SimEvent.Request()
        request.type = self.NAME
        request.time = 0.0
        # Get payload ID from YAML or use random payload from garage if not provided
        payload_id_str = event_yaml.get("payload_id", None)
        if payload_id_str is None:
            payload_id_str = self._get_random_payload_id_from_garage()
            self._context.retrieve_req_payload_ids.add(payload_id_str)
        request.payload.id = parse_guid(payload_id_str)
        print(
            f"Requesting {self.NAME}: payload_id={guid_to_string(request.payload.id)}"
        )
        self._send_sim_event_request(request)
    def _is_event_handled(self) -> bool:
        return self._is_sim_event_response_ready()
    def _get_random_payload_id_from_garage(self) -> str:
        if self._context.discrete_garage_state is None:
            raise ValueError(
                f"Cannot execute {self.NAME} event with random payload ID as no discrete_garage_state received yet"
            )
        candidates: list[str] = []
        for payload_state in self._context.discrete_garage_state.payloads:
            payload_id_str = guid_to_string(payload_state.payload.id)
            if payload_id_str not in self._context.retrieve_req_payload_ids:
                candidates.append(payload_id_str)
        if not candidates:
            raise ValueError(
                f"Cannot execute {self.NAME} event as there are no more valid payloads"
            )
        return random.choice(candidates)
</file>

<file path="scenario/events/sleep_event.py">
import time
from .event_base import EventContext, EventBase
class SleepEvent(EventBase):
    NAME = "sleep"
    def __init__(self, event_id: int, context: EventContext):
        super().__init__(event_id, context)
        self._end_time: float = 0.0
    def _execute(self, event_yaml: dict) -> None:
        duration_sec = float(event_yaml.get("duration", 0.0))
        self._end_time = time.monotonic() + duration_sec
        if duration_sec > 0:
            print(f"Sleeping for {duration_sec} seconds...")
    def _is_event_handled(self) -> bool:
        return time.monotonic() >= self._end_time
