from rclpy.timer import Timer
from common_py.general_utils import guid_to_string, parse_guid, random_guid
from interfaces.msg import BayReport, DiscreteBayState, SchedulerJob
from interfaces.srv import SimEvent
from .event_base import EventContext, EventBase
# Default payload attributes
DEFAULT_PAYLOAD_MASS_KG: float = 1500.0
DEFAULT_PAYLOAD_LENGTH_M: float = 4.5
DEFAULT_PAYLOAD_WIDTH_M: float = 2.0
DEFAULT_PAYLOAD_HEIGHT_M: float = 1.4
class PatronArrivalEvent(EventBase):
    NAME = "patron_arrival"
    CHECK_BAY_TIMER_PERIOD_SEC: float = 1.0
    def __init__(self, event_id: int, context: EventContext):
        super().__init__(event_id, context, SchedulerJob.TYPE_INSERT)
        self._complete: bool = False
        self._event_yaml: dict | None = None
        self._bays_for_insertion: list[DiscreteBayState] = []
        self._check_bay_timer: Timer | None = None
    def _execute(self, event_yaml: dict) -> None:
        self._event_yaml = event_yaml
        print("Waiting for a bay to be ready for insertion...")
        self._check_bay_timer = self._context.create_timer(
            self.CHECK_BAY_TIMER_PERIOD_SEC, self._check_bay
        )
    def _is_event_handled(self) -> bool:
        return self._complete
    def _get_ready_to_insert_bays(self) -> list[DiscreteBayState]:
        bays: list[DiscreteBayState] = []
        if self._context.discrete_garage_state is not None:
            for bay in self._context.discrete_garage_state.bays:
                if bay.state == BayReport.STATE_READY_TO_INSERT:
                    bays.append(bay)
        return bays
    def _request_insert(self):
        request = SimEvent.Request()
        request.type = self.NAME
        request.time = 0.0
        payload_id_str = self._event_yaml.get("payload_id")
        request.payload.id = (
            random_guid() if payload_id_str is None else parse_guid(payload_id_str)
        )
        request.payload.mass = self._event_yaml.get("mass", DEFAULT_PAYLOAD_MASS_KG)
        request.payload.length_m = self._event_yaml.get(
            "length_m", DEFAULT_PAYLOAD_LENGTH_M
        )
        request.payload.width_m = self._event_yaml.get(
            "width_m", DEFAULT_PAYLOAD_WIDTH_M
        )
        request.payload.height_m = self._event_yaml.get(
            "height_m", DEFAULT_PAYLOAD_HEIGHT_M
        )
        print(
            f"Requesting {self.NAME}: payload_id={guid_to_string(request.payload.id)}"
        )
        self._send_sim_event_request(request)
    def _check_bay(self):
        # The insert request has already been sent, nothing left to do
        if self._complete:
            return
        # Check if any bay is ready for insertion
        if len(self._bays_for_insertion) == 0:
            self._bays_for_insertion = self._get_ready_to_insert_bays()
            # If a bay is ready for insertion, send request
            if self._bays_for_insertion:
                print("A bay is ready for insertion")
                self._request_insert()
            return
        # Still waiting for response from enqueue sim event service
        if not self._is_sim_event_response_ready():
            print(f"Waiting for {self.NAME} sim event response")
            return
        # Loop through the bays that were ready for insertion and check if any have
        # transitioned to a new state (signaling the bay is handling the insert)
        for bay_for_insertion in self._bays_for_insertion:
            for discrete_bay in self._context.discrete_garage_state.bays:
                if bay_for_insertion.id == discrete_bay.id:
                    if discrete_bay.state != BayReport.STATE_READY_TO_INSERT:
                        print(f"Bay {discrete_bay.id} is processing the insertion")
                        self._check_bay_timer.cancel()
                        self._complete = True
