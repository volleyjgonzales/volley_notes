<file path="setup.py">
import os
from glob import glob
from setuptools import setup
package_name = "scenario"
setup(
    name=package_name,
    version="0.0.1",
    packages=[package_name, package_name + ".events"],
    data_files=[
        # Install marker file in the package index
        ("share/ament_index/resource_index/packages", ["resource/" + package_name]),
        # Include our package.xml file
        ("share/" + package_name, ["package.xml"]),
        # Include all scenario files.
        (
            os.path.join("share", package_name, "scenarios"),
            glob(os.path.join("scenarios", "*.yaml")),
        ),
    ],
    install_requires=["setuptools"],
    zip_safe=True,
    maintainer="dev",
    maintainer_email="sw@volleyautomation.com",
    description="Methods and nodes related to scenarios",
    license="proprietary",
    extras_require={
        "test": [
            "pytest",
        ],
    },
    entry_points={
        "console_scripts": [
            "exercise_sim_events = scenario.exercise_sim_events:main",
        ],
    },
)
</file>

