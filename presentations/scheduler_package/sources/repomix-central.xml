#include "central/execution_state.hpp"

#include <common_ros/collision_geometry.hpp>
#include <common_ros/discrete_garage_event_io.hpp>
#include <iostream>
#include <unordered_map>

namespace volley {

// clang-format off
ExecutionStateStringPair CreateExecutionStatePtr(
    const volley::DiscreteGarageState& garage_state,
    PoseGraphCSPtr pose_graph,
    CommandSendSPtr command_send,
    const volley::GarageGraph& gg,
    const volley::CollisionTable& collision_table) {
// clang-format off
  auto [exec_state_opt, message] = CreateExecutionGarageState(garage_state, pose_graph);
  if(!exec_state_opt.has_value()) {
    return {nullptr, message };
  }
  return { std::make_shared<ExecutionState>(exec_state_opt.value(), command_send, gg, collision_table), "" };
}

// clang-format off
ExecutionStateStringPair CreateExecutionStatePtr(
    const ExecutionGarageState& exec_state_latest,
    const Schedule& existing_schedule,
    std::vector<ActionNodeMsg> response_nodes,
    CommandSendSPtr command_send,
    const volley::GarageGraph& gg,
    const volley::CollisionTable& collision_table) {
// clang-format off
  // Construct a new execution state based on the given latest state
  ExecutionStateSPtr exec_state = std::make_shared<ExecutionState>(exec_state_latest, command_send, gg, collision_table);

  // Construct our new schedule.
  // Update our future execution garage state by applying the schedule.
  Schedule& new_schedule = exec_state->schedule_;
  ExecutionGarageState& new_exec_state_future = exec_state->exec_state_future_;

  // Note that, as we go, we update any AGV commands to contain the correct src and dst values.
  // Note that nodes are in a valid topological order.
  unsigned int n_nodes_in_response = response_nodes.size();
  for(unsigned int node_index = 0; node_index < n_nodes_in_response; node_index++) {
    // Note that we may modify the node
    ActionNodeMsg& node = response_nodes.at(node_index);

    // If this is an existing node, only include it if it is incomplete.
    // We do not send completed nodes to the planner, but it is possible that we
    // complete a node between sending a plan request and receiving the plan response.
    auto existing_node_index_opt = existing_schedule.GetNodeByGuid(node.guid);
    if(existing_node_index_opt.has_value() &&
        existing_schedule.IsNodeCompleted(existing_node_index_opt.value())) {
      continue;
    }

    // Update the parent indices to be with respect to the new schedule, and drop
    // indices of any completed parents.
    std::vector<uint32_t> new_parents;
    for(unsigned int node_index_parent_in_resp : node.parents) {
      if(node_index_parent_in_resp >= node_index) {
        return std::make_pair(nullptr, "Node " + std::to_string(node_index) +
                                                " had invalid parent index " +
                                                std::to_string(node_index_parent_in_resp));
      }

      // If we fail to find the GUID, that means the node was dropped for being completed
      const auto& parent_guid = response_nodes.at(node_index_parent_in_resp).guid;
      auto node_index_parent_in_new = new_schedule.GetNodeByGuid(parent_guid);
      if(node_index_parent_in_new.has_value()) {
        new_parents.emplace_back(node_index_parent_in_new.value());
      }
    }
    node.parents = new_parents;

    // If the node is an AGV command, update its src / dst entries to be consistent with the
    // future state. We do not receive the full src/dst from the planner.
    if(node.type == ActionNodeMsg::TYPE_AGV_COMMAND) {
      auto agv_opt = new_exec_state_future.GetGarageState().GetAgv(node.agv_id);
      if(!agv_opt.has_value()) {
        return std::make_pair(nullptr, "Failed to look up a" + std::to_string(node.agv_id) +
                                                " while adjusting new node " + std::to_string(node.guid));
      }

      if(node.agv_command.dst.lift != node.agv_command.src.lift) {
        // lift command - match the poses
        node.agv_command.src.pose = agv_opt->pose;
        node.agv_command.dst.pose = agv_opt->pose;
      }
      else {
        // move command - match the lift state
        node.agv_command.src.lift = agv_opt->lift;
        node.agv_command.dst.lift = agv_opt->lift;
      }
    }

    // Add the node to our schedule, maintaining its status in case it has been received or
    // completed since the plan call finished. This will be INCOMPLETE if the node is new
    node.status = ActionNodeMsg::STATUS_NOT_RECEIVED;
    if(existing_node_index_opt.has_value()) {
      node.status = existing_schedule.GetNodeStatus(existing_node_index_opt.value());
    }

    // TODO(Gunther): We probably need a "SENT" status here to capture cases
    // where the node is sent, but not received but the safety checker still
    // needs to behave as if an entity could be in the process of executing the node.
    if(node.status == ActionNodeMsg::STATUS_RECEIVED) {
      auto [success, message] =
          exec_state->safety_checker_->Apply(node, exec_state->exec_state_latest_.GetGarageState());
      if(!success) {
        return std::make_pair(nullptr, "Failed to apply " + std::to_string(node_index) + "th node " +
                                                std::to_string(node.guid) +
                                                " to our safety checker: " + message);
      }
      // std::cout << "Safety Checker Applied: " << std::to_string(node) << std::endl;
    }

    auto [success, message] = new_schedule.Append(node);
    if(!success) {
      return std::make_pair(nullptr, "Failed to append " + std::to_string(node_index) + "th node " +
                                              std::to_string(node.guid) + " to our schedule: " + message);
    }

    // Apply the node to our future state
    std::tie(success, message) = new_exec_state_future.Apply(node);
    if(!success) {
      return std::make_pair(nullptr, "Failed to apply " + std::to_string(node_index) + "th node " +
                                              std::to_string(node.guid) +
                                              " to our future execution state: " + message);
    }
  }

  exec_state->CoalesceMotionBatches();

  // Success!
  return { exec_state, "" };
}


// clang-format off
ExecutionState::ExecutionState(
  const ExecutionGarageState& exec_garage_state,
