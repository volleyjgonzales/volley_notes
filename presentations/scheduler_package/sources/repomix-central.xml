#pragma once
#include <central/central_msgs.hpp>
#include <common_ros/roslog.hpp>
#include <functional>
#include <unordered_map>

namespace volley {

// Monitors the continuous garage state.
// Disables any AGVs whose batteries drop too low.
class AgvMonitor {
public:
  AgvMonitor(double low_agv_battery_fraction_threshold,
      const std::function<void(SetResourceDisablednessSrv::Request::SharedPtr)> disable_agv,
      const rclcpp::Logger& logger);

  // Process the garage info
  void SetContinuousGarageInfo(ContinuousGarageInfoMsg::UniquePtr info);

  // Store the latest discrete garage state
  void SetDiscreteGarageState(DiscreteGarageStateMsg::UniquePtr state);

private:
  // Any AGVs below this battery fraction will be disabled.
  double low_agv_battery_fraction_threshold_;

  // Whether each agv (by id) is disabled in the discrete garage state
  std::unordered_map<uint16_t, bool> agv_disabledness_map_;

  // Function for disabling an agv
  std::function<void(SetResourceDisablednessSrv::Request::SharedPtr request)> disable_agv_;

  rclcpp::Logger logger_;
};

}  // namespace volley
