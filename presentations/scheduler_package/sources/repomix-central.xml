// A retrieve job has the system bring the specified payload to a bay.
class RetrieveJob : public Job {
public:
  RetrieveJob(const GuidMsg& guid, const rclcpp::Time& time_registered, const GuidMsg& payload_id);

  uint8_t GetType() const override { return SchedulerJobMsg::TYPE_RETRIEVE; };
  std::string GetName() const override { return "RETRIEVE"; };
  const GuidMsg& GetPayloadId() const { return payload_id_; }
  uint16_t GetBayId() const { return bay_id_; }
  const GuidMsg& GetBayArrivalNodeGuid() const { return bay_arrival_node_guid_; }
  float GetSecondsToBayArrival() const { return seconds_to_bay_arrival_; }
  bool GetNeedsBayInRetrieve() const { return needs_bay_in_retrieve_; }

  void SetPlannedData(uint16_t bay_id, const GuidMsg& bay_arrival_node_guid);
  void SetSecondsToBayArrival(float seconds_to_bay_arrival);
  void SetNeedsBayInRetrieve(bool needs_bay_in_retrieve);

  SchedulerJobMsg ToRos() const override;

  // Advance the job to the SUCCESS state
  void OnSuccess(const rclcpp::Time& time) override;

  // Advance the job to the ERROR state
  void OnError(const rclcpp::Time& time) override;

  // Get a string with the payload ID for printing when the job fails to plan
  std::string GetPrintInfo() const override { return "payload " + std::to_string(payload_id_); }

private:
  // The GUID of the payload to retrieve
  GuidMsg payload_id_;

  // The bay to which this retrieve has been planned. 0 prior to being planned.
  uint16_t bay_id_ = 0;

  // The GUID of the execution action node that processes the retrieve. We use this node to
  // estimate when the customer will have access to their vehicle.
  GuidMsg bay_arrival_node_guid_ = volley::kEmptyGuid;

  // The estimated number of seconds until the retrieved vehicle is in the bay.
  // This value is set to the start time of the node referenced by bay_arrival_node_guid.
  // Inf prior to being planned.
  // Zero once in a terminal state.
  float seconds_to_bay_arrival_ = std::numeric_limits<float>::infinity();

  // When true, this job can't be planned because it needs a bay in READY FOR RETRIEVE
  bool needs_bay_in_retrieve_ = false;
};

