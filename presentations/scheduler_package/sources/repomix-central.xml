bool DispatchRos::SendAgvCommand(uint16_t agv_id, const AgvCommandMsg& agv_command) {
  auto agv_command_request = std::make_shared<AgvCommandSrv::Request>();
  agv_command_request->command = agv_command;

  if(!HasAgv(agv_id)) {
    CreateAgvClients(agv_id);
  }

  // Send the command
  auto response_opt = volley::Call<AgvCommandSrv::Response>(
      agv_clients_[agv_id].command_cli, agv_command_request, node_->get_logger());
  if(response_opt.has_value()) {
    std::string header = "Received response from a" + std::to_string(agv_id) + ": ";
    if(response_opt.value()->command_status == common::EnumInteger(CommandStatus::ACCEPTED)) {
      INFOS(node_->get_logger(), header + response_opt.value()->message);
      return true;
    }
    else if(response_opt.value()->command_status == common::EnumInteger(CommandStatus::IGNORED)) {
      WARNS(node_->get_logger(), header + response_opt.value()->message);
    }
    else if(response_opt.value()->command_status == common::EnumInteger(CommandStatus::REJECTED)) {
      ERRORS(node_->get_logger(), header + response_opt.value()->message);
    }
  }

  return false;
}

