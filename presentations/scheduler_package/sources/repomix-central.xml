<file path="include/central/central_timing.hpp">
#pragma once

#include <chrono>

namespace central {

using namespace std::chrono_literals;

// max time we wait for a plan response
constexpr auto kPlanDeadlinePeriod = 5s;

// Rate of the main dispatch loop for dispatching jobs
constexpr auto kDispatchJobsPeriod = 1800ms;  // 2s;

// Rate at which the planner is called
constexpr auto kPlannerPeriod = 850ms;  // Original Value: 500ms;

// Rate at which our version info is published
constexpr auto kVersionInfoPeriod = 5s;

// Rate at which we cull old terminal jobs
constexpr auto kCullOldJobsPeriod = 300s;

// Rate at which we publish garage info from the garage tracker
constexpr auto kGarageInfoPeriod = 1s;

// Only commands that will be completed within this horizon can be sent
static constexpr float kCommandSendHorizon = 30;  // [s]

// max age of an AGV report before it is considered stale
constexpr auto kAgvUpdateStaleness = 90s;

// max age of a bay report before it is considered stale
constexpr auto kBayUpdateStaleness = 1min;

// max age of a VECS report before it is considered stale
constexpr auto kVecsUpdateStaleness = 1min;

// max age of a consistency report before it is considered stale
constexpr auto kConsistencyReportStaleness = 5s;

// the amount of time we keep a terminated job (succeeded or errored) before removing it
constexpr auto kTerminalJobRetainPeriod = 1h;

// the amount of idle time before transitioning to charge mode
constexpr auto kTimeoutCharge = 1min;

// the amount of idle time before queueing an opportunistic clean
constexpr auto kTimeoutClean = 10min;

// time in starting before we fail and revert to stopping
constexpr auto kTimeoutStarting = 1min;

// snapshot
constexpr auto kSnapshotTimer = 50ms;  // 50ms = 20Hz, 66ms = 15Hz, 100ms = 10Hz

}  // namespace central
</file>

