std::optional<int> ExecutionGarageState::GetTrayResourceSizeIndex(const DiscreteTrayStateMsg& tray) {
  auto payload_opt = garage_state_.GetPayload(tray.payload_id);
  if(payload_opt.has_value()) {
    return pose_graph_->GetLayout()->GetSmallestEnclosingResourceSizeIndex(
        payload_opt->payload.length_m, payload_opt->payload.width_m, payload_opt->payload.height_m);
  }

  // no payload - just the size of an empty tray
  return volley::kResourceSizeIndexTray;
}

