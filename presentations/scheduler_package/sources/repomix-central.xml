<file path="include/central/schedule.hpp">
#pragma once
#include <central/central_msgs.hpp>
#include <common/types.hpp>
#include <common_ros/print_graph.hpp>
#include <common_ros/print_utils.hpp>
#include <common_ros/ros_utils.hpp>
#include <common_ros/roslog.hpp>
#include <fstream>
#include <map>
#include <set>
#include <vector>

namespace volley {

enum MotionBatchState {
  MBS_PENDING = 0,         // waiting to be sent
  MBS_SENT = 1,            // sent to AGV, waiting for motion started
  MBS_MOTIONSTARTED = 2,   // AGV reported motion started, waiting for motion completed
  MBS_MOTIONCOMPLETED = 3  // AGV reported motion completed
};

// Each AGV ActionNode coresponds to a single graph edge in the Volley garage layout.
// But sinding one-ActionNode-at-a-time is not compatible with Hito AGVs.
// A MotionBatch is the a group of AGV ActionNodes, with collinear AGV motion.
// The entire batch is sent to a Hito AGV as a single motion command.
class MotionBatch {
public:
  std::vector<uint32_t> indices_;
  uint16_t agv_id_ = 0;
  MotionBatchState state_;  // pending, sent, motionstarted, motioncompleted
};

using MotionBatchSPtr = std::shared_ptr<MotionBatch>;
using NodeBatchMap = std::map<uint32_t, MotionBatchSPtr>;

// Schedules are produced by the Planner, and take the form of a directed acyclic graph of actions that
// the dispatcher is to take. Each node in this DAG is an action, and the edges represent temporal
// dependencies between actions. A child node can only take place after all parents have been
// completed.
// Schedules contain the information necessary for the Dispatcher to dispatch actions to garage
// entities. Schedules are constructed from Plan responses and are subsequently only modified insofar
// as nodes are marked complete.
// A node is ready to be dispatched if its parents are all complete. Note however, that there are some
// special cases when it comes to chaining AGV moves.
class Schedule {
public:
  Schedule() = default;

  // Append a new node (in topographical order).
  // We return a bool/string pair. The boolean indicates success/failure and the message contains
  // error information.
  // We guarantee that if Append fails, that the Schedule will not have been modified.
  BoolStringPair Append(ActionNodeMsg node);

  uint32_t NumNodes() const { return nodes_.size(); };

  bool IsNodeCompleted(uint32_t node_index) const {
    return nodes_.at(node_index).status == ActionNodeMsg::STATUS_COMPLETED;
  };

  bool IsNodeReceived(uint32_t node_index) const {
    return nodes_.at(node_index).status == ActionNodeMsg::STATUS_RECEIVED;
  };

  // A node is ready if it has no incomplete predecessors
  bool IsNodeReady(uint32_t node_index) const { return ready_nodes_.find(node_index) != ready_nodes_.end(); };

  // Get the status of a given node
  uint8_t GetNodeStatus(uint32_t node_index) const { return nodes_.at(node_index).status; }

  bool IsNodeOutsideSplit(uint32_t node_index) const { return nodes_.at(node_index).outside_split; }

  // Check if number of incomplete parents is 1 or 0 and if the incomplete parent is Received
  bool IsNodeReadyForChaining(uint32_t node_index) const;

  // Check all parents to see whether they are all complete
  bool NodeHasNoIncompleteParents(uint32_t node_index) const;

  // Count the number of parents that are not complete
  uint32_t GetNumberOfIncompleteParents(uint32_t node_index) const;

  // Constant getters
  const ActionNodeMsg& GetNode(uint32_t node_index) const { return nodes_.at(node_index); }
  const std::vector<ActionNodeMsg>& GetNodes() const { return nodes_; }
  const std::set<uint32_t>& GetReadyNodeIndices() const { return ready_nodes_; }
  const std::vector<uint32_t>& GetSuccessorNodeIndices(uint32_t node_index) const;

  // Get the index of the node associated with the given GUID, if it exists
  std::optional<uint32_t> GetNodeByGuid(const GuidMsg& guid) const;

  // Get the index of the given entity's leading action, or nothing if there is no scheduled
  // action.
  std::optional<uint32_t> GetLeadingEntityActionIndex(const GarageEntityIdMsg& entity_id) const;

  // Given the index of a node corresponding to an entity action, find the index of the successor
  // node that is also an entity action, if such a node exists. Note that there can be at most
  // one.
  std::optional<uint32_t> GetSuccessorEntityActionIndex(uint32_t node_index) const;

  // Whether the given bay has an infinite duration action such that it is being used
  // indefinitely.
  bool IsBayOccupiedIndefinitely(uint16_t bay_id) const;

  // Returns a string containing code in the graphviz DOT language used to render graphs.
  // https://graphviz.org/doc/info/lang.html
  // Can be compiled using, for example: dot -Tps graph.dot -o graph.pdf
  // If left_right is true, the plot will be oriented left to right. Otherwise, it will be
  // rendered top to bottom
  std::string ToDotFormatString(bool left_right = true) const;

  // Print this schedule graph to the log
  void PrintGraph(const std::string& label, rclcpp::Logger logger = rclcpp::get_logger("")) const;

  // Complete the action node associated with the given node index
  BoolStringPair CompleteAction(uint32_t node_index);

  // Mark an action node as being received by the AGV
  BoolStringPair MarkActionReceived(uint32_t node_index);

  // Get the node start time based on the duration of the uncompleted parents
  float GetNodeStartTime(uint32_t node_index) const;

  // Get all nodes start times based on durations of the uncompleted parents
  std::vector<float> GetNodeStartTimes() const;

  // Determine which nodes are outside the command send horizon while a plan call is executing
  void SplitSchedule(float horizon);

  // Set outside_horizon=false for all action nodes in the schedule
  void UndoSplit();

private:
  // The action nodes, in a topological order.
  // Node parent indices are stored in ascending (topological) order.
  std::vector<ActionNodeMsg> nodes_;

  // For each node, the indices of the successors for that node.
  // That is, the indices of all nodes who have this node in their `parents` list.
  // Items are sorted in ascending (topological) order for reproducibility.
  std::vector<std::vector<uint32_t>> successors_;

  // Set of ready node indices. A node is ready if it has no incomplete predecessors.
  std::set<uint32_t> ready_nodes_;

  // Map of node guid to its node index
  std::map<GuidMsg, uint32_t, volley::GuidComparator> guid_to_node_index_;

  // If an entity has any remaining actions in the schedule,
  // this map will map its id to the index of its leading incomplete action node.
  std::map<GarageEntityIdMsg, uint32_t, volley::GarageEntityIdComparator> entity_id_to_leading_action_;
};

}  // namespace volley
</file>

