#include <central/execution_state.hpp>
#include <central/send_ready_agv_adaptor.hpp>

namespace volley {

void SendReadyAgvAdaptor::SendReadyAgvCommand(uint16_t agv_id) {
  assert(exeptr_ != nullptr);

  auto entity_id = volley::AgvId(agv_id);

  // Get the leading action, if there is one
  auto leading_action_index_opt = exeptr_->schedule_.GetLeadingEntityActionIndex(entity_id);
  if(!leading_action_index_opt.has_value()) {
    // Nothing to dispatch
    return;
  }
  unsigned int leading_action_index = leading_action_index_opt.value();

  // The leading action must be ready
  if(!exeptr_->schedule_.IsNodeReady(leading_action_index)) {
    return;
  }

  // The leading action must be inside the schedule split if there is an ongoing plan call
  if(exeptr_->schedule_.IsNodeOutsideSplit(leading_action_index)) {
    return;
  }

  const std::vector<ActionNodeMsg>& schednodes = exeptr_->schedule_.GetNodes();

  // If this leading command should be sent, don't even look at the successor and just send
  // this one
  bool send_leading_action = exeptr_->IsActionInsideCommandHorizon(leading_action_index) &&
                             !exeptr_->schedule_.IsNodeReceived(leading_action_index);

  auto leading_node = exeptr_->schedule_.GetNode(leading_action_index);

  unsigned int command_to_send_index = leading_action_index;

  // Get the successor action index, if there is one
  auto successor_action_index_opt = exeptr_->schedule_.GetSuccessorEntityActionIndex(command_to_send_index);

  // Recursively loop through successors that have been received until we find one that has not
  // been received, then determine if it is ready to be sent or not
  // TODO(Tim): A down followed by an up is inefficient, and can be pruned out in the
  //            future.  https://app.asana.com/0/1199554542620192/1200829199448571/f
  // TODO(Tim): Do not chain a lift and a move action (but do chain a move and then a lift),
  //            as if we miss intermediate reports, we will incorrectly produce a move and
  //            then a lift.
  //            https://app.asana.com/0/1199554542620192/1201840455130759/f

  while(successor_action_index_opt.has_value() && !send_leading_action) {
    unsigned int successor_action_index = successor_action_index_opt.value();
    if(!exeptr_->schedule_.IsNodeReceived(successor_action_index)) {
      // This current successor hasn't been received yet, so do some checks to determine if we
      // should chain this action, then break out of the loop.
      leading_node = exeptr_->schedule_.GetNode(leading_action_index);
      const auto& successor_node = exeptr_->schedule_.GetNode(successor_action_index);
      bool successor_is_ready_for_chaining =
          exeptr_->schedule_.IsNodeReadyForChaining(successor_action_index);

      // Lift commands have special logic
      bool leading_action_is_lift_change =
          leading_node.agv_command.dst.lift != leading_node.agv_command.src.lift;
      bool successor_action_is_lift_change =
          successor_node.agv_command.dst.lift != successor_node.agv_command.src.lift;

      // We cannot apply a lift and then a move command, not just for the stated
      // reason above, but also because the base discrete garage state
      // will produce an incorrect Collision ID for the safety checker based on the
      // pre-lift state.
      bool lift_and_then_move = leading_action_is_lift_change && (!successor_action_is_lift_change);

      // Make sure successor command is within the command send horizon
      bool within_command_horizon = exeptr_->IsActionInsideCommandHorizon(successor_action_index);

      // Make sure command is inside the schedule split if there is an ongoing plan call
      bool within_schedule_split = !exeptr_->schedule_.IsNodeOutsideSplit(successor_action_index);

      if(within_command_horizon && within_schedule_split && successor_is_ready_for_chaining &&
          !lift_and_then_move) {
        command_to_send_index = successor_action_index;
      }
      break;
    }

    // The current successor is already received, so go to this action's successor
    leading_action_index = successor_action_index;
    successor_action_index_opt = exeptr_->schedule_.GetSuccessorEntityActionIndex(successor_action_index);
  }

  if(exeptr_->schedule_.IsNodeReceived(command_to_send_index)) {
    // This command has already been dispatched.
    return;
  }

  const ActionNodeMsg& action_node = exeptr_->schedule_.GetNode(command_to_send_index);
  AgvCommandMsg command_to_send = action_node.agv_command;

  // We have chosen our command
  // TODO(any):
  // As an additional safety measure, only send it if the edge the AGV will
  // travel is collision free

  // If this is an AGV lift command, make sure the tray being lifted does not have a charging
  // payload on it. If it does, don't send the command
  if(command_to_send.dst.lift != command_to_send.src.lift) {
    auto node_id = command_to_send.src.pose.node_id;
    auto vecs_opt = exeptr_->exec_state_latest_.GetGarageState().GetVecs(node_id);
    if(vecs_opt.has_value() && vecs_opt->state != VecsReportMsg::READY_TO_CHARGE) {
      std::cout << "ERROR - TRYING TO LIFT A TRAY THAT'S PLUGGED INTO A VECS" << std::endl;
      return;
    }
  }

  auto [safe, msg] =
      exeptr_->safety_checker_->Apply(action_node, exeptr_->exec_state_latest_.GetGarageState());

  if(!safe) {
    std::cout << "Safety check failed trying to send action node: " << msg << std::endl;
    return;
  }

  const auto it = exeptr_->startnodebatchmap_.find(command_to_send_index);
  if(it == exeptr_->startnodebatchmap_.end()) {
    // The whole batch is already sent.
    return;
  }

  // This is the start of a motion batch.  Send the batch.
  const auto& batch = it->second;
  AgvCommandMsgVec cmds;
  for(const auto index : batch->indices_) {
    const auto& node = schednodes[index];
    cmds.push_back(node.agv_command);
  }

  const bool received = exeptr_->command_send_->sendAgvCommand(agv_id, cmds);
  if(received) {
    batch->state_ = MBS_SENT;
    for(const uint32_t index : batch->indices_) {
      exeptr_->schedule_.MarkActionReceived(index);
    }
  }
}

}  // namespace volley
