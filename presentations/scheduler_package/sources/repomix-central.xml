#include <central/consistency_monitor_ros.hpp>
#include <common/topics_central.hpp>
#include <common_ros/ros_utils.hpp>
namespace volley {

using namespace std::chrono_literals;
using VersionInfo = VersionInfoMsg;

ConsistencyMonitorRos::ConsistencyMonitorRos(NodeSPtr node) :
    node_(node),
    consistency_monitor_(
        [this](const std::string& entity_name, const std::optional<std::string>& service_name) {
          CreateVersionSubscription(entity_name, service_name);
        },
        node->get_logger()) {
  // Register publisher and subscribers
  consistency_report_pub_ = node_->create_publisher<ConsistencyReportMsg>(
      volley::TopicCentralConsistencyReport().Name(), volley::GetReliableQoS(1));
  discrete_garage_state_sub_ =
      node_->create_subscription<DiscreteGarageStateMsg>(volley::TopicCentralDiscreteGarageState().Name(),
          volley::GetBestEffortQoS(1), [this](DiscreteGarageStateMsg::UniquePtr msg) {
            consistency_monitor_.DiscreteGarageStateCallback(std::move(msg));
          });

  // Repeatedly trigger timer callback.
  main_timer_ = node_->create_timer(1s, [this] { PublishConsistencyReport(); });
}

bool ConsistencyMonitorRos::IsConsistent() const {
  return consistency_monitor_.IsConsistent(node_->now());
}

void ConsistencyMonitorRos::PublishConsistencyReport() {
  auto report = std::make_unique<ConsistencyReportMsg>();
  report->header.stamp = node_->now();
  report->consistent = IsConsistent();
  consistency_report_pub_->publish(std::move(report));
}

void ConsistencyMonitorRos::VersionInfoCallback(VersionInfo::UniquePtr version_info) {
  consistency_monitor_.SetVersionInfo(std::move(version_info));
}

void ConsistencyMonitorRos::CreateVersionSubscription(
    const std::string& entity_name, const std::optional<std::string>& service_name) {
  // If there is no service name, then we try and remove the existing subscription.
  if(!service_name.has_value()) {
    version_info_subs_.erase(entity_name);
    return;
  }

  // Otherwise, try and subscribe unless we are already subscribed to this topic
  if(version_info_subs_.find(entity_name) != version_info_subs_.end()) {
    return;
  }
  version_info_subs_[entity_name] =
      node_->create_subscription<VersionInfo>(service_name.value(), volley::GetBestEffortQoS(1),
          [this](VersionInfo::UniquePtr version_info) { VersionInfoCallback(std::move(version_info)); });
}

}  // namespace volley
</file>

<file path="src/consistency_monitor.cpp">
#include <central/consistency_monitor.hpp>
#include <common/topics_central.hpp>
#include <common/topics_common.hpp>
#include <common_ros/roslog.hpp>
#include <unordered_set>

namespace volley {

using namespace std::chrono_literals;

// Version info messages older than this will be ignored
constexpr auto kVersionInfoTimeout = 5min;

bool ConsistencyMonitor::IsConsistent(const rclcpp::Time& now) const {
  // We cannot be consistent if we don't know about anything
  if(version_infos_.empty()) {
    return false;
  }

  // Check to see if we have received valid versions from all entities.
  std::vector<std::string> missing_entities;
  for(const auto& [name, info] : version_infos_) {
    if(info.gitsha.empty()) {
      missing_entities.emplace_back(name);
      missing_since_.try_emplace(name, now);
    }
    else {
      missing_since_.erase(name);
    }
  }
  if(!missing_entities.empty()) {
    std::string reason = "Inconsistent! Missing version info from:";
    for(const auto& name : missing_entities) {
      const auto waited_s = static_cast<int64_t>((now - missing_since_.at(name)).seconds());
      reason += " " + name + " (missing for " + std::to_string(waited_s) + "s)";
    }
    WARNS(logger_, reason);
    return false;
  }

  // If we have all version infos, evaluate consistency.
  // Note that we do not use the release to check for consistency, because it is not
  // guaranteed to indicate equality in the same way that the gitsha is.
  bool consistent = true;
  const auto& dispatcher_info = version_infos_.at("dispatcher");
  for(const auto& [name, version_info] : version_infos_) {
    const rclcpp::Time stamp(version_info.header.stamp, now.get_clock_type());
    if((now - stamp) > rclcpp::Duration(kVersionInfoTimeout)) {
      WARNS(logger_, "Inconsistent! " << name << "'s version info message is stale!");
      consistent = false;
    }
    else if(version_info.gitsha != dispatcher_info.gitsha) {
      WARNS(logger_, "Inconsistent! " << name << "'s gitsha " << version_info.gitsha
                                      << " does not match the dispatcher gitsha of " << dispatcher_info.gitsha
                                      << "!  Their releases are " << version_info.release << " and "
                                      << dispatcher_info.release);
      consistent = false;
    }
    else if(name.empty() ||           // pedantic check just in case name is empty
            (name.at(0) != 'b' &&     // NOTE: Skip bays - they do not load layouts.
                name.at(0) != 'v' &&  // NOTE: Skip VEXen - they do not load layouts.
                version_info.layout_md5sum != dispatcher_info.layout_md5sum)) {
      WARNS(logger_, "Inconsistent! " << name << "'s layout md5sum " << version_info.layout_md5sum
                                      << " does not match the dispatcher md5sum of "
                                      << dispatcher_info.layout_md5sum);
      consistent = false;
    }
  }

  return consistent;
}

std::vector<std::string> ConsistencyMonitor::GetEntityNames() {
  std::vector<std::string> names;
  for(const auto& [name, info] : version_infos_) {
    names.emplace_back(name);
  }
  return names;
}

void ConsistencyMonitor::DiscreteGarageStateCallback(DiscreteGarageStateMsg::UniquePtr garage_state) {
  std::string info_topic = volley::kVersionInfoTopic.Name();
  AddVersionInfo("dispatcher", "/central/" + info_topic);
  AddVersionInfo("scheduler", volley::TopicCentralSchedulerVersionInfo().Name());

  // List of AGV, bay, or VECS names to remove if they don't appear in the discrete garage state
  // or are disabled
  std::unordered_set<std::string> version_info_names_to_delete;
  for(const auto& [name, info] : version_infos_) {
    uint16_t id = 0;
    if(sscanf(name.c_str(), "a%hu", &id) == 1 || sscanf(name.c_str(), "b%hu", &id) == 1 ||
        sscanf(name.c_str(), "v%hu", &id) == 1) {
      version_info_names_to_delete.insert(name);
    }
  }

  for(const auto& agv : garage_state->agvs) {
    if(agv.disabled) {
      continue;
    }
    std::string name = 'a' + std::to_string(agv.id);
    AddVersionInfo(name, "/agv/" + name + "/" + info_topic);
    version_info_names_to_delete.erase(name);
  }
  for(const auto& bay : garage_state->bays) {
    if(bay.disabled) {
      continue;
    }
    std::string name = 'b' + std::to_string(bay.id);
    AddVersionInfo(name, "/bay/" + name + "/" + info_topic);
    version_info_names_to_delete.erase(name);
  }
  for(const auto& vecs : garage_state->vexen) {
    if(vecs.disabled) {
      continue;
    }
    std::string name = 'v' + std::to_string(vecs.id);
    AddVersionInfo(name, "/vecs/" + name + "/" + info_topic);
    version_info_names_to_delete.erase(name);
  }

  // Remove AGVs, bays, and vexen that no longer exist or are disabled
  for(auto name : version_info_names_to_delete) {
    version_infos_.erase(name);
    missing_since_.erase(name);
    change_subscription_(name, std::nullopt);
  }
}

void ConsistencyMonitor::SetVersionInfo(VersionInfoMsg::UniquePtr version_info) {
  // If we don't already know about this version reset the list of version infos, so we'll be
  // inconsistent.
  if(version_infos_.find(version_info->name) == version_infos_.end()) {
    WARNS(logger_, "Received unexpected version info from " << version_info->name);
    version_infos_.clear();
    missing_since_.clear();
    return;
  }
  version_infos_[version_info->name] = *version_info;
}

void ConsistencyMonitor::AddVersionInfo(const std::string& entity_name, const std::string& topic_name) {
  if(version_infos_.find(entity_name) != version_infos_.end()) {
    return;
  }
  version_infos_[entity_name] = VersionInfoMsg {};
  change_subscription_(entity_name, topic_name);
}

}  // namespace volley
