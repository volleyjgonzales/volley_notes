<file path="include/central/garage_tracker_mysql_io.hpp">
#pragma once
#include <mysql_connection.h>
#include <yaml-cpp/yaml.h>

#include <central/central_msgs.hpp>
#include <common/types.hpp>
#include <common_ros/discrete_garage_state.hpp>
#include <cstring>
#include <string>
#include <vector>

namespace volley {

// Table names
const std::string kEventsTable = "discrete_events";
const std::string kSnapshotsTable = "snapshots";

// A garage snapshot is a compressed YAML file, containing all relevent information to
// construct a DiscreteGarageState, as well as a version parameter to remain backwards
// compatible and as future proof as reasonably possible.
//
// The garage_tracker_recovery can be used to load versions which are malformed or cannot
// be loaded in the current version without human guidance by taking an annotated YAML
// object from the parsing of the state which includes information about which fields are
// missing or failed to parse. Once the state is fixed, it is validated and then uploaded
// to the mysql database, allowing for breaking changes in DiscreteGarageState ROS messages
// to be made and rectified in the field without losing any state data.
//
// Current YAML Format DiscreteGarageState Example:
// is_faulted: true
// agvs:
//   - id: 1
//     state: "\x04"
//     lift: true
//     garage_pose:
//       node_id: 101
//       heading: 90
//     tray_id: 101
//     disabled: false
// bays:
//   - id: 1
//     state: "\x02"
// trays:
//   - id: 101
//     pose:
//       node_id: 101
//       heading: -90
//     agv_id: 1
//     payload_id:
//       string: 00000000-0000-0000-0000-00000000CAFE
//     disabled: false
// payloads:
//   - payload:
//       id:
//         string: 00000000-0000-0000-0000-00000000C0DE
//       mass: 900
//       length_m: 4
//       width_m: 2.1
//       height_m: 1.4
//     tray_id: 301
//     reciprocal_to_tray: false
//     charging: false
// hash: 1640572270227573849

// A single structure for passing around the parameters needed to talk to MySQL.
struct GarageDatabaseParameters {
  unsigned int port = 0;
  std::string host;
  std::string user;
  std::string password;
  std::string database;
};

// Create both the events and the snapshots table, if they do not exist.
BoolStringPair InitTables(const GarageDatabaseParameters& params);

// Obtain the latest event sequence number.
// We return a tuple:
//  bool - whether the retrieve was successful
//  uint64 - the sequence number of the most recent event
//  string - may contain an error message for debugging
std::tuple<bool, uint64_t, std::string> GetLatestEventSequenceNumber(const GarageDatabaseParameters& params);

// Serialize the given discrete garage state in the format we expect for our snapshots table:
//
// This format was chosen to help ensure that we maintain backwards compatability. That is, because
// we designed our discrete garage events to never fail to be deserializable, we can decompose our
// discrete garage state into an construction event for each entity. Future versions of this
// software should still be able to load from old events.
//
// The version number does not suggest that we anticipate a reason to change this format. We do not
// need to change the serialization format when adding new events. However, it is good practice to
// include a version number such that if we do, we can be backwards compatible if we want.
//
// We return a tuple:
//  bool - whether serialization was successful
//  buffer - the serialized byte array
//  string - may contain an error message for debugging
std::tuple<bool, std::vector<uint8_t>, std::string> SerializeDiscreteGarageState(
    const volley::DiscreteGarageState& state, std::optional<uint32_t> version = std::nullopt);

// Deserialize a snapshot from our snapshots table.
// We return a tuple:
//  bool - whether the retrieve was successful
//  state - The discrete garage state stored in the latest snapshot
//  string - may contain an error message for debugging
//  YAML::Node - annotated version of yaml encoded state to be used for debugging and recovery
std::tuple<bool, volley::DiscreteGarageState, std::string, YAML::Node> DeserializeDiscreteGarageState(
    std::vector<uint8_t> data_vec,
    // TODO(Gunther): Remove the need for below asap
    sql::Connection* conn, uint64_t sequence_number);

// Write a discrete garage state to our snapshots table.
// Here, `event_sequence_number` refers to the sequence number of the most recent event to be
// applied to our state.
//
// Our table stores the sequence_number and a serialized snapshot.
// The sequence number is needed so that we can easily retrieve all events that occurred since
// this snapshot, so we can back out the current state
//
// We return a pair:
//  bool - whether the write was successful
//  string - may contain an error message for debugging
BoolStringPair WriteSnapshot(const GarageDatabaseParameters& params, const volley::DiscreteGarageState& state,
    uint64_t event_sequence_number, std::optional<uint32_t> version = std::nullopt);

// Obtain the latest sequence from our snapshots table.
// We return a tuple:
//  bool - whether the retrieve was successful
//  state - The discrete garage state stored in the latest snapshot
//  uint64 - the sequence number of the most recent event to be applied to our retrieved state.
//  string - may contain an error message for debugging
//  YAML::Node - annotated version of the parssed snapshot to be used for debugging and recovery
std::tuple<bool, volley::DiscreteGarageState, uint64_t, std::string, YAML::Node> GetLatestSnapshot(
    const GarageDatabaseParameters& params);

}  // namespace volley
</file>

