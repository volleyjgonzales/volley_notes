void Dispatch::SetModeSrvCallback(
    SetUInt8Srv::Request::SharedPtr request, SetUInt8Srv::Response::SharedPtr response) {
  if(status_ != Status::STOPPED && status_ != Status::STOPPING) {
    WARNS(logger_, "Cannot set mode unless in STOPPED or STOPPING, mode: " << common::EnumNameString(mode_));
    response->success = false;
    response->message = "Not in STOPPED or STOPPING";
    return;
  }

  auto mode_desired = common::EnumCast<Mode>(request->value);
  if(!mode_desired) {
    WARNS(logger_, "Unknown requested mode value: " << std::to_string(request->value));
    response->success = false;
    response->message = "Unknown mode value";
    return;
  }

  // Set the mode
  mode_ = mode_desired.value();
  INFOS(logger_, "Set dispatcher mode to " << common::EnumNameString(mode_));
  response->success = true;
}

void Dispatch::StartSrvCallback(TriggerSrv::Response::SharedPtr response, const rclcpp::Time& now) {
  // Assume failure
  response->success = false;

  // The dispatcher can only be started if consistency in the garage has been
  // achieved. We ensure that our latest consistency report is not stale. NOTE: We do
  // not allow starting if STOPPING. We have to be fully stopped.

  if(status_ != Status::STOPPED and status_ != Status::PAUSED) {
    WARNS(logger_, "Cannot start dispatch - not stopped or paused: " << common::EnumNameString(status_));
    response->message = "not stopped or paused";
    return;
  }
  else if(IsConsistencyReportStale(now)) {
    WARNS(logger_, "Cannot start dispatch - consistency report is stale");
    response->message = "consistency report is stale";
    return;
  }
  else if(IsContinuousGarageInfoStale(now)) {
    WARNS(logger_, "Cannot start dispatch - continuous garage info is stale");
    response->message = "continuous garage info is stale";
    return;
  }
  else if(!consistency_report_.consistent) {
    WARNS(logger_, "Cannot start dispatch - inconsistent");
    response->message = "inconsistent";
    return;
  }
  else if(discrete_garage_state_.IsFaulted()) {
    WARNS(logger_, "Cannot start dispatch - faulted garage state");
    response->message = "state is faulted";
    return;
  }

  INFOS(logger_, "Starting! Start Service was requested.");

  if(status_ == Status::STOPPED) {
    // If stopped, enter starting
    exec_state_.reset();
    status_ = Status::STARTING;
    time_enter_starting_.reset();
  }
  else {
    // If paused, enter running
    status_ = Status::RUNNING;

    // Reset our idle trackers
    time_became_idle_.reset();
    queued_idle_clean_ = false;
    queued_idle_rebalance_ = false;
  }

  response->success = true;
}

void Dispatch::StopSrvCallback(TriggerSrv::Response::SharedPtr response) {
  if(status_ == Status::STOPPED) {
    response->success = false;
    response->message = "Dispatcher is already stopped!";
    WARNS(logger_, response->message);
    return;
  }

  INFOS(logger_, "Stopping! Stop Service was requested.");

  status_ = Status::STOPPING;
  response->success = true;
}

void Dispatch::PauseSrvCallback(TriggerSrv::Response::SharedPtr response) {
  if(status_ == Status::PAUSED) {
    response->success = false;
    response->message = "Dispatcher is already paused!";
    WARNS(logger_, response->message);
    return;
  }
  else if(status_ != Status::RUNNING) {
    response->success = false;
    response->message = "Dispatcher must be running to be paused";
    WARNS(logger_, response->message);
    return;
  }

  INFOS(logger_, "Pausing! Pause Service was requested.");

  status_ = Status::PAUSED;
  response->success = true;
}

void Dispatch::ChargePayloadSrvCallback(ChargePayloadSrv::Request::SharedPtr request,
    ChargePayloadSrv::Response::SharedPtr response, const rclcpp::Time& now) {
  INFOS(logger_, "Received request to Charge Payload " << std::to_string(request->payload_id));

  std::tie(response->success, response->message) = CanAcceptAutoJob();
  if(!response->success) {
    WARNS(logger_, "Cannot accept Charge Payload: " << response->message);
    return;
  }

  if(!discrete_garage_state_.HasPayload(request->payload_id)) {
    response->success = false;
    response->message =
        "Cannot accept Charge Payload: payload " + std::to_string(request->payload_id) + " does not exist!";
    WARNS(logger_, response->message);
    return;
  }

  if(gg_.GetLayout()->GetNodeIdsOfType(GarageNodeMsg::TYPE_EV_CHARGE).size() == 0) {
    response->success = false;
    response->message = "Cannot accept Charge Payload: no EV Charge nodes exist in this layout!";
    WARNS(logger_, response->message);
    return;
  }

  auto job = std::make_unique<ChargePayloadJob>(GenerateGuid(now), now, request->payload_id);

  // We return the job's GUID
  response->job_id = job->GetGuid();

  RegisterPendingJob(std::move(job));
}

