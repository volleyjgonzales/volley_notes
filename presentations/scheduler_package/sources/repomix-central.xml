#pragma once

#include <central/central_msgs.hpp>
#include <central/central_timing.hpp>
#include <central/charge_agvs.hpp>
#include <central/dispatch_jobs.hpp>
#include <central/execution_state.hpp>
#include <common/types.hpp>
#include <common_ros/discrete_garage_event_io.hpp>
#include <common_ros/discrete_garage_state.hpp>
#include <common_ros/pose_graph.hpp>
#include <common_ros/print_utils.hpp>
#include <common_ros/ros_utils.hpp>
#include <map>
#include <rclcpp/time.hpp>
#include <string>
#include <vector>

namespace volley {
using namespace central;

enum class Status : uint8_t {
  STARTING = DispatchReportMsg::STATUS_STARTING,
  RUNNING = DispatchReportMsg::STATUS_RUNNING,
  STOPPING = DispatchReportMsg::STATUS_STOPPING,
  STOPPED = DispatchReportMsg::STATUS_STOPPED,
  PAUSED = DispatchReportMsg::STATUS_PAUSED,
};

enum class Mode : uint8_t {
  AUTO = DispatchReportMsg::MODE_AUTO,
  MANUAL = DispatchReportMsg::MODE_MANUAL,
};

// A single structure to pass in when constructing a Dispatch object, rather than
// passing in all of these values individually.
struct DispatchParams {
  uint32_t installation_id;
  std::string layout_md5sum;
};

// There are different ways to request a plan from the scheduler.
enum PlanRequestStrategy {
  PLAN_JOBS_UNLIMITED,               // Request the whole queue, since there is no reason to do otherwise.
  PLAN_JOBS_MAX_RESOURCES_EXIST,     // Request only the amount of jobs, for minimum of AGVs and bays.
  PLAN_JOBS_MAX_RESOURCES_NON_BUSY,  // Request, for AGVs that are not busy.
  PLAN_JOBS_ONE_JOB_AT_TIME,         // Request only one job. The one at the front of the pending queue.
};

// This holds onto some information from the last plan request that will be used to validate the
// response
struct LastPlanCallData {
  // The time at which we last called the scheduler. This is used to avoid overlapping plan calls
  rclcpp::Time time_last_called;
  // The id of the ongoing plan call, if there is one
  GuidMsg plan_call_id;
  // The base schedule that is given in a plan request. The response needs to contain each of
  // these nodes in its schedule, or it is considered invalid
  std::unordered_map<GuidMsg, ActionNodeMsg> base_schedule;
};

// The dispatcher is responsible for dispatching commands to our garage entities. Today, this
// consists of the AGVs and the bays. The dispatcher maintains the schedule returned from the
// planner and mediates it out, as appropriate. The dispatcher maintains a list of jobs. Each job
// represents a task that can be submitted to the planner to complete by incorporating actions into
// a schedule. For example, a MoveAgvJob or a RetrieveJob.
class Dispatch {
public:
  Dispatch(const DispatchParams& params, PoseGraphCSPtr pose_graph, CommandSendSPtr command_send,
      const rclcpp::Logger& logger);

  // Subscription callbacks
  void ConsistencyReportCallback(ConsistencyReportMsg::UniquePtr report);
  void ContinuousGarageInfoCallback(ContinuousGarageInfoMsg::UniquePtr info);
  void DiscreteGarageEventCallback(DiscreteGarageEventStampedMsg::UniquePtr event);
  void DiscreteGarageStateCallback(DiscreteGarageStateMsg::UniquePtr garage_state);

  // Service callbacks
  void GetJobStateSrvCallback(
      GetJobStateSrv::Request::SharedPtr request, GetJobStateSrv::Response::SharedPtr response);
  void SetModeSrvCallback(SetUInt8Srv::Request::SharedPtr request, SetUInt8Srv::Response::SharedPtr response);
  void StartSrvCallback(TriggerSrv::Response::SharedPtr response, const rclcpp::Time& now);
  void StopSrvCallback(TriggerSrv::Response::SharedPtr response);
  void PauseSrvCallback(TriggerSrv::Response::SharedPtr response);

  void ChargePayloadSrvCallback(ChargePayloadSrv::Request::SharedPtr request,
      ChargePayloadSrv::Response::SharedPtr response, const rclcpp::Time& now);
  void MoveAgvSrvCallback(MoveAgvSrv::Request::SharedPtr request, MoveAgvSrv::Response::SharedPtr response,
      const rclcpp::Time& now);
  void MoveTraySrvCallback(MoveTraySrv::Request::SharedPtr request, MoveTraySrv::Response::SharedPtr response,
      const rclcpp::Time& now);
  void ReparkTraySrvCallback(ReparkTraySrv::Request::SharedPtr request,
      ReparkTraySrv::Response::SharedPtr response, const rclcpp::Time& now);
  void RetrieveSrvCallback(RetrieveSrv::Request::SharedPtr request, RetrieveSrv::Response::SharedPtr response,
      const rclcpp::Time& now);
  void TransitionBayToInsertSrvCallback(TransitionBayToInsertSrv::Request::SharedPtr request,
      TransitionBayToInsertSrv::Response::SharedPtr response, const rclcpp::Time& now);
  void TransitionBayToRetrieveSrvCallback(TransitionBayToRetrieveSrv::Request::SharedPtr request,
      TransitionBayToRetrieveSrv::Response::SharedPtr response, const rclcpp::Time& now);

  void CleanGarageSrvCallback(TriggerSrv::Response::SharedPtr response, const rclcpp::Time& now);
  void RebalanceGarageSrvCallback(TriggerSrv::Response::SharedPtr response, const rclcpp::Time& now);

  // Service client callbacks
  void PlanClientCallback(PlanSrv::Response::SharedPtr response, const rclcpp::Time& now);

  // Timer callbacks
  void MainTimerCallback(const rclcpp::Time& now);

  // Whether we have a job with the given id
  bool HasJob(const GuidMsg& job_id) const { return jobs_.find(job_id) != jobs_.end(); };

  // Whether our latest consistency report is stale
  bool IsConsistencyReportStale(const rclcpp::Time& now) const;
  // Whether our latest continuous garage info message is stale
  bool IsContinuousGarageInfoStale(const rclcpp::Time& now) const;
  // Whether the given AGV is stale according to the continuous garage info
  bool IsAgvGarageInfoStale(uint16_t agv_id) const;
  // Whether the given bay is stale according to the continuous garage info
  bool IsBayGarageInfoStale(uint16_t bay_id) const;
  // Whether the given VECS is stale according to the continuous garage info
  bool IsVecsGarageInfoStale(uint16_t vecs_id) const;

  // Whether the dispatcher can currently accept an auto job
  BoolStringPair CanAcceptAutoJob() const;

  // Whether the dispatcher can currently accept a manual job
  BoolStringPair CanAcceptManualJob() const;

  // Useful for logging information to the console
  void LogState() const;
  void LogJobs() const;
  void LogScheduleProgress() const;
  void LogGarageStateAgvsAndBays(const volley::DiscreteGarageState& state) const;

  // Generate a GUID. These are not random, but are generated with a combination
  // of the current time and an increasing counter. Note that this is different from
  // how dotnet GUIDs are generated.
  GuidMsg GenerateGuid(const rclcpp::Time& time);

  std::unique_ptr<DispatchReportMsg> GetDispatchReport(const rclcpp::Time& now) const;
  DispatchHeartbeatMsg::UniquePtr GetHeartbeat(const rclcpp::Time& now) const;
  VersionInfoMsg::UniquePtr GetVersionInfo(const rclcpp::Time& now) const;
  std::optional<PlanSrv::Request::SharedPtr> GetPlannerServiceRequest(const rclcpp::Time& now);
  std::optional<std::unique_ptr<ScheduleMsg>> GetScheduleMessage(const rclcpp::Time& now) const;
  Status GetStatus() const { return status_; };
  bool ShouldCallPlanner() const;
  const std::map<GuidMsg, std::unique_ptr<Job>, volley::GuidComparator>& GetJobs() const { return jobs_; }
  std::unordered_map<uint16_t, std::unique_ptr<AgvCommandSequenceMsg>> GetAgvCommandSequences(
      const rclcpp::Time& now) const;
  SchedulerJobListMsg GetPendingJobListMessage(const rclcpp::Time& now) const {
    return MakeJobListMessage(now, jobs_pending_);
  }
  SchedulerJobListMsg GetActiveJobListMessage(const rclcpp::Time& now) const {
    return MakeJobListMessage(now, jobs_active_);
  }
  SchedulerJobListMsg GetCompletedJobListMessage(const rclcpp::Time& now) const {
    return MakeJobListMessage(now, jobs_completed_);
  }

  // Remove sufficiently old terminal-state jobs
  void CullOldTerminalJobs(const rclcpp::Time& now);

  void PrintDags() {
    printdags_ = !printdags_;
    if(exec_state_) {
      exec_state_->printdags_ = printdags_;
    }
  }

  void SetPrintDags(bool printdags) {
    printdags_ = printdags;
    if(exec_state_) {
      exec_state_->printdags_ = printdags_;
    }
  }

  void SetEnableDispatchChargingMode(bool enable) { enable_dispatch_charging_mode_ = enable; }

  void SetGarageDirtinessThresholdRatio(double thresh) { garage_dirtiness_threshold_ratio_ = thresh; }

private:
  // Execution logic depending on the dispatch state
  void ActOnRunning(const rclcpp::Time& now);
  void ActOnRunningIdle(const rclcpp::Time& now);

  void ActOnStarting(const rclcpp::Time& now);
  void ActOnStoppedOrStopping(const rclcpp::Time& now);

  void UpdateActiveJobsEmpty(const rclcpp::Time& now);
  void UponActiveJobsEmpty(const rclcpp::Time& now);
  void NextSimplerPlanRequestStrategy();

  int32_t MinimumAgvsAndBays();
  int32_t MinimumNonBusyAgvsAndBays();

  std::optional<int32_t> UpdateAgvsNotBusyCount() const;

  // Returns true if all the bays are in READY_TO_RETRIEVE, the state necessary for STOPPED
  BoolStringPair AreAllBaysStopped() const;

  // Returns true if all the vexen are in READY_TO_CHARGE, the state necessary for STOPPED
  BoolStringPair AreAllVexenStopped() const;

  // Send commands to needed bays to transition them to READY_TO_RETRIEVE, the state necessary for
  // STOPPED
  void MoveAllBaysToStopped(const rclcpp::Time& now);

  // Send commands to needed Vexen to transition them to READY_TO_CHARGE, the state necessary for
  // STOPPED
  void MoveAllVexenToStopped(const rclcpp::Time& now);

  // Create jobs based off of new events
  void CreateJobsFromEvents(const DiscreteGarageEventMsg& event, const rclcpp::Time& now);

  // Register a new pending job
  void RegisterPendingJob(std::unique_ptr<Job> job);
  std::list<std::unique_ptr<Job>> RemovePendingJobsType(uint8_t jobtype);

  // True for job types that don't interrupt idle/charging (charge, clean, rebalance).
  static bool IsIdleBackgroundJobType(uint8_t jobtype) {
    return jobtype == SchedulerJobMsg::TYPE_CHARGE_AGV || jobtype == SchedulerJobMsg::TYPE_CLEAN_GARAGE ||
           jobtype == SchedulerJobMsg::TYPE_REBALANCE_GARAGE;
  }

  void UpdateIdleStartTime(const rclcpp::Time& now);

  // Returns true if this pending job be given to the planner to plan
  bool ShouldPendingJobBePlanned(const GuidMsg& pending_job_id) const;

  void CompleteJobs(const rclcpp::Time& now);
  void DispatchReadyCommands();

  // Make a message containing a list of jobs for debug publishing
  SchedulerJobListMsg MakeJobListMessage(const rclcpp::Time& now, const std::vector<GuidMsg>& guids) const;

  // Helper function that does everything necessary when a plan response gets rejected: undo the
  // schedule split, reset the last plan call data, and log a warn message
  void RejectPlanResponse(std::string warn_message);

  // Fraction (0.0-1.0) of TYPE_WAYPOINT nodes currently occupied by a tray. Gates whether
  // an idle garage is worth queueing a CleanGarageJob for.
  double GarageDirtiness();

private:
  CommandSendSPtr command_send_;
  rclcpp::Logger logger_;
  // Whether we display extra information

  // The dispatcher's current behavior status.
  //     STOPPED if all AGVs are inactive and all bays are in READY_TO_RETRIEVE
  //     STOPPING if trying to reach STOPPED.
  //       NOTE can re-enter STOPPING if already stopped if conditions not met.
  //     RUNNING if in normal operation
  //     STARTING if trying to get all AGVs into ACTIVE and all bays into READY_TO_RETRIEVE
  //     PAUSED if temporarily halting normal operation - does not dispatch new commands
  Status status_ = Status::STOPPING;

  // The dispatcher's current mode.
  //     AUTO - The system schedules retrieve and repark tray jobs and maintains our garage
  //            invariants. It will automatically charge AGVs when idle.
  //     MANUAL - The system schedules manual jobs.
  Mode mode_ = Mode::MANUAL;

  // The time at which we became idle; used to time out
  std::optional<rclcpp::Time> time_became_idle_;

  // The time at which we entered STARTING; used to time out
  std::optional<rclcpp::Time> time_enter_starting_;

  // Data from the last plan request used to validate the response. This value is nullopt if there
  // is no ongoing plan call
  std::optional<LastPlanCallData> plan_call_data_;

  // Whether our discrete garage state is currently invalid
  bool discrete_garage_state_diverged_ = true;

  // The id of our installation - issued in the heartbeat
  uint32_t installation_id_;

  // Our latest consistency report
  ConsistencyReportMsg consistency_report_;

  // Our latest continuous garage info
  ContinuousGarageInfoMsg continuous_garage_info_;

  // Maintain the discrete state of the garage
  volley::DiscreteGarageState discrete_garage_state_;

  // Garage pose graph and its md5sum
  std::string layout_md5sum_;
  PoseGraphCSPtr pose_graph_;

  // The active execution state, if any. This object contains our schedule
  ExecutionStateSPtr exec_state_;

  // Map of job GUIDs to all job structs
  std::map<GuidMsg, std::unique_ptr<Job>, volley::GuidComparator> jobs_;

  // List of jobs that are to be scheduled, in the order received.
  std::vector<GuidMsg> jobs_pending_;
  std::map<GuidMsg, int32_t, volley::GuidComparator> jobs_pending_retry_count_;
  std::map<GuidMsg, int32_t, volley::GuidComparator> jobs_requeue_count_;

  // GUIDs of pending jobs that were included in the most recent plan request sent to the
  // scheduler.  Populated in GetPlannerServiceRequest(), cleared when the plan response is
  // processed or rejected.  RemovePendingJobsType() skips any GUID present here: removing
  // a job that the scheduler is actively planning causes "Planner returned unknown job id",
  // leaves jobs_active_ empty, and the next request omits the base_schedule — which makes
  // the scheduler re-plan the AGV from scratch, appending a duplicate trajectory into an
  // exec_state that already has those motions committed and triggering divergence.
  std::vector<GuidMsg> jobs_in_flight_;

  // List of scheduled / active jobs, in the order they became active.
  std::vector<GuidMsg> jobs_active_;
  size_t previous_size_jobs_active_ = 0;

  // List of completed job GUIDs, in the order they were completed.
  std::vector<GuidMsg> jobs_completed_;

  volley::GarageGraph gg_;

  volley::CollisionTable collision_table_;

  mutable int32_t agvs_active_ = 0;          // Count, valid if there is an exec_state_
  mutable int32_t agvs_not_busy_count_ = 0;  // Count is updated in ShouldCallPlanner()

  // For the pending jobs, there are different ways to request a plan from the scheduler.
  PlanRequestStrategy plan_request_strategy_default_ = PlanRequestStrategy::PLAN_JOBS_UNLIMITED;
  PlanRequestStrategy plan_request_strategy_ = PlanRequestStrategy::PLAN_JOBS_UNLIMITED;
  int32_t max_plan_request_jobs_ = -1;  // -1 means unlimited

  // Pending jobs can be planned even if there are already executing jobs.
  // Configurable via a parameter: Don't plan if there are already executing jobs.
  bool enable_overlapping_planning_ = false;

  bool enable_dispatch_charging_mode_ = true;

  double garage_dirtiness_threshold_ratio_ = 0.10;

  // True once a CleanGarageJob is queued this idle episode; RegisterPendingJob clears it on real work.
  bool queued_idle_clean_ = false;

  // True once a settle RebalanceGarageJob is queued this idle episode; cleared the same way.
  bool queued_idle_rebalance_ = false;

  // Log the schedule DAGs. Not high performance, so off by default.
  // Requires: sudo apt-get install libgraph-easy-perl
  mutable bool printdags_ = false;
};

}  // namespace volley
</file>

<file path="include/central/execution_garage_state.hpp">
#pragma once
#include <central/central_msgs.hpp>
#include <common/types.hpp>
#include <common_ros/discrete_garage_state.hpp>
#include <common_ros/pose_graph.hpp>
#include <common_ros/print_utils.hpp>
#include <optional>

namespace volley {

// Represents a discrete garage state for the dispatcher.
// The execution garage state is advanced according to the dispatcher's schedule.
class ExecutionGarageState {
public:
  ExecutionGarageState(const volley::DiscreteGarageState& garage_state, PoseGraphCSPtr pose_graph);

  // Apply the given action node to our execution state
  BoolStringPair Apply(const ActionNodeMsg& node);

  // Apply the given discrete garage event to our discrete garage state
  // We only allow a specific subset of events.
  BoolStringPair OnEvent(const BayStateChangedMsg& bay_state_changed);
  BoolStringPair OnEvent(const PayloadExistenceChangedMsg& payload_existence_changed);
  BoolStringPair OnEvent(const VecsStateChangedMsg& vecs_state_changed);
  BoolStringPair OnEvent(const VrcStateChangedMsg& vrc_state_changed);
  BoolStringPair OnEvent(const AgvPoseChangedMsg& agv_pose_changed);
  BoolStringPair OnEvent(const TrayPoseSetManuallyMsg& tray_pose_set_manually);

  // Getters
  const volley::DiscreteGarageState& GetGarageState() const { return garage_state_; }
  const PoseGraphCSPtr& GetPoseGraph() const { return pose_graph_; }

private:
  // Get the resource size index for the given tray, which depends on the size of its payload.
  // Returns kInvalidIndex if the resource size is invalid (i.e., payload is too large).
  std::optional<int> GetTrayResourceSizeIndex(const DiscreteTrayStateMsg& tray);

  // The garage state
  volley::DiscreteGarageState garage_state_;

  // Our pose graph
  PoseGraphCSPtr pose_graph_;

  friend std::pair<std::optional<ExecutionGarageState>, std::string> CreateExecutionGarageState(
      const volley::DiscreteGarageState& garage_state, PoseGraphCSPtr pose_graph);
};

// Create an execution garage state. Note that creation can fail, for example,
// if two AGVs overlap. We return both an optional, which contains the created execution
// garage state if we succeeded, and a string that can contain an error message.
std::pair<std::optional<ExecutionGarageState>, std::string> CreateExecutionGarageState(
    const volley::DiscreteGarageState& garage_state, PoseGraphCSPtr pose_graph);

}  // namespace volley
</file>

