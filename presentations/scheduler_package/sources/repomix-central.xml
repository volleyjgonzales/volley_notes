#include <central/central_msgs.hpp>
#include <central/execution_garage_state.hpp>
#include <common/math_utils.hpp>
#include <common_ros/pose_utils.hpp>
#include <common_ros/ros_utils.hpp>
#include <vrc_interfaces/msg/vrc_state.hpp>

namespace volley {

std::pair<std::optional<ExecutionGarageState>, std::string> CreateExecutionGarageState(
    const volley::DiscreteGarageState& garage_state, PoseGraphCSPtr pose_graph) {
  ExecutionGarageState exec(garage_state, pose_graph);

  // Verify that AGV and tray poses are valid
  for(const auto& [agv_id, agv] : garage_state.GetAgvs()) {
    int pose_index = pose_graph->GetPoseIndex(agv.pose);
    if(pose_index == volley::kInvalidIndex) {
      return std::make_pair(
          std::nullopt, "Pose invalid for a" + std::to_string(agv_id) + ": " + std::to_string(agv.pose));
    }
  }

  for(const auto& [tray_id, tray] : garage_state.GetTrays()) {
    int pose_index = pose_graph->GetPoseIndex(tray.pose);
    if(pose_index == volley::kInvalidIndex) {
      return std::make_pair(std::nullopt,
          "Pose invalid for tray " + std::to_string(tray_id) + ": " + std::to_string(tray.pose));
    }
    // Determine the resource size (note: for now this just makes sure payloads are valid sizes)
    auto resource_size_index_tray_opt = exec.GetTrayResourceSizeIndex(tray);
    if(!resource_size_index_tray_opt.has_value()) {
      return std::make_pair(std::nullopt,
          "Failed to get tray resource size index for tray with payload " + std::to_string(tray.payload_id));
    }
  }

  // TODO(any) make sure there are no colliding entities (AGV-AGV, AGV-tray leg, tray-tray,
  // ODP-AGV, etc)

  for(const auto& node_id : garage_state.GetDisabledNodes()) {
    // Make sure disabled nodes are valid
    auto node_opt = pose_graph->GetLayout()->GetNodeById(node_id);
    if(!node_opt.has_value()) {
      return std::make_pair(std::nullopt, "Disabled node " + std::to_string(node_id) + "does not exist!");
    }
    // TODO(any) handle disabled nodes
  }

  std::optional<ExecutionGarageState> retval = exec;
  return std::make_pair(retval, "");
}

ExecutionGarageState::ExecutionGarageState(
    const volley::DiscreteGarageState& garage_state, PoseGraphCSPtr pose_graph) :
    pose_graph_(pose_graph) {
  garage_state_.Set(garage_state);
}

BoolStringPair ExecutionGarageState::Apply(const ActionNodeMsg& node) {
  if(node.type == ActionNodeMsg::TYPE_AGV_COMMAND) {
    auto agv_opt = garage_state_.GetAgv(node.agv_id);
    if(!agv_opt.has_value()) {
      return std::make_pair(false, "Failed to look up a" + std::to_string(node.agv_id) +
                                       " while propagating AGV command " + std::to_string(node.guid));
    }

    if(node.agv_command.dst.lift != node.agv_command.src.lift) {
      AgvLiftChangedMsg agv_lift_changed {};
      agv_lift_changed.agv_id = node.agv_id;
      agv_lift_changed.raised = node.agv_command.dst.lift;

      auto [success, message] = garage_state_.OnEvent(agv_lift_changed);
      if(!success) {
        return std::make_pair(false, "Failed to apply AGV lift changed for a" + std::to_string(node.agv_id) +
                                         " while propagating AGV command " + std::to_string(node.guid) +
                                         ": " + message);
      }
    }
    else if(node.agv_command.dst.pose != node.agv_command.src.pose) {
      // This is a pose change

      // TODO(any) make sure the AGV's path is collision free (including path for tray
      // if carrying one)

      AgvPoseChangedMsg agv_pose_changed {};
      agv_pose_changed.agv_id = node.agv_id;
      agv_pose_changed.node_id_curr = agv_opt->pose.node_id;
      agv_pose_changed.heading_curr = agv_opt->pose.heading;
      agv_pose_changed.node_id_next = node.agv_command.dst.pose.node_id;
      agv_pose_changed.heading_next = node.agv_command.dst.pose.heading;

      auto [success, message] = garage_state_.OnEvent(agv_pose_changed);
      if(!success) {
        return std::make_pair(false, "Failed to apply AGV pose changed to " +
                                         std::to_string(node.agv_command.dst.pose) + " for a" +
                                         std::to_string(node.agv_id) + " while propagating AGV command " +
                                         std::to_string(node.guid) + ": " + message);
      }
    }
    else {
      return std::make_pair(false, "Invalid AGV Command for a" + std::to_string(node.agv_id) +
                                       " while propagating node " + std::to_string(node.guid) + ": " +
                                       std::to_string(node.agv_command.src) + " -> " +
                                       std::to_string(node.agv_command.dst));
    }
  }
  else if(node.type == ActionNodeMsg::TYPE_BAY_COMMAND) {
    auto bay_opt = garage_state_.GetBay(node.bay_id);
    if(!bay_opt.has_value()) {
      return std::make_pair(false, "Failed to look up b" + std::to_string(node.bay_id) +
                                       " while propagating bay command " + std::to_string(node.guid));
    }

    // All valid bay commands result in a state change
    BayStateChangedMsg bay_state_changed {};
    bay_state_changed.bay_id = node.bay_id;
    bay_state_changed.state_curr = bay_opt->state;

    // TODO(any) make sure bay state changed does not result in collision (ODP)

    if(node.bay_command.command_type == BayCommandMsg::COMMAND_TYPE_PROCESS_RETRIEVE) {
      bay_state_changed.state_next = BayReportMsg::STATE_READY_TO_INSERT;
      if(bay_opt->state != bay_state_changed.state_next) {
        // NOTE - if we are sending a process retrieve command, the bay is very likely
        //        already ready to retrieve.
        auto [success, message] = garage_state_.OnEvent(bay_state_changed);
        if(!success) {
          return std::make_pair(false,
              "Failed to apply bay state changed to READY_TO_INSERT "
              "for b" +
                  std::to_string(node.bay_id) + " while propagating PROCESS_RETRIEVE bay command " +
                  std::to_string(node.guid) + ": " + message);
        }
      }
    }
    else if(node.bay_command.command_type == BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT) {
      bay_state_changed.state_next = BayReportMsg::STATE_READY_TO_INSERT;
      auto [success, message] = garage_state_.OnEvent(bay_state_changed);
      if(!success) {
        return std::make_pair(false, "Failed to apply bay state changed to READY_TO_INSERT for b" +
                                         std::to_string(node.bay_id) +
                                         " while propagating TRANSITION_TO_INSERT bay command " +
                                         std::to_string(node.guid) + ": " + message);
      }
    }
    else if(node.bay_command.command_type == BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE) {
      bay_state_changed.state_next = BayReportMsg::STATE_READY_TO_RETRIEVE;
      auto [success, message] = garage_state_.OnEvent(bay_state_changed);
      if(!success) {
        return std::make_pair(false, "Failed to apply bay state changed to READY_TO_RETRIEVE for b" +
                                         std::to_string(node.bay_id) +
                                         " while propagating TRANSITION_TO_RETRIEVE bay command " +
                                         std::to_string(node.guid) + ": " + message);
      }
    }
    else {
      return std::make_pair(false,
          "Unknown bay command type " + std::to_string(node.bay_command.command_type) + " for b" +
              std::to_string(node.bay_id) + " while propagating bay command " + std::to_string(node.guid));
    }
  }
  else if(node.type == ActionNodeMsg::TYPE_VECS_COMMAND) {
    auto vecs_opt = garage_state_.GetVecs(node.vecs_id);
    if(!vecs_opt.has_value()) {
      return std::make_pair(false, "Failed to look up v" + std::to_string(node.vecs_id) +
                                       " while propagating VECS command " + std::to_string(node.guid));
    }

    // All valid VECS commands result in a state change
    VecsStateChangedMsg vecs_state_changed {};
    vecs_state_changed.vecs_id = node.vecs_id;
    vecs_state_changed.state_curr = vecs_opt->state;

    if(node.vecs_command.command_type == VecsCommandMsg::COMMAND_TYPE_START_CHARGING) {
      vecs_state_changed.state_next = VecsReportMsg::CHARGING;
      auto [success, message] = garage_state_.OnEvent(vecs_state_changed);

      if(!success) {
        return std::make_pair(false,
            "Failed to apply VECS state changed to CHARGING "
            "for v" +
                std::to_string(node.vecs_id) + " while propagating START_CHARGING VECS command " +
                std::to_string(node.guid) + ": " + message);
      }
    }
    else if(node.vecs_command.command_type == VecsCommandMsg::COMMAND_TYPE_STOP_CHARGING) {
      vecs_state_changed.state_next = VecsReportMsg::READY_TO_CHARGE;
      auto [success, message] = garage_state_.OnEvent(vecs_state_changed);
      if(!success) {
        return std::make_pair(false, "Failed to apply VECS state changed to READY TO CHARGE for v" +
                                         std::to_string(node.vecs_id) +
                                         " while propagating STOP_CHARGING VECS command " +
                                         std::to_string(node.guid) + ": " + message);
      }
    }
    else {
      return std::make_pair(false,
          "Unknown VECS command type " + std::to_string(node.vecs_command.command_type) + " for v" +
              std::to_string(node.vecs_id) + " while propagating VECS command " + std::to_string(node.guid));
    }
  }
  else if(node.type == ActionNodeMsg::TYPE_VRC_COMMAND) {
    auto vrc_opt = garage_state_.GetVrc(node.vrc_id);
    if(!vrc_opt.has_value()) {
      return std::make_pair(false, "Failed to look up r" + std::to_string(node.vrc_id) +
                                       " while propagating VRC command " + std::to_string(node.guid));
    }

    // If the VRC is already IDLE at the target floor, this is a no-op
    if(vrc_opt->state.value == vrc_interfaces::msg::VrcState::STATE_IDLE &&
        vrc_opt->current_floor == node.vrc_command.requested_floor) {
      return std::make_pair(true, "");
    }

    // If the VRC is IDLE, first transition it to MOVING
    if(vrc_opt->state.value == vrc_interfaces::msg::VrcState::STATE_IDLE) {
      VrcStateChangedMsg to_moving;
      to_moving.current_discrete_state = vrc_opt.value();
      to_moving.next_discrete_state = vrc_opt.value();
      to_moving.next_discrete_state.state.value = vrc_interfaces::msg::VrcState::STATE_MOVING;
      to_moving.next_discrete_state.requested_floor = node.vrc_command.requested_floor;
      auto [success, message] = garage_state_.OnEvent(to_moving);
      if(!success) {
        return std::make_pair(false, "Failed to apply VRC transition to MOVING for r" +
                                         std::to_string(node.vrc_id) + " while propagating VRC command " +
                                         std::to_string(node.guid) + ": " + message);
      }
      vrc_opt = garage_state_.GetVrc(node.vrc_id);
    }

    // Transition to IDLE at the requested floor
    VrcStateChangedMsg to_idle;
    to_idle.current_discrete_state = vrc_opt.value();
    to_idle.next_discrete_state = vrc_opt.value();
    to_idle.next_discrete_state.state.value = vrc_interfaces::msg::VrcState::STATE_IDLE;
    to_idle.next_discrete_state.current_floor = node.vrc_command.requested_floor;
    to_idle.next_discrete_state.requested_floor = node.vrc_command.requested_floor;
    auto [success, message] = garage_state_.OnEvent(to_idle);
    if(!success) {
      return std::make_pair(false, "Failed to apply VRC transition to IDLE for r" +
                                       std::to_string(node.vrc_id) + " while propagating VRC command " +
                                       std::to_string(node.guid) + ": " + message);
    }
  }
  else {
    return std::make_pair(false, "Unknown node type " + std::to_string(node.type));
  }

  // success
  return std::make_pair(true, "");
}

BoolStringPair ExecutionGarageState::OnEvent(const BayStateChangedMsg& bay_state_changed) {
  auto [success, message] = garage_state_.OnEvent(bay_state_changed);
  if(!success) {
    return std::make_pair(false, "Failed to apply BayStateChanged event: " + message);
  }

  return std::make_pair(true, "");
}

