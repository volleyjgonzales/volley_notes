void Dispatch::PlanClientCallback(PlanSrv::Response::SharedPtr plan_response, const rclcpp::Time& now) {
  // Ensure that we have a valid execution state
  if(exec_state_ == nullptr) {
    RejectPlanResponse("Received plan response when we do not have an execution state! Plan call ID: " +
                       std::to_string(plan_response->response_data.id));
    return;
  }

  // Ensure that the id matches the id of the last plan request sent
  if(!plan_call_data_.has_value()) {
    RejectPlanResponse(
        "Received plan response when there is no ongoing plan call! Rejecting plan response. "
        "Plan call ID: " +
        std::to_string(plan_response->response_data.id));
    return;
  }
  else if(plan_call_data_->plan_call_id != plan_response->response_data.id) {
    RejectPlanResponse("ID of plan response " + std::to_string(plan_response->response_data.id) +
                       " does not match ongoing plan call request id! " +
                       std::to_string(plan_call_data_->plan_call_id) + " Rejecting plan response.");
    return;
  }

  // Ensure the plan was successful
  if(!plan_response->response_data.success) {
    RejectPlanResponse("Plan was not successful: " + plan_response->response_data.message +
                       " Plan call ID: " + std::to_string(plan_response->response_data.id));
    return;
  }

  // Ensure that our current execution plan has not diverged
  if(exec_state_->IsDiverged()) {
    RejectPlanResponse("The current execution plan has diverged. Cannot accept new plan. Plan call ID: " +
                       std::to_string(plan_response->response_data.id));
    return;
  }

  {
    // We need to verify that the plan response includes the base schedule given in the plan
    // request. The base schedule is defined in the request as the nodes in the existing
    // schedule that are inside the schedule split. We assume that some or all of these nodes
    // are executed during the plan call, so they must be included in the new schedule.
    auto& base_schedule = plan_call_data_->base_schedule;
    for(const auto& new_schedule_node : plan_response->response_data.schedule.nodes) {
      // We expect the new schedule to have nodes that don't exist in the base schedule.
      if(base_schedule.find(new_schedule_node.guid) == base_schedule.end()) {
        continue;
      }
      const auto& base_schedule_node = base_schedule.at(new_schedule_node.guid);
      if(base_schedule_node != new_schedule_node) {
        RejectPlanResponse(
            "ActionNode in plan response has same guid but differing values from a node in "
            "the base schedule! Plan call ID: " +
            std::to_string(plan_response->response_data.id) +
            " |Base schedule node: " + std::to_string(base_schedule_node) +
            " |Plan response node: " + std::to_string(new_schedule_node));
        return;
      }
      // Remove it, so later we can make sure they're all accounted for
      base_schedule.erase(new_schedule_node.guid);

      // No need to keep iterating if the base schedule is empty
      if(base_schedule.size() == 0) {
        break;
      }
    }

    // We have looked through the entire new schedule. If any nodes in the base schedule are
    // unaccounted for in the new schedule, then we have to reject the entire plan response
    if(base_schedule.size() != 0) {
      RejectPlanResponse("Not every node in the base schedule exists in the plan response schedule! " +
                         std::to_string(base_schedule.size()) + " nodes are unaccounted for. Plan call ID: " +
                         std::to_string(plan_response->response_data.id));
      return;
    }
  }

  // Was there multiple jobs in the request?
  if(plan_response->response_data.scheduled_jobs.size() > 1) {
    // What if all the jobs in the request have failed to plan?
    // Do not just throw away Retrieve jobs while patrons are waiting.
    // Patrons should not have to request to retrieve their car more than once.
    bool all_jobs_failed = true;
    for(const auto& scheduled_job : plan_response->response_data.scheduled_jobs) {
      if(scheduled_job.job.state != SchedulerJobMsg::STATE_ERROR) {
        all_jobs_failed = false;
        break;
      }
    }
    if(all_jobs_failed) {
      // Get the first job in the pending list.
      GuidMsg jobguid = jobs_pending_.front();
      int32_t retry_count = jobs_pending_retry_count_[jobguid];

      INFOF(logger_, " - - - PlanClientCallback  numjobs=%ld  retry_count=%d",
          plan_response->response_data.scheduled_jobs.size(), retry_count);

      // Increment the retry count for this job.
      retry_count += 1;
      jobs_pending_retry_count_[jobguid] = retry_count;

      // Did it exceed the max retries?
      if(retry_count > kMaxPlanRetries) {
        // Round-robin the jobs: Move the first job to the end of the pending list.
        jobs_pending_.erase(jobs_pending_.begin());
        jobs_pending_.emplace_back(jobguid);
        jobs_requeue_count_[jobguid]++;
      }

      RejectPlanResponse(
          "All jobs in the planning request have failed to plan. Will try again with reduced complexity of "
          "the request.");

      // Now try again.
      NextSimplerPlanRequestStrategy();
      plan_call_data_.reset();
      return;
    }
  }

  // Jobs planned in the request did not fail.
  jobs_pending_retry_count_.clear();

  // Create a new execution state from the response
  const auto& response_nodes = plan_response->response_data.schedule.nodes;
  auto [exec_state, message] = CreateExecutionStatePtr(exec_state_->GetLatest(), exec_state_->GetSchedule(),
      response_nodes, command_send_, gg_, collision_table_);
  if(exec_state == nullptr) {
    // If we hit any inconsistencies / invalid conditions, simply return and do not modify
    // our existing execution state
    RejectPlanResponse("Failed to construct new execution state from plan response: " + message);
    return;
  }

  // Set the new state
  exec_state_ = exec_state;
  exec_state_->printdags_ = printdags_;

  std::vector<GuidMsg> retry_jobs_pending;

  // The response includes all newly scheduled jobs.
  // Move them to active or failed, as appropriate.
  for(const auto& scheduled_job : plan_response->response_data.scheduled_jobs) {
    // Ensure this job already exists
    const auto& guid = scheduled_job.job.guid;
    if(!HasJob(guid)) {
      WARNS(logger_, "Planner returned unknown job id " << std::to_string(guid));
      continue;
    }

    // Find the job and its pending or active job index
    auto& job = jobs_.at(guid);
    std::optional<int> pending_job_index_opt = 0;
    std::optional<int> active_job_index_opt = 0;
    while(pending_job_index_opt < static_cast<int>(jobs_pending_.size()) &&
          jobs_pending_.at(pending_job_index_opt.value()) != guid) {
      pending_job_index_opt.value()++;
    }
    if(pending_job_index_opt >= static_cast<int>(jobs_pending_.size())) {
      pending_job_index_opt = std::nullopt;

      // Job is not in pending jobs list. Search for it in active jobs.
      active_job_index_opt.value() = 0;
      while(active_job_index_opt.value() < static_cast<int>(jobs_active_.size()) &&
            jobs_active_.at(active_job_index_opt.value()) != guid) {
        active_job_index_opt.value()++;
      }
      if(active_job_index_opt.value() >= static_cast<int>(jobs_active_.size())) {
        active_job_index_opt = std::nullopt;
        WARNS(logger_, "Could not find pending or active job associated with id " << std::to_string(guid));
        continue;
      }
    }

    // Update the job's note
    job->SetNote(scheduled_job.job.note);

    // Update the job based on the newly reported state
    auto new_state = common::EnumCast<JobState>(scheduled_job.job.state).value_or(JobState::ERROR);
    if(new_state == JobState::EXECUTING) {
      // Job is now executing
      job->OnExecuting(now);

      // Move the job to active if it's pending
      if(pending_job_index_opt.has_value()) {
        jobs_pending_.erase(jobs_pending_.begin() + pending_job_index_opt.value());
        jobs_active_.emplace_back(guid);
      }

      // Remove the job_id from the requeue map if it was ever requeued
      jobs_requeue_count_.erase(guid);

      // Create the active job data entry
      std::vector<GuidMsg> execution_nodes_to_complete;
      for(uint32_t node_index_in_resp : scheduled_job.node_indices) {
        if(node_index_in_resp >= response_nodes.size()) {
          exec_state_.reset();  // diverged
          RejectPlanResponse("Execution State has diverged! Scheduled job " + std::to_string(guid) +
                             " had invalid node index to complete " + std::to_string(node_index_in_resp) +
                             " Plan call ID: " + std::to_string(plan_response->response_data.id));
          return;
        }
        execution_nodes_to_complete.emplace_back(response_nodes.at(node_index_in_resp).guid);
      }
      job->SetExecutionNodesToComplete(execution_nodes_to_complete);

      // Extract any scheduled job data
      if(job->GetType() == SchedulerJobMsg::TYPE_RETRIEVE) {
        auto& retrieve_job = dynamic_cast<RetrieveJob&>(*job);
        retrieve_job.SetPlannedData(scheduled_job.bay_id, scheduled_job.bay_arrival_node_guid);
      }
    }
    else if(new_state == JobState::ERROR) {
      // We failed to plan it.
      // Reset the job, or error it out if it should not be retained.
      // If the job should be retained, check if it's a retrieve that needs a bay transitioned
      // If it's not being retained, remove the job from pending
      std::string retention = " Job was not retained.";
      if(scheduled_job.job.retain_job && job->GetType() == SchedulerJobMsg::TYPE_RETRIEVE) {
        // Special case: Scheduler indicated a bay is needed for Retrieve.
        auto& retrieve_job = dynamic_cast<RetrieveJob&>(*job);
        retrieve_job.SetNeedsBayInRetrieve(scheduled_job.job.needs_bay_in_retrieve);
        retention = " Retrieve Job has been retained, waiting for a bay to be available.";
      }
      else if(job->GetType() == SchedulerJobMsg::TYPE_RETRIEVE) {
        // Do not just throw away Retrieve jobs while patrons are waiting.
        // Instead, re-queue the Retrieve job to be re-planned, up to a limit.
        const int32_t requeue_count = ++jobs_requeue_count_[guid];
        if(requeue_count > kMaxRequeueRetries) {
          job->SetNote(job->GetNote() + " | Max requeue retries exceeded");
          job->OnError(now);
          // Complete the job with error state
          jobs_pending_.erase(jobs_pending_.begin() + pending_job_index_opt.value());
          jobs_completed_.emplace_back(guid);
          jobs_requeue_count_.erase(guid);
          retention = " Retrieve Job errored out after exceeding max requeue retries (" +
                      std::to_string(kMaxRequeueRetries) + ").";
        }
        else {
          retry_jobs_pending.emplace_back(scheduled_job.job.guid);
          jobs_pending_.erase(jobs_pending_.begin() + pending_job_index_opt.value());
          retention = " Retrieve Job has been retained, moving to end of queue (" +
                      std::to_string(requeue_count) + "/" + std::to_string(kMaxRequeueRetries) + ").";
        }
      }
      else {
        // Complete the job with the error state
        job->OnError(now);
        if(pending_job_index_opt.has_value()) {
          jobs_pending_.erase(jobs_pending_.begin() + pending_job_index_opt.value());
        }
        else {
          jobs_active_.erase(jobs_active_.begin() + active_job_index_opt.value());
        }
        jobs_completed_.emplace_back(guid);
      }
      WARNS(logger_, "Failed to plan " << job->GetName() << " job: [" << job->GetPrintInfo()
                                       << "], job ID: " << std::to_string(guid) << ": " << job->GetNote()
                                       << " | " << retention);
    }
    else {
      WARNS(logger_, "Pending job " << std::to_string(guid) << " unexpectedly in state "
                                    << common::EnumNameString(job->GetState()) << "! Erroring out job.");

      // Error out the job as a precaution
      job->OnError(now);
      job->SetNote(job->GetNote() + " and errored out due to unexpected state");
      if(pending_job_index_opt.has_value()) {
        jobs_pending_.erase(jobs_pending_.begin() + pending_job_index_opt.value());
      }
      else {
        jobs_active_.erase(jobs_active_.begin() + active_job_index_opt.value());
      }
      jobs_completed_.emplace_back(guid);
    }
  }

  // Add retrys back into the pending list.
  for(const auto& retry_job_guid : retry_jobs_pending) {
    // Re-queue the job to be re-planned
    jobs_pending_.emplace_back(retry_job_guid);
  }

  // Update all active jobs, if needed
  for(const auto& active_job_guid : jobs_active_) {
    auto& job = jobs_.at(active_job_guid);
    if(job->GetType() == SchedulerJobMsg::TYPE_RETRIEVE) {
      // Update the seconds to bay arrival
      // NOTE: We only update this value when we receive new plans.
      //       We really should be updating the schedule times periodically, as we continue to
      //       advance through time irrespective of whether we get plan callbacks.
      auto& retrieve_job = dynamic_cast<RetrieveJob&>(*job);

      retrieve_job.SetSecondsToBayArrival(0.0);
      auto node_index_opt = exec_state_->GetSchedule().GetNodeByGuid(retrieve_job.GetBayArrivalNodeGuid());
      if(node_index_opt.has_value()) {
        retrieve_job.SetSecondsToBayArrival(
            exec_state_->GetSchedule().GetNodeStartTime(node_index_opt.value()));
      }
    }
  }

  // Dispatch any commands that are then immediately available
  DispatchReadyCommands();

  // Reset the last plan call data so another plan request can go through
  plan_call_data_.reset();
  jobs_in_flight_.clear();
}

void Dispatch::MainTimerCallback(const rclcpp::Time& now) {
  // Print the status
  if(logger_.get_effective_level() == Level::Debug) {
    LogState();
    LogJobs();
    LogScheduleProgress();
    LogGarageStateAgvsAndBays(discrete_garage_state_);
  }

  // Automatically stop if our execution state diverged, if our continuous garage info is stale,
  // if any active enabled AGVs timed out, if any bay timed out, or our garage has faulted.
  bool continuous_garage_info_timed_out = IsContinuousGarageInfoStale(now);

  bool any_active_enabled_agv_timed_out = false;
  std::string stale_agvs = "";
  for(const auto& agv_info : continuous_garage_info_.agvs) {
    auto agv_opt = discrete_garage_state_.GetAgv(agv_info.report.agv_id);
    // NOTE: If lookup fails, we assume it is an old AGV that is not in our discrete state,
    //       so we can safely ignore it. The discrete state is the source of truth.
    if(agv_opt.has_value() && !agv_opt->disabled && agv_opt->state == AgvReportMsg::STATE_ACTIVE &&
        (agv_info.staleness > volley::ChronoDurationToSeconds(central::kAgvUpdateStaleness))) {
      any_active_enabled_agv_timed_out = true;
      stale_agvs += "a" + std::to_string(agv_info.report.agv_id) + " ";
    }
  }

  bool any_enabled_bay_timed_out = false;
  std::string stale_bays = "";
  for(const auto& bay_info : continuous_garage_info_.bays) {
    auto bay_opt = discrete_garage_state_.GetBay(bay_info.report.bay_id);
    // NOTE: If lookup fails, we assume it is an old bay (for some reason) that is not in our
    // discrete state, so we can safely ignore it. The discrete state is the source of truth.
    // Disabled bays won't be used, so they shouldn't cause the dispatcher to stop
    if(bay_opt.has_value() && !bay_opt->disabled &&
        (bay_info.staleness > volley::ChronoDurationToSeconds(central::kBayUpdateStaleness))) {
      any_enabled_bay_timed_out = true;
      stale_bays += "b" + std::to_string(bay_info.report.bay_id) + " ";
    }
  }

  bool any_enabled_vecs_timed_out = false;
  std::string stale_vexen = "";
  for(const auto& vecs_info : continuous_garage_info_.vexen) {
    auto vecs_opt = discrete_garage_state_.GetVecs(vecs_info.report.vecs_id);
    // NOTE: If lookup fails, we assume it is an old VECS (for some reason) that is not in our
    // discrete state, so we can safely ignore it. The discrete state is the source of truth.
    // Disabled vexen won't be used, so they shouldn't cause the dispatcher to stop
    if(vecs_opt.has_value() && !vecs_opt->disabled &&
        (vecs_info.staleness > volley::ChronoDurationToSeconds(central::kVecsUpdateStaleness))) {
      any_enabled_vecs_timed_out = true;
      stale_vexen += "v" + std::to_string(vecs_info.report.vecs_id) + " ";
    }
  }

  bool exec_state_diverged = exec_state_ != nullptr && exec_state_->IsDiverged();

  if(continuous_garage_info_timed_out || any_active_enabled_agv_timed_out || any_enabled_bay_timed_out ||
      exec_state_diverged || discrete_garage_state_.IsFaulted() || not consistency_report_.consistent) {
    if(status_ != Status::STOPPING) {
      // clang-format off
      WARNS(logger_,
        "Stopping! The following condition(s) caused the change to stopping: "
          << (continuous_garage_info_timed_out ? " Continuous garage info timed out." : "")
          << (any_active_enabled_agv_timed_out ? " Any active enabled AGV timed out: " + stale_agvs : "")
          << (any_enabled_bay_timed_out ? " Any enabled bay timed out: " + stale_bays : "")
          << (any_enabled_vecs_timed_out ? " Any enabled VECS timed out: " + stale_vexen : "")
          << (exec_state_diverged ? " Execution state diverged." : "")
          << (discrete_garage_state_.IsFaulted() ? " Garage faulted." : "")
          << (!consistency_report_.consistent ? " Consistency report inconsistent." : ""));
      // clang-format on
    }
    status_ = Status::STOPPING;
  }

  // Act based on status
  if(status_ == Status::STARTING) {
    ActOnStarting(now);
  }
  else if(status_ == Status::RUNNING) {
    ActOnRunning(now);
  }
  else if(status_ == Status::STOPPING || status_ == Status::STOPPED) {
    ActOnStoppedOrStopping(now);
  }
  else if(status_ == Status::PAUSED) {
    // do nothing
  }
}

GuidMsg Dispatch::GenerateGuid(const rclcpp::Time& time) {
  static uint64_t counter = 0;
  counter++;  // increment on every call
  return volley::MakeGuid(counter, time.nanoseconds());
}

bool Dispatch::IsConsistencyReportStale(const rclcpp::Time& now) const {
  auto staleness = volley::GetMessageStaleness(consistency_report_.header, now);
  return staleness > central::kConsistencyReportStaleness;
}

bool Dispatch::IsContinuousGarageInfoStale(const rclcpp::Time& now) const {
  auto staleness = volley::GetMessageStaleness(continuous_garage_info_.header, now);
  return staleness > central::kAgvUpdateStaleness || staleness > central::kBayUpdateStaleness;
}

bool Dispatch::IsAgvGarageInfoStale(uint16_t agv_id) const {
  for(const auto& agv_info : continuous_garage_info_.agvs) {
    if(agv_info.report.agv_id == agv_id) {
      return agv_info.staleness > volley::ChronoDurationToSeconds(central::kAgvUpdateStaleness);
    }
  }
  return true;  // We assume it is stale if it is not found.
}

bool Dispatch::IsBayGarageInfoStale(uint16_t bay_id) const {
  for(const auto& bay_info : continuous_garage_info_.bays) {
    if(bay_info.report.bay_id == bay_id) {
      return bay_info.staleness > volley::ChronoDurationToSeconds(central::kBayUpdateStaleness);
    }
  }
  return true;  // We assume it is stale if it is not found.
}

bool Dispatch::IsVecsGarageInfoStale(uint16_t vecs_id) const {
  for(const auto& vecs_info : continuous_garage_info_.vexen) {
    if(vecs_info.report.vecs_id == vecs_id) {
      return vecs_info.staleness > volley::ChronoDurationToSeconds(central::kVecsUpdateStaleness);
    }
  }
  return true;  // We assume it is stale if it is not found.
}

BoolStringPair Dispatch::CanAcceptAutoJob() const {
  if(status_ != Status::RUNNING && status_ != Status::STARTING) {
    return std::make_pair(false, "Cannot accept auto job if dispatcher is not RUNNING or STARTING. Status=" +
                                     common::EnumNameString(status_));
  }
  else if(mode_ != Mode::AUTO) {
    return std::make_pair(false,
        "Cannot accept auto job if dispatcher is not in AUTO mode. Mode=" + common::EnumNameString(mode_));
  }
  return std::make_pair(true, "");
}

BoolStringPair Dispatch::CanAcceptManualJob() const {
  if(status_ != Status::RUNNING && status_ != Status::STARTING) {
    return std::make_pair(
        false, "Cannot accept manual job if dispatcher is not RUNNING or STARTING. Status=" +
                   common::EnumNameString(status_));
  }
  else if(mode_ != Mode::MANUAL) {
    return std::make_pair(false, "Cannot accept manual job if dispatcher is not in MANUAL mode. Mode=" +
                                     common::EnumNameString(mode_));
  }
  return std::make_pair(true, "");
}

void Dispatch::ActOnRunning(const rclcpp::Time& now) {
  // If needed, initialize our execution state
  if(exec_state_ == nullptr) {
    // Attempt to create an execution state
    std::string message = "";
    std::tie(exec_state_, message) =
        CreateExecutionStatePtr(discrete_garage_state_, pose_graph_, command_send_, gg_, collision_table_);
    if(exec_state_ == nullptr) {
      ERRORS(logger_, "Failed to initialize execution state: " << message);
      return;
    }

    if(mode_ == Mode::AUTO) {
      // Start by cleaning the garage
      auto job = std::make_unique<CleanGarageJob>(GenerateGuid(now), now);
      RegisterPendingJob(std::move(job));
      auto rebalance_job = std::make_unique<RebalanceGarageJob>(GenerateGuid(now), now);
      RegisterPendingJob(std::move(rebalance_job));
    }
  }

  DispatchReadyCommands();
  CompleteJobs(now);

  UpdateIdleStartTime(now);
  ActOnRunningIdle(now);
}

void Dispatch::ActOnRunningIdle(const rclcpp::Time& now) {
  if(mode_ == Mode::AUTO && time_became_idle_.has_value()) {
    const auto cur_idle_time = now - time_became_idle_.value();

    if(enable_dispatch_charging_mode_ && exec_state_ != nullptr && cur_idle_time >= kTimeoutCharge) {
      auto agvs_to_charge = ChargeAgvs(exec_state_->GetFuture().GetGarageState(), pose_graph_,
          continuous_garage_info_.agvs, kAgvLowBattery);
      for(auto agv_id : agvs_to_charge) {
        auto job = std::make_unique<ChargeAgvJob>(GenerateGuid(now), now, agv_id);
        RegisterPendingJob(std::move(job));
      }
    }

    // Queue one CleanGarageJob per idle-and-dirty episode; queued_idle_clean_ prevents repeats.
    if(!queued_idle_clean_ && cur_idle_time >= central::kTimeoutClean) {
      auto job = std::make_unique<CleanGarageJob>(GenerateGuid(now), now);
      RegisterPendingJob(std::move(job));
      queued_idle_clean_ = true;
    }
  }
}

void Dispatch::ActOnStarting(const rclcpp::Time& now) {
  // In the STARTING state, we try to activate all AGVs and get Bays to the correct state.
  // We only reach starting if:
  //   - all enabled AGVs are active, have their lifts down, and have recent reports
  //   - all bays have recent reports and are in READY_TO_RETRIEVE
  // We send activate commands to all AGVs if they are inactive and send lift down
  // commands if their lifts are up. If we succeed, we transition to RUNNING. If we
  // take too long to reach these conditions, we automatically enter STOPPING. Note
  // that we check the state in the garage rather than the latest update. We ignore
  // disabled AGVs.

  // Ensure we have not timed out
  if(!time_enter_starting_.has_value()) {
    time_enter_starting_ = now;
  }
  else if(now - time_enter_starting_.value() > central::kTimeoutStarting) {
    WARNS(logger_, "Stopping due to timeout while entering starting");
    status_ = Status::STOPPING;
    return;
  }

  // Iterate over all AGV commands and activate all inactive, enabled AGVs
  // and send lift actuation commands to any AGV with its lift up.

  bool all_enabled_agvs_are_active = true;
  bool all_enabled_agvs_have_lift_down = true;
  bool all_enabled_agvs_have_recent_reports = true;
  std::string inactive_agvs = "";
  std::string lift_up_agvs = "";
  std::string stale_report_agvs = "";
  for(const auto& [agv_id, agv] : discrete_garage_state_.GetAgvs()) {
    if(!agv.disabled) {
      if(IsAgvGarageInfoStale(agv_id)) {
        all_enabled_agvs_have_recent_reports = false;
        stale_report_agvs += "a" + std::to_string(agv_id) + " ";
      }

      if(agv.state != AgvReportMsg::STATE_ACTIVE) {
        all_enabled_agvs_are_active = false;
        inactive_agvs += "a" + std::to_string(agv_id) + " ";
        command_send_->activateAgv(agv_id);
      }
      else {
        // AGV is ACTIVE. If its lift is up, send a lower command.
        if(agv.lift) {
          all_enabled_agvs_have_lift_down = false;
          lift_up_agvs += "a" + std::to_string(agv_id) + " ";

          INFOF(logger_, "   Dispatch::ActOnStarting  ->sendAgvCommand    lower command - - - agv_id=%d",
              agv_id);

          AgvCommandMsg agv_command {};
          agv_command.id = "dispatch_initial_lower_command";
          agv_command.src.pose = agv.pose;
          agv_command.src.lift = true;
          agv_command.dst.pose = agv.pose;
          agv_command.dst.lift = false;
          command_send_->sendAgvCommand(agv_id, agv_command);
        }
      }
    }
  }

  // Stop all bays and vexen
  MoveAllBaysToStopped(now);
  MoveAllVexenToStopped(now);

  auto [all_bays_in_valid_state, not_stopped_bays] = AreAllBaysStopped();
  auto [all_vexen_in_valid_state, not_stopped_vexen] = AreAllVexenStopped();

  // Iterate over all enabled bays and ensure we have recent reports.
  bool all_bays_have_recent_reports = true;
  std::string stale_report_bays = "";
  for(const auto& [bay_id, bay] : discrete_garage_state_.GetEnabledBays()) {
    if(IsBayGarageInfoStale(bay_id)) {
      all_bays_have_recent_reports = false;
      stale_report_bays = "b" + std::to_string(bay_id) + " ";
    }
  }

  // Iterate over all enabled vexen and ensure we have recent reports
  bool all_vexen_have_recent_reports = true;
  std::string stale_report_vexen = "";
  for(const auto& [vecs_id, vecs] : discrete_garage_state_.GetEnabledVexen()) {
    if(IsVecsGarageInfoStale(vecs_id)) {
      all_vexen_have_recent_reports = false;
      stale_report_vexen = "v" + std::to_string(vecs_id) + " ";
    }
  }

  // If all enabled AGVs are active, we can transition to RUNNING.
  if(all_enabled_agvs_are_active && all_enabled_agvs_have_lift_down && all_enabled_agvs_have_recent_reports &&
      all_bays_have_recent_reports && all_bays_in_valid_state && all_vexen_have_recent_reports &&
      all_vexen_in_valid_state) {
    // Transition to running
    status_ = Status::RUNNING;
    time_became_idle_.reset();

    // When we transition to running, we want to ensure that we have a valid execution state
    ActOnRunning(now);
  }
  else {
    // clang-format off
    INFOS(logger_,
      "Attempting to start the garage. Temporarily blocked because: "
        << (!all_enabled_agvs_are_active ? "Not all AGVs are active yet: " + inactive_agvs : "")
        << (!all_enabled_agvs_have_lift_down ? "Not all enabled AGVs have their lifts down: " + lift_up_agvs : "")
        << (!all_enabled_agvs_have_recent_reports ? "Not all enabled AGVs have recent reports: " + stale_report_agvs : "")
        << (!all_bays_have_recent_reports ? "Not all bays have recent reports: " + stale_report_bays : "")
        << (!all_bays_in_valid_state ? "Not all bays are in the READY_TO_RETRIEVE state: " + not_stopped_bays : "")
        << (!all_vexen_have_recent_reports ? "Not all vexen have recent reports: " + stale_report_vexen : "")
        << (!all_vexen_in_valid_state ? "Not all vexen are in the READY_TO_CHARGE state: " + not_stopped_vexen : ""));
    // clang-format on
  }
}

void Dispatch::ActOnStoppedOrStopping(const rclcpp::Time& now) {
  // In the STOPPED or STOPPING state, we verify that all AGVs are inactive and that
  // all bays are in a static state. We can re-enter STOPPING if any AGVs reactivate
  // for an unforeseen reason.

  // Error out any pending jobs
  for(const auto& pending_job_guid : jobs_pending_) {
    auto& job = jobs_.at(pending_job_guid);
    job->OnError(now);
    jobs_completed_.emplace_back(job->GetGuid());
  }
  jobs_pending_.clear();

  // Error out any active jobs
  for(const auto& active_job_guid : jobs_active_) {
    auto& job = jobs_.at(active_job_guid);
    job->OnError(now);
    jobs_completed_.emplace_back(job->GetGuid());
  }
  jobs_active_.clear();

  // Clear our execution state
  exec_state_.reset();

  // Stop all active AGVs.
  bool all_agvs_inactive = true;
  for(const auto& [agv_id, agv] : discrete_garage_state_.GetAgvs()) {
    if(agv.state == AgvReportMsg::STATE_ACTIVE) {
      command_send_->stopAgv(agv_id);
      all_agvs_inactive = false;
    }
  }

  // Stop all bays
  MoveAllBaysToStopped(now);
  MoveAllVexenToStopped(now);

  auto [all_bays_inactive, _] = AreAllBaysStopped();
  auto [all_vexen_inactive, msg] = AreAllVexenStopped();

  // Set STOPPING / STOPPED based on success.
  // Note that we can re-enter STOPPING if an AGV changes state unexpectedly.
  if(all_agvs_inactive && all_bays_inactive && all_vexen_inactive) {
    status_ = Status::STOPPED;
  }
  else {
    status_ = Status::STOPPING;
  }
}

void Dispatch::UpdateActiveJobsEmpty(const rclcpp::Time& now) {
  if(previous_size_jobs_active_ != 0 && jobs_active_.size() == 0) {
    UponActiveJobsEmpty(now);
  }
  previous_size_jobs_active_ = jobs_active_.size();
}

// There are no more active jobs. There are no busy resources.
void Dispatch::UponActiveJobsEmpty(const rclcpp::Time& now) {
  // INFOS(logger_, "\n - - - UponActiveJobsEmpty() - - -  N O   M O R E   A C T I V E   J O B S  \n");

  if(mode_ == Mode::AUTO) {
    if(GarageDirtiness() >= garage_dirtiness_threshold_ratio_) {
      auto job = std::make_unique<CleanGarageJob>(GenerateGuid(now), now);
      RegisterPendingJob(std::move(job));
      queued_idle_clean_ = true;
    }
    if(!queued_idle_rebalance_) {
      auto rebalance_job = std::make_unique<RebalanceGarageJob>(GenerateGuid(now), now);
      RegisterPendingJob(std::move(rebalance_job));
      queued_idle_rebalance_ = true;
    }
  }

  // Go back to the most difficult plan request strategy.
  if(plan_request_strategy_ != plan_request_strategy_default_) {
    INFOS(logger_, " - - - UponActiveJobsEmpty() - - -  PLAN_JOBS_UNLIMITED");
    // "UNLIMITED" means all the pending jobs in the queue are sent in the plan request,
    // without discrimiation between trivial job (insert into empty garage) or
    // complicated job (multiple triple-pick-retrieve from a full garage, or carousel shuffle).
    // And the scheduler could fail the entire batch of jobs if they are too
    // complicated (because it runs out of unoccupied waypoints and unblocked paths).
    plan_request_strategy_ = plan_request_strategy_default_;
    max_plan_request_jobs_ = -1;
  }
}

// This could happen if the scheduler has failed an entire batch of pending jobs.
// e.g. If there are multiple jobs that are non-trivial (triple-pick in a full garage,
// or carousel shuffle), then eventually try planning the jobs one-at-a-time.
void Dispatch::NextSimplerPlanRequestStrategy() {
  switch(plan_request_strategy_) {
  case PLAN_JOBS_UNLIMITED:
    INFOS(logger_,
        " - - - NextSimplerPlanRequestStrategy()  PLAN_JOBS_UNLIMITED --> PLAN_JOBS_MAX_RESOURCES_EXIST");
    // Try planning only the amount of jobs, for the amount of resources that exist.
    plan_request_strategy_ = PLAN_JOBS_MAX_RESOURCES_EXIST;
    max_plan_request_jobs_ = MinimumAgvsAndBays();
    if(max_plan_request_jobs_ == 0) {
      max_plan_request_jobs_ = 1;
    }
    break;
  case PLAN_JOBS_MAX_RESOURCES_EXIST:
    INFOS(logger_,
        " - - - NextSimplerPlanRequestStrategy()  PLAN_JOBS_MAX_RESOURCES_EXIST --> "
        "PLAN_JOBS_MAX_RESOURCES_NON_BUSY");
    // Try planning only the amount of jobs, for the amount of resources that are not busy.
    plan_request_strategy_ = PLAN_JOBS_MAX_RESOURCES_NON_BUSY;
    max_plan_request_jobs_ = MinimumNonBusyAgvsAndBays();
    if(max_plan_request_jobs_ == 0) {
      max_plan_request_jobs_ = 1;
    }
    break;
  case PLAN_JOBS_MAX_RESOURCES_NON_BUSY:
    INFOS(logger_,
        " - - - NextSimplerPlanRequestStrategy()  PLAN_JOBS_MAX_RESOURCES_NON_BUSY --> "
        "PLAN_JOBS_ONE_JOB_AT_TIME");
    // Try planning only one job at a time.
    plan_request_strategy_ = PLAN_JOBS_ONE_JOB_AT_TIME;
    max_plan_request_jobs_ = 1;
    break;
  case PLAN_JOBS_ONE_JOB_AT_TIME:
    INFOS(logger_, " - - - NextSimplerPlanRequestStrategy()  PLAN_JOBS_ONE_JOB_AT_TIME");
    // This is the simplest strategy.
    max_plan_request_jobs_ = 1;
    break;
  }
  assert(max_plan_request_jobs_ != 0);
}

int32_t Dispatch::MinimumAgvsAndBays() {
  // std::min( How many non-disabled agvs are there?, How many non-disabled bays are there? )
  return agvs_active_;
}

int32_t Dispatch::MinimumNonBusyAgvsAndBays() {
  // std::min( How many AGVs are not busy?, How many bays are not occupied with payload? )
  return agvs_not_busy_count_;
}

BoolStringPair Dispatch::AreAllBaysStopped() const {
  bool all_bays_stopped = true;
  std::string not_stopped_bays = "";
  for(const auto& [bay_id, bay] : discrete_garage_state_.GetEnabledBays()) {
    if(bay.state != BayReportMsg::STATE_READY_TO_RETRIEVE) {
      all_bays_stopped = false;
      not_stopped_bays += "b" + std::to_string(bay_id) + " ";
    }
  }
  return std::make_pair(all_bays_stopped, not_stopped_bays);
}

void Dispatch::MoveAllBaysToStopped(const rclcpp::Time& now) {
  // Get all enabled bays to the READY_TO_RETRIEVE state. That transition is only valid from the
  // READY_TO_INSERT state.
  for(const auto& [bay_id, bay] : discrete_garage_state_.GetEnabledBays()) {
    if(bay.state == BayReportMsg::STATE_READY_TO_INSERT) {
      auto command = BayCommandMsg {};
      command.command_id = std::to_string(GenerateGuid(now));
      command.command_type = BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE;
      command_send_->sendBayCommand(bay_id, command);
    }
  }
}

BoolStringPair Dispatch::AreAllVexenStopped() const {
  bool all_vexen_stopped = true;
  std::string not_stopped_vexen = "";
  for(const auto& [vecs_id, vecs] : discrete_garage_state_.GetEnabledVexen()) {
    if(vecs.state != VecsReportMsg::READY_TO_CHARGE) {
      all_vexen_stopped = false;
      not_stopped_vexen += "v" + std::to_string(vecs_id) + " ";
    }
  }
  return std::make_pair(all_vexen_stopped, not_stopped_vexen);
}

void Dispatch::MoveAllVexenToStopped(const rclcpp::Time& now) {
  // Get all enabled Vexen to the READY_TO_CHARGE state. That transition is only valid from the
  // CHARGING state.
  for(const auto& [vecs_id, vecs] : discrete_garage_state_.GetEnabledVexen()) {
    if(vecs.state == VecsReportMsg::CHARGING) {
      auto command = VecsCommandMsg {};
      command.command_id = std::to_string(GenerateGuid(now));
      command.command_type = VecsCommandMsg::COMMAND_TYPE_STOP_CHARGING;
      command_send_->sendVecsCommand(vecs_id, command);
    }
  }
}

void Dispatch::CullOldTerminalJobs(const rclcpp::Time& now) {
  int n_culled_jobs = 0;
  int completed_job_index = 0;
  while(completed_job_index < static_cast<int>(jobs_completed_.size())) {
    auto job_id = jobs_completed_.at(completed_job_index);
    auto completion_time = jobs_.at(job_id)->GetTimeCompleted();
    if(now - completion_time > central::kTerminalJobRetainPeriod) {
      // Remove the job
      jobs_completed_.erase(jobs_completed_.begin() + completed_job_index);
      jobs_.erase(job_id);

      // Decrement our index
      completed_job_index--;

      // Count how many jobs we removed
      n_culled_jobs += 1;
    }

    completed_job_index++;
  }

  if(n_culled_jobs > 0) {
    INFOS(logger_, "Culled " << n_culled_jobs << " jobs older than "
                             << volley::ChronoDurationToSeconds(central::kTerminalJobRetainPeriod)
                             << " seconds");
  }
}

void Dispatch::CreateJobsFromEvents(const DiscreteGarageEventMsg& event, const rclcpp::Time& now) {
  // For now, we only create jobs based off of BayStateChanged events. In the future, if we
  // consider other event types, we should change the structure of this, maybe to a series of
  // if/else's
  if(event.type != "BayStateChanged") {
    return;
  }
  auto discrete_garage_event_opt = volley::Deserialize<BayStateChangedMsg>(event);
  if(!discrete_garage_event_opt.has_value()) {
    // If this event cannot be deserialized, an error will be thrown when the event is applied
    // to the garage state in another function
    return;
  }
  auto bay_state_change = discrete_garage_event_opt.value();

  // If the bay is transitioning from PROCESSING INSERT to STATE_VEHICLE_INSERTED, create an
  // Insert Job and then follow-up with rebalance + clean garage.
  if(bay_state_change.state_curr == BayReportMsg::STATE_PROCESSING_INSERT &&
      bay_state_change.state_next == BayReportMsg::STATE_VEHICLE_INSERTED) {
    auto tray_in_bay = discrete_garage_state_.GetTrayOnNode(bay_state_change.bay_id);
    // Check there is a tray, and a payload in the bay.
    if(tray_in_bay.has_value() && tray_in_bay->payload_id != volley::kEmptyGuid) {
      // InsertJob has to make sure the bay door is open before reparking the tray.
      auto insert_job = std::make_unique<InsertJob>(
          GenerateGuid(now), now, bay_state_change.bay_id, tray_in_bay->payload_id);
      RegisterPendingJob(std::move(insert_job));
      if(mode_ == Mode::AUTO) {
        auto rebalance_job = std::make_unique<RebalanceGarageJob>(GenerateGuid(now), now);
        RegisterPendingJob(std::move(rebalance_job));
      }
    }
  }
}

void Dispatch::LogState() const {
  LOG_DEBUG(logger_, "{}", common::EnumNameString(status_));
}

void Dispatch::LogJobs() const {
  LOG_DEBUG(logger_, "Dispatcher jobs:");
  LOG_DEBUG(logger_, "\tPending: ");
  for(const auto& pending_job_guid : jobs_pending_) {
    auto& job = jobs_.at(pending_job_guid);
    LOG_DEBUG(logger_, "\t\t{:>26}  {:>9}  {}", job->GetName(), common::EnumNameString(job->GetState()),
        std::to_string(job->GetGuid()));
  }
  LOG_DEBUG(logger_, "\tActive: ");
  for(const auto& active_job_guid : jobs_active_) {
    const auto& job = jobs_.at(active_job_guid);
    LOG_DEBUG(logger_, "\t\t{:>26}  {:>9}  {}", job->GetName(), common::EnumNameString(job->GetState()),
        std::to_string(job->GetGuid()));
    if(job->GetType() == SchedulerJobMsg::TYPE_RETRIEVE) {
      const auto& retrieve_job = dynamic_cast<const RetrieveJob&>(*job);
      LOG_DEBUG(logger_, "\t\t payload_id: {}", std::to_string(retrieve_job.GetPayloadId()));
      LOG_DEBUG(logger_, "\t\t bay_id: {}", retrieve_job.GetBayId());
      LOG_DEBUG(
          logger_, "\t\t bay_arrival_node_guid: {}", std::to_string(retrieve_job.GetBayArrivalNodeGuid()));
      LOG_DEBUG(logger_, "\t\t seconds_to_bay_arrival: {:g}", retrieve_job.GetSecondsToBayArrival());
    }
  }
  LOG_DEBUG(logger_, "\tCompleted: ");
  for(const auto& completed_job_guid : jobs_completed_) {
    const auto& job = jobs_.at(completed_job_guid);
    LOG_DEBUG(logger_, "\t\t{:>26}  {:>9}  {}", job->GetName(), common::EnumNameString(job->GetState()),
        std::to_string(job->GetGuid()));
    if(job->GetNote() != "") {
      LOG_DEBUG(logger_, "\t\t{:>26}  {}", "NOTE:", job->GetNote());
    }
  }
}

void Dispatch::LogScheduleProgress() const {
  if(exec_state_ != nullptr) {
    const auto& schedule = exec_state_->GetSchedule();

    // Print one line of node status, in topological order
    // ex: [x][r][ ][ ][ ][ ][ ][ ][ ]
    std::ostringstream os;
    os << "Schedule: ";
    for(unsigned int node_index = 0; node_index < schedule.NumNodes(); node_index++) {
      if(schedule.IsNodeCompleted(node_index)) {
        os << "[x]";
      }
      else if(schedule.IsNodeReceived(node_index)) {
        os << "[R]";
      }
      else if(schedule.IsNodeReady(node_index)) {
        os << "[r]";
      }
      else {
        os << "[ ]";
      }
    }
    LOG_DEBUG(logger_, "{}", os.str());

    // Clear our string stream
    os.str("");
    os.clear();

    // Print one line of node type
    os << "          ";
    for(const auto& node : schedule.GetNodes()) {
      char c = '?';
      if(node.type == ActionNodeMsg::TYPE_AGV_COMMAND) {
        c = 'a';
      }
      else if(node.type == ActionNodeMsg::TYPE_BAY_COMMAND) {
        c = 'b';
      }
      else if(node.type == ActionNodeMsg::TYPE_VECS_COMMAND) {
        c = 'v';
      }
      os << " " << c << " ";
    }
    LOG_DEBUG(logger_, "{}", os.str());
  }
  else {
    LOG_DEBUG(logger_, "Schedule: none");
  }
}

void Dispatch::LogGarageStateAgvsAndBays(const volley::DiscreteGarageState& state) const {
  LOG_DEBUG(logger_, "AGVS:");
  for(const auto& [agv_id, agv] : state.GetAgvs()) {
    LOG_DEBUG(logger_, "\ta{}: {}  {} {}    Disabled: {}", agv_id,
        (agv.state == AgvReportMsg::STATE_ACTIVE ? "ACTIVE" : "inactive"), std::to_string(agv.pose), agv.lift,
        agv.disabled);
  }

  LOG_DEBUG(logger_, "BAYS:");
  for(const auto& [bay_id, bay] : state.GetBays()) {
    LOG_DEBUG(logger_, "\tb{}: {}  {}  Disabled: {}", bay_id,
        (bay.state == BayReportMsg::STATE_READY_TO_RETRIEVE ? "READY_TO_RETRIEVE" : "NOT READY"),
        std::to_string(bay.state), bay.disabled);
  }
}

DispatchHeartbeatMsg::UniquePtr Dispatch::GetHeartbeat(const rclcpp::Time& now) const {
  auto heartbeat = std::make_unique<DispatchHeartbeatMsg>();
  heartbeat->header.stamp = now;
  heartbeat->installation_id = installation_id_;
  return heartbeat;
}

std::unique_ptr<DispatchReportMsg> Dispatch::GetDispatchReport(const rclcpp::Time& now) const {
  auto report = std::make_unique<DispatchReportMsg>();
  report->consistent = consistency_report_.consistent;
  report->has_execution_state = exec_state_ != nullptr;
  report->execution_state_diverged = exec_state_ == nullptr || exec_state_->IsDiverged();
  report->state_diverged = discrete_garage_state_diverged_;
  report->status = common::EnumInteger(status_);
  report->mode = common::EnumInteger(mode_);

  // Include all active jobs
  for(const auto& active_job_guid : jobs_active_) {
    if(HasJob(active_job_guid)) {
      report->jobs.emplace_back(jobs_.at(active_job_guid)->ToRos());
    }
    else {
      ERRORS(logger_, "Could not find active job " << std::to_string(active_job_guid));
    }
  }

  // Then include all pending jobs
  for(const auto& pending_job_guid : jobs_pending_) {
    if(HasJob(pending_job_guid)) {
      report->jobs.emplace_back(jobs_.at(pending_job_guid)->ToRos());
    }
    else {
      ERRORS(logger_, "Could not find pending job " << std::to_string(pending_job_guid));
    }
  }

  // Only include the 5 latest completed jobs
  const int num_completed_jobs_to_include = 5;
  int n_completed_jobs = static_cast<int>(jobs_completed_.size());
  int first_completed_job_index = std::max(0, n_completed_jobs - num_completed_jobs_to_include);
  for(int i = first_completed_job_index; i < n_completed_jobs; i++) {
    const auto& guid = jobs_completed_.at(i);
    if(HasJob(guid)) {
      report->jobs.emplace_back(jobs_.at(guid)->ToRos());
    }
    else {
      ERRORS(logger_, "Could not find completed job " << std::to_string(guid));
    }
  }

  report->header.stamp = now;

  return report;
}

VersionInfoMsg::UniquePtr Dispatch::GetVersionInfo(const rclcpp::Time& now) const {
  auto version_info = std::make_unique<VersionInfoMsg>();
  version_info->header.stamp = now;
  version_info->name = "dispatcher";
  version_info->release = volley::GetRelease();
  version_info->gitsha = volley::GetGitsha();
  version_info->layout_md5sum = layout_md5sum_;
  return version_info;
}

void Dispatch::RegisterPendingJob(std::unique_ptr<Job> job) {
  if(job->GetGuid() == volley::kEmptyGuid) {
    WARNS(logger_, "Cannot register job with empty guid! Ignored job is of type " << job->GetName());
    return;
  }

  if(HasJob(job->GetGuid())) {
    WARNS(logger_, "Dispatcher already has a job with id " << std::to_string(job->GetGuid())
                                                           << ". Ignored job is of type " << job->GetName());
    return;
  }

  // Before adding this job, drop any pending job it makes redundant — a same-type
  // REBALANCE_GARAGE/CLEAN_GARAGE job, or a ChargeAgvJob for the same AGV.
  uint8_t jobtype = job->GetType();

  // New non-idle-background work ends this idle episode, re-arming the clean/rebalance triggers.
  if(!IsIdleBackgroundJobType(jobtype)) {
    queued_idle_clean_ = false;
    queued_idle_rebalance_ = false;
  }

  if(jobtype == SchedulerJobMsg::TYPE_CLEAN_GARAGE) {
    // If we already have a CleanGarageJob in the queue, it's there for a reason. Don't remove it from its
    // position or tack a new one onto the end
    for(const auto& pending_job_guid : jobs_pending_) {
      if(jobs_.at(pending_job_guid)->GetType() == SchedulerJobMsg::TYPE_CLEAN_GARAGE) {
        return;
      }
    }
  }
  else if(jobtype == SchedulerJobMsg::TYPE_REBALANCE_GARAGE) {
    // If there are any pending jobs of the same type, remove them.
    // RemovePendingJobsType skips any job currently in jobs_in_flight_ to avoid the
    // "Planner returned unknown job id" / execution-state-diverged race (see that function).
    RemovePendingJobsType(jobtype);
  }
  else if(jobtype == SchedulerJobMsg::TYPE_CHARGE_AGV) {
    // Only keep one pending ChargeAgvJob per AGV. Without this, ActOnRunningIdle()
    // re-registers a new ChargeAgvJob every ~1.8s while the prior plan is in flight,
    // and the scheduler eventually plans them all in one request where each successive
    // job sees the AGV virtually relocated to a charger by the previous plan — producing
    // an oscillation plan that bounces the AGV between chargers.
    auto charge_job = dynamic_cast<ChargeAgvJob*>(job.get());
    if(charge_job != nullptr) {
      const uint16_t new_agv_id = charge_job->GetAgvId();
      for(auto it = jobs_pending_.begin(); it != jobs_pending_.end();) {
        auto& pending = jobs_.at(*it);
        if(pending->GetType() == SchedulerJobMsg::TYPE_CHARGE_AGV) {
          auto pending_charge = dynamic_cast<ChargeAgvJob*>(pending.get());
          if(pending_charge != nullptr && pending_charge->GetAgvId() == new_agv_id) {
            jobs_.erase(*it);
            it = jobs_pending_.erase(it);
            continue;
          }
        }
        ++it;
      }
    }
  }

  // Add the job to our pending job list
  jobs_pending_.push_back(job->GetGuid());

  // Retain the job (moved so that the unique ptr ownership transfers)
  jobs_.emplace(job->GetGuid(), std::move(job));
}

// e.g.  jobtype = SchedulerJobMsg::TYPE_CLEAN_GARAGE
std::list<std::unique_ptr<Job>> Dispatch::RemovePendingJobsType(uint8_t jobtype) {
  std::list<std::unique_ptr<Job>> removedjobs;
  for(auto it = jobs_pending_.begin(); it != jobs_pending_.end();) {
    auto pending_job_guid = *it;
    auto& jobptrref = jobs_.at(pending_job_guid);
    if(jobptrref->GetType() == jobtype) {
      // Never remove a job that is currently in the in-flight plan request.  The plan
      // response references it by GUID; removing it from jobs_ before the response
      // arrives causes PlanClientCallback to log "Planner returned unknown job id",
      // skip the job, and leave jobs_active_ empty — so the follow-up plan request
      // sends no base_schedule, the scheduler re-plans the AGV from scratch, and the
      // response appends a duplicate trajectory into an exec_state that already has
      // those motions committed, triggering "Execution State has diverged".
      const bool in_flight = std::ranges::find(jobs_in_flight_, pending_job_guid) != jobs_in_flight_.end();
      if(in_flight) {
        ++it;
        continue;
      }
      removedjobs.push_back(std::move(jobptrref));  // move unique_ptr from the map to the list
      jobs_.erase(pending_job_guid);                // erase from the map
      it = jobs_pending_.erase(it);                 // erase from vector returns the next iterator
    }
    else {
      ++it;
    }
  }
  return removedjobs;
}

void Dispatch::UpdateIdleStartTime(const rclcpp::Time& now) {
  if(exec_state_ == nullptr) {
    return;  // already idle - pass
  }

  auto is_charge_or_clean = [](uint8_t jobtype) {
    return jobtype == SchedulerJobMsg::TYPE_CHARGE_AGV || jobtype == SchedulerJobMsg::TYPE_CLEAN_GARAGE;
  };

  // Whether any pending/active job isn't a charge or clean — either alone is normal while idling.
  bool has_non_charge_or_clean = false;
  for(const auto& pending_job_guid : jobs_pending_) {
    if(!is_charge_or_clean(jobs_.at(pending_job_guid)->GetType())) {
      has_non_charge_or_clean = true;
      break;
    }
  }
  for(const auto& active_job_guid : jobs_active_) {
    if(!is_charge_or_clean(jobs_.at(active_job_guid)->GetType())) {
      has_non_charge_or_clean = true;
      break;
    }
  }

  bool has_bay_with_payload = false;
  const auto& future_state = exec_state_->GetFuture().GetGarageState();
  for(const auto& [bay_id, bay] : future_state.GetEnabledBays()) {
    auto tray_in_bay = future_state.GetTrayOnNode(bay_id);
    if(tray_in_bay.has_value() && tray_in_bay->payload_id != volley::kEmptyGuid) {
      has_bay_with_payload = true;
      break;
    }
  }

  if(has_non_charge_or_clean || has_bay_with_payload) {
    time_became_idle_.reset();
  }
  else {
    if(!time_became_idle_.has_value()) {
      time_became_idle_ = now;
    }
  }
}

std::optional<PlanSrv::Request::SharedPtr> Dispatch::GetPlannerServiceRequest(const rclcpp::Time& now) {
  if(exec_state_ == nullptr) {
    WARNS(logger_, "Not calling planner due to missing execution state");
    return {};
  }

  GuidMsg plan_call_id = GenerateGuid(now);

  // Plan call data used to verify the response.
  // Note: if a plan request is not created (i.e. 'return {}' is added below this line),
  // plan_call_data_ needs to be reset
  plan_call_data_ = LastPlanCallData();
  plan_call_data_->time_last_called = now;
  plan_call_data_->plan_call_id = plan_call_id;
  jobs_in_flight_.clear();

  bool has_active_jobs = jobs_active_.size() != 0;

  // The planner is allowed to modify the schedule that we send it.
  // Today, we only want the planner to append to our schedule.
  // Note that we DO NOT set the base state to the future execution state, but rather, include
  // our current schedule. This is necessary for several reasons:
  //  1. If we merely set the base state to the future state, the planner would assume that is how
  //     everything is at t=0. However, different parts of the future state may be reached at
  //     different times.
  //  2. The planner would not properly build dependencies between the existing portion of the
  //     schedule and the new addition to the schedule.
  // TODO(any) update comment with new abilities

  // Construct our request
  auto request = std::make_shared<PlanSrv::Request>();
  request->request_data.id = plan_call_id;

  request->request_data.base_state =
      exec_state_->GetLatest().GetGarageState().GetDiscreteGarageStateMessage();

  // Split the schedule by determining which nodes are outside the command send horizon while this
  // plan call is executing
  // TODO(joe) Replanning needs this
  //    exec_state_->SplitSchedule();

  if(jobs_active_.size() != 0) {
    // Set the base schedule from our current schedule, skipping any completed nodes or nodes
    // determined to be outside the split for this plan call.
    const auto& schedule = exec_state_->GetSchedule();
    const auto& nodes = schedule.GetNodes();
    std::vector<int> new_node_indices(nodes.size(), -1);

    for(unsigned int i_node = 0; i_node < nodes.size(); i_node++) {
      if(!schedule.IsNodeCompleted(i_node)) {
        // TODO(joe) Replanning needs this
        //            if (!(schedule.IsNodeCompleted(i_node) ||
        //            schedule.IsNodeOutsideSplit(i_node))) {

        int new_index = static_cast<int>(request->request_data.base_schedule.nodes.size());
        new_node_indices.at(i_node) = new_index;

        // Copy the node.
        ActionNodeMsg node = nodes.at(i_node);

        // Keep any parents that still exist
        node.parents.clear();
        for(auto i_parent : nodes.at(i_node).parents) {
          int new_parent_index = new_node_indices.at(i_parent);
          if(new_parent_index != -1) {
            node.parents.emplace_back(new_parent_index);
          }
        }

        // Add node, with modified parents, to the request schedule
        // and the plan call data struct
        plan_call_data_->base_schedule.insert({node.guid, node});
        request->request_data.base_schedule.nodes.emplace_back(node);
      }
    }
  }

  {
    // Pending jobs that have not been sent to the planner yet.
    if(max_plan_request_jobs_ < 0) {
      // INFOS(logger_, " - - - GetPlannerServiceRequest() - - - PLAN_JOBS_UNLIMITED");
      for(const auto& pending_job_guid : jobs_pending_) {
        auto jobit = jobs_.find(pending_job_guid);
        if(jobit == jobs_.end()) {
          ERRORS(logger_, "Could not find pending job " << std::to_string(pending_job_guid));
          continue;
        }
        auto& jobptrref = jobit->second;
        if(has_active_jobs) {
          // Don't plan a TYPE_CLEAN_GARAGE while there are currently active jobs and busy AGVs.
          if(jobptrref->GetType() == SchedulerJobMsg::TYPE_CLEAN_GARAGE) {
            break;
          }
        }
        if(jobptrref->GetShouldBePlanned()) {
          request->request_data.pending_jobs.emplace_back(jobptrref->ToRos());
          jobs_in_flight_.push_back(pending_job_guid);
        }
      }
    }
    else {
      // INFOF(logger_, " - - - GetPlannerServiceRequest() max_plan_request_jobs_=%d",
      //     max_plan_request_jobs_);
      for(const auto& pending_job_guid : jobs_pending_) {
        // Limit according to strategy:
        // MAX_RESOURCES_EXIST, MAX_RESOURCES_NON_BUSY, ONE_JOB_AT_TIME
        assert(max_plan_request_jobs_ > 0);
        size_t max_request = max_plan_request_jobs_;
        if(request->request_data.pending_jobs.size() >= max_request) {
          break;
        }
        auto jobit = jobs_.find(pending_job_guid);
        if(jobit == jobs_.end()) {
          ERRORS(logger_, "Could not find pending job " << std::to_string(pending_job_guid));
          continue;
        }
        auto& jobptrref = jobit->second;
        if(has_active_jobs) {
          // Don't plan a TYPE_CLEAN_GARAGE while there are currently active jobs and busy AGVs.
          if(jobptrref->GetType() == SchedulerJobMsg::TYPE_CLEAN_GARAGE) {
            break;
          }
        }
        if(jobptrref->GetShouldBePlanned()) {
          request->request_data.pending_jobs.emplace_back(jobptrref->ToRos());
          jobs_in_flight_.push_back(pending_job_guid);
        }
      }
    }

    // Active jobs are currently executing.
    // The planner uses these like "disabled nodes" to de-conflict new plans.
    for(const auto& active_job_guid : jobs_active_) {
      auto jobit = jobs_.find(active_job_guid);
      if(jobit == jobs_.end()) {
        ERRORS(logger_, "Could not find active job " << std::to_string(active_job_guid));
        continue;
      }
      auto& jobptrref = jobit->second;
      request->request_data.active_jobs.emplace_back(jobptrref->ToRos());
    }
  }

  return request;
}

std::optional<std::unique_ptr<ScheduleMsg>> Dispatch::GetScheduleMessage(const rclcpp::Time& now) const {
  if(exec_state_ == nullptr) {
    return {};
  }
  auto schedule_msg = std::make_unique<ScheduleMsg>();
  schedule_msg->nodes = exec_state_->GetSchedule().GetNodes();
  schedule_msg->header.stamp = now;
  return schedule_msg;
}

std::optional<int32_t> Dispatch::UpdateAgvsNotBusyCount() const {
  int32_t agvs_active = 0;
  int32_t agvs_not_busy_count = 0;
  if(!exec_state_) {
    agvs_active_ = agvs_active;
    agvs_not_busy_count_ = agvs_not_busy_count;
    return std::nullopt;
  }
  // How many AGVs are busy? How many AGVs are idle?
  // Check the ActionNodes in the Schedule and jobs_active_.
  std::set<GuidMsg, volley::GuidComparator> active_jobs_set;
  std::copy(
      jobs_active_.begin(), jobs_active_.end(), std::inserter(active_jobs_set, active_jobs_set.begin()));
  std::set<uint16_t> agvs_already_busy;
  const Schedule& schedule = exec_state_->GetSchedule();
  const std::vector<ActionNodeMsg>& nodes = schedule.GetNodes();
  for(const auto& node : nodes) {
    if(node.type == ActionNodeMsg::TYPE_AGV_COMMAND) {
      if(active_jobs_set.find(node.job_id) != active_jobs_set.end()) {
        if(node.agv_command.src != node.agv_command.dst) {
          agvs_already_busy.insert(node.agv_id);
        }
      }
    }
  }
  const volley::DiscreteGarageState& latest_state = exec_state_->GetLatest().GetGarageState();
  const std::map<uint16_t, DiscreteAgvStateMsg>& agvs = latest_state.GetAgvs();
  for(const auto& [agv_id, agv] : agvs) {
    if(!agv.disabled) {
      if(agv.state == AgvReportMsg::STATE_ACTIVE) {
        agvs_active++;
        if(agvs_already_busy.find(agv_id) == agvs_already_busy.end()) {
          agvs_not_busy_count_++;
        }
      }
    }
  }
  agvs_active_ = agvs_active;
  agvs_not_busy_count_ = agvs_not_busy_count;
  return agvs_not_busy_count_;
}

bool Dispatch::ShouldCallPlanner() const {
  // No point in making a plan call if the Dispatcher is not running
  if(GetStatus() != Status::RUNNING) {
    return false;
  }

  // Update how many AGVs are busy? How many AGVs are idle?
  std::optional<int32_t> agvs_not_busy_opt = std::nullopt;
  if(exec_state_) {
    agvs_not_busy_opt = UpdateAgvsNotBusyCount();
  }

  // We want to avoid making a plan call while a previous call is executing. This optional stores
  // data from the last plan call if one is executing, and is nullopt if there is no currently
  // executing plan call
  if(plan_call_data_.has_value()) {
    return false;
  }

  if(!enable_overlapping_planning_) {
    // Are there currently executing jobs?
    if(jobs_active_.size() != 0) {
      // Prevent new pending jobs from being planned, while jobs are currently being executed.
      return false;
    }
  }

  // TODO(name): De-duplicate this code. Its almost identical to the code in UpdateAgvsNotBusyCount()
  // But dont break the github nightly Release Workflow.
  if(exec_state_) {
    // How many AGVs are busy? How many AGVs are idle? Check the ActionNodes in the Schedule and
    // jobs_active_.
    std::set<GuidMsg, volley::GuidComparator> active_jobs_set;
    std::copy(
        jobs_active_.begin(), jobs_active_.end(), std::inserter(active_jobs_set, active_jobs_set.begin()));
    std::set<uint16_t> agvs_already_busy;
    const Schedule& schedule = exec_state_->GetSchedule();
    const std::vector<ActionNodeMsg>& nodes = schedule.GetNodes();
    for(const auto& node : nodes) {
      if(node.type == ActionNodeMsg::TYPE_AGV_COMMAND) {
        if(active_jobs_set.find(node.job_id) != active_jobs_set.end()) {
          if(node.agv_command.src != node.agv_command.dst) {
            agvs_already_busy.insert(node.agv_id);
          }
        }
      }
    }

    // Don't call Scheduler::Plan() if all the AGVs are busy. Check if there is at least one
    // available AGV.
    const volley::DiscreteGarageState& latest_state = exec_state_->GetLatest().GetGarageState();
    const std::map<uint16_t, DiscreteAgvStateMsg>& agvs = latest_state.GetAgvs();
    int agvs_not_busy = 0;
    for(const auto& [agv_id, agv] : agvs) {
      if(!agv.disabled) {
        if(agv.state == AgvReportMsg::STATE_ACTIVE) {
          if(agvs_already_busy.find(agv_id) == agvs_already_busy.end()) {
            agvs_not_busy++;
          }
        }
      }
    }
    if(agvs_not_busy == 0) {
      // Not going to call Scheduler::Plan() if all the AGVs are busy.
      INFOS(logger_, "ShouldCallPlanner() All AGVs are busy in the schedule. None are available.");
      schedule.PrintGraph(std::string("ShouldCallPlanner"), logger_);
      return false;
    }
  }

  // Determines whether it makes sense to call the planner. The planner should not be called if
  // there are no unplanned jobs, and similarly should not be called if the only pending job(s)
  // are guaranteed to fail given the future garage state.
  for(const auto& pending_job_guid : jobs_pending_) {
    if(!HasJob(pending_job_guid)) {
      ERRORS(logger_, "Could not find pending job " << std::to_string(pending_job_guid));
      continue;
    }
    jobs_.at(pending_job_guid)->SetShouldBePlanned(ShouldPendingJobBePlanned(pending_job_guid));
    if(jobs_.at(pending_job_guid)->GetShouldBePlanned()) {
      return true;
    }
  }

  return false;
}

bool Dispatch::ShouldPendingJobBePlanned(const GuidMsg& pending_job_id) const {
  // Determines if a pending job should be given to the planner to be planned. It should
  // not be if it is guaranteed to fail. As of now, the only scenarios where we know this
  // happens is when a retrieve job is waiting on a bay to be in READY TO RETRIEVE but
  // no bay in the future state is in that state, or the payload is charging
  const auto& pending_job = jobs_.at(pending_job_id);
  const auto& future_state = exec_state_->GetFuture().GetGarageState();

  if((pending_job->GetType() != SchedulerJobMsg::TYPE_RETRIEVE)) {
    // If a pending job is not a retrieve job, plan the job
    return true;
  }

  const auto& retrieve_job = dynamic_cast<RetrieveJob&>(*pending_job);
  if(!retrieve_job.GetNeedsBayInRetrieve()) {
    // If the retrieve job is not waiting on a bay to transition, plan the job
    return true;
  }
  for(const auto& [bay_id, future_bay] : future_state.GetEnabledBays()) {
    auto future_tray_opt = future_state.GetTrayOnNode(bay_id);
    bool tray_in_bay = future_tray_opt.has_value();
    if(future_bay.state == BayReportMsg::STATE_READY_TO_RETRIEVE && !tray_in_bay) {
      // If there is a pending retrieve job that is waiting on a bay to be in ready
      // to retrieve and a bay is in ready to retrieve in the future state (and
      // there's no tray in the bay), plan the job
      return true;
    }
  }

  // If none of the above conditions are met, don't plan the job
  return false;
}

std::unordered_map<uint16_t, std::unique_ptr<AgvCommandSequenceMsg>> Dispatch::GetAgvCommandSequences(
    const rclcpp::Time& now) const {
  // This function is a wrapper to make sure we have an execution state before calling the method
  if(exec_state_ == nullptr) {
    return {};
  }

  return exec_state_->GetAgvCommandSequences(now);
}

void Dispatch::CompleteJobs(const rclcpp::Time& now) {
  // Detect job completion
  // The planner returns a list of node ids that must be completed for a job to be considered
  // done (We cannot simply check end conditions. For example, if we move an AGV from A -> B
  // -> C, and then append another move from C -> B, we might accidentally complete the 2nd
  // one once we first reach B.)

  if(exec_state_ == nullptr) {
    WARNS(logger_, "Cannot complete jobs when execution state has no value");
    return;
  }

  const auto& schedule = exec_state_->GetSchedule();

  int active_job_index = 0;
  while(active_job_index < static_cast<int>(jobs_active_.size())) {
    const auto& active_job_guid = jobs_active_[active_job_index];
    if(!HasJob(active_job_guid)) {
      ERRORS(logger_, "Could not find active job " << std::to_string(active_job_guid));
      continue;
    }
    auto& job = jobs_.at(active_job_guid);

    // The job is completed if its execution_nodes_to_complete set is empty
    bool all_completed = true;
    for(const auto& guid : job->GetExecutionNodesToComplete()) {
      auto node_index_opt = schedule.GetNodeByGuid(guid);
      // If lookup fails, we can assume the item was completed
      all_completed &= (!node_index_opt.has_value() || schedule.IsNodeCompleted(node_index_opt.value()));
    }

    if(all_completed) {
      job->OnSuccess(now);
      jobs_active_.erase(jobs_active_.begin() + active_job_index);
      active_job_index--;
      jobs_completed_.emplace_back(job->GetGuid());
    }

    active_job_index++;
  }

  UpdateActiveJobsEmpty(now);
}

void Dispatch::DispatchReadyCommands() {
  if(exec_state_ != nullptr) {
    exec_state_->SendReadyCommands();
  }
}

SchedulerJobListMsg Dispatch::MakeJobListMessage(
    const rclcpp::Time& now, const std::vector<GuidMsg>& guids) const {
  SchedulerJobListMsg job_list;
  job_list.header.stamp = now;
  for(auto guid : guids) {
    if(HasJob(guid)) {
      job_list.jobs.push_back(jobs_.at(guid)->ToRos());
    }
  }

  return job_list;
}

void Dispatch::RejectPlanResponse(std::string warn_message) {
  WARNS(logger_, warn_message);
  plan_call_data_.reset();
  jobs_in_flight_.clear();
  if(exec_state_ != nullptr) {
    exec_state_->UndoSplit();
  }
}

double Dispatch::GarageDirtiness() {
  const auto waypoint_node_ids = pose_graph_->GetLayout()->GetNodeIdsOfType(GarageNodeMsg::TYPE_WAYPOINT);
  if(waypoint_node_ids.empty()) {
    return 0.0;
  }

  int num_trays_on_waypoints = 0;
  for(const auto node_id : waypoint_node_ids) {
    std::optional<DiscreteTrayStateMsg> tray_on_node = discrete_garage_state_.GetTrayOnNode(node_id);
    if(tray_on_node.has_value()) {
      num_trays_on_waypoints++;
    }
  }

  return static_cast<double>(num_trays_on_waypoints) / static_cast<double>(waypoint_node_ids.size());
}

