#include <central/dispatch_ros.hpp>
#include <common_ros/component.hpp>
#include <common_ros/layout.hpp>
#include <common_ros/pose_graph.hpp>
#include <cstdlib>
namespace central {
using namespace volley;

class DispatchComponent : public volley::Component {
public:
  explicit DispatchComponent(const rclcpp::NodeOptions& options) {
    auto node = std::make_shared<volley::Node>("dispatcher", options);
    const auto logger = node->get_logger();

    // Load our ROS params
    std::string layout_file = "";
    volley::DispatchParams params = {};
    try {
      params.installation_id = static_cast<uint32_t>(node->Param<int>("installation_id"));
      layout_file = node->Param<std::string>("layout");
    }
    catch(const std::exception& exception) {
      // Catch all parameter related exceptions. No reason to continue on if we cannot read
      // our parameters properly.
      ERRORS(logger, "Exception: " << exception.what());
      exit(EXIT_FAILURE);
    }

    const auto layout_filepath_or = GetLayoutPathByName(layout_file);
    if(!layout_filepath_or.has_value()) {
      ERRORS(logger, layout_filepath_or.error());
      exit(EXIT_FAILURE);
    }
    const auto& layout_filepath = layout_filepath_or.value();

    // Display our parameters
    // clang-format off
    INFOS(logger, "installation_id:              " << params.installation_id);
    INFOS(logger, "layout_file:                  " << layout_filepath);
    // clang-format on

    // Load the layout
    LayoutSPtr layout = std::make_shared<volley::Layout>(layout_filepath);
    params.layout_md5sum = layout->GetMD5Sum();

    // Construct our pose graph
    // Note that we use a shared ptr to a constant object to prevent anyone from ever editing it
    auto pose_graph = std::make_shared<const volley::PoseGraph>(layout);

    // Create the dispatcher
    dispatcher_ = std::make_unique<DispatchRos>(params, pose_graph, node);

    SetNode(node);
  }

private:
  std::unique_ptr<DispatchRos> dispatcher_;
};

}  // namespace central

#include <rclcpp_components/register_node_macro.hpp>
RCLCPP_COMPONENTS_REGISTER_NODE(central::DispatchComponent)
