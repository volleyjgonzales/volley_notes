<file path="src/schedule.cpp">
#include <central/central_msgs.hpp>
#include <central/schedule.hpp>
#include <cmath>
#include <common_ros/pose_utils.hpp>

namespace volley {

static_assert(sizeof(uint32_t) == sizeof(uint32_t), "uint32_t is not 32 bits");

bool IsEntityAction(const ActionNodeMsg& node) {
  return node.type == ActionNodeMsg::TYPE_AGV_COMMAND || node.type == ActionNodeMsg::TYPE_BAY_COMMAND ||
         node.type == ActionNodeMsg::TYPE_VECS_COMMAND || node.type == ActionNodeMsg::TYPE_VRC_COMMAND;
}

BoolStringPair Schedule::Append(ActionNodeMsg node) {
  // Ensure GUID is not the zero-guid
  if(node.guid == volley::kEmptyGuid) {
    return std::make_pair(false, "The empty guid is not allowed");
  }

  // Ensure a valid node type
  if(node.type != ActionNodeMsg::TYPE_AGV_COMMAND && node.type != ActionNodeMsg::TYPE_BAY_COMMAND &&
      node.type != ActionNodeMsg::TYPE_VECS_COMMAND && node.type != ActionNodeMsg::TYPE_VRC_COMMAND) {
    return std::make_pair(false, "Unknown node type " + std::to_string(node.type));
  }

  // Duration may not be negative
  if(node.duration < 0.0) {
    return std::make_pair(false, "Node duration " + std::to_string(node.duration) + " must be non-negative");
  }

  // Ensure the node does not already exist
  if(GetNodeByGuid(node.guid).has_value()) {
    return std::make_pair(false, "Schedule already has a node with guid " + std::to_string(node.guid));
  }

  // Ensure that all parent indices are valid
  for(uint32_t parent_index : node.parents) {
    if(parent_index >= nodes_.size()) {
      return std::make_pair(false, "Parent index " + std::to_string(parent_index) + " is out of bounds");
    }
  }

  GarageEntityIdMsg entity_id {};
  if(node.type == ActionNodeMsg::TYPE_AGV_COMMAND) {
    entity_id = volley::AgvId(node.agv_id);
  }
  else if(node.type == ActionNodeMsg::TYPE_BAY_COMMAND) {
    entity_id = volley::BayId(node.bay_id);
  }
  else if(node.type == ActionNodeMsg::TYPE_VECS_COMMAND) {
    entity_id = volley::VecsId(node.vecs_id);
  }
  else if(node.type == ActionNodeMsg::TYPE_VRC_COMMAND) {
    entity_id = volley::VrcId(node.vrc_id);
  }

  // Ensure that, if this is an AGV, bay, VECS, or VRC command, that we have the latest command as
  // a parent, and no other parents can be commands to the same entity.
  if(IsEntityAction(node)) {
    // Get the leading action index
    auto leading_index = GetLeadingEntityActionIndex(entity_id);
    while(leading_index.has_value()) {
      auto successor_index = GetSuccessorEntityActionIndex(leading_index.value());
      auto find_leading_index = std::find(node.parents.begin(), node.parents.end(), leading_index.value());
      if(successor_index.has_value()) {
        // We are not allowed to have the leading index as a parent
        // TODO(any) uncomment this block once we are running C++ scheduler
        // if (find_leading_index != node.parents.end()) {
        //     return std::make_pair(false, "Node " + std::to_string(node.guid) +
        //                                      " has invalid parent index " +
        //                                      std::to_string(leading_index.value()) +
        //                                      " which is not to a trailing command for " +
        //                                      std::to_string(entity_id));
        // }
      }
      else {
        // This is the trailing command for that entity. We must have it as a parent
        if(find_leading_index == node.parents.end()) {
          return std::make_pair(false, "Node " + std::to_string(node.guid) + " lacks the parent index " +
                                           std::to_string(leading_index.value()) +
                                           " which is the trailing command for " + std::to_string(entity_id));
        }
      }
      leading_index = successor_index;
    }
  }

  // ------------------------------------------------------
  // Commit to adding the node. The append must now succeed

  uint32_t node_index = nodes_.size();

  // Store the guid
  guid_to_node_index_.emplace(node.guid, node_index);

  // Give it a successors entry
  successors_.emplace_back(std::vector<uint32_t>());

  // Set the same guid in its AGV, bay, VECS, VRC commands
  // This could/should be done in the scheduler code to make testing easier
  if(node.type == ActionNodeMsg::TYPE_AGV_COMMAND) {
    node.agv_command.id = std::to_string(node.guid);
  }
  else if(node.type == ActionNodeMsg::TYPE_BAY_COMMAND) {
    node.bay_command.command_id = std::to_string(node.guid);
  }
  else if(node.type == ActionNodeMsg::TYPE_VECS_COMMAND) {
    node.vecs_command.command_id = std::to_string(node.guid);
  }
  else if(node.type == ActionNodeMsg::TYPE_VRC_COMMAND) {
    node.vrc_command.command_id = std::to_string(node.guid);
  }

  // Hook up parents <-> children - they are all guaranteed to exist,
  // and update the new node's start time.
  // Note that because we append to `successors_`, and nodes are added in topological order,
  // `successors_` will always be in ascending order.
  for(auto parent_index : node.parents) {
    successors_.at(parent_index).emplace_back(node_index);
  }

  // Sort the parents, for reproducibility
  std::sort(node.parents.begin(), node.parents.end());

  // Store the node
  nodes_.emplace_back(node);

  // If the node is ready, mark it as such
  if(NodeHasNoIncompleteParents(node_index)) {
    ready_nodes_.emplace(node_index);
  }

  // Set the leading actions, if necessary
  // We store the leading actions in order to quickly look up which action to dispatch next to a
  // given entity.
  if((IsEntityAction(node)) && !GetLeadingEntityActionIndex(entity_id).has_value()) {
    entity_id_to_leading_action_.emplace(entity_id, node_index);
  }

  return std::make_pair(true, "");
}

bool Schedule::IsNodeReadyForChaining(uint32_t node_index) const {
  // Look no further if it's ready in the normal sense (all parents completed)
  if(IsNodeReady(node_index)) {
    return true;
  }

  bool one_incomplete_parent = false;
  auto agv_id = nodes_.at(node_index).agv_id;
  auto bay_id = nodes_.at(node_index).bay_id;
  auto vecs_id = nodes_.at(node_index).vecs_id;
  auto vrc_id = nodes_.at(node_index).vrc_id;
  for(auto parent : nodes_.at(node_index).parents) {
    const auto& parent_node = nodes_.at(parent);
    // Perform some checks if this parent is not completed
    if(!IsNodeCompleted(parent)) {
      // Make sure that this parent is received and belongs to the same entity as the node
      // we are checking
      if(IsNodeReceived(parent) && parent_node.agv_id == agv_id && parent_node.bay_id == bay_id &&
          parent_node.vecs_id == vecs_id && parent_node.vrc_id == vrc_id) {
        // We only allow one Received parent- if there are more, this node is not ready
        if(one_incomplete_parent) {
          return false;
        }
        else {
          one_incomplete_parent = true;
        }
      }
      else {
        return false;
      }
    }
  }

  // Pass all the checks and this node is ready for chaining.
  return true;
}

uint32_t Schedule::GetNumberOfIncompleteParents(uint32_t node_index) const {
  uint32_t n_incomplete_parents = 0;
  for(auto parent : nodes_.at(node_index).parents) {
    n_incomplete_parents += not IsNodeCompleted(parent);
  }
  return n_incomplete_parents;
}

bool Schedule::NodeHasNoIncompleteParents(uint32_t node_index) const {
  return GetNumberOfIncompleteParents(node_index) == 0;
}

const std::vector<uint32_t>& Schedule::GetSuccessorNodeIndices(uint32_t node_index) const {
  return successors_.at(node_index);
}

std::optional<uint32_t> Schedule::GetNodeByGuid(const GuidMsg& guid) const {
  auto it = guid_to_node_index_.find(guid);
  if(it == guid_to_node_index_.end()) {
    return std::nullopt;
  }
  return it->second;
}

std::optional<uint32_t> Schedule::GetLeadingEntityActionIndex(const GarageEntityIdMsg& entity_id) const {
  auto it = entity_id_to_leading_action_.find(entity_id);
  if(it == entity_id_to_leading_action_.end()) {
    return std::nullopt;
  }
  return it->second;
}

std::optional<uint32_t> Schedule::GetSuccessorEntityActionIndex(uint32_t node_index) const {
  const auto& node = nodes_.at(node_index);

  if(!IsEntityAction(node)) {
    // This is not an entity action node
    return std::nullopt;
  }

  // Each command node for an entity can have at most a single child command node for the same
  // entity. For example, a1 moving would be trailed by at most one more lift or move command for
  // the same entity, not two, as a single entity can only act sequentially.
  for(auto child_index : successors_.at(node_index)) {
    const auto& child_node = nodes_.at(child_index);
    if(child_node.type == node.type && child_node.agv_id == node.agv_id && child_node.bay_id == node.bay_id &&
        child_node.vecs_id == node.vecs_id && child_node.vrc_id == node.vrc_id) {
      return child_index;
    }
  }
  return std::nullopt;
}

BoolStringPair Schedule::CompleteAction(uint32_t node_index) {
  const auto& node = nodes_.at(node_index);

  // The action must not already be completed
  if(IsNodeCompleted(node_index)) {
    return std::make_pair(false, "Tried to complete a completed action at index " +
                                     std::to_string(node_index) + " of type " + std::to_string(node.type));
  }

  // The action must not be marked as outside the split
  if(node.outside_split) {
    return std::make_pair(false, "Tried to complete an action outside the schedule split at index " +
                                     std::to_string(node_index) + " of type " + std::to_string(node.type));
  }

  // Remove the action from ready actions
  ready_nodes_.erase(node_index);

  // Complete the action
  nodes_.at(node_index).status = ActionNodeMsg::STATUS_COMPLETED;

  // Update any successors that may now be ready
  for(auto successor_index : successors_.at(node_index)) {
    if(NodeHasNoIncompleteParents(successor_index)) {
      ready_nodes_.emplace(successor_index);
    }
  }

  if(IsEntityAction(node)) {
    // Update entity_id_to_leading_action_
    auto entity_id = volley::AgvId(node.agv_id);
    if(node.type == ActionNodeMsg::TYPE_BAY_COMMAND) {
      entity_id = volley::BayId(node.bay_id);
    }
    else if(node.type == ActionNodeMsg::TYPE_VECS_COMMAND) {
      entity_id = volley::VecsId(node.vecs_id);
    }
    else if(node.type == ActionNodeMsg::TYPE_VRC_COMMAND) {
      entity_id = volley::VrcId(node.vrc_id);
    }

    auto it = entity_id_to_leading_action_.find(entity_id);
    if(it != entity_id_to_leading_action_.end() && it->second == node_index) {
      entity_id_to_leading_action_.erase(it);

      // The successor action, if any, becomes the next leading action.
      auto successor_action_index_opt = GetSuccessorEntityActionIndex(node_index);
      if(successor_action_index_opt.has_value()) {
        entity_id_to_leading_action_[entity_id] = successor_action_index_opt.value();
      }
    }
  }

  return std::make_pair(true, "");
}

BoolStringPair Schedule::MarkActionReceived(uint32_t node_index) {
  const auto& node = nodes_.at(node_index);

  // The action must not already be completed
  if(IsNodeCompleted(node_index)) {
    return std::make_pair(false, "Tried to mark received a completed action at index " +
                                     std::to_string(node_index) + " of type " + std::to_string(node.type));
  }

  // Make sure node was ready to be dispatched
  if(!IsNodeReadyForChaining(node_index)) {
    return std::make_pair(false, "Tried to mark received an action that is not ready for chaining " +
                                     std::to_string(node_index) + " of type " + std::to_string(node.type));
  }

  // Mark action as received
  nodes_.at(node_index).status = ActionNodeMsg::STATUS_RECEIVED;
  return std::make_pair(true, "");
}

static std::string to_str(const GaragePoseMsg& pose) {
  return std::to_string(pose.node_id);
  // + "@" + std::to_string(pose.heading);
}

std::string Schedule::ToDotFormatString(bool left_right) const {
  std::stringstream ss;
  ss << "digraph G {" << std::endl;
  ss << "  node [shape=box, style=\"filled,rounded\"];" << std::endl;

  // Optionally lay out the graph left-to-right
  if(left_right) {
    ss << "  rankdir=LR;" << std::endl;
  }

  // Render all nodes
  for(size_t i = 0; i < nodes_.size(); i++) {
    const auto& node = nodes_.at(i);
    std::string color = "lightgray";
    std::string node_string = "";  //"ACTION";

    // auto guidstr = std::to_string(node.guid);
    // node_string = "(" + guidstr.substr(guidstr.length() - 3) + ") ";

    if(node.type == ActionNodeMsg::TYPE_AGV_COMMAND) {
      color = "lightgreen";
      const auto& agv_command = node.agv_command;
      node_string += std::string("a") + std::to_string(node.agv_id);
      if(agv_command.dst.pose != agv_command.src.pose) {
        // AGV move node
        if(agv_command.dst.pose.heading != agv_command.src.pose.heading) {
          node_string +=
              " " + std::to_string(agv_command.src.pose) + " to " + std::to_string(agv_command.dst.pose);
        }
        else {
          node_string += " " + to_str(agv_command.src.pose) + " to " + to_str(agv_command.dst.pose);
        }
      }
      else if(agv_command.dst.lift != agv_command.src.lift) {
        node_string += std::string(" lift ") + (agv_command.dst.lift ? "UP" : "DOWN");
      }
      else {
        node_string += " ???";
      }
    }
    else if(node.type == ActionNodeMsg::TYPE_BAY_COMMAND) {
      color = "lightblue";
      const auto& bay_command = node.bay_command;
      node_string = std::string("b") + std::to_string(node.bay_id);
      if(bay_command.command_type == BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT) {
        node_string += " to insert";
      }
      else if(bay_command.command_type == BayCommandMsg::COMMAND_TYPE_PROCESS_RETRIEVE) {
        node_string += " process retrieve";
      }
      else if(bay_command.command_type == BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE) {
        node_string += " to retrieve";
      }
      else {
        node_string += " ???";
      }
    }
    else if(node.type == ActionNodeMsg::TYPE_VECS_COMMAND) {
      color = "orange";
      node_string = std::string("v") + std::to_string(node.vecs_command);
    }
    else if(node.type == ActionNodeMsg::TYPE_VRC_COMMAND) {
      color = "plum";
      node_string = std::string("vrc") + std::to_string(node.vrc_id);
      node_string += " floor->" + std::to_string(node.vrc_command.requested_floor);
    }
    ss << "  n" << std::to_string(i) << "[label=\"" << node_string << "\", color=" << color << "];"
       << std::endl;
  }

  // Render all edges
  for(size_t i = 0; i < nodes_.size(); ++i) {
    const auto& parent = nodes_.at(i);
    for(auto j : successors_.at(i)) {
      const auto& child = nodes_.at(j);
      if((parent.type >= ActionNodeMsg::TYPE_AGV_COMMAND && child.type >= ActionNodeMsg::TYPE_AGV_COMMAND)) {
        ss << "  n" << std::to_string(i) << " -> n" << std::to_string(j) << ";" << std::endl;
      }
    }
  }

  ss << "}" << std::endl;
  return ss.str();
}

// Print this schedule graph to the log
void Schedule::PrintGraph(const std::string& label, rclcpp::Logger logger) const {
  std::string dotcontents = ToDotFormatString();
  const char* color = "\033[1;36m";  // Bold Cyan
  volley::PrintGraph(label, dotcontents, logger, color);
}

bool Schedule::IsBayOccupiedIndefinitely(uint16_t bay_id) const {
  // The bay is occupied indefinitely if it has an infinite-duration action.
  auto bay_action_index = GetLeadingEntityActionIndex(volley::BayId(bay_id));
  while(bay_action_index.has_value()) {
    uint32_t index = bay_action_index.value();
    if(!std::isfinite(nodes_.at(index).duration)) {
      return true;  // infinite-duration action
    }
    bay_action_index = GetSuccessorEntityActionIndex(index);
  }
  return false;
}

float Schedule::GetNodeStartTime(uint32_t node_index) const {
  uint32_t n = node_index + 1;
  std::vector<float> start_times(n, 0.0f);

  // Take advantage of the topological sorting of nodes_ to compute the start time of each node up
  // to the one we care about.
  for(uint32_t node_id = 0; node_id < std::min<size_t>(n, nodes_.size()); node_id++) {
    if(IsNodeCompleted(node_id)) {
      continue;
    }
    for(auto parent_id : nodes_.at(node_id).parents) {
      if(IsNodeCompleted(parent_id)) {
        continue;
      }
      start_times[node_id] =
          std::max(start_times[node_id], start_times[parent_id] + nodes_.at(parent_id).duration);
    }
  }

  return start_times[node_index];
}

std::vector<float> Schedule::GetNodeStartTimes() const {
  std::vector<float> start_times(nodes_.size(), 0.0f);

  // Take advantage of the topological sorting of nodes_ to compute the start time of each node
  for(uint32_t node_id = 0; node_id < nodes_.size(); node_id++) {
    if(IsNodeCompleted(node_id)) {
      continue;
    }
    for(auto parent_id : nodes_.at(node_id).parents) {
      if(IsNodeCompleted(parent_id)) {
        continue;
      }
      start_times[node_id] =
          std::max(start_times[node_id], start_times[parent_id] + nodes_.at(parent_id).duration);
    }
  }

  return start_times;
}

void Schedule::SplitSchedule(float horizon) {
  std::vector<float> start_times = GetNodeStartTimes();
  for(uint32_t node_index = 0; node_index < nodes_.size(); node_index++) {
    nodes_[node_index].outside_split = start_times[node_index] > horizon;
  }
}

void Schedule::UndoSplit() {
  for(auto& node : nodes_) {
    node.outside_split = false;
  }
}

}  // namespace volley
