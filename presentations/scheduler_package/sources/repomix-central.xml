  vrc_clients_[vrc_id].move_cli = volley::rclcppx::CreateActionClient(node_,
      volley::rclcppx::Namespaced(vrc_interfaces::VrcNamespace(vrc_id), vrc_interfaces::kVrcMoveAction),
      vrc_clients_[vrc_id].client_cb_group);
}

bool DispatchRos::SendVrcCommand(uint16_t vrc_id, const VrcCommandMsg& vrc_command) {
  // VRC commands dispatch directly to the VRC action server for both standalone VRCs and
  // BLift VRCs. For BLifts, the bay state machine tolerates the external carriage move
  // while in READY_* and updates `current_floor_` from the lift report — no out-of-band
  // bay command is needed.
  if(!HasVrc(vrc_id)) {
    CreateVrcClient(vrc_id);
  }

  auto goal = vrc_interfaces::action::VrcMove::Goal();
  goal.requested_floor = vrc_command.requested_floor;

  auto goal_options = rclcpp_action::Client<vrc_interfaces::action::VrcMove>::SendGoalOptions();
  auto future = vrc_clients_[vrc_id].move_cli->async_send_goal(goal, goal_options);

  // Wait for goal acceptance only (not for the action result)
  static std::chrono::seconds kVrcActionAcceptanceTimeout(100);
  if(future.wait_for(kVrcActionAcceptanceTimeout) == std::future_status::timeout) {
    WARNS(node_->get_logger(), "Timeout waiting for VRC r" << vrc_id << " goal acceptance");
    return false;
  }

  auto goal_handle = future.get();
  if(!goal_handle) {
    WARNS(
        node_->get_logger(), "VRC r" << vrc_id << " rejected goal to floor " << vrc_command.requested_floor);
    return false;
  }

  INFOS(node_->get_logger(), "VRC r" << vrc_id << " accepted goal to floor " << vrc_command.requested_floor);
  return true;
}

void DispatchRos::CallPlanner() {
  auto request_opt = dispatch_.GetPlannerServiceRequest(node_->now());
  if(request_opt.has_value()) {
    // Publish plan requests to be bagged
    auto request_msg = request_opt.value()->request_data;
    plan_request_pub_->publish(std::move(request_msg));
    plan_cli_->async_send_request(
        request_opt.value(), [this](std::shared_future<PlanSrv::Response::SharedPtr> future) {
          if(future.valid()) {
            // Publish plan responses to be bagged
            auto response_msg = future.get()->response_data;
            plan_response_pub_->publish(std::move(response_msg));
            dispatch_.PlanClientCallback(future.get(), node_->now());
          }
        });
  }
}

