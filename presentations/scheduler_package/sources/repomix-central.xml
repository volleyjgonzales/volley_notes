<file path="src/mqtt_bridge.cpp">
#include <central/mqtt_bridge.hpp>
#include <central/mqtt_bridge_constants.hpp>
#include <common_ros/ros_utils.hpp>
#include <common_ros/roslog.hpp>
#include <cstdlib>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <nlohmann/json.hpp>
#include <regex>

using json = nlohmann::json;

namespace volley {

// The constructor creates an MQTT client and connects to our MQTT broker. If the connection fails,
// then the mqtt_client_ will be nullptr and no MQTT messages will be published during the lifetime
// of the central nodes which is fine in cases such as running a simulation.
MqttBridge::MqttBridge(const rclcpp::Logger& logger, const std::string& installation_id) :
    logger_(logger), installation_id_(installation_id), mqtt_client_(nullptr) {
  INFOS(logger_, "Setting up MQTT client...");

  if(!SetUpCertificates()) {
    ERRORS(logger_, "There is a problem with the certificates. No MQTT client will be created.");
    return;
  }

  const std::string endpoint_uri = MakeEndpointUri();
  const std::string client_id = installation_id_ + "-central";

  mqtt_client_ = std::make_unique<mqtt::async_client>(endpoint_uri, client_id);

  mqtt::connect_options conn_opts;
  conn_opts.set_clean_start(true);
  conn_opts.set_clean_session(true);
  conn_opts.set_keep_alive_interval(std::chrono::seconds(20));
  conn_opts.set_automatic_reconnect(true);
  conn_opts.set_connect_timeout(5);

  mqtt::ssl_options ssl_opts = MakeSslOptions();
  conn_opts.set_ssl(ssl_opts);

  try {
    INFOS(logger_, "Connecting...");
    auto token = mqtt_client_->connect(conn_opts);
    token->wait();
    INFOS(logger_, "Connected? " << (mqtt_client_->is_connected() ? "Yes." : "No."));
    INFOS(logger_, "Publishing test message on topic 'test_topic'.");
    mqtt_client_->publish("test_topic", "test message!");
    INFOS(logger_, "MQTT Bridge is ready.");
  }
  catch(const mqtt::exception& e) {
    ERRORS(logger_, "Connection failed: " << e.what() << " (Return code: " << e.get_reason_code() << ")");
    mqtt_client_ = nullptr;
  }

  if(!mqtt_client_) {
    ERRORS(logger_, "Failed to connect to " << endpoint_uri << "; No MQTT messages will be published!");
  }
}

// Utility function to check that the certificate file is formatted correctly. Currently this just
// checks that the file starts with -----BEGIN but we can make it more sophisticated if there is an
// issue in the future with writing the certificates.
bool MqttBridge::IsPemFile(const std::string& filename) {
  std::ifstream file(filename);
  std::string line;
  return std::getline(file, line) && line.find("-----BEGIN") != std::string::npos;
}

// Utility function that returns the value of an environment variable as a string.
std::string MqttBridge::GetEnvVariable(const char* var_name) {
  char* value = std::getenv(var_name);
  return value ? std::string(value) : "";
}

// Utility function that writes the contents of an environment variable to a text file. This is
// used to store the AWS IoT certificates in /tmp files so that the MQTT client can use them to
// connect to the broker. The certificates are pulled from AWS Secrets Manager and stored in
// environment variables on deployment.
void MqttBridge::WriteEnvVarToFile(const std::string& var_name, const std::string& filename) {
  // Read the variable.
  std::string content = GetEnvVariable(var_name.c_str());

  // Replace the literal \n in the environment variable with actual newlines.
  std::regex newline_re("\\\\n");
  std::string content_newlines = std::regex_replace(content, newline_re, "\n");

  // Write the content to a text file.
  std::ofstream file(filename);
  file << content_newlines;
  file.close();
}

// Helper function called from the ctor that reads certificates stored as strings in environment
// variables and writes them to text files. This is necessary because the Paho MQTT library only
// accepts file paths and not the certificate values.
bool MqttBridge::SetUpCertificates() const {
  bool certs_ok = true;

  // Env vars are defined in terraform/central_deployment/scheduler.tf and store the
  // certificates. We write them to text files so the client can read them.
  INFOS(logger_, "Writing certificates to files from env vars...");
  WriteEnvVarToFile(kCertVar, kCertFile);
  WriteEnvVarToFile(kKeyVar, kKeyFile);
  WriteEnvVarToFile(kCaVar, kCaFile);

  // Verify the certificate files exist and are readable.
  INFOS(logger_, "Checking file existence and permissions...");
  for(const auto& file : {kCertFile, kKeyFile, kCaFile}) {
    if(!std::filesystem::exists(file) || !std::filesystem::is_regular_file(file)) {
      ERRORS(logger_, "Cannot read file: " << file << " - " << strerror(errno));
      certs_ok = false;
    }
    else {
      INFOS(logger_, "File readable: " << file);
    }
  }

  // Check formatting of the certificate files.
  for(const auto& file : {kCertFile, kKeyFile, kCaFile}) {
    if(!IsPemFile(file)) {
      ERRORS(logger_, "File does not appear to be a valid PEM file: " << file);
      certs_ok = false;
    }
    else {
      INFOS(logger_, "File appears to be a valid PEM file: " << file);
    }
  }

  return certs_ok;
}

// The endpoint URI required by the Paho MQTT client must start with ssl:// and end with the port
// number. The endpoint value that gets stored in AWS Secrets Manager from Terraform output does
// have it.
const std::string MqttBridge::MakeEndpointUri() const {
  const std::string endpoint = GetEnvVariable("IOT_ENDPOINT");
  const std::string endpoint_uri = "ssl://" + endpoint + ":8883";
  INFOS(logger_, "AWS IoT endpoint URI: " << endpoint_uri);
  return endpoint_uri;
}

// Constructs SSL connection parameters and sets them to the certificate files.
mqtt::ssl_options MqttBridge::MakeSslOptions() const {
  mqtt::ssl_options ssl_opts;

  try {
    ssl_opts.set_key_store(kCertFile);
    INFOS(logger_, "Key store set successfully: " << kCertFile);
  }
  catch(const mqtt::exception& e) {
    ERRORS(logger_, "Error setting key store: " << e.what());
  }

  try {
    ssl_opts.set_private_key(kKeyFile);
    INFOS(logger_, "Private key set successfully: " << kKeyFile);
  }
  catch(const mqtt::exception& e) {
    ERRORS(logger_, "Error setting private key: " << e.what());
  }

  try {
    ssl_opts.set_trust_store(kCaFile);
    INFOS(logger_, "Trust store set successfully: " << kCaFile);
  }
  catch(const mqtt::exception& e) {
    ERRORS(logger_, "Error setting trust store: " << e.what());
  }

  return ssl_opts;
}

// Publishes a message through the client, unless the client is nullptr which means we failed to
// connect in the constructor in which case nothing happens.
void MqttBridge::PublishMessage(const std::string& topic, const std::string& json_str) {
  if(mqtt_client_) {
    if(!mqtt_client_->is_connected()) {
      // Attempt to reconnect.
      ERRORS(logger_, "MQTT client is not connected.");

      try {
        auto token = mqtt_client_->reconnect();
        if(!token->wait_for(kConnectionWaitForMs)) {
          ERRORS(logger_, "MQTT client reconnection timed out.");

          if(++failed_reconnection_attempts_ >= kConnectionAttemptsAllowed) {
            ERRORS(logger_, "Too many failed attempts to reconnect, disabling MQTT client.");
            mqtt_client_.reset();
          }
          return;
        }
        else {
          INFOS(logger_, "MQTT client reconnected.");
          failed_reconnection_attempts_ = 0;
        }
      }
      catch(const mqtt::exception& e) {
        ERRORS(logger_, "Reconnection failed: " << e.what() << " (Return code: " << e.get_reason_code() << ")"
                                                << "(Count: " << (failed_reconnection_attempts_ + 1) << ")");
        if(++failed_reconnection_attempts_ >= kConnectionAttemptsAllowed) {
          ERRORS(logger_, "Too many failed attempts to reconnect, disabling MQTT client.");
          mqtt_client_.reset();
        }
        return;
      }
    }

    // Client should be connected if we didn't return above, so try publishing.
    try {
      mqtt_client_->publish(topic, json_str);
    }
    catch(const mqtt::exception& e) {
      ERRORS(logger_, "Publishing failed: " << e.what() << " (Return code: " << e.get_reason_code() << ")");
    }
  }
}

// Public facing callback for MqttBridgeRos' garage status subscription.
std::string MqttBridge::PublishGarageStatus(GarageStatusReportMsg::UniquePtr msg) {
  std::string json_str = ToJsonString(*msg);
  PublishMessage(installation_id_ + "/central/garage_status", json_str);
  return json_str;
}

// Public facing callback for MqttBridgeRos' VECS report subscriptions.
std::string MqttBridge::PublishVecsReport(VecsReportMsg::UniquePtr msg) {
  std::string json_str = ToJsonString(*msg);
  const std::string topic = installation_id_ + "/vecs/" + msg->name + "/report";
  PublishMessage(topic, json_str);
  return json_str;
}

// Functions that convert ROS messages into JSON strings. For more info about how these JSON
// objects are formed, see
// https://github.com/nlohmann/json?tab=readme-ov-file#json-as-first-class-data-type

// GarageStatusReport to JSON.
std::string MqttBridge::ToJsonString(const GarageStatusReportMsg& msg) const {
  json json_object = {
      {"header", {{"stamp", {{"sec", msg.header.stamp.sec}, {"nanosec", msg.header.stamp.nanosec}}}}},
      {"active_agv_count", msg.active_agv_count}, {"active_bay_count", msg.active_bay_count},
      {"agv_ids", msg.agv_ids}, {"agv_statuses", msg.agv_statuses}, {"bay_ids", msg.bay_ids},
      {"bay_statuses", msg.bay_statuses}, {"downtime_seconds", msg.downtime_seconds},
      {"garage_up", msg.garage_up}, {"in_auto_mode", msg.in_auto_mode}, {"reason", msg.reason},
      {"uptime_seconds", msg.uptime_seconds}};

  return json_object.dump();
}

// VecsReport to JSON.
std::string MqttBridge::ToJsonString(const VecsReportMsg& msg) const {
  json json_object = {
      {"header", {"stamp", {{"sec", msg.header.stamp.sec}, {"nanosec", msg.header.stamp.nanosec}}}},
      {"vecs_id", msg.vecs_id}, {"name", msg.name}, {"state", msg.state}, {"state_string", msg.state_string},
      {"current_command_type", msg.current_command_type},
      {"current_command_type_string", msg.current_command_type_string},
      {"current_command_status", msg.current_command_status},
      {"current_command_status_string", msg.current_command_status_string}};

  return json_object.dump();
}

}  // namespace volley
</file>

