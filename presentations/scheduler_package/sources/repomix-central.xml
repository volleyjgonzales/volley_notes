static
std::string to_str(const GaragePoseMsg& pose) {
  return std::to_string(pose.node_id) + "@" + std::to_string(pose.heading);
}

static
std::string parent_node_str(const Schedule& sched, uint32_t parent_idx) {
  const auto& parent_node = sched.GetNode(parent_idx);
  std::string s = "idx=" + std::to_string(parent_idx);
  s += " completed=" + std::to_string(sched.IsNodeCompleted(parent_idx));
  s += " received=" + std::to_string(sched.IsNodeReceived(parent_idx));
  if(parent_node.type == ActionNodeMsg::TYPE_AGV_COMMAND) {
    const auto& cmd = parent_node.agv_command;
    if(cmd.dst.lift != cmd.src.lift) {
      s += " lift_" + std::string(cmd.dst.lift ? "UP" : "DOWN");
    } else {
      s += " " + to_str(cmd.src.pose) + "->" + to_str(cmd.dst.pose);
    }
  }
  return "[" + s + "]";
}

// Map every AGV ActionNode id to its motion batch
void ExecutionState::CoalesceMotionBatches() {
  startnodebatchmap_.clear();
  allnodebatchmap_.clear();

  const std::vector<ActionNodeMsg>& schednodes = schedule_.GetNodes();
  if(schednodes.empty()) {
    return;
  }

  LayoutSPtr layout = safety_checker_->GetGarageGraph().GetLayout();
  std::unordered_map<uint16_t, std::vector<uint32_t>> agvindices;

  for(uint32_t index = 0; index < schednodes.size(); index++) {
    const auto& node = schednodes[index];
    if(node.type != ActionNodeMsg::TYPE_AGV_COMMAND) {
      continue;
    }
    uint16_t agv_id = node.agv_id;
    agvindices[agv_id].push_back(index);
  }

  // For each AGV, look at pairs of nodes.
  // Find all nodes that are non-continous motion, i.e. wait for a parent.
  for(const auto& [agv_id, indices] : agvindices) {
    auto it = indices.begin();
    uint32_t index0 = *it;

    MotionBatchSPtr batch = std::make_shared<MotionBatch>();
    batch->agv_id_ = agv_id;
    batch->state_ = MBS_PENDING;
    batch->indices_.push_back(index0);
    startnodebatchmap_[index0] = batch;
    allnodebatchmap_[index0] = batch;

    while(it != indices.end()) {
      const auto& node0 = schednodes[index0];
      const auto& cmd0 = node0.agv_command;

      // Check the two nodes for this AGV.
      std::string nodestr;
      nodestr += "a" + std::to_string(agv_id);

      nodestr += " ";
      nodestr += std::to_string(index0);
      nodestr += " ";

      if(cmd0.dst.pose != cmd0.src.pose) {
        nodestr += " " + to_str(cmd0.src.pose) + " to " + to_str(cmd0.dst.pose);
      }
      else if(cmd0.dst.lift != cmd0.src.lift) {
        nodestr += std::string(" lift ") + (cmd0.dst.lift ? "UP" : "DOWN");
      }

      // Is there a parent node that requires waiting?
      if(node0.parents.size() > 1 ) {
        nodestr += " [";
        for(auto parent_index : node0.parents) {
          nodestr += std::to_string(parent_index) + " ";
        }
        nodestr += "] ";
      }

      if(cmd0.src.pose.heading != cmd0.dst.pose.heading) {
        nodestr += " rotation cmd0";
      }

      // Is there a lift raise or lift lower command?
      bool has_lift = false;
      if(cmd0.dst.lift != cmd0.src.lift) {
        has_lift = true;
      }
      if(has_lift) {
        // node0 is lift, so node0 is its own motion batch by itself.
        INFOF(rclcpp::get_logger(""), "    0 has lift, start new batch  %s", nodestr.c_str() );
        batch = std::make_shared<MotionBatch>();
        batch->agv_id_ = agv_id;
        batch->state_ = MBS_PENDING;
        batch->indices_.push_back(index0);
        startnodebatchmap_[index0] = batch;
        allnodebatchmap_[index0] = batch;

        it++;
        if(it != indices.end()) {
          // Next motion batch
          uint32_t index1 = *it;

          INFOF(rclcpp::get_logger(""), "    1 has lift, start next batch  %s", nodestr.c_str() );
          batch = std::make_shared<MotionBatch>();
          batch->agv_id_ = agv_id;
          batch->state_ = MBS_PENDING;
          batch->indices_.push_back(index1);
          startnodebatchmap_[index1] = batch;
          allnodebatchmap_[index1] = batch;

          index0 = index1;
          continue;
        }
        else {
          break;
        }
      }
      else {
        // Not a lift command.
        it++;
        uint32_t index1 = index0;
        if(it != indices.end()) {
          index1 = *it;
          const auto& node1 = schednodes[index1];
          const auto& cmd1 = node1.agv_command;

          if(cmd0.dst.pose.heading != cmd1.src.pose.heading) {
            nodestr += " rotation between nodes??";
          }
          if(cmd1.src.pose.heading != cmd1.dst.pose.heading) {
            nodestr += " rotation cmd1";
          }
          nodestr += " --> ";
          nodestr += " ";
          nodestr += std::to_string(index1);
          nodestr += " ";
          if(cmd1.dst.pose != cmd1.src.pose) {
            nodestr += " " + to_str(cmd1.src.pose) + " to " + to_str(cmd1.dst.pose);
          }
          else if(cmd1.dst.lift != cmd1.src.lift) {
            nodestr += std::string(" lift ") + (cmd1.dst.lift ? "UP" : "DOWN");
          }

          if(cmd1.dst.lift != cmd1.src.lift) {
            has_lift = true;
          }
          if(has_lift) {
            // node1 is lift, so node1 is its own motion batch by itself.
            batch = std::make_shared<MotionBatch>();
            batch->agv_id_ = agv_id;
            batch->state_ = MBS_PENDING;
            batch->indices_.push_back(index1);
            startnodebatchmap_[index1] = batch;
            allnodebatchmap_[index1] = batch;

            it++;
            if(it != indices.end()) {
              // Next motion batch
              uint32_t index1 = *it;

              INFOF(rclcpp::get_logger(""), "    2 has lift, start next batch  %s", nodestr.c_str() );
              batch = std::make_shared<MotionBatch>();
              batch->agv_id_ = agv_id;
              batch->state_ = MBS_PENDING;
              batch->indices_.push_back(index1);
              startnodebatchmap_[index1] = batch;
              allnodebatchmap_[index1] = batch;

              index0 = index1;
              continue;
            }
            else {
              break;
            }
          }


          // Is there a parent node the must be completed before node1 can start?
          bool has_wait = false;
          if(node1.parents.size() > 1) {
            nodestr += " (";
            for(auto parent_index : node1.parents) {
              if(parent_index != (index0)) {
                nodestr += "wait " + std::to_string(parent_index) + " ";
                has_wait = true;
              }
            }
            nodestr += ") ";
          }

          if(has_wait) {
            // Requires AGV waiting for a parent node.  So node1 is the start of a new motion batch.
            INFOF(rclcpp::get_logger(""), "    has wait, start new batch  %s", nodestr.c_str() );
            batch = std::make_shared<MotionBatch>();
            batch->agv_id_ = agv_id;
            batch->state_ = MBS_PENDING;
            batch->indices_.push_back(index1);
            startnodebatchmap_[index1] = batch;
            allnodebatchmap_[index1] = batch;
          }
          else {
            INFOF(rclcpp::get_logger(""), "    add to existing batch  %s", nodestr.c_str() );
            batch->indices_.push_back(index1);
            allnodebatchmap_[index1] = batch;
          }
        }

        index0 = index1;
      }

    }

    INFOF(rclcpp::get_logger(""), "   ");
  }

  for(const auto& [startindex, batch] : startnodebatchmap_) {
    if(batch != nullptr) {
    INFOF(rclcpp::get_logger(""), "  AGV:%d BatchStart:%d BatchSize:%ld ",
      batch->agv_id_, batch->indices_[0], batch->indices_.size() );
    }
    else {
      ERRORF(rclcpp::get_logger(""), "  BATCH at startindex:%d IS NULLPTR", startindex );
      continue;
    }
    for(const uint32_t index : batch->indices_) {
      const auto& node = schednodes[index];
      const auto& cmd = node.agv_command;
      std::string nodestr;
      if(cmd.dst.pose != cmd.src.pose) {
        nodestr += " " + to_str(cmd.src.pose) + " to " + to_str(cmd.dst.pose);
      }
      else if(cmd.src.pose.heading != cmd.dst.pose.heading) {
        nodestr += " rotation ";
      }
      else if(cmd.dst.lift != cmd.src.lift) {
        nodestr += std::string(" lift ") + (cmd.dst.lift ? "UP" : "DOWN");
      }
      INFOF(rclcpp::get_logger(""), "       index:%d  %s", index, nodestr.c_str());
    }
  }
}

std::unordered_map<uint16_t, std::unique_ptr<AgvCommandSequenceMsg>> ExecutionState::GetAgvCommandSequences(
    const rclcpp::Time& now) const {
  std::unordered_map<uint16_t, std::unique_ptr<AgvCommandSequenceMsg>> command_sequences;

  // Go through schedule in topological order, copying AGV Commands to the command sequences
  for(const auto& node : schedule_.GetNodes()) {
    if(node.type != ActionNodeMsg::TYPE_AGV_COMMAND) {
      continue;
    }
    auto agv_id = node.agv_id;
    // Add a CommandSequence to the map if this is the first time seeing this AGV ID
    if(command_sequences.find(agv_id) == command_sequences.end()) {
      command_sequences[agv_id] = std::make_unique<AgvCommandSequenceMsg>();
      command_sequences[agv_id]->header.stamp = now;
      command_sequences[agv_id]->agv_id = agv_id;
    }

    // Populate the message fields and add it to the sequence
    auto agv_command = node.agv_command;
    AgvCommandStatusMsg command_status;
    switch(node.status) {
    case ActionNodeMsg::STATUS_NOT_RECEIVED:
      command_status.status = "NOT_RECEIVED";
      break;
    case ActionNodeMsg::STATUS_RECEIVED:
      command_status.status = "RECEIVED";
      break;
    case ActionNodeMsg::STATUS_COMPLETED:
      command_status.status = "COMPLETED";
      break;
    default:
      command_status.status = "UNKNOWN";  // should never happen
    }
    command_status.description = std::to_string(agv_command.src) + "->" + std::to_string(agv_command.dst);
    // Note this command type is not a 1:1 match with the Type enum in agv_command.hpp
    if(agv_command.src == agv_command.dst) {
      command_status.command_type = "CENTER";
    }
    else if(agv_command.src.pose.node_id != agv_command.dst.pose.node_id) {
      command_status.command_type = "MOVE";
    }
    else if(agv_command.src.lift != agv_command.dst.lift) {
      command_status.command_type = agv_command.dst.lift ? "LIFT_RAISE" : "LIFT_LOWER";
    }
    else if(agv_command.src.pose.heading != agv_command.dst.pose.heading) {
      command_status.command_type = "ROTATE";
    }
    else {
      command_status.command_type = "UNKNOWN";  // Should never happen
    }

    command_sequences[agv_id]->command_sequence.push_back(command_status);
  }

  return command_sequences;
}

// Old unit tests call this version of Update().
BoolStringPair ExecutionState::Update(const DiscreteGarageEventMsg& event) {
  DiscreteGarageEventStampedMsg event_stamped;
  event_stamped.event = event;
  return Update(event_stamped);
}

// Dispatcher calls this version of Update() so I can see the sequence number.
BoolStringPair ExecutionState::Update(const DiscreteGarageEventStampedMsg& event_stamped) {
  const auto& event = event_stamped.event;

  if(printdags_) {
    schedule_.PrintGraph(std::string("ExecutionStateUpdate_before_") +
                         std::to_string(event_stamped.sequence_number) + "_" + event.type);
  }
  auto [success, message] = UpdateInternal(event);
  if(!success) {
    diverged_ = true;
  }

  if(printdags_) {
    schedule_.PrintGraph(std::string("ExecutionStateUpdate_after_") +
                         std::to_string(event_stamped.sequence_number) + "_" + event.type);
  }
  return std::make_pair(success, message);
}

void ExecutionState::SendReadyBayCommand(uint16_t bay_id) {
  auto entity_id = volley::BayId(bay_id);

  // Get the leading action, if there is one
  auto leading_action_index_opt = schedule_.GetLeadingEntityActionIndex(entity_id);
  if(!leading_action_index_opt.has_value()) {
    // Nothing to dispatch
    return;
  }

  unsigned int leading_action_index = leading_action_index_opt.value();

  // The leading action must be ready
  if(!schedule_.IsNodeReady(leading_action_index)) {
    return;
  }

  // If the leading action has already been received we do not need to send it again
  if(schedule_.IsNodeReceived(leading_action_index)) {
    return;
  }

  // Make sure command will be sent within the command send horizon and command is inside the
  // schedule split if there is an ongoing plan call
  if((!IsActionInsideCommandHorizon(leading_action_index)) ||
      schedule_.IsNodeOutsideSplit(leading_action_index)) {
    return;
  }

  // We have our chosen command
  auto [safe, msg] =
      safety_checker_->Apply(schedule_.GetNode(leading_action_index), exec_state_latest_.GetGarageState());

  if(!safe) {
    // TODO(Gunther): Logger here?
    std::cout << "Safety check failed trying to send action node " << msg << std::endl;
    return;
  }
  // std::cout << "Safety Checker Applied: "
  //           << std::to_string(schedule_.GetNode(leading_action_index)) << std::endl;

  if(command_send_->sendBayCommand(bay_id, schedule_.GetNode(leading_action_index).bay_command)) {
    schedule_.MarkActionReceived(leading_action_index);
  }
}

void ExecutionState::SendReadyVecsCommand(uint16_t vecs_id) {
  auto entity_id = volley::VecsId(vecs_id);

  // Get the leading action, if there is one
  auto leading_action_index_opt = schedule_.GetLeadingEntityActionIndex(entity_id);
  if(!leading_action_index_opt.has_value()) {
    // Nothing to dispatch
    return;
  }

  unsigned int leading_action_index = leading_action_index_opt.value();

  // The leading action must be ready
  if(!schedule_.IsNodeReady(leading_action_index)) {
    return;
  }

  // If the leading action has already been received we do not need to send it again
  if(schedule_.IsNodeReceived(leading_action_index)) {
    return;
  }

  // Make sure command will be sent within the command send horizon and command is inside the
  // schedule split if there is an ongoing plan call
  if((!IsActionInsideCommandHorizon(leading_action_index)) ||
      schedule_.IsNodeOutsideSplit(leading_action_index)) {
    return;
  }

  auto tray_opt = exec_state_latest_.GetGarageState().GetTrayOnNode(vecs_id);
  if(tray_opt.has_value()) {
    if(tray_opt->agv_id) {
      // Don't tell the VECS to do anything if there's a non-lowered tray on this node
      return;
    }
  }
  // We have our chosen command
  auto [safe, msg] =
      safety_checker_->Apply(schedule_.GetNode(leading_action_index), exec_state_latest_.GetGarageState());

  if(!safe) {
    // TODO(Gunther): Logger here?
    std::cout << "Safety check failed trying to send action node " << msg << std::endl;
    return;
  }

  if(command_send_->sendVecsCommand(vecs_id, schedule_.GetNode(leading_action_index).vecs_command)) {
    schedule_.MarkActionReceived(leading_action_index);
  }
}

