<file path="src/agv_monitor.cpp">
#include <central/agv_monitor.hpp>
#include <common_ros/roslog.hpp>

namespace volley {

AgvMonitor::AgvMonitor(double low_agv_battery_fraction_threshold,
    const std::function<void(SetResourceDisablednessSrv::Request::SharedPtr)> disable_agv,
    const rclcpp::Logger& logger) :
    low_agv_battery_fraction_threshold_(low_agv_battery_fraction_threshold),
    disable_agv_(disable_agv),
    logger_(logger) {
}

void AgvMonitor::SetContinuousGarageInfo(ContinuousGarageInfoMsg::UniquePtr info) {
  for(const auto& agv_info : info->agvs) {
    // NOTE: This implementation does not do any debouncing, and triggers on the first low
    //       voltage report. In the future, we may wish to add debouncers for every AGV, and
    //       dynamically add new debouncers as new AGVs are added.

    if(agv_info.report.battery_fraction < low_agv_battery_fraction_threshold_) {
      // AGV has low voltage.
      // Only respond to AGVs that we have in our map
      // We want to avoid weird race conditions on startup. If they are not in the discrete
      // garage state, then telling the garage tracker to disable them won't do anything
      // anyway.
      auto it = agv_disabledness_map_.find(agv_info.report.agv_id);
      if(it != agv_disabledness_map_.end()) {
        // Disable the AGV if it is not already disabled.
        if(!it->second) {
          // Disable the AGV
          WARNS(logger_, "a" << std::to_string(agv_info.report.agv_id) << " battery fraction "
                             << agv_info.report.battery_fraction << " is below "
                             << low_agv_battery_fraction_threshold_ << ". Disabling.");

          auto request = std::make_shared<SetResourceDisablednessSrv::Request>();
          request->resource_id = agv_info.report.agv_id;
          request->disable = true;
          disable_agv_(request);
        }
      }
    }
  }
}

void AgvMonitor::SetDiscreteGarageState(DiscreteGarageStateMsg::UniquePtr state) {
  // Update our disabledness map
  for(const auto& agv : state->agvs) {
    agv_disabledness_map_[agv.id] = agv.disabled;
  }
}

}  // namespace volley
</file>

<file path="src/charge_agvs.cpp">
#include <central/charge_agvs.hpp>

namespace volley {

bool OnChargeNode(const DiscreteAgvStateMsg& agv, PoseGraphCSPtr pose_graph) {
  auto agv_node_opt = pose_graph->GetLayout()->GetNodeById(agv.pose.node_id);
  if(!agv_node_opt.has_value()) {
    return false;
  }
  auto agv_node = agv_node_opt.value();

  // The AGV is only considered to be already charging if its heading matches the Charge node's
  // primary heading
  int16_t node_primary_heading = agv_node.headings.at(0);
  if(agv_node.faces_reciprocal) {
    node_primary_heading = static_cast<int16_t>(volley::Wrap(node_primary_heading + 180));
  }

  return agv_node.type == GarageNodeMsg::TYPE_AGV_CHARGE && agv.pose.heading == node_primary_heading;
}

std::vector<uint16_t> ChargeAgvs(const volley::DiscreteGarageState& future_state, PoseGraphCSPtr pose_graph,
    std::vector<ContinuousGarageAgvInfoMsg> agv_infos, double low_battery_thresh) {
  std::vector<uint16_t> agvs_to_charge;

  // Only create as many AGV Charge Jobs as we have AGV Charge nodes in the layout.
  int available_charge_nodes =
      static_cast<int>(pose_graph->GetLayout()->GetNodeIdsOfType(GarageNodeMsg::TYPE_AGV_CHARGE).size());

  // Sort the AGVs by battery fraction, such that AGVs that need
  // charging the most come first.
  std::sort(agv_infos.begin(), agv_infos.end(),
      [](const ContinuousGarageAgvInfoMsg& a, const ContinuousGarageAgvInfoMsg& b) {
        return a.report.battery_fraction < b.report.battery_fraction;  // increasing order
      });

  // First count all the AGVs that already are charging in the future state, so we know exactly
  // how many charge nodes are available
  for(const auto& agv_info : agv_infos) {
    auto future_agv = future_state.GetAgv(agv_info.report.agv_id);
    if(future_agv.has_value()) {
      // Decrease available charge nodes if this AGV is already ending up on one
      available_charge_nodes -= OnChargeNode(future_agv.value(), pose_graph);
    }
  }

  // Determine which AGVs should be sent to charge
  for(const auto& agv_info : agv_infos) {
    if(available_charge_nodes == 0) {
      break;
    }
    // Skip any AGV that, for some reason, does not exist
    auto future_agv = future_state.GetAgv(agv_info.report.agv_id);
    if(!future_agv.has_value()) {
      continue;
    }

    // Skip if it's already going to an AGV Charge node
    if(OnChargeNode(future_agv.value(), pose_graph)) {
      continue;
    }

    // Skip if, for some reason, the AGV's node does not exist
    auto agv_node_opt = pose_graph->GetLayout()->GetNodeById(future_agv->pose.node_id);
    if(!agv_node_opt.has_value()) {
      continue;
    }
    auto agv_node = agv_node_opt.value();

    // Skip the AGV if it's stuck in a bay and the bay is not in a state that can be
    // transitioned immediately
    if(agv_node.type == GarageNodeMsg::TYPE_BAY) {
      auto future_bay = future_state.GetBay(agv_node.id);
      if(!future_bay.has_value()) {
        continue;
      }

      // If the bay is in ready for retrieve, the ODP is not blocking its path to a charge
      // node. If the bay is in ready for insert, only make the job to free it from the bay if
      // its battery is below the threshold. If it's in neither, we cannot immediately
      // transition the bay to free the AGV, so we do not create the job
      bool bay_in_retrieve = future_bay->state == BayReportMsg::STATE_READY_TO_RETRIEVE;
      bool bay_in_insert = future_bay->state == BayReportMsg::STATE_READY_TO_INSERT;
      bool agv_low_battery = agv_info.report.battery_fraction < low_battery_thresh;
      if(!(bay_in_retrieve || (bay_in_insert && agv_low_battery))) {
        continue;
      }
    }

    // If there are no issues, add a pending job for this AGV
    agvs_to_charge.push_back(agv_info.report.agv_id);

    // If we are going to add a pending job for this AGV, decrease the available nodes counter
    --available_charge_nodes;
  }

  return agvs_to_charge;
}

}  // namespace volley
</file>

