<file path="include/central/garage_tracker.hpp">
#pragma once
#include <central/central_msgs.hpp>
#include <central/garage_tracker_mysql_io.hpp>
#include <common/types.hpp>
#include <common_ros/discrete_garage_event_io.hpp>
#include <common_ros/discrete_garage_state.hpp>
#include <common_ros/layout.hpp>
#include <common_ros/print_utils.hpp>
#include <map>
#include <std_srvs/srv/trigger.hpp>
#include <vrc_interfaces/msg/vrc_report.hpp>

#include "vrc_interfaces/msg/vrc_report.hpp"

// These two macros are a workaround to avoid clang-tidy checks from hanging:
// bugprone-reserved-identifier and readability-identifier-naming
// The static assert in the regular RCLCPP_ macros seem to put clang-tidy
// into an infinite loop. The macros are defined here because it seems to be
// the only part of the code that is affected. They are a copy of the macros
// in rclcpp/logging.hpp minus the static_asserts.
// It should be safe to remove static_asserts since the RCLCPP_ macros are used
// elsewhere in the code without triggering the assertions.
// NOLINTBEGIN(cppcoreguidelines-macro-usage,bugprone-macro-parentheses)
#define WORKAROUND_WARNS(logger, stream_arg)                                            \
  do {                                                                                  \
    std::stringstream rclcpp_stream_ss_;                                                \
    rclcpp_stream_ss_ << stream_arg;                                                    \
    RCUTILS_LOG_WARN_NAMED((logger).get_name(), "%s", rclcpp_stream_ss_.str().c_str()); \
  } while(0)

#define WORKAROUND_ERRORS(logger, stream_arg)                                            \
  do {                                                                                   \
    std::stringstream rclcpp_stream_ss_;                                                 \
    rclcpp_stream_ss_ << stream_arg;                                                     \
    RCUTILS_LOG_ERROR_NAMED((logger).get_name(), "%s", rclcpp_stream_ss_.str().c_str()); \
  } while(0)
// NOLINTEND(cppcoreguidelines-macro-usage,bugprone-macro-parentheses)

namespace volley {

constexpr int kNumEventsBetweenSnapshots = 1000;

/*
The garage tracker is a module that acts as the source of truth for the discrete garage state.
The volley garage system does not directly observe tray and payload positions. As such, we need
to keep track of every time a tray moves with an AGV, so that we can maintain our knowledge of
where things are. This includes recovery from a power failure.

The garage tracker maintains the discrete garage state. It receives information from garage
entities such as bays and AGVs, and uses that to update the state. State updates take the form
of events. Each event is applied as a delta to the larger garage state. These events are
published such that other ROS components can keep track of the discrete garage state without
having to receive full state messages.

The events published by the garage tracker include state hashes such that subscribers can know
when they have diverged. If they have, they can also subscribe to our full-state topic.

Note that the garage tracker does not validate all changes against a layout. It will happily update
the AGV's state to an invalid pose if the AGV reports an invalid pose.
*/
class GarageTracker {
public:
  GarageTracker(LayoutSPtr layout, std::optional<GarageDatabaseParameters> db_params,
      const std::function<void(DiscreteGarageEventStampedMsg::UniquePtr)>& event_publisher,
      const rclcpp::Logger& logger, bool simulation = false);

  void AgvReportCallback(AgvReportMsg::UniquePtr agv_report);
  void BayReportCallback(BayReportMsg::UniquePtr bay_report);
  void VecsReportCallback(VecsReportMsg::UniquePtr vecs_report);
  void VrcReportCallback(vrc_interfaces::msg::VrcReport::UniquePtr vrc_report);

  // Service callbacks
  void AddAgvSrvCallback(
      SetUInt16Srv::Request::SharedPtr request, SetUInt16Srv::Response::SharedPtr response);
  void AddPayloadSrvCallback(
      AddPayloadSrv::Request::SharedPtr request, AddPayloadSrv::Response::SharedPtr response);
  void AddTraySrvCallback(AddTraySrv::Request::SharedPtr request, AddTraySrv::Response::SharedPtr response);
  void FaultResetSrvCallback(TriggerSrv::Response::SharedPtr response);
  void PlacePayloadInBaySrvCallback(
      PlacePayloadInBaySrv::Request::SharedPtr request, PlacePayloadInBaySrv::Response::SharedPtr response);
  void RemoveAgvSrvCallback(
      SetUInt16Srv::Request::SharedPtr request, SetUInt16Srv::Response::SharedPtr response);
  void RemovePayloadFromBaySrvCallback(
      SetUInt32Srv::Request::SharedPtr request, SetUInt32Srv::Response::SharedPtr response);
  void RemovePayloadFromTraySrvCallback(
      SetUInt16Srv::Request::SharedPtr request, SetUInt16Srv::Response::SharedPtr response);
  void RemoveTraySrvCallback(
      SetUInt16Srv::Request::SharedPtr request, SetUInt16Srv::Response::SharedPtr response);
  void SetAgvDisablednessSrvCallback(SetResourceDisablednessSrv::Request::SharedPtr request,
      SetResourceDisablednessSrv::Response::SharedPtr response);
  void SetNodeDisablednessSrvCallback(SetResourceDisablednessSrv::Request::SharedPtr request,
      SetResourceDisablednessSrv::Response::SharedPtr response);
  void SetVecsDisablednessSrvCallback(SetResourceDisablednessSrv::Request::SharedPtr request,
      SetResourceDisablednessSrv::Response::SharedPtr response);
  void SetTrayDisablednessSrvCallback(SetResourceDisablednessSrv::Request::SharedPtr request,
      SetResourceDisablednessSrv::Response::SharedPtr response);
  void SetTrayPoseSrvCallback(
      MoveTraySrv::Request::SharedPtr request, MoveTraySrv::Response::SharedPtr response);

  const volley::DiscreteGarageState& GetState() const { return state_; }
  ContinuousGarageInfoMsg::UniquePtr GetContinuousGarageInfo(const rclcpp::Time& now) const;
  DiscreteGarageStateMsg::UniquePtr GetDiscreteGarageState(const rclcpp::Time& now) const;

  std::vector<GarageEntityIdMsg> ValidatePosesForLayout() const;

  void CaptureGarageSnapshot(GarageSnapshotMsg& snapshot, const rclcpp::Time& now);

private:
  BoolStringPair PublishSerializedEvent(const DiscreteGarageEventMsg& serialized_event, size_t hash_prev);

  // Apply the given discrete garage event (specific event type from
  // interfaces::msg rather than the general DiscreteGarageEvent)
  // Note that any event we generate ourselves should never fail to be applied. However,
  // some events, such as those caused by outside triggers like PlacePayloadInBaySrvCallback,
  // could be malformatted and not succeed.
  template <typename T>
  BoolStringPair ApplyAndPublishEvent(const T& discrete_garage_event, bool should_never_fail = true) {
    size_t hash_prev = state_.Hash();
    auto [success, message] = state_.OnEvent(discrete_garage_event);

    if(!success) {
      if(should_never_fail) {
        // We should never fail to apply our own events.
        WORKAROUND_ERRORS(logger_, "Failed to apply event: " << message);
      }
      else {
        WORKAROUND_WARNS(logger_, "Failed to apply event: " << message);
      }

      return std::make_pair(false, message);
    }

    // Serialize the event
    auto event_opt = volley::Serialize(discrete_garage_event);
    if(!event_opt.has_value()) {
      // We should never fail to serialize an event.
      WORKAROUND_ERRORS(logger_, "Failed to serialize event");
      return std::make_pair(false, "Failed to serialize event");
    }

    return PublishSerializedEvent(event_opt.value(), hash_prev);
  }

  // Apply the given discrete garage event (specific event type from
  // interfaces::msg rather than the general DiscreteGarageEvent)
  // and fault if it fails.
  template <typename T>
  BoolStringPair ApplyAndPublishEventOrFault(const T& discrete_garage_event) {
    auto [success, msg] = ApplyAndPublishEvent(discrete_garage_event);
    if(!success && !state_.IsFaulted()) {
      // Issue a fault
      ApplyAndPublishEvent(volley::GetFaultedEvent(true));
    }
    return {success, msg};
  }

  BoolStringPair PublishPayloadEvChargeEvent(DiscretePayloadStateMsg payload, bool charging);

  // Update position of any un-carried tray to the current VRC (virtual) node
  void CorrectVrcTrayPoses(uint16_t vrc_id, uint16_t current_floor);

  // Return the VRC virtual node ID for the current floor of the vrc
  uint32_t ResolveVrcNodeId(uint32_t reported_node_id) const;

  // Latest event sequence number
  uint64_t sequence_number_ = 0;

  // Maintain the discrete state of the garage
  volley::DiscreteGarageState state_;

  // Parameters for connecting to our MySQL database
  // If these do not exist (such as in sim), we do not interact with MySQL.
  std::optional<GarageDatabaseParameters> db_params_;

  // Keep track of the latest reports from each entity
  // (Ordered map, so our published ContinuousGarageInfo is always ordered)
  std::map<uint16_t, AgvReportMsg> agv_reports_;
  std::map<uint16_t, BayReportMsg> bay_reports_;
  std::map<uint16_t, VecsReportMsg> vecs_reports_;
  std::map<uint16_t, vrc_interfaces::msg::VrcReport> vrc_reports_;

  // Our layout. Used only to verify manual requests (such as adding a or moving a tray). We do
  // not verify that all garage updates are valid since the job of the garage tracker to just
  // track what happens and not to determine if what happened was valid.
  LayoutSPtr layout_;

  // A function for sending the discrete garage events wherever they need to go. Note that the
  // message stamp will need to be populated by this function.
  std::function<void(DiscreteGarageEventStampedMsg::UniquePtr)> event_publisher_;

public:
  rclcpp::Logger logger_;
  bool simulation_ = false;
};

}  // namespace volley
</file>

<file path="include/central/metrics_recorder.hpp">
#pragma once

#include <agv_interfaces/msg/node_accuracy_stamped.hpp>
#include <atomic>
#include <common_ros/node.hpp>
#include <cstdint>
#include <interfaces/msg/agv_report.hpp>
#include <interfaces/msg/bay_report.hpp>
#include <interfaces/msg/continuous_garage_info.hpp>
#include <interfaces/msg/discrete_garage_state.hpp>
#include <interfaces/msg/dispatch_report.hpp>
#include <interfaces/msg/scheduler_job.hpp>
#include <interfaces/msg/scheduler_job_list.hpp>
#include <map>
#include <optional>
#include <otel/metrics_client.hpp>
#include <rclcpp/subscription_base.hpp>
#include <rclcpp/time.hpp>
#include <shared_mutex>
#include <string>
#include <string_view>
#include <unordered_set>

namespace central {

// Standalone metrics subscriber: reads from bay/agv/dispatch topics and
// publishes OTel instruments.  No OTel code lives in those packages.
class MetricsRecorder {
public:
  explicit MetricsRecorder(NodeSPtr node);

private:
  using BayReportMsg = interfaces::msg::BayReport;
  using AgvReportMsg = interfaces::msg::AgvReport;
  using NodeAccuracyMsg = agv_interfaces::msg::NodeAccuracyStamped;
  using ContinuousGarageInfoMsg = interfaces::msg::ContinuousGarageInfo;
  using DiscreteGarageStateMsg = interfaces::msg::DiscreteGarageState;
  using DispatchReportMsg = interfaces::msg::DispatchReport;
  using SchedulerJobListMsg = interfaces::msg::SchedulerJobList;
  using SchedulerJobMsg = interfaces::msg::SchedulerJob;

  NodeSPtr node_;

  // --- Latest values read by gauge callbacks ---
  // Shared mutex: unique_lock for insertions (EnsureGaugeHandle), shared_lock
  // in gauge callbacks so the OTel export thread can read concurrently with other
  // reads but is excluded during structural map modifications.
  // Values are atomic so shared_lock holders never contend on individual reads.
  std::shared_mutex gauge_values_mutex_;

  // Bay state pairs a numeric value with its human-readable name (from BayReport::state_string)
  // and when the bay entered that state, so unlike the atomic-only maps below all fields are
  // guarded entirely by gauge_values_mutex_: unique_lock to write (OnBayReport), shared_lock to
  // read (the dynamic gauge's poll callback).
  struct BayStateEntry {
    int64_t value = 0;
    std::string state_name;
    rclcpp::Time state_entry_stamp;
    bool initialized = false;
  };
  std::map<uint32_t, BayStateEntry> bay_state_entries_;

  std::map<uint16_t, std::atomic<double>> agv_soc_values_;
  std::map<uint16_t, std::atomic<int64_t>> agv_state_values_;
  std::map<uint16_t, std::atomic<double>> agv_staleness_values_;
  std::atomic<int64_t> pending_jobs_count_ {0};
  std::atomic<int64_t> active_jobs_count_ {0};
  std::atomic<int64_t> car_count_ {0};
  std::atomic<int64_t> tray_count_ {0};
  std::atomic<int64_t> garage_faulted_ {0};

  // Declared after the gauge-captured state so its destructor (which deregisters gauge callbacks)
  // runs before those maps are destroyed, preventing a use-after-free on the export thread.
  data::otel::MetricsClient client_;

  // --- Instruments ---
  data::otel::Counter<uint64_t> state_transitions_counter_;
  data::otel::Counter<uint64_t> jobs_completed_counter_;
  data::otel::Histogram<double> job_pending_duration_histogram_;
  data::otel::Histogram<double> job_active_duration_histogram_;
  data::otel::Histogram<double> bay_state_duration_histogram_;
  data::otel::Histogram<double> dispatch_state_duration_histogram_;
  data::otel::Histogram<double> node_accuracy_x_offset_histogram_;
  data::otel::Histogram<double> node_accuracy_y_offset_histogram_;
  data::otel::Histogram<double> node_accuracy_yaw_offset_histogram_;

  // Latest dispatch status/mode plus when it started. Guarded by gauge_values_mutex_:
  // unique_lock to write (OnDispatchReport), shared_lock to read (the dispatch.state gauge's
  // poll callback, which also serves as the "current state" source for OnDispatchReport itself).
  struct DispatchStateEntry {
    uint8_t status = 0;
    uint8_t mode = 0;
    rclcpp::Time entry_stamp;
  };
  std::optional<DispatchStateEntry> prev_dispatch_state_;

  // Just the two attribute fields (no timestamp), so GetDispatchAttrs call sites set each one
  // explicitly by name instead of passing two same-typed uint8_t values positionally.
  struct DispatchStatusMode {
    uint8_t status = 0;
    uint8_t mode = 0;
  };

  // --- Seen job IDs for deduplicating completed-job events ---
  std::unordered_set<std::string> known_completed_guids_;

  // --- Subscriptions: bay/agv discovered dynamically, keyed by topic name ---
  std::map<std::string, rclcpp::SubscriptionBase::SharedPtr> bay_subs_;
  std::map<std::string, rclcpp::SubscriptionBase::SharedPtr> agv_report_subs_;
  std::map<std::string, rclcpp::SubscriptionBase::SharedPtr> agv_node_accuracy_subs_;

  rclcpp::SubscriptionBase::SharedPtr dispatch_report_sub_;
  rclcpp::SubscriptionBase::SharedPtr pending_jobs_sub_;
  rclcpp::SubscriptionBase::SharedPtr active_jobs_sub_;
  rclcpp::SubscriptionBase::SharedPtr completed_jobs_sub_;
  rclcpp::SubscriptionBase::SharedPtr discrete_garage_state_sub_;
  rclcpp::SubscriptionBase::SharedPtr continuous_garage_info_sub_;

  rclcpp::TimerBase::SharedPtr discovery_timer_;

  void SetupInstruments();
  void SetupDispatchSubscriptions();
  void DiscoverTopics();

  void OnBayReport(const BayReportMsg& msg);
  void EnsureBayGaugeHandle(uint32_t bay_id);
  void OnAgvReport(const AgvReportMsg& msg);
  void OnNodeAccuracyReport(const NodeAccuracyMsg& msg);
  void OnDispatchReport(const DispatchReportMsg& msg);
  void OnPendingJobs(const SchedulerJobListMsg& msg);
  void OnActiveJobs(const SchedulerJobListMsg& msg);
  void OnCompletedJobs(const SchedulerJobListMsg& msg);
  void OnDiscreteGarageState(const DiscreteGarageStateMsg& msg);
  void OnContinuousGarageInfo(const ContinuousGarageInfoMsg& msg);

  data::otel::Attrs GetDispatchAttrs(const DispatchStatusMode& state);

  template <typename IdT, data::otel::GaugeValue ValueT>
  void EnsureGaugeHandle(IdT id, std::map<IdT, std::atomic<ValueT>>& values, std::string_view metric,
      std::string_view attr_key, std::string_view desc);
};

}  // namespace central
</file>

