// We use the Connector C++ API
// Documentation is available at https://dev.mysql.com/doc/connector-cpp/1.1/en/
#include <cppconn/driver.h>
#include <cppconn/exception.h>
#include <cppconn/prepared_statement.h>
#include <cppconn/resultset.h>
#include <cppconn/statement.h>
#include <mysql_connection.h>

#include <central/garage_tracker_mysql_io.hpp>
#include <common_ros/discrete_garage_state.hpp>
#include <common_ros/versioned_state_buffer.hpp>
#include <fstream>
#include <sstream>
#include <streambuf>

namespace volley {

// Snapshot storage format constants
constexpr uint32_t kSnapshotMagicNumber = 1128354337;
constexpr uint32_t kSnapshotVersionNumber = 1;

// MySQL expects an std::istream when inserting blobs.
// These struct definitions define such a stream object for const char* arrays.
struct MemBuf : std::streambuf {
  MemBuf(char const* base, size_t size) {
    // NOLINTNEXTLINE(cppcoreguidelines-pro-type-const-cast)
    char* p(const_cast<char*>(base));
    // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
    this->setg(p, p, p + size);
  }
};
struct IMemStream : virtual MemBuf, std::istream {
  IMemStream(char const* base, size_t size) :
      MemBuf(base, size), std::istream(static_cast<std::streambuf*>(this)) { }
};

// Create a MySQL connection and set our active database.
std::unique_ptr<sql::Connection> GetMySQLConnection(const GarageDatabaseParameters& params) {
  std::string host_connection = "tcp://" + params.host + ":" + std::to_string(params.port);
  auto driver = get_driver_instance();
  std::unique_ptr<sql::Connection> connection(driver->connect(host_connection, params.user, params.password));
  connection->setSchema(params.database);
  return connection;
}

BoolStringPair InitTables(const GarageDatabaseParameters& params) {
  try {
    std::unique_ptr<sql::Connection> connection = GetMySQLConnection(params);
    std::unique_ptr<sql::Statement> statement(connection->createStatement());

    // If our tables do not exist, create them
    // clang-format off
        statement->execute("CREATE TABLE IF NOT EXISTS `" + kEventsTable + "` ("
            " `sequence_number` bigint(11) NOT NULL PRIMARY KEY,"
            " `recorded_at`     timestamp  NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,"
            " `type`            text       NOT NULL,"
            " `buffer`          blob       NOT NULL"
            ") ENGINE=InnoDB DEFAULT CHARSET=utf8;");
        statement->execute("CREATE TABLE IF NOT EXISTS `" + kSnapshotsTable + "` ("
            " `id`                    bigint(11) NOT NULL PRIMARY KEY AUTO_INCREMENT,"
            " `event_sequence_number` bigint(11) NOT NULL,"
            " `snapshot`              blob       NOT NULL"
            ") ENGINE=InnoDB DEFAULT CHARSET=utf8;");
    // clang-format on
  }
  catch(const sql::SQLException& e) {
    return std::make_pair(false, e.what());
  }

  return std::make_pair(true, "");
}

std::tuple<bool, uint64_t, std::string> GetLatestEventSequenceNumber(const GarageDatabaseParameters& params) {
  // Return values
  bool success = true;
  uint64_t sequence_number = 0;
  std::string message;

  try {
    std::unique_ptr<sql::Connection> connection = GetMySQLConnection(params);
    std::unique_ptr<sql::Statement> statement(connection->createStatement());

    // Don't format SQL statements
    // clang-format off
        std::unique_ptr<sql::ResultSet> res(statement->executeQuery("SELECT sequence_number FROM `" + kEventsTable + "` "
                                 "ORDER BY sequence_number DESC "
                                 "LIMIT 1"));
    // clang-format on

    // New format only stores snapshots, not events, so take the max of the old format event
    // table or the new format snapshot table.
    // clang-format off
        std::unique_ptr<sql::ResultSet> res_snapshot(statement->executeQuery("SELECT event_sequence_number FROM `"
                                  + kSnapshotsTable + "` "
                                 "ORDER BY event_sequence_number DESC "
                                 "LIMIT 1"));
    // clang-format on
    if(res->next()) {
      sequence_number = res->getUInt64(1);
    }
    else {
      message = "No event in table";
      success = true;  // It is still a success
    }

    if(res_snapshot->next()) {
      sequence_number = std::max(sequence_number, res_snapshot->getUInt64(1));
    }
  }
  catch(const sql::SQLException& e) {
    message = e.what();
    success = false;
  }

  return std::make_tuple(success, sequence_number, message);
}

std::tuple<bool, std::vector<uint8_t>, std::string> SerializeDiscreteGarageState(
    const volley::DiscreteGarageState& state, std::optional<uint32_t> version) {
  std::vector<uint8_t> buffer;
  auto state_msg = state.GetDiscreteGarageStateMessage();

  bool success = true;
  YAML::Node garage_state_yaml;

  if(version) {
    // Recalculate hash to match version we're serializing to
    state_msg.hash = state.Hash(version.value());
    std::tie(success, garage_state_yaml) = volley::EncodeVersionedYaml(state_msg, version.value());
  }
  else {
    std::tie(success, garage_state_yaml) = volley::EncodeVersionedYaml(state_msg);
  }

  YAML::Emitter emit;
  emit << garage_state_yaml;
  std::string yaml_string(emit.c_str());

  // TODO(Gunther) Once Encoding can fail, return Annotated YAML
  if(!success) {
    return std::make_tuple(
        false, std::move(buffer), "Failed to serialize discrete garage state to YAML : " + yaml_string);
  }
  // Write to mysql as compressed bytes for now. Can use MongoDB or something text
  // efficient in the future to limit size. Right now a fulton snapshot is
  // ~ 500 bytes
  buffer = std::vector<uint8_t>(yaml_string.begin(), yaml_string.end());

  return std::make_tuple(true, std::move(buffer), "Converted to yaml");
}

BoolStringPair WriteSnapshot(const GarageDatabaseParameters& params, const volley::DiscreteGarageState& state,
    uint64_t event_sequence_number, std::optional<uint32_t> version_opt) {
  // First serialize our state
  auto [success, serialized_state, message] = SerializeDiscreteGarageState(state, version_opt);
  if(!success) {
    return std::make_pair(false, message);
  }

  try {
    std::unique_ptr<sql::Connection> connection = GetMySQLConnection(params);
    std::unique_ptr<sql::PreparedStatement> prepared_statement(connection->prepareStatement(
        "INSERT INTO " + kSnapshotsTable + "(event_sequence_number,snapshot) VALUES (?,COMPRESS(?))"));

    // MySQL expects an std::istream
    // NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast)
    IMemStream blob(reinterpret_cast<const char*>(serialized_state.data()), serialized_state.size());

    prepared_statement->setUInt64(1, event_sequence_number);
    prepared_statement->setBlob(2, &blob);
    prepared_statement->executeUpdate();
  }
  catch(const sql::SQLException& e) {
    return std::make_pair(false, e.what());
  }

  return std::make_pair(true, "");
}

// TODO(Gunther) Once we get all garages off the old binary format, remove this code.

// Local utility method for reading a uint32_t from a buffer at the given offset.
uint32_t ReadUInt32(const unsigned char* data, unsigned int offset) {
  // clang-format off
    uint32_t value = (static_cast<uint32_t>(data[offset + 0]) << 24) | // NOLINT(cppcoreguidelines-pro-bounds-pointer-arithmetic)
                     (static_cast<uint32_t>(data[offset + 1]) << 16) | // NOLINT(cppcoreguidelines-pro-bounds-pointer-arithmetic)
                     (static_cast<uint32_t>(data[offset + 2]) << 8)  | // NOLINT(cppcoreguidelines-pro-bounds-pointer-arithmetic)
                     (static_cast<uint32_t>(data[offset + 3]));        // NOLINT(cppcoreguidelines-pro-bounds-pointer-arithmetic)
  // clang-format on
  return value;
}

// Local utility method for reading a uint64_t from a buffer at the given offset.
uint64_t ReadUInt64(const unsigned char* data, unsigned int offset) {
  // clang-format off
    uint64_t value = (static_cast<uint64_t>(data[offset + 0]) << 56) | // NOLINT(cppcoreguidelines-pro-bounds-pointer-arithmetic)
                     (static_cast<uint64_t>(data[offset + 1]) << 48) | // NOLINT(cppcoreguidelines-pro-bounds-pointer-arithmetic)
                     (static_cast<uint64_t>(data[offset + 2]) << 40) | // NOLINT(cppcoreguidelines-pro-bounds-pointer-arithmetic)
                     (static_cast<uint64_t>(data[offset + 3]) << 32) | // NOLINT(cppcoreguidelines-pro-bounds-pointer-arithmetic)
                     (static_cast<uint64_t>(data[offset + 4]) << 24) | // NOLINT(cppcoreguidelines-pro-bounds-pointer-arithmetic)
                     (static_cast<uint64_t>(data[offset + 5]) << 16) | // NOLINT(cppcoreguidelines-pro-bounds-pointer-arithmetic)
                     (static_cast<uint64_t>(data[offset + 6]) << 8)  | // NOLINT(cppcoreguidelines-pro-bounds-pointer-arithmetic)
                     (static_cast<uint64_t>(data[offset + 7]));        // NOLINT(cppcoreguidelines-pro-bounds-pointer-arithmetic)
  // clang-format on
  return value;
}

std::tuple<bool, volley::DiscreteGarageState, std::string, YAML::Node> DeserializeDiscreteGarageState(
    std::vector<uint8_t> data_vec,
    // Below arguments should be removed when the old binary format is fully depricated
    sql::Connection* conn, uint64_t sequence_number) {
  volley::DiscreteGarageState state;

  std::string yaml_string(data_vec.begin(), data_vec.end());
  std::string message;

  try {
    YAML::Node yaml_state = YAML::Load(yaml_string);
    auto [state_msg_opt, annotated] = volley::DecodeVersionedYaml<DiscreteGarageStateMsg>(yaml_state);
    if(!state_msg_opt) {
      return std::make_tuple(
          false, std::move(state), "Failed to parse garage_state YAML into discrete garage state", annotated);
    }
    auto state_msg = state_msg_opt.value();
    // Set the discrete garage state from the message deserialized
    auto [set_success, message] = state.Set(state_msg);
    if(!set_success) {
      return std::make_tuple(false, std::move(state),
          "Failed to create valid DiscreteGarageState from YAML: " + message, annotated);
    }
    uint64_t state_hash = state.Hash(yaml_state["version"].as<uint32_t>());
    if(state_hash != state_msg.hash) {
      std::stringstream err_stream;
      err_stream << "Error hashes don't match!" << std::endl;
      err_stream << "state_hash: " << state_hash << std::endl;
      err_stream << "msg_hash  : " << state_msg.hash << std::endl;
      err_stream << "Failed to load YAML discrete garge state of version " << yaml_state["version"];
      // Never want to start the garage with any uncertinty. If hashes don't match, don't
      // start. The garage_tracker_recovery can be used to dump a bad state to a yaml file,
      // which can be edited and then the hash automatically calculated before upload.
      return std::make_tuple(false, state, err_stream.str(), annotated);
    }

    return std::make_tuple(true, std::move(state), "", annotated);
  }
  catch(const YAML::ParserException&) {
    // This catch is being used for control flow while the old version is in code, if there are
    // YAML exceptions we skip all the new format changes.
    // TODO(Gunther) cout right now, once we no longer attempt to support the old format
    // return this as `message` and it can be properly logged with the ROS Logger
    std::cout << "Failed to parse buffer as YAML attempting old binary format" << std::endl;
  }

  // Old way below -- remove ASAP to clean up this function considerably
  // Keep track of our index within the buffer
  unsigned int b = 0;
  const unsigned char* data = data_vec.data();
  size_t n_bytes = data_vec.size();

  // Used to extract strings, which use signed chars.
  // NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast)
  auto chars = reinterpret_cast<const char*>(data);

  // Ensure we have enough bytes to extract our header
  if(n_bytes < 4 + 4 + 4 + 8) {
    return std::make_tuple(false, state,
        "Not enough bytes in buffer for message header: " + std::to_string(n_bytes), YAML::Node());
  }

  uint32_t magic_number = ReadUInt32(data, b);
  b += 4;
  uint32_t version_number = ReadUInt32(data, b);
  b += 4;
  uint32_t num_events = ReadUInt32(data, b);
  b += 4;
  uint64_t hash_expected = ReadUInt64(data, b);
  b += 8;

  if(magic_number != kSnapshotMagicNumber) {
    message = "Magic number " + std::to_string(magic_number) + " does not match expected magic number of " +
              std::to_string(kSnapshotMagicNumber);
    return std::make_tuple(false, state, message, YAML::Node());
  }

  if(version_number != 1) {
    message = "Unsupported version number " + std::to_string(version_number) +
              ". This code only supports version 1";
    return std::make_tuple(false, state, message, YAML::Node());
  }

  // Deserialize our events and apply them as we go
  while(num_events > 0) {
    num_events--;

    if(b + 8 >= n_bytes) {
      message = "Not enough bytes for next event header, b=" + std::to_string(b) +
                ", but n_bytes=" + std::to_string(n_bytes);
      return std::make_tuple(false, state, message, YAML::Node());
    }

    uint32_t n_bytes_type = ReadUInt32(data, b);
    b += 4;
    uint32_t n_bytes_buffer = ReadUInt32(data, b);
    b += 4;

    if(n_bytes_type > 100) {
      message = "Number of bytes for event type is suspiciously large: " + std::to_string(n_bytes_type);
      return std::make_tuple(false, state, message, YAML::Node());
    }

    if(n_bytes_buffer > 250) {
      message = "Number of bytes for event buffer is suspiciously large: " + std::to_string(n_bytes_buffer);
      return std::make_tuple(false, state, message, YAML::Node());
    }

    if(b + n_bytes_type + n_bytes_buffer > n_bytes) {
      message = "Not enough bytes for next event data, b=" + std::to_string(b) +
                ", n_bytes_type=" + std::to_string(n_bytes_type) +
                ", n_bytes_buffer=" + std::to_string(n_bytes_buffer) +
                ", but n_bytes=" + std::to_string(n_bytes);
      return std::make_tuple(false, state, message, YAML::Node());
    }

    DiscreteGarageEventMsg event {};

    // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
    std::basic_string event_type(chars + b, n_bytes_type);
    event.type = event_type;
    b += n_bytes_type;

    event.buffer.resize(n_bytes_buffer);
    // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
    std::memcpy(event.buffer.data(), data + b, n_bytes_buffer);
    b += n_bytes_buffer;

    // Apply the event
    auto [apply_success, apply_message] = state.OnEvent(event);
    if(!apply_success) {
      return std::make_tuple(false, state, apply_message, YAML::Node());
    }
  }

  // Verify that we used all the bytes
  if(b != n_bytes) {
    message = "Bytes were left over! b=" + std::to_string(b) + ", n_bytes=" + std::to_string(n_bytes);
    return std::make_tuple(false, state, message, YAML::Node());
  }

  // Verify that our state hash matches
  uint64_t hash_actual = state.Hash();
  if(hash_actual != hash_expected) {
    message = "State hash " + std::to_string(hash_actual) + " does not match expected value of " +
              std::to_string(hash_expected);

    // Get all events since last snapshot (old format - remove this once garages have been using
    // new version for a while) Below used to be GetEventsSince function which was only used for
    // deserializinig snapshot + events, moving here so all vestigial code can be removed in one
    // easy commit
    std::unique_ptr<sql::Statement> statement(conn->createStatement());
    std::unique_ptr<sql::ResultSet> res;
    try {
      res.reset(statement->executeQuery("SELECT sequence_number, type, buffer FROM `" + kEventsTable +
                                        "` WHERE sequence_number > " + std::to_string(sequence_number) +
                                        " ORDER BY sequence_number ASC"));
    }
    catch(const sql::SQLException& e) {
      message = e.what();
      return std::make_tuple(false, state, message, YAML::Node());
    }

    std::vector<DiscreteGarageEventMsg> events;
    while(res->next()) {
      std::string event_type = res->getString(2).asStdString();
      std::istream* buffer = res->getBlob(3);

      // Figure out how many bytes there are
      buffer->seekg(0, std::ios::end);
      auto n_bytes = buffer->tellg();
      buffer->seekg(0);

      DiscreteGarageEventMsg event {};
      event.type = event_type;
      event.buffer.resize(n_bytes);
      // NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast)
      buffer->read(reinterpret_cast<char*>(event.buffer.data()), n_bytes);

      events.emplace_back(event);
    }
    for(const auto& event : events) {
      auto [apply_success, apply_message] = state.OnEvent(event);
      if(!apply_success) {
        return std::make_tuple(
            false, state, "Error while applying latest events: " + apply_message, YAML::Node());
      }
    }

    auto [success, state_bytes, reserialize_message] = SerializeDiscreteGarageState(state);
    YAML::Node bad_hash_state;
    if(success) {
      std::string bad_hash_string(state_bytes.begin(), state_bytes.end());
      try {
        bad_hash_state = YAML::Load(bad_hash_string);
      }
      catch(const YAML::Exception&) {
        bad_hash_state = YAML::Node();
      }
    }
    return std::make_tuple(false, state, message, bad_hash_state);
  }

  // Get all events since last snapshot (old format - remove this once garages have been using
  // new version for a while) Below used to be GetEventsSince function which was only used for
  // deserializinig snapshot + events, moving here so all vestigial code can be removed in one
  // easy commit
  std::unique_ptr<sql::Statement> statement(conn->createStatement());
  std::unique_ptr<sql::ResultSet> res;
  try {
    res.reset(statement->executeQuery("SELECT sequence_number, type, buffer FROM `" + kEventsTable +
                                      "` WHERE sequence_number > " + std::to_string(sequence_number) +
                                      " ORDER BY sequence_number ASC"));
  }
  catch(const sql::SQLException& e) {
    message = e.what();
    return std::make_tuple(false, state, message, YAML::Node());
  }

  std::vector<DiscreteGarageEventMsg> events;
  while(res->next()) {
    std::string event_type = res->getString(2).asStdString();
    std::istream* buffer = res->getBlob(3);

    // Figure out how many bytes there are
    buffer->seekg(0, std::ios::end);
    auto n_bytes = buffer->tellg();
    buffer->seekg(0);

    DiscreteGarageEventMsg event {};
    event.type = event_type;
    event.buffer.resize(n_bytes);
    // NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast)
    buffer->read(reinterpret_cast<char*>(event.buffer.data()), n_bytes);

    events.emplace_back(event);
  }
  for(const auto& event : events) {
    auto [apply_success, apply_message] = state.OnEvent(event);
    if(!apply_success) {
      return std::make_tuple(
          false, state, "Error while applying latest events: " + apply_message, YAML::Node());
    }
  }

  // Success!
  return std::make_tuple(true, state, "", YAML::Node());
}

std::tuple<bool, volley::DiscreteGarageState, uint64_t, std::string, YAML::Node> GetLatestSnapshot(
    const GarageDatabaseParameters& params) {
  // Return values
  bool success = true;
  volley::DiscreteGarageState state;
  uint64_t sequence_number = 0;
  std::string message;
  YAML::Node annotated;

  try {
    std::unique_ptr<sql::Connection> connection = GetMySQLConnection(params);
    std::unique_ptr<sql::Statement> statement(connection->createStatement());

    // clang-format off
        std::unique_ptr<sql::ResultSet> res(statement->executeQuery("SELECT event_sequence_number, UNCOMPRESS(snapshot) FROM `" + kSnapshotsTable + "`"
                                    " ORDER BY event_sequence_number DESC" +
                                    " LIMIT 1"));

    // clang-format on
    if(res->next()) {
      sequence_number = res->getUInt64(1);
      std::istream* buffer = res->getBlob(2);

      // Figure out how many bytes there are
      buffer->seekg(0, std::ios::end);
      auto n_bytes = buffer->tellg();
      buffer->seekg(0);

      if(n_bytes == 0) {
        // If buffer is empty, try again w/o uncompress -- old format wasn't compressed data
        res.reset(statement->executeQuery("SELECT event_sequence_number, snapshot FROM `" + kSnapshotsTable +
                                          "` ORDER BY event_sequence_number DESC" + " LIMIT 1"));
        // will always be valid since we know this row exists from above check
        res->next();
        buffer = res->getBlob(2);
        buffer->seekg(0, std::ios::end);
        n_bytes = buffer->tellg();
        buffer->seekg(0);
      }

      if(n_bytes > 100000) {
        message = "Unexpectedly large number of bytes: " + std::to_string(n_bytes) + " for snapshot";
        success = false;
      }
      else {
        std::vector<unsigned char> blob;
        blob.resize(n_bytes);
        // NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast)
        buffer->read(reinterpret_cast<char*>(blob.data()), n_bytes);
        if(buffer->tellg() != n_bytes) {
          message = "Failed to read " + std::to_string(n_bytes) + " bytes for snapshot";
          success = false;
        }
        else {
          std::tie(success, state, message, annotated) =
              DeserializeDiscreteGarageState(std::move(blob), connection.get(), sequence_number);
        }
      }
    }
    else {
      // No snapshot
      message = "No snapshot in table";
      success = true;  // It is still a success
    }
  }
  catch(const sql::SQLException& e) {
    message = e.what();
    success = false;
  }
  return std::make_tuple(success, state, sequence_number, message, annotated);
}

}  // namespace volley
