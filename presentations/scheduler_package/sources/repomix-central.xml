void Dispatch::DiscreteGarageEventCallback(DiscreteGarageEventStampedMsg::UniquePtr event_stamped) {
  // Ensure that our event matches the current hash
  if(discrete_garage_state_.Hash() != event_stamped->hash_prev) {
    ERRORS(logger_, "Discrete Garage State has diverged! State hash "
                        << std::to_string(discrete_garage_state_.Hash())
                        << " does not match expected hash of " << std::to_string(event_stamped->hash_prev)
                        << " for " << event_stamped->event.type << " (num "
                        << std::to_string(event_stamped->sequence_number) << ")");
    discrete_garage_state_diverged_ = true;
  }

  // Create jobs based off this event
  CreateJobsFromEvents(event_stamped->event, event_stamped->header.stamp);

  // Update our state
  const auto& event = event_stamped->event;
  auto [success, message] = discrete_garage_state_.OnEvent(event);
  if(!success) {
    discrete_garage_state_diverged_ = true;
    ERRORS(logger_,
        "Discrete Garage State has diverged! Failed to apply " << event.type << " event: " << message);
  }
  else {
    LOG_DEBUG(logger_, "Applied {} event (num {})", event.type, event_stamped->sequence_number);
  }

  if(discrete_garage_state_diverged_) {
    // Nothing we can do - reset the execution state
    ERRORS(logger_, "Discrete Garage State has diverged, so the Execution State has diverged!");
    exec_state_.reset();
    return;
  }

  // Update our execution state
  if(exec_state_ != nullptr) {
    std::tie(success, message) = exec_state_->Update(*event_stamped);
    if(!success) {
      ERRORS(logger_, "Execution State has diverged! " << message);
    }
  }
}

void Dispatch::DiscreteGarageStateCallback(DiscreteGarageStateMsg::UniquePtr garage_state) {
  // Used to update our garage state any time that we diverge from the garage tracker
  if(discrete_garage_state_diverged_) {
    // Construct a new state from the one that was given
    discrete_garage_state_.Set(*garage_state);

    if(discrete_garage_state_.Hash() != garage_state->hash) {
      ERRORS(logger_, "Failed to construct garage state from message - hashes "
                          << discrete_garage_state_.Hash() << " and " << garage_state->hash
                          << " do not match");
    }
    else {
      INFOS(logger_, "Successfully reset discrete garage state");
    }

    // We are no longer diverged
    discrete_garage_state_diverged_ = false;

    // Ensure we have no execution state
    exec_state_.reset();
  }
}

void Dispatch::GetJobStateSrvCallback(
    GetJobStateSrv::Request::SharedPtr request, GetJobStateSrv::Response::SharedPtr response) {
  if(!HasJob(request->guid)) {
