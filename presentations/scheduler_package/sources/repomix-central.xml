void Dispatch::ReparkTraySrvCallback(ReparkTraySrv::Request::SharedPtr request,
    ReparkTraySrv::Response::SharedPtr response, const rclcpp::Time& now) {
  INFOS(logger_, "Received request to repark tray!");

  std::tie(response->success, response->message) = CanAcceptAutoJob();
  if(!response->success) {
    WARNS(logger_, "Cannot accept Repark Tray: " << response->message);
    return;
  }

  if(!discrete_garage_state_.HasTray(request->tray_id)) {
    response->success = false;
    response->message =
        "Cannot accept Repark Tray: tray " + std::to_string(request->tray_id) + " does not exist!";
    WARNS(logger_, response->message);
    return;
  }

  if(!pose_graph_->HasPose(request->pose)) {
    response->success = false;
    response->message =
        "Cannot accept Repark Tray: pose " + std::to_string(request->pose) + " does not exist!";
    WARNS(logger_, response->message);
    return;
  }

  auto job = std::make_unique<ReparkTrayJob>(
      GenerateGuid(now), now, request->tray_id, request->pose, request->allow_reciprocal);

  // We return the job's GUID
  response->job_id = job->GetGuid();

  RegisterPendingJob(std::move(job));
}

void Dispatch::RetrieveSrvCallback(RetrieveSrv::Request::SharedPtr request,
    RetrieveSrv::Response::SharedPtr response, const rclcpp::Time& now) {
  INFOS(logger_, "Received request to retrieve payload " + std::to_string(request->payload_id));

  if(!discrete_garage_state_.HasPayload(request->payload_id)) {
    response->success = false;
    response->message = "Payload " + std::to_string(request->payload_id) + " does not exist in the garage";
    WARNS(logger_, "Retrieve request failed: " << response->message);
    return;
  }

  std::tie(response->success, response->message) = CanAcceptAutoJob();
  if(!response->success) {
    WARNS(logger_, "Cannot accept Retrieve: " << response->message);
    return;
  }

  auto job = std::make_unique<RetrieveJob>(GenerateGuid(now), now, request->payload_id);

  // We return the job's GUID
  response->job_id = job->GetGuid();

  RegisterPendingJob(std::move(job));

  // Emit a garage event
  GarageEventMsg event {};
  event.type = GarageEventMsg::EVENT_RETRIEVE;
  event.payload_id = std::to_string(request->payload_id);
  volley::PrintEvent(logger_, event);
}

