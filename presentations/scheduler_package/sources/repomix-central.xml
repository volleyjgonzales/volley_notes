#include "central/garage_tracker.hpp"

#include <common/math_utils.hpp>
#include <common_ros/ros_utils.hpp>
#include <rclcpp/time.hpp>
#include <stdexcept>

#include "vrc_interfaces/msg/vrc_report.hpp"
#include "vrc_interfaces/msg/vrc_state.hpp"

namespace volley {

GarageTracker::GarageTracker(LayoutSPtr layout, std::optional<GarageDatabaseParameters> db_params,
    const std::function<void(DiscreteGarageEventStampedMsg::UniquePtr)>& event_publisher,
    const rclcpp::Logger& logger, bool simulation) :
    db_params_(std::move(db_params)),
    layout_(layout),
    event_publisher_(event_publisher),
    logger_(logger),
    simulation_(simulation) {
  // Note that if db_params does not have a value, we do not expect to reach a MySQL database.
  // In that case we start with a blank slate. This occurs in the sim, in which case the initial
  // conditions will be set by the scenario runner via service calls.
  // TODO(Gunther) : Accept a YAML Node representing the initial state for the sim and load from
  // there so we follow the same path.

  if(db_params_.has_value()) {
    // We expect to reach our MySQL database.

    // Initialize our tables if they do not already exist.
    auto [init_success, init_message] = InitTables(db_params_.value());
    if(!init_success) {
      ERRORS(logger_, "Error while initializing MySQL tables: " << init_message);
      // We failed to speak to MySQL. We do not want to run after this occurs.
      // We error out such that we are forced to set up MySQL correctly or specify that we do
      // not want to run with it.
      std::stringstream err;
      err << "Error while initializing MySQL tables: " << init_message;
      throw std::runtime_error(err.str());
    }

    // Load latest snapshot, if one exists.
    auto [snapshot_success, snapshot, snapshot_seq, snapshot_message, annotated] =
        GetLatestSnapshot(db_params_.value());
    if(!snapshot_success) {
      // Note that we do not enter this if statement if there is no snapshot in the table.
      // That is considered a success, since that happens in real garages on every first run.

      // We failed to retrieve a snapshot. This can occur if:
      //  - our comms with MySQL failed
      //  - we failed to deserialize the latest snapshot

      // If the latest snapshot fails to construct a valid discrete garage state, either by a
      // parsing error, new field w/o a sensible default or a hash mismatch, we will fail to
      // start, but the garage_tracker_recovery can be used to get the bad snapshot as a YAML
      // file. That snapshot can then be fixed by hand and reuploaded as a new snapshot.

      std::stringstream err;
      err << "Error while initializing while retrieving latest snapshot: " << snapshot_message;
      if(annotated) {
        err << std::endl
            << "garage_tracker_recovery can be used to fix and recover discrete garage "
               "state";
      }
      ERRORS(logger_, err.str());
      throw std::runtime_error(err.str());
    }
    else {
      INFOS(logger_, "Successfully queried for latest snapshot");
      state_ = snapshot;
      sequence_number_ = snapshot_seq;
    }
  }

  // Add any bays that are not already in the state, and store all bay inbound headings.
  // A bay may not already be in our state the first time we load from an empty MySQL table
  // or when running in the sim.
  for(const uint32_t bay_id : layout_->GetBayLikeNodeIds()) {
    if(!state_.HasBay(bay_id)) {
      BayExistenceChangedMsg event {};
      event.added = true;
      event.bay_id = bay_id;
      event.state = BayReportMsg::STATE_BOOTING;
      event.disabled = state_.IsNodeDisabled(bay_id);
      auto [success, message] = state_.OnEvent(event);
      if(!success) {
        throw std::runtime_error("Error adding bay to state: " + message);
      }
    }
  }

  // Remove any bays that are not in our layout.
  // Note that we do not exit out because we want to be able to survive changes to our layout
  // without having to modify the mysql database.
  for(const auto& [bay_id, bay] : state_.GetBays()) {
    if(!layout_->GetBayInboundHeading(bay_id).has_value()) {
      WARNS(logger_, "Unexpected bay " << std::to_string(bay_id)
                                       << " in our state, that is not in our layout. Removing it.");
      BayExistenceChangedMsg event {};
      event.added = false;
      event.bay_id = bay_id;
      event.state = bay.state;
      auto [success, message] = state_.OnEvent(event);
      if(!success) {
        throw std::runtime_error("Error removing bay from state: " + message);
      }
    }
  }

  // Remove any vexen that are not in our layout
  for(const auto& [vecs_id, vecs] : state_.GetVexen()) {
    if(layout_->GetNodeById(vecs_id).value().type != GarageNodeMsg::TYPE_EV_CHARGE) {
      WARNS(logger_, "Unexpected VECS " << std::to_string(vecs_id)
                                        << " in our state, that is not in our layout. Removing it.");
      VecsExistenceChangedMsg event {};
      event.added = false;
      event.vecs_id = vecs_id;
      event.state = vecs.state;
      auto [success, message] = state_.OnEvent(event);
      if(!success) {
        throw std::runtime_error("Error removing VECS from state: " + message);
      }
    }
  }

  // Add any vexen that are not already in the state.
  for(const uint32_t vecs_id : layout_->GetNodeIdsOfType(GarageNodeMsg::TYPE_EV_CHARGE)) {
    if(!state_.HasVecs(vecs_id)) {
      VecsExistenceChangedMsg event {};
      event.added = true;
      event.vecs_id = vecs_id;
      event.state = VecsReportMsg::BOOTING;
      event.disabled = state_.IsNodeDisabled(vecs_id);
      auto [success, message] = state_.OnEvent(event);
      if(!success) {
        throw std::runtime_error("Error adding VECS to state: " + message);
      }
    }
  }

  // Add any VRCs that are not already in the state
  for(const auto& layout_vrc : layout_->GetVrcs()) {
    if(!state_.HasVrc(layout_vrc.id)) {
      DiscreteVrcStateMsg vrc;
      vrc.id = layout_vrc.id;
      vrc.state.value = vrc_interfaces::msg::VrcState::STATE_INITIALIZING;
      VrcExistenceChangedMsg event;
      event.added = true;
      event.discrete_state = vrc;
      auto [success, message] = state_.OnEvent(event);
      if(!success) {
        throw std::runtime_error("Error adding VRC to state: " + message);
      }
    }
  }

  // Remove any VRC that are not in our layout
  for(const auto& [vrc_id, vrc] : state_.GetVrcs()) {
    const auto& layout_vrc = layout_->GetVrc(vrc_id);
    if(!layout_vrc.has_value()) {
      WARNS(logger_, "Unexpected VRC " << std::to_string(vrc_id)
                                       << " in our state, that is not in our layout. Removing it.");
      VrcExistenceChangedMsg event {};
      event.added = false;
      event.discrete_state = vrc;
      auto [success, message] = state_.OnEvent(event);
      if(!success) {
        throw std::runtime_error("Error removing VRC from state: " + message);
      }
    }
  }

  // Loading the discrete garage state with Set() validates against duplicates or tray/
  // agv mismatches but the DiscreteGarageState doesn't have Layout information, so here
  // we need to guard against Agvs or Nodes which have invalid poses for the layout.
  auto invalid_entities = ValidatePosesForLayout();
  if(!invalid_entities.empty()) {
    // Don't start the garage if an entity is invalid for the layout
    std::stringstream err;
    err << "Entites with invalid poses in garage state for layout:";
    for(const auto& entity : invalid_entities) {
      err << "\n\t:" << std::to_string(entity);
    }
    ERRORS(logger_, err.str());
    throw std::runtime_error(err.str());
  }

  // DiscreteGarageState will be published by GarageTrackerROS, so any subscribers will be
  // up to date just after this is set.
  INFOS(logger_, "Loaded garage tracker");
}

void GarageTracker::AgvReportCallback(AgvReportMsg::UniquePtr report) {
  // Update our state to reflect this latest AGV report.
  // Produces discrete events.

  auto agv_opt = state_.GetAgv(report->agv_id);
  if(!agv_opt.has_value()) {
    // The update came from an unknown AGV.
    ERRORS(logger_, "Unknown AGV " << report->agv_id << ". This should never happen.");

    // Add the AGV to our state
    AgvExistenceChangedMsg event {};
    event.added = true;
    event.agv_id = report->agv_id;
    event.state = report->state;
    event.lift = report->garage_pose_and_lift.lift;
    event.node_id = report->garage_pose_and_lift.pose.node_id;
    event.heading = static_cast<int16_t>(volley::Wrap(report->garage_pose_and_lift.pose.heading));
    event.disabled = false;  // NOTE: We don't know disabledness from the AGV report

    // NOTE: The AGV report does not contain the tray id. We have just heard from an unknown
    //       AGV. We can try to infer the tray id if the lift is up and we know of a tray
    //       at this location. However, if there is no known tray at this location, and the lift
    //       is up, we have no way to know whether it is carrying a tray that is unknown to the
    //       system.
    //       Reports from unknown AGVs should cause the system to halt, so either way this issue
    //       should be handled downstream.
    event.tray_id = 0;
    ApplyAndPublishEvent(event);

    // Fault
    ApplyAndPublishEvent(volley::GetFaultedEvent());
  }
  else {
    auto& agv = agv_opt.value();

    // Check for an AGV state change
    if(report->state != agv.state) {
      AgvStateChangedMsg event {};
      event.agv_id = report->agv_id;
      event.state_curr = agv.state;
      event.state_next = report->state;
      ApplyAndPublishEventOrFault(event);
    }

    // Check for pose and lift state changes when the AGV knows its pose
    if(report->state == report->STATE_STOPPED or report->state == report->STATE_ACTIVE ||
        report->state == report->STATE_JOYSTICK) {
      int reported_heading = volley::Wrap(report->garage_pose_and_lift.pose.heading);
      uint32_t reported_node_id = ResolveVrcNodeId(report->garage_pose_and_lift.pose.node_id);
      if(reported_node_id != agv.pose.node_id || reported_heading != agv.pose.heading) {
        AgvPoseChangedMsg event {};
        event.agv_id = report->agv_id;
        event.node_id_curr = agv.pose.node_id;
        event.heading_curr = agv.pose.heading;
        event.node_id_next = reported_node_id;
        event.heading_next = static_cast<int16_t>(reported_heading);
        INFOS(logger_, "GarageTracker::AgvReportCallback  a"
                           << report->agv_id << " pose changed: node " << event.node_id_curr << "@"
                           << event.heading_curr << " -> node " << event.node_id_next << "@"
                           << event.heading_next << " (carrying t" << agv.tray_id << ")");
        ApplyAndPublishEventOrFault(event);
        if(agv.tray_id != 0) {
          auto tray_after = state_.GetTray(agv.tray_id);
          if(tray_after.has_value()) {
            INFOS(logger_, "GarageTracker::AgvReportCallback  t"
                               << agv.tray_id << " carried by agv " << report->agv_id << " now at node "
                               << tray_after->pose.node_id << "@" << tray_after->pose.heading);
          }
        }
      }

      if(report->garage_pose_and_lift.lift != agv.lift) {
        AgvLiftChangedMsg event {};
        event.agv_id = report->agv_id;
        event.raised = report->garage_pose_and_lift.lift;
        ApplyAndPublishEventOrFault(event);
      }
    }
  }

  // Store the latest message
  agv_reports_[report->agv_id] = *report;
}

void GarageTracker::BayReportCallback(BayReportMsg::UniquePtr report) {
  // Update our state to reflect this latest bay report.
  // Produces discrete state events.

  auto bay_opt = state_.GetBay(report->bay_id);
  if(!bay_opt.has_value()) {
    // The update came from an unknown bay.
    ERRORS(logger_, "Unknown bay " << report->bay_id << ". This should never happen.");

    // Add the bay to our state
    BayExistenceChangedMsg event {};
    event.added = true;
    event.bay_id = report->bay_id;
    event.state = report->state;
    event.disabled = state_.IsNodeDisabled(report->bay_id);
    ApplyAndPublishEvent(event);

    // Fault
    ApplyAndPublishEvent(volley::GetFaultedEvent());
  }
  else {
    auto& bay = bay_opt.value();

    // Check for a bay state change
    if(report->state != bay.state) {
      INFOS(logger_, "GarageTracker::BayReportCallback  Bay " << report->bay_id << " has changed state from "
                                                              << std::to_string(bay.state) << " to "
                                                              << std::to_string(report->state));

      BayStateChangedMsg event {};
      event.bay_id = report->bay_id;
      event.state_curr = bay.state;
      event.state_next = report->state;
      ApplyAndPublishEventOrFault(event);
    }
  }

  // Store the latest message
  bay_reports_[report->bay_id] = *report;
}

void GarageTracker::VecsReportCallback(VecsReportMsg::UniquePtr report) {
  // Update our state to reflect this latest VECS report.
  // Produces discrete state events.

  auto vecs_opt = state_.GetVecs(report->vecs_id);
  if(!vecs_opt.has_value()) {
    // The update came from an unknown VECS.
    ERRORS(logger_, "Unknown VECS " << report->vecs_id << ". This should never happen.");

    // Add the VECS to our state
    VecsExistenceChangedMsg event {};
    event.added = true;
    event.vecs_id = report->vecs_id;
    event.state = report->state;
    event.disabled = state_.IsNodeDisabled(report->vecs_id);
    ApplyAndPublishEvent(event);

    // Fault
    ApplyAndPublishEvent(volley::GetFaultedEvent());
  }
  else {
    auto& vecs = vecs_opt.value();

    // Check for a VECS state change
    if(report->state != vecs.state) {
      VecsStateChangedMsg event {};
      event.vecs_id = report->vecs_id;
      event.state_curr = vecs.state;
      event.state_next = report->state;
      ApplyAndPublishEventOrFault(event);
    }
  }

  // Store the latest message
  vecs_reports_[report->vecs_id] = *report;
}

void GarageTracker::VrcReportCallback(vrc_interfaces::msg::VrcReport::UniquePtr report) {
  // Update our state to reflect this latest VRC report.
  // Produces discrete state events.

  auto vrc_opt = state_.GetVrc(report->id);
  if(!vrc_opt.has_value()) {
    // The update came from an unknown VRC.
    ERRORS(logger_, "Unknown VRC " << report->id << ". This should never happen.");

    // Add the VRC to our state
    VrcExistenceChangedMsg event {};
    event.added = true;
    event.discrete_state.id = report->id;
    event.discrete_state.state = report->state;
    event.discrete_state.gates = report->gates;
    event.discrete_state.current_floor = report->current_floor;
    event.discrete_state.requested_floor = report->requested_floor;
    ApplyAndPublishEvent(event);

    // Fault
    ApplyAndPublishEvent(volley::GetFaultedEvent());
  }
  else {
    const auto& vrc = vrc_opt.value();

    // Check for a VRC state change
    const bool idle_or_moving = (report->state.value == vrc_interfaces::msg::VrcState::STATE_IDLE) ||
                                (report->state.value == vrc_interfaces::msg::VrcState::STATE_MOVING);
    if(idle_or_moving && (vrc.state.value != report->state.value)) {
      VrcStateChangedMsg event {};
      event.current_discrete_state = vrc;
      event.next_discrete_state.id = vrc.id;
      event.next_discrete_state.state = report->state;
      event.next_discrete_state.gates = report->gates;
      event.next_discrete_state.current_floor = report->current_floor;
      event.next_discrete_state.requested_floor = report->requested_floor;
      ApplyAndPublishEventOrFault(event);

      if(report->state.value == vrc_interfaces::msg::VrcState::STATE_IDLE) {
        CorrectVrcTrayPoses(vrc.id, report->current_floor);
      }
    }
  }

  // Store the latest message
  vrc_reports_[report->id] = *report;
}

uint32_t GarageTracker::ResolveVrcNodeId(uint32_t reported_node_id) const {
  auto vrc_layout_opt = layout_->GetVrcForNodeId(reported_node_id);
  if(!vrc_layout_opt.has_value()) {
    return reported_node_id;
  }

  auto vrc_state_opt = state_.GetVrc(vrc_layout_opt->id);
  if(!vrc_state_opt.has_value()) {
    return reported_node_id;
  }

  for(const auto& vrc_node : vrc_layout_opt->nodes) {
    if(vrc_node.floor == vrc_state_opt->current_floor) {
      return vrc_node.id;
    }
  }

  return reported_node_id;
}

void GarageTracker::CorrectVrcTrayPoses(uint16_t vrc_id, uint16_t current_floor) {
  auto vrc_layout_opt = layout_->GetVrc(vrc_id);
  if(!vrc_layout_opt.has_value()) {
    return;
  }
  const auto& vrc_layout = vrc_layout_opt.value();

  std::optional<uint32_t> target_node_id;
  for(const auto& vrc_node : vrc_layout.nodes) {
    if(vrc_node.floor == current_floor) {
      target_node_id = vrc_node.id;
      break;
    }
  }
  if(!target_node_id.has_value()) {
    return;
  }

  auto is_vrc_node = [&](uint32_t node_id) {
    if(node_id == vrc_layout.root_node_id) {
      return true;
    }
    for(const auto& vrc_node : vrc_layout.nodes) {
      if(vrc_node.id == node_id) {
        return true;
      }
    }
    return false;
  };

  // Only un-carried trays (riding the VRC on their own) need correcting here. A tray carried by
  // an AGV is moved by the AGV-carries-tray cascade in OnEvent(AgvPoseChangedMsg), driven by
  // AgvReportCallback's own ResolveVrcNodeId resolution.
  std::vector<uint16_t> trays_to_move;
  for(const auto& [tray_id, tray] : state_.GetTrays()) {
    if(tray.agv_id == 0 && tray.pose.node_id != target_node_id.value() && is_vrc_node(tray.pose.node_id)) {
      trays_to_move.push_back(tray_id);
    }
  }
  for(uint16_t tray_id : trays_to_move) {
    auto tray = state_.GetTray(tray_id).value();
    TrayPoseSetManuallyMsg pose_change {};
    pose_change.tray_id = tray_id;
    pose_change.node_id_curr = tray.pose.node_id;
    pose_change.heading_curr = tray.pose.heading;
    pose_change.node_id_next = target_node_id.value();
    pose_change.heading_next = tray.pose.heading;
    INFOS(logger_, "GarageTracker::CorrectVrcTrayPoses  vrc"
                       << vrc_id << " settled at floor " << current_floor << ", correcting t" << tray_id
                       << " from node " << pose_change.node_id_curr << " to node " << target_node_id.value());
    ApplyAndPublishEventOrFault(pose_change);
  }
}

void GarageTracker::AddAgvSrvCallback(
    SetUInt16Srv::Request::SharedPtr request, SetUInt16Srv::Response::SharedPtr response) {
  uint16_t agv_id = request->value;
  INFOS(logger_, "Received request to add a" << std::to_string(agv_id));

  if(agv_id == 0) {
    WARNS(logger_, "AGV id must be positive");
    response->success = false;
    response->message += "AGV id must be positive";
    return;
  }

  // Default to true
  response->success = true;

  if(!state_.HasAgv(agv_id)) {
    // Add the AGV to our state - with default values.
    // These values will likely be overwritten as soon as we get our first report.
    AgvExistenceChangedMsg event {};
    event.added = true;
    event.agv_id = agv_id;
    event.state = AgvReportMsg::STATE_NOT_LOCALIZED;
    event.lift = false;
    event.node_id = 0;
    event.heading = 0;
    event.tray_id = 0;
    event.disabled = false;  // Default to enabled
    ApplyAndPublishEvent(event);
  }
  else {
    WARNS(logger_, "State already includes a" << std::to_string(agv_id));
    response->success = false;
    response->message += "(AGV already exists)";
  }
}

void GarageTracker::AddPayloadSrvCallback(
    AddPayloadSrv::Request::SharedPtr request, AddPayloadSrv::Response::SharedPtr response) {
  INFOS(logger_, "Received request to add payload "
                     << std::to_string(request->payload.id) << " to tray " << std::to_string(request->tray_id)
                     << " with reciprocal_to_tray = " << request->reciprocal_to_tray);

  PayloadExistenceChangedMsg add_payload {};
  add_payload.payload_id = request->payload.id.bytes;
  add_payload.added = true;
  add_payload.mass = request->payload.mass;
  add_payload.length_m = request->payload.length_m;
  add_payload.width_m = request->payload.width_m;
  add_payload.height_m = request->payload.height_m;
  add_payload.ev_charge_requested = request->payload.ev_charge_requested;
  auto resource_size_opt = layout_->GetSmallestEnclosingResourceSizeIndex(
      request->payload.length_m, request->payload.width_m, request->payload.height_m);
  if(!resource_size_opt.has_value()) {
    auto msg = "Payload not added! Length " + std::to_string(request->payload.length_m) + " , width " +
               std::to_string(request->payload.width_m) + " , height " +
               std::to_string(request->payload.height_m) + " does not fit in any resource windows!";
    WARNS(logger_, msg);
    response->success = false;
    response->message = msg;
    return;
  }

  if(request->tray_id != 0) {
    // Place the payload on the specified tray
    add_payload.tray_id = request->tray_id;
    add_payload.reciprocal_to_tray = request->reciprocal_to_tray;
  }
  else {
    // Find the tray based on the given garage pose
    for(const auto& [tray_id, tray] : state_.GetTrays()) {
      if(tray.pose.node_id == request->pose.node_id) {
        add_payload.tray_id = tray_id;

        if(request->pose.heading == tray.pose.heading) {
          add_payload.reciprocal_to_tray = false;
        }
        else if(request->pose.heading == volley::Wrap(tray.pose.heading + 180)) {
          add_payload.reciprocal_to_tray = true;
        }
        else {
          WARNS(logger_, "Failed to add payload " << std::to_string(request->payload.id)
                                                  << " because heading " << request->pose.heading
                                                  << " is not parallel to tray heading "
                                                  << request->pose.heading);
          response->success = false;
          return;
        }

        break;
      }
    }
  }

  // Apply and return
  std::tie(response->success, response->message) = ApplyAndPublishEventOrFault(add_payload);
}

void GarageTracker::AddTraySrvCallback(
    AddTraySrv::Request::SharedPtr request, AddTraySrv::Response::SharedPtr response) {
  INFOS(logger_, "Received request to add tray " << request->id << "!");

  TrayExistenceChangedMsg add_tray {};
  add_tray.tray_id = request->id;
  add_tray.added = true;
  add_tray.agv_id = request->agv_id;
  add_tray.disabled = request->disabled;

  if(add_tray.agv_id != 0) {
    // Place this tray on top of the given AGV (if it is raised)
    auto agv_opt = state_.GetAgv(add_tray.agv_id);
    if(!agv_opt.has_value()) {
      response->message = "a" + std::to_string(add_tray.agv_id) + " does not exist";
      response->success = false;
      return;
    }
    else {
      const auto& agv = agv_opt.value();
      if(!agv.lift) {
        response->message =
            "a" + std::to_string(add_tray.agv_id) + " must be lifted for a tray to be placed on it";
        response->success = false;
        return;
      }

      add_tray.node_id = agv.pose.node_id;
      add_tray.heading = static_cast<int16_t>(agv.pose.heading + 180 * request->reciprocal_to_agv);
    }
  }
  else {
    // Not placing on an AGV. First, confirm that the garage pose exists.
    if(!layout_->HasGaragePose(request->garage_pose)) {
      response->message =
          "Garage pose " + std::to_string(request->garage_pose) + " does not exist in our layout.";
      response->success = false;
      return;
    }
    add_tray.node_id = request->garage_pose.node_id;
    add_tray.heading = request->garage_pose.heading;
  }

  // Apply and return
  std::tie(response->success, response->message) = ApplyAndPublishEventOrFault(add_tray);
}

void GarageTracker::FaultResetSrvCallback(TriggerSrv::Response::SharedPtr response) {
  if(state_.IsFaulted()) {
    std::tie(response->success, response->message) =
        ApplyAndPublishEventOrFault(volley::GetFaultedEvent(false));
    if(response->success) {
      INFOS(logger_, "Reset fault state");
    }
    else {
      WARNS(logger_, "Failed to reset fault state: " << response->message);
    }
  }
  else {
    INFOS(logger_, "Received request to reset fault state but we are not faulted");
    response->success = false;
    response->message = "Not currently faulted";
  }
}

void GarageTracker::PlacePayloadInBaySrvCallback(
    PlacePayloadInBaySrv::Request::SharedPtr request, PlacePayloadInBaySrv::Response::SharedPtr response) {
  INFOS(logger_, "Received request to place payload " << std::to_string(request->payload.id) << " in bay b"
                                                      << request->bay_id << "!");

  // Find the bay
  auto bay_opt = state_.GetBay(request->bay_id);
  if(!bay_opt.has_value()) {
    response->message = "b" + std::to_string(request->bay_id) + " does not exist";
    response->success = false;
    return;
  }

  // Find the tray
  auto tray_opt = state_.GetTrayOnNode(request->bay_id);
  if(!tray_opt.has_value()) {
    response->message =
        "Could not find a tray in b" + std::to_string(request->bay_id) + " on which to place the payload";
    response->success = false;
    return;
  }

  // Find the bay inbound heading
  auto inbound_heading_opt = layout_->GetBayInboundHeading(request->bay_id);
  if(!inbound_heading_opt.has_value()) {
    response->message = "Could not find inbound heading for b" + std::to_string(request->bay_id);
    response->success = false;
    return;
  }

  PayloadExistenceChangedMsg add_payload {};
  add_payload.payload_id = request->payload.id.bytes;
  add_payload.added = true;
  add_payload.mass = request->payload.mass;
  add_payload.length_m = request->payload.length_m;
  add_payload.width_m = request->payload.width_m;
  add_payload.height_m = request->payload.height_m;
  add_payload.ev_charge_requested = request->payload.ev_charge_requested;
  add_payload.tray_id = tray_opt->id;
  add_payload.reciprocal_to_tray = tray_opt->pose.heading != inbound_heading_opt.value();
  auto resource_size_opt = layout_->GetSmallestEnclosingResourceSizeIndex(
      request->payload.length_m, request->payload.width_m, request->payload.height_m);
  if(!resource_size_opt.has_value()) {
    auto msg = "Payload not added! Length " + std::to_string(request->payload.length_m) + " , width " +
               std::to_string(request->payload.width_m) + " , height " +
               std::to_string(request->payload.height_m) + " does not fit in any resource windows!";
    WARNS(logger_, msg);
    response->success = false;
    response->message = msg;
    return;
  }

  // Apply the event
  // Note that this can fail, such as when the tray already has a payload
  std::tie(response->success, response->message) = ApplyAndPublishEvent(add_payload, false);
  if(!response->success) {
    response->message = "Failed to place payload " + std::to_string(request->payload.id) + " on t" +
                        std::to_string(tray_opt->id) + " in b" + std::to_string(request->bay_id) + ": " +
                        response->message;
  }
}

void GarageTracker::RemoveAgvSrvCallback(
    SetUInt16Srv::Request::SharedPtr request, SetUInt16Srv::Response::SharedPtr response) {
  const auto& agv_id = request->value;
  std::string agv_name = "a" + std::to_string(agv_id);
  INFOS(logger_, "Received request to remove AGV " << agv_name << "!");

  // Find the AGV
  auto agv_opt = state_.GetAgv(agv_id);
  if(!agv_opt.has_value()) {
    response->message = "Could not find AGV " + agv_name;
    response->success = false;
    return;
  }

  // If the AGV is carrying a tray, drop the tray first so the removal can succeed
  if(agv_opt->tray_id > 0) {
    AgvLiftChangedMsg lower_agv {};
    lower_agv.agv_id = agv_id;
    lower_agv.raised = false;
    std::tie(response->success, response->message) = ApplyAndPublishEvent(lower_agv, false);
    if(!response->success) {
      response->message = "Failed to lower " + agv_name + " with tray " + std::to_string(agv_opt->tray_id) +
                          ": " + response->message;
      return;
    }

    // Update our AGV reference (AGV is guaranteed to exist)
    agv_opt = state_.GetAgv(agv_id);
  }

  auto remove_agv = volley::GetAddEvent(agv_opt.value());
  remove_agv.added = false;

  // Apply the removal event
  std::tie(response->success, response->message) = ApplyAndPublishEvent(remove_agv, false);
  if(!response->success) {
    response->message = "Failed to remove AGV " + agv_name + ": " + response->message;
  }
}

void GarageTracker::RemovePayloadFromBaySrvCallback(
    SetUInt32Srv::Request::SharedPtr request, SetUInt32Srv::Response::SharedPtr response) {
  uint16_t bay_id = request->value;
  INFOS(logger_, "Received request to remove payload from bay b" << bay_id << "!");

  // Find the bay
  auto bay_opt = state_.GetBay(bay_id);
  if(!bay_opt.has_value()) {
    response->message = "b" + std::to_string(bay_id) + " does not exist";
    response->success = false;
    return;
  }

  // Find the tray
  auto tray_opt = state_.GetTrayOnNode(bay_id);
  if(!tray_opt.has_value()) {
    response->message =
        "Could not find a tray in b" + std::to_string(bay_id) + " from which to remove a payload";
    response->success = false;
    return;
  }

  auto tray = tray_opt.value();
  if(tray.payload_id == volley::kEmptyGuid) {
    response->message = "Tray in b" + std::to_string(bay_id) + " has no payload";
    response->success = false;
    return;
  }

  auto payload_opt = state_.GetPayload(tray.payload_id);
  if(!payload_opt.has_value()) {
    response->message = "Failed to look up payload " + std::to_string(tray.payload_id) +
                        " while removing it from tray t" + std::to_string(tray.id);
    response->success = false;
    return;
  }

  auto remove_payload = volley::GetAddEvent(payload_opt.value());
  remove_payload.added = false;

  // Apply the event
  // Note that this can fail, such as when the tray already has a payload
  std::tie(response->success, response->message) = ApplyAndPublishEvent(remove_payload, false);
  if(!response->success) {
    response->message = "Failed to remove payload " + std::to_string(payload_opt->payload.id) + " on t" +
                        std::to_string(remove_payload.tray_id) + " in b" + std::to_string(bay_id) + ": " +
                        response->message;
  }
  else {
    // Emit a garage event
    GarageEventMsg event {};
    event.type = GarageEventMsg::EVENT_PAYLOAD_REMOVED_FROM_BAY;
    event.bay_id = bay_id;
    volley::PrintEvent(logger_, event);
  }
}

