<file path="src/garage_tracker_ros.cpp">
#include "central/garage_tracker_ros.hpp"

#include <common/topics_agv.hpp>
#include <common/topics_bay.hpp>
#include <common/topics_central.hpp>
#include <common/topics_sim.hpp>
#include <common/topics_vecs.hpp>
#include <common_ros/print_utils.hpp>
#include <rclcppx/interface_factories.hpp>
#include <vrc_interfaces/msg/vrc_report.hpp>
#include <vrc_interfaces/namespace.hpp>
#include <vrc_interfaces/topics.hpp>

#include "central/central_timing.hpp"

namespace volley {

GarageTrackerRos::GarageTrackerRos(
    LayoutSPtr layout, std::optional<GarageDatabaseParameters> db_params, NodeSPtr node) :
    node_(node),
    tracker_(
        layout, db_params,
        [this](DiscreteGarageEventStampedMsg::UniquePtr event) {
          if(discrete_event_pub_) {
            event->header.stamp = node_->now();
            discrete_event_pub_->publish(std::move(event));
          }
        },
        node_->get_logger(), node_->Param<bool>("is_simulation", false)) {
  // clang-format off

    // only publish latest
    continuous_garage_info_pub_ = node_->CreatePub<ContinuousGarageInfoMsg>(
        volley::TopicCentralContinousGarageInfo(), volley::GetReliableQoS(1));
    discrete_event_pub_ =
        node_->CreatePub<DiscreteGarageEventStampedMsg>(volley::TopicCentralDiscreteEvents());
    // only publish latest if multiple events produced at once
    discrete_garage_state_pub_ = node_->CreatePub<DiscreteGarageStateMsg>(
        volley::TopicCentralDiscreteGarageState(), volley::GetReliableQoS(1));

    register_retrieval_code_cli_ = node_->create_client<RegisterRetrievalCodeSrv>("/rest_api/register_retrieval_code");

    // Services
    add_agv_srv_ = rclcppx::CreateService<SetUInt16Srv>(node_,
        "add_agv", [this](SetUInt16Srv::Request::SharedPtr request,
                          SetUInt16Srv::Response::SharedPtr response) {
            tracker_.AddAgvSrvCallback(request, response);
            if (response->success) {
                SubscribeToAgv(request->value);
            }
        });
    add_payload_srv_ = rclcppx::CreateService<AddPayloadSrv>(node_,
        "add_payload", [this](AddPayloadSrv::Request::SharedPtr request,
                              AddPayloadSrv::Response::SharedPtr response) {
            tracker_.AddPayloadSrvCallback(request, response);
            if(response->success) {
                auto req = std::make_shared<RegisterRetrievalCodeSrv::Request>();
                req->payload_id = request->payload.id;
                register_retrieval_code_cli_->async_send_request(req,
                    [logger = node_->get_logger(), payload_id = request->payload.id](
                        rclcpp::Client<RegisterRetrievalCodeSrv>::SharedFuture future) {
                        auto result = future.get();
                        if(!result->success) {
                            WARNS(logger, std::format("Failed to register payload {} for retrieval: {}", to_string(payload_id), result->message));
                        }
                        else{
                            INFOS(logger, std::format("Sucessfully registered payload {} with retrieval code {}", to_string(payload_id), result->retrieval_code));
                        }
                    });
            }
        });
    add_tray_srv_ = rclcppx::CreateService<AddTraySrv>(node_,
        "add_tray",
        [this](AddTraySrv::Request::SharedPtr request, AddTraySrv::Response::SharedPtr response) {
            tracker_.AddTraySrvCallback(request, response);
        });
    fault_reset_srv_ = rclcppx::CreateService<TriggerSrv>(node_,
        "fault_reset",
        [this](TriggerSrv::Request::SharedPtr, TriggerSrv::Response::SharedPtr response) {
            tracker_.FaultResetSrvCallback(response);
        });
    place_payload_in_bay_srv_ = rclcppx::CreateService<PlacePayloadInBaySrv>(node_,
        "place_payload_in_bay", [this](PlacePayloadInBaySrv::Request::SharedPtr request,
                                       PlacePayloadInBaySrv::Response::SharedPtr response) {
            tracker_.PlacePayloadInBaySrvCallback(request, response);
        });
    remove_agv_srv_ = rclcppx::CreateService<SetUInt16Srv>(node_,
        "remove_agv", [this](SetUInt16Srv::Request::SharedPtr request,
                             SetUInt16Srv::Response::SharedPtr response) {
            tracker_.RemoveAgvSrvCallback(request, response);
            if (response->success) {
                agv_report_subs_.erase(request->value);
            }
        });
    remove_payload_from_bay_srv_ = rclcppx::CreateService<SetUInt32Srv>(node_,
        "remove_payload_from_bay", [this](SetUInt32Srv::Request::SharedPtr request,
                                          SetUInt32Srv::Response::SharedPtr response) {
            tracker_.RemovePayloadFromBaySrvCallback(request, response);
        });
    remove_payload_from_tray_srv_ = rclcppx::CreateService<SetUInt16Srv>(node_,
        "remove_payload_from_tray", [this](SetUInt16Srv::Request::SharedPtr request,
                                           SetUInt16Srv::Response::SharedPtr response) {
            tracker_.RemovePayloadFromTraySrvCallback(request, response);
        });
    remove_tray_srv_ = rclcppx::CreateService<SetUInt16Srv>(node_,
        "remove_tray", [this](SetUInt16Srv::Request::SharedPtr request,
                              SetUInt16Srv::Response::SharedPtr response) {
            tracker_.RemoveTraySrvCallback(request, response);
        });
    set_agv_disabledness_srv_ = rclcppx::CreateService<SetResourceDisablednessSrv>(node_,
        "set_agv_disabledness", [this](SetResourceDisablednessSrv::Request::SharedPtr request,
                                       SetResourceDisablednessSrv::Response::SharedPtr response) {
            tracker_.SetAgvDisablednessSrvCallback(request, response);
        });
    set_node_disabledness_srv_ = rclcppx::CreateService<SetResourceDisablednessSrv>(node_,
        "set_node_disabledness", [this](SetResourceDisablednessSrv::Request::SharedPtr request,
                                        SetResourceDisablednessSrv::Response::SharedPtr response) {
            tracker_.SetNodeDisablednessSrvCallback(request, response);
        });
    set_tray_disabledness_srv_ = rclcppx::CreateService<SetResourceDisablednessSrv>(node_,
        "set_tray_disabledness", [this](SetResourceDisablednessSrv::Request::SharedPtr request,
                                        SetResourceDisablednessSrv::Response::SharedPtr response) {
            tracker_.SetTrayDisablednessSrvCallback(request, response);
        });
    set_vecs_disabledness_srv_ = rclcppx::CreateService<SetResourceDisablednessSrv>(node_,
        "set_vecs_disabledness", [this](SetResourceDisablednessSrv::Request::SharedPtr request,
                                        SetResourceDisablednessSrv::Response::SharedPtr response) {
            tracker_.SetVecsDisablednessSrvCallback(request, response);
        });
    set_tray_pose_srv_ = rclcppx::CreateService<MoveTraySrv>(node_,
        "set_tray_pose",
        [this](MoveTraySrv::Request::SharedPtr request, MoveTraySrv::Response::SharedPtr response) {
            tracker_.SetTrayPoseSrvCallback(request, response);
        });

    // Add subscriptions for entities in the state
    CreateEntitySubscriptions();

    // Create our timer
    continuous_garage_info_pub_timer_ =
        node_->create_timer(central::kGarageInfoPeriod, [this] {
            PublishContinuousGarageInfo();
            PublishDiscreteGarageState();
        });

    snapshot_pub_ = node->CreatePub<GarageSnapshotMsg>("/central/", volley::TopicGarageSnapshot());
    snapshot_timer_ = node_->create_timer(central::kSnapshotTimer, [this] {
          GarageSnapshotMsg snapshot;
          tracker_.CaptureGarageSnapshot(snapshot, node_->now());
          snapshot_pub_->publish(snapshot);
        });

    // While the discrete state will be published quickly by the timer, it makes
    // sense to once the tracker is loaded, immediately publish a complete discrete
    // garage state for other components to work off of.
    PublishDiscreteGarageState();
  // clang-format on
}

void GarageTrackerRos::CreateEntitySubscriptions() {
  for(const auto& [agv_id, agv] : tracker_.GetState().GetAgvs()) {
    if(agv_report_subs_.find(agv_id) == agv_report_subs_.end()) {
      SubscribeToAgv(agv_id);
    }
  }

  for(const auto& [bay_id, bay] : tracker_.GetState().GetBays()) {
    if(bay_report_subs_.find(bay_id) == bay_report_subs_.end()) {
      SubscribeToBay(bay_id);
    }
  }

  for(const auto& [vecs_id, vecs] : tracker_.GetState().GetVexen()) {
    if(vecs_report_subs_.find(vecs_id) == vecs_report_subs_.end()) {
      SubscribeToVecs(vecs_id);
    }
  }

  for(const auto& [vrc_id, vrcs] : tracker_.GetState().GetVrcs()) {
    if(vrc_report_subs_.find(vrc_id) == vrc_report_subs_.end()) {
      SubscribeToVrc(vrc_id);
    }
  }
}

void GarageTrackerRos::SubscribeToAgv(const uint16_t agv_id) {
  if(agv_id == 0) {
    WARNS(node_->get_logger(), "Attempted to subscribe to a0 - rejecting");
    return;
  }

  std::string name = "a" + std::to_string(agv_id);
  INFOS(node_->get_logger(), "Subscribing to new AgvReport topic: " << name);
  agv_report_subs_[agv_id] = node_->create_subscription<AgvReportMsg>(
      "/agv/" + name + "/" + volley::TopicAgvReport().Name(), volley::GetBestEffortQoS(1),
      [this](AgvReportMsg::UniquePtr msg) { tracker_.AgvReportCallback(std::move(msg)); });
}

void GarageTrackerRos::SubscribeToBay(const uint16_t bay_id) {
  if(bay_id == 0) {
    WARNS(node_->get_logger(), "Attempted to subscribe to b0 - rejecting");
    return;
  }

  std::string name = "b" + std::to_string(bay_id);
  INFOS(node_->get_logger(), "Subscribing to new BayReport topic: " << name);
  bay_report_subs_[bay_id] = node_->create_subscription<BayReportMsg>(
      "/bay/" + name + "/" + volley::TopicBayReport().Name(), volley::GetBestEffortQoS(1),
      [this](BayReportMsg::UniquePtr msg) { tracker_.BayReportCallback(std::move(msg)); });
}

void GarageTrackerRos::SubscribeToVecs(const uint16_t vecs_id) {
  if(vecs_id == 0) {
    WARNS(node_->get_logger(), "Attempted to subscribe to v0 - rejecting");
    return;
  }

  std::string name = "v" + std::to_string(vecs_id);
  INFOS(node_->get_logger(), "Subscribing to new VecsReport topic: " << name);
  vecs_report_subs_[vecs_id] = node_->create_subscription<VecsReportMsg>(
      "/vecs/" + name + "/" + volley::TopicVecsReport().Name(), volley::GetBestEffortQoS(1),
      [this](VecsReportMsg::UniquePtr msg) { tracker_.VecsReportCallback(std::move(msg)); });
}

void GarageTrackerRos::SubscribeToVrc(const uint16_t vrc_id) {
  if(vrc_id == 0) {
    WARNS(node_->get_logger(), "Attempted to subscribe to vrc_id=0 - rejecting");
    return;
  }

  const auto topic =
      volley::rclcppx::Namespaced(vrc_interfaces::VrcNamespace(vrc_id), vrc_interfaces::kVrcReportTopic);
  INFOS(node_->get_logger(), "Subscribing to new VRC report topic: " << topic.name);
  vrc_report_subs_[vrc_id] = volley::rclcppx::CreateSubscription(node_, topic,
      [this](vrc_interfaces::msg::VrcReport::UniquePtr msg) { tracker_.VrcReportCallback(std::move(msg)); });
}

void GarageTrackerRos::PublishContinuousGarageInfo() {
  continuous_garage_info_pub_->publish(tracker_.GetContinuousGarageInfo(node_->now()));
}

void GarageTrackerRos::PublishDiscreteGarageState() {
  discrete_garage_state_pub_->publish(tracker_.GetDiscreteGarageState(node_->now()));
}

