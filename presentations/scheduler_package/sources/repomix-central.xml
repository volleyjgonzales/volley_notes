<file path="include/central/command_send.hpp">
#pragma once
#include <central/central_msgs.hpp>
#include <common/constants.hpp>
#include <common/types.hpp>
#include <functional>
#include <rclcpp/time.hpp>

namespace volley {

// The CommandSend interface is an adaptor for interchangable components
// between real-world, unit-test, system-test, simulation.

// Functions return true to indicate that the command was successfully received by the entity.
// Functions return false if the command was not received.

// Old interface functions send AgvCommand, BayCommand, VecsCommand.
// New interace functions send a vector of ActionNodes, which contains the respective commands.

class CommandSend {
public:
  virtual ~CommandSend() = default;

  virtual void activateAgv(uint16_t agv_id) = 0;
  virtual void stopAgv(uint16_t agv_id) = 0;
  virtual bool sendAgvCommand(uint16_t agv_id, const AgvCommandMsg& command) = 0;
  virtual bool sendAgvCommand(uint16_t agv_id, const AgvCommandMsgVec& cmds) = 0;

  virtual bool sendBayCommand(uint16_t bay_id, const BayCommandMsg& command) = 0;
  virtual bool sendVecsCommand(uint16_t vecs_id, const VecsCommandMsg& command) = 0;
  virtual bool sendVrcCommand(uint16_t vrc_id, const VrcCommandMsg& command) = 0;
};

using CommandSendSPtr = std::shared_ptr<CommandSend>;

// Helper for holding functions for sending commands to various entities
class CommandSendFunctions : public CommandSend {
public:
  CommandSendFunctions() = delete;
  CommandSendFunctions(const std::function<bool(uint16_t, const AgvCommandMsg&)>& agv_command_function,
      const std::function<bool(uint16_t, const BayCommandMsg&)>& bay_command_function,
      const std::function<void(uint16_t)>& agv_activate_function,
      const std::function<void(uint16_t)>& agv_stop_function,
      const std::function<bool(uint16_t, const VecsCommandMsg&)>& vecs_command_function = {},
      const std::function<bool(uint16_t, const VrcCommandMsg&)>& vrc_command_function = {}) :
      send_agv_command(agv_command_function),
      send_bay_command(bay_command_function),
      activate_agv(agv_activate_function),
      stop_agv(agv_stop_function),
      send_vecs_command(vecs_command_function),
      send_vrc_command(vrc_command_function) { }

  void activateAgv(uint16_t agv_id) override;
  void stopAgv(uint16_t agv_id) override;

  bool sendAgvCommand(uint16_t agv_id, const AgvCommandMsg& command) override;
  bool sendAgvCommand(uint16_t agv_id, const AgvCommandMsgVec& cmds) override;

  bool sendBayCommand(uint16_t bay_id, const BayCommandMsg& command) override;
  bool sendVecsCommand(uint16_t vecs_id, const VecsCommandMsg& command) override;
  bool sendVrcCommand(uint16_t vrc_id, const VrcCommandMsg& command) override;

protected:
  // Sending functions for the AGV and bay commands. A true return value indicates the command was
  // successfully received.
  std::function<bool(uint16_t, const AgvCommandMsg&)> send_agv_command;
  std::function<bool(uint16_t, const BayCommandMsg&)> send_bay_command;
  // Activation and stopping functions for the AGV.
  std::function<void(uint16_t)> activate_agv;
  std::function<void(uint16_t)> stop_agv;
  // Sending function for VECS commands.
  std::function<bool(uint16_t, const VecsCommandMsg&)> send_vecs_command;
  // Sending function for VRC commands.
  std::function<bool(uint16_t, const VrcCommandMsg&)> send_vrc_command;
};

}  // namespace volley
</file>

