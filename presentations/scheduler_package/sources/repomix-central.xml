#include <central/central_msgs.hpp>
#include <central/mqtt_bridge_constants.hpp>
#include <central/mqtt_bridge_ros.hpp>
#include <common/topics_central.hpp>
#include <common_ros/ros_utils.hpp>
#include <cstdlib>

namespace volley {

// Constructs a wrapper around the ROS node and creates the MqttBridge which actually connects
// to the broker. Also creates any subscriptions whose topics are knowable (i.e. ones that don't
// contain an entity ID such as a VECS node that vary per garage).
MqttBridgeRos::MqttBridgeRos(NodeSPtr node) : node_(node) {
  int installation_id = 0;
  try {
    installation_id = node->Param<int>("installation_id", 0);
  }
  catch(const std::exception& e) {
    ERRORS(node->get_logger(),
        "MQTT bridge can't be initialized because we failed to get installation ID: " << e.what());
    return;
  }

  // Check if the AWS IoT certificates are in the environment. If they are missing (such as when
  // running a sim), don't create the bridge and try to connect.
  bool env_ok = true;
  for(const auto& env_var : {kCertVar, kKeyVar, kCaVar}) {
    if(!std::getenv(env_var.c_str())) {
      env_ok = false;
      INFOS(node->get_logger(), "Environment variable " << env_var << " is not set.");
    }
  }
  if(!env_ok) {
    WARNS(node->get_logger(),
        "Certificates are missing from the environment and no MQTT client will be "
        "created. This is OK if this is not a real garage.");
    return;
  }

  mqtt_bridge_ = std::make_unique<MqttBridge>(node->get_logger(), std::to_string(installation_id));

  // Subscribe to garage status which is the same for all garages.
  garage_status_sub_ = node->create_subscription<GarageStatusReportMsg>(
      volley::TopicCentralGarageStatus().Name(), volley::GetBestEffortQoS(1),
      [this](GarageStatusReportMsg::UniquePtr msg) { mqtt_bridge_->PublishGarageStatus(std::move(msg)); });

  // Subscribe to continuous garage info so that we can subscribe to entities listed therein such
  // as AGVs, bays, vexen, etc. once they have published a report that is included in the
  // continuous garage info message.
  continuous_garage_info_sub_ = node->create_subscription<ContinuousGarageInfoMsg>(
      volley::TopicCentralContinousGarageInfo().Name(), volley::GetBestEffortQoS(1),
      [this](ContinuousGarageInfoMsg::UniquePtr msg) { ReadContinuousGarageInfo(std::move(msg)); });

  // Temporarily adding v45 directly until vexen are present in the ContinuousGarageInfo which
  // Seth has a ticket for (SW-964). TODO(dan): Remove this.
  // DUE TO COMPANY WIND DOWN, THIS WAS NOT COMPLETED. If you are running VECS in the future and
  // want to publish the report over MQTT, update the topic AND id integer in the insert below.
  const std::string topic = "/vecs/v45/report";
  rclcpp::Subscription<VecsReportMsg>::SharedPtr sub =
      node_->create_subscription<VecsReportMsg>(topic, volley::GetBestEffortQoS(1),
          [this](VecsReportMsg::UniquePtr msg) { mqtt_bridge_->PublishVecsReport(std::move(msg)); });
  vecs_report_subs_.insert({45, sub});
}

// Callback for the continuous garage info subscription that reads the list of vexen and subscribes
// to their reports and adds to the vecs_report_subs_ map.
void MqttBridgeRos::ReadContinuousGarageInfo(ContinuousGarageInfoMsg::UniquePtr msg) {
  // Check for new VECS reports and subscribe to them.
  for(const auto& vecs : msg->vexen) {
    if(vecs_report_subs_.count(vecs.report.vecs_id) == 0) {
      const std::string topic = "/vecs/" + vecs.report.name + "/report";
      rclcpp::Subscription<VecsReportMsg>::SharedPtr sub =
          node_->create_subscription<VecsReportMsg>(topic, volley::GetBestEffortQoS(1),
              [this](VecsReportMsg::UniquePtr msg) { mqtt_bridge_->PublishVecsReport(std::move(msg)); });
      vecs_report_subs_.insert({vecs.report.vecs_id, sub});
    }
  }
}

}  // namespace volley
