#include <central/central_msgs.hpp>
#include <central/garage_tracker_ros.hpp>
#include <common_ros/component.hpp>
#include <common_ros/layout.hpp>
#include <cstdlib>

namespace central {
using namespace volley;

class GarageTrackerComponent : public volley::Component {
public:
  explicit GarageTrackerComponent(const rclcpp::NodeOptions& options) {
    auto node = std::make_shared<volley::Node>("garage_tracker", options);
    const auto logger = node->get_logger();

    // Load our ROS params
    std::string layout_file;
    bool write_to_mysql = true;
    GarageDatabaseParameters db_params;
    try {
      layout_file = node->Param<std::string>("layout");
      write_to_mysql = node->Param<bool>("garage_tracker.write_to_mysql");
      db_params.port = node->Param<int>("garage_tracker.mysql.port");
      db_params.host = node->Param<std::string>("garage_tracker.mysql.host");
      db_params.user = node->Param<std::string>("garage_tracker.mysql.user");
      db_params.password = node->Param<std::string>("garage_tracker.mysql.password");
      db_params.database = node->Param<std::string>("garage_tracker.mysql.database");
      // TODO(Gunther):  Add a initial_discrete_garage_state param for the sim so the state
      // can be loaded at startup
    }
    catch(const std::exception& exception) {
      // Catch all parameter related exceptions. No reason to continue on if we cannot read
      // our parameters properly.
      ERRORS(logger, "Exception: " << exception.what());
      exit(EXIT_FAILURE);
    }

    const auto layout_filepath_or = GetLayoutPathByName(layout_file);
    if(!layout_filepath_or.has_value()) {
      ERRORS(logger, layout_filepath_or.error());
      exit(EXIT_FAILURE);
    }
    const auto& layout_filepath = layout_filepath_or.value();

    // Display information
    INFOS(logger, "layout_file: " << layout_filepath);

    std::optional<GarageDatabaseParameters> db_params_opt = std::nullopt;
    if(write_to_mysql) {
      INFOS(logger, "port:     " << db_params.port);
      INFOS(logger, "host:     " << db_params.host);
      INFOS(logger, "user:     " << db_params.user);
      INFOS(logger, "password: " << db_params.password);
      INFOS(logger, "database: " << db_params.database);
      db_params_opt = db_params;
    }
    else {
      INFOS(logger, "Not writing to MySQL");
    }

    // Moving `exit` calls here instead of exiting from many different places within the garage
    // tracker. GarageTracker constructor throws an std::runtime_error when it fails.
    try {
      garage_tracker_ = std::make_unique<GarageTrackerRos>(
          std::make_shared<volley::Layout>(layout_filepath), db_params_opt, node);
    }
    catch(const std::runtime_error& e) {
      ERRORS(logger, "Failed to construct GarageTracker ROS " << e.what());
      exit(1);
    }
    SetNode(node);
  }

private:
  std::unique_ptr<GarageTrackerRos> garage_tracker_;
};

}  // namespace central

#include <rclcpp_components/register_node_macro.hpp>
RCLCPP_COMPONENTS_REGISTER_NODE(central::GarageTrackerComponent)
