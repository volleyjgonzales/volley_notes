void GarageTracker::SetTrayPoseSrvCallback(
    MoveTraySrv::Request::SharedPtr request, MoveTraySrv::Response::SharedPtr response) {
  INFOS(logger_, "Received request to set the pose of t" << std::to_string(request->tray_id) << "!");

  // Find the tray
  auto tray_opt = state_.GetTray(request->tray_id);
  if(!tray_opt.has_value()) {
    response->message = "Could not find tray t" + std::to_string(request->tray_id);
    response->success = false;
    return;
  }

  // Confirm that the destination garage pose exists.
  if(!layout_->HasGaragePose(request->pose)) {
    response->message =
        "Destination garage pose " + std::to_string(request->pose) + " does not exist in our layout.";
    response->success = false;
    return;
  }

  // move the tray
  TrayPoseSetManuallyMsg tray_pose_set {};
  tray_pose_set.tray_id = request->tray_id;
  tray_pose_set.node_id_curr = tray_opt->pose.node_id;
  tray_pose_set.heading_curr = tray_opt->pose.heading;
  tray_pose_set.node_id_next = request->pose.node_id;
  tray_pose_set.heading_next = request->pose.heading;

  // Apply the event
  std::tie(response->success, response->message) = ApplyAndPublishEvent(tray_pose_set, false);
  if(!response->success) {
    response->message = "Failed to manually set tray pose for t" + std::to_string(tray_pose_set.tray_id) +
                        ": " + response->message;
    return;
  }
}

ContinuousGarageInfoMsg::UniquePtr GarageTracker::GetContinuousGarageInfo(const rclcpp::Time& now) const {
  auto message = std::make_unique<ContinuousGarageInfoMsg>();
  for(const auto& [agv_id, report] : agv_reports_) {
    ContinuousGarageAgvInfoMsg info;
    info.report = report;
    info.staleness = static_cast<float>((now - rclcpp::Time(report.header.stamp)).seconds());
    message->agvs.emplace_back(info);
  }
  for(const auto& [bay_id, report] : bay_reports_) {
    ContinuousGarageBayInfoMsg info;
    info.report = report;
    info.staleness = static_cast<float>((now - rclcpp::Time(report.header.stamp)).seconds());
    message->bays.emplace_back(info);
  }
  for(const auto& [vecs_id, report] : vecs_reports_) {
    ContinuousGarageVecsInfoMsg info;
    info.report = report;
    info.staleness = static_cast<float>((now - rclcpp::Time(report.header.stamp)).seconds());
    message->vexen.emplace_back(info);
  }
  for(const auto& [vrc_id, report] : vrc_reports_) {
    message->vrcs.emplace_back(report);
  }

  message->header.stamp = now;
  return message;
}

DiscreteGarageStateMsg::UniquePtr GarageTracker::GetDiscreteGarageState(const rclcpp::Time& now) const {
  auto message = std::make_unique<DiscreteGarageStateMsg>(state_.GetDiscreteGarageStateMessage());

  message->header.stamp = now;
  return message;
}

void GarageTracker::CaptureGarageSnapshot(GarageSnapshotMsg& snapshot, const rclcpp::Time& now) {
  snapshot.header.stamp = now;

  const std::map<uint16_t, DiscreteTrayStateMsg>& trays = state_.GetTrays();
  const std::map<const GuidMsg, DiscretePayloadStateMsg, GuidComparator>& payloads = state_.GetPayloads();

  // Trays
  for(const auto& [tray_id, tray] : trays) {
    GarageTrayMsg garage_tray {};
    garage_tray.id = tray.id;
    const auto node = layout_->GetNodeById(tray.pose.node_id);
    garage_tray.floor = node.has_value() ? node.value().floor : 0;
    float tray_degrees = tray.pose.heading;
    float tray_radians = radians(tray_degrees);

    // Payloads on trays
    if(tray.payload_id != volley::kEmptyGuid) {
      auto pit = payloads.find(tray.payload_id);
      if(pit != payloads.end()) {
        const DiscretePayloadStateMsg& payload = pit->second;
        garage_tray.reciprocal_to_payload = payload.reciprocal_to_tray;
        garage_tray.payload_id = tray.payload_id;

        GaragePayloadMsg garage_payload {};
        garage_payload.payload = payload.payload;
        garage_payload.pose = tray.pose;
        garage_payload.floor = garage_tray.floor;

        if(tray.agv_id != 0) {
          // Check the AGV.
          auto it = agv_reports_.find(tray.agv_id);
          if(it != agv_reports_.end()) {
            // Is the AGV carrying this tray?
            const AgvReportMsg& agvreport = it->second;

            garage_payload.pose = agvreport.garage_pose_and_lift.pose;

            // Use the Geometric Pose from the AGV that is carrying it.
            garage_payload.geometric_pose = agvreport.pose;

            // Check if the tray is reciprocal to the AGV.
            bool tray_reciprocal_to_agv = tray.pose.heading != agvreport.garage_pose_and_lift.pose.heading;

            if(tray_reciprocal_to_agv) {
              // The tray is reciprocal heading to the AGV.
              garage_tray.geometric_pose.yaw = volley::Wrap(agvreport.pose.yaw + M_PI);
              if(!payload.reciprocal_to_tray) {
                // The payload is reciprocal heading to the AGV.
                garage_payload.geometric_pose.yaw = volley::Wrap(agvreport.pose.yaw + M_PI);
                garage_payload.pose.heading = volley::Wrap(agvreport.garage_pose_and_lift.pose.heading + 180);
              }
              // Otherwise the payload is the same heading as the AGV.
            }
            else {
              // Tray is same heading as AGV.
              if(payload.reciprocal_to_tray) {
                // The payload is reciprocal heading as the AGV.
                garage_payload.geometric_pose.yaw = volley::Wrap(agvreport.pose.yaw + M_PI);
                garage_payload.pose.heading = volley::Wrap(agvreport.garage_pose_and_lift.pose.heading + 180);
              }
              // Otherwise the payload is the same heading as the AGV.
            }
          }
        }
        else {
          // Not carried by an AGV. Use the Garage Pose from the layout.
          std::optional<GarageNodeMsg> node_opt = layout_->GetNodeById(tray.pose.node_id);
          if(node_opt.has_value()) {
            const GarageNodeMsg& node = node_opt.value();
            garage_payload.geometric_pose.x = node.x;
            garage_payload.geometric_pose.y = node.y;
            garage_payload.geometric_pose.yaw = tray_radians;
            if(payload.reciprocal_to_tray) {
              garage_payload.geometric_pose.yaw = volley::Wrap(garage_payload.geometric_pose.yaw + M_PI);
            }
          }
        }
        snapshot.payloads.emplace_back(garage_payload);
      }
      else {
        garage_tray.reciprocal_to_payload = false;
        garage_tray.payload_id = volley::kEmptyGuid;
      }
    }
    else {
      garage_tray.reciprocal_to_payload = false;
      garage_tray.payload_id = volley::kEmptyGuid;
    }

    // Check the AGV
    if(tray.agv_id != 0) {
      auto it = agv_reports_.find(tray.agv_id);
      if(it != agv_reports_.end()) {
        // Carried by AGV. Use the Geometric Pose from the AGV that is carrying it.
        const AgvReportMsg& agvreport = it->second;

        // Check if the tray pose is reciprocal to the AGV.
        bool tray_reciprocal_to_agv = tray.pose.heading != agvreport.garage_pose_and_lift.pose.heading;

        garage_tray.pose = agvreport.garage_pose_and_lift.pose;
        garage_tray.geometric_pose = agvreport.pose;
        if(tray_reciprocal_to_agv) {
          garage_tray.geometric_pose.yaw = volley::Wrap(agvreport.pose.yaw + M_PI);
          garage_tray.pose.heading = volley::Wrap(agvreport.garage_pose_and_lift.pose.heading + 180);
        }
        snapshot.trays.emplace_back(garage_tray);
      }
      else {
        // Not carried by an AGV. Use the Garage Pose from the layout.
        std::optional<GarageNodeMsg> node_opt = layout_->GetNodeById(tray.pose.node_id);
        if(node_opt) {
          const GarageNodeMsg& node = node_opt.value();
          garage_tray.pose.node_id = node_opt->id;
          garage_tray.pose.heading = tray.pose.heading;
          garage_tray.geometric_pose.x = node.x;
          garage_tray.geometric_pose.y = node.y;
          garage_tray.geometric_pose.yaw = tray_radians;
          snapshot.trays.emplace_back(garage_tray);
        }
      }
    }
    else {
      // Not carried by an AGV. Use the Garage Pose from the layout.
      std::optional<GarageNodeMsg> node_opt = layout_->GetNodeById(tray.pose.node_id);
      if(node_opt) {
        const GarageNodeMsg& node = node_opt.value();
        garage_tray.pose.node_id = node_opt->id;
        garage_tray.pose.heading = tray.pose.heading;
        garage_tray.geometric_pose.x = node.x;
        garage_tray.geometric_pose.y = node.y;
        garage_tray.geometric_pose.yaw = tray_radians;
        snapshot.trays.emplace_back(garage_tray);
      }
    }
  }

  for(const auto& [bay_id, bayreport] : bay_reports_) {
    BayStateMsg baystate;
    baystate.id = bay_id;
    baystate.patron_light_state = 0;
    baystate.system_door_state = (bayreport.state == BayReportMsg::STATE_READY_TO_RETRIEVE)
                                     ? DoorReportMsg::DOOR_STATE_OPEN
                                     : DoorReportMsg::DOOR_STATE_CLOSED;
    snapshot.bays.emplace_back(baystate);
  }

  for(const auto& [agv_id, agv_report] : agv_reports_) {
    AgvSimStateMsg agv_sim_state;
    agv_sim_state.state.geometric_pose = agv_report.pose;
    const auto node = layout_->GetNodeById(agv_report.garage_pose_and_lift.pose.node_id);
    agv_sim_state.state.garage_pose = agv_report.garage_pose_and_lift.pose;
    agv_sim_state.state.floor = node.has_value() ? node.value().floor : 0;
    agv_sim_state.agv_id = agv_id;
    snapshot.agvs.emplace_back(agv_sim_state);
  }

  for(const auto& [vrc_id, report] : vrc_reports_) {
    snapshot.vrcs.emplace_back(report);
  }
}

BoolStringPair GarageTracker::PublishSerializedEvent(const DiscreteGarageEventMsg& event, size_t hash_prev) {
  // Increment our sequence number
  sequence_number_ += 1;
  // Create our event
  auto event_stamped = std::make_unique<DiscreteGarageEventStampedMsg>();
  event_stamped->event = event;
  event_stamped->sequence_number = sequence_number_;
  event_stamped->hash_prev = hash_prev;
  event_stamped->hash_next = state_.Hash();

  // Only interact with MySQL if specified.
  // We do not interact with MySQL when running in the sim.
  if(db_params_.has_value()) {
    // Store the updated state in our database
    auto [success, message] = WriteSnapshot(db_params_.value(), state_, sequence_number_);
    if(!success) {
      WARNS(logger_, "Failed to write snapshot to database: " << message);
      return std::make_pair(false, message);
    }
  }

  // Publish the event
  event_publisher_(std::move(event_stamped));

  // Success!
  return std::make_pair(true, "");
}

std::vector<GarageEntityIdMsg> GarageTracker::ValidatePosesForLayout() const {
  std::vector<GarageEntityIdMsg> errors;
  for(auto const& [agv_id, agv] : state_.GetAgvs()) {
    // Allow for unlocalized AGVs (pose 0@0)
    if(!(agv.pose.node_id == 0 && agv.pose.heading == 0) && !layout_->HasGaragePose(agv.pose)) {
      errors.emplace_back(volley::AgvId(agv_id));
    }
  }
  for(unsigned int bay_id : layout_->GetBayLikeNodeIds()) {
    if(!state_.HasBay(bay_id)) {
      errors.emplace_back(volley::BayId(bay_id));
    }
  }
  for(auto const& [tray_id, tray] : state_.GetTrays()) {
    if(!layout_->HasGaragePose(tray.pose)) {
      errors.emplace_back(volley::TrayId(tray_id));
    }
  }
  return errors;
}

