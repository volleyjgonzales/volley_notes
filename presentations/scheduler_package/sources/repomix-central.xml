  AgvClients clients;
  clients.client_cb_group = node_->create_callback_group(rclcpp::CallbackGroupType::MutuallyExclusive);
  clients.activate_cli = node_->create_client<TriggerSrv>(ns + "/activate");
  clients.command_cli =
      node_->create_client<AgvCommandSrv>(ns + "/command", rclcpp::ServicesQoS(), clients.client_cb_group);
  clients.commandlist_cli = node_->create_client<AgvCommandListSrv>(
      ns + "/commandlist", rclcpp::ServicesQoS(), clients.client_cb_group);
  clients.stop_cli = node_->create_client<AgvStopSrv>(ns + "/stop");

