namespace volley {

// CommandSend derived class for DispatchRos.
class CommandSendDispatch : public volley::CommandSend {
  DispatchRos* dispatchros_ = nullptr;

public:
  explicit CommandSendDispatch(DispatchRos* dispatchros) : dispatchros_(dispatchros) { }

  void activateAgv(uint16_t agv_id) override {
    if(dispatchros_ == nullptr) {
      return;
    }
    dispatchros_->SendAgvActivateCommand(agv_id);
  }
  void stopAgv(uint16_t agv_id) override {
    if(dispatchros_ == nullptr) {
      return;
    }
    dispatchros_->SendAgvStopCommand(agv_id);
  }
  bool sendAgvCommand(uint16_t agv_id, const AgvCommandMsg& command) override {
    if(dispatchros_ == nullptr) {
      return false;
    }
    return dispatchros_->SendAgvCommand(agv_id, command);
  }
  bool sendAgvCommand(uint16_t agv_id, const AgvCommandMsgVec& cmds) override {
    if(dispatchros_ == nullptr) {
      return false;
    }
    if(!dispatchros_->SendAgvCommandList(agv_id, cmds)) {
      return false;
    }
    return true;
  }
  bool sendBayCommand(uint16_t bay_id, const BayCommandMsg& command) override {
    if(dispatchros_ == nullptr) {
      return false;
    }
    return dispatchros_->SendBayCommand(bay_id, command);
  }
  bool sendVecsCommand(uint16_t vecs_id, const VecsCommandMsg& command) override {
    if(dispatchros_ == nullptr) {
      return false;
    }
    return dispatchros_->SendVecsCommand(vecs_id, command);
  }
  bool sendVrcCommand(uint16_t vrc_id, const VrcCommandMsg& command) override {
    if(dispatchros_ == nullptr) {
      return false;
    }
    return dispatchros_->SendVrcCommand(vrc_id, command);
  }
};

CommandSendSPtr CreateCommandSendDispatch(DispatchRos* dispatchros, const DispatchParams& /*params*/) {
  return std::make_shared<CommandSendDispatch>(dispatchros);
}

DispatchRos::DispatchRos(const DispatchParams& params, PoseGraphCSPtr pose_graph, NodeSPtr node) :
    dispatch_(params, pose_graph, CreateCommandSendDispatch(this, params), node->get_logger()), node_(node) {
  // clang-format off

    bool enable_dispatch_charging_mode = node->Param<bool>("enable_dispatch_charging_mode", true);
    dispatch_.SetEnableDispatchChargingMode(enable_dispatch_charging_mode);

    auto garage_dirtiness_threshold_ratio =
        node->Param<double>("dispatch.garage_dirtiness_threshold_ratio", 0.1);
    dispatch_.SetGarageDirtinessThresholdRatio(garage_dirtiness_threshold_ratio);

    bool printdags = node->Param<bool>("printdags");
    dispatch_.SetPrintDags(printdags);

    heartbeat_pub_ = node_->CreatePub<DispatchHeartbeatMsg>(volley::TopicCentralHeartbeat());

    report_pub_ = node_->CreatePub<DispatchReportMsg>(volley::TopicCentralReport());

    schedule_pub_ = node_->CreatePub<ScheduleMsg>(volley::TopicCentralSchedule());
    version_info_pub_ = node_->CreatePub<VersionInfoMsg>(volley::TopicCentralVersionInfo());
    pending_job_list_pub_ = node_->CreatePub<SchedulerJobListMsg>(volley::TopicCentralPendingJobs());
    active_job_list_pub_ = node_->CreatePub<SchedulerJobListMsg>(volley::TopicCentralActiveJobs());
    completed_job_list_pub_ = node_->CreatePub<SchedulerJobListMsg>(volley::TopicCentralCompletedJobs());
    plan_request_pub_ = node_->CreatePub<PlanRequestMsg>(volley::TopicCentralPlanRequest());
    plan_response_pub_ = node_->CreatePub<PlanResponseMsg>(volley::TopicCentralPlanResponse());

    consistency_report_sub_ = node_->CreateSub<ConsistencyReportMsg>(volley::TopicCentralConsistencyReport(),
        [this](ConsistencyReportMsg::UniquePtr msg) {
            dispatch_.ConsistencyReportCallback(std::move(msg));
        });
    continuous_garage_info_sub_ = node_->CreateSub<ContinuousGarageInfoMsg>(volley::TopicCentralContinousGarageInfo(),
        [this](ContinuousGarageInfoMsg::UniquePtr msg) {
            dispatch_.ContinuousGarageInfoCallback(std::move(msg));
        });
    discrete_garage_event_sub_ = node_->CreateSub<DiscreteGarageEventStampedMsg>(volley::TopicCentralDiscreteEvents(),
        [this](DiscreteGarageEventStampedMsg::UniquePtr msg) {
            dispatch_.DiscreteGarageEventCallback(std::move(msg));
        });
    discrete_garage_state_sub_ = node_->CreateSub<DiscreteGarageStateMsg>(volley::TopicCentralDiscreteGarageState(),
        [this](DiscreteGarageStateMsg::UniquePtr msg) {
            dispatch_.DiscreteGarageStateCallback(std::move(msg));
        });

    // Basic services
    get_job_state_srv_ = rclcppx::CreateService<GetJobStateSrv>(node_,
        "get_job_state", [this](GetJobStateSrv::Request::SharedPtr request,
                                GetJobStateSrv::Response::SharedPtr response) {
            dispatch_.GetJobStateSrvCallback(request, response);
        });
    set_mode_srv_ = rclcppx::CreateService<SetUInt8Srv>(node_,
        "set_mode",
        [this](SetUInt8Srv::Request::SharedPtr request, SetUInt8Srv::Response::SharedPtr response) {
            dispatch_.SetModeSrvCallback(request, response);
        });
    start_srv_ = rclcppx::CreateService<TriggerSrv>(node_,
        "start", [this](TriggerSrv::Request::SharedPtr, TriggerSrv::Response::SharedPtr response) {
            dispatch_.StartSrvCallback(response, node_->now());
        });
    stop_srv_ = rclcppx::CreateService<TriggerSrv>(node_,
        "stop", [this](TriggerSrv::Request::SharedPtr, TriggerSrv::Response::SharedPtr response) {
            dispatch_.StopSrvCallback(response);
        });
    pause_srv_ = rclcppx::CreateService<TriggerSrv>(node_,
        "pause", [this](TriggerSrv::Request::SharedPtr, TriggerSrv::Response::SharedPtr response) {
            dispatch_.PauseSrvCallback(response);
        });

    // Testing services:
    stop_planner_srv_ = rclcppx::CreateService<TriggerSrv>(node_,
        "stop_auto_planner",
        [this](TriggerSrv::Request::SharedPtr, TriggerSrv::Response::SharedPtr response) {
            if (!planner_timer_->is_canceled()) {
                planner_timer_->cancel();
                response->success = true;
                response->message = "Disabled automatic planner calls";
                INFOS(node_->get_logger(), response->message);
            } else {
                response->success = false;
                response->message = "Automatic planner calls already disabled";
                WARNS(node_->get_logger(), response->message);
            }
        });

    start_planner_srv_ = rclcppx::CreateService<TriggerSrv>(node_,
        "start_auto_planner",
        [this](TriggerSrv::Request::SharedPtr, TriggerSrv::Response::SharedPtr response) {
            if (planner_timer_->is_canceled()) {
                planner_timer_->reset();
                response->success = true;
                response->message = "Enabled automatic planner calls";
                INFOS(node_->get_logger(), response->message);
            } else {
                response->success = false;
                response->message = "Automatic planner calls not disabled";
                WARNS(node_->get_logger(), response->message);
            }
        });

    trigger_plan_srv_ = rclcppx::CreateService<TriggerSrv>(node_,
        "trigger_plan_call",
        [this](TriggerSrv::Request::SharedPtr, TriggerSrv::Response::SharedPtr response) {
            if (planner_timer_->is_canceled()) {
                if (dispatch_.ShouldCallPlanner()) {
                    CallPlanner();
                    response->success = true;
                    response->message = "Triggered plan call";
                    INFOS(node_->get_logger(), response->message);
                } else {
                    response->success = false;
                    response->message = "Dispatch::ShouldCallPlanner returned false";
                    WARNS(node_->get_logger(), response->message);
                }

            } else {
                response->success = false;
                response->message = "Did not trigger plan call, disable automatic plan calls first";
                WARNS(node_->get_logger(), response->message);
            }
        });
    // Engineering-only debug toggle, intentionally not introspected.
    debug_printdags_srv_ = node_->create_service<TriggerSrv>(
        "debug/printdags",
        [this](TriggerSrv::Request::SharedPtr request, TriggerSrv::Response::SharedPtr response) {
          (void) request;
          INFOF(node_->get_logger(), "Note: printing DAGs requires 'sudo apt-get install libgraph-easy-perl'");
          dispatch_.PrintDags();
          response->success = true;
          return response;
        },
        1u);

    charge_payload_srv_ = rclcppx::CreateService<ChargePayloadSrv>(node_,
        "charge_payload", [this](ChargePayloadSrv::Request::SharedPtr request,
                                 ChargePayloadSrv::Response::SharedPtr response) {
            dispatch_.ChargePayloadSrvCallback(request, response, node_->now());
        });
    move_agv_srv_ = rclcppx::CreateService<MoveAgvSrv>(node_,
        "move_agv",
        [this](MoveAgvSrv::Request::SharedPtr request, MoveAgvSrv::Response::SharedPtr response) {
            dispatch_.MoveAgvSrvCallback(request, response, node_->now());
        });
    move_tray_srv_ = rclcppx::CreateService<MoveTraySrv>(node_,
        "move_tray",
        [this](MoveTraySrv::Request::SharedPtr request, MoveTraySrv::Response::SharedPtr response) {
            dispatch_.MoveTraySrvCallback(request, response, node_->now());
        });
    repark_tray_srv_ = rclcppx::CreateService<ReparkTraySrv>(node_,
        "repark_tray", [this](ReparkTraySrv::Request::SharedPtr request,
                              ReparkTraySrv::Response::SharedPtr response) {
            dispatch_.ReparkTraySrvCallback(request, response, node_->now());
        });
    retrieve_srv_ = rclcppx::CreateService<RetrieveSrv>(node_,
        "retrieve",
        [this](RetrieveSrv::Request::SharedPtr request, RetrieveSrv::Response::SharedPtr response) {
            dispatch_.RetrieveSrvCallback(request, response, node_->now());
        });
    transition_bay_to_insert_srv_ = rclcppx::CreateService<TransitionBayToInsertSrv>(node_,
        "transition_bay_to_insert", [this](TransitionBayToInsertSrv::Request::SharedPtr request,
                                           TransitionBayToInsertSrv::Response::SharedPtr response) {
            dispatch_.TransitionBayToInsertSrvCallback(request, response, node_->now());
        });
    transition_bay_to_retrieve_srv_ = rclcppx::CreateService<TransitionBayToRetrieveSrv>(node_,
        "transition_bay_to_retrieve",
        [this](TransitionBayToRetrieveSrv::Request::SharedPtr request,
               TransitionBayToRetrieveSrv::Response::SharedPtr response) {
            dispatch_.TransitionBayToRetrieveSrvCallback(request, response, node_->now());
        });
    clean_garage_srv_ = rclcppx::CreateService<TriggerSrv>(node_,
        "clean_garage",
        [this](TriggerSrv::Request::SharedPtr, TriggerSrv::Response::SharedPtr response) {
            dispatch_.CleanGarageSrvCallback(response, node_->now());
        });
    rebalance_garage_srv_ = rclcppx::CreateService<TriggerSrv>(node_,
        "rebalance_garage",
        [this](TriggerSrv::Request::SharedPtr, TriggerSrv::Response::SharedPtr response) {
            dispatch_.RebalanceGarageSrvCallback(response, node_->now());
        });

    // Service Clients
    auto plan_qos = volley::GetReliableQoS(1);  // only keep one latest plan response
    plan_qos.lifespan(central::kPlanDeadlinePeriod);
    plan_cli_ = node_->create_client<PlanSrv>("/scheduler/plan", plan_qos);

    // Timers
    main_timer_ = node_->create_timer(central::kDispatchJobsPeriod, [this] {
            dispatch_.MainTimerCallback(node_->now());
            // Publish our heartbeat, report, and debug messages
            PublishHeartbeat();
            PublishReport();
            PublishDebugMessages();
        });
    planner_timer_ = node_->create_timer(central::kPlannerPeriod, [this] {
            if (dispatch_.ShouldCallPlanner()) {
                CallPlanner();
            }
        });
    version_info_timer_ = node_->create_timer(central::kVersionInfoPeriod, [this] {
            PublishVersionInfo();
        });
    cull_old_jobs_timer_ = node_->create_timer(central::kCullOldJobsPeriod, [this] {
            dispatch_.CullOldTerminalJobs(node_->now());
        });
  // clang-format on
}

void DispatchRos::PublishHeartbeat() {
  heartbeat_pub_->publish(dispatch_.GetHeartbeat(node_->now()));
}

void DispatchRos::PublishReport() {
  report_pub_->publish(dispatch_.GetDispatchReport(node_->now()));
}

void DispatchRos::PublishVersionInfo() {
  version_info_pub_->publish(dispatch_.GetVersionInfo(node_->now()));
}

void DispatchRos::PublishDebugMessages() {
  auto schedule_msg = dispatch_.GetScheduleMessage(node_->now());
  if(schedule_msg.has_value()) {
    schedule_pub_->publish(std::move(schedule_msg.value()));
  }

  auto command_sequences = dispatch_.GetAgvCommandSequences((node_->now()));
  for(auto& [agv_id, command_sequence_msg] : command_sequences) {
    if(!HasAgvCommandSequencePub(agv_id)) {
      CreateAgvCommandSequencePublisher(agv_id);
    }
    agv_command_sequence_pubs_[agv_id]->publish(std::move(command_sequence_msg));
  }

  pending_job_list_pub_->publish(std::move(dispatch_.GetPendingJobListMessage(node_->now())));
  active_job_list_pub_->publish(std::move(dispatch_.GetActiveJobListMessage(node_->now())));
  completed_job_list_pub_->publish(std::move(dispatch_.GetCompletedJobListMessage(node_->now())));
}

void DispatchRos::CreateAgvClients(uint16_t agv_id) {
