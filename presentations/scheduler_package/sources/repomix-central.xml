bool ExecutionState::IsActionInsideCommandHorizon(unsigned int node_index) const {
  return schedule_.GetNodeStartTime(node_index) < central::kCommandSendHorizon;
}

// TODO(Gunther): Return message or take logger?
void ExecutionState::SendReadyCommands() {
  // If using Hito, then use the use scehdule_execution.
  if(schedule_execution_) {
    schedule_execution_->SendReadyCommands();
  }
  else
  {
    // Not using hito, do it the old way.
    const auto& state = exec_state_latest_.GetGarageState();

    // Send ready AGV commands
    for(const auto& [agv_id, agv] : state.GetAgvs()) {
      // because of copy and move, the pointer could be different.
      send_ready_agv_->exeptr_ = this;
      send_ready_agv_->SendReadyAgvCommand(agv_id);
    }

    // Send ready bay commands
    for(const auto& [bay_id, bay] : state.GetBays()) {
      ExecutionState::SendReadyBayCommand(bay_id);
    }

    // Send ready VECS commands
    for(const auto& [vecs_id, _] : state.GetVexen()) {
      ExecutionState::SendReadyVecsCommand(vecs_id);
    }

    // Send ready VRC commands
    for(const auto& [vrc_id, _] : state.GetVrcs()) {
      ExecutionState::SendReadyVrcCommand(vrc_id);
    }
  }
}

void ExecutionState::SplitSchedule() {
  schedule_.SplitSchedule(central::kCommandSendHorizon);
}

void ExecutionState::UndoSplit() {
  schedule_.UndoSplit();
}

BoolStringPair ExecutionState::UpdateInternal(const DiscreteGarageEventMsg& event) {
  if(event.type == "AgvLiftChanged") {
    auto discrete_garage_event_opt = volley::Deserialize<AgvLiftChangedMsg>(event);
    if(!discrete_garage_event_opt.has_value()) {
      return std::make_pair(false, "Failed to deserialize " + event.type + " event");
    }

    auto agv_lift_changed = discrete_garage_event_opt.value();
    auto leading_action_index_opt =
        schedule_.GetLeadingEntityActionIndex(volley::AgvId(agv_lift_changed.agv_id));
    if(!leading_action_index_opt.has_value()) {
      return std::make_pair(false, "Event " + event.type + " was not found as the leading AGV node for " +
                                       std::to_string(agv_lift_changed.agv_id));
    }

    const auto& node = schedule_.GetNode(leading_action_index_opt.value());
    bool is_ready = schedule_.IsNodeReady(leading_action_index_opt.value());
    bool matches_leading_action = AgvCommandMatchesAgvEvent(node.agv_command, agv_lift_changed);
    if(!is_ready || !matches_leading_action) {
      std::string reason;
      if(!is_ready) {
        reason += "node " + std::to_string(leading_action_index_opt.value()) + " not ready (parents:";
        for(auto parent_idx : node.parents) {
          reason += " " + parent_node_str(schedule_, parent_idx);
        }
        reason += ")";
      }
      if(!matches_leading_action) {
        if(!reason.empty()) { reason += "; "; }
        reason += "leading action does not match event";
      }
      return std::make_pair(false,
          "Event " + event.type + " for AGV " + std::to_string(agv_lift_changed.agv_id) + ": " + reason);
    }

    auto [success, message] = schedule_.CompleteAction(leading_action_index_opt.value());
    if(success) {
      // Also complete the action node in exec_state_latest_
      std::tie(success, message) = exec_state_latest_.Apply(node);
      if(success) {
        std::tie(success, message) =
            safety_checker_->CompleteAction(node, exec_state_latest_.GetGarageState());
        // std::cout << "Safety Check completed action: " << std::to_string(node) <<
        // std::endl;
      }
    }

    if(!success) {
      return std::make_pair(false, "Failed to complete " + event.type + ": " + message);
    }
  }
  else if(event.type == "AgvPoseChanged") {
    auto discrete_garage_event_opt = volley::Deserialize<AgvPoseChangedMsg>(event);
    if(!discrete_garage_event_opt.has_value()) {
      return std::make_pair(false, "Failed to deserialize " + event.type + " event");
    }

    auto agv_pose_changed = discrete_garage_event_opt.value();

    // When the VRC carries an AGV between floors, the AGV reports a new node and the tracker emits a
    // pose change whose curr and next node ids belong to the same VRC. That ride is managed by the VRC,
    // not the schedule, so skip schedule completion. Nodes on two different VRCs are a real floor drive.
    // The safety checker still needs this event, though -- otherwise the AGV's tracked occupancy is
    // never cleared from node_id_curr, leaving a stale blocker behind at the VRC entry indefinitely.
    const auto curr_vrc = layout_->GetVrcForNodeId(agv_pose_changed.node_id_curr);
    const auto next_vrc = layout_->GetVrcForNodeId(agv_pose_changed.node_id_next);
    if(curr_vrc.has_value() && next_vrc.has_value() && (curr_vrc->id == next_vrc->id)) {
      auto [success, msg] = safety_checker_->OnEvent(event, exec_state_latest_.GetGarageState());
      if(!success) {
        return std::make_pair(false, "Safety checker detected potential collision: " + msg);
      }
      // apply the new agv pose change even though the schedule is not complete
      std::tie(success, msg) = exec_state_latest_.OnEvent(agv_pose_changed);
      if(!success) {
        return std::make_pair(false, "Failed to apply AgvPoseChanged to exec_state_latest_: " + msg);
      }
      return std::make_pair(true, "");
    }

    auto leading_action_index_opt =
        schedule_.GetLeadingEntityActionIndex(volley::AgvId(agv_pose_changed.agv_id));
    if(!leading_action_index_opt.has_value()) {
      return std::make_pair(false, "Event " + event.type + " corresponds to AGV " +
                                       std::to_string(agv_pose_changed.agv_id) +
                                       " that does not have a leading action");
    }
    if(!schedule_.IsNodeReady(leading_action_index_opt.value())) {
      const auto& blocked_node = schedule_.GetNode(leading_action_index_opt.value());
      std::string parent_info;
      for(auto parent_idx : blocked_node.parents) {
        parent_info += " " + parent_node_str(schedule_, parent_idx);
      }
      return std::make_pair(false, "Event " + event.type +
                                       " for AGV " + std::to_string(agv_pose_changed.agv_id) +
                                       " node:" + std::to_string(agv_pose_changed.node_id_curr) +
                                       " heading:" + std::to_string(agv_pose_changed.heading_curr) +
                                       " -> node:" + std::to_string(agv_pose_changed.node_id_next) +
                                       " heading:" + std::to_string(agv_pose_changed.heading_next) +
                                       ": leading action (index=" +
                                       std::to_string(leading_action_index_opt.value()) +
                                       ") is not ready. Parents:" + parent_info);
    }
    auto leading_node = schedule_.GetNode(leading_action_index_opt.value());
    if(!AgvCommandMatchesAgvEventSource(leading_node.agv_command, agv_pose_changed, *layout_)) {
      const auto& cmd = leading_node.agv_command;
      std::string cmd_str;
      if(cmd.dst.lift != cmd.src.lift) {
        cmd_str = "lift_" + std::string(cmd.dst.lift ? "UP" : "DOWN") +
                  " at " + to_str(cmd.src.pose);
      } else {
        cmd_str = to_str(cmd.src.pose) + "->" + to_str(cmd.dst.pose);
      }
      return std::make_pair(false, "Event " + event.type +
                                       " for AGV " + std::to_string(agv_pose_changed.agv_id) +
                                       " node:" + std::to_string(agv_pose_changed.node_id_curr) +
                                       " heading:" + std::to_string(agv_pose_changed.heading_curr) +
                                       " -> node:" + std::to_string(agv_pose_changed.node_id_next) +
                                       " heading:" + std::to_string(agv_pose_changed.heading_next) +
                                       ": leading action (index=" +
                                       std::to_string(leading_action_index_opt.value()) +
                                       ") source does not match. Leading cmd: " + cmd_str);
    }

    // Since AGV reports are published asynchronously, multiple actions could be completed
    // between reports. So instead of just comparing the event to the leading action, we must
    // compare the event to each action that has been sent to the AGV. Only the leading action
    // can be ready, so we do not check for readiness on successor actions. If an action that
    // matches the event is found, we complete each action up to and including that action
    auto action_index_opt = leading_action_index_opt;
    bool matches_valid_action = false;
    std::vector<int> actions_to_complete;
    while(action_index_opt.has_value()) {
      auto action_index = action_index_opt.value();
      // If this node is not received, it can't match the event
      if(!(schedule_.IsNodeReceived(action_index) || (schedule_.IsNodeReady(action_index)))) {
        break;
      }
      actions_to_complete.push_back(static_cast<int>(action_index));
      auto& action_node = schedule_.GetNode(action_index);
      // Break out of the loop if the event matches this command. If not, move to the
      // successor and keep looking
      if(AgvCommandMatchesAgvEventDestination(action_node.agv_command, agv_pose_changed )) {
        matches_valid_action = true;
        break;
      }

      // Move to successor node
      action_index_opt = schedule_.GetSuccessorEntityActionIndex(action_index);
    }

    if(!matches_valid_action) {
      // Temporary workaround (SW2-275): to avoid failing to validate discrete events for AgvPoseChanged
      // messages that are rotations in the wrong direction, just ignore the mismatch here and wait to
      // validate all rotation action nodes until AGV reaches final heading at this node
      const bool agv_pose_change_is_rotation = agv_pose_changed.node_id_curr == agv_pose_changed.node_id_next;
      if (!agv_pose_change_is_rotation) {
        return std::make_pair(false, "Event " + event.type
          + " node:" + std::to_string(agv_pose_changed.node_id_curr)
          + " heading:" + std::to_string(agv_pose_changed.heading_curr)
          + " next node:" + std::to_string(agv_pose_changed.node_id_next)
          + " next heading:" + std::to_string(agv_pose_changed.heading_next)
          + " does not match any received action for AGV " + std::to_string(agv_pose_changed.agv_id));
      } else {
        WARNS(rclcpp::get_logger("ExecutionState"),
            "Failed to validate AgvPoseChanged event, but ignoring until AGV reaches final heading at node");
      }
    }
    else {
      // Complete and Apply each action node up to and including the matching action
      for(auto index : actions_to_complete) {
        const auto& node = schedule_.GetNode(index);
        auto [success, message] = schedule_.CompleteAction(index);
        if(success) {
          // Also complete the action node in exec_state_latest_
          std::tie(success, message) = exec_state_latest_.Apply(node);
          if(success) {
            std::tie(success, message) =
                safety_checker_->CompleteAction(node, exec_state_latest_.GetGarageState());
          }
        }

        if(!success) {
          return std::make_pair(false, "Failed to complete " + event.type + ": " + message);
        }
      }
    }
  }
  else if(event.type == "AgvStateChanged") {
    // Ignore state change events for disabled AGVs, provided that the AGV does not enter a
    // state in which it might move.
    auto discrete_garage_event_opt = volley::Deserialize<AgvStateChangedMsg>(event);
    if(!discrete_garage_event_opt.has_value()) {
      return std::make_pair(false, "Failed to deserialize " + event.type + " event");
    }

    auto agv_state_changed = discrete_garage_event_opt.value();
    std::optional<DiscreteAgvStateMsg> agv_opt = exec_state_latest_.GetGarageState().GetAgv(agv_state_changed.agv_id);
    if(agv_opt.has_value() && agv_opt->disabled &&
        (agv_state_changed.state_next != AgvReportMsg::STATE_ACTIVE &&
            agv_state_changed.state_next != AgvReportMsg::STATE_JOYSTICK)) {
      // pass.
      // Here we did not diverge, but we also did not update our state
      // In the future, we can choose to update exec_state_latest_ and
      // exec_state_future_. For now, it does not matter.
    }
    else {
      std::string text1 = "Unexpected AgvStateChanged event for a" + std::to_string(agv_state_changed.agv_id);
      std::string text2 = "";
      if(agv_opt.has_value()) {
        if(agv_opt->disabled) {
          text2 += " The AGV is disabled.";
        }
        text2 += " The AGV has state has transitioned from state (" + std::to_string(agv_state_changed.state_curr) + ").";
        text2 += " to disallowed state (" + std::to_string(agv_state_changed.state_next) + ").";
      }
      else {
        text2 = "The AGV was not found in the exec_state_latest_ DiscreteGarageState";
      }
      return std::make_pair(false, text1 + text2);
    }
  }
  else if(event.type == "BayStateChanged") {
    auto discrete_garage_event_opt = volley::Deserialize<BayStateChangedMsg>(event);
    if(!discrete_garage_event_opt.has_value()) {
      return std::make_pair(false, "Failed to deserialize " + event.type + " event");
    }

    auto bay_state_changed = discrete_garage_event_opt.value();
    auto entity_id = volley::BayId(bay_state_changed.bay_id);

    // NOTE: Unlike for AGVs, bay state changes may occur even when there is no leading
    // action, and that is okay. (Though not all state changes are okay.)
    //       A bay in READY_TO_RETRIEVE should never change state on its own.
    //       A bay in READY_TO_INSERT may change state on its own.
    auto leading_action_index_opt = schedule_.GetLeadingEntityActionIndex(entity_id);

    // Determine whether this event was expected
    int bay_event_expectedness = 0;
    if(!leading_action_index_opt.has_value()) {
      // We do not have a leading action.

      // We are fine with any state changes unless the bay is in ready-to-retrieve, or
      // they are state changes into BOOTING or ERROR. However, if the bay has been disabled,
      // the garage should not diverge.
      bay_event_expectedness = 0;
      auto bay_opt = exec_state_latest_.GetGarageState().GetBay(bay_state_changed.bay_id);
      bool bay_disabled = bay_opt.has_value() && bay_opt.value().disabled;
      if((bay_state_changed.state_next == BayReportMsg::STATE_BOOTING ||
             bay_state_changed.state_next == BayReportMsg::STATE_ERROR) &&
          !bay_disabled) {
        bay_event_expectedness = -1;
      }
    }
    else {
      const auto& node = schedule_.GetNode(leading_action_index_opt.value());
      bool is_ready = schedule_.IsNodeReady(leading_action_index_opt.value());
      bay_event_expectedness = BayCommandMatchesBayEvent(node.bay_command, bay_state_changed);

      if(is_ready && bay_event_expectedness == 1) {
        auto [success, message] = schedule_.CompleteAction(leading_action_index_opt.value());
        if(success) {
          // Also complete the action node in exec_state_latest_
          std::tie(success, message) = exec_state_latest_.Apply(node);
          if(success) {
            std::tie(success, message) =
                safety_checker_->CompleteAction(node, exec_state_latest_.GetGarageState());
            // std::cout << "Safety Check completed action: " << std::to_string(node)
            //           << std::endl;
          }
        }

        if(!success) {
          return std::make_pair(false, "Failed to complete " + event.type + ": " + message);
        }
      }
    }

    // We diverge if we had an unexpected event, such as a bay entering the ERROR state
    // Note that if bay_event_expectedness == 0, that we neither diverged nor updated the
    // schedule.
    if(bay_event_expectedness == -1) {
      return std::make_pair(false, "BayStateChanged event to state " +
                                       std::to_string(bay_state_changed.state_next) +
                                       " had a negative expectedness.  i.e. the state change was unexpected.");
    }

    // The predicted future bay state may not match the actual bay state.
    // For example, if we command a transition to insert, the bay may process an insert
    // and end up in READY_TO_RETRIEVE.
    // We thus update the latest and future states if we either (1) had no leading action or (2)
    // had a ready leading action that we completed (in which case we now have no
    // leading action).
    uint8_t future_bay_state =
        exec_state_future_.GetGarageState().GetBay(bay_state_changed.bay_id).value().state;
    if(!schedule_.GetLeadingEntityActionIndex(entity_id).has_value() &&
        future_bay_state != bay_state_changed.state_next) {
      BayStateChangedMsg bay_state_changed_latest = bay_state_changed;
      bay_state_changed_latest.state_curr =
          exec_state_latest_.GetGarageState().GetBay(bay_state_changed.bay_id).value().state;
      auto [success, message] = exec_state_latest_.OnEvent(bay_state_changed_latest);
      if(!success) {
        return std::make_pair(false, "Failed to apply bay state changed to state " +
                                         std::to_string(bay_state_changed.state_next) +
                                         " to our latest state: " + message);
      }

      BayStateChangedMsg bay_state_changed_future = bay_state_changed;
      bay_state_changed_future.state_curr = future_bay_state;
      std::tie(success, message) = exec_state_future_.OnEvent(bay_state_changed_future);
      if(!success) {
        return std::make_pair(false, "Failed to apply bay state changed to state " +
                                         std::to_string(bay_state_changed.state_next) +
                                         " to our future state: " + message);
      }
    }
  }
  else if(event.type == "PayloadExistenceChanged") {
    auto discrete_garage_event_opt = volley::Deserialize<PayloadExistenceChangedMsg>(event);
    if(!discrete_garage_event_opt.has_value()) {
      return std::make_pair(false, "Failed to deserialize event of type " + event.type);
    }

    auto payload_existence_changed = discrete_garage_event_opt.value();

    // Ensure that this event occurred in a bay
    const auto& state_latest = exec_state_latest_.GetGarageState();
    auto tray_opt = state_latest.GetTray(payload_existence_changed.tray_id);
    if(!tray_opt.has_value() || !state_latest.GetBay(tray_opt->pose.node_id).has_value()) {
      return std::make_pair(false,
          "Payload existence changed (added: " + std::to_string(payload_existence_changed.added) +
              ") to a tray (t" + std::to_string(payload_existence_changed.tray_id) + ") not in a bay!");
    }

    // Update our latest state
    auto [success, message] = exec_state_latest_.OnEvent(payload_existence_changed);
    if(!success) {
      return std::make_pair(false, "Failed to apply payload existence changed (added: " +
                                       std::to_string(payload_existence_changed.added) + ") to t" +
                                       std::to_string(payload_existence_changed.tray_id) +
                                       " to our latest state: " + message);
    }

    // Update our future state
    std::tie(success, message) = exec_state_future_.OnEvent(payload_existence_changed);
    if(!success) {
      return std::make_pair(false, "Failed to apply payload existence changed (added: " +
                                       std::to_string(payload_existence_changed.added) + ") to t" +
                                       std::to_string(payload_existence_changed.tray_id) +
                                       " to our future state: " + message);
    }
  }
  else if(event.type == "VecsStateChanged") {
    auto discrete_garage_event_opt = volley::Deserialize<VecsStateChangedMsg>(event);
    if(!discrete_garage_event_opt.has_value()) {
      return std::make_pair(false, "Failed to deserialize " + event.type + " event");
    }

    auto vecs_state_changed = discrete_garage_event_opt.value();

    auto entity_id = volley::VecsId(vecs_state_changed.vecs_id);
    auto leading_action_index_opt = schedule_.GetLeadingEntityActionIndex(entity_id);

    // Determine whether this event was expected
    int vecs_event_expectedness = 0;
    if(!leading_action_index_opt.has_value()) {
      // We do not have a leading action. VECS should not be transitioning
      vecs_event_expectedness = -1;
    }
    else {
      const auto& node = schedule_.GetNode(leading_action_index_opt.value());
      bool is_ready = schedule_.IsNodeReady(leading_action_index_opt.value());
      vecs_event_expectedness = VecsCommandMatchesVecsEvent(node.vecs_command, vecs_state_changed);

      if(is_ready && vecs_event_expectedness == 1) {
        auto [success, message] = schedule_.CompleteAction(leading_action_index_opt.value());
        if(success) {
          // Also complete the action node in exec_state_latest_
          std::tie(success, message) = exec_state_latest_.Apply(node);
          // TODO(some poor soul) add to safety checker
          //                    if (success) {
          //                        std::tie(success, message) =
          //                        safety_checker_->CompleteAction(
          //                            node, exec_state_latest_.GetGarageState());
          //                    }
        }

        if(!success) {
          return std::make_pair(false, "Failed to complete " + event.type + ": " + message);
        }
      }
      else if(vecs_event_expectedness == 0) {
        auto [success, message] = exec_state_latest_.OnEvent(vecs_state_changed);
        if(!success) {
          return std::make_pair(false, "Failed to apply " + event.type + " to latest state: " + message);
        }
      }
    }

    // We diverge if we had an unexpected event, such as a VECS entering the ERROR state
    // Note that if vecs_event_expectedness == 0, that we neither diverged nor updated the
    // schedule.
    if(vecs_event_expectedness == -1) {
      return std::make_pair(false, "VecsStateChanged event to state " +
                                       std::to_string(vecs_state_changed.state_next) +
                                       " had a negative expectedness");
    }
  }
  else if(event.type == "VrcStateChanged") {
    auto discrete_garage_event_opt = volley::Deserialize<VrcStateChangedMsg>(event);
    if(!discrete_garage_event_opt.has_value()) {
      return std::make_pair(false, "Failed to deserialize " + event.type + " event");
    }

    auto vrc_state_changed = discrete_garage_event_opt.value();
    auto entity_id = volley::VrcId(vrc_state_changed.current_discrete_state.id);
    auto leading_action_index_opt = schedule_.GetLeadingEntityActionIndex(entity_id);

    // Determine whether this event was expected
    int vrc_event_expectedness = 0;
    if(!leading_action_index_opt.has_value()) {
      // We do not have a leading action. VRC should not be transitioning
      vrc_event_expectedness = -1;
    }
    else {
      const auto& node = schedule_.GetNode(leading_action_index_opt.value());
      bool is_ready = schedule_.IsNodeReady(leading_action_index_opt.value());
      vrc_event_expectedness = VrcCommandMatchesVrcEvent(node.vrc_command, vrc_state_changed);

      if(is_ready && vrc_event_expectedness == 1) {
        INFOF(rclcpp::get_logger("ExecutionState"),
            "VrcStateChanged completed action for vrc%d: state %d -> %d (command_id=%s requested_floor=%d)",
            vrc_state_changed.current_discrete_state.id,
            static_cast<int>(vrc_state_changed.current_discrete_state.state.value),
            static_cast<int>(vrc_state_changed.next_discrete_state.state.value),
            node.vrc_command.command_id.c_str(),
            node.vrc_command.requested_floor);
        auto [success, message] = schedule_.CompleteAction(leading_action_index_opt.value());
        if(success) {
          // Also complete the action node in exec_state_latest_
          std::tie(success, message) = exec_state_latest_.Apply(node);
        }

        if(!success) {
          return std::make_pair(false, "Failed to complete " + event.type + ": " + message);
        }

        INFOF(rclcpp::get_logger("ExecutionState"),
            "Completed leading VRC action: vrc%d node_index=%d command_id=%s requested_floor=%d",
            vrc_state_changed.current_discrete_state.id,
            leading_action_index_opt.value(),
            node.vrc_command.command_id.c_str(),
            node.vrc_command.requested_floor);
      }
      else if(vrc_event_expectedness == 0) {
        auto [success, message] = exec_state_latest_.OnEvent(vrc_state_changed);
        if(!success) {
          return std::make_pair(false, "Failed to apply " + event.type + " to latest state: " + message);
        }
      }
    }

    if(vrc_event_expectedness == -1) {
      return std::make_pair(false, "VrcStateChanged event to state " +
                                       std::to_string(vrc_state_changed.next_discrete_state.state.value) +
                                       " had a negative expectedness");
    }
  }
  else if(event.type == "TrayPoseSetManually") {
    auto discrete_garage_event_opt = volley::Deserialize<TrayPoseSetManuallyMsg>(event);
    if(!discrete_garage_event_opt.has_value()) {
      return std::make_pair(false, "Failed to deserialize " + event.type + " event");
    }

    // Never corresponds to a schedule action node -- either a manual recovery override, or a
    // tray riding a VRC on its own with no AGV to cascade the move through. Apply directly to
    // keep exec_state_latest_ in sync with the live garage state.
    auto tray_pose_set_manually = discrete_garage_event_opt.value();
    auto [success, message] = exec_state_latest_.OnEvent(tray_pose_set_manually);
    if(!success) {
      return std::make_pair(false, "Failed to apply TrayPoseSetManually to exec_state_latest_: " + message);
    }
  }
  else {
    return std::make_pair(false, "Unexpected event of type " + event.type);
  }

  auto [success, msg] = safety_checker_->OnEvent(event, exec_state_latest_.GetGarageState());

  if(!success) {
    return std::make_pair(false, "Safety checker detected potential collision: " + msg);
  }

  // Success
  return std::make_pair(true, "");
}

}  // namespace volley
</file>

<file path="src/garage_monitor_component.cpp">
#include <central/garage_monitor_ros.hpp>
#include <common_ros/component.hpp>

namespace central {
using namespace volley;
using namespace std::chrono_literals;

class GarageMonitorComponent : public volley::Component {
public:
  explicit GarageMonitorComponent(const rclcpp::NodeOptions& options) {
    auto node = std::make_shared<volley::Node>("garage_monitor", options);

    int status_period_ms = 10000;

    try {
      status_period_ms = node->Param<int>("garage_monitor.status_period_ms");
    }
    catch(const std::exception& exception) {
      // Catch all parameter related exceptions. No reason to continue on if we can't read our
      // parameters properly.
      std::cerr << "Exception: " << exception.what() << std::endl;
      exit(1);
    }

    garage_monitor_ = std::make_unique<GarageMonitorRos>(node, status_period_ms * 1ms);

    SetNode(node);
  }

private:
  std::unique_ptr<GarageMonitorRos> garage_monitor_;
};

}  // namespace central

#include <rclcpp_components/register_node_macro.hpp>
RCLCPP_COMPONENTS_REGISTER_NODE(central::GarageMonitorComponent)
</file>

<file path="src/garage_monitor_ros.cpp">
#include <central/central_msgs.hpp>
#include <central/garage_monitor_ros.hpp>
#include <common/topics_central.hpp>
#include <common_ros/ros_utils.hpp>

namespace volley {

GarageMonitorRos::GarageMonitorRos(NodeSPtr node, std::chrono::milliseconds status_period_ms) : node_(node) {
  garage_monitor_ = std::make_unique<GarageMonitor>(node->get_logger());

  // clang-format off

    continuous_garage_info_sub_ = node->create_subscription<ContinuousGarageInfoMsg>(
        volley::TopicCentralContinousGarageInfo().Name(), volley::GetBestEffortQoS(1),
        [this](ContinuousGarageInfoMsg::UniquePtr msg) {
            garage_monitor_->ReadContinuousGarageInfo(std::move(msg));
        });

    dispatch_report_sub_ = node_->create_subscription<DispatchReportMsg>(
        volley::TopicCentralReport().Name(), volley::GetBestEffortQoS(1),
        [this](DispatchReportMsg::UniquePtr msg) {
            garage_monitor_->ReadDispatchReport(std::move(msg));
        });

    status_report_pub_ = node_->CreatePub<GarageStatusReportMsg>(volley::TopicCentralGarageStatus());

    main_timer_ = node_->create_timer(status_period_ms, [this]() { Tick(); });

  // clang-format on
}

void GarageMonitorRos::Tick() {
  auto report =
      std::make_unique<GarageStatusReportMsg>(garage_monitor_->GenerateGarageStatusReport(node_->now()));

  report->header.stamp = node_->now();
  status_report_pub_->publish(std::move(report));
}

}  // namespace volley
</file>

<file path="src/garage_monitor.cpp">
#include <algorithm>
#include <central/garage_monitor.hpp>
#include <common_ros/ros_utils.hpp>
#include <common_ros/roslog.hpp>

namespace volley {

using namespace std::chrono_literals;
// Maximum allowed staleness in seconds for the DispatchReport.
constexpr auto kMaxDispatchReportStaleness = 3s;

// Maximum allowed staleness (float32) in seconds for AGV report in ContinuousAgvInfo.msg.
constexpr float kMaxAgvStaleness = 3.0f;

// Maximum allowed staleness (float32) in seconds for Bay report in ContinuousBayInfo.msg.
constexpr float kMaxBayStaleness = 3.0f;

GarageMonitor::GarageMonitor(const rclcpp::Logger& logger) : logger_(logger) {
}

// Use the latest information from the DispatchReport and ContinuousGarageInfo to determine if the
// garage should be considered "up" or not and return that information in a GarageStatusReport.
GarageStatusReportMsg GarageMonitor::GenerateGarageStatusReport(const rclcpp::Time& now) {
  GarageStatusReportMsg report {};

  auto [garage_up, reason] = CalculateGarageStatusForReport(now);
  report.garage_up = garage_up;
  report.reason = reason;
  UpdateCurrentGarageStatus(report.garage_up, now, report.reason);
  report.in_auto_mode = scheduler_auto_;

  auto [uptime_seconds, downtime_seconds] = CalculateUptimeAndDowntimeForReport(now);
  report.uptime_seconds = uptime_seconds;
  report.downtime_seconds = downtime_seconds;

  u_int8_t active_agv_count = 0;
  for(const auto& pair : agv_status_) {
    report.agv_ids.push_back(pair.first);
    report.agv_statuses.push_back(pair.second);
    if(pair.second) {
      active_agv_count++;
    }
  }
  report.active_agv_count = active_agv_count;

  u_int8_t active_bay_count = 0;
  for(const auto& pair : bay_status_) {
    report.bay_ids.push_back(pair.first);
    report.bay_statuses.push_back(pair.second);
    if(pair.second) {
      active_bay_count++;
    }
  }
  report.active_bay_count = active_bay_count;

  return report;
}

// Reads AGV and bay reports from ContinuousGarageInfo and determines if the AGVs and bays are
// active or not.
void GarageMonitor::ReadContinuousGarageInfo(ContinuousGarageInfoMsg::UniquePtr msg) {
  received_continuous_garage_info_ = true;

  for(const auto& agv_info : msg->agvs) {
    if(agv_info.report.state == AgvReportMsg::STATE_ACTIVE && agv_info.staleness <= kMaxAgvStaleness) {
      agv_status_[agv_info.report.agv_id] = true;
    }
    else {
      agv_status_[agv_info.report.agv_id] = false;
    }
  }

  for(const auto& bay_info : msg->bays) {
    switch(bay_info.report.state) {
    case BayReportMsg::STATE_BOOTING:
    case BayReportMsg::STATE_DOOR_VALIDATION:
    case BayReportMsg::STATE_ERROR:
      bay_status_[bay_info.report.bay_id] = false;
      break;
    default:
      bay_status_[bay_info.report.bay_id] = bay_info.staleness <= kMaxBayStaleness ? true : false;
    }
  }

  return;
}

// Stores relevant information from the dispatch report. This is the callback for the dispatch
// subscriber in GarageMonitorRos.
void GarageMonitor::ReadDispatchReport(DispatchReportMsg::UniquePtr msg) {
  last_dispatch_report_header_ = msg->header;
  scheduler_running_ =
      msg->status == DispatchReportMsg::STATUS_RUNNING || msg->status == DispatchReportMsg::STATUS_PAUSED;
  scheduler_auto_ = msg->mode == DispatchReportMsg::MODE_AUTO;

  return;
}

// Determines if the garage should be considered up or not and writes it to the report. If the
// garage is not up, the reason is written to the report.
BoolStringPair GarageMonitor::CalculateGarageStatusForReport(const rclcpp::Time& now) const {
  // Assume the garage is up unless disproven below.
  bool garage_up = true;
  std::string reason = "";

  // If we have not received a DispatchReport and/or ContinuousGarageInfo, the garage is down.
  if(!last_dispatch_report_header_.has_value() || !received_continuous_garage_info_) {
    garage_up = false;
    reason = std::string("Missing required data: ") +
             (last_dispatch_report_header_.has_value() ? "" : "DispatchReport ") +
             (received_continuous_garage_info_ ? "" : "ContinuousGarageInfo");
  }
  else {
    // If the latest DispatchReport is too stale, the garage is down.
    if(volley::GetMessageStaleness(last_dispatch_report_header_.value(), now) > kMaxDispatchReportStaleness) {
      garage_up = false;
      reason += "DispatchReport is stale;";
    }
    else if(!scheduler_running_) {
      // If the DispatchReport is not stale, but the scheduler is not running, the garage is
      // down.
      garage_up = false;
      reason += "Scheduler not running;";
    }
  }

  return std::make_pair(garage_up, reason);
}

// Updates the variables tracking the current garage up status and when it last changed.
void GarageMonitor::UpdateCurrentGarageStatus(
    const bool garage_up, const rclcpp::Time& now, const std::string& reason) {
  // If garage_up_ does not yet have a value, or if its value is different from the newest
  // status, store the new up status and the time that it changed.
  if(!garage_up_.has_value() || garage_up_.value() != garage_up) {
    garage_up_ = garage_up;
    garage_status_changed_at_ = now;

    auto info_str =
        std::string("Garage status changed to ") + (garage_up_.value() ? "UP" : "DOWN, because " + reason);
    INFOS(logger_, info_str);
  }

  return;
}

// Computes the current consecutive uptime or downtime and puts it in the report.
std::pair<uint32_t, uint32_t> GarageMonitor::CalculateUptimeAndDowntimeForReport(
    const rclcpp::Time& now) const {
  uint32_t uptime_seconds = 0;
  uint32_t downtime_seconds = 0;

  if(garage_status_changed_at_.has_value() && garage_up_.has_value()) {
    auto time_difference_seconds =
        (now - garage_status_changed_at_.value()).nanoseconds() / static_cast<uint64_t>(1e9);
    if(garage_up_.value()) {
      uptime_seconds = static_cast<uint32_t>(time_difference_seconds);
    }
    else {
      downtime_seconds = static_cast<uint32_t>(time_difference_seconds);
    }
  }

  return std::make_pair(uptime_seconds, downtime_seconds);
}

}  // namespace volley
