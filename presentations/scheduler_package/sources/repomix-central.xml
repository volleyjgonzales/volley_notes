void GarageTracker::SetAgvDisablednessSrvCallback(SetResourceDisablednessSrv::Request::SharedPtr request,
    SetResourceDisablednessSrv::Response::SharedPtr response) {
  INFOS(logger_, "Received request to set AGV a" << std::to_string(request->resource_id)
                                                 << " disabledness to " << std::boolalpha
                                                 << request->disable);

  AgvDisablednessChangedMsg agv_disabledness_changed {};
  agv_disabledness_changed.agv_id = request->resource_id;
  agv_disabledness_changed.disable = request->disable;

  // Apply the event
  // Note that this can fail, such as when the AGV is already in the desired state
  std::tie(response->success, response->message) = ApplyAndPublishEvent(agv_disabledness_changed, false);
}

void GarageTracker::SetNodeDisablednessSrvCallback(SetResourceDisablednessSrv::Request::SharedPtr request,
    SetResourceDisablednessSrv::Response::SharedPtr response) {
  INFOS(logger_, "Received request to set node " << std::to_string(request->resource_id)
                                                 << " disabledness to " << std::boolalpha
                                                 << request->disable);

  // Don't do anything if the node doesn't exist
  if(!layout_->HasNode(request->resource_id)) {
    response->success = false;
    response->message = "Failed to disable node: Node " + std::to_string(request->resource_id) +
                        " does not exist in the layout";
    return;
  }

  NodeDisablednessChangedMsg node_disabledness_changed {};
  node_disabledness_changed.node_id = request->resource_id;
  node_disabledness_changed.disable = request->disable;

  // Apply the event
  // Note that this can fail, such as when the node is already in the desired state
  std::tie(response->success, response->message) = ApplyAndPublishEvent(node_disabledness_changed, false);

  if(!response->success) {
    return;
  }

  // If the node disabling was successful and this is a VECS or bay node, disable that as well
  if(layout_->GetNodeById(request->resource_id)->type == GarageNodeMsg::TYPE_EV_CHARGE) {
    SetVecsDisablednessSrvCallback(request, response);
  }
  if(layout_->GetNodeById(request->resource_id)->type != GarageNodeMsg::TYPE_BAY) {
    return;
  }

  INFOS(logger_, "Received request to set bay b" << std::to_string(request->resource_id)
                                                 << " disabledness to " << std::boolalpha
                                                 << request->disable);

  BayDisablednessChangedMsg bay_disabledness_changed {};
  bay_disabledness_changed.bay_id = request->resource_id;
  bay_disabledness_changed.disable = request->disable;

  // Apply the event
  // Note that this can fail, such as when the bay is already in the desired state
  std::tie(response->success, response->message) = ApplyAndPublishEvent(bay_disabledness_changed, false);

  // If we aren't able to disable the bay, undo the node disabling
  if(!response->success) {
    ApplyAndPublishEvent(volley::Reverse(node_disabledness_changed), false);
  }
}

