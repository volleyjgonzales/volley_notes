<file path="include/central/consistency_monitor.hpp">
#pragma once

#include <central/central_msgs.hpp>
#include <common_ros/roslog.hpp>
#include <functional>
#include <map>
#include <optional>
#include <rclcpp/time.hpp>
#include <string>
#include <vector>

namespace volley {

/*
The Consistency Monitor node provides the all-clear signal to the dispatcher prior to startup
to ensure that all garage entities have matching software versions.
If all information is obtained and the software versions all match (including the dispatcher
software version), the consistency monitor will issue an all clear to the dispatcher. If any
versions do not match, then the consistency monitor will not clear the dispatcher to start. The
dispatcher will not allow starting unless it receives an all-clear from the consistency monitor.
*/
class ConsistencyMonitor {
public:
  ConsistencyMonitor(
      const std::function<void(const std::string&, const std::optional<std::string>&)>& change_subscription,
      const rclcpp::Logger& logger) :
      change_subscription_(change_subscription), logger_(logger) { }

  void DiscreteGarageStateCallback(DiscreteGarageStateMsg::UniquePtr garage_state);
  void SetVersionInfo(VersionInfoMsg::UniquePtr version_info);

  // Check if we are consistent. To be consistent, all entities must have the same version and all
  // version info messages must be recent.
  bool IsConsistent(const rclcpp::Time& now) const;
  std::vector<std::string> GetEntityNames();

private:
  // If entity_name is not already a key in version_infos_, create an entry for it.
  void AddVersionInfo(const std::string& entity_name, const std::string& topic_name);

  // Function for adding or removing an entity ros subscription. If the topic name is empty, the
  // subscription should be dropped.
  std::function<void(const std::string&, const std::optional<std::string>&)> change_subscription_;

  // The latest version info messages by entity name
  std::map<std::string, VersionInfoMsg> version_infos_;

  // The time each currently-missing entity was first observed missing a version info, so we can
  // report how long we've been waiting on it. Mutated from the const IsConsistent() since it's
  // purely a diagnostic cache and not part of consistency state.
  mutable std::map<std::string, rclcpp::Time> missing_since_;

  rclcpp::Logger logger_;
};

}  // namespace volley
</file>

<file path="include/central/dispatch_jobs.hpp">
#pragma once

#include <boost/variant.hpp>
#include <central/central_msgs.hpp>
#include <common_ros/pose_utils.hpp>
#include <common_ros/print_utils.hpp>
#include <common_ros/ros_utils.hpp>
#include <limits>
#include <rclcpp/time.hpp>

namespace volley {

// Jobs can be in one of several states
// SUCCESS and ERROR are terminal states.
enum class JobState : uint8_t {
  UNPLANNED = SchedulerJobMsg::STATE_UNPLANNED,
  EXECUTING = SchedulerJobMsg::STATE_EXECUTING,
  SUCCESS = SchedulerJobMsg::STATE_SUCCESS,
  ERROR = SchedulerJobMsg::STATE_ERROR,
};

class Job {
public:
  Job(const GuidMsg& guid, const rclcpp::Time& time_registered);

  // Child classes call destructors, thus requiring a virtual destructor here. In turn, because we
  // define a destructor, this class needs all other move, copy, and assignment constructors
  // defined as well.
  Job() = default;
  virtual ~Job() = default;
  Job(Job const&) = default;
  Job& operator=(Job const&) = default;
  Job(Job&&) = default;
  Job& operator=(Job&&) = default;

  // True if the job is in a terminal state
  bool IsInTerminalState() const;

  // Getters
  virtual uint8_t GetType() const = 0;
  virtual std::string GetName() const = 0;
  const GuidMsg& GetGuid() const { return guid_; }
  JobState GetState() const { return state_; }
  const std::string& GetNote() const { return note_; }
  const bool& GetShouldBePlanned() const { return should_be_planned_; }
  const rclcpp::Time& GetTimeRegistered() const { return time_registered_; }
  const rclcpp::Time& GetTimePlanned() const { return time_planned_; }
  const rclcpp::Time& GetTimeCompleted() const { return time_completed_; }
  const std::vector<GuidMsg>& GetExecutionNodesToComplete() const { return execution_nodes_to_complete_; }

  // Public setters
  void SetNote(const std::string& note) { note_ = note; }
  void SetShouldBePlanned(const bool& should_be_planned) { should_be_planned_ = should_be_planned; }
  void SetExecutionNodesToComplete(const std::vector<GuidMsg>& execution_nodes_to_complete) {
    execution_nodes_to_complete_ = execution_nodes_to_complete;
  }

  // Convert this base class to a ROS message
  virtual SchedulerJobMsg ToRos() const;

  // Advance the job to the EXECUTING state
  virtual void OnExecuting(const rclcpp::Time& time);

  // Advance the job to the SUCCESS state
  virtual void OnSuccess(const rclcpp::Time& time);

  // Advance the job to the ERROR state
  virtual void OnError(const rclcpp::Time& time);

  // Get a string with the relevant information (e.g. AGV ID for a ChargeAGV Job)
  // for printing when the job fails to plan
  virtual std::string GetPrintInfo() const { return ""; }

private:
  // A unique identifier
  GuidMsg guid_;

  // The job's planning state
  JobState state_ {};

  // The planner may include information on why a job failed to plan
  std::string note_;

  // The GUIDs for all execution action nodes that must be completed
  // in order for this active job to be completed.
  std::vector<GuidMsg> execution_nodes_to_complete_;

  // If true, the job should be given to the planner. Only relevant for pending jobs
  bool should_be_planned_ = false;

  // When the job was received by the dispatcher
  rclcpp::Time time_registered_;

  // When the job was moved to executing
  rclcpp::Time time_planned_ = rclcpp::Time(0, 0);

  // When the job was terminated (succeeded or failed)
  rclcpp::Time time_completed_ = rclcpp::Time(0, 0);
};

// A charge AGV job sends a specific AGV to a charge node.
// This job will violate our garage invariants, because the AGV will not be on a stay node. As such,
// these jobs are only expected while the garage is idle in AUTO mode.
// Today these jobs cannot be submitted externally, and are only produced by the dispatcher.
