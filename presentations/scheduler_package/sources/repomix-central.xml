namespace volley {

// Check whether the given lift changed event matches the given command sent to an AGV.
bool AgvCommandMatchesAgvEvent(const AgvCommandMsg& agv_command, const AgvLiftChangedMsg& agv_lift_changed);

/// @brief Check whether the event's source node matches the command's source node.
/// @param layout Used to resolve VRC membership: two nodes in the same VRC are treated as equivalent.
bool AgvCommandMatchesAgvEventSource(
    const AgvCommandMsg& agv_command, const AgvPoseChangedMsg& agv_pose_changed, const Layout& layout);

bool AgvCommandMatchesAgvEventDestination(
    const AgvCommandMsg& agv_command, const AgvPoseChangedMsg& agv_pose_changed);

// Check whether the given pose changed event matches the given command sent to an AGV.
bool AgvCommandMatchesAgvEvent(
    const AgvCommandMsg& agv_command, const AgvPoseChangedMsg& agv_pose_changed, const Layout& layout);

// Check whether the given bay state changed event matches the given command sent to the bay.
// We return 1 if they match, indicating that the command was completed.
// We return 0 if the bay state change was expected as part of processing the command, but the
//   command is not yet completed.
// We return -1 if the bay state change was unexpected and indicates divergence.
int BayCommandMatchesBayEvent(const BayCommandMsg& bay_command, const BayStateChangedMsg& bay_state_changed);

// Check whether the given VECS state changed event matches the given command sent to the VECS.
// We return 1 if they match, indicating that the command was completed.
// We return 0 if the VECS state change was expected as part of processing the command, but the
//   command is not yet completed.
// We return -1 if the VECS state change was unexpected and indicates divergence.
int VecsCommandMatchesVecsEvent(
    const VecsCommandMsg& vecs_command, const VecsStateChangedMsg& vecs_state_changed);

// Check whether the given VRC state changed event matches the given command sent to the VRC.
// We return 1 if they match, indicating that the command was completed.
// We return 0 if the VRC state change was expected as part of processing the command, but the
//   command is not yet completed.
// We return -1 if the VRC state change was unexpected and indicates divergence.
int VrcCommandMatchesVrcEvent(const VrcCommandMsg& vrc_command, const VrcStateChangedMsg& vrc_state_changed);

// Checks whether the two GaragePoses match
bool GaragePosesMatch(const GaragePoseMsg& a, const GaragePoseMsg& b);

}  // namespace volley
</file>

<file path="include/central/execution_state.hpp">
#pragma once
#include <central/central_timing.hpp>
#include <central/command_send.hpp>
#include <central/execution_garage_state.hpp>
#include <central/execution_state_util.hpp>
#include <central/schedule.hpp>
#include <central/schedule_execution.hpp>
#include <central/send_ready_agv_adaptor.hpp>
#include <common/constants.hpp>
#include <common/types.hpp>
#include <common_ros/garage_safety_checker.hpp>
#include <common_ros/print_utils.hpp>
#include <common_ros/ros_utils.hpp>
#include <rclcpp/time.hpp>

namespace volley {

using ExecutionStateSPtr = std::shared_ptr<class ExecutionState>;
using ExecutionStateStringPair = std::pair<ExecutionStateSPtr, std::string>;

class ExecutionState {
public:
  // clang-format off
  ExecutionState(
    const ExecutionGarageState& exec_garage_state,
    CommandSendSPtr command_send,
    const volley::GarageGraph& gg,
    const volley::CollisionTable& collision_table
  );
  // clang-format off

  void CoalesceMotionBatches();

  bool IsDiverged() const { return diverged_; }

  const Schedule& GetSchedule() const { return schedule_; }
  const ExecutionGarageState& GetFuture() const { return exec_state_future_; }
  const ExecutionGarageState& GetLatest() const { return exec_state_latest_; }
  std::unordered_map<uint16_t, std::unique_ptr<AgvCommandSequenceMsg>> GetAgvCommandSequences(
      const rclcpp::Time& now) const;

  // Update the execution state with the given garage event. This propagates our latest state,
  // can complete a node in the schedule, or can simply update our latest state.
  // The call returns a boolean indicating whether the update was a success. If it fails, the
  // string will contain a message that describes why it failed.
  // We can fail, for example, if the event is unexpected with respect to our current schedule or
  // garage state.
  // Any failure will cause the execution state to diverge.
  BoolStringPair Update(const DiscreteGarageEventMsg& event);
  BoolStringPair Update(const DiscreteGarageEventStampedMsg& event);

  // Send ready commands
  void SendReadyCommands();

  // Split the schedule into two parts in anticipation of a plan call. The first part is action
  // nodes that can be sent and executed. The second part will not be sent and will be
  // discarded if the plan call is successful.
  void SplitSchedule();

  // Undo the schedule split so that all nodes can be ready
  void UndoSplit();

  // Send ready commands for this bay
  void SendReadyBayCommand(uint16_t bay_id);

  // Send ready commands for this VECS
  void SendReadyVecsCommand(uint16_t vecs_id);

  // Send ready commands for this VRC
  void SendReadyVrcCommand(uint16_t vrc_id);

  // Returns true if the action node is estimated to be sent inside the command send horizon
  bool IsActionInsideCommandHorizon(unsigned int node_index) const;

  // The bulk of the work done by `Update` is done in this.
  BoolStringPair UpdateInternal(const DiscreteGarageEventMsg& event);

private:
  // Whether we diverged from our schedule
  bool diverged_ = false;

  // The schedule
  Schedule schedule_;
  NodeBatchMap startnodebatchmap_;
  NodeBatchMap allnodebatchmap_;


  // The execution garage state tracking our current state
  ExecutionGarageState exec_state_latest_;

  // The execution garage state tracking our future, at the end of the schedule
  ExecutionGarageState exec_state_future_;

  // Sending functions for the AGV and bay commands.
  CommandSendSPtr command_send_;

  // Layout used for VRC virtual-node resolution during event matching.
  LayoutSPtr layout_;

  // Keeps track of the current occupancy state of the entire garage, which
  // is used to only dispatch commands which are known to not cause
  // collisions.
  //
  // Doesn't track "true" state of all events since the execution state is
  // limited to only think about events which occur when dispatch is running.
  std::shared_ptr<volley::GarageSafetyChecker> safety_checker_;

  friend class SendReadyAgvAdaptor;
  std::shared_ptr<SendReadyAgvAdaptor> send_ready_agv_;
  friend class ScheduleExecution;
  std::shared_ptr<ScheduleExecution> schedule_execution_;

public:
  // Log the schedule DAGs. Not high performance, so off by default.
  // Requires: sudo apt-get install libgraph-easy-perl
  mutable bool printdags_ = false;

  friend ExecutionStateStringPair CreateExecutionStatePtr(
      const ExecutionGarageState& exec_state_latest,
      const Schedule& existing_schedule,
      std::vector<ActionNodeMsg> response_nodes,
      CommandSendSPtr command_send,
      const volley::GarageGraph& gg,
      const volley::CollisionTable& collision_table
    );
};


// Construct an empty execution state
ExecutionStateStringPair CreateExecutionStatePtr(const volley::DiscreteGarageState& garage_state,
    PoseGraphCSPtr pose_graph, CommandSendSPtr command_send, const volley::GarageGraph& gg,
    const volley::CollisionTable& collision_table);

// Construct a populated execution state, which builds a future state by applying the given
// action nodes to the given latest state. These nodes must be in a topological order.
// Note that we modify any AGV commands to contain the correct src and dst values.
ExecutionStateStringPair CreateExecutionStatePtr(const ExecutionGarageState& exec_state_latest,
    const Schedule& existing_schedule, std::vector<ActionNodeMsg> response_nodes,
    CommandSendSPtr command_send, const volley::GarageGraph& gg,
    const volley::CollisionTable& collision_table);

}  // namespace volley
</file>

