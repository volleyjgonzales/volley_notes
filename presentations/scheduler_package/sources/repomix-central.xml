namespace volley {

void ScheduleExecution::SendReadyCommands() {
  const auto& state = exeptr_->exec_state_latest_.GetGarageState();

  // Send ready AGV commands
  for(const auto& [agv_id, agv] : state.GetAgvs()) {
    // because of C++ copy and move for the ExecutionState instance, the exeptr_ pointer could be different.
    exeptr_->send_ready_agv_->exeptr_ = exeptr_;
    exeptr_->send_ready_agv_->SendReadyAgvCommand(agv_id);
  }

  // Send ready bay commands
  for(const auto& [bay_id, bay] : state.GetBays()) {
    exeptr_->ExecutionState::SendReadyBayCommand(bay_id);
  }

  // Send ready VECS commands
  for(const auto& [vecs_id, _] : state.GetVexen()) {
    exeptr_->ExecutionState::SendReadyVecsCommand(vecs_id);
  }

  // Send ready VRC commands
  for(const auto& [vrc_id, _] : state.GetVrcs()) {
    exeptr_->ExecutionState::SendReadyVrcCommand(vrc_id);
  }
}

}  // namespace volley
