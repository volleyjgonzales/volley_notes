namespace volley {

AgvMonitorRos::AgvMonitorRos(double low_agv_battery_fraction_threshold, NodeSPtr node) {
  // NOTE: the ordering here is important. We do not want to subscribe to the topics before the
  // underlying monitor is constructed.

  // Service clients
  set_agv_disabledness_cli_ =
      node->create_client<SetResourceDisablednessSrv>("/central/set_agv_disabledness");

  // Create the monitor class
  agv_monitor_ = std::make_unique<AgvMonitor>(
      low_agv_battery_fraction_threshold,
      [this](SetResourceDisablednessSrv::Request::SharedPtr request) {
        set_agv_disabledness_cli_->async_send_request(request);
      },
      node->get_logger());

  // Subscriptions
  continuous_garage_info_sub_ =
      node->create_subscription<ContinuousGarageInfoMsg>(volley::TopicCentralContinousGarageInfo().Name(),
          volley::GetBestEffortQoS(1), [this](ContinuousGarageInfoMsg::UniquePtr msg) {
            agv_monitor_->SetContinuousGarageInfo(std::move(msg));
          });
  discrete_garage_state_sub_ =
      node->create_subscription<DiscreteGarageStateMsg>(volley::TopicCentralDiscreteGarageState().Name(),
          volley::GetBestEffortQoS(1), [this](DiscreteGarageStateMsg::UniquePtr msg) {
            agv_monitor_->SetDiscreteGarageState(std::move(msg));
          });
}

}  // namespace volley
