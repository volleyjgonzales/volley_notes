<file path="src/execution_state_util.cpp">
#include <central/execution_state_util.hpp>
#include <common_ros/layout.hpp>
#include <vrc_interfaces/msg/vrc_state.hpp>

#include "vrc_interfaces/msg/vrc_state.hpp"

namespace volley {

bool AgvCommandMatchesAgvEvent(const AgvCommandMsg& agv_command, const AgvLiftChangedMsg& agv_lift_changed) {
  bool command_is_lift_change = (agv_command.src.lift != agv_command.dst.lift);
  return command_is_lift_change && agv_lift_changed.raised == agv_command.dst.lift;
}

bool AgvCommandMatchesAgvEventSource(
    const AgvCommandMsg& agv_command, const AgvPoseChangedMsg& agv_pose_changed, const Layout& layout) {
  bool command_is_pose_change = (agv_command.src.pose != agv_command.dst.pose);
  if(!command_is_pose_change) {
    return false;
  }

  const uint32_t event_node = agv_pose_changed.node_id_curr;
  const uint32_t cmd_src_node = agv_command.src.pose.node_id;
  if(event_node == cmd_src_node) {
    return true;
  }

  // The AGV reports a new node after the VRC carries it between floors. Both the reported node
  // and the command's source node belong to the same VRC, so accept that as the source match.
  const auto event_vrc = layout.GetVrcForNodeId(event_node);
  const auto cmd_vrc = layout.GetVrcForNodeId(cmd_src_node);
  return event_vrc.has_value() && cmd_vrc.has_value() && event_vrc->id == cmd_vrc->id;
}

bool AgvCommandMatchesAgvEventDestination(
    const AgvCommandMsg& agv_command, const AgvPoseChangedMsg& agv_pose_changed) {
  bool command_is_pose_change = (agv_command.src.pose != agv_command.dst.pose);
  return command_is_pose_change && agv_pose_changed.node_id_next == agv_command.dst.pose.node_id &&
         agv_pose_changed.heading_next == agv_command.dst.pose.heading;
}

bool AgvCommandMatchesAgvEvent(
    const AgvCommandMsg& agv_command, const AgvPoseChangedMsg& agv_pose_changed, const Layout& layout) {
  bool command_is_pose_change = (agv_command.src.pose != agv_command.dst.pose);
  bool matches_source = AgvCommandMatchesAgvEventSource(agv_command, agv_pose_changed, layout);
  bool matches_dest = AgvCommandMatchesAgvEventDestination(agv_command, agv_pose_changed);
  return command_is_pose_change && matches_source && matches_dest;
}

int BayCommandMatchesBayEvent(const BayCommandMsg& bay_command, const BayStateChangedMsg& bay_state_changed) {
  // Determine based on the command type
  uint8_t state_next = bay_state_changed.state_next;
  uint8_t command_type = bay_command.command_type;
  if(command_type == BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE) {
    if(state_next == BayReportMsg::STATE_READY_TO_RETRIEVE ||
        state_next == BayReportMsg::STATE_VEHICLE_INSERTED) {
      return 1;
    }
    else if(state_next == BayReportMsg::STATE_TRANSITIONING_TO_RETRIEVE ||
            state_next == BayReportMsg::STATE_PROCESSING_INSERT) {
      // NOTE: We allow for PROCESSING_INSERT here. This occurs when there is a race
      //       condition, and we plan to swap a bay over to ready-to-retrieve but a
      //       customer arrives and triggers the processing-insert instead. The
      //       end result is the same (except now a payload will be on the tray),
      //       so we allow it.
      return 0;
    }
    else {
      return -1;
    }
  }
  else if(command_type == BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT) {
    if(state_next == BayReportMsg::STATE_READY_TO_INSERT ||
        state_next == BayReportMsg::STATE_PROCESSING_INSERT) {
      // Processing insert is also ok here because a waiting customer can trigger an insert
      // nearly instantly and so the dispatcher may never see the ready_to_insert state.
      return 1;
    }
    else if(state_next == BayReportMsg::STATE_TRANSITIONING_TO_INSERT) {
      return 0;
    }
    else {
      return -1;
    }
  }
  else if(command_type == BayCommandMsg::COMMAND_TYPE_PROCESS_RETRIEVE) {
    // We complete the command in either READY_TO_RETRIEVE or READY_TO_INSERT.
    if(state_next == BayReportMsg::STATE_READY_TO_INSERT ||
        state_next == BayReportMsg::STATE_READY_TO_RETRIEVE ||
        state_next == BayReportMsg::STATE_VEHICLE_INSERTED) {
      return 1;
    }
    else if(state_next == BayReportMsg::STATE_PROCESSING_RETRIEVE) {
      return 0;
    }
    else {
      return -1;
    }
  }
  return 0;
}

int VecsCommandMatchesVecsEvent(
    const VecsCommandMsg& vecs_command, const VecsStateChangedMsg& vecs_state_changed) {
  // Determine based on the command type
  uint8_t state_next = vecs_state_changed.state_next;
  uint8_t command_type = vecs_command.command_type;
  if(command_type == VecsCommandMsg::COMMAND_TYPE_START_CHARGING) {
    if(state_next == VecsReportMsg::CHARGING) {
      // Only complete the command once it's CHARGING
      return 1;
    }
    else if(state_next == VecsReportMsg::ATTACHING_ADAPTER) {
      // ATTACHING_ADAPTER is allowed as an intermediate stage
      return 0;
    }
  }
  else if(command_type == VecsCommandMsg::COMMAND_TYPE_STOP_CHARGING) {
    if(state_next == VecsReportMsg::READY_TO_CHARGE) {
      // Only complete the command once it's READY_TO_CHARGE
      return 1;
    }
    else if(state_next == VecsReportMsg::DETACHING_ADAPTER) {
      // DETACHING_ADAPTER is allowed as an intermediate stage
      return 0;
    }
  }

  // Anything else is no bueno
  return -1;
}

int VrcCommandMatchesVrcEvent(const VrcCommandMsg& vrc_command, const VrcStateChangedMsg& vrc_state_changed) {
  vrc_interfaces::msg::VrcState next_state = vrc_state_changed.next_discrete_state.state;
  if(next_state.value == vrc_interfaces::msg::VrcState::STATE_IDLE &&
      vrc_state_changed.next_discrete_state.current_floor == vrc_command.requested_floor) {
    return 1;  // Command complete: VRC is idle at the requested floor
  }
  else if(next_state.value == vrc_interfaces::msg::VrcState::STATE_MOVING) {
    return 0;  // Command in progress: VRC is moving
  }
  return -1;  // Unexpected state change
}

bool GaragePosesMatch(const GaragePoseMsg& a, const GaragePoseMsg& b) {
  bool node_ids_match = a.node_id == b.node_id;
  bool headings_match = volley::IsNearToAngleOrReciprocal(a.heading * kDeg2Rad, b.heading * kDeg2Rad);
  return node_ids_match && headings_match;
}

}  // namespace volley
