#include <getopt.h>
#include <unistd.h>

#include <central/garage_tracker_recovery_args.hpp>
#include <common/enum.hpp>
#include <iostream>
#include <regex>
#include <sstream>
#include <tuple>
#include <unordered_map>
#include <vector>

namespace volley {

// Command line options and their associated help strings, reused by one or more options
// across commands.
constexpr struct option kVersionOpt = {"version", required_argument, nullptr, 'v'};
constexpr struct option kStateOpt = {"state-yaml", required_argument, nullptr, 's'};
constexpr struct option kDBOpt = {"db-params", required_argument, nullptr, 'd'};
constexpr struct option kHelpOpt = {"help", no_argument, nullptr, 'h'};
constexpr struct option kOutputOpt = {"output", required_argument, nullptr, 'o'};
constexpr struct option kTerminal = {nullptr, 0, nullptr, 0};

constexpr const char* kVersionStr = "Discrete garage state encoding version to upload.";
constexpr const char* kStateStr =
    "Yaml encoded discrete garage state to be parsed, validated, and uploaded to mysql";
constexpr const char* kDBStr =
    "Garage database parameters, in the format of user:password@hostname:port/database";
constexpr const char* kHelpStr = "Display this message.";
constexpr const char* kOutputStr =
    "Outuput file to save latest discrete garage state yaml representation to. Will contain\n"
    "\tannotations if it cannot be parsed into a discrete garage state";

constexpr unsigned kMysqlDefaultPort = 3306u;

// Map command to long arguments accepted
// Clang format messes up the brackets and makes this map unreadable
// clang-format off
const std::unordered_map<
    Command,
    std::tuple<std::vector<struct option>, std::vector<std::string>, const char*>>
    kCommandToOpts = {
        {
            Command::UPLOAD,
            {
                {
                    kVersionOpt,
                    kStateOpt,
                    kDBOpt,
                    kHelpOpt,
                    kTerminal
                },
                {
                    kVersionStr,
                    kStateStr,
                    kDBStr,
                    kHelpStr
                },
                ":v:s:d:h"
            }
        },
        {
            Command::GET,
            {
                {
                    kOutputOpt,
                    kDBOpt,
                    kHelpOpt,
                    kTerminal
                },
                {
                    kOutputStr,
                    kDBStr,
                    kHelpStr
                },
                ":o:d:h"
            },
        },
        {
            Command::UPDATE,
            {
                {
                    kVersionOpt,
                    kOutputOpt,
                    kDBOpt,
                    kHelpOpt,
                    kTerminal
                },
                {
                    kVersionStr,
                    kOutputStr,
                    kDBStr,
                    kHelpStr
                },
                ":v:o:d:h"
            }
        }
    };
// clang-format on

// Parse args uses the global ::optind variable from getopt.h which isn't ideal, but
// it allows us to handle commands first with command specific options.
std::pair<std::optional<Options>, std::string> ParseArgs(int argc, char* const* argv) {
  // Can't do anything without a command and a layout name
  if(argc < 3) {
    return {std::nullopt, GenerateUsage()};
  }
  // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
  std::optional<Command> command_opt = common::EnumCastCaseInsensitive<Command>(argv[::optind++]);
  if(!command_opt) {
    return {std::nullopt,
        // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
        GenerateUsage(std::string("Invalid command: '") + argv[::optind - 1] + "'")};
  }
  // Reference is easier to read over optional
  Command& command = command_opt.value();

  // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
  std::string layout_name = std::string(argv[::optind++]);
  // If the second argument is an option, the layout is missing
  if(layout_name[0] == '-') {
    return {std::nullopt, GenerateUsage("Missing layout!")};
  }

  Options options {command, layout_name};

  // Used to match and capture command line db specification.
  // Matches user:password@hostname[:port]/database_name
  static std::regex db_matcher(R"(^(?:(\w+)(?::(.*))?@)?((?:\w+://)?[\w\.]+)(?::(\d+))?(?:/(\w+))$)");
  std::smatch db_matches;
  GarageDatabaseParameters db_params;

  // Match only options which are in the map for that specific command.
  // For instance doesn't allow 'get' commands to take in an upload file.
  auto [long_options, _, optstring] = kCommandToOpts.at(command);
  int opt = 0;
  while((opt = ::getopt_long(argc, argv, optstring, long_options.data(), nullptr)) != -1) {
    switch(opt) {
    case 'v':
      try {
        options.version = std::stoul(::optarg);
      }
      catch(const std::invalid_argument& e) {
        return {std::nullopt,
            CommandUsage(command, std::string("Cannot convert ") + ::optarg + " to valid version")};
      }
      break;
    case 's':
      options.upload_file.emplace(::optarg);
      break;
    case 'o':
      options.output_file.emplace(::optarg);
      break;
    case 'd': {
      std::string params_string(::optarg);
      if(std::regex_match(params_string, db_matches, db_matcher)) {
        // Match an capture database parameters, allow default value only for port
        db_params.user = db_matches.str(1);
        db_params.password = db_matches.str(2);
        db_params.host = db_matches.str(3);
        db_params.port = (db_matches.str(4).empty() ? kMysqlDefaultPort : std::stoul(db_matches.str(4)));
        db_params.database = db_matches.str(5);
        options.db_params = db_params;
      }
      else {
        return {std::nullopt, CommandUsage(command, std::string("Unable to parse ") + params_string +
                                                        " into database parameters")};
      }
      break;
    }
    case 'h':
      return {std::nullopt, CommandUsage(command)};

    // Generic unknown argument errors
    case ':':
      return {std::nullopt,
          // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
          CommandUsage(command, std::string("Argument ") + argv[::optind - 1] + " missing required value")};
    case '?':
      return {std::nullopt,
          // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
          CommandUsage(command, std::string("Unknown argument ") + argv[::optind - 1])};
    }
  }
  // Don't allow random unparsed garbage from the command line, the user probably was trying
  // something that doesn't work
  if(::optind < argc) {
    return {std::nullopt,
        CommandUsage(command, std::string("Unknown possitional argument : ") +
                                  // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
                                  std::string(argv[::optind]))};
  }
  return {std::move(options), std::string()};
}

std::string GenerateUsage(const std::string& extra_message) {
  std::stringstream stream;
  if(!extra_message.empty()) {
    stream << extra_message << std::endl;
  }

  stream << "usage : garage_tracker_recovery <command> <layout_name> [command_options | --help]" << std::endl;

  for(const auto& map_c : kCommandToOpts) {
    stream << std::endl << CommandUsage(map_c.first);
  }
  return stream.str();
}

std::string CommandUsage(Command command, const std::string& extra_message) {
  std::stringstream stream;
  if(!extra_message.empty()) {
    stream << extra_message << std::endl;
  }
  const auto [opts, opt_help_strings, _] = kCommandToOpts.at(command);
  // last op is a terminal
  size_t n_opts = opts.size() - 1;
  std::string command_name = common::EnumNameString<Command>(command);
  std::transform(
      command_name.begin(), command_name.end(), command_name.begin(), [](char c) { return std::tolower(c); });
  stream << "'" << command_name << "' options : " << std::endl;
  for(size_t i = 0; i < n_opts; i++) {
    stream << "--" << opts[i].name << ": " << opt_help_strings[i] << std::endl;
  }
  return stream.str();
}

}  // namespace volley
</file>

<file path="src/garage_tracker_recovery.cpp">
#include <getopt.h>
#include <unistd.h>
#include <yaml-cpp/yaml.h>

#include <central/central_msgs.hpp>
#include <central/garage_tracker.hpp>
#include <central/garage_tracker_recovery_args.hpp>
#include <common_ros/layout.hpp>
#include <common_ros/versioned_state_buffer.hpp>
#include <cstdlib>
#include <fstream>
#include <iostream>
#include <rclcpp/time.hpp>

// *****************************************************************************
// Garage tracker recovery tool cli tool
// Supports 3 commands :
//    get :    Download the latest garage state from the garage tracker and
//             save it. Defaults to saving as annotated_garage_state.yaml
//
//    upload : Will take a yaml file representing a versioned discrete garage
//             state and parse it, validate it, and upload it the as the new
//             latest snapshot. Defaults to annotated_garage_state.yaml.
//
//    update : A combination of the prior two commands, update will grab the latest
//             snapshot from the discrete garage state and reupload it, optionally
//             at the desired version.

namespace volley {

int WriteAnnotatedWithInfo(YAML::Node annotated, std::string output_filename = "annotated_garage_state.yaml",
    bool has_annotation = true);

// Grab snapshot of old version from the mysql database and attempt to create a
// DiscreteGarageState. This will trigger a prompt for user action if the new state requires
// manual changes.
//
// Uses --output-file and --db-params options
int RunGetCommand(const Options& opts) {
  std::string output_filename = opts.output_file.value_or("annotated_garage_state.yaml");
  auto [snapshot_success, snapshot, snapshot_seq, snapshot_message, annotated_yaml] =
      volley::GetLatestSnapshot(opts.db_params.value());
  if(!snapshot_success) {
    std::cout << "Failed to load a garage state from the latest snapshot: " << snapshot_message << std::endl;
  }
  // If we succeed annotated yaml contains a valid state, else contains annotations indicating
  // what needs to be fixed.
  int write_result = WriteAnnotatedWithInfo(annotated_yaml, output_filename, !snapshot_success);
  return write_result && not snapshot_success;  // 0 for success 1 for failure for cli exit codes
}

// Upload versioned garage state file to mysql database. If we fail to parse the YAML
// write an annotated state which can be amended.
//
// Uses --state-yaml, --db-params, and --version
int RunUploadCommand(const Options& opts) {
  // Parse input file into discrete garage state
  std::string garage_state_yaml = opts.upload_file.value_or("annotated_garage_state.yaml");
  std::cout << "Loading garage state from " << garage_state_yaml << std::endl;

  const auto layout_filepath_or = GetLayoutPathByName(opts.layout_name);
  if(!layout_filepath_or.has_value()) {
    std::cerr << layout_filepath_or.error() << std::endl;
    return EXIT_FAILURE;
  }
  const auto& layout_filepath = layout_filepath_or.value();

  YAML::Node annotated;
  DiscreteGarageStateMsg state_msg {};
  volley::DiscreteGarageState central_state;
  try {
    YAML::Node yaml_state = YAML::LoadFile(garage_state_yaml);
    // Load for current version -- Can't load for previous versions because
    // we don't guarantee previous version ROS messages are compatible
    std::optional<DiscreteGarageStateMsg> state_msg_opt;
    std::tie(state_msg_opt, annotated) = volley::DecodeVersionedYaml<DiscreteGarageStateMsg>(yaml_state);

    if(!state_msg_opt) {
      // If we fail to parse, write out file with annotations to be hand fixed
      std::cout << "Failed to construct DiscreteGarageState message from " << garage_state_yaml << std::endl;
      WriteAnnotatedWithInfo(annotated, "annotated_" + garage_state_yaml);
      return 1;
    }
    state_msg = state_msg_opt.value();
  }
  catch(YAML::BadFile const& e) {
    // File doesn't exist or cannot be read. Unfortunately until we update ubuntu/yaml-cpp
    // e.what() won't be very useful. Latest yaml-cpp codebase contains which file failed.
    std::cout << "Failed to load yaml state file:\n\t" << e.what() << std::endl;
    return 1;
  }
  catch(YAML::ParserException const& parse_e) {
    std::cout << "Failed to parse YAML file " << garage_state_yaml << " for " << layout_filepath << ":\n\t"
              << parse_e.what() << std::endl;
    // We can fail here if the snapshot is of a future version. Leave that to require
    // running this tool from the future version to downgrade for safety reasons.
    return 1;
  }
  catch(YAML::Exception const& general_e) {
    std::cout << "YAML Exception:\n\t" << general_e.what() << std::endl;
    return 1;
  }

  // Set doesn't check for a Hash mismatch, which works out since we ignore that a handwritten
  // or edited YAML won't match the hash any more.
  auto [set_success, set_message] = central_state.Set(state_msg);
  if(!set_success) {
    std::cout << "Failed to construct a valid Discrete garage state for " << garage_state_yaml << ":\n\t"
              << set_message << std::endl;
    WriteAnnotatedWithInfo(annotated, "annotated_" + garage_state_yaml);
    return 1;
  }
  bool invalid_state = false;

  // Construct a layout to validate state against
  volley::Layout layout(layout_filepath);

  try {
    // Search for each agv / tray and validate that its garage_pose
    // exists in the layout. If not, annotate the existing YAML and
    // write that for a user to edit.
    for(auto const& [agv_id, agv] : central_state.GetAgvs()) {
      // Allow for unlocalized AGVs (pose 0@0)
      if(!(agv.pose.node_id == 0 and agv.pose.heading == 0) && !layout.HasGaragePose(agv.pose)) {
        auto found = std::find_if(annotated["agvs"].begin(), annotated["agvs"].end(),
            // gcc supports capturing structured bindings but clang
            // doesn't. Below should just read [agv_id] but that breaks
            // clang tidy and can't be ignored because clang tidy
            // fails the line with a compilation error not a tidy error
            [agv_id = agv_id](const YAML::Node& node) { return node["id"].as<uint16_t>() == agv_id; });
        invalid_state = true;
        (*found)["garage_pose"] = std::to_string(agv.pose) + " <<<INVALID POSE FOR LAYOUT>>>";
      }
    }
    for(auto const& [tray_id, tray] : central_state.GetTrays()) {
      if(!layout.HasGaragePose(tray.pose)) {
        auto found = std::find_if(annotated["trays"].begin(), annotated["trays"].end(),
            [tray_id = tray_id](const YAML::Node& node) { return node["id"].as<uint16_t>() == tray_id; });
        invalid_state = true;
        (*found)["garage_pose"] = std::to_string(tray.pose) + " <<<INVALID POSE FOR LAYOUT>>>";
      }
    }
    if(invalid_state) {
      std::cout << "Failed to validate state for " << opts.layout_name << std::endl;
      WriteAnnotatedWithInfo(annotated);
      return 1;
    }
  }
  catch(YAML::Exception const& e) {
    std::cout << "Error validating garage_state with layout:\n\t" << e.what() << std::endl;
    return 1;
  }
  auto [seq_number_success, latest_sequence_number, seq_number_message] =
      volley::GetLatestEventSequenceNumber(opts.db_params.value());
  if(!seq_number_success) {
    std::cout << "Failed to get latest sequence from database:\n\t" << seq_number_message << std::endl;
    return 1;
  }
  else {
    std::cout << "Writing garage state to database with version "
              << (opts.version ? std::to_string(opts.version.value()) : std::string("latest")) << " ..."
              << std::endl;

    auto [write_success, write_message] = volley::WriteSnapshot(opts.db_params.value(), central_state,
        latest_sequence_number + 1, opts.version.value_or(volley::kLatestYamlEncodingVersion));
    if(!write_success) {
      std::cout << "Failed to write snapshot:\n\t" << write_message << std::endl;
      return 1;
    }
  }

  std::cout << "Upload Success!" << std::endl;
  std::cout << "Please be sure to verify the state in the NOC before starting operations!" << std::endl;
  return 0;
}

// Update command chains a successful Get command
// with an Update command, used when trying to update the garage
// state to the newest version without starting the garage, or when
// downgrading from a newer to an older garage snapshot version directly.
//
// Uses --output-file, --db-params, and --version
int RunUpdateCommand(const Options& opts) {
  // If we fail to get a valid state, don't bother uploading
  if(int return_code = RunGetCommand(opts) != 0) {
    return return_code;
  }
  return RunUploadCommand(opts);
}

// Helper to write the annoated garage state YAML file to disk
int WriteAnnotatedWithInfo(YAML::Node annotated, std::string output_filename, bool has_annotation) {
  try {
    YAML::Emitter emit;
    emit << annotated;
    std::ofstream ofs(output_filename);
    if(!ofs) {
      std::cout << "Failed to open \"" << output_filename << "\" for writing." << std::endl;
      return 1;
    }
    std::cout << "Wrote garage state yaml " << output_filename << std::endl;
    ofs << emit.c_str() << std::endl;
    // Only print help message if output file has annotations
    if(has_annotation) {
      std::cout << "Please fix errors indicated with <<<MISSING>>> <<<INVALID...>>> and "
                   "<<<FAILED TO PARSE>>> in "
                << output_filename << "." << std::endl
                << "Once fixed please try to upload " << output_filename << " again" << std::endl;
    }
  }
  catch(YAML::EmitterException const& e) {
    std::cout << "Failed to create " << output_filename << ": " << e.what() << std::endl;
    return 1;
  }
  return 0;
}

// Entry point for the garage tracker CLI
// Parses command line arguments and then executes
// requested command.
int GarageTrackerRecoveryCli(int argc, char* const* argv) {
  std::optional<Options> opts_opt;  // :)
  std::string usage_str;
  std::tie(opts_opt, usage_str) = ParseArgs(argc, argv);
  Options opts {};

  if(!opts_opt) {
    std::cout << usage_str;
    return 1;
  }
  else {
    opts = std::move(opts_opt.value());
  }

  if(!opts.db_params) {
    opts.db_params = volley::GarageDatabaseParameters {
        .port = 3306u,
        .host = "mysql",
        .user = "scheduler",
        .password = "password",
        .database = "scheduler",
    };
  }

  // Make sure the expected tables exist, has the added bonus of making
  // sure we can connect to the DB
  auto [init_success, init_message] = volley::InitTables(opts.db_params.value());
  if(!init_success) {
    std::cout << "Couldn't connect to Database with parameters : " << init_message << std::endl;
    std::cout << "\thost: " << opts.db_params.value().host << std::endl;
    std::cout << "\tuser: " << opts.db_params.value().user << std::endl;
    std::cout << "\tport: " << opts.db_params.value().port << std::endl;
    std::cout << "\tpass: " << opts.db_params.value().password << std::endl;
    std::cout << "\tdb  : " << opts.db_params.value().database << std::endl;
    return 1;
  }

  switch(opts.command) {
  case Command::GET:
    return RunGetCommand(opts);
  case Command::UPLOAD:
    return RunUploadCommand(opts);
  case Command::UPDATE:
    // Ensure output and upload are the same file
    // The CLI won't allow an upload file to be passed
    // for an update command, only an output file, which
    // defaults to annotated_garage_state.yaml
    opts.upload_file = opts.output_file;
    return RunUpdateCommand(opts);
  default:
    // Should never hit here.
    std::cout << "Unknown Command encountered" << std::endl;
    return 255;
  }
}
}  // namespace volley

// getopt long requires the funky char * const * argv
int main(int argc, char* const* argv) {
  return volley::GarageTrackerRecoveryCli(argc, argv);
}
