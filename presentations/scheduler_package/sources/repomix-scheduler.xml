namespace volley::scheduler {

struct AgvAssignmentState;
struct TrayAssignmentState;
struct CandidateMove;

using AgvAssignmentEdgeKey = std::pair<uint16_t, std::shared_ptr<ScheduleEvent>>;
using AgvAssignmentEdgeCosts = std::unordered_map<AgvAssignmentEdgeKey, Interval::Duration>;

/// A tray move in apply order; `occupied_poses` is empty when recursion produced the move.
struct PlannedTrayMove {
  std::shared_ptr<TrayMove> move;
  std::vector<interfaces::msg::GaragePose> occupied_poses;
  std::optional<interfaces::msg::GaragePose> source_pose_if_applied = std::nullopt;
};
using PlannedTrayMoves = std::vector<PlannedTrayMove>;

struct TrayDestinationPlan {
  std::optional<interfaces::msg::GaragePose> dest;
  PlannedTrayMoves required_moves;
};

struct ResolveRequest {
  uint16_t tray_id;
  std::set<uint16_t> immobile_trays = {};
  VertexCollisionIdMap illegal_poses = {};
  bool is_retrieval_heading_enforced = false;
  bool is_waypoint_stash_allowed = true;
};

struct SchedulerParams {
  float target_insert_ready_bay_fraction = 0.0f;
  bool is_cost_audit_enabled = true;
  cost::MotionCostParams motion_cost = {};
};

class Scheduler {
public:
  explicit Scheduler(std::string layout_filepath, rclcpp::Logger logger, const SchedulerParams& params);

  interfaces::msg::PlanResponse Plan(
      const interfaces::msg::PlanRequest& request_data, const rclcpp::Time& now) const;

  std::optional<ContinuousState> PlanMotions(PlanContextSPtr ctx) const;

  stdx::Expected<std::vector<interfaces::msg::ActionNode>> BuildActionGraph(
      PlanContextSPtr ctx, const ContinuousState& final_state) const;

  interfaces::msg::VersionInfo::UniquePtr GetVersionInfo(const rclcpp::Time& now) const;

  std::unique_ptr<interfaces::msg::SchedulerReport> GetSchedulerReport(const rclcpp::Time& now) const {
    auto report = std::make_unique<interfaces::msg::SchedulerReport>();
    report->header.stamp = now;
    report->bay_readiness_ratio = target_insert_ready_bay_fraction_;
    return report;
  }

  [[nodiscard]] stdx::Result AssignTrays(PlanContextSPtr ctx) const;

  std::optional<Interval::Duration> ComputeTravelDuration(const interfaces::msg::GaragePose& start_pose,
      const interfaces::msg::GaragePose& end_pose, const interfaces::msg::GarageEntityId& agv_entity,
      bool is_agv_loaded = false, std::optional<GraphFilterProperties> path_filter = std::nullopt) const;
  std::optional<Interval::Duration> ComputeAgvPickupDuration(uint16_t agv_id, const TrayMove& move,
      const DiscreteGarageState& working_state,
      std::optional<GraphFilterProperties> path_filter = std::nullopt) const;
  std::optional<Interval::Duration> ComputeAgvAssignmentCost(uint16_t agv_id, const TrayMove& move,
      const DiscreteGarageState& working_state, const Interval::Duration& agv_busy_duration,
      std::optional<GraphFilterProperties> path_filter = std::nullopt) const;

  [[nodiscard]] stdx::Result AssignAgvs(PlanContextSPtr ctx) const;

  [[nodiscard]] stdx::Result ValidateEventSequence(PlanContextSPtr ctx) const;

  bool SetBayReadinessRatioCallback(interfaces::srv::SetFloat32::Request::SharedPtr request,
      interfaces::srv::SetFloat32::Response::SharedPtr response);

  LayoutSPtr GetLayout() const { return layout_; }
  const GarageGraph& GetMotionGraph() const { return motion_graph_; }
  const CollisionTable& GetCollisionTable() const { return collision_table_; }

  void ToggleDagPrinting() { is_dag_printing_enabled_ = !is_dag_printing_enabled_; }

  /// The caller applies the returned moves.
  TrayDestinationPlan ResolveBlockingTrays(
      const DiscreteGarageState& base_state, const ResolveRequest& request, size_t job_index) const;

private:
  std::function<void(void)> clean_garage_request_fn_;
  std::function<void(void)> rebalance_garage_request_fn_;
  std::function<void(uint16_t, uint16_t)> reset_bay_state_request_fn_;
  friend class SchedulerRos;

  [[nodiscard]] stdx::Expected<void, JobFailure> ExpandJob(
      PlanContextSPtr ctx, const interfaces::msg::SchedulerJob& job) const;

  /// For each parking node that allows it and reaches the preferred retrieve bay, stores the payload heading
  /// a retrieve prefers there: the reverse of that bay's inbound heading.
  void StorePreferredPayloadHeadingsForRetrieval();

  [[nodiscard]] stdx::Expected<void, JobFailure> ExpandAgvMoveJob(
      PlanContextSPtr ctx, uint16_t agv_id, interfaces::msg::GaragePose dest, size_t job_index) const;

  [[nodiscard]] stdx::Expected<void, JobFailure> ExpandRetrieveJob(
      PlanContextSPtr ctx, const interfaces::msg::Guid& payload_id, size_t job_index) const;

  [[nodiscard]] stdx::Expected<void, JobFailure> ExpandReparkTrayJob(PlanContextSPtr ctx,
      std::optional<uint16_t> tray_id, size_t job_index, bool is_reciprocal_heading_allowed,
      std::optional<interfaces::msg::GaragePose> dest = std::nullopt) const;

  [[nodiscard]] stdx::Result AddBayTransitionToRetrieve(
      PlanContextSPtr ctx, const interfaces::msg::DiscreteBayState& bay, size_t job_index) const;

  [[nodiscard]] stdx::Expected<void, JobFailure> ExpandInsertJob(
      PlanContextSPtr ctx, uint16_t bay_id, size_t job_index) const;

  [[nodiscard]] stdx::Expected<void, JobFailure> ExpandReadyForInsertJob(
      PlanContextSPtr ctx, uint16_t bay_id, size_t job_index) const;

  [[nodiscard]] stdx::Expected<void, JobFailure> ExpandReadyForRetrieveJob(
      PlanContextSPtr ctx, uint16_t bay_id, size_t job_index) const;

  [[nodiscard]] stdx::Expected<void, JobFailure> ExpandCleanGarageJob(
      PlanContextSPtr ctx, size_t job_index) const;

  [[nodiscard]] stdx::Expected<void, JobFailure> ExpandRebalanceGarageJob(
      PlanContextSPtr ctx, size_t job_index) const;

  /// Best effort: a tray that fails is logged and skipped.
  [[nodiscard]] stdx::Result ReparkWaypointStashedTrays(PlanContextSPtr ctx, size_t job_index) const;

  [[nodiscard]] stdx::Expected<void, JobFailure> ExpandAgvChargeJob(
      PlanContextSPtr ctx, uint16_t agv_id, size_t job_index) const;

  [[nodiscard]] stdx::Expected<void, JobFailure> ExpandBayTransitionJob(
      PlanContextSPtr ctx, uint16_t bay_id, uint8_t command_type, size_t job_index) const;

  [[nodiscard]] stdx::Expected<void, JobFailure> ExpandChargePayloadJob(
      PlanContextSPtr ctx, const interfaces::msg::Guid& payload_id, size_t job_index) const;

  /// The tray heading that puts the payload at the node's preferred payload heading
  /// (StorePreferredPayloadHeadingsForRetrieval): reversed for a payload reciprocal to its tray; nullopt
  /// without a payload or when the node has none.
  [[nodiscard]] std::optional<int16_t> FindPreferredTrayHeadingForRetrieval(
      uint32_t node_id, const std::optional<interfaces::msg::DiscretePayloadState>& payload_opt) const;
