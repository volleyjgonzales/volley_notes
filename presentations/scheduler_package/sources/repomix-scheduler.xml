<file path="test/include/scheduler/test/scenarios/recording.hpp">
#pragma once

#include <yaml-cpp/yaml.h>

#include <filesystem>
#include <string>
#include <string_view>

/// The recorded part of a scenario file: a message as a document in the files' compact form, the
/// comparison of two documents, and the comparison with or rewriting of a file's `input` and
/// `output`.
namespace volley::scheduler::test::scenarios {

/// Put sequences of scalars (GUID bytes, parent indices, node indices) on one line each.
void FlowScalarSequences(YAML::Node node);

/// Spell out the message fields named by an acronym (`vexen` is `ev_chargers`), as the files do.
void SpellOutFieldNames(YAML::Node node);

/// Reduce @p node to what differs from the message defaults: GUIDs become one scalar, default-valued
/// fields are left out (an absent field in a recording holds its default), short maps go on one line.
void Compact(YAML::Node node);

/// @return @p msg as a document, as to_yaml prints it, with the two passes above applied.
template <class Msg>
[[nodiscard]] YAML::Node MessageYaml(const Msg& msg) {
  YAML::Node doc = YAML::Load(to_yaml(msg));
  FlowScalarSequences(doc);
  SpellOutFieldNames(doc);
  return doc;
}

/// @return @p node in block style with a final newline: the on-disk form of the recorded part.
[[nodiscard]] std::string Emit(const YAML::Node& node);

/// Fail the test with the first differing line when @p expected and @p actual emit differently.
void ExpectSameDocument(const YAML::Node& expected, const YAML::Node& actual, std::string_view what);

/// Check that the file at @p path exists, names the running test and holds a recorded part. With
/// SCHEDULER_CHECK_RECORDINGS set, @p recorded (`input`, `output`) must also match it (off by
/// default: a configuration change moves every recording); with RECORD_REFERENCE_OUTPUT set, the
/// recorded part is rewritten instead.
void ExpectRecorded(const std::filesystem::path& path, const YAML::Node& recorded);

}  // namespace volley::scheduler::test::scenarios
</file>

