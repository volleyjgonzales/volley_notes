#include <vector>

#include "scheduler/test/scenarios/recording.hpp"

namespace volley::scheduler::test::scenarios {

YAML::Node Dag(const PlanContext& ctx) {
  const auto& dag = ctx.event_dag;

  // Name every vertex by its event's ToString, numbering identical strings in vertex order; the
  // canonical index of a vertex is the position of its name in the sorted list.
  std::vector<std::string> names(dag.NumVertices());
  std::map<std::string, size_t> seen;
  for(size_t vertex = 0; vertex < names.size(); ++vertex) {
    const auto text = std::to_string(*dag.GetEvent(vertex));
    names[vertex] = text + " #" + std::to_string(seen[text]++);
  }
  std::vector<std::string> sorted = names;
  std::ranges::sort(sorted);
  auto index = [&](size_t vertex) {
    return static_cast<size_t>(std::ranges::lower_bound(sorted, names[vertex]) - sorted.begin());
  };

  YAML::Node doc;
  doc["events"] = sorted;

  std::vector<std::pair<size_t, size_t>> edges;
  const auto& graph = dag.GetBaseGraph();
  for(auto [edge, end] = boost::edges(graph); edge != end; ++edge) {
    edges.emplace_back(index(boost::source(*edge, graph)), index(boost::target(*edge, graph)));
  }
  std::ranges::sort(edges);
  YAML::Node edge_list(YAML::NodeType::Sequence);
  for(const auto& [from, to] : edges) {
    YAML::Node pair(YAML::NodeType::Sequence);
    pair.push_back(from);
    pair.push_back(to);
    pair.SetStyle(YAML::EmitterStyle::Flow);
    edge_list.push_back(pair);
  }
  doc["edges"] = edge_list;

  std::map<unsigned, size_t> first_event_by_tray;
  for(const auto& [tray_id, event] : ctx.first_event_by_tray) {
    first_event_by_tray[tray_id] = index(dag.GetVertex(event).value());
  }
  YAML::Node by_tray(YAML::NodeType::Map);
  for(const auto& [tray_id, event_index] : first_event_by_tray) {
    by_tray[tray_id] = event_index;
  }
  doc["first_event_by_tray"] = by_tray;
  return doc;
}

Scenario Stage(std::string_view stage, std::string_view suffix) {
  return Load(StagePath(stage, suffix));
}

void ExpectStage(
    std::string_view stage, const YAML::Node& dag_before, const PlanContext& ctx, std::string_view suffix) {
  YAML::Node recorded;
  recorded["input"]["dag"] = dag_before;
  recorded["output"]["dag"] = Dag(ctx);
  ExpectRecorded(StagePath(stage, suffix), recorded);
}

}  // namespace volley::scheduler::test::scenarios
</file>

