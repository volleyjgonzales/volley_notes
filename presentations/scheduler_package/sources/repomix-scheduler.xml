<file path="test/include/scheduler/test/agv_commands.hpp">
#pragma once

#include <interfaces/msg/agv_command.hpp>

#include "scheduler/scheduler.hpp"

namespace volley::scheduler::test {

/// @return True when @p command lowers the tray the AGV carries.
[[nodiscard]] inline bool IsAgvLiftLowered(const interfaces::msg::AgvCommand& command) {
  return command.src.lift && !command.dst.lift;
}

/// @return True when @p command lifts the tray the AGV stands under.
[[nodiscard]] inline bool IsAgvLiftRaised(const interfaces::msg::AgvCommand& command) {
  return command.dst.lift && !command.src.lift;
}

}  // namespace volley::scheduler::test
</file>

