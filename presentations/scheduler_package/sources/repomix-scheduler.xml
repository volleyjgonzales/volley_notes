#include "scheduler/test/initial_states.hpp"

#include <yaml-cpp/yaml.h>

#include <common_ros/layout.hpp>
#include <format>
#include <stdexcept>
#include <utility>

namespace volley::scheduler::test::initial_states {

namespace {

/// The names the files use for the fields of DiscreteGarageState that the message names by an acronym.
constexpr std::pair<const char*, const char*> kFieldNames[] = {
    {"ev_chargers", "vexen"},
    {"vertical_conveyors", "vrcs"},
};

/// @return The site layout file named @p layout.
[[nodiscard]] std::filesystem::path LayoutPath(const std::string& layout) {
  const auto path_or = GetLayoutPathByName(layout);
  if(!path_or.has_value()) {
    throw std::runtime_error(std::format("Layout '{}': {}", layout, path_or.error()));
  }
  return path_or.value();
}

}  // namespace

InitialState Load(std::string_view name) {
  const auto path =
      std::filesystem::path(SCHEDULER_SCENARIO_DIR) / "initial_states" / std::format("{}.yaml", name);
  if(!std::filesystem::exists(path)) {
    throw std::runtime_error(std::format("No initial state file '{}'", path.string()));
  }

  YAML::Node doc = YAML::LoadFile(path.string());
  for(const auto& [file_name, field_name] : kFieldNames) {
    if(doc[file_name]) {
      doc[field_name] = doc[file_name];
      doc.remove(file_name);
    }
  }

  InitialState initial;
  initial.layout_path = LayoutPath(std::string(name.substr(0, name.find('/'))));
  if(const auto [success, message] = initial.state.Set(doc); !success) {
    throw std::runtime_error(std::format("Initial state '{}': {}", path.string(), message));
  }
  return initial;
}

}  // namespace volley::scheduler::test::initial_states
</file>

