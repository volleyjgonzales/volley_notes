    {"TRANSITION_BAY_TO_RETRIEVE", interfaces::msg::SchedulerJob::TYPE_TRANSITION_BAY_TO_RETRIEVE},
    {"CLEAN_GARAGE", interfaces::msg::SchedulerJob::TYPE_CLEAN_GARAGE},
