<file path="test/src/jobs/agv_charge_job_tests.cpp">
#include <gtest/gtest.h>

#include <interfaces/msg/action_node.hpp>
#include <interfaces/msg/bay_command.hpp>
#include <interfaces/msg/garage_node.hpp>
#include <interfaces/msg/garage_pose.hpp>
#include <interfaces/msg/scheduler_job.hpp>

#include "scheduler/scheduler.hpp"
#include "scheduler/test/scenarios/plan.hpp"

namespace volley::scheduler::test {

TEST(AgvChargeJob, ToNearestCharger) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  const auto& schedule = run.response.schedule.nodes;
  for(unsigned int i = 0u; i < schedule.size(); ++i) {
    const auto& node = schedule[i];
    EXPECT_EQ(interfaces::msg::ActionNode::TYPE_AGV_COMMAND, node.type);
    // The last node takes the AGV to C10, the closest charger
    if(i == schedule.size() - 1) {
      EXPECT_EQ(10u, node.agv_command.dst.pose.node_id);
    }
  }
}

TEST(AgvChargeJob, AlreadyOnCharger) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  ASSERT_EQ(1u, run.response.scheduled_jobs.size());
  EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_EXECUTING, run.response.scheduled_jobs[0].job.state);
  EXPECT_EQ(0u, run.response.schedule.nodes.size());
}

TEST(AgvChargeJob, TwoAgvsDistinctChargers) {
  const auto run = scenarios::Plan();
  for(const auto& job : run.response.scheduled_jobs) {
    ASSERT_EQ(interfaces::msg::SchedulerJob::STATE_EXECUTING, job.job.state) << job.job.note;
  }

  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  const auto& schedule = run.response.schedule.nodes;
  interfaces::msg::GaragePose last_a1 {};
  interfaces::msg::GaragePose last_a2 {};
  for(auto node : schedule) {
    EXPECT_EQ(interfaces::msg::ActionNode::TYPE_AGV_COMMAND, node.type);
    if(node.agv_id == 1) {
      last_a1 = node.agv_command.dst.pose;
    }
    if(node.agv_id == 2) {
      last_a2 = node.agv_command.dst.pose;
    }
  }

  const auto node_a1 = run.scheduler->GetLayout()->GetNodeById(last_a1.node_id);
  const auto node_a2 = run.scheduler->GetLayout()->GetNodeById(last_a2.node_id);
  ASSERT_TRUE(node_a1.has_value() && node_a2.has_value());
  EXPECT_EQ(interfaces::msg::GarageNode::TYPE_AGV_CHARGE, node_a1->type);
  EXPECT_EQ(interfaces::msg::GarageNode::TYPE_AGV_CHARGE, node_a2->type);
}

TEST(AgvChargeJob, FromInsideBay) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  const auto& schedule = run.response.schedule.nodes;
  ASSERT_GE(schedule.size(), 2u);
  const auto& bay_node = schedule[0];
  EXPECT_EQ(interfaces::msg::ActionNode::TYPE_BAY_COMMAND, bay_node.type);
  EXPECT_EQ(7u, bay_node.bay_id);
  EXPECT_EQ(
      interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_RETRIEVE, bay_node.bay_command.command_type);
  for(unsigned int i = 1u; i < schedule.size() - 1; ++i) {
    const auto& node = schedule[i];
    EXPECT_EQ(interfaces::msg::ActionNode::TYPE_AGV_COMMAND, node.type);
    EXPECT_EQ(1u, node.agv_id);
    // The second to last node takes the AGV to C10, the closest charger
    if(i == schedule.size() - 2) {
      EXPECT_EQ(10u, node.agv_command.dst.pose.node_id);
    }
  }
  const auto& last_node = schedule.back();
  EXPECT_EQ(interfaces::msg::ActionNode::TYPE_BAY_COMMAND, last_node.type);
  EXPECT_EQ(
      interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_INSERT, last_node.bay_command.command_type);
}

TEST(AgvChargeJob, SkipsDisabledChargers) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;

  ASSERT_EQ(1u, run.response.scheduled_jobs.size());

  // The AGV ends at C16 even though it is the farthest charger
  const auto& schedule = run.response.schedule.nodes;
  ASSERT_FALSE(schedule.empty());
  const auto& last_node = schedule.back();
  EXPECT_EQ(interfaces::msg::ActionNode::TYPE_AGV_COMMAND, last_node.type);
  EXPECT_EQ(16u, last_node.agv_command.dst.pose.node_id);
}

TEST(AgvChargeJob, Deterministic) {
  scenarios::ExpectDeterministic();
}

}  // namespace volley::scheduler::test
</file>

