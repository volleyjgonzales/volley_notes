<file path="test/scenarios/plan/retrieve_job/FromStall.yaml">
test: RetrieveJob.FromStall
description: >-
  Scenario: On 275_sunrise_b, AGV 1 stands at P2067, tray 1 carries payload 1 at P2066, and bay
  B2068 is ready to retrieve. Test: The test plans one RETRIEVE job for payload 1 through Plan().
  Expected: AGV 1 carries tray 1 into B2068 @ 0°, a PROCESS_RETRIEVE command to the bay ends the
  schedule, and the job is returned as executing.
initial_state: 275_sunrise_b/car_at_p2066_bay_ready_to_retrieve
scheduler:
  target_insert_ready_bay_fraction: 0.5
request:
  jobs:
  - type: RETRIEVE
    payload: 00000000-0000-0000-0000-000000000001
output:
  response:
    success: true
    id: 1000
    schedule:
      nodes:
        - guid: 1
          job_id: 1001
          type: 1
          duration: 6.81000
          agv_id: 1
          agv_command:
            src:
              pose: {node_id: 2067, heading: 90}
            dst:
              pose: {node_id: 2066, heading: 90}
        - guid: 2
          job_id: 1001
          type: 1
          parents: [0]
          duration: 6.00000
          agv_id: 1
          agv_command:
            src:
              pose: {node_id: 2066, heading: 90}
            dst:
              pose: {node_id: 2066, heading: 90}
              lift: true
        - guid: 3
          job_id: 1001
