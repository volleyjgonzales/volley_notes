#include "scheduler/test/scenarios/plan.hpp"

namespace volley::scheduler::test {

namespace {

// The two retrieves below stay on tiny_lot: its blocker has nowhere to go, which exercises the
// tray-assignment fallbacks; on 275_sunrise_b a blocker always finds a waypoint, and closing the
// garage down to a region makes the planner cycle.

}  // namespace

TEST(RetrieveJob, FromStall) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  for(const auto& job : run.response.scheduled_jobs) {
    ASSERT_EQ(job.job.state, interfaces::msg::SchedulerJob::STATE_EXECUTING);
  }

  const auto& schedule = run.response.schedule.nodes;
  ASSERT_GE(schedule.size(), 2u);
  auto prev_dst = ConstructGaragePose(2067, 90);
  bool has_lift = false;
  bool has_lower = false;
  for(unsigned int i = 0; i < schedule.size() - 1; ++i) {
    const auto& node = schedule[i];
    EXPECT_EQ(interfaces::msg::ActionNode::TYPE_AGV_COMMAND, node.type);
    EXPECT_EQ(prev_dst, node.agv_command.src.pose);
    prev_dst = node.agv_command.dst.pose;
    has_lower = has_lower || IsAgvLiftLowered(node.agv_command);
    has_lift = has_lift || IsAgvLiftRaised(node.agv_command);
  }
  EXPECT_EQ(ConstructGaragePose(2068, 0), schedule[schedule.size() - 2].agv_command.dst.pose);
  EXPECT_TRUE(has_lift);
  EXPECT_TRUE(has_lower);
  const auto& process_node = schedule.back();
  EXPECT_EQ(process_node.type, interfaces::msg::ActionNode::TYPE_BAY_COMMAND);
  EXPECT_EQ(
      process_node.bay_command.command_type, interfaces::msg::BayCommand::COMMAND_TYPE_PROCESS_RETRIEVE);
}

TEST(RetrieveJob, FromDisabledNode) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  for(const auto& job : run.response.scheduled_jobs) {
    ASSERT_EQ(job.job.state, interfaces::msg::SchedulerJob::STATE_ERROR);
  }

  EXPECT_EQ(0u, run.response.schedule.nodes.size());
}

TEST(RetrieveJob, WithBayTransition) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  for(const auto& job : run.response.scheduled_jobs) {
    ASSERT_EQ(job.job.state, interfaces::msg::SchedulerJob::STATE_EXECUTING);
  }

  const auto& schedule = run.response.schedule.nodes;
  ASSERT_GE(schedule.size(), 2u);
  auto prev_dst = ConstructGaragePose(2067, 90);
  bool has_lift = false;
  bool has_lower = false;
  bool has_transition_to_retrieve = false;
  bool has_process_retrieve = false;
  for(auto node : schedule) {
    bool is_agv_command = node.type == interfaces::msg::ActionNode::TYPE_AGV_COMMAND;
    bool is_bay_command = node.type == interfaces::msg::ActionNode::TYPE_BAY_COMMAND;
    EXPECT_TRUE(is_agv_command || is_bay_command);
    if(is_bay_command) {
      has_transition_to_retrieve =
          has_transition_to_retrieve ||
          (node.bay_command.command_type == interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_RETRIEVE);
      has_process_retrieve =
          has_process_retrieve or
          (node.bay_command.command_type == interfaces::msg::BayCommand::COMMAND_TYPE_PROCESS_RETRIEVE);
      continue;
    }
    EXPECT_EQ(prev_dst, node.agv_command.src.pose);
    prev_dst = node.agv_command.dst.pose;
    has_lower = has_lower || IsAgvLiftLowered(node.agv_command);
    has_lift = has_lift || IsAgvLiftRaised(node.agv_command);
  }
  EXPECT_EQ(ConstructGaragePose(2068, 0), schedule[schedule.size() - 2].agv_command.dst.pose);
  EXPECT_TRUE(has_lift);
  EXPECT_TRUE(has_lower);
  EXPECT_TRUE(has_transition_to_retrieve);
  EXPECT_TRUE(has_process_retrieve);
}

TEST(RetrieveJob, BackToBack) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  for(const auto& job : run.response.scheduled_jobs) {
    ASSERT_EQ(job.job.state, interfaces::msg::SchedulerJob::STATE_EXECUTING);
  }

  const auto& schedule = run.response.schedule.nodes;
  ASSERT_GE(schedule.size(), 2u);
  int num_process_retrieve_cmds = 0;
  for(auto node : schedule) {
    num_process_retrieve_cmds +=
        node.type == interfaces::msg::ActionNode::TYPE_BAY_COMMAND &&
        node.bay_command.command_type == interfaces::msg::BayCommand::COMMAND_TYPE_PROCESS_RETRIEVE;
  }

  EXPECT_EQ(2, num_process_retrieve_cmds);
}

TEST(RetrieveJob, WithCleanGarage) {
  const auto run = scenarios::Plan();

  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  for(const auto& job : run.response.scheduled_jobs) {
    EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_EXECUTING, job.job.state);
  }

  const auto& schedule = run.response.schedule.nodes;
  ASSERT_GE(schedule.size(), 2u);
  bool has_process_retrieve = false;
  for(const auto& node : schedule) {
    has_process_retrieve =
        has_process_retrieve ||
        (node.bay_command.command_type == interfaces::msg::BayCommand::COMMAND_TYPE_PROCESS_RETRIEVE &&
            node.type == interfaces::msg::ActionNode::TYPE_BAY_COMMAND);
  }
  EXPECT_TRUE(has_process_retrieve);
}

// The blocker sits on waypoint 3, so the next step of the critical path (6) is free: the root
// tray is advanced to 6 before the blocker is resolved again.
TEST(RetrieveJob, AdvancesRootTray) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  ASSERT_EQ(1u, run.response.scheduled_jobs.size());
  EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_EXECUTING, run.response.scheduled_jobs[0].job.state);
}

// The blocker sits on parking 6, the next step of the critical path, so the root tray cannot
// advance: the blocker is allowed to park on the critical path instead.
TEST(RetrieveJob, ParksBlockerOnCriticalPath) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  ASSERT_EQ(1u, run.response.scheduled_jobs.size());
  EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_EXECUTING, run.response.scheduled_jobs[0].job.state);
}

TEST(RetrieveJob, Deterministic) {
  scenarios::ExpectDeterministic();
}

// A stage failure fails the jobs that expanded; a job that failed expanding is not reported again.
TEST(RetrieveJob, FailedJobReportedOnce) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  ASSERT_EQ(run.request.pending_jobs.size(), run.response.scheduled_jobs.size());
  for(const auto& job : run.response.scheduled_jobs) {
    EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_ERROR, job.job.state);
  }
}

// A job that fails after adding events leaves none behind: the next job's plan holds only its own.
TEST(RetrieveJob, FailedJobLeavesNoEvents) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  ASSERT_EQ(run.response.scheduled_jobs.size(), 2u);
  EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_ERROR, run.response.scheduled_jobs[0].job.state);
  EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_EXECUTING, run.response.scheduled_jobs[1].job.state);
  EXPECT_EQ(
      1, std::ranges::count_if(run.response.schedule.nodes, [](const interfaces::msg::ActionNode& node) {
        return node.type == interfaces::msg::ActionNode::TYPE_VECS_COMMAND;
      }));
}

}  // namespace volley::scheduler::test
