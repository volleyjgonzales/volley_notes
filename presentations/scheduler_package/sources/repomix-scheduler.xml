interfaces::msg::PlanRequest BuildRequest(const Scenario& scenario, const rclcpp::Time& now) {
  interfaces::msg::PlanRequest request;
  request.id = MakeGuid(0u, kRequestGuid);
  request.base_state = scenario.initial.state.GetDiscreteGarageStateMessage();
  request.pending_jobs = scenario.request.jobs;
  for(size_t index = 0; index < request.pending_jobs.size(); ++index) {
    auto& job = request.pending_jobs[index];
    job.guid = MakeGuid(0u, kFirstJobGuid + index);
    job.time_registered = now;
  }
  request.base_schedule.nodes = scenario.request.base_schedule;
  return request;
}

