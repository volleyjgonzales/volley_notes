<file path="test/src/jobs/insert_job_tests.cpp">
#include <gtest/gtest.h>

#include <cstdint>
#include <interfaces/msg/action_node.hpp>
#include <interfaces/msg/scheduler_job.hpp>

#include "scheduler/scheduler.hpp"
#include "scheduler/test/agv_commands.hpp"
#include "scheduler/test/scenarios/plan.hpp"

namespace volley::scheduler::test {

namespace {

// The AGV nearest the bay lifts the tray in it and lowers it outside; where is recorded in the
// scenario: the retrieval-heading rule caches no heading for the stalls of 5675_pecos_combined, so
// the car lands on the waypoint in front of the bay rather than in the free stall.
struct InsertExpectation {
  uint32_t bay;
  uint32_t agv;
  int16_t lift_heading;
};

void ExpectInsert(const scenarios::Run& run, const InsertExpectation& expected) {
  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  for(const auto& job : run.response.scheduled_jobs) {
    ASSERT_EQ(job.job.state, interfaces::msg::SchedulerJob::STATE_EXECUTING);
  }

  const auto& schedule = run.response.schedule.nodes;
  bool has_lift = false;
  bool has_lower = false;

  for(const auto& node : schedule) {
    bool is_agv_command = node.type == interfaces::msg::ActionNode::TYPE_AGV_COMMAND;
    bool is_bay_command = node.type == interfaces::msg::ActionNode::TYPE_BAY_COMMAND;
    EXPECT_TRUE(is_agv_command || is_bay_command);

    if(is_agv_command) {
      // The AGV nearest the bay does the job.
      EXPECT_EQ(node.agv_id, expected.agv);

      bool is_lower = IsAgvLiftLowered(node.agv_command);
      bool is_lift = IsAgvLiftRaised(node.agv_command);

      if(is_lift && !has_lower) {
        // The AGV lifts the tray in the bay, aligned with the tray.
        EXPECT_EQ(node.agv_command.dst.pose.node_id, expected.bay);
        EXPECT_EQ(node.agv_command.dst.pose.heading, expected.lift_heading);
      }

      if(has_lift && is_lower) {
        // The AGV lowers the tray somewhere outside the bay.
        EXPECT_NE(node.agv_command.dst.pose.node_id, expected.bay);
      }
      has_lower = has_lower || is_lower;
      has_lift = has_lift || is_lift;
    }
  }

  EXPECT_TRUE(has_lift);
  EXPECT_TRUE(has_lower);
}

}  // namespace

TEST(InsertJob, WithCleanGarage) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  for(const auto& job : run.response.scheduled_jobs) {
    ASSERT_EQ(job.job.state, interfaces::msg::SchedulerJob::STATE_EXECUTING);
  }

  const auto& schedule = run.response.schedule.nodes;
  bool has_lift = false;
  bool has_lower = false;
  for(const auto& node : schedule) {
    bool is_agv_command = node.type == interfaces::msg::ActionNode::TYPE_AGV_COMMAND;
    bool is_bay_command = node.type == interfaces::msg::ActionNode::TYPE_BAY_COMMAND;
    EXPECT_TRUE(is_agv_command || is_bay_command);
    if(is_agv_command) {
      has_lower = has_lower || IsAgvLiftLowered(node.agv_command);
      has_lift = has_lift || IsAgvLiftRaised(node.agv_command);
    }
  }
  EXPECT_TRUE(has_lift);
  EXPECT_TRUE(has_lower);
}

TEST(InsertJob, FromBay7TrayHeading90) {
  ExpectInsert(scenarios::Plan(), {.bay = 7, .agv = 7, .lift_heading = 90});
}

TEST(InsertJob, FromBay7TrayReversed) {
  ExpectInsert(scenarios::Plan(), {.bay = 7, .agv = 7, .lift_heading = 90});
}

TEST(InsertJob, FromBay21TrayHeading90) {
  ExpectInsert(scenarios::Plan(), {.bay = 21, .agv = 10, .lift_heading = 90});
}

TEST(InsertJob, FromBay21TrayReversed) {
  ExpectInsert(scenarios::Plan(), {.bay = 21, .agv = 10, .lift_heading = 90});
}

TEST(InsertJob, Deterministic) {
  scenarios::ExpectDeterministic();
}

