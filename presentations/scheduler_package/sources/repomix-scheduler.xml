#include "scheduler/move_events.hpp"

#include <interfaces/msg/agv_pose_changed.hpp>

namespace volley {

std::shared_ptr<AgvMove> MakeAgvPoseMove(size_t job_index, uint16_t agv_id,
    const interfaces::msg::GaragePose& source, const interfaces::msg::GaragePose& destination) {
  interfaces::msg::AgvPoseChanged pose_change;
  pose_change.agv_id = agv_id;
  pose_change.node_id_curr = source.node_id;
  pose_change.heading_curr = source.heading;
  pose_change.node_id_next = destination.node_id;
  pose_change.heading_next = destination.heading;
  return std::make_shared<AgvMove>(job_index, pose_change);
}

std::shared_ptr<TrayMove> MakeTrayMove(size_t job_index, std::optional<uint16_t> tray_id,
    std::optional<interfaces::msg::GaragePose> dest, std::optional<uint16_t> agv_id) {
  auto move = std::make_shared<TrayMove>(job_index);
  if(tray_id) {
    move->SetTrayId(*tray_id);
  }
  if(dest) {
    move->SetDest(*dest);
  }
  if(agv_id) {
    move->SetAgvId(*agv_id);
  }
  return move;
}

}  // namespace volley
