TEST(ScenarioYaml, DecodesJobFields) {
  const auto job = YAML::Load(
      "{type: RETRIEVE, tray_id: 3, bay_id: 2068, payload: 00000000-0000-0000-0000-000000000001, "
      "destination: {node_id: 2068, heading: 0}, note: a note, allow_reciprocal: true}")
                       .as<SchedulerJob>();
  EXPECT_EQ(job.type, SchedulerJob::TYPE_RETRIEVE);
  EXPECT_EQ(job.tray_id, 3);
  EXPECT_EQ(job.bay_id, 2068);
  EXPECT_EQ(job.payload_id.bytes.back(), 1);
  EXPECT_EQ(job.destination.node_id, 2068u);
