    ASSERT_EQ(job.job.state, interfaces::msg::SchedulerJob::STATE_EXECUTING);
  }

  const auto& schedule = run.response.schedule.nodes;
  ASSERT_FALSE(schedule.empty());
  auto prev_dst = ConstructGaragePose(2067, 90);
  for(const auto& node : schedule) {
    EXPECT_EQ(interfaces::msg::ActionNode::TYPE_AGV_COMMAND, node.type);
    EXPECT_EQ(prev_dst, node.agv_command.src.pose);
    prev_dst = node.agv_command.dst.pose;
  }
  EXPECT_EQ(run.request.pending_jobs[0].destination, schedule.back().agv_command.dst.pose);
}

TEST(MoveJob, AgvAlreadyAtDestination) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  // Job 'succeeds' to plan but empty schedule because it's already at the dest node
  ASSERT_EQ(1u, run.response.scheduled_jobs.size());
  EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_EXECUTING, run.response.scheduled_jobs[0].job.state);
  EXPECT_EQ(0u, run.response.schedule.nodes.size());
}

// An AGV command in the base schedule reserves its AGV and its two nodes: neither is used.
TEST(MoveJob, BaseScheduleReservesAgvAndNodes) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  ASSERT_EQ(1u, run.response.scheduled_jobs.size());
  EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_EXECUTING, run.response.scheduled_jobs[0].job.state);
  EXPECT_FALSE(run.response.schedule.nodes.empty());
  for(const auto& node : run.response.schedule.nodes) {
    EXPECT_EQ(1u, node.agv_id) << "the reserved AGV was used";
  }
