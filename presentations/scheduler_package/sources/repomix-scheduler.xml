interfaces::msg::Guid GenerateNextActionGuid() {
  static uint64_t guid_counter = 1;
  return MakeGuid(0u, guid_counter++);
}

bool IsAgvMotionBetweenFloors(const Motion& motion, const Layout& layout) {
  const auto garage_event_opt = motion.GetDelta();
  if(!garage_event_opt.has_value() || garage_event_opt->type != "AgvPoseChanged") {
    return false;
  }

  const auto agv_pose_change = Deserialize<interfaces::msg::AgvPoseChanged>(garage_event_opt.value());
  if(!agv_pose_change) {
    return false;
  }

  const auto src_layout_node = layout.GetNodeById(agv_pose_change->node_id_curr);
  const auto dst_layout_node = layout.GetNodeById(agv_pose_change->node_id_next);
  if(!src_layout_node.has_value() || !dst_layout_node.has_value()) {
    return false;
  }

  return src_layout_node->floor != dst_layout_node->floor;
}

// Door close + carriage transit + door open, whether or not the carriage carries an AGV.
float ComputeVrcFloorTransitSeconds(const Layout& layout, uint16_t src_floor_id, uint16_t dst_floor_id,
    const cost::MotionCostModel& cost_model) {
  if(src_floor_id == dst_floor_id) {
    return 0.0f;
  }
  auto src_z = layout.GetFloorZForFloorId(src_floor_id);
  auto dst_z = layout.GetFloorZForFloorId(dst_floor_id);
  if(!src_z || !dst_z) {
    return 0.0f;
  }
  const Transition transition {std::abs(dst_z.value() - src_z.value()), TransitionType::VRC_TRANSITION};
  const auto& event_durations = cost_model.Params().events;
  return event_durations.vrc_door_close + cost_model.Duration(transition).count() +
         event_durations.vrc_door_open;
}
stdx::Result InsertVrcActionsIntoDag(Dag<interfaces::msg::ActionNode>& actions_dag, const Layout& layout,
    const DiscreteGarageState& initial_state, const cost::MotionCostModel& cost_model) {
  // Later VRC commands wait on this so the carriage never moves out from under an AGV.
  std::unordered_map<uint16_t, std::shared_ptr<interfaces::msg::ActionNode>> last_vrc_action;
  std::unordered_map<uint16_t, uint16_t> vrc_simulated_floor;

  const auto pre_vrc_order = actions_dag.GetTopologicalOrdering();
  if(!pre_vrc_order.has_value()) {
    return stdx::Unexpected("Failed to get pre-VRC topological order for action DAG");
  }

  for(const auto& vertex : pre_vrc_order.value()) {
    const auto action = actions_dag.GetNode(vertex);
    if(action->type != interfaces::msg::ActionNode::TYPE_AGV_COMMAND) {
      continue;
    }
    const auto src_node_opt = layout.GetNodeById(action->agv_command.src.pose.node_id);
    const auto dst_node_opt = layout.GetNodeById(action->agv_command.dst.pose.node_id);
    if(!src_node_opt.has_value() || !dst_node_opt.has_value()) {
      continue;
    }
    const interfaces::msg::GarageNode src_node = src_node_opt.value();
    const interfaces::msg::GarageNode dst_node = dst_node_opt.value();

    const auto src_vrc = layout.GetVrcForNodeId(src_node.id);
    const auto dst_vrc = layout.GetVrcForNodeId(dst_node.id);
    if(!src_vrc.has_value() && !dst_vrc.has_value()) {
      continue;
    }

    const bool is_cross_floor = (src_node.floor != dst_node.floor);
    if(is_cross_floor) {
      // A cross-floor edge runs along one VRC, so both endpoints must be on it.
      if(!src_vrc.has_value() || !dst_vrc.has_value() || src_vrc->id != dst_vrc->id) {
        return stdx::Unexpected(
            "Cannot process move across floors from node {} to node {} as they are not on the same VRC",
            src_node.id, dst_node.id);
      }
    }

    const Vrc vrc = src_vrc.has_value() ? src_vrc.value() : dst_vrc.value();
    // dst.floor is safe when src is off the VRC, because such a move is same-floor.
    const uint16_t required_start_floor = src_vrc.has_value() ? src_node.floor : dst_node.floor;
    const uint16_t end_floor = dst_node.floor;

    if(!vrc_simulated_floor.contains(vrc.id)) {
      auto vrc_state = initial_state.GetVrc(vrc.id);
      vrc_simulated_floor[vrc.id] = vrc_state.has_value() ? vrc_state->current_floor : required_start_floor;
    }
    const uint16_t vrc_current_floor = vrc_simulated_floor.at(vrc.id);

    const auto make_vrc_move_action = [&](uint16_t from_floor, uint16_t to_floor) {
      auto vrc_action = std::make_shared<interfaces::msg::ActionNode>();
      vrc_action->guid = GenerateNextActionGuid();
      vrc_action->job_id = action->job_id;
      vrc_action->type = interfaces::msg::ActionNode::TYPE_VRC_COMMAND;
      vrc_action->vrc_id = vrc.id;
      vrc_action->vrc_command.command_id = "VrcCommand";
      vrc_action->vrc_command.command_type = interfaces::msg::VrcCommand::COMMAND_TYPE_MOVE;
      vrc_action->vrc_command.requested_floor = to_floor;
      vrc_action->duration = ComputeVrcFloorTransitSeconds(layout, from_floor, to_floor, cost_model);
      return vrc_action;
    };
    // Skip a cycle-closing edge: pre_vrc_order interleaves parallel branches, so this action can already
    // be upstream of last_vrc_action, and the existing edges then imply the ordering.
    const auto order_after_last_vrc_action =
        [&](const std::shared_ptr<interfaces::msg::ActionNode>& vrc_action) {
          if(last_vrc_action.contains(vrc.id) &&
              !actions_dag.WouldCreateCycle(last_vrc_action.at(vrc.id), vrc_action)) {
            actions_dag.AddDependency(last_vrc_action.at(vrc.id), vrc_action);
          }
        };

    if(vrc_current_floor != required_start_floor) {
      const auto vrc_approach_action = make_vrc_move_action(vrc_current_floor, required_start_floor);
      actions_dag.Add(vrc_approach_action);
      actions_dag.AddDependency(vrc_approach_action, action);
      order_after_last_vrc_action(vrc_approach_action);
      last_vrc_action[vrc.id] = vrc_approach_action;
      vrc_simulated_floor[vrc.id] = required_start_floor;
    }

    if(is_cross_floor) {
      const auto vrc_move_action = make_vrc_move_action(required_start_floor, end_floor);
      const auto agv_id = action->agv_id;
      actions_dag.Replace(action, vrc_move_action);

      std::shared_ptr<interfaces::msg::ActionNode> exit_vrc_action = nullptr;
      for(const auto& child_action : actions_dag.GetChildren(vertex)) {
        if(child_action->type == interfaces::msg::ActionNode::TYPE_AGV_COMMAND &&
            child_action->agv_id == agv_id && child_action->agv_command.src.pose.node_id == dst_node.id) {
          exit_vrc_action = child_action;
          break;
        }
      }

      order_after_last_vrc_action(vrc_move_action);

      // The AGV stays on the carriage until it exits, so later commands wait on the exit if found.
      last_vrc_action[vrc.id] = exit_vrc_action ? exit_vrc_action : vrc_move_action;
    }
    else {
      // Same-floor visit: later commands wait for the AGV to leave the carriage.
      last_vrc_action[vrc.id] = action;
    }

    vrc_simulated_floor[vrc.id] = end_floor;
  }

  return {};
}

// Non-AGV collision ids are trays or payloads, which only move while lifted by an AGV.
bool IsLiftedMotion(const Motion& motion) {
  return motion.GetCollisionId() != common::EnumInteger(CollisionEntityId::AGV);
}

// Total order on Motions: start time, action id, hash, then every other field, payload included, so std::set
// keeps distinct motions whose hashes collide. Each key is computed only when the ones before tie.
class MotionScheduleOrder {
  static auto LocationKey(const std::variant<Motion::Pose, Motion::Edge>& location) {
    if(const auto* pose = std::get_if<Motion::Pose>(&location)) {
      return std::make_tuple(pose->node_id, pose->heading, uint32_t {0}, int16_t {0});
    }
    const auto& edge = std::get<Motion::Edge>(location);
    return std::make_tuple(edge[0].node_id, edge[0].heading, edge[1].node_id, edge[1].heading);
  }

  // The fields after the hash up to the event type; the payload bytes and the idle flag follow.
  static auto FieldKey(const Motion& motion) {
    const auto& entity = motion.GetEntityId();
    const auto& delta = motion.GetDelta();
    return std::make_tuple(motion.GetInterval().GetEnd(), motion.GetCollisionId(),
        std::string_view(entity.entity_type), entity.id, motion.GetLocation().index(),
        LocationKey(motion.GetLocation()), delta.has_value(),
        delta ? std::string_view(delta->type) : std::string_view {});
  }

public:
  bool operator()(const Motion& a, const Motion& b) const {
    const auto& a_start = a.GetInterval().GetBegin();
    const auto& b_start = b.GetInterval().GetBegin();
    if(a_start != b_start) {
      return a_start < b_start;
    }
    if(a.GetActionId() != b.GetActionId()) {
      return a.GetActionId() < b.GetActionId();
    }
    const auto a_hash = MotionHasher {}(a);
    const auto b_hash = MotionHasher {}(b);
    if(a_hash != b_hash) {
      return a_hash < b_hash;
    }
    const auto a_fields = FieldKey(a);
    const auto b_fields = FieldKey(b);
    if(a_fields != b_fields) {
      return a_fields < b_fields;
    }
    // FieldKey compared delta.has_value(), so both have a payload or neither does.
    if(a.GetDelta()) {
      const auto& a_bytes = a.GetDelta()->buffer;
      const auto& b_bytes = b.GetDelta()->buffer;
      if(!std::ranges::equal(a_bytes, b_bytes)) {
        return std::ranges::lexicographical_compare(a_bytes, b_bytes);
      }
    }
    return a.IsIdle() < b.IsIdle();
  }
};

stdx::Expected<interfaces::msg::ActionNode> ToActionNode(
    const Motion& motion, interfaces::msg::Guid job_id, const ScheduleEvent& event) {
  const auto& garage_event_opt = motion.GetDelta();
  if(!garage_event_opt) {
    return stdx::Unexpected("Motion {} has no discrete change", std::to_string(motion));
  }
  const auto& type = garage_event_opt->type;

  interfaces::msg::ActionNode action_node;
  action_node.guid = GenerateNextActionGuid();
  action_node.job_id = job_id;
  action_node.duration = static_cast<float>(motion.GetInterval().GetDuration().count()) / 1e9f;

  if(type == "AgvPoseChanged") {
    const auto pose_change = Deserialize<interfaces::msg::AgvPoseChanged>(*garage_event_opt);
    if(!pose_change) {
      return stdx::Unexpected("Cannot deserialize the {} of motion {}", type, std::to_string(motion));
    }
    action_node.type = interfaces::msg::ActionNode::TYPE_AGV_COMMAND;
    action_node.agv_id = pose_change->agv_id;
    action_node.agv_command.src.pose.node_id = pose_change->node_id_curr;
    action_node.agv_command.src.pose.heading = pose_change->heading_curr;
    action_node.agv_command.dst.pose.node_id = pose_change->node_id_next;
    action_node.agv_command.dst.pose.heading = pose_change->heading_next;
    action_node.agv_command.src.lift = IsLiftedMotion(motion);
    action_node.agv_command.dst.lift = IsLiftedMotion(motion);
  }
  else if(type == "AgvLiftChanged") {
    const auto lift_change = Deserialize<interfaces::msg::AgvLiftChanged>(*garage_event_opt);
    if(!lift_change) {
      return stdx::Unexpected("Cannot deserialize the {} of motion {}", type, std::to_string(motion));
    }
    const auto* pose = std::get_if<Motion::Pose>(&motion.GetLocation());
    if(pose == nullptr) {
      return stdx::Unexpected("Lift motion {} is not at a pose", std::to_string(motion));
    }
    action_node.type = interfaces::msg::ActionNode::TYPE_AGV_COMMAND;
    action_node.agv_id = lift_change->agv_id;
    action_node.agv_command.src.pose = *pose;
    action_node.agv_command.dst.pose = *pose;
    action_node.agv_command.src.lift = !lift_change->raised;
    action_node.agv_command.dst.lift = lift_change->raised;
  }
  else if(type == "BayStateChanged") {
    const auto* bay_transition = dynamic_cast<const BayTransition*>(&event);
    if(bay_transition == nullptr) {
      return stdx::Unexpected("Bay state change of motion {} belongs to {}, not to a bay transition",
          std::to_string(motion), event.ToString());
    }
    const auto bay_change = Deserialize<interfaces::msg::BayStateChanged>(*garage_event_opt);
    if(!bay_change) {
      return stdx::Unexpected("Cannot deserialize the {} of motion {}", type, std::to_string(motion));
    }
    action_node.type = interfaces::msg::ActionNode::TYPE_BAY_COMMAND;
    action_node.bay_id = bay_change->bay_id;
    action_node.bay_command = bay_transition->GetCommand();
  }
  else if(type == "VecsStateChanged") {
    const auto ev_charger_change = Deserialize<interfaces::msg::VecsStateChanged>(*garage_event_opt);
    if(!ev_charger_change) {
      return stdx::Unexpected("Cannot deserialize the {} of motion {}", type, std::to_string(motion));
    }
    action_node.type = interfaces::msg::ActionNode::TYPE_VECS_COMMAND;
    action_node.vecs_id = ev_charger_change->vecs_id;
    interfaces::msg::VecsCommand command {};
    command.command_id = std::to_string(action_node.guid);
    switch(ev_charger_change->state_next) {
    case interfaces::msg::VecsReport::READY_TO_CHARGE: {
      command.command_type = interfaces::msg::VecsCommand::COMMAND_TYPE_STOP_CHARGING;
    } break;
    case interfaces::msg::VecsReport::CHARGING: {
      command.command_type = interfaces::msg::VecsCommand::COMMAND_TYPE_START_CHARGING;
    } break;
    default:
      return stdx::Unexpected("Charger state {} of motion {} has no command",
          static_cast<int>(ev_charger_change->state_next), std::to_string(motion));
    }
    action_node.vecs_command = command;
  }
  else if(type == "VrcStateChanged") {
    const auto vrc_change = Deserialize<interfaces::msg::VrcStateChanged>(*garage_event_opt);
    if(!vrc_change) {
      return stdx::Unexpected("Cannot deserialize the {} of motion {}", type, std::to_string(motion));
    }
    action_node.type = interfaces::msg::ActionNode::TYPE_VRC_COMMAND;
    action_node.vrc_id = vrc_change->current_discrete_state.id;
    interfaces::msg::VrcCommand command {};
    command.command_id = std::to_string(action_node.guid);
    command.command_type = interfaces::msg::VrcCommand::COMMAND_TYPE_MOVE;
    command.requested_floor = vrc_change->next_discrete_state.current_floor;
    action_node.vrc_command = command;
  }
  else {
    return stdx::Unexpected("Unknown discrete change {} of motion {}", type, std::to_string(motion));
  }

  return action_node;
}

stdx::Result CollectAndCollapseTrajectoryMotions(const ContinuousState& final_state, const Layout& layout,
    std::set<Motion, MotionScheduleOrder>& all_motions) {
  for(const auto& [entity_id, trajectory] : final_state.GetTrajectories()) {
    std::optional<Motion> first_interfloor_motion;
    for(const auto& motion : trajectory) {
      if(IsAgvMotionBetweenFloors(motion, layout)) {
        if(!first_interfloor_motion.has_value()) {
          first_interfloor_motion = motion;
        }
        continue;
      }
      else if(first_interfloor_motion.has_value()) {
        const Interval interval(
            first_interfloor_motion->GetInterval().GetBegin(), motion.GetInterval().GetBegin());
        Motion combined_interfloor_motion(motion.GetEntityId(), interval, motion.GetCollisionId(),
            motion.GetActionId(), {first_interfloor_motion->GetSourcePose(), motion.GetSourcePose()});

        if(!all_motions.insert(combined_interfloor_motion).second) {
          return stdx::Unexpected(
              "Failed to add {} to set of all motions", std::to_string(combined_interfloor_motion));
        }
        first_interfloor_motion = std::nullopt;
      }

      // Waits get no action node; the occupancy history orders around them.
      auto garage_event_opt = motion.GetDelta();
      if(!garage_event_opt.has_value() || motion.IsIdle()) {
        continue;
      }
      if(!all_motions.insert(motion).second) {
        return stdx::Unexpected("Failed to add {} to set of all motions", std::to_string(motion));
      }
    }
  }
  return {};
}

stdx::Result BuildActionDagFromMotions(const std::set<Motion, MotionScheduleOrder>& all_motions,
    PlanContextSPtr ctx, Dag<interfaces::msg::ActionNode>& final_actions_dag,
    GarageOccupancyChecker<std::shared_ptr<interfaces::msg::ActionNode>>& occupancy_history,
    ActionSpanByEvent& action_span_by_event) {
  std::unordered_map<interfaces::msg::GarageEntityId, std::shared_ptr<interfaces::msg::ActionNode>,
      GarageEntityIdHasher>
      last_entity_action;
  for(const auto& motion : all_motions) {
    const auto event_vertex = static_cast<ScheduleEventDag::Vertex>(motion.GetActionId());
    const auto event = ctx->event_dag.GetEvent(event_vertex);
    auto action_node_or = ToActionNode(motion, ctx->scheduled_jobs[event->GetJobIndex()].job.guid, *event);
    if(!action_node_or.has_value()) {
      return stdx::Unexpected(action_node_or.error());
    }
    const auto action_node = std::make_shared<interfaces::msg::ActionNode>(std::move(*action_node_or));
    // Tasks are linear, so overwriting `last` on each subsequent motion is sufficient.
    auto& span = action_span_by_event[motion.GetActionId()];
    if(span.first_action == nullptr) {
      span.first_action = action_node;
    }
    span.last_action = action_node;
    final_actions_dag.Add(action_node);

    auto last_action = last_entity_action.find(motion.GetEntityId());
    if(last_action != last_entity_action.end()) {
      final_actions_dag.AddDependency(last_action->second, action_node);
    }
    last_entity_action[motion.GetEntityId()] = action_node;

    const bool is_lifted = IsLiftedMotion(motion);
    // Bay and VECS motions carry their node without a heading, and the occupancy graph lacks some edges
    // AGVs drive. By policy such a location orders nothing and is ordered after nothing; that does not
    // mean it cannot conflict, only that this graph cannot tell.
    const auto blockers_or =
        occupancy_history.GetBlockers(motion.GetLocation(), motion.GetCollisionId(), is_lifted);
    // Every move into a space depends on every earlier occupant; RemoveRedundantEdges() prunes the excess.
    if(blockers_or) {
      for(const auto& blocker : *blockers_or) {
        final_actions_dag.AddDependency(blocker, action_node);
      }
    }
    occupancy_history.AddOccupant(motion.GetLocation(), motion.GetCollisionId(), action_node, is_lifted);
  }
  return {};
}

stdx::Result TransferEventDagDepsToActionDag(PlanContextSPtr ctx,
    const ActionSpanByEvent& action_span_by_event, Dag<interfaces::msg::ActionNode>& final_actions_dag) {
  const auto total_ordering = ctx->event_dag.GetTopologicalOrdering();
  if(!total_ordering.has_value()) {
    return stdx::Unexpected("Failed to get total ordering for input events!");
  }
  for(const auto& event_vertex : total_ordering.value()) {
    if(!action_span_by_event.contains(event_vertex)) {
      return stdx::Unexpected("Failed to transfer dependencies: {} ({}) has no associated motions!",
          ctx->event_dag.GetEvent(event_vertex)->ToString(), event_vertex);
    }
    const auto& span = action_span_by_event.at(event_vertex);
    for(const auto& dependent_edge : boost::make_iterator_range(ctx->event_dag.GetOutEdges(event_vertex))) {
      const auto dependent_vertex = ctx->event_dag.GetTargetVertex(dependent_edge);
      final_actions_dag.AddDependency(
          span.last_action, action_span_by_event.at(dependent_vertex).first_action);
    }
  }
  return {};
}

std::vector<interfaces::msg::ActionNode> BuildScheduledActionsArray(
    const Dag<interfaces::msg::ActionNode>& final_actions_dag,
    const std::vector<Dag<interfaces::msg::ActionNode>::Vertex>& final_ordering) {
  std::unordered_map<interfaces::msg::Guid, size_t> position_by_action_guid;
  std::unordered_map<interfaces::msg::GarageEntityId, size_t> last_position_by_entity;
  std::vector<interfaces::msg::ActionNode> scheduled_actions;
  scheduled_actions.reserve(final_ordering.size());
  for(const auto action_vertex : final_ordering) {
    auto action_node = *final_actions_dag.GetNode(action_vertex);
    const auto position = scheduled_actions.size();
    position_by_action_guid[action_node.guid] = position;
    for(const auto& parent_action_node : final_actions_dag.GetParents(action_vertex)) {
      action_node.parents.push_back(position_by_action_guid.at(parent_action_node->guid));
    }

    interfaces::msg::GarageEntityId entity {};
    if(action_node.type == interfaces::msg::ActionNode::TYPE_AGV_COMMAND) {
      entity = AgvId(action_node.agv_id);
    }
    else if(action_node.type == interfaces::msg::ActionNode::TYPE_BAY_COMMAND) {
      entity = BayId(action_node.bay_id);
    }
    else if(action_node.type == interfaces::msg::ActionNode::TYPE_VRC_COMMAND) {
      entity = VrcId(action_node.vrc_id);
    }

    if(last_position_by_entity.contains(entity)) {
      const auto last_position = last_position_by_entity.at(entity);
      if(std::ranges::find(action_node.parents, last_position) == action_node.parents.end()) {
        action_node.parents.push_back(last_position);
      }
    }
    last_position_by_entity[entity] = position;
    scheduled_actions.push_back(std::move(action_node));
  }
  return scheduled_actions;
}

void WriteJobActionIndices(
    PlanContextSPtr ctx, const std::vector<interfaces::msg::ActionNode>& scheduled_actions) {
  std::unordered_map<interfaces::msg::Guid, size_t> job_position_by_guid;
  for(size_t job_position = 0; job_position < ctx->scheduled_jobs.size(); ++job_position) {
    job_position_by_guid[ctx->scheduled_jobs[job_position].job.guid] = job_position;
  }
  for(size_t position = 0; position < scheduled_actions.size(); ++position) {
    const auto job_position = job_position_by_guid.at(scheduled_actions[position].job_id);
    ctx->scheduled_jobs[job_position].node_indices.push_back(position);
  }
}

}  // namespace

stdx::Expected<std::vector<interfaces::msg::ActionNode>> Scheduler::BuildActionGraph(
    PlanContextSPtr ctx, const ContinuousState& final_state) const {
  std::set<Motion, MotionScheduleOrder> all_motions;
  if(const auto collected = CollectAndCollapseTrajectoryMotions(final_state, *layout_, all_motions);
      !collected) {
    LOG_ERROR(logger_, "{}", collected.error());
    return stdx::Unexpected(collected.error());
  }

  ActionSpanByEvent action_span_by_event;
  Dag<interfaces::msg::ActionNode> final_actions_dag;
  GarageOccupancyChecker<std::shared_ptr<interfaces::msg::ActionNode>> occupancy_history(
      collision_table_, motion_graph_);
  if(const auto built = BuildActionDagFromMotions(
         all_motions, ctx, final_actions_dag, occupancy_history, action_span_by_event);
      !built) {
    LOG_ERROR(logger_, "{}", built.error());
    return stdx::Unexpected(built.error());
  }

  PrintDagIfEnabled(final_actions_dag, *ctx, "after_occupancy_ordering");
  if(const auto reduced = final_actions_dag.RemoveRedundantEdges(); !reduced) {
    LOG_ERROR(logger_, "{}", reduced.error());
    return stdx::Unexpected(reduced.error());
  }
  PrintDagIfEnabled(final_actions_dag, *ctx, "after_occupancy_ordering_reduced");

  // Tray-move deps land on the lifts, not the motions; occupancy_history handles motion conflicts.
  if(const auto transferred = TransferEventDagDepsToActionDag(ctx, action_span_by_event, final_actions_dag);
      !transferred) {
    LOG_ERROR(logger_, "{}", transferred.error());
    return stdx::Unexpected(transferred.error());
  }

  PrintDagIfEnabled(final_actions_dag, *ctx, "after_event_dag_merge");
  if(const auto reduced = final_actions_dag.RemoveRedundantEdges(); !reduced) {
    LOG_ERROR(logger_, "{}", reduced.error());
    return stdx::Unexpected(reduced.error());
  }
  PrintDagIfEnabled(final_actions_dag, *ctx, "after_event_dag_merge_reduced");

  const auto vrc_insertion_result =
      InsertVrcActionsIntoDag(final_actions_dag, *layout_, ctx->initial_state, cost_model_);
  if(!vrc_insertion_result.has_value()) {
    LOG_ERROR(logger_, "{}", vrc_insertion_result.error());
    return stdx::Unexpected(vrc_insertion_result.error());
  }

  if(const auto reduced = final_actions_dag.RemoveRedundantEdges(); !reduced) {
    LOG_ERROR(logger_, "{}", reduced.error());
    return stdx::Unexpected(reduced.error());
  }
  PrintDagIfEnabled(final_actions_dag, *ctx, "after_vrc_insertion");

  const auto final_ordering = final_actions_dag.GetTopologicalOrdering();
  if(!final_ordering.has_value()) {
    LOG_ERROR(logger_, "Failed to get final ordering for action DAG!");
    return stdx::Unexpected("Failed to get final ordering for action DAG!");
  }

  auto scheduled_actions = BuildScheduledActionsArray(final_actions_dag, *final_ordering);
  WriteJobActionIndices(ctx, scheduled_actions);
  return scheduled_actions;
}

