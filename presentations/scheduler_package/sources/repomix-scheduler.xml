#include <interfaces/msg/bay_command.hpp>
#include <interfaces/msg/bay_report.hpp>
#include <interfaces/msg/discrete_agv_state.hpp>
#include <interfaces/msg/discrete_bay_state.hpp>
#include <interfaces/msg/discrete_payload_state.hpp>
#include <interfaces/msg/discrete_tray_state.hpp>
#include <interfaces/msg/discrete_vecs_state.hpp>
#include <interfaces/msg/garage_node.hpp>
#include <interfaces/msg/garage_pose.hpp>
#include <interfaces/msg/guid.hpp>
#include <interfaces/msg/vecs_report.hpp>
#include <motion_planner/agv_hiding_search.hpp>
#include <motion_planner/interval.hpp>
#include <ranges>
#include <rclcppx/logging.hpp>
#include <unordered_set>

#include "scheduler/bay_rebalancing.hpp"
#include "scheduler/format.hpp"
#include "scheduler/move_events.hpp"
#include "scheduler/scheduler.hpp"
#include "scheduler/utils.hpp"

namespace volley::scheduler {

namespace {

[[nodiscard]] stdx::Expected<DiscreteGarageState> ComputeStateAfterPlannedEvents(const PlanContext& ctx) {
  auto state = ctx.initial_state;
  if(const auto applied = ctx.event_dag.ApplyEventsTo(state); !applied) {
    return stdx::Unexpected(applied.error());
  }
  return state;
}

bool IsTrayReversedOnAgv(
    const interfaces::msg::DiscreteAgvState& agv, const interfaces::msg::DiscreteTrayState& tray) {
  return IsReciprocal(agv.pose.heading, tray.pose.heading);
}

interfaces::msg::VecsStateChanged MakeVecsStateChange(
    uint16_t vecs_id, uint8_t state_curr, uint8_t state_next) {
  interfaces::msg::VecsStateChanged state_change {};
  state_change.vecs_id = vecs_id;
  state_change.state_curr = state_curr;
  state_change.state_next = state_next;
  return state_change;
}

interfaces::msg::BayCommand MakeBayCommand(uint8_t command_type, uint64_t placeholder_id, uint8_t floor = 0) {
  interfaces::msg::BayCommand command;
  command.command_type = command_type;
  command.command_id = std::to_string(MakeGuid(0, placeholder_id));
  command.floor = floor;
  return command;
}

// The schedule replaces these ids with each action node's GUID.
constexpr uint64_t kBayTransitionPlaceholderId = 1;

constexpr uint64_t kBayProcessPlaceholderId = 2;

bool IsEvChargeRequested(const DiscreteGarageState& state, const interfaces::msg::Guid& payload_id) {
  const auto payload_opt = state.GetPayload(payload_id);
  return payload_opt.has_value() && payload_opt->payload.ev_charge_requested;
}

void OrderAfterBayAndChargerEvents(PlanContext& ctx, const DiscreteGarageState& working_state,
    const interfaces::msg::GaragePose& dest, const ScheduleEventSPtr& tray_move) {
  const auto& last_event_by_entity = ctx.last_event_by_entity;
  if(const auto bay_opt = working_state.GetBay(dest.node_id)) {
    if(const auto it = last_event_by_entity.find(BayId(bay_opt->id)); it != last_event_by_entity.end()) {
      ctx.event_dag.AddDependency(it->second, tray_move);
    }
  }
  if(const auto ev_charger_opt = working_state.GetVecs(dest.node_id)) {
    if(const auto it = last_event_by_entity.find(VecsId(ev_charger_opt->id));
        it != last_event_by_entity.end()) {
      ctx.event_dag.AddDependency(it->second, tray_move);
    }
  }
}

stdx::Result AddChargingStopBeforeTrayMove(
    PlanContext& ctx, const interfaces::msg::DiscreteVecsState& ev_charger, size_t job_index) {
  if(ev_charger.state == interfaces::msg::VecsReport::READY_TO_CHARGE) {
    return {};
  }
  if(ev_charger.state != interfaces::msg::VecsReport::CHARGING) {
    return stdx::Unexpected(
        "{} is in state {}, neither charging nor ready to charge", VecsId(ev_charger.id), ev_charger.state);
  }
  ctx.AddChainedEvent(std::make_shared<VecsTransition>(
      job_index, MakeVecsStateChange(ev_charger.id, interfaces::msg::VecsReport::CHARGING,
                     interfaces::msg::VecsReport::READY_TO_CHARGE)));
  return {};
}

}  // namespace

stdx::Expected<void, JobFailure> Scheduler::ExpandAgvMoveJob(
    PlanContextSPtr ctx, uint16_t agv_id, interfaces::msg::GaragePose dest, size_t job_index) const {
  auto working_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!working_state_or) {
    return Fail("Failed to apply the planned events: {}", working_state_or.error());
  }
  auto working_state = std::move(*working_state_or);

  const auto agv_opt = working_state.GetAgv(agv_id);
  if(!agv_opt) {
    return Fail("Tried to move a{} which doesn't exist!", agv_id);
  }
  const auto& agv = *agv_opt;
  if(agv.disabled) {
    return Fail("Tried to move a disabled agv {}", agv_id);
  }
  if(agv.pose == dest) {
    return {};
  }

  // A carried tray may take its retrieval heading, which turns the AGV with it.
  auto agv_dest = dest;
  std::optional<interfaces::msg::GaragePose> tray_dest;
  if(IsCarryingTray(agv)) {
    const auto tray = working_state.GetTray(agv.tray_id).value();
    tray_dest = ResolveCarriedTrayDestination(dest, agv, tray, working_state.GetPayload(tray.payload_id));
    agv_dest = IsTrayReversedOnAgv(agv, tray) ? ReversePoseHeading(*tray_dest) : *tray_dest;
  }

  const auto dest_vertex_opt = motion_graph_.GetVertexFromPose(agv_dest);
  if(!dest_vertex_opt) {
    return Fail("Tried to move an agv to a destination that doesn't exist: {}", agv_dest);
  }
  const auto collision_id = CollisionEntityIdFromAgvState(agv, working_state, *layout_);
  const auto keep_out_filter_or = ctx->FindKeepOutFilter(collision_id);
  if(!keep_out_filter_or) {
    return Fail("{}", keep_out_filter_or.error());
  }
  const auto& keep_out_filter = keep_out_filter_or->get();
  if(!keep_out_filter.IsEnabled(*dest_vertex_opt)) {
    return Fail("Tried to move an agv to a disabled location: {}", agv_dest);
  }

  ScheduleEventSPtr new_event;
  if(tray_dest) {
    new_event = MakeTrayMove(job_index, agv.tray_id, tray_dest, agv_id);
  }
  else {
    new_event = MakeAgvPoseMove(job_index, agv_id, agv.pose, agv_dest);
  }
  ctx->AddChainedEvent(new_event);
  ctx->OrderAfterJobLeafEvents(new_event);

  return {};
}

interfaces::msg::GaragePose Scheduler::ResolveCarriedTrayDestination(
    const interfaces::msg::GaragePose& agv_dest, const interfaces::msg::DiscreteAgvState& agv,
    const interfaces::msg::DiscreteTrayState& tray,
    const std::optional<interfaces::msg::DiscretePayloadState>& payload_opt) const {
  auto tray_dest = IsTrayReversedOnAgv(agv, tray) ? ReversePoseHeading(agv_dest) : agv_dest;
  tray_dest.heading =
      FindPreferredTrayHeadingForRetrieval(tray_dest.node_id, payload_opt).value_or(tray_dest.heading);
  return tray_dest;
}

stdx::Expected<void, JobFailure> Scheduler::ExpandRetrieveJob(
    PlanContextSPtr ctx, const interfaces::msg::Guid& payload_id, size_t job_index) const {
  auto working_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!working_state_or) {
    return Fail("Failed to apply the planned events: {}", working_state_or.error());
  }
  auto working_state = std::move(*working_state_or);

  auto payload_opt = working_state.GetPayload(payload_id);

  if(!payload_opt.has_value()) {
    return Fail("Requested retrieve of unknown payload {}", payload_id);
  }
  const auto& payload = *payload_opt;

  // ValidateBaseState guarantees that the payload's tray and the tray's pose exist.
  const auto tray = working_state.GetTray(payload.tray_id).value();
  const auto collision_id = CollisionEntityIdFromPayloadState(payload, *layout_);
  const auto keep_out_filter_or = ctx->FindKeepOutFilter(collision_id);
  if(!keep_out_filter_or) {
    return Fail("{}", keep_out_filter_or.error());
  }
  const auto& keep_out_filter = keep_out_filter_or->get();
  if(!keep_out_filter.IsEnabled(motion_graph_.GetVertexFromPose(tray.pose).value())) {
    return Fail("Payload requested for retrieve is in a disabled area {}", tray.pose);
  }

  if(const auto ev_charger_opt = working_state.GetVecs(tray.pose.node_id)) {
    if(const auto charging_stop = AddChargingStopBeforeTrayMove(*ctx, *ev_charger_opt, job_index);
        !charging_stop) {
      return stdx::Unexpected(
          JobFailure {.message = std::format(
                          "Requested retrieve of payload that is on a VECS: {}", charging_stop.error()),
              .is_retryable = true});
    }
  }

  auto bay_opt = FindBayForRetrieve(working_state, payload);
  if(!bay_opt.has_value()) {
    return stdx::Unexpected(JobFailure {.message = "No Bay available for retrieve!", .is_retryable = true});
  }
  auto& planned_bay = *bay_opt;

  if(planned_bay.state == interfaces::msg::BayReport::STATE_READY_TO_INSERT ||
      planned_bay.state == interfaces::msg::BayReport::STATE_VEHICLE_INSERTED) {
    const auto retrieve_floor = layout_->GetBayRetrieveFloor(planned_bay.id).value_or(0);
    const auto command = MakeBayCommand(interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_RETRIEVE,
        kBayTransitionPlaceholderId, retrieve_floor);
    const auto transition = std::make_shared<BayTransition>(job_index, planned_bay, command);
    ctx->AddChainedEvent(transition);
    planned_bay.state = interfaces::msg::BayReport::STATE_READY_TO_RETRIEVE;
  }

  // Reparked here rather than in ResolveBlockingTrays so AGV assignment clears the bay first.
  auto tray_in_bay = working_state.GetTrayOnNode(planned_bay.id);
  if(tray_in_bay.has_value()) {
    if(const auto tray_repark = ExpandReparkTrayJob(ctx, tray_in_bay->id, job_index, true); !tray_repark) {
      return Fail("Failed to clear tray from bay before retrieve: {}", tray_repark.error().message);
    }
  }

  const auto bay_inbound_pose = MakeBayInboundPose(planned_bay.id);

  auto payload_tray_dest =
      payload.reciprocal_to_tray ? bay_inbound_pose : ReversePoseHeading(bay_inbound_pose);

  if(const auto tray_repark = ExpandReparkTrayJob(ctx, payload.tray_id, job_index, false, payload_tray_dest);
      !tray_repark) {
    return stdx::Unexpected(tray_repark.error());
  }

  const auto bay_transition = std::make_shared<BayTransition>(job_index, planned_bay,
      MakeBayCommand(interfaces::msg::BayCommand::COMMAND_TYPE_PROCESS_RETRIEVE, kBayProcessPlaceholderId));
  ctx->AddChainedEvent(bay_transition);

  ctx->OrderAfterJobLeafEvents(bay_transition);

  return {};
}

stdx::Expected<void, JobFailure> Scheduler::ExpandReparkTrayJob(PlanContextSPtr ctx,
    std::optional<uint16_t> tray_id, size_t job_index, bool is_reciprocal_heading_allowed,
    std::optional<interfaces::msg::GaragePose> dest) const {
  if(!tray_id && !dest) {
    return Fail("Requested repark of tray with no tray_id or destination");
  }

  auto working_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!working_state_or) {
    return Fail("Failed to apply the planned events: {}", working_state_or.error());
  }
  auto working_state = std::move(*working_state_or);

  std::optional<interfaces::msg::DiscreteTrayState> tray_opt;
  if(tray_id) {
    tray_opt = working_state.GetTray(*tray_id);
    if(!tray_opt) {
      // A move without a destination earlier in this plan takes the tray out of the planned state.
      tray_opt = ctx->initial_state.GetTray(*tray_id);
    }
    if(!tray_opt) {
      return Fail("Requested repark of tray {} which does not exist in discrete state", *tray_id);
    }
    if(tray_opt->disabled) {
      return Fail("Requested repark of disabled tray {}", *tray_id);
    }
    if(const auto ev_charger_opt = working_state.GetVecs(tray_opt->pose.node_id)) {
      if(const auto charging_stop = AddChargingStopBeforeTrayMove(*ctx, *ev_charger_opt, job_index);
          !charging_stop) {
        return Fail("Requested repark of tray that is on a VECS: {}", charging_stop.error());
      }
    }
  }

  if(dest) {
    if(tray_opt) {
      const auto payload_opt = working_state.GetPayload(tray_opt->payload_id);
      const auto retrieval_heading_opt = FindPreferredTrayHeadingForRetrieval(dest->node_id, payload_opt);
      if(is_reciprocal_heading_allowed && IsParkingWithoutBayOrCharger(working_state, dest->node_id)) {
        if(payload_opt) {
          dest->heading = retrieval_heading_opt.value_or(dest->heading);
        }
        else {
          KeepTrayHeadingIfEquivalent(*dest, tray_opt->pose.heading);
        }
      }
      if(tray_opt->pose == *dest) {
        return {};
      }
      dest->heading = retrieval_heading_opt.value_or(dest->heading);
    }
    if(const auto usable = CheckReparkDestination(*ctx, working_state, tray_opt, *dest); !usable) {
      return usable;
    }
  }

  const auto tray_move = MakeTrayMove(job_index, tray_id, dest);
  ctx->AddChainedEvent(tray_move);
  if(dest) {
    OrderAfterBayAndChargerEvents(*ctx, working_state, *dest, tray_move);
  }
  ctx->OrderAfterJobLeafEvents(tray_move);

  return {};
}

stdx::Expected<void, JobFailure> Scheduler::CheckReparkDestination(PlanContext& ctx,
    const DiscreteGarageState& working_state,
    const std::optional<interfaces::msg::DiscreteTrayState>& tray_opt,
    const interfaces::msg::GaragePose& dest) const {
  if(const auto ev_charger_opt = working_state.GetVecs(dest.node_id);
      ev_charger_opt && ev_charger_opt->state != interfaces::msg::VecsReport::READY_TO_CHARGE) {
    return Fail("Requested repark to destination {} that has a VECS not in Ready to Charge!", dest);
  }
  CollisionEntityId_t collision_id = common::EnumInteger(CollisionEntityId::TRAY);
  if(tray_opt) {
    collision_id = CollisionEntityIdFromTrayState(*tray_opt, working_state, *layout_);
  }
  const auto dest_vertex_opt = motion_graph_.GetVertexFromPose(dest);
  if(!dest_vertex_opt) {
    return Fail("Destination for repark tray does not exist {}", dest);
  }
  const auto keep_out_filter_or = ctx.FindKeepOutFilter(collision_id);
  if(!keep_out_filter_or) {
    return Fail("{}", keep_out_filter_or.error());
  }
  const auto& keep_out_filter = keep_out_filter_or->get();
  if(!keep_out_filter.IsEnabled(*dest_vertex_opt)) {
    return Fail("Destination for repark tray is in a disabled area {}", dest);
  }
  if(const auto bay_opt = working_state.GetBay(dest.node_id); bay_opt && bay_opt->disabled) {
    return Fail("Destination for repark tray is in a disabled bay {}", dest);
  }
  return {};
}

stdx::Result Scheduler::AddBayTransitionToRetrieve(
    PlanContextSPtr ctx, const interfaces::msg::DiscreteBayState& bay, size_t job_index) const {
  const auto floor = GetFirstSystemFloor(bay.id);
  if(!floor) {
    return stdx::Unexpected("Requested to transition b{} to READY_TO_RETRIEVE: {}", bay.id, floor.error());
  }

  const auto bay_transition = std::make_shared<BayTransition>(job_index, bay,
      MakeBayCommand(interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_RETRIEVE,
          kBayTransitionPlaceholderId, *floor));
  ctx->AddChainedEvent(bay_transition);
  ctx->OrderAfterJobLeafEvents(bay_transition);

  return {};
}

stdx::Expected<void, JobFailure> Scheduler::ExpandInsertJob(
    PlanContextSPtr ctx, uint16_t bay_id, size_t job_index) const {
  auto working_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!working_state_or) {
    return Fail("Failed to apply the planned events: {}", working_state_or.error());
  }
  auto working_state = std::move(*working_state_or);

  auto bay_opt = working_state.GetBay(bay_id);
  if(!bay_opt.has_value()) {
    return Fail("Requested InsertJob for bay {} but the bay is not in discrete state", bay_id);
  }
  const auto& bay = *bay_opt;

  if(bay.disabled) {
    return Fail("Requested insert for disabled bay {}", bay_id);
  }

  auto tray_opt = working_state.GetTrayOnNode(bay.id);

  if(!tray_opt.has_value()) {
    return Fail("Requested InsertJob for bay {} but the bay has no tray in discrete state.", bay_id);
  }
  const auto& tray = *tray_opt;

  if(!HasPayload(tray)) {
    return Fail("Requested insert into bay {} but tray {} does not have a payload", bay_id, tray.id);
  }

  if(bay.state != interfaces::msg::BayReport::STATE_VEHICLE_INSERTED &&
      bay.state != interfaces::msg::BayReport::STATE_READY_TO_RETRIEVE) {
    return Fail("Requested InsertJob for bay {} but bay state is {}", bay_id, bay.state);
  }

  if(const auto retrieve_transition = AddBayTransitionToRetrieve(ctx, bay, job_index); !retrieve_transition) {
    return Fail("{}", retrieve_transition.error());
  }

  if(const auto tray_repark = ExpandReparkTrayJob(ctx, tray.id, job_index, true); !tray_repark) {
    return stdx::Unexpected(tray_repark.error());
  }

  // Requested as a separate job, so a missing empty tray or an AGV conflict cannot fail this insert.
  if(reset_bay_state_request_fn_) {
    reset_bay_state_request_fn_(bay_id, interfaces::msg::BayReport::STATE_READY_TO_INSERT);
  }

  return {};
}

stdx::Expected<void, JobFailure> Scheduler::ExpandReadyForInsertJob(
    PlanContextSPtr ctx, uint16_t bay_id, size_t job_index) const {
  auto working_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!working_state_or) {
    return Fail("Failed to apply the planned events: {}", working_state_or.error());
  }
  auto working_state = std::move(*working_state_or);

  auto bay_opt = working_state.GetBay(bay_id);

  if(!bay_opt) {
    return Fail(
        "Requested unknown {} to ready for insert but bay does not exist in discrete state", BayId(bay_id));
  }
  const auto& bay = *bay_opt;

  if(bay.state != interfaces::msg::BayReport::STATE_READY_TO_RETRIEVE) {
    return Fail(
        "Requested to transition {} to ready for insert but bay state is not READY_TO_RETRIEVE. State: {}",
        BayId(bay_id), bay.state);
  }

  auto tray_in_bay_opt = working_state.GetTrayOnNode(bay.id);
  const auto empty_tray_dest = MakeBayInboundPose(bay.id);

  const bool is_bay_tray_loaded = tray_in_bay_opt && HasPayload(*tray_in_bay_opt);
  if(is_bay_tray_loaded && IsEvChargeRequested(working_state, tray_in_bay_opt->payload_id)) {
    if(const auto payload_charge = ExpandChargePayloadJob(ctx, tray_in_bay_opt->payload_id, job_index);
        !payload_charge) {
      return Fail("Failed to plan a charge payload job: {}", payload_charge.error().message);
    }
  }
  const bool is_empty_tray_needed = !tray_in_bay_opt || is_bay_tray_loaded;
  if(is_empty_tray_needed) {
    if(const auto tray_repark = ExpandReparkTrayJob(ctx, std::nullopt, job_index, true, empty_tray_dest);
        !tray_repark) {
      return stdx::Unexpected(tray_repark.error());
    }
  }

  // working_state predates the reparks above.
  if(const auto fill_assignment = AssignTraysToBayFillMoves(ctx, job_index); !fill_assignment) {
    return fill_assignment;
  }

  const auto bay_transition = std::make_shared<BayTransition>(job_index, bay,
      MakeBayCommand(
          interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_INSERT, kBayTransitionPlaceholderId));
  ctx->AddChainedEvent(bay_transition);
  ctx->OrderAfterJobLeafEvents(bay_transition);

  return {};
}

stdx::Expected<void, JobFailure> Scheduler::ExpandReadyForRetrieveJob(
    PlanContextSPtr ctx, uint16_t bay_id, size_t job_index) const {
  auto working_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!working_state_or) {
    return Fail("Failed to apply the planned events: {}", working_state_or.error());
  }
  auto working_state = std::move(*working_state_or);

  auto bay_opt = working_state.GetBay(bay_id);

  if(!bay_opt.has_value()) {
    return Fail(
        "Requested unknown {} to ready for retrieve but bay does not exist in discrete state", BayId(bay_id));
  }
  const auto& bay = *bay_opt;

  if(bay.state != interfaces::msg::BayReport::STATE_READY_TO_INSERT &&
      bay.state != interfaces::msg::BayReport::STATE_READY_TO_RETRIEVE) {
    return Fail(
        "Requested to transition {} to ready for retrieve but bay state is not READY_TO_INSERT or "
        "READY_TO_RETRIEVE. State: {}",
        BayId(bay_id), bay.state);
  }

  if(bay.state == interfaces::msg::BayReport::STATE_READY_TO_INSERT) {
    if(const auto retrieve_transition = AddBayTransitionToRetrieve(ctx, bay, job_index);
        !retrieve_transition) {
      return Fail("{}", retrieve_transition.error());
    }
  }

  auto tray_in_bay_opt = working_state.GetTrayOnNode(bay.id);

  if(tray_in_bay_opt.has_value()) {
    if(IsEvChargeRequested(working_state, tray_in_bay_opt->payload_id)) {
      const auto payload_charge = ExpandChargePayloadJob(ctx, tray_in_bay_opt->payload_id, job_index);
      if(!payload_charge) {
        return Fail("Failed to plan a charge payload job: {}", payload_charge.error().message);
      }
    }
    else {
      const auto bay_clearing = ExpandReparkTrayJob(ctx, tray_in_bay_opt->id, job_index, true);
      if(!bay_clearing) {
        return Fail("Failed to clear tray from bay: {}", bay_clearing.error().message);
      }
    }
  }

  return {};
}

stdx::Expected<void, JobFailure> Scheduler::ExpandCleanGarageJob(
    PlanContextSPtr ctx, size_t job_index) const {
  auto working_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!working_state_or) {
    return Fail("Failed to apply the planned events: {}", working_state_or.error());
  }
  auto working_state = std::move(*working_state_or);

  if(job_index == 0) {
    const auto pose_under_tray_by_agv_opt = FindAgvUnderTrayAssignment(working_state, collision_table_);
    if(!pose_under_tray_by_agv_opt) {
      return Fail("Failed to assign AGVs to tray hiding spots");
    }

    for(const auto& [agv_id, dest] : *pose_under_tray_by_agv_opt) {
      auto agv_state = working_state.GetAgv(agv_id).value();

      if(agv_state.pose != dest) {
        const auto agv_move = MakeAgvPoseMove(job_index, agv_id, agv_state.pose, dest);
        ctx->AddChainedEvent(agv_move);
        // Chain into the bay's entity too, so any bay transition waits for the AGV to arrive.
        if(working_state.HasBay(dest.node_id)) {
          ctx->ChainAfterLastEntityEvent(BayId(dest.node_id), agv_move);
        }
        if(const auto [is_applied, message] = agv_move->ApplyTo(working_state); !is_applied) {
          return Fail("Failed to apply {}: {}", agv_move->ToString(), message);
        }
      }
    }
  }

  const auto stashed_tray_repark = ReparkWaypointStashedTrays(ctx, job_index);
  if(!stashed_tray_repark) {
    LOG_WARN(logger_, "Failed to repark the trays stashed on waypoints: {}", stashed_tray_repark.error());
  }

  return {};
}

stdx::Result Scheduler::ReparkWaypointStashedTrays(PlanContextSPtr ctx, size_t job_index) const {
  auto working_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!working_state_or) {
    return stdx::Unexpected("Failed to apply the planned events: {}", working_state_or.error());
  }
  auto working_state = std::move(*working_state_or);

  for(const auto& [tray_id, tray] : working_state.GetTrays()) {
    const auto node_opt = layout_->GetNodeById(tray.pose.node_id);
    if(tray.disabled || !node_opt || node_opt->type != interfaces::msg::GarageNode::TYPE_WAYPOINT) {
      continue;
    }
    const auto tray_repark =
        ExpandReparkTrayJob(ctx, tray_id, job_index, /*is_reciprocal_heading_allowed=*/true);
    if(!tray_repark) {
      LOG_WARN(logger_, "Skipping stashed tray {}: {}", std::to_string(TrayId(tray_id)),
          tray_repark.error().message);
    }
  }
  return {};
}

// AGVs are not hidden under trays: more work is expected to follow.
stdx::Expected<void, JobFailure> Scheduler::ExpandRebalanceGarageJob(
    PlanContextSPtr ctx, size_t job_index) const {
  auto working_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!working_state_or) {
    return Fail("Failed to apply the planned events: {}", working_state_or.error());
  }
  auto working_state = std::move(*working_state_or);

  auto [transition_to_insert_bays, transition_to_retrieve_bays] = ComputeBayRebalancingActions(
      working_state, layout_->GetBayPrioritization(), target_insert_ready_bay_fraction_);

  for(auto bay_id : transition_to_insert_bays) {
    const auto insert_readiness = ExpandReadyForInsertJob(ctx, bay_id, job_index);
    if(!insert_readiness) {
      LOG_WARN(logger_, "Failed to rebalance {} to READY_TO_INSERT: {}", std::to_string(BayId(bay_id)),
          insert_readiness.error().message);
    }
  }
  for(auto bay_id : transition_to_retrieve_bays) {
    const auto retrieve_readiness = ExpandReadyForRetrieveJob(ctx, bay_id, job_index);
    if(!retrieve_readiness) {
      LOG_WARN(logger_, "Failed to rebalance {} to READY_TO_RETRIEVE: {}", std::to_string(BayId(bay_id)),
          retrieve_readiness.error().message);
    }
  }

  return {};
}

stdx::Expected<void, JobFailure> Scheduler::ExpandAgvChargeJob(
    PlanContextSPtr ctx, uint16_t agv_id, size_t job_index) const {
  auto working_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!working_state_or) {
    return Fail("Failed to apply the planned events: {}", working_state_or.error());
  }
  auto working_state = std::move(*working_state_or);

  auto agv_opt = working_state.GetAgv(agv_id);
  if(!agv_opt.has_value()) {
    return Fail("Cannot plan Charge AGV job: {}", AgvId(agv_id));
  }
  auto agv = agv_opt.value();

  if(agv.disabled) {
    return Fail("Can't charge {} because it's disabled.", AgvId(agv_id));
  }

  auto current_node = layout_->GetNodeById(agv.pose.node_id).value();
  if(current_node.type == interfaces::msg::GarageNode::TYPE_AGV_CHARGE &&
      agv.pose == MakeInboundPose(current_node)) {
    return {};
  }

  std::optional<interfaces::msg::DiscreteBayState> trapping_bay_opt = std::nullopt;
  if(current_node.type == interfaces::msg::GarageNode::TYPE_BAY) {
    auto bay_state = working_state.GetBay(current_node.id)->state;
    if(bay_state == interfaces::msg::BayReport::STATE_READY_TO_INSERT) {
      // A Charge job means the battery is low, so free the AGV even at the cost of a bay transition.
      const auto bay_transition =
          std::make_shared<BayTransition>(job_index, working_state.GetBay(current_node.id).value(),
              MakeBayCommand(interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_RETRIEVE,
                  kBayTransitionPlaceholderId, layout_->GetBayRetrieveFloor(current_node.id).value_or(0)));
      ctx->AddChainedEvent(bay_transition);
      if(const auto [is_applied, message] = bay_transition->ApplyTo(working_state); !is_applied) {
        return Fail(
            "Failed to apply {} before charging {}: {}", bay_transition->ToString(), AgvId(agv_id), message);
      }
      trapping_bay_opt = working_state.GetBay(current_node.id);
    }
    else if(bay_state != interfaces::msg::BayReport::STATE_READY_TO_RETRIEVE) {
      return Fail("Error. Can't charge {} because it's stuck in {} which is in state {}", AgvId(agv_id),
          BayId(current_node.id), bay_state);
    }
  }

  const auto charger_pose_with_shortest_travel =
      FindUnoccupiedChargerWithShortestTravelTime(*ctx, working_state, agv);
  if(!charger_pose_with_shortest_travel.has_value()) {
    return Fail(
        "Caution: No available charge nodes for {}. AGV state of charge is at risk. Discharge may be "
        "imminent.",
        AgvId(agv_id));
  }

  if(const auto agv_move = ExpandAgvMoveJob(ctx, agv_id, *charger_pose_with_shortest_travel, job_index);
      !agv_move) {
    return agv_move;
  }
  if(!trapping_bay_opt.has_value()) {
    return {};
  }
  return ExpandBayTransitionJob(
      ctx, trapping_bay_opt->id, interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_INSERT, job_index);
}

stdx::Expected<void, JobFailure> Scheduler::ExpandBayTransitionJob(
    PlanContextSPtr ctx, uint16_t bay_id, uint8_t command_type, size_t job_index) const {
  auto working_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!working_state_or) {
    return Fail("Failed to apply the planned events: {}", working_state_or.error());
  }
  auto working_state = std::move(*working_state_or);

  auto bay_opt = working_state.GetBay(bay_id);
  std::string bay_name = std::to_string(BayId(bay_id));

  uint8_t target_floor = 0;

  if(!bay_opt.has_value()) {
    return Fail("Requested to transition {} but bay does not exist in discrete state.", bay_name);
  }
  auto bay = bay_opt.value();

  if(bay.disabled) {
    return Fail("Requested to transition {} but it's disabled.", bay_name);
  }

  if(!IsBayOdpAreaClear(bay_id, working_state)) {
    return Fail("Requested to transition {} but the ODP's area is occupied.", bay_name);
  }

  if(command_type == interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_INSERT) {
    if(bay.state != interfaces::msg::BayReport::STATE_READY_TO_RETRIEVE) {
      return Fail("Can't transition {} to Ready for Insert because it's not in Ready for Retrieve, state: {}",
          bay_name, bay.state);
    }
  }
  else if(command_type == interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_RETRIEVE) {
    const auto floor = GetFirstSystemFloor(bay_id);
    if(!floor) {
      return Fail("Requested to transition {} to READY_TO_RETRIEVE: {}", bay_name, floor.error());
    }
    target_floor = *floor;

    if(bay.state != interfaces::msg::BayReport::STATE_READY_TO_INSERT &&
        bay.state != interfaces::msg::BayReport::STATE_VEHICLE_INSERTED) {
      return Fail(
          "Can't transition {} to Ready for Retrieve because it's not in Ready for Insert or vehicle "
          "inserted, state: {}",
          bay_name, bay.state);
    }
  }
  else {
    return Fail("Invalid bay transition type for {} : {}", bay_name, command_type);
  }

  const auto bay_transition = std::make_shared<BayTransition>(
      job_index, *bay_opt, MakeBayCommand(command_type, kBayTransitionPlaceholderId, target_floor));
  ctx->AddChainedEvent(bay_transition);
  ctx->OrderAfterJobLeafEvents(bay_transition);

  return {};
}

stdx::Expected<void, JobFailure> Scheduler::ExpandChargePayloadJob(
    PlanContextSPtr ctx, const interfaces::msg::Guid& payload_id, size_t job_index) const {
  auto working_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!working_state_or) {
    return Fail("Failed to apply the planned events: {}", working_state_or.error());
  }
  auto working_state = std::move(*working_state_or);

  auto payload_opt = working_state.GetPayload(payload_id);
  std::string payload_name = std::to_string(payload_id);

  if(!payload_opt.has_value()) {
    return Fail("Requested to charge {} but payload does not exist in discrete state.", payload_name);
  }
  auto payload = payload_opt.value();
  auto tray = working_state.GetTray(payload.tray_id).value();

  auto tray_node = layout_->GetNodeById(tray.pose.node_id).value();
  auto ev_charger_opt = working_state.GetVecs(tray.pose.node_id);
  uint16_t ev_charger_id = 0u;
  if(tray_node.type == interfaces::msg::GarageNode::TYPE_EV_CHARGE && ev_charger_opt.has_value() &&
      ev_charger_opt->state == interfaces::msg::VecsReport::READY_TO_CHARGE) {
    ev_charger_id = ev_charger_opt->id;
  }
  else {
    auto [dest_garage_pose_opt, _] = ResolveBlockingTrays(working_state, {.tray_id = tray.id}, job_index);
    if(!dest_garage_pose_opt.has_value()) {
      return Fail("Unable to ResolveBlockingTrays to a VECS location");
    }
    auto dest_garage_pose = dest_garage_pose_opt.value();

    auto dest_ev_charger_opt = working_state.GetVecs(dest_garage_pose.node_id);
    if(!dest_ev_charger_opt.has_value()) {
      return Fail("ResolveBlockingTrays was supposed to find a VECS node here, but returned a non-VECS one");
    }
    ev_charger_id = dest_ev_charger_opt->id;

    if(const auto tray_repark = ExpandReparkTrayJob(ctx, tray.id, job_index, false, dest_garage_pose);
        !tray_repark) {
      return stdx::Unexpected(tray_repark.error());
    }
  }

  const auto ev_charger_transition = std::make_shared<VecsTransition>(
      job_index, MakeVecsStateChange(ev_charger_id, interfaces::msg::VecsReport::READY_TO_CHARGE,
                     interfaces::msg::VecsReport::CHARGING));
  ctx->AddChainedEvent(ev_charger_transition);
  ctx->OrderAfterJobLeafEvents(ev_charger_transition);

  return {};
}

stdx::Expected<void, JobFailure> Scheduler::AssignTraysToBayFillMoves(
    PlanContextSPtr ctx, size_t job_index) const {
  auto fill_state_or = ComputeStateAfterPlannedEvents(*ctx);
  if(!fill_state_or) {
    return Fail("Failed to apply the planned events: {}", fill_state_or.error());
  }
  auto fill_state = std::move(*fill_state_or);
  const auto events = ctx->event_dag.GetEventsInTopologicalOrder();
  if(!events.has_value()) {
    return Fail("Failed to get a topological ordering of events");
  }
  for(const auto& event : *events) {
    auto* move = dynamic_cast<TrayMove*>(event.get());
    if(move == nullptr || event->GetJobIndex() != job_index || move->GetTrayId() || !move->GetDest()) {
      continue;
    }
    const auto tray_id_assignment = AssignEmptyTrayToMove(*move, fill_state);
    if(!tray_id_assignment) {
      // AssignTrays retries once other jobs have freed trays.
      LOG_WARN(logger_, "Deferring tray assignment for a bay-fill move: {}", tray_id_assignment.error());
      continue;
    }
    ctx->ChainAfterLastEntityEvent(move->GetGarageEntityId().value(), event);
    auto [apply_move_ok, apply_move_message] = move->ApplyTo(fill_state);
    if(!apply_move_ok) {
      return Fail("Failed to apply a resolved tray move: {}", apply_move_message);
    }
  }
  return {};
}

bool Scheduler::IsPayloadWithinBaySizeLimits(
    const interfaces::msg::DiscretePayloadState& payload, uint16_t bay_id) const {
  const auto bay_node_opt = layout_->GetNodeById(bay_id);
  if(!bay_node_opt.has_value()) {
    return true;
  }
  const auto bay_window_opt = layout_->GetResourceWindow(bay_node_opt->max_resource_size_index);
  if(!bay_window_opt.has_value()) {
    return true;
  }
  const float payload_length = payload.payload.length_m;
  const float payload_width = payload.payload.width_m;
  const float payload_height = payload.payload.height_m;
  if(payload_length > bay_window_opt->length_m || payload_width > bay_window_opt->width_m) {
    return false;
  }
  return !(
      payload_height > 0.0f && bay_window_opt->height_m > 0.0f && payload_height > bay_window_opt->height_m);
}

std::optional<interfaces::msg::DiscreteBayState> Scheduler::FindBayForRetrieve(
    const DiscreteGarageState& working_state, const interfaces::msg::DiscretePayloadState& payload) const {
  std::optional<interfaces::msg::DiscreteBayState> fallback_bay;
  // Most to least preferred for READY_TO_RETRIEVE.
  for(const auto bay_id : layout_->GetBayPrioritization() | std::views::reverse) {
    const auto bay_state_opt = working_state.GetBay(bay_id);
    if(!bay_state_opt.has_value() || bay_state_opt->disabled ||
        !IsPayloadWithinBaySizeLimits(payload, bay_id)) {
      continue;
    }
    if(bay_state_opt->state == interfaces::msg::BayReport::STATE_READY_TO_RETRIEVE) {
      return bay_state_opt;
    }
    if(!fallback_bay.has_value() &&
        (bay_state_opt->state == interfaces::msg::BayReport::STATE_READY_TO_INSERT ||
            bay_state_opt->state == interfaces::msg::BayReport::STATE_VEHICLE_INSERTED)) {
      fallback_bay = bay_state_opt;
    }
  }
  return fallback_bay;
}

std::optional<interfaces::msg::GaragePose> Scheduler::FindUnoccupiedChargerWithShortestTravelTime(
    const PlanContext& ctx, const DiscreteGarageState& working_state,
    const interfaces::msg::DiscreteAgvState& agv) const {
  const auto keep_out_filter_or = ctx.FindKeepOutFilter(common::EnumInteger(CollisionEntityId::AGV));
  if(!keep_out_filter_or) {
    return std::nullopt;
  }
  const auto& keep_out_filter = keep_out_filter_or->get();
  // Unoccupied means no AGV on the node, not collision free.
  const auto& charge_nodes = layout_->GetNodeIdsOfType(interfaces::msg::GarageNode::TYPE_AGV_CHARGE);
  std::optional<interfaces::msg::GaragePose> charger_pose_with_shortest_travel = std::nullopt;
  Interval::Duration shortest_travel_duration = Interval::Duration::max();
  const auto path_filter = BuildStaticObstacleFilter(common::EnumInteger(CollisionEntityId::AGV),
      motion_graph_, working_state, collision_table_, std::unordered_set<uint16_t>(),
      std::unordered_set<uint16_t>({agv.id}), std::unordered_set<uint16_t>());
  for(unsigned int charge_node_id : charge_nodes) {
    const auto agv_on_node_opt = working_state.GetAgvOnNode(charge_node_id);
    if(agv_on_node_opt.has_value()) {
      continue;
    }
    const auto charge_pose = MakeInboundPose(layout_->GetNodeById(charge_node_id).value());

    const auto dest_vertex_opt = motion_graph_.GetVertexFromPose(charge_pose);
    if(!dest_vertex_opt) {
      LOG_ERROR(logger_,
          "Something went very wrong trying to plan an AGV charge job for AGV {} to charge node {}@{} which "
          "doesn't exist in the graph",
          agv.id, charge_node_id, charge_pose.heading);
      continue;
    }

    if(!keep_out_filter.IsEnabled(*dest_vertex_opt)) {
      continue;
    }
    const auto travel_duration_opt =
        ComputeTravelDuration(agv.pose, charge_pose, AgvId(agv.id), IsCarryingTray(agv), path_filter);
    if(!travel_duration_opt.has_value()) {
      continue;
    }
    if(*travel_duration_opt < shortest_travel_duration) {
      shortest_travel_duration = *travel_duration_opt;
      charger_pose_with_shortest_travel = charge_pose;
    }
  }

  return charger_pose_with_shortest_travel;
}

