TEST(AgvAssignment, ChainsThreeMovesAcrossTwoAgvs) {
  const auto garage = scenarios::Stage("agv_assignment").initial;

  const auto scheduler = scenarios::SharedScheduler(garage.layout_path, SchedulerParams {});
  interfaces::msg::Guid request_id = MakeGuid(0, 0xDEADBEEF);
  const auto ctx = std::make_shared<PlanContext>(request_id, garage.state, scenarios::kNow);

  const auto tray_move_1 = std::make_shared<TrayMove>(0u);
  tray_move_1->SetTrayId(2);
  interfaces::msg::GaragePose end_pose;
  end_pose.node_id = 2064;
  end_pose.heading = 90;
  tray_move_1->SetDest(end_pose);
  ctx->event_dag.AddEvent(tray_move_1);

  const auto tray_move_2 = std::make_shared<TrayMove>(1u);
  tray_move_2->SetTrayId(1);
  end_pose.node_id = 2067;
  end_pose.heading = 90;
  tray_move_2->SetDest(end_pose);
  ctx->event_dag.AddEvent(tray_move_2);
  ctx->event_dag.AddDependency(tray_move_1, tray_move_2);

  const auto tray_move_3 = std::make_shared<TrayMove>(2u);
  tray_move_3->SetTrayId(2);
  end_pose.node_id = 2068;
  end_pose.heading = 0;
  tray_move_3->SetDest(end_pose);
  ctx->event_dag.AddEvent(tray_move_3);
  ctx->event_dag.AddDependency(tray_move_2, tray_move_3);

  const auto dag_before_agv = scenarios::Dag(*ctx);
  const auto agv_assignment = scheduler->AssignAgvs(ctx);
  scenarios::ExpectStage("agv_assignment", dag_before_agv, *ctx);
  EXPECT_TRUE(agv_assignment) << agv_assignment.error();

  EXPECT_TRUE(tray_move_1->GetAgvId().has_value());
  EXPECT_TRUE(tray_move_2->GetAgvId().has_value());
  EXPECT_TRUE(tray_move_3->GetAgvId().has_value());

  EXPECT_EQ(tray_move_1->GetAgvId().value(), 1);
  EXPECT_EQ(tray_move_2->GetAgvId().value(), 1);
  EXPECT_EQ(tray_move_3->GetAgvId().value(), 8);

  // The transitive reduction at the end of AssignAgvs drops the direct tray-move edges:
  // the per-AGV chains and the node-arrival dependencies already order them (the apply loop
  // below checks the order).
  EXPECT_FALSE(ctx->event_dag.HasDependency(tray_move_1, tray_move_2));
  EXPECT_FALSE(ctx->event_dag.HasDependency(tray_move_2, tray_move_3));

  // Apply the events and check where everything ends up.
  const auto new_total_ordering_or = ctx->event_dag.GetTopologicalOrdering();
  ASSERT_TRUE(new_total_ordering_or.has_value());
  for(const auto& event_vert : new_total_ordering_or.value()) {
    const auto event = ctx->event_dag.GetEvent(event_vert);
    EXPECT_TRUE(event->ApplyTo(ctx->initial_state).first);
  }
  const auto tray_1 = ctx->initial_state.GetTray(1);
  const auto tray_2 = ctx->initial_state.GetTray(2);
  ASSERT_TRUE(tray_1.has_value() && tray_2.has_value());
  EXPECT_EQ(tray_move_2->GetDest(), tray_1->pose);
  EXPECT_EQ(tray_move_3->GetDest(), tray_2->pose);
}

