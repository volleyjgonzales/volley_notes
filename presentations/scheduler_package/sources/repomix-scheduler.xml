constexpr auto kDestination = "destination"sv;
constexpr auto kNote = "note"sv;
constexpr auto kAllowReciprocal = "allow_reciprocal"sv;
constexpr std::string_view kJobKeys[] = {
    kType, kAgvId, kBayId, kTrayId, kPayload, kDestination, kNote, kAllowReciprocal};

constexpr auto kFrom = "from"sv;
constexpr auto kTo = "to"sv;
constexpr std::string_view kCommandKeys[] = {kAgvId, kFrom, kTo};

constexpr auto kTargetInsertReadyBayFraction = "target_insert_ready_bay_fraction"sv;
constexpr std::string_view kParamsKeys[] = {kTargetInsertReadyBayFraction};

constexpr auto kJobs = "jobs"sv;
constexpr auto kBaseSchedule = "base_schedule"sv;
constexpr std::string_view kRequestKeys[] = {kJobs, kBaseSchedule};

const std::map<std::string, uint8_t> kJobTypes = {
    {"MOVE_AGV", interfaces::msg::SchedulerJob::TYPE_MOVE_AGV},
    {"MOVE_TRAY", interfaces::msg::SchedulerJob::TYPE_MOVE_TRAY},
    {"READY_FOR_INSERT", interfaces::msg::SchedulerJob::TYPE_READY_FOR_INSERT},
