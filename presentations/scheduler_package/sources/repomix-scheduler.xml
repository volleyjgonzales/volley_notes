    agv_pose_changed.heading_next = 90;
    auto [success, msg] = ctx->initial_state.OnEvent(agv_pose_changed);
    EXPECT_TRUE(success) << msg;
    auto cost_or =
        scheduler->ComputeAgvAssignmentCost(agv_id, *tray_move, ctx->initial_state, occupied_duration);
    EXPECT_TRUE(cost_or.has_value());
    EXPECT_GT(cost_or.value(), k_lift_lower_seconds + occupied_duration);
  }
  {
    // The AGV is holding a different tray: nullopt
    const auto occupied_duration = Interval::Duration::zero();
    interfaces::msg::AgvLiftChanged agv_lift_changed {};
    agv_lift_changed.agv_id = 1;
    agv_lift_changed.raised = true;
    auto [success, msg] = ctx->initial_state.OnEvent(agv_lift_changed);
    EXPECT_TRUE(success);
    auto cost_or =
        scheduler->ComputeAgvAssignmentCost(agv_id, *tray_move, ctx->initial_state, occupied_duration);
    EXPECT_FALSE(cost_or.has_value());
  }
}

