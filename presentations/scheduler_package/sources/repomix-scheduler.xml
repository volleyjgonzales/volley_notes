TEST(SchedulerState, ChainAfterLastEntityEvent) {
  const auto layout_filepath_or = GetLayoutPathByName(kLayoutName);
  ASSERT_TRUE(layout_filepath_or.has_value()) << layout_filepath_or.error();
  const auto& layout_filepath = layout_filepath_or.value();

  SchedulerParams params {};
  params.target_insert_ready_bay_fraction = 0.5;

  const auto scheduler = scenarios::SharedScheduler(layout_filepath, params);
  interfaces::msg::Guid request_id = MakeGuid(0, 0xDEADBEEF);
  auto ctx = std::make_shared<PlanContext>(request_id, std::move(DiscreteGarageState()), rclcpp::Time(0));

  interfaces::msg::DiscreteBayState bay {};
  bay.id = 1u;
  interfaces::msg::BayCommand cmd {};
  cmd.command_type = 2;
  const auto bay_transition = std::make_shared<BayTransition>(0u, bay, cmd);
  ctx->event_dag.AddEvent(bay_transition);
  ctx->ChainAfterLastEntityEvent(BayId(bay.id), bay_transition);

  {
    EXPECT_EQ(1u, ctx->event_dag.NumVertices());
    auto bay_last_event_it = ctx->last_event_by_entity.find(BayId(bay.id));
    ASSERT_NE(bay_last_event_it, ctx->last_event_by_entity.end());
    const auto last_event = dynamic_cast<BayTransition*>(bay_last_event_it->second.get());
    ASSERT_NE(last_event, nullptr);
    EXPECT_EQ(bay_transition->GetBayId(), last_event->GetBayId());
    EXPECT_EQ(bay_transition->GetCommand(), last_event->GetCommand());
  }

  bay.id = 2u;
  cmd.command_type = 2;
  const auto bay_transition_2 = std::make_shared<BayTransition>(0u, bay, cmd);
  ctx->event_dag.AddEvent(bay_transition_2);
  ctx->ChainAfterLastEntityEvent(BayId(bay.id), bay_transition_2);

  {
    EXPECT_EQ(2u, ctx->event_dag.NumVertices());
    auto bay_last_event_it = ctx->last_event_by_entity.find(BayId(bay.id));
    ASSERT_NE(bay_last_event_it, ctx->last_event_by_entity.end());
    const auto last_event = dynamic_cast<BayTransition*>(bay_last_event_it->second.get());
    ASSERT_NE(last_event, nullptr);
    EXPECT_EQ(bay_transition_2->GetBayId(), last_event->GetBayId());
    EXPECT_EQ(bay_transition_2->GetCommand(), last_event->GetCommand());
  }

  bay.id = 1u;
  cmd.command_type = 2;
  const auto bay_transition_3 = std::make_shared<BayTransition>(0u, bay, cmd);
  ctx->event_dag.AddEvent(bay_transition_3);
  ctx->ChainAfterLastEntityEvent(BayId(bay.id), bay_transition_3);

  {
    EXPECT_EQ(3u, ctx->event_dag.NumVertices());
    auto bay_last_event_it = ctx->last_event_by_entity.find(BayId(bay.id));
    ASSERT_NE(bay_last_event_it, ctx->last_event_by_entity.end());
    const auto last_event = dynamic_cast<BayTransition*>(bay_last_event_it->second.get());
    ASSERT_NE(last_event, nullptr);
    EXPECT_EQ(bay_transition_3->GetBayId(), last_event->GetBayId());
    EXPECT_EQ(bay_transition_3->GetCommand(), last_event->GetCommand());
    // Should have a dependency between this and first bay transition for bay 2
    EXPECT_TRUE(ctx->event_dag.HasDependency(bay_transition, bay_transition_3));
  }
}

