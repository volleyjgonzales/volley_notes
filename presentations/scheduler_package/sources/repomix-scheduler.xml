constexpr auto kInitialState = "initial_state"sv;
constexpr auto kScheduler = "scheduler"sv;
constexpr auto kRequest = "request"sv;
constexpr std::string_view kScenarioKeys[] = {
    kTest, "description"sv, kInitialState, kScheduler, kRequest, "input"sv, "output"sv};

/// @return The running test as gtest names it, `Suite.Name`.
[[nodiscard]] std::string TestName() {
  const auto* info = ::testing::UnitTest::GetInstance()->current_test_info();
  return std::format("{}.{}", info->test_suite_name(), info->name());
}

/// @return @p name in snake case: RetrieveJob -> retrieve_job.
[[nodiscard]] std::string SnakeCase(std::string_view name) {
  std::string out;
  for(const char c : name) {
    if(std::isupper(static_cast<unsigned char>(c)) != 0 && !out.empty()) {
      out += '_';
    }
    out += static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
  }
  return out;
}

/// @return The running test's file name, with @p suffix when one test has several scenarios.
[[nodiscard]] std::string FileName(std::string_view suffix) {
  std::string name = ::testing::UnitTest::GetInstance()->current_test_info()->name();
  if(!suffix.empty()) {
    name += std::format(".{}", suffix);
  }
  return std::format("{}.yaml", name);
}

}  // namespace

std::filesystem::path PlanPath(std::string_view suffix) {
  const auto* info = ::testing::UnitTest::GetInstance()->current_test_info();
  return std::filesystem::path(SCHEDULER_SCENARIO_DIR) / "plan" / SnakeCase(info->test_suite_name()) /
         FileName(suffix);
}

std::filesystem::path StagePath(std::string_view stage, std::string_view suffix) {
  return std::filesystem::path(SCHEDULER_SCENARIO_DIR) / "task_planning" / std::string(stage) /
         FileName(suffix);
}

Scenario Load(const std::filesystem::path& path) {
  if(!std::filesystem::exists(path)) {
    throw std::runtime_error(std::format("No scenario file '{}'", path.string()));
  }
  ExpectOwnTest(path, YAML::LoadFile(path.string()));
  return Read(path);
}

Scenario Read(const std::filesystem::path& path) {
  if(!std::filesystem::exists(path)) {
    throw std::runtime_error(std::format("No scenario file '{}'", path.string()));
  }
  const YAML::Node doc = YAML::LoadFile(path.string());
  try {
    ExpectKeys(doc, kScenarioKeys, "the scenario");
    Scenario scenario;
    scenario.path = path;
    scenario.initial = initial_states::Load(doc[std::string(kInitialState)].as<std::string>());
    if(const auto params = doc[std::string(kScheduler)]) {
      scenario.params = params.as<SchedulerParams>();
    }
    if(const auto request = doc[std::string(kRequest)]) {
      scenario.request = request.as<Request>();
    }
    return scenario;
  }
  catch(const std::exception& error) {
    throw std::runtime_error(std::format("{}: {}", path.string(), error.what()));
  }
}

void ExpectOwnTest(const std::filesystem::path& path, const YAML::Node& doc) {
  if(const auto owner = doc[std::string(kTest)].as<std::string>(""); owner != TestName()) {
    throw std::runtime_error(
        std::format("'{}' belongs to test '{}', not {}", path.string(), owner, TestName()));
  }
}

std::string AuthoredText(const std::filesystem::path& path) {
  std::ifstream in(path);
  std::string text;
  std::string line;
  while(std::getline(in, line)) {
    if(line.starts_with("input:") || line.starts_with("output:")) {
      break;
    }
    text += line + "\n";
  }
  return text;
}

}  // namespace volley::scheduler::test::scenarios
</file>

