template <>
struct std::hash<volley::scheduler::AgvAssignmentEdgeKey> {
  std::size_t operator()(const volley::scheduler::AgvAssignmentEdgeKey& key) const {
    std::size_t result = 0;
    boost::hash_combine(result, boost::hash_value(key.first));
    boost::hash_combine(result, boost::hash_value(key.second));
    return result;
  }
};

namespace volley::scheduler {

struct AgvAssignmentState {
  DiscreteGarageState working_state;
  std::unordered_map<uint16_t, std::shared_ptr<ScheduleEvent>> last_event_by_agv = {};
  std::unordered_map<uint16_t, std::shared_ptr<ScheduleEvent>> last_move_to_tray_event_by_agv = {};
  std::unordered_map<uint32_t, uint16_t> last_agv_by_node = {};
  std::unordered_map<uint16_t, Interval::Duration> busy_duration_by_agv = {};
  std::unordered_map<std::shared_ptr<ScheduleEvent>, Interval::Duration> earliest_start_by_event = {};
};

namespace {

void ChainAgvEvent(
    PlanContext& ctx, AgvAssignmentState& state, uint16_t agv_id, const ScheduleEventSPtr& event) {
  if(const auto it = state.last_event_by_agv.find(agv_id); it != state.last_event_by_agv.end()) {
    ctx.event_dag.AddDependency(it->second, event);
  }
  state.last_event_by_agv[agv_id] = event;
}

int16_t ChoosePickupHeading(
    const interfaces::msg::DiscreteAgvState& agv, const interfaces::msg::DiscreteTrayState& tray) {
  return IsSameOrOppositeHeading(agv.pose.heading, tray.pose.heading) ? agv.pose.heading : tray.pose.heading;
}

stdx::Expected<DiscreteGarageState> ComputeStateBefore(
    const PlanContext& ctx, const ScheduleEventSPtr& event) {
  auto state = ctx.initial_state;
  const auto events = ctx.event_dag.GetEventsInTopologicalOrder();
  if(!events.has_value()) {
    return stdx::Unexpected("Invalid topological ordering");
  }
  for(const auto& earlier_event : *events) {
    if(earlier_event == event) {
      break;
    }
    if(const auto [is_applied, message] = earlier_event->ApplyTo(state); !is_applied) {
      return stdx::Unexpected("Could not apply {}: {}", earlier_event->ToString(), message);
    }
  }
  return state;
}

const interfaces::msg::AgvLiftChanged* FindAgvLiftChange(const ScheduleEvent& event, uint16_t agv_id) {
  if(event.GetType() != ScheduleEventType::AGV_MOVE) {
    return nullptr;
  }
  const auto& agv_move = dynamic_cast<const AgvMove&>(event);
  if(agv_move.GetAgvId() != agv_id) {
    return nullptr;
  }
  return std::get_if<interfaces::msg::AgvLiftChanged>(&agv_move.GetDiscreteChange());
}

// Bounded by the edges that could be added; ValidateEventSequence is the backstop.
constexpr size_t kMaxAgvMoveOrderPasses = 256;

bool HasTrayMoveEvents(const ScheduleEventDag& event_dag) {
  const auto [first_vertex, end_vertex] = event_dag.GetVertices();
  return std::any_of(first_vertex, end_vertex, [&event_dag](const auto vertex) {
    return event_dag.GetEvent(vertex)->GetType() == ScheduleEventType::TRAY_MOVE;
  });
}

}  // namespace

stdx::Result Scheduler::AssignAgvs(PlanContextSPtr ctx) const {
  AgvAssignmentState state {.working_state = ctx->initial_state};

  if(!HasTrayMoveEvents(ctx->event_dag)) {
    return {};
  }

  std::vector<uint16_t> available_agv_ids;
  for(const auto& [agv_id, agv_state] : state.working_state.GetAgvs()) {
    if(agv_state.disabled) {
      continue;
    }
    // TODO(any): Start from the time until the AGV finishes its assigned events; zero for now.
    state.busy_duration_by_agv[agv_id] = Interval::Duration::zero();
    available_agv_ids.push_back(agv_id);
    state.last_agv_by_node[agv_state.pose.node_id] = agv_id;
  }
  if(available_agv_ids.empty()) {
    return stdx::Unexpected("No available AGVs to attempt assignment");
  }

  auto pending_events(ctx->event_dag);

  while(!pending_events.GetRootEvents().empty()) {
    // Non-tray roots first: they can expose tray-move roots that BottleneckAssignment must see together.
    if(const auto non_tray_events = ApplyNonTrayRootEvents(ctx, state, pending_events); !non_tray_events) {
      return non_tray_events;
    }

    std::vector<ScheduleEventSPtr> root_events = pending_events.GetRootEvents();
    if(root_events.empty()) {
      continue;
    }

    const auto edge_costs = ComputeAgvAssignmentEdgeCosts(state, root_events, available_agv_ids);

    if(edge_costs.empty()) {
      return stdx::Unexpected("Failed to assign AGVs: no AGV has a cost for any tray move");
    }

    // max_cost is Duration::max() since no edge will have that value
    auto assignment_opt =
        BottleneckAssignment(edge_costs, available_agv_ids, root_events, Interval::Duration::max());
    if(!assignment_opt.has_value()) {
      return stdx::Unexpected("Failed to assign AGVs: no complete assignment");
    }

    const auto& [root_event_by_agv, bottleneck_threshold] = *assignment_opt;
    if(root_event_by_agv.empty()) {
      return stdx::Unexpected("Failed to assign AGVs: no AGV is assigned to any event");
    }

    auto agv_order_dag = BuildAgvOrderDag(root_event_by_agv, state.working_state);

    std::optional<std::vector<uint64_t>> agv_assignment_order_opt = agv_order_dag.GetTopologicalOrdering();
    if(!agv_assignment_order_opt) {
      return stdx::Unexpected("Failed to assign AGVs: the assigned AGVs block each other's pickups");
    }

    for(const auto& vertex : agv_assignment_order_opt.value()) {
      const uint16_t agv_id = *agv_order_dag.GetNode(vertex);
      const auto& root_event_opt = root_event_by_agv.at(agv_id);
      // No event matched to this AGV (more AGVs than root events).
      if(!root_event_opt.has_value()) {
        continue;
      }
      const auto& root_event = *root_event_opt;
      const auto assignment_duration_or = AssignAgvToTrayMove(ctx, state, agv_id, root_event, agv_order_dag);
      if(!assignment_duration_or) {
        return stdx::Unexpected(assignment_duration_or.error());
      }
      pending_events.Remove(root_event);

      PropagateEarliestStartToChildren(root_event, *assignment_duration_or, ctx, state);
      state.busy_duration_by_agv[agv_id] += *assignment_duration_or;
    }
  }

  if(const auto ordered = OrderAgvMovesAfterBlockingAgvs(ctx); !ordered) {
    return ordered;
  }

  if(const auto reduced = ctx->event_dag.RemoveRedundantEdges(); !reduced) {
    return reduced;
  }

  return OrderAllTransitionsAroundAgvLifts(ctx);
}

stdx::Result Scheduler::ApplyNonTrayRootEvents(
    PlanContextSPtr ctx, AgvAssignmentState& state, ScheduleEventDag& pending_events) const {
  while(true) {
    bool is_non_tray_event_applied = false;
    auto current_roots = pending_events.GetRootEvents();
    for(const std::shared_ptr<ScheduleEvent>& root_event : current_roots) {
      if(root_event->GetType() == ScheduleEventType::TRAY_MOVE) {
        continue;
      }
      const auto [success, message] = root_event->ApplyTo(state.working_state);
      if(!success) {
        return stdx::Unexpected("Could not apply non-tray event: {}", message);
      }
      if(auto* agv_move = dynamic_cast<AgvMove*>(root_event.get())) {
        const auto move_duration = ComputeAgvMoveDuration(*agv_move, state.working_state);
        if(!move_duration.has_value()) {
          return stdx::Unexpected(move_duration.error());
        }

        auto agv_id = agv_move->GetAgvId();
        state.busy_duration_by_agv[agv_id] += *move_duration;
        ChainAgvEvent(*ctx, state, agv_id, root_event);
        if(const auto* pose_change =
                std::get_if<interfaces::msg::AgvPoseChanged>(&agv_move->GetDiscreteChange())) {
          const auto arrival_order =
              OrderArrivalAfterPriorOccupant(ctx, state, pose_change->node_id_next, agv_id, root_event);
          if(!arrival_order) {
            return stdx::Unexpected(
                "Failed to assign AGVs: AGV pose-change arrival infeasible: {}", arrival_order.error());
          }
        }
      }
      pending_events.Remove(root_event);
      is_non_tray_event_applied = true;
    }
    if(!is_non_tray_event_applied) {
      break;
    }
  }
  return {};
}

AgvAssignmentEdgeCosts Scheduler::ComputeAgvAssignmentEdgeCosts(const AgvAssignmentState& state,
    const std::vector<ScheduleEventSPtr>& root_events, const std::vector<uint16_t>& agvs_to_assign) const {
  const auto& working_state = state.working_state;
  const std::unordered_set<uint16_t> all_enabled_agvs(agvs_to_assign.begin(), agvs_to_assign.end());
  const auto path_filter =
      BuildStaticObstacleFilter(common::EnumInteger(CollisionEntityId::AGV), motion_graph_, working_state,
          collision_table_, std::unordered_set<uint16_t>(), all_enabled_agvs, std::unordered_set<uint16_t>());
  AgvAssignmentEdgeCosts edge_costs;
  for(const std::shared_ptr<ScheduleEvent>& root_event : root_events) {
    auto tray_move = dynamic_cast<TrayMove*>(root_event.get());
    const auto earliest_start_it = state.earliest_start_by_event.find(root_event);
    const auto event_earliest_start = earliest_start_it == state.earliest_start_by_event.end()
                                          ? Interval::Duration::zero()
                                          : earliest_start_it->second;
    for(const auto& agv_id : agvs_to_assign) {
      auto bay_opt = working_state.GetBay(working_state.GetAgv(agv_id)->pose.node_id);
      if(bay_opt.has_value() && bay_opt->state != interfaces::msg::BayReport::STATE_READY_TO_RETRIEVE) {
        continue;
      }
      auto agv_wait =
          max(state.busy_duration_by_agv.at(agv_id) - event_earliest_start, Interval::Duration::zero());
      auto cost_opt = ComputeAgvAssignmentCost(agv_id, *tray_move, working_state, agv_wait, path_filter);
      if(cost_opt.has_value()) {
        edge_costs[std::make_pair(agv_id, root_event)] = cost_opt.value();
      }
    }
  }
  return edge_costs;
}

Dag<uint16_t> Scheduler::BuildAgvOrderDag(
    const std::unordered_map<uint16_t, std::optional<ScheduleEventSPtr>>& root_event_by_agv,
    const DiscreteGarageState& working_state) const {
  auto order_dag = Dag<uint16_t>();
  std::unordered_map<uint16_t, Dag<uint16_t>::Vertex> vertex_by_agv;
  for(const auto& [agv_id, _] : root_event_by_agv) {
    const auto vertex_opt = order_dag.Add(std::make_shared<uint16_t>(agv_id));
    if(!vertex_opt) {
      throw std::runtime_error("Failed to add AGV " + std::to_string(agv_id) + " to the AGV order DAG");
    }
    vertex_by_agv.emplace(agv_id, *vertex_opt);
  }

  for(const auto& [agv_id, assigned_event_opt] : root_event_by_agv) {
    if(!assigned_event_opt) {
      continue;
    }
    for(const auto& agv_at_pickup :
        FindAssignedAgvsBlockingPickup(root_event_by_agv, working_state, agv_id)) {
      if(!order_dag.AddDependency(vertex_by_agv.at(agv_at_pickup), vertex_by_agv.at(agv_id))) {
        throw std::runtime_error("Failed to add dependency between AGV " + std::to_string(agv_at_pickup) +
                                 " and AGV " + std::to_string(agv_id));
      }
    }
  }

  return order_dag;
}

stdx::Expected<Interval::Duration> Scheduler::AssignAgvToTrayMove(PlanContextSPtr ctx,
    AgvAssignmentState& state, uint16_t agv_id, const std::shared_ptr<ScheduleEvent>& root_event,
    const Dag<uint16_t>& agv_order_dag) const {
  const auto tray_move = dynamic_cast<TrayMove*>(root_event.get());
  const auto tray = state.working_state.GetTray(tray_move->GetTrayId().value()).value();
  Interval::Duration event_cost(0);

  const auto agv = state.working_state.GetAgv(agv_id).value();
  // The cost functions never assign an AGV carrying a different tray, so it holds this tray or none.
  if(agv.tray_id != tray.id) {
    if(tray.pose.node_id != agv.pose.node_id ||
        !IsSameOrOppositeHeading(agv.pose.heading, tray.pose.heading)) {
      const auto agv_move_to_tray = ScheduleAgvMoveToPickup(ctx, state, agv_id, root_event, agv_order_dag);
      if(!agv_move_to_tray) {
        return stdx::Unexpected(agv_move_to_tray.error());
      }
      event_cost += agv_move_to_tray.value();
    }
    const auto agv_lift = ScheduleAgvLiftChange(ctx, state, agv_id, true, root_event->GetJobIndex());
    if(!agv_lift) {
      return stdx::Unexpected(agv_lift.error());
    }
    event_cost += agv_lift.value();
  }

  tray_move->SetAgvId(agv.id);
  ChainAgvEvent(*ctx, state, agv_id, root_event);
  // The tray move relocates the AGV to its destination; treat it as an arrival there.
  {
    const auto arrival_order =
        OrderArrivalAfterPriorOccupant(ctx, state, tray_move->GetDest().value().node_id, agv_id, root_event);
    if(!arrival_order) {
      return stdx::Unexpected(
          "Failed to assign AGVs: tray-move destination arrival infeasible: {}", arrival_order.error());
    }
  }

  const auto agv_for_cost_opt = state.working_state.GetAgv(agv_id);
  if(!agv_for_cost_opt.has_value()) {
    return stdx::Unexpected("Failed to assign AGVs: assigned AGV missing from working state");
  }
  const auto& agv_for_cost = agv_for_cost_opt.value();

  auto root_event_cost_opt = ComputeTravelDuration(
      agv_for_cost.pose, tray_move->GetDest().value(), AgvId(agv_id), IsCarryingTray(agv_for_cost));
  if(!root_event_cost_opt.has_value()) {
    return stdx::Unexpected("assigned event cost is infeasible");
  }
  event_cost += root_event_cost_opt.value();
  {
    auto [success, message] = root_event->ApplyTo(state.working_state);
    if(!success) {
      std::string error_message = "AGV Assignments post matching: Failed to apply " + root_event->ToString() +
                                  " while assigning AGVs: " + message;
      LOG_ERROR(logger_, "{}", error_message);
      return stdx::Unexpected("AGV Assignment failure: {}", error_message);
    }
  }

  const auto agv_lower = ScheduleAgvLiftChange(ctx, state, agv_id, false, root_event->GetJobIndex());
  if(!agv_lower) {
    return stdx::Unexpected(agv_lower.error());
  }
  event_cost += agv_lower.value();
  return event_cost;
}

void Scheduler::PropagateEarliestStartToChildren(const std::shared_ptr<ScheduleEvent>& root_event,
    Interval::Duration event_duration, PlanContextSPtr ctx, AgvAssignmentState& state) const {
  auto& earliest_start_by_event = state.earliest_start_by_event;
  if(!ctx->event_dag.Has(root_event)) {
    throw std::runtime_error("Failed to get AGV vertex in DAG");
  }
  const auto child_earliest_start = event_duration + earliest_start_by_event[root_event];
  for(const auto& child_event : ctx->event_dag.GetChildren(root_event)) {
    auto& child_event_start = earliest_start_by_event[child_event];
    child_event_start = std::max(child_event_start, child_earliest_start);
  }
}

stdx::Result Scheduler::OrderAgvMovesAfterBlockingAgvs(PlanContextSPtr ctx) const {
  for(size_t pass = 0; pass < kMaxAgvMoveOrderPasses; ++pass) {
    const auto is_edge_added = AddNextMissingAgvMoveOrder(ctx);
    if(!is_edge_added.has_value()) {
      return stdx::Unexpected(is_edge_added.error());
    }
    if(!*is_edge_added) {
      return {};
    }
  }
  return {};
}

stdx::Result Scheduler::OrderAllTransitionsAroundAgvLifts(PlanContextSPtr ctx) const {
  auto new_total_ordering_opt = ctx->event_dag.GetTopologicalOrdering();
  if(!new_total_ordering_opt.has_value()) {
    LOG_ERROR(logger_, "Failed to get new total ordering. AGV assignments introduced a loop!!!!");
    return stdx::Unexpected("Failed to get new total ordering");
  }

  for(const auto& event_vertex : new_total_ordering_opt.value()) {
    auto event = ctx->event_dag.GetEvent(event_vertex);

    if(auto* bay_transition = dynamic_cast<BayTransition*>(event.get())) {
      if(const auto ordered = OrderTransitionAroundAgvLifts(ctx, event, bay_transition->GetSourceState().id);
          !ordered) {
        return stdx::Unexpected(ordered.error());
      }
    }
    else if(auto* ev_charger_transition = dynamic_cast<VecsTransition*>(event.get())) {
      if(const auto ordered = OrderTransitionAroundAgvLifts(ctx, event, ev_charger_transition->GetVecsId());
          !ordered) {
        return stdx::Unexpected(ordered.error());
      }
    }
  }

  return {};
}

stdx::Expected<Interval::Duration> Scheduler::ComputeAgvMoveDuration(
    const AgvMove& agv_move, const DiscreteGarageState& working_state) const {
  if(const auto* lift_change = std::get_if<interfaces::msg::AgvLiftChanged>(&agv_move.GetDiscreteChange())) {
    return ComputeAgvLiftDuration(lift_change->raised);
  }
  const auto* pose_change = std::get_if<interfaces::msg::AgvPoseChanged>(&agv_move.GetDiscreteChange());
  if(pose_change == nullptr) {
    return stdx::Unexpected("Unknown AGV move discrete change {}", agv_move.ToString());
  }
  const auto start_pose = ConstructGaragePose(pose_change->node_id_curr, pose_change->heading_curr);
  const auto end_pose = ConstructGaragePose(pose_change->node_id_next, pose_change->heading_next);
  const bool is_agv_loaded = IsCarryingTray(working_state.GetAgv(agv_move.GetAgvId()).value());
  const auto travel_duration =
      ComputeTravelDuration(start_pose, end_pose, AgvId(agv_move.GetAgvId()), is_agv_loaded);
  if(!travel_duration.has_value()) {
    return stdx::Unexpected("No path for AGV move {}", agv_move.ToString());
  }
  return *travel_duration;
}

stdx::Result Scheduler::OrderArrivalAfterPriorOccupant(PlanContextSPtr ctx, AgvAssignmentState& state,
    uint32_t dest_node_id, uint16_t arriving_agv_id, const std::shared_ptr<ScheduleEvent>& new_event) const {
  auto it = state.last_agv_by_node.find(dest_node_id);
  if(it != state.last_agv_by_node.end() && it->second != arriving_agv_id) {
    auto prev_event_it = state.last_event_by_agv.find(it->second);
    if(prev_event_it == state.last_event_by_agv.end()) {
      // Nothing to gate the arrival on, and the dispatcher would reject the plan, so fail here and let
      // the caller pick another AGV or relocate the idle occupant.
      return stdx::Unexpected("a{} cannot arrive at node {}: a{} is idle there with no scheduled departure",
          arriving_agv_id, dest_node_id, std::to_string(it->second));
    }
    ctx->event_dag.AddDependency(prev_event_it->second, new_event);
  }
  state.last_agv_by_node[dest_node_id] = arriving_agv_id;
  return {};
}

std::optional<Interval::Duration> Scheduler::ComputeAgvAssignmentCost(uint16_t agv_id, const TrayMove& move,
    const DiscreteGarageState& working_state, const Interval::Duration& agv_busy_duration,
    std::optional<GraphFilterProperties> path_filter) const {
  if(!move.GetTrayId().has_value()) {
    LOG_WARN(
        logger_, "Attempting to get AMIGA cost for a tray move with no tray ID {}", std::to_string(move));
    return std::nullopt;
  }
  auto tray_opt = working_state.GetTray(move.GetTrayId().value());
  if(!tray_opt.has_value()) {
    LOG_WARN(logger_, "Attempting to get AMIGA cost for a tray move whose tray doesn't exist {}",
        std::to_string(move));
    return std::nullopt;
  }
  if(!layout_->GetNodeById(tray_opt->pose.node_id).has_value()) {
    LOG_WARN(logger_, "Attempting to get AMIGA cost for a tray move whose tray isn't on a valid node {}",
        std::to_string(move));
    return std::nullopt;
  }
  auto agv_opt = working_state.GetAgv(agv_id);
  if(!agv_opt.has_value()) {
    LOG_WARN(logger_, "Attempting to get AMIGA cost for an AGV that doesn't exist {}", std::to_string(move));
    return std::nullopt;
  }
  if(!layout_->GetNodeById(agv_opt->pose.node_id).has_value()) {
    LOG_WARN(logger_, "Attempting to get AMIGA cost for an AGV that isn't on a valid node {}",
        std::to_string(move));
    return std::nullopt;
  }
  if(IsCarryingTray(*agv_opt) && agv_opt->tray_id != move.GetTrayId().value()) {
    return std::nullopt;
  }
  auto moving_cost_opt = ComputeAgvPickupDuration(agv_id, move, working_state, path_filter);
  if(!moving_cost_opt.has_value()) {
    return std::nullopt;
  }
  return agv_busy_duration + moving_cost_opt.value();
}

std::vector<uint16_t> Scheduler::FindAssignedAgvsBlockingPickup(
    const std::unordered_map<uint16_t, std::optional<ScheduleEventSPtr>>& root_event_by_agv,
    const DiscreteGarageState& working_state, const uint16_t agv_id) const {
  if(root_event_by_agv.empty()) {
    return {};
  }

  auto assigned_event_opt = root_event_by_agv.at(agv_id);
  if(!assigned_event_opt.has_value()) {
    return {};
  }

  auto tray_move = dynamic_cast<TrayMove*>(assigned_event_opt->get());
  if(tray_move == nullptr) {
    return {};
  }

  const auto pickup_pose = working_state.GetTray(tray_move->GetTrayId().value())->pose;
  const auto agv_collision_id = CollisionEntityIdFromAgvState(
      working_state.GetAgv(agv_id).value(), working_state, *(motion_graph_.GetLayout()));

  std::vector<uint16_t> agvs_at_pickup;
  for(const auto& [other_agv_id, other_agv] : working_state.GetAgvs()) {
    if(other_agv_id == agv_id) {
      continue;
    }
    if(root_event_by_agv.find(other_agv_id) == root_event_by_agv.end()) {
      continue;
    }

    const auto other_collision_id =
        CollisionEntityIdFromAgvState(other_agv, working_state, *(motion_graph_.GetLayout()));
    if(collision_table_.Query(agv_collision_id, other_collision_id, pickup_pose, other_agv.pose)) {
      agvs_at_pickup.push_back(other_agv_id);
    }
  }

  return agvs_at_pickup;
}

stdx::Expected<Interval::Duration> Scheduler::ScheduleAgvMoveToPickup(PlanContextSPtr ctx,
    AgvAssignmentState& state, uint16_t agv_id, const std::shared_ptr<ScheduleEvent>& root_event,
    const Dag<uint16_t>& agv_order_dag) const {
  const auto agv = state.working_state.GetAgv(agv_id).value();
  const auto tray =
      state.working_state.GetTray(dynamic_cast<TrayMove*>(root_event.get())->GetTrayId().value()).value();
  const auto pickup_heading = ChoosePickupHeading(agv, tray);
  const auto move_to_tray = MakeAgvPoseMove(
      root_event->GetJobIndex(), agv_id, agv.pose, ConstructGaragePose(tray.pose.node_id, pickup_heading));
  ctx->event_dag.AddEvent(move_to_tray);
  ChainAgvEvent(*ctx, state, agv_id, move_to_tray);

  // Mirror the AGV's prior move-to-tray events as deps on this move to keep cross-AGV ordering.
  const auto [first_vertex, end_vertex] = agv_order_dag.GetVertices();
  const auto agv_vertex = std::find_if(
      first_vertex, end_vertex, [&](const auto vertex) { return *agv_order_dag.GetNode(vertex) == agv_id; });
  if(agv_vertex == end_vertex) {
    throw std::runtime_error("Failed to find AGV vertex in DAG");
  }
  for(const auto& parent_agv_id : agv_order_dag.GetParents(*agv_vertex)) {
    if(const auto it = state.last_move_to_tray_event_by_agv.find(*parent_agv_id);
        it != state.last_move_to_tray_event_by_agv.end()) {
      ctx->event_dag.AddDependency(it->second, move_to_tray);
    }
  }

  if(const auto arrival_order =
          OrderArrivalAfterPriorOccupant(ctx, state, tray.pose.node_id, agv_id, move_to_tray);
      !arrival_order) {
    return stdx::Unexpected("Failed to assign AGVs: {}", arrival_order.error());
  }
  // Without this, move_to_tray can pass a node before its tray is moved and ValidateEventSequence rejects the
  // plan.
  OrderAfterTraysOnPath(*ctx, agv, tray, move_to_tray, root_event);

  state.last_move_to_tray_event_by_agv[agv_id] = move_to_tray;

  auto move_to_tray_cost_opt = ComputeTravelDuration(agv.pose, tray.pose, AgvId(agv_id), IsCarryingTray(agv));
  if(!move_to_tray_cost_opt.has_value()) {
    return stdx::Unexpected("assigned event cost is infeasible");
  }

  auto [success, message] = move_to_tray->ApplyTo(state.working_state);
  if(!success) {
    std::string error_message = "AGV Assignments post matching: Failed to apply " + move_to_tray->ToString() +
                                " while moving assigned AGV to Tray: " + message;
    LOG_ERROR(logger_, "{}", error_message);
    return stdx::Unexpected("AGV Assignment failure: {}", error_message);
  }
  return move_to_tray_cost_opt.value();
}

stdx::Expected<Interval::Duration> Scheduler::ScheduleAgvLiftChange(PlanContextSPtr ctx,
    AgvAssignmentState& state, uint16_t agv_id, bool is_raising, size_t job_index) const {
  interfaces::msg::AgvLiftChanged lift_change;
  lift_change.agv_id = agv_id;
  lift_change.raised = is_raising;
  auto lift_event = std::make_shared<AgvMove>(job_index, lift_change);
  ctx->event_dag.AddEvent(lift_event);
  ChainAgvEvent(*ctx, state, agv_id, lift_event);

  auto [success, message] = lift_event->ApplyTo(state.working_state);
  if(!success) {
    const std::string verb = is_raising ? "lifting" : "lowering";
    std::string error_message =
        "Failed to apply " + lift_event->ToString() + " while AGV " + verb + " Tray: " + message;
    LOG_ERROR(logger_, "{}", error_message);
    return stdx::Unexpected("AGV Assignment failure: {}", error_message);
  }
  return ComputeAgvLiftDuration(is_raising);
}

std::optional<Interval::Duration> Scheduler::ComputeTravelDuration(
    const interfaces::msg::GaragePose& start_pose, const interfaces::msg::GaragePose& end_pose,
    const interfaces::msg::GarageEntityId& agv_entity, bool is_agv_loaded,
    std::optional<GraphFilterProperties> path_filter) const {
  if(start_pose == end_pose) {
    return Interval::Duration::zero();
  }
  // The collision body barely affects travel time, so AGV is used for any entity.
  const auto collision_id = static_cast<CollisionEntityId_t>(CollisionEntityId::AGV);
  std::vector<interfaces::msg::GaragePose> pose_path =
      FindPosePath(motion_graph_, start_pose, end_pose, cost_model_, path_filter);
  if(pose_path.empty()) {
    return std::nullopt;
  }
  auto trajectory = ConvertPosePathToTrajectory(pose_path, motion_graph_, cost_model_, Interval::Timepoint(),
      agv_entity, collision_id, 0, nullptr, is_agv_loaded);

  auto interval_opt = trajectory.GetInterval();
  if(!interval_opt.has_value()) {
    LOG_WARN(logger_, "Failed to compute the travel duration: the trajectory has no interval");
    return std::nullopt;
  }
  return interval_opt->GetDuration();
}

stdx::Expected<bool> Scheduler::AddNextMissingAgvMoveOrder(PlanContextSPtr ctx) const {
  auto ordering_opt = ctx->event_dag.GetTopologicalOrdering();
  if(!ordering_opt.has_value()) {
    return stdx::Unexpected("Failed to get the topological ordering while ordering AGV moves");
  }
  const auto& ordering = ordering_opt.value();
  auto working_state = ctx->initial_state;

  for(size_t position = 0; position < ordering.size(); ++position) {
    auto event = ctx->event_dag.GetEvent(ordering[position]);
    if(OrderAgvMoveAfterBlockerDeparture(ctx, ordering, position, event, working_state)) {
      // The order changed, so every later occupancy is stale.
      return true;
    }
    if(const auto [is_applied, message] = event->ApplyTo(working_state); !is_applied) {
      return stdx::Unexpected("Failed to apply {} while ordering AGV moves: {}", event->ToString(), message);
    }
  }
  return false;
}

stdx::Result Scheduler::OrderTransitionAroundAgvLifts(
    PlanContextSPtr ctx, std::shared_ptr<ScheduleEvent> event, uint16_t node_id) const {
  auto event_vertex_opt = ctx->event_dag.GetVertex(event);
  if(!event_vertex_opt.has_value()) {
    LOG_WARN(logger_, "Cannot order a transition around AGV lifts: {} is not in the event DAG",
        std::to_string(*event));
    return {};
  }
  auto event_vertex = event_vertex_opt.value();
  if(event->GetType() != ScheduleEventType::BAY_TRANSITION &&
      event->GetType() != ScheduleEventType::VECS_TRANSITION) {
    LOG_WARN(logger_, "Cannot order a transition around AGV lifts: {} is not a bay or VECS transition",
        std::to_string(*event));
    return {};
  }

  for(const auto& dependency_event : ctx->event_dag.GetParents(event_vertex)) {
    if(auto* tray_move = dynamic_cast<TrayMove*>(dependency_event.get())) {
      auto tray_agv_id = tray_move->GetAgvId().value();
      if(tray_move->GetDest()->node_id == node_id) {
        for(const auto& tray_dependent_event : ctx->event_dag.GetChildren(dependency_event)) {
          if(const auto* lift_change = FindAgvLiftChange(*tray_dependent_event, tray_agv_id);
              lift_change != nullptr && !lift_change->raised) {
            ctx->event_dag.AddDependency(tray_dependent_event, event);
          }
        }
      }
    }
  }
  for(const auto& dependent_event : ctx->event_dag.GetChildren(event_vertex)) {
    if(auto* tray_move = dynamic_cast<TrayMove*>(dependent_event.get())) {
      auto tray_agv_id = tray_move->GetAgvId().value();
      // The tray's source is where it is just before the tray move.
      const auto working_state = ComputeStateBefore(*ctx, dependent_event);
      if(!working_state.has_value()) {
        return stdx::Unexpected(working_state.error());
      }
      if(working_state->GetTray(tray_move->GetTrayId().value())->pose.node_id == node_id) {
        for(const auto& tray_dependency_event : ctx->event_dag.GetParents(dependent_event)) {
          if(const auto* lift_change = FindAgvLiftChange(*tray_dependency_event, tray_agv_id);
              lift_change != nullptr && lift_change->raised) {
            ctx->event_dag.AddDependency(event, tray_dependency_event);
          }
        }
      }
    }
  }
  return {};
}

Interval::Duration Scheduler::ComputeAgvLiftDuration(bool is_raising) const {
  const auto& event_params = cost_model_.Params().events;
  return std::chrono::duration_cast<Interval::Duration>(
      cost::SecondsF(is_raising ? event_params.agv_lift_up : event_params.agv_lift_down));
}

std::optional<Interval::Duration> Scheduler::ComputeAgvPickupDuration(uint16_t agv_id, const TrayMove& move,
    const DiscreteGarageState& working_state, std::optional<GraphFilterProperties> path_filter) const {
  auto tray = working_state.GetTray(move.GetTrayId().value()).value();
  auto agv = working_state.GetAgv(agv_id).value();
  auto tray_pose = ConstructGaragePose(tray.pose.node_id, ChoosePickupHeading(agv, tray));
  auto moving_cost_opt =
      ComputeTravelDuration(agv.pose, tray_pose, AgvId(agv_id), IsCarryingTray(agv), path_filter);
  if(!moving_cost_opt.has_value()) {
    return std::nullopt;
  }
  const auto lift_cost =
      agv.tray_id != tray.id ? ComputeAgvLiftDuration(/*is_raising=*/true) : Interval::Duration::zero();
  return moving_cost_opt.value() + lift_cost;
}

void Scheduler::OrderAfterTraysOnPath(PlanContext& ctx, const interfaces::msg::DiscreteAgvState& agv,
    const interfaces::msg::DiscreteTrayState& tray, const ScheduleEventSPtr& move_to_tray,
    const ScheduleEventSPtr& root_event) const {
  auto nav_path = FindPosePath(motion_graph_, agv.pose, tray.pose, cost_model_);
  for(size_t path_index = 1; path_index < nav_path.size(); ++path_index) {
    const uint16_t path_node = nav_path[path_index].node_id;
    // Skip the destination node: the tray being picked up is there, and rotations can repeat it.
    if(path_node == tray.pose.node_id) {
      continue;
    }
    for(const auto& [blocker_tray_id, blocker_tray] : ctx.initial_state.GetTrays()) {
      if(blocker_tray.pose.node_id != path_node) {
        continue;
      }
      auto it = ctx.first_event_by_tray.find(blocker_tray_id);
      if(it == ctx.first_event_by_tray.end()) {
        break;
      }
      // Skipped when root_event already reaches the tray's first event: the edge would close a cycle.
      if(!ctx.event_dag.WouldCreateCycle(it->second, root_event)) {
        ctx.event_dag.AddDependency(it->second, move_to_tray);
      }
      break;
    }
  }
}

bool Scheduler::OrderAgvMoveAfterBlockerDeparture(PlanContextSPtr ctx,
    const std::vector<ScheduleEventDag::Vertex>& ordering, size_t position, const ScheduleEventSPtr& event,
    const DiscreteGarageState& working_state) const {
  // Only AGV reposition (pose-change) moves with a destination can be blocked by another AGV body.
  auto* agv_move = dynamic_cast<AgvMove*>(event.get());
  if(agv_move == nullptr) {
    return false;
  }
  const auto dest_opt = agv_move->GetDest();
  if(!dest_opt.has_value() ||
      !std::holds_alternative<interfaces::msg::AgvPoseChanged>(agv_move->GetDiscreteChange())) {
    return false;
  }
  const auto agv_opt = working_state.GetAgv(agv_move->GetAgvId());
  if(!agv_opt.has_value()) {
    return false;
  }
  const uint16_t agv_id = agv_move->GetAgvId();
  const auto agv = agv_opt.value();
  const auto dest = dest_opt.value();
  const auto collision_id = CollisionEntityIdFromAgvState(agv, working_state, *layout_);

  // Same collision model as ValidateEventSequence: `ignore_agvs` are absent; trays (slide-under),
  // disabled nodes and bays still count.
  auto is_feasible_ignoring = [&](const std::unordered_set<uint16_t>& ignore_agvs) -> bool {
    auto path_filter = BuildStaticObstacleFilter(collision_id, motion_graph_, working_state, collision_table_,
        std::unordered_set<uint16_t>(), ignore_agvs, std::unordered_set<uint16_t>());
    return !FindPosePath(motion_graph_, agv.pose, dest, cost_model_, path_filter).empty();
  };

  // ValidateEventSequence ignores only the moving AGV, so a feasible path here needs no repair.
  if(is_feasible_ignoring(std::unordered_set<uint16_t> {agv_id})) {
    return false;
  }

  // Infeasible even without other AGVs: trays or disabled nodes block it, and reordering cannot help.
  std::unordered_set<uint16_t> all_agvs {agv_id};
  for(const auto& [other_id, other_state] : working_state.GetAgvs()) {
    if(!other_state.disabled) {
      all_agvs.insert(other_id);
    }
  }
  if(!is_feasible_ignoring(all_agvs)) {
    return false;
  }

  // Gate this move on the first departure of an AGV whose absence alone clears the path.
  for(const auto& [other_id, other_state] : working_state.GetAgvs()) {
    if(other_id == agv_id || other_state.disabled) {
      continue;
    }
    if(!is_feasible_ignoring(std::unordered_set<uint16_t> {agv_id, other_id})) {
      continue;
    }
    auto departure = FindAgvDepartureFromNode(ctx, ordering, position, other_id, other_state.pose.node_id);
    if(!departure || ctx->event_dag.WouldCreateCycle(departure, event)) {
      // No departure, or gating on it would deadlock: the blocker leaves only after this move.
      continue;
    }
    if(ctx->event_dag.AddDependency(departure, event)) {
      return true;
    }
  }
  return false;
}

ScheduleEventSPtr Scheduler::FindAgvDepartureFromNode(PlanContextSPtr ctx,
    const std::vector<ScheduleEventDag::Vertex>& ordering, size_t after_position, uint16_t agv_id,
    uint32_t node) const {
  for(size_t j = after_position + 1; j < ordering.size(); ++j) {
    auto candidate = ctx->event_dag.GetEvent(ordering[j]);
    if(auto* candidate_move = dynamic_cast<AgvMove*>(candidate.get())) {
      const auto* pose_change =
          std::get_if<interfaces::msg::AgvPoseChanged>(&candidate_move->GetDiscreteChange());
      if(candidate_move->GetAgvId() == agv_id && pose_change != nullptr &&
          pose_change->node_id_curr == node) {
        return candidate;
      }
    }
    else if(auto* candidate_tray = dynamic_cast<TrayMove*>(candidate.get())) {
      if(candidate_tray->GetAgvId() == agv_id) {
        return candidate;
      }
    }
  }
  return nullptr;
}

}  // namespace volley::scheduler
