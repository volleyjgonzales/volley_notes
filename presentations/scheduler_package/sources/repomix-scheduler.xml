TEST(AssignmentCost, JustMoving) {
  const auto garage = initial_states::Load("275_sunrise_b/empty_tray_in_bay");

  const auto scheduler = scenarios::SharedScheduler(garage.layout_path, SchedulerParams {});

  interfaces::msg::GaragePose start_pose;
  interfaces::msg::GaragePose end_pose;
  const auto agv_id = AgvId(1u);
  {
    // Start and end are same; cost is 0
    start_pose.node_id = 2068;
    start_pose.heading = 0;
    end_pose.node_id = 2068;
    end_pose.heading = 0;
    const auto cost_or = scheduler->ComputeTravelDuration(start_pose, end_pose, agv_id, false);
    EXPECT_TRUE(cost_or.has_value());
    EXPECT_EQ(cost_or.value(), Interval::Duration::zero());
  }
  {
    // Start and end are two different poses; succeeds with nonzero cost
    start_pose.node_id = 2066;
    start_pose.heading = 90;
    end_pose.node_id = 2068;
    end_pose.heading = 0;
    const auto cost_or = scheduler->ComputeTravelDuration(start_pose, end_pose, agv_id, false);
    EXPECT_TRUE(cost_or.has_value());
    EXPECT_GT(cost_or.value(), Interval::Duration::zero());
  }
  {
    // Loaded AGV should take longer than unloaded over the same path
    start_pose.node_id = 2066;
    start_pose.heading = 90;
    end_pose.node_id = 2068;
    end_pose.heading = 0;
    const auto unloaded =
        scheduler->ComputeTravelDuration(start_pose, end_pose, agv_id, /*is_agv_loaded=*/false);
    const auto loaded =
        scheduler->ComputeTravelDuration(start_pose, end_pose, agv_id, /*is_agv_loaded=*/true);
    EXPECT_TRUE(unloaded.has_value());
    EXPECT_TRUE(loaded.has_value());
    EXPECT_GT(loaded.value(), unloaded.value());
  }
}

TEST(AssignmentCost, AgvCurrentPoseToTrayMove) {
  const auto garage = initial_states::Load("275_sunrise_b/agv_lifting_tray_in_bay");

  // The cost model's default agv_lift_up and agv_lift_down.
  const auto k_lift_lower_seconds = std::chrono::seconds(6);
  const auto scheduler = scenarios::SharedScheduler(garage.layout_path, SchedulerParams {});
  interfaces::msg::Guid request_id = MakeGuid(0, 0xDEADBEEF);
  const auto ctx = std::make_shared<PlanContext>(request_id, garage.state, scenarios::kNow);
  const auto tray_move = std::make_shared<TrayMove>(0u);
  tray_move->SetTrayId(1);
  interfaces::msg::GaragePose end_pose;
  end_pose.node_id = 2066;
  end_pose.heading = 90;
  tray_move->SetDest(end_pose);
  const auto agv_id = 1u;
  {
    // The AGV is already carrying that tray: time is 0
    const auto cost_or = scheduler->ComputeAgvPickupDuration(agv_id, *tray_move, ctx->initial_state);
    EXPECT_TRUE(cost_or.has_value());
    EXPECT_EQ(cost_or.value(), Interval::Duration::zero());
  }
  {
    // The AGV is under the tray but not carrying it: time is liftlowertime
    interfaces::msg::AgvLiftChanged agv_lift_changed {};
    agv_lift_changed.agv_id = 1;
    agv_lift_changed.raised = false;
    auto [success, msg] = ctx->initial_state.OnEvent(agv_lift_changed);
    EXPECT_TRUE(success);
    const auto cost_or = scheduler->ComputeAgvPickupDuration(agv_id, *tray_move, ctx->initial_state);
    EXPECT_TRUE(cost_or.has_value());
    EXPECT_EQ(cost_or.value(), k_lift_lower_seconds);
  }
  {
    // The AGV is somewhere else: time is more than liftlowertime
    interfaces::msg::AgvPoseChanged agv_pose_changed {};
    agv_pose_changed.agv_id = 1;
    agv_pose_changed.node_id_curr = 2068;
    agv_pose_changed.heading_curr = 0;
    agv_pose_changed.node_id_next = 2075;
    agv_pose_changed.heading_next = 90;
    auto [success, msg] = ctx->initial_state.OnEvent(agv_pose_changed);
    EXPECT_TRUE(success) << msg;
    const auto cost_or = scheduler->ComputeAgvPickupDuration(agv_id, *tray_move, ctx->initial_state);
    EXPECT_TRUE(cost_or.has_value());
    EXPECT_GT(cost_or.value(), k_lift_lower_seconds);
  }
}

