#include "scheduler/bay_rebalancing.hpp"

#include <algorithm>
#include <cmath>
#include <common_ros/discrete_garage_state_utils.hpp>
#include <interfaces/msg/bay_report.hpp>
#include <ranges>
#include <unordered_set>

#include "scheduler/utils.hpp"

namespace volley {

BayClassification ClassifyBay(uint8_t planned_bay_state, bool is_tray_in_bay, bool is_payload_in_bay) {
  if(is_payload_in_bay && !is_tray_in_bay) {
    return BayClassification::NOT_USABLE;
  }
  // A processing bay must hold a tray and a payload; it is classified by the state it is heading to.
  switch(planned_bay_state) {
  case interfaces::msg::BayReport::STATE_PROCESSING_INSERT:
    return is_tray_in_bay && is_payload_in_bay ? BayClassification::INSERT_IN_PROGRESS
                                               : BayClassification::NOT_USABLE;
  case interfaces::msg::BayReport::STATE_PROCESSING_RETRIEVE:
    return is_tray_in_bay && is_payload_in_bay ? BayClassification::RETRIEVE_IN_PROGRESS
                                               : BayClassification::NOT_USABLE;
  case interfaces::msg::BayReport::STATE_READY_TO_INSERT:
    return is_tray_in_bay && !is_payload_in_bay ? BayClassification::INSERT_READY
                                                : BayClassification::INSERT_NEEDS_EMPTY_TRAY;
  case interfaces::msg::BayReport::STATE_READY_TO_RETRIEVE:
    return !is_tray_in_bay && !is_payload_in_bay ? BayClassification::RETRIEVE_READY
                                                 : BayClassification::RETRIEVE_NEEDS_TRAY_REMOVAL;
  default:
    return BayClassification::NOT_USABLE;
  }
}

std::unordered_map<uint16_t, BayClassification> ClassifyBays(const DiscreteGarageState& state) {
  std::unordered_map<uint16_t, BayClassification> classification_map;

  for(const auto& [bay_id, bay] : state.GetBays()) {
    if(bay.disabled) {
      classification_map.emplace(bay_id, BayClassification::NOT_USABLE);
      continue;
    }
    auto tray_opt = state.GetTrayOnNode(bay_id);

    const bool is_tray_in_bay = tray_opt.has_value();
    const bool is_payload_in_bay = is_tray_in_bay and HasPayload(*tray_opt);

    classification_map.emplace(bay_id, ClassifyBay(bay.state, is_tray_in_bay, is_payload_in_bay));
  }

  return classification_map;
}

DesiredBaySplit CalculateDesiredBaySplit(
    float target_insert_ready_bay_fraction, int n_eligible_bays, int n_empty_trays) {
  // Round fractional targets up to favour insert readiness; empty-tray availability caps the result.
  auto n_desired_insert_ready_bays =
      static_cast<int>(std::ceil(target_insert_ready_bay_fraction * static_cast<float>(n_eligible_bays)));

  n_desired_insert_ready_bays = std::clamp(n_desired_insert_ready_bays, 0, n_eligible_bays);

  n_desired_insert_ready_bays = std::min(n_desired_insert_ready_bays, n_empty_trays);

  int n_desired_retrieve_ready_bays = n_eligible_bays - n_desired_insert_ready_bays;

  return {.n_insert_ready_bays = n_desired_insert_ready_bays,
      .n_retrieve_ready_bays = n_desired_retrieve_ready_bays};
}

BayRebalancingActions ComputeBayRebalancingActions(
    const std::unordered_map<uint16_t, BayClassification>& bay_classifications,
    const std::vector<uint16_t>& bay_prioritization, int n_remaining_insert_ready_bays,
    int n_remaining_retrieve_ready_bays) {
  BayRebalancingActions bay_state_changes;

  // An unknown bay in the prioritization fails silently with no changes.
  for(const auto& bay_id : bay_prioritization) {
    if(!bay_classifications.contains(bay_id)) {
      return bay_state_changes;
    }
  }

  std::unordered_set<uint16_t> assigned_bays;

  for(const auto& [bay_id, classification] : bay_classifications) {
    // A finished retrieve leaves the bay ready to insert onto the tray it leaves behind.
    if(classification == BayClassification::RETRIEVE_IN_PROGRESS) {
      assigned_bays.emplace(bay_id);
      n_remaining_insert_ready_bays--;
    }
  }

  // Bays already in a wanted state are kept before others are transitioned, so fewer bays change
  // state even if the result fits bay_prioritization less well.

  for(const auto& bay_id : bay_prioritization) {
    if(n_remaining_insert_ready_bays <= 0) {
      break;
    }

    const auto& classification = bay_classifications.at(bay_id);
    if(classification == BayClassification::INSERT_READY) {
      assigned_bays.emplace(bay_id);
      n_remaining_insert_ready_bays--;
    }
  }

  for(const auto& bay_id : std::views::reverse(bay_prioritization)) {
    if(n_remaining_retrieve_ready_bays <= 0) {
      break;
    }

    const auto& classification = bay_classifications.at(bay_id);
    if(classification == BayClassification::RETRIEVE_READY) {
      assigned_bays.emplace(bay_id);
      n_remaining_retrieve_ready_bays--;
    }
  }

  for(const auto& bay_id : bay_prioritization) {
    if(n_remaining_insert_ready_bays <= 0) {
      break;
    }
    if(assigned_bays.contains(bay_id)) {
      continue;
    }

    const auto& classification = bay_classifications.at(bay_id);
    if(classification == BayClassification::RETRIEVE_READY ||
        classification == BayClassification::INSERT_NEEDS_EMPTY_TRAY ||
        classification == BayClassification::RETRIEVE_NEEDS_TRAY_REMOVAL) {
      bay_state_changes.bays_to_make_insert_ready.push_back(bay_id);
      assigned_bays.emplace(bay_id);
      n_remaining_insert_ready_bays--;
    }
  }

  for(const auto& bay_id : std::views::reverse(bay_prioritization)) {
    if(n_remaining_retrieve_ready_bays <= 0) {
      break;
    }
    if(assigned_bays.contains(bay_id)) {
      continue;
    }

    const auto& classification = bay_classifications.at(bay_id);
    if(classification == BayClassification::INSERT_READY ||
        classification == BayClassification::RETRIEVE_NEEDS_TRAY_REMOVAL ||
        classification == BayClassification::INSERT_NEEDS_EMPTY_TRAY) {
      bay_state_changes.bays_to_make_retrieve_ready.push_back(bay_id);
      assigned_bays.emplace(bay_id);
      n_remaining_retrieve_ready_bays--;
    }
  }

  for(const auto& [bay_id, classification] : bay_classifications) {
    if(assigned_bays.contains(bay_id)) {
      continue;
    }
    if(classification == BayClassification::INSERT_NEEDS_EMPTY_TRAY ||
        classification == BayClassification::RETRIEVE_NEEDS_TRAY_REMOVAL) {
      bay_state_changes.bays_to_make_retrieve_ready.push_back(bay_id);
    }
  }

  return bay_state_changes;
}

BayRebalancingActions ComputeBayRebalancingActions(const DiscreteGarageState& state,
    const std::vector<uint16_t>& bay_prioritization, float target_insert_ready_bay_fraction) {
  auto bay_classifications = ClassifyBays(state);

  const int n_empty_trays = static_cast<int>(CountEmptyTrays(state));

  int n_eligible_bays = 0;
  for(const auto& [bay_id, classification] : bay_classifications) {
    n_eligible_bays += (classification != BayClassification::NOT_USABLE);
  }

  auto [n_desired_insert_ready_bays, n_desired_retrieve_ready_bays] =
      CalculateDesiredBaySplit(target_insert_ready_bay_fraction, n_eligible_bays, n_empty_trays);

  return ComputeBayRebalancingActions(
      bay_classifications, bay_prioritization, n_desired_insert_ready_bays, n_desired_retrieve_ready_bays);
}

}  // namespace volley
</file>

