#include <common_ros/garage_occupancy_checker.hpp>
#include <interfaces/msg/discrete_payload_state.hpp>
#include <interfaces/msg/garage_pose.hpp>
#include <motion_planner/blocking_tray_search.hpp>
#include <motion_planner/interval.hpp>
#include <rclcppx/logging.hpp>
#include <unordered_map>
#include <unordered_set>
#include <utility>

#include "scheduler/format.hpp"
#include "scheduler/move_events.hpp"
#include "scheduler/scheduler.hpp"
#include "scheduler/utils.hpp"

namespace volley::scheduler {

struct TrayAssignmentState {
  DiscreteGarageState working_state;
  std::unordered_map<uint16_t, std::shared_ptr<ScheduleEvent>> last_event_by_tray = {};
  /// Tray moves and bay or charger transitions, recorded at the poses they occupy; an event that later uses
  /// one of those poses is ordered after them. The occupants are events, not the objects there now.
  GarageOccupancyChecker<std::shared_ptr<ScheduleEvent>> occupancy_history;
};

namespace {

void ChainTrayEvent(
    PlanContext& ctx, TrayAssignmentState& state, uint16_t tray_id, const ScheduleEventSPtr& event) {
  if(const auto it = state.last_event_by_tray.find(tray_id); it != state.last_event_by_tray.end()) {
    ctx.event_dag.AddDependency(it->second, event);
  }
  else {
    ctx.first_event_by_tray[tray_id] = event;
  }
  state.last_event_by_tray[tray_id] = event;
}

}  // namespace

// NOLINTNEXTLINE(google-readability-function-size)
stdx::Result Scheduler::AssignTrays(PlanContextSPtr ctx) const {
  TrayAssignmentState state {
      .working_state = ctx->initial_state, .occupancy_history = {collision_table_, motion_graph_}};

  const auto events = ctx->event_dag.GetEventsInTopologicalOrder();
  if(!events.has_value()) {
    return stdx::Unexpected("Failed to get total ordering");
  }

  const auto tray_collision_id = common::EnumInteger(CollisionEntityId::TRAY);
  for(const auto& event : *events) {
    if(event->GetType() != ScheduleEventType::TRAY_MOVE) {
      const auto transition_registration = ApplyBayOrChargerTransition(state, event);
      if(!transition_registration) {
        return stdx::Unexpected(transition_registration.error());
      }
      continue;
    }

    auto move = dynamic_cast<TrayMove*>(event.get());
    if(!move->GetTrayId()) {
      const auto tray_id_assignment = AssignEmptyTrayToMove(*move, state.working_state);
      if(!tray_id_assignment) {
        return stdx::Unexpected(tray_id_assignment.error());
      }
    }

    if(!move->GetDest()) {
      const auto dest_assignment = AssignDestinationAndUnblockingMoves(ctx, state, event);
      if(!dest_assignment) {
        return stdx::Unexpected(dest_assignment.error());
      }
      continue;
    }

    uint16_t tray_id = move->GetTrayId().value();
    auto tray_opt = state.working_state.GetTray(tray_id);

    // Only disabled AGVs and trays block: the others can be moved. The TRAY id also collides with bays.
    const auto path_filter = BuildImmobileTrayFilter(tray_collision_id, state.working_state, {});
    const auto usable_dest = ResolveDestinationHeading(path_filter, tray_id, *move->GetDest());
    if(!usable_dest) {
      return stdx::Unexpected(usable_dest.error());
    }
    move->SetDest(*usable_dest);

    const CollisionEntityId_t root_tray_collision_id =
        CollisionEntityIdFromTrayState(tray_opt.value(), state.working_state, *(motion_graph_.GetLayout()));
    BlockingTrayState start_state;
    start_state.vert = motion_graph_.GetVertexFromPose(tray_opt->pose).value();
    const auto dest_vertex = motion_graph_.GetVertexFromPose(move->GetDest().value()).value();
    BlockingTraySearchEnvironment blocking_search_env(tray_id, root_tray_collision_id, motion_graph_,
        collision_table_, state.working_state, cost_model_, dest_vertex, path_filter);
    auto blocking_solution = SingleSourceSearch(start_state, Interval::Duration(0), blocking_search_env);

    if(!blocking_solution.GetTarget().has_value()) {
      return stdx::Unexpected("Failed to find path for t{} from {} to {}", tray_id, tray_opt->pose,
          std::to_string(move->GetDest().value()));
    }

    auto root_target = blocking_solution.GetTarget().value();
    auto root_path = blocking_solution.GetPath(root_target).value();
    auto root_tray_it = root_path.begin();

    std::vector<uint16_t> blocking_trays;
    std::set<uint16_t> blocking_tray_set;

    VertexCollisionIdMap root_path_illegal_poses;

    // Destinations already given to each blocking tray, so no tray shuffles back and forth between two spots.
    std::unordered_map<uint16_t, VertexCollisionIdMap> prior_dests_by_blocking_tray;
    auto with_prior_dests = [&prior_dests_by_blocking_tray](
                                uint16_t blocking_tray_id, VertexCollisionIdMap illegal_poses) {
      auto it = prior_dests_by_blocking_tray.find(blocking_tray_id);
      if(it != prior_dests_by_blocking_tray.end()) {
        for(const auto& [vertex, id] : it->second) {
          illegal_poses.insert({vertex, id});
        }
      }
      return illegal_poses;
    };

    for(const auto& [path_state, _] : root_path) {
      root_path_illegal_poses[path_state.vert] = root_tray_collision_id;

      for(auto blocking_tray_id : path_state.blocking_trays) {
        if(blocking_tray_set.insert(blocking_tray_id).second) {
          blocking_trays.push_back(blocking_tray_id);
        }
      }
    }

    while(!blocking_trays.empty()) {
      auto blocking_tray_id = blocking_trays.front();

      PlannedTrayMoves required_moves;
      const auto resolve_blocking_tray = [&](VertexCollisionIdMap illegal_poses) {
        auto [resolved_dest, repark_moves] = ResolveBlockingTrays(state.working_state,
            {.tray_id = blocking_tray_id,
                .immobile_trays = {tray_id},
                .illegal_poses = std::move(illegal_poses)},
            move->GetJobIndex());
        required_moves.insert(required_moves.end(), std::make_move_iterator(repark_moves.begin()),
            std::make_move_iterator(repark_moves.end()));
        return resolved_dest;
      };
      auto dest = resolve_blocking_tray(with_prior_dests(blocking_tray_id, root_path_illegal_poses));

      if(!dest) {
        // Both tiers failed off the root path: advance the root tray one step and retry, then allow parking
        // on the root path.
        // TODO(any): Allow parking only on the part of the root path past this blocking tray, and
        // keep advancing until the root-path repark succeeds or no advance is left.

        auto next_step = std::next(root_tray_it);
        if(next_step == root_path.end()) {
          // Can't happen: reaching the dest directly would mean there are no blocking trays.
          return stdx::Unexpected(
              "Failed to find blocking tray resolution. Logic "
              "error, we advanced to dest "
              "without having resolved all blocking trays.");
        }

        auto next_solution = next_step->first;
        auto next_pose = motion_graph_.GetPoseFromVertex(next_solution.vert).value();

        bool is_blocking = false;
        for(const auto& [other_tray_id, other_tray] : state.working_state.GetTrays()) {
          if(other_tray_id == tray_id) {
            continue;
          }
          CollisionEntityId_t other_collision_id =
              CollisionEntityIdFromTrayState(other_tray, state.working_state, *(motion_graph_.GetLayout()));

          if(collision_table_.Query(other_collision_id, root_tray_collision_id, other_tray.pose, next_pose)) {
            is_blocking = true;
            break;
          }
        }
        if(!is_blocking) {
          auto advance_move = MakeTrayMove(move->GetJobIndex(), tray_id, next_pose);

          root_path_illegal_poses.erase(motion_graph_.GetVertexFromPose(tray_opt->pose).value());
          const auto pre_advance_pose = tray_opt->pose;

          auto [success, message] = advance_move->ApplyTo(state.working_state);
          if(!success) {
            LOG_ERROR(logger_, "Failed to apply advance move: {}: {}", advance_move->ToString(), message);
            return stdx::Unexpected(
                "Failed to apply advance move: {}: {}", advance_move->ToString(), message);
          }
          tray_opt = state.working_state.GetTray(tray_id);
          root_tray_it = next_step;

          required_moves.push_back({.move = advance_move,
              .occupied_poses = {pre_advance_pose, next_pose},
              .source_pose_if_applied = pre_advance_pose});

          dest = resolve_blocking_tray(with_prior_dests(blocking_tray_id, root_path_illegal_poses));
        }

        if(!dest) {
          dest = resolve_blocking_tray(with_prior_dests(blocking_tray_id, {}));
          if(!dest) {
            return stdx::Unexpected("Failed to find open space for blocking tray t{}", blocking_tray_id);
          }
        }
      }

      // Recorded with the blocking tray's own footprint, which may differ from the root tray's.
      prior_dests_by_blocking_tray[blocking_tray_id][motion_graph_.GetVertexFromPose(dest.value()).value()] =
          CollisionEntityIdFromTrayState(state.working_state.GetTray(blocking_tray_id).value(),
              state.working_state, *(motion_graph_.GetLayout()));

      std::shared_ptr<TrayMove> last_move;

      auto new_move = MakeTrayMove(move->GetJobIndex(), blocking_tray_id, dest);

      // Unordered: the blocking tray's move claims the whole root path.
      std::vector<interfaces::msg::GaragePose> root_path_poses;
      for(const auto& [vertex, _] : root_path_illegal_poses) {
        root_path_poses.push_back(motion_graph_.GetPoseFromVertex(vertex).value());
      }

      required_moves.push_back({.move = new_move, .occupied_poses = root_path_poses});

      for(auto& [unblock_move, occupied_poses, source_pose_if_applied] : required_moves) {
        auto source_pose = state.working_state.GetTray(unblock_move->GetTrayId().value())->pose;
        if(source_pose_if_applied) {
          source_pose = *source_pose_if_applied;
        }
        else if(const auto [is_applied, message] = unblock_move->ApplyTo(state.working_state); !is_applied) {
          return stdx::Unexpected(
              "Failed to apply unblocking move: {}: {}", unblock_move->ToString(), message);
        }
        ctx->event_dag.AddEvent(unblock_move);
        if(last_move) {
          ctx->event_dag.AddDependency(last_move, unblock_move);
        }

        ChainTrayEvent(*ctx, state, unblock_move->GetTrayId().value(), unblock_move);
        last_move = unblock_move;

        // Ordered after every earlier occupant of each pose; excess edges are pruned later.
        const auto collision_id =
            ComputeTrayCollisionId(state.working_state, unblock_move->GetTrayId().value());
        for(auto& pose : occupied_poses) {
          if(const auto ordered = OrderAfterPriorOccupants(*ctx, state, pose, collision_id, unblock_move);
              !ordered) {
            return ordered;
          }
          if(const auto registered =
                  state.occupancy_history.AddOccupant(pose, collision_id, unblock_move, true);
              !registered) {
            return registered;
          }
        }

        if(const auto registered = state.occupancy_history.AddOccupant(
               source_pose, common::EnumInteger(CollisionEntityId::TRAY), unblock_move, true);
            !registered) {
          return registered;
        }
      }

      ctx->event_dag.AddDependency(new_move, event);

      blocking_trays.clear();
      blocking_tray_set.clear();

      for(auto it = root_tray_it; it != root_path.end(); ++it) {
        auto root_path_vertex = it->first.vert;
        auto root_path_pose = motion_graph_.GetPoseFromVertex(root_path_vertex).value();
        for(const auto& [other_tray_id, other_tray] : state.working_state.GetTrays()) {
          if(other_tray_id == tray_id) {
            continue;
          }

          CollisionEntityId_t other_collision_id =
              CollisionEntityIdFromTrayState(other_tray, state.working_state, *(motion_graph_.GetLayout()));

          if(collision_table_.Query(
                 other_collision_id, root_tray_collision_id, other_tray.pose, root_path_pose)) {
            if(blocking_tray_set.insert(other_tray_id).second) {
              blocking_trays.push_back(other_tray_id);
            }
          }
        }
      }
    }

    if(const auto ordered =
            OrderAfterPriorOccupants(*ctx, state, move->GetDest().value(), tray_collision_id, event);
        !ordered) {
      return ordered;
    }
    // The source too: a move out of a bay waits for the bay's last transition.
    if(const auto ordered = OrderAfterPriorOccupants(*ctx, state, tray_opt->pose, tray_collision_id, event);
        !ordered) {
      return ordered;
    }

    if(const auto registered = state.occupancy_history.AddOccupant(
           tray_opt->pose, common::EnumInteger(CollisionEntityId::TRAY), event, true);
        !registered) {
      return registered;
    }

    auto [apply_ok, message] = event->ApplyTo(state.working_state);
    if(!apply_ok) {
      return stdx::Unexpected(
          "Failed to apply event during tray assignment: {}: {}", event->ToString(), message);
    }
    ChainTrayEvent(*ctx, state, tray_id, event);
  }

  auto new_total_ordering_opt = ctx->event_dag.GetTopologicalOrdering();
  if(!new_total_ordering_opt.has_value()) {
    LOG_ERROR(logger_, "Failed to get new total ordering. Tray assignments introduced a loop!!!!");
    return stdx::Unexpected("Failed to get new total ordering");
  }

  return {};
}

stdx::Result Scheduler::ApplyBayOrChargerTransition(
    TrayAssignmentState& state, const std::shared_ptr<ScheduleEvent>& event) const {
  // The TRAY id makes every later move into or out of the bay or VECS wait for this transition.
  const auto tray_collision_id = common::EnumInteger(CollisionEntityId::TRAY);

  std::optional<interfaces::msg::GaragePose> transition_pose;
  if(const auto* bay_transition = dynamic_cast<const BayTransition*>(event.get())) {
    transition_pose = MakeBayInboundPose(bay_transition->GetBayId());
  }
  else if(const auto* ev_charger_transition = dynamic_cast<const VecsTransition*>(event.get())) {
    const auto ev_charger_id = ev_charger_transition->GetVecsId();
    transition_pose = MakeInboundPose(layout_->GetNodeById(ev_charger_id).value());
  }
  if(!transition_pose.has_value()) {
    return {};
  }
  if(const auto registered = state.occupancy_history.AddOccupant(*transition_pose, tray_collision_id, event);
      !registered) {
    return registered;
  }
  if(const auto [success, message] = event->ApplyTo(state.working_state); !success) {
    return stdx::Unexpected("Failed to apply event while assigning trays: {}", message);
  }
  return {};
}

stdx::Result Scheduler::AssignEmptyTrayToMove(
    TrayMove& move, const DiscreteGarageState& working_state) const {
  if(!move.GetDest()) {
    return stdx::Unexpected("Can't resolve a tray move with no tray id or dest");
  }
  auto source_vertex_opt = motion_graph_.GetVertexFromPose(move.GetDest().value());
  if(!source_vertex_opt) {
    return stdx::Unexpected("Tray pose does not exist in garage graph");
  }
  BlockingTrayState start_state;
  start_state.vert = source_vertex_opt.value();

  const auto path_filter =
      BuildImmobileTrayFilter(common::EnumInteger(CollisionEntityId::TRAY), working_state, {});

  EmptyTraySearchEnvironment empty_search_env(
      motion_graph_, collision_table_, working_state, cost_model_, path_filter);
  auto search_solution = SingleSourceSearch(start_state, Interval::Duration(0), empty_search_env);

  if(!search_solution.GetTarget().has_value()) {
    return stdx::Unexpected(
        "Failed to find empty tray to move to {}", std::to_string(move.GetDest().value()));
  }

  auto tray_to_use =
      working_state
          .GetTrayOnNode(motion_graph_.GetPoseFromVertex(search_solution.GetTarget().value().vert)->node_id)
          .value();

  move.SetTrayId(tray_to_use.id);

  auto dest_opt = move.GetDest();
  if(dest_opt && IsSameOrOppositeHeading(tray_to_use.pose.heading, dest_opt->heading)) {
    auto node_opt = layout_->GetNodeById(dest_opt->node_id);
    if(node_opt) {
      interfaces::msg::GaragePose dest_pose = dest_opt.value();
      if(tray_to_use.pose.heading != dest_pose.heading) {
        dest_pose.heading = tray_to_use.pose.heading;
        move.SetDest(dest_pose);
      }
    }
  }
  return {};
}

stdx::Result Scheduler::AssignDestinationAndUnblockingMoves(
    PlanContextSPtr ctx, TrayAssignmentState& state, const std::shared_ptr<ScheduleEvent>& event) const {
  auto move = dynamic_cast<TrayMove*>(event.get());
  if(!move->GetTrayId()) {
    return stdx::Unexpected("Can't resolve a tray move with no tray id or dest");
  }
  const auto tray_id = move->GetTrayId().value();
  const auto tray_opt = state.working_state.GetTray(tray_id);
  if(!tray_opt) {
    return stdx::Unexpected("TrayMove with TrayId={} does not exist in working_state", tray_id);
  }
  const auto payload_opt = state.working_state.GetPayload(tray_opt->payload_id);
  auto [dest, required_moves] = ResolveBlockingTrays(state.working_state,
      {.tray_id = tray_id, .is_retrieval_heading_enforced = payload_opt.has_value()}, move->GetJobIndex());
  if(!dest) {
    return stdx::Unexpected("Failed to find open space for t{}", tray_id);
  }

  if(IsParkingWithoutBayOrCharger(state.working_state, dest->node_id)) {
    if(payload_opt.has_value()) {
      dest->heading =
          FindPreferredTrayHeadingForRetrieval(dest->node_id, payload_opt).value_or(dest->heading);
    }
    else {
      // Tray orientation doesn't matter if there is no payload.
      KeepTrayHeadingIfEquivalent(*dest, tray_opt->pose.heading);
    }
  }
  move->SetDest(*dest);

  std::shared_ptr<TrayMove> last_move;
  for(auto& [new_move, occupied_poses, _] : required_moves) {
    auto source_pose = state.working_state.GetTray(new_move->GetTrayId().value())->pose;
    auto [apply_ok, apply_message] = new_move->ApplyTo(state.working_state);
    if(!apply_ok) {
      return stdx::Unexpected("Failed to apply unblocking move required: {}", apply_message);
    }
    ctx->event_dag.AddEvent(new_move);
    if(last_move) {
      ctx->event_dag.AddDependency(last_move, new_move);
    }
    ChainTrayEvent(*ctx, state, new_move->GetTrayId().value(), new_move);
    last_move = new_move;

    // Ordered after every earlier occupant along the path, so moves in one parking column stay ordered.
    const auto collision_id = ComputeTrayCollisionId(state.working_state, new_move->GetTrayId().value());
    for(auto& pose : occupied_poses) {
      if(const auto ordered = OrderAfterPriorOccupants(*ctx, state, pose, collision_id, new_move); !ordered) {
        return ordered;
      }
      if(const auto registered = state.occupancy_history.AddOccupant(pose, collision_id, new_move, true);
          !registered) {
        return registered;
      }
    }
    if(const auto registered = state.occupancy_history.AddOccupant(source_pose, collision_id, new_move, true);
        !registered) {
      return registered;
    }
  }

  auto [success, message] = move->ApplyTo(state.working_state);
  if(!success) {
    return stdx::Unexpected(message);
  }
  if(last_move) {
    ctx->event_dag.AddDependency(last_move, event);
  }
  ChainTrayEvent(*ctx, state, move->GetTrayId().value(), event);
  return {};
}

GraphFilterProperties Scheduler::BuildImmobileTrayFilter(CollisionEntityId_t collision_entity,
    const DiscreteGarageState& working_state, const std::set<uint16_t>& immobile_trays) const {
  // Paths may pass through every tray except the immobile ones.
  std::unordered_set<uint16_t> trays;
  for(const auto& [id, _] : working_state.GetTrays()) {
    if(immobile_trays.find(id) == immobile_trays.end()) {
      trays.insert(id);
    }
  }
  std::unordered_set<uint16_t> agvs;
  for(const auto& [agv_id, _] : working_state.GetAgvs()) {
    agvs.insert(agv_id);
  }
  return BuildStaticObstacleFilter(
      collision_entity, motion_graph_, working_state, collision_table_, trays, agvs, {});
}

stdx::Expected<interfaces::msg::GaragePose> Scheduler::ResolveDestinationHeading(
    const GraphFilterProperties& path_filter, uint16_t tray_id,
    const interfaces::msg::GaragePose& dest) const {
  if(const auto vertex_opt = motion_graph_.GetVertexFromPose(dest)) {
    if(!path_filter.IsEnabled(*vertex_opt)) {
      return stdx::Unexpected("Requested to move tray to {} but it's occupied, or not enabled.", dest);
    }
    return dest;
  }
  const auto opposite_dest = ReversePoseHeading(dest);
  const auto opposite_vertex_opt = motion_graph_.GetVertexFromPose(opposite_dest);
  if(!opposite_vertex_opt) {
    return stdx::Unexpected("Requested to move tray to {} but could not get a valid vertex from the pose {}",
        dest, opposite_dest);
  }
  if(!path_filter.IsEnabled(*opposite_vertex_opt)) {
    return stdx::Unexpected(
        "Requested to move tray {} to {} but it's occupied, or not enabled.", tray_id, dest);
  }
  return opposite_dest;
}

TrayDestinationPlan Scheduler::ResolveBlockingTrays(
    const DiscreteGarageState& base_state, const ResolveRequest& request, size_t job_index) const {
  auto working_state = base_state;
  auto tray_opt = base_state.GetTray(request.tray_id);
  const CollisionEntityId_t collision_entity =
      CollisionEntityIdFromTrayState(tray_opt.value(), working_state, *(motion_graph_.GetLayout()));

  std::optional<interfaces::msg::GaragePose> dest;
  PlannedTrayMoves required_moves;

  // Resolve blocking trays one at a time, fewest extra moves first, then re-search for the root tray.
  // This pushes them deeper instead of reparking them across the garage.
  while(!dest) {
    auto search_result = FindDestinationForRootTray(working_state, request, collision_entity);
    if(!search_result.has_value()) {
      return {};
    }
    const auto& target = search_result->target;
    if(target.blocking_trays.empty()) {
      dest = motion_graph_.GetPoseFromVertex(target.vert).value();
      continue;
    }

    std::optional<BlockingTrayResolution> resolution_opt;
    for(const auto& blocking_tray_id : target.blocking_trays) {
      resolution_opt = FindBlockingTrayResolution(
          working_state, request, blocking_tray_id, search_result->blocking_tray_illegal_poses, job_index);
      if(resolution_opt) {
        break;
      }
    }
    if(!resolution_opt.has_value()) {
      LOG_ERROR(logger_, "Failed to find open space for any blocking trays of t{}", request.tray_id);
      return {};
    }

    for(auto& prereq : resolution_opt->prereq_moves) {
      auto [prereq_ok, prereq_message] = prereq.move->ApplyTo(working_state);
      if(!prereq_ok) {
        LOG_ERROR(logger_, "Failed to apply recursive prereq move for blocking tray: {}", prereq_message);
        return {};
      }
      required_moves.push_back(std::move(prereq));
    }

    // TODO(any): Apply the preferred retrieval heading to this destination.
    auto new_move = MakeTrayMove(job_index, resolution_opt->tray_id, resolution_opt->dest);

    auto [success, message] = new_move->ApplyTo(working_state);
    if(!success) {
      LOG_ERROR(logger_, "Failed to apply new move: {}", message);
      return {};
    }
    required_moves.push_back(
        {.move = std::move(new_move), .occupied_poses = std::move(resolution_opt->occupied_poses)});
  }

  // A TYPE_WAYPOINT stash is left for a later plan: a repark here would run before the root tray's move.
  return {.dest = std::move(dest), .required_moves = std::move(required_moves)};
}

CollisionEntityId_t Scheduler::ComputeTrayCollisionId(
    const DiscreteGarageState& working_state, uint16_t tray_id) const {
  return CollisionEntityIdFromTrayState(working_state.GetTray(tray_id).value(), working_state, *layout_);
}

stdx::Result Scheduler::OrderAfterPriorOccupants(PlanContext& ctx, const TrayAssignmentState& state,
    const interfaces::msg::GaragePose& pose, CollisionEntityId_t collision_id,
    const ScheduleEventSPtr& event) const {
  const auto blockers_or = state.occupancy_history.GetBlockers(pose, collision_id);
  if(!blockers_or) {
    return stdx::Unexpected(blockers_or.error());
  }
  for(const auto& blocker : *blockers_or) {
    if(blocker == event) {
      continue;
    }
    const auto is_dependency_added = ctx.event_dag.AddDependency(blocker, event);
    LOG_DEBUG_IF(logger_, is_dependency_added, "Adding dependency on move to {} on move to {}",
        event->ToString(), blocker->ToString());
  }
  return {};
}

std::optional<int16_t> Scheduler::FindPreferredTrayHeadingForRetrieval(
    uint32_t node_id, const std::optional<interfaces::msg::DiscretePayloadState>& payload_opt) const {
  if(!payload_opt.has_value()) {
    return std::nullopt;
  }
  const auto retrieval_heading_opt = motion_graph_.GetRetrievalHeading(node_id);
  if(!retrieval_heading_opt.has_value()) {
    return std::nullopt;
  }
  return payload_opt->reciprocal_to_tray ? ReverseHeading(*retrieval_heading_opt) : *retrieval_heading_opt;
}

std::optional<Scheduler::OpenSpaceSearchResult> Scheduler::FindDestinationForRootTray(
    const DiscreteGarageState& working_state, const ResolveRequest& request,
    CollisionEntityId_t collision_entity) const {
  auto tray_opt = working_state.GetTray(request.tray_id);
  BlockingTrayState start_state;
  start_state.vert = motion_graph_.GetVertexFromPose(tray_opt->pose).value();

  const auto path_filter = BuildImmobileTrayFilter(collision_entity, working_state, request.immobile_trays);
  const auto run_search = [&](bool is_retrieval_heading_enforced, bool is_waypoint_stash_allowed) {
    OpenSpaceSearchEnvironment search_env(request.tray_id, collision_entity, motion_graph_, collision_table_,
        working_state, cost_model_, request.illegal_poses, path_filter, std::nullopt,
        is_retrieval_heading_enforced, is_waypoint_stash_allowed);
    return SingleSourceSearch(start_state, Interval::Duration(0), search_env);
  };
  auto search_solution =
      run_search(request.is_retrieval_heading_enforced, /*is_waypoint_stash_allowed=*/false);
  if(!search_solution.GetTarget().has_value() && request.is_waypoint_stash_allowed) {
    // Tier 2: allow a TYPE_WAYPOINT stash.
    search_solution = run_search(/*is_retrieval_heading_enforced=*/false, /*is_waypoint_stash_allowed=*/true);
  }

  if(!search_solution.GetTarget().has_value()) {
    return std::nullopt;
  }

  // Block intermediate path nodes so a blocking tray can't park there and make the outer loop cycle.
  // The destination stays open: parking there makes the outer loop pick another destination.
  OpenSpaceSearchResult open_space {search_solution.GetTarget().value(), request.illegal_poses};
  const auto original_tray_path = search_solution.GetPath(open_space.target);
  if(original_tray_path.has_value()) {
    for(const auto& [state, _] : original_tray_path.value()) {
      if(state.vert == open_space.target.vert) {
        continue;
      }
      open_space.blocking_tray_illegal_poses[state.vert] = collision_entity;
    }
  }
  return open_space;
}

std::optional<Scheduler::BlockingTrayResolution> Scheduler::FindBlockingTrayResolution(
    const DiscreteGarageState& working_state, const ResolveRequest& root_request, uint16_t blocking_tray_id,
    const VertexCollisionIdMap& blocking_tray_illegal_poses, size_t job_index) const {
  auto blocking_tray_state = working_state.GetTray(blocking_tray_id).value();
  CollisionEntityId_t blocking_collision_entity =
      CollisionEntityIdFromTrayState(blocking_tray_state, working_state, *(motion_graph_.GetLayout()));

  BlockingTrayState start_state;
  start_state.vert = motion_graph_.GetVertexFromPose(blocking_tray_state.pose).value();

  const auto path_filter =
      BuildImmobileTrayFilter(blocking_collision_entity, working_state, root_request.immobile_trays);

  auto run_search = [&](bool is_waypoint_stash_allowed) {
    OpenSpaceSearchEnvironment env(blocking_tray_id, blocking_collision_entity, motion_graph_,
        collision_table_, working_state, cost_model_, blocking_tray_illegal_poses, path_filter, std::nullopt,
        root_request.is_retrieval_heading_enforced, is_waypoint_stash_allowed);
    return SingleSourceSearch(start_state, Interval::Duration(0), env);
  };

  auto tray_solution = run_search(/*is_waypoint_stash_allowed=*/false);
  if(!tray_solution.GetTarget().has_value()) {
    // Tier 2: allow a TYPE_WAYPOINT stash.
    tray_solution = run_search(/*is_waypoint_stash_allowed=*/true);
  }

  if(!tray_solution.GetTarget().has_value()) {
    return std::nullopt;
  }
  auto target = tray_solution.GetTarget().value();

  if(target.blocking_trays.empty()) {
    auto path_opt = tray_solution.GetPath(target);
    if(!path_opt.has_value()) {
      return std::nullopt;
    }
    std::vector<interfaces::msg::GaragePose> blocking_tray_path;
    for(const auto& [state, _] : path_opt.value()) {
      blocking_tray_path.push_back(motion_graph_.GetPoseFromVertex(state.vert).value());
    }
    return BlockingTrayResolution {.tray_id = blocking_tray_id,
        .dest = motion_graph_.GetPoseFromVertex(target.vert).value(),
        .occupied_poses = std::move(blocking_tray_path),
        .prereq_moves = {}};
  }

  // Mark the root tray immobile so the recursion can't reuse it to break the deadlock.
  auto immobile_trays_with_root = root_request.immobile_trays;
  immobile_trays_with_root.insert(root_request.tray_id);
  auto [recursive_dest, recursive_prereqs] = ResolveBlockingTrays(working_state,
      {.tray_id = blocking_tray_id,
          .immobile_trays = std::move(immobile_trays_with_root),
          .illegal_poses = blocking_tray_illegal_poses,
          .is_retrieval_heading_enforced = root_request.is_retrieval_heading_enforced},
      job_index);
  if(!recursive_dest.has_value()) {
    return std::nullopt;
  }
  return BlockingTrayResolution {.tray_id = blocking_tray_id,
      .dest = recursive_dest.value(),
      .occupied_poses = {},
      .prereq_moves = std::move(recursive_prereqs)};
}

}  // namespace volley::scheduler
</file>

