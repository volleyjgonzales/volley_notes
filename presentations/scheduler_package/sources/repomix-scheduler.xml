TEST(SchedulerState, SetBayReadinessRatioService) {
  const auto layout_filepath_or = GetLayoutPathByName(kLayoutName);
  ASSERT_TRUE(layout_filepath_or.has_value()) << layout_filepath_or.error();
  const auto& layout_filepath = layout_filepath_or.value();

  SchedulerParams params {};
  params.target_insert_ready_bay_fraction = 0.5;

  // This test changes the ratio through the service callback, so it owns its scheduler instead of
  // sharing the binary's.
  Scheduler scheduler(layout_filepath, rclcpp::get_logger("scheduler"), params);

  rclcpp::Time now = rclcpp::Time(0);
  EXPECT_EQ(scheduler.GetSchedulerReport(now)->bay_readiness_ratio, 0.5f);

