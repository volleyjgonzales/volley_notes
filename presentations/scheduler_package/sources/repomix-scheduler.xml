#include <gtest/gtest.h>

#include <interfaces/msg/action_node.hpp>
#include <interfaces/msg/bay_command.hpp>
#include <interfaces/msg/garage_pose.hpp>
#include <interfaces/msg/scheduler_job.hpp>
#include <interfaces/msg/vecs_command.hpp>
#include <string>

#include "scheduler/scheduler.hpp"
#include "scheduler/test/agv_commands.hpp"
#include "scheduler/test/scenarios/plan.hpp"

namespace volley::scheduler::test {

namespace {

// On 38_gramercy the bay is the car lift BL26 on floor 1, so the AGV commands end in the lift node,
// VRC commands carry the car up and a PROCESS_RETRIEVE ends the schedule.
void ExpectRetrieveThroughLift(const scenarios::Run& run, bool is_unplug_expected) {
  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  for(const auto& job : run.response.scheduled_jobs) {
    ASSERT_EQ(job.job.state, interfaces::msg::SchedulerJob::STATE_EXECUTING);
  }

  const auto& schedule = run.response.schedule.nodes;
  ASSERT_FALSE(schedule.empty());
  auto prev_dst = ConstructGaragePose(19, 90);
  bool has_lift = false;
  bool has_lower = false;
  bool has_lift_command = false;
  bool is_charging_stopped = false;
  interfaces::msg::GaragePose lowered {};
  for(const auto& node : schedule) {
    if(node.type == interfaces::msg::ActionNode::TYPE_VRC_COMMAND) {
      has_lift_command = true;
      continue;
    }
    if(node.type == interfaces::msg::ActionNode::TYPE_VECS_COMMAND) {
      EXPECT_FALSE(has_lift) << "the charger is unplugged before the tray is lifted";
      EXPECT_EQ(node.vecs_command.command_type, interfaces::msg::VecsCommand::COMMAND_TYPE_STOP_CHARGING);
      is_charging_stopped = true;
      continue;
    }
    if(node.type == interfaces::msg::ActionNode::TYPE_BAY_COMMAND) {
      EXPECT_EQ(node.bay_command.command_type, interfaces::msg::BayCommand::COMMAND_TYPE_PROCESS_RETRIEVE);
      continue;
    }
    // AGV commands chain; the lift carries the AGV from L2 to BL26 between two of them
    EXPECT_EQ(interfaces::msg::ActionNode::TYPE_AGV_COMMAND, node.type);
    const auto& src = node.agv_command.src.pose;
    EXPECT_TRUE(
        src == prev_dst || (prev_dst.node_id == 2 && src.node_id == 26 && src.heading == prev_dst.heading))
        << "command from " << std::to_string(src) << " after " << std::to_string(prev_dst);
    prev_dst = node.agv_command.dst.pose;
    if(IsAgvLiftLowered(node.agv_command)) {
      has_lower = true;
      lowered = node.agv_command.dst.pose;
    }
    has_lift = has_lift || IsAgvLiftRaised(node.agv_command);
  }
  EXPECT_TRUE(has_lift);
  EXPECT_TRUE(has_lower);
  EXPECT_TRUE(has_lift_command);
  EXPECT_EQ(26u, lowered.node_id) << "the car is lowered in the lift";
  EXPECT_EQ(is_unplug_expected, is_charging_stopped);
  EXPECT_EQ(schedule.back().type, interfaces::msg::ActionNode::TYPE_BAY_COMMAND);
}

}  // namespace

TEST(RetrieveJob, FromReadyCharger) {
  ExpectRetrieveThroughLift(scenarios::Plan(), false);
}

TEST(RetrieveJob, FromUnavailableCharger) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  EXPECT_EQ(run.response.id, run.request.id);

  for(const auto& job : run.response.scheduled_jobs) {
    ASSERT_EQ(job.job.state, interfaces::msg::SchedulerJob::STATE_ERROR);
  }
}

TEST(RetrieveJob, WhileCharging) {
  ExpectRetrieveThroughLift(scenarios::Plan(), true);
}

}  // namespace volley::scheduler::test
</file>

