TEST(TrayAssignment, ResolvesBlockerChainRecursively) {
  // The block is closed off and full but for P2149, so the root tray at P2117 can only reach it
  // through the tray at P2118, whose own escape passes through the tray at P2134: the search
  // must recurse into the blocker's blocker.
  const auto garage = initial_states::Load("275_sunrise_b/eight_empty_trays_no_agv");

  const auto scheduler = scenarios::SharedScheduler(garage.layout_path, SchedulerParams {});

  // The root tray is tray 6, at P2117; the job index is arbitrary for this unit test.
  constexpr uint16_t k_root_tray_id = 6;
  constexpr size_t k_job_index = 0u;
  auto [dest, required_moves] =
      scheduler->ResolveBlockingTrays(garage.state, {.tray_id = k_root_tray_id}, k_job_index);

  ASSERT_TRUE(dest.has_value()) << "Recursive resolution should produce a destination for the root tray";

  // Without recursion the chain would be rejected and no moves returned.
  EXPECT_GE(required_moves.size(), 2u)
      << "Recursive resolution should produce at least two tray moves (one prereq + the front blocker)";

  // Every move has a destination and no two moves share one.
  std::set<uint32_t> distinct_dest_nodes;
  for(const auto& [move, _occupied_poses, _source_pose_if_applied] : required_moves) {
    ASSERT_NE(move, nullptr);
    const auto move_dest = move->GetDest();
    ASSERT_TRUE(move_dest.has_value()) << "Every move in a recursive chain must have a set destination";
    distinct_dest_nodes.insert(move_dest->node_id);
  }
  EXPECT_EQ(distinct_dest_nodes.size(), required_moves.size())
      << "Each move in a recursive chain should target a distinct node";
}

TEST(TrayAssignment, ThenAgvAssignment) {
  const auto garage = scenarios::Stage("tray_assignment").initial;

  const auto scheduler = scenarios::SharedScheduler(garage.layout_path, SchedulerParams {});
  interfaces::msg::Guid request_id = MakeGuid(0, 0xDEADBEEF);
  const auto ctx = std::make_shared<PlanContext>(request_id, garage.state, scenarios::kNow);

  const auto tray_move = std::make_shared<TrayMove>(0u);
  tray_move->SetTrayId(1);
  ctx->event_dag.AddEvent(std::move(tray_move));
  const auto dag_before_tray = scenarios::Dag(*ctx);
  const auto tray_assignment = scheduler->AssignTrays(ctx);
  scenarios::ExpectStage("tray_assignment", dag_before_tray, *ctx);
  EXPECT_TRUE(tray_assignment) << tray_assignment.error();

  const auto dag_before_agv = scenarios::Dag(*ctx);
  const auto agv_assignment = scheduler->AssignAgvs(ctx);
  scenarios::ExpectStage("agv_assignment", dag_before_agv, *ctx);
  EXPECT_TRUE(agv_assignment) << agv_assignment.error();

  const auto topo_ordering = ctx->event_dag.GetTopologicalOrdering();
  ASSERT_TRUE(topo_ordering.has_value());

  const auto final_cont_state_or = scheduler->PlanMotions(ctx);
  EXPECT_TRUE(final_cont_state_or.has_value());
}

}  // namespace volley::scheduler::test
</file>

