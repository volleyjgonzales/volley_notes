    {"CHARGE_PAYLOAD", interfaces::msg::SchedulerJob::TYPE_CHARGE_PAYLOAD},
    {"REBALANCE_GARAGE", interfaces::msg::SchedulerJob::TYPE_REBALANCE_GARAGE},
};

[[nodiscard]] const YAML::Node Field(const YAML::Node& node, std::string_view key) {
  return node[std::string(key)];
}

}  // namespace

namespace volley::scheduler::test::scenarios {

void ExpectKeys(const YAML::Node& map, std::span<const std::string_view> allowed, std::string_view what) {
  for(const auto& item : map) {
    const auto key = item.first.as<std::string>();
    if(std::ranges::find(allowed, key) == allowed.end()) {
      throw std::runtime_error(std::format("unknown key '{}' in {}", key, what));
    }
  }
}

}  // namespace volley::scheduler::test::scenarios

namespace YAML {

// NOLINTBEGIN(readability-identifier-naming): `decode` is the name yaml-cpp looks up.

using volley::scheduler::test::scenarios::ExpectKeys;
using volley::scheduler::test::scenarios::Request;

bool convert<interfaces::msg::GaragePose>::decode(const Node& node, interfaces::msg::GaragePose& pose) {
  ExpectKeys(node, kPoseKeys, "a pose");
  pose =
      volley::ConstructGaragePose(Field(node, kNodeId).as<uint32_t>(), Field(node, kHeading).as<int16_t>());
  return true;
}

bool convert<interfaces::msg::SchedulerJob>::decode(const Node& node, interfaces::msg::SchedulerJob& job) {
  ExpectKeys(node, kJobKeys, "a job");
  const auto type = Field(node, kType).as<std::string>();
  const auto type_it = kJobTypes.find(type);
  if(type_it == kJobTypes.end()) {
    throw std::runtime_error(std::format("unknown job type '{}'", type));
  }
  job = interfaces::msg::SchedulerJob();
  job.type = type_it->second;
  job.type_name = type;
  job.state = interfaces::msg::SchedulerJob::STATE_UNPLANNED;
  job.state_name = "UNPLANNED";
  job.note = Field(node, kNote).as<std::string>("");
  job.agv_id = Field(node, kAgvId).as<uint16_t>(0);
  job.bay_id = Field(node, kBayId).as<uint16_t>(0);
  job.tray_id = Field(node, kTrayId).as<uint16_t>(0);
  if(const auto payload = Field(node, kPayload)) {
    const auto guid_or = volley::ParseGuid(payload.as<std::string>());
    if(!guid_or.has_value()) {
      throw std::runtime_error(std::format("bad payload GUID '{}'", payload.as<std::string>()));
    }
    job.payload_id = guid_or.value();
  }
  if(const auto destination = Field(node, kDestination)) {
    job.destination = destination.as<interfaces::msg::GaragePose>();
  }
  job.allow_reciprocal = Field(node, kAllowReciprocal).as<bool>(false);
  return true;
}

bool convert<interfaces::msg::ActionNode>::decode(const Node& node, interfaces::msg::ActionNode& command) {
  ExpectKeys(node, kCommandKeys, "a base_schedule command");
  command = interfaces::msg::ActionNode();
  command.type = interfaces::msg::ActionNode::TYPE_AGV_COMMAND;
  command.agv_id = Field(node, kAgvId).as<uint16_t>();
  command.agv_command.src.pose = Field(node, kFrom).as<interfaces::msg::GaragePose>();
  command.agv_command.dst.pose = Field(node, kTo).as<interfaces::msg::GaragePose>();
  return true;
}

bool convert<volley::scheduler::SchedulerParams>::decode(
    const Node& node, volley::scheduler::SchedulerParams& params) {
  ExpectKeys(node, kParamsKeys, "scheduler");
  params = volley::scheduler::SchedulerParams();
  params.target_insert_ready_bay_fraction = Field(node, kTargetInsertReadyBayFraction).as<float>(0.0f);
  return true;
}

bool convert<Request>::decode(const Node& node, Request& request) {
  ExpectKeys(node, kRequestKeys, "request");
  request = Request();
  for(const auto& item : Field(node, kJobs)) {
    request.jobs.push_back(item.as<interfaces::msg::SchedulerJob>());
  }
  for(const auto& item : Field(node, kBaseSchedule)) {
    request.base_schedule.push_back(item.as<interfaces::msg::ActionNode>());
  }
  return true;
}

// NOLINTEND(readability-identifier-naming)

}  // namespace YAML
