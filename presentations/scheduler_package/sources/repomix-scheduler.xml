namespace {
using std::chrono_literals::operator""s;
constexpr auto kVersionInfoPeriod = 5s;
constexpr auto kReportPeriod = 5s;
}  // namespace

namespace volley::scheduler {
using std::chrono_literals::operator""s;

SchedulerRos::SchedulerRos(const SchedulerParams& params, std::string layout_filepath, NodeSPtr node) :
    node_(node) {
  LOG_INFO(node_->get_logger(), "Starting scheduler node.");
  bool is_dag_printing_enabled = node->Param<bool>("printdags");

  scheduler_ = std::make_shared<Scheduler>(layout_filepath, node->get_logger(), params);
  scheduler_->is_dag_printing_enabled_ = is_dag_printing_enabled;

  publication_timer_callback_group_ =
      node_->create_callback_group(rclcpp::CallbackGroupType::MutuallyExclusive);

  version_info_pub_ = node_->create_publisher<interfaces::msg::VersionInfo>("version_info", 1u);
  version_info_timer_ = node_->create_timer(
      ::kVersionInfoPeriod, [this] { version_info_pub_->publish(scheduler_->GetVersionInfo(node_->now())); },
      publication_timer_callback_group_);

  report_pub_ = node_->create_publisher<interfaces::msg::SchedulerReport>("report", 1u);
  report_timer_ = node_->create_timer(
      ::kReportPeriod, [this] { report_pub_->publish(scheduler_->GetSchedulerReport(node_->now())); },
      publication_timer_callback_group_);

  plan_srv_ = rclcppx::CreateService<interfaces::srv::Plan>(
      node_, "plan",
      [this](interfaces::srv::Plan::Request::SharedPtr request,
          interfaces::srv::Plan::Response::SharedPtr response) {
        auto response_msg = scheduler_->Plan(request->request_data, node_->now());
        rclcpp::Time now = node_->now();
        for(auto& job_data : response_msg.scheduled_jobs) {
          job_data.job.time_planned = now;
        }
        response->response_data = std::move(response_msg);
        return response;
      },
      1u);

  // Engineering-only debug toggle, intentionally not introspected.
  debug_printdags_srv_ = node_->create_service<std_srvs::srv::Trigger>(
      "debug/printdags",
      [this](std_srvs::srv::Trigger::Request::SharedPtr request,
          std_srvs::srv::Trigger::Response::SharedPtr response) {
        (void)request;
        LOG_INFO(
            node_->get_logger(), "Note: printing DAGs requires 'sudo apt-get install libgraph-easy-perl'");
        scheduler_->ToggleDagPrinting();
        response->success = true;
        return response;
      },
      1u);

  clean_garage_cli_ =
      node->create_client<std_srvs::srv::Trigger>("/central/clean_garage", rclcpp::ServicesQoS());
  rebalance_garage_cli_ =
      node->create_client<std_srvs::srv::Trigger>("/central/rebalance_garage", rclcpp::ServicesQoS());
  bay_to_insert_cli_ = node_->create_client<interfaces::srv::TransitionBayToInsert>(
      "/central/transition_bay_to_insert", rclcpp::ServicesQoS());
  bay_to_retrieve_cli_ = node_->create_client<interfaces::srv::TransitionBayToRetrieve>(
      "/central/transition_bay_to_retrieve", rclcpp::ServicesQoS());

  scheduler_->clean_garage_request_fn_ = [this]() {
    if(clean_garage_cli_) {
      auto request = std::make_shared<std_srvs::srv::Trigger::Request>();
      clean_garage_cli_->async_send_request(request,
          [this](std::shared_future<std_srvs::srv::Trigger::Response::SharedPtr> future) { (void)future; });
    }
  };
  scheduler_->rebalance_garage_request_fn_ = [this]() {
    if(rebalance_garage_cli_) {
      auto request = std::make_shared<std_srvs::srv::Trigger::Request>();
      rebalance_garage_cli_->async_send_request(request,
          [this](std::shared_future<std_srvs::srv::Trigger::Response::SharedPtr> future) { (void)future; });
    }
  };
  scheduler_->reset_bay_state_request_fn_ = [this](uint16_t bay_id, uint16_t state) {
    if(state == interfaces::msg::BayReport::STATE_READY_TO_INSERT) {
      if(bay_to_insert_cli_) {
        auto request = std::make_shared<interfaces::srv::TransitionBayToInsert::Request>();
        request->bay_id = bay_id;
        bay_to_insert_cli_->async_send_request(request,
            [this](std::shared_future<interfaces::srv::TransitionBayToInsert::Response::SharedPtr> future) {
              (void)future;
            });
      }
    }
    else if(state == interfaces::msg::BayReport::STATE_READY_TO_RETRIEVE) {
      if(bay_to_retrieve_cli_) {
        auto request = std::make_shared<interfaces::srv::TransitionBayToRetrieve::Request>();
        request->bay_id = bay_id;
        bay_to_retrieve_cli_->async_send_request(request,
            [this](std::shared_future<interfaces::srv::TransitionBayToRetrieve::Response::SharedPtr> future) {
              (void)future;
            });
      }
    }
    else {
      LOG_ERROR(node_->get_logger(), "Transition to state {} is not supported", state);
    }
  };

  set_bay_readiness_ratio_srv_ =
      rclcppx::CreateService<interfaces::srv::SetFloat32>(node_, "set_bay_readiness_ratio",
          [this](interfaces::srv::SetFloat32::Request::SharedPtr request,
              interfaces::srv::SetFloat32::Response::SharedPtr response) {
            bool is_fraction_changed = scheduler_->SetBayReadinessRatioCallback(request, response);
            if(is_fraction_changed && scheduler_->rebalance_garage_request_fn_) {
              scheduler_->rebalance_garage_request_fn_();
            }
          });

  LOG_INFO(node_->get_logger(), "Scheduler node started");
}
}  // namespace volley::scheduler
