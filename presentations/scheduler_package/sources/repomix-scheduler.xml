namespace volley::scheduler::test {

TEST(BayJob, ReadyForRetrieve) {
  {
    const auto run = scenarios::Plan("empty_bay");
    EXPECT_TRUE(run.response.success) << run.response.message;
    EXPECT_EQ(run.response.id, run.request.id);

    const auto& schedule = run.response.schedule.nodes;
    ASSERT_EQ(1u, schedule.size());
    EXPECT_EQ(interfaces::msg::ActionNode::TYPE_BAY_COMMAND, schedule[0].type);
    EXPECT_EQ(interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_RETRIEVE,
        schedule[0].bay_command.command_type);
    EXPECT_EQ(2068u, schedule[0].bay_id);
  }
  {
    const auto run = scenarios::Plan("tray_in_bay");
    EXPECT_TRUE(run.response.success) << run.response.message;
    EXPECT_EQ(run.response.id, run.request.id);

    const auto& schedule = run.response.schedule.nodes;
    bool has_agv_as_child = false;
    bool has_bay_node = false;
    unsigned int bay_node_index = 0;
    for(unsigned int node_index = 0; node_index < schedule.size(); ++node_index) {
      auto& node = schedule[node_index];
      if(node.type == interfaces::msg::ActionNode::TYPE_BAY_COMMAND) {
        EXPECT_EQ(
            interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_RETRIEVE, node.bay_command.command_type);
        EXPECT_EQ(2068, node.bay_id);
        EXPECT_EQ(0, node.parents.size());
        has_bay_node = true;
        bay_node_index = node_index;
        continue;
      }
      EXPECT_EQ(interfaces::msg::ActionNode::TYPE_AGV_COMMAND, node.type);
      if(has_bay_node && !has_agv_as_child) {
        for(auto& parent : node.parents) {
          if(parent == bay_node_index) {
            has_agv_as_child = true;
            break;
          }
        }
      }
    }
    EXPECT_TRUE(has_agv_as_child);
    EXPECT_TRUE(has_bay_node);
  }
}

TEST(BayJob, Transitions) {
  {
    const auto run = scenarios::Plan("unknown_bay");
    EXPECT_TRUE(run.response.success) << run.response.message;
    ASSERT_EQ(1u, run.response.scheduled_jobs.size());
    EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_ERROR, run.response.scheduled_jobs[0].job.state);
    EXPECT_EQ(0u, run.response.schedule.nodes.size());
  }
  {
    const auto run = scenarios::Plan("wrong_command");
    EXPECT_TRUE(run.response.success) << run.response.message;
    ASSERT_EQ(1u, run.response.scheduled_jobs.size());
    EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_ERROR, run.response.scheduled_jobs[0].job.state);
    EXPECT_EQ(0u, run.response.schedule.nodes.size());
  }
  {
    const auto run = scenarios::Plan("to_retrieve");
    EXPECT_TRUE(run.response.success) << run.response.message;
    ASSERT_EQ(1u, run.response.scheduled_jobs.size());
    EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_EXECUTING, run.response.scheduled_jobs[0].job.state);
    ASSERT_EQ(1u, run.response.schedule.nodes.size());
    const auto& node = run.response.schedule.nodes[0];
    EXPECT_EQ(interfaces::msg::ActionNode::TYPE_BAY_COMMAND, node.type);
    EXPECT_EQ(7u, node.bay_id);
    EXPECT_EQ(
        interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_RETRIEVE, node.bay_command.command_type);
  }
  {
    const auto run = scenarios::Plan("to_insert");
    EXPECT_TRUE(run.response.success) << run.response.message;
    ASSERT_EQ(1u, run.response.scheduled_jobs.size());
    EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_EXECUTING, run.response.scheduled_jobs[0].job.state);
    ASSERT_EQ(1u, run.response.schedule.nodes.size());
    const auto& node = run.response.schedule.nodes[0];
    EXPECT_EQ(interfaces::msg::ActionNode::TYPE_BAY_COMMAND, node.type);
    EXPECT_EQ(7u, node.bay_id);
    EXPECT_EQ(interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_INSERT, node.bay_command.command_type);
  }
}

TEST(BayJob, CannotTransitionDisabledBay) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;

  ASSERT_EQ(1u, run.response.scheduled_jobs.size());

  const auto& job = run.response.scheduled_jobs[0];
  EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_ERROR, job.job.state);
  EXPECT_EQ(0u, run.response.schedule.nodes.size());
}

// An empty bay gets an empty tray (a move with a blank tray id) before transitioning to insert.
TEST(BayJob, ReadyForInsert) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  ASSERT_EQ(1u, run.response.scheduled_jobs.size());
  EXPECT_EQ(interfaces::msg::SchedulerJob::STATE_EXECUTING, run.response.scheduled_jobs[0].job.state);
  ASSERT_FALSE(run.response.schedule.nodes.empty());
  const auto& last_node = run.response.schedule.nodes.back();
  EXPECT_EQ(interfaces::msg::ActionNode::TYPE_BAY_COMMAND, last_node.type);
  EXPECT_EQ(
      interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_INSERT, last_node.bay_command.command_type);
}

TEST(BayJob, Deterministic) {
  scenarios::ExpectDeterministic();
}

}  // namespace volley::scheduler::test
