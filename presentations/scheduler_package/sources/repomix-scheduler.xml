namespace volley::scheduler::test::scenarios {
namespace {

/// @return @p response in its canonical form: action-node GUIDs come from a process-wide counter, so
/// each is replaced by the node's position, followed everywhere the GUID was copied; scheduled_jobs
/// are sorted by job GUID; then the document is compacted (see Compact).
[[nodiscard]] YAML::Node CanonicalResponse(const interfaces::msg::PlanResponse& response) {
  interfaces::msg::PlanResponse copy = response;
  std::map<std::string, interfaces::msg::Guid> positional;
  for(size_t position = 0; position < copy.schedule.nodes.size(); ++position) {
    auto& node = copy.schedule.nodes[position];
    const interfaces::msg::Guid guid = MakeGuid(0, position + 1);
    positional[std::to_string(node.guid)] = guid;
    node.guid = guid;
  }
  auto rename = [&](std::string& id) {
    if(const auto it = positional.find(id); it != positional.end()) {
      id = std::to_string(it->second);
    }
  };
  for(auto& node : copy.schedule.nodes) {
    rename(node.agv_command.id);
    rename(node.vecs_command.command_id);
    rename(node.vrc_command.command_id);
  }
  for(auto& job : copy.scheduled_jobs) {
    if(const auto it = positional.find(std::to_string(job.bay_arrival_node_guid)); it != positional.end()) {
      job.bay_arrival_node_guid = it->second;
    }
  }
  std::ranges::stable_sort(copy.scheduled_jobs, {},
      [](const interfaces::msg::ScheduledJobData& job) { return std::to_string(job.job.guid); });
  YAML::Node doc = MessageYaml(copy);
  Compact(doc);
  return doc;
}

}  // namespace

Run Plan(std::string_view suffix) {
  const auto path = PlanPath(suffix);
  Run run;
  run.scenario = Load(path);
  run.scheduler = SharedScheduler(run.scenario.initial.layout_path, run.scenario.params);
  run.request = BuildRequest(run.scenario, kNow);
  run.response = run.scheduler->Plan(run.request, kNow);
  YAML::Node recorded;
  recorded["output"]["response"] = CanonicalResponse(run.response);
  ExpectRecorded(path, recorded);
  return run;
}

void ExpectDeterministic() {
  std::vector<std::filesystem::path> paths;
  for(const auto& entry : std::filesystem::directory_iterator(PlanPath().parent_path())) {
    if(entry.path().extension() == ".yaml") {
      paths.push_back(entry.path());
    }
  }
  std::ranges::sort(paths);
  for(const auto& path : paths) {
    const Scenario scenario = Read(path);
    const auto scheduler = SharedScheduler(scenario.initial.layout_path, scenario.params);
    const auto request = BuildRequest(scenario, kNow);
    const YAML::Node planned = CanonicalResponse(scheduler->Plan(request, kNow));
    const YAML::Node replanned = CanonicalResponse(scheduler->Plan(request, kNow));
    ExpectSameDocument(planned, replanned, std::format("two plans of {}", path.filename().string()));
  }
}

}  // namespace volley::scheduler::test::scenarios
</file>

<file path="test/src/scenarios/recording.cpp">
#include "scheduler/test/scenarios/recording.hpp"

#include <gtest/gtest.h>

#include <algorithm>
#include <cstdint>
#include <cstdlib>
#include <format>
#include <fstream>
#include <interfaces/msg/guid.hpp>
#include <iostream>
#include <ranges>
#include <sstream>
#include <stdexcept>
#include <utility>
#include <vector>

#include "scheduler/test/scenarios/file.hpp"

namespace volley::scheduler::test::scenarios {
namespace {

/// The names the scenario files use for the message fields named by an acronym (the initial-state
/// files use the same ones; see initial_states.cpp).
constexpr std::pair<const char*, const char*> kFieldNames[] = {
    {"vexen", "ev_chargers"},
    {"vrcs", "vertical_conveyors"},
    {"vecs_id", "ev_charger_id"},
    {"vecs_command", "ev_charger_command"},
    {"vrc_id", "vertical_conveyor_id"},
    {"vrc_command", "vertical_conveyor_command"},
};

/// @return Whether @p node is a GUID message as to_yaml prints it: a map with the one key `bytes`.
[[nodiscard]] bool IsGuid(const YAML::Node& node) {
  return node.IsMap() && node.size() == 1 && node["bytes"] && node["bytes"].IsSequence() &&
         node["bytes"].size() == sizeof(interfaces::msg::Guid::bytes);
}

/// @return @p guid as one scalar: its value when only the last four bytes are set (the positional
/// GUIDs of a canonical response, the job GUIDs of a request), else the 8-4-4-4-12 form of
/// std::to_string(interfaces::msg::Guid), the one the initial-state files use.
[[nodiscard]] YAML::Node GuidScalar(const YAML::Node& guid) {
  const auto bytes = guid["bytes"].as<std::vector<unsigned>>();
  if(std::ranges::all_of(bytes | std::views::take(12), [](unsigned byte) { return byte == 0; })) {
    return YAML::Node((bytes[12] << 24U) | (bytes[13] << 16U) | (bytes[14] << 8U) | bytes[15]);
  }
  interfaces::msg::Guid message;
  std::ranges::transform(
      bytes, message.bytes.begin(), [](unsigned byte) { return static_cast<uint8_t>(byte); });
  return YAML::Node(std::to_string(message));
}

/// @return Whether @p node holds its message default (zero, empty, false, or a sub-message of
/// defaults); to_yaml quotes strings, so a quoted "0" or "false" is a string and stays.
[[nodiscard]] bool IsDefault(const YAML::Node& node) {
  if(node.IsScalar()) {
    const auto& text = node.Scalar();
    if(node.Tag() == "!") {
      return text.empty();
    }
    double number {};
    return text.empty() || text == "false" || (YAML::convert<double>::decode(node, number) && number == 0.0);
  }
  if(node.IsSequence()) {
    return node.size() == 0;
  }
  return std::ranges::all_of(node, [](const auto& item) { return IsDefault(item.second); });
}

}  // namespace

void FlowScalarSequences(YAML::Node node) {
  if(node.IsSequence()) {
    if(std::ranges::all_of(node, [](const YAML::Node& item) { return item.IsScalar(); })) {
      node.SetStyle(YAML::EmitterStyle::Flow);
      return;
    }
    for(auto item : node) {
      FlowScalarSequences(item);
    }
  }
  else if(node.IsMap()) {
    for(auto item : node) {
      FlowScalarSequences(item.second);
    }
  }
}

void SpellOutFieldNames(YAML::Node node) {
  if(node.IsMap()) {
    for(const auto& [message_name, file_name] : kFieldNames) {
      if(node[message_name]) {
        node[file_name] = node[message_name];
        node.remove(message_name);
      }
    }
    for(auto item : node) {
      SpellOutFieldNames(item.second);
    }
  }
  else if(node.IsSequence()) {
    for(auto item : node) {
      SpellOutFieldNames(item);
    }
  }
}

void Compact(YAML::Node node) {
  if(node.IsSequence()) {
    for(auto item : node) {
      Compact(item);
    }
    return;
  }
  if(!node.IsMap()) {
    return;
  }
  std::vector<std::string> guids;
  std::vector<std::string> defaults;
  for(auto item : node) {
    const auto key = item.first.as<std::string>();
    if(IsGuid(item.second)) {
      guids.push_back(key);
    }
    else if(IsDefault(item.second)) {
      defaults.push_back(key);
    }
    else {
      Compact(item.second);
    }
  }
  for(const auto& key : guids) {
    const YAML::Node scalar = GuidScalar(node[key]);
    if(IsDefault(scalar)) {
      defaults.push_back(key);
    }
    else {
      node[key] = scalar;
    }
  }
  for(const auto& key : defaults) {
    node.remove(key);
  }
  const bool is_scalar_only =
      std::ranges::all_of(node, [](const auto& item) { return item.second.IsScalar(); });
  if(is_scalar_only && node.size() <= 2) {
    node.SetStyle(YAML::EmitterStyle::Flow);
  }
}

std::string Emit(const YAML::Node& node) {
  // Emit twice through a load: a freshly built empty collection emits differently from a loaded
  // one, and the round trip gives the same text for both.
  YAML::Emitter first;
  first << node;
  YAML::Emitter out;
  out << YAML::Load(first.c_str());
  return std::format("{}\n", out.c_str());
}

void ExpectSameDocument(const YAML::Node& expected, const YAML::Node& actual, std::string_view what) {
  std::istringstream expected_lines(Emit(expected));
  std::istringstream actual_lines(Emit(actual));
  std::string expected_line;
  std::string actual_line;
  for(size_t line = 1;; ++line) {
    const bool is_expected_line_read = static_cast<bool>(std::getline(expected_lines, expected_line));
    const bool is_actual_line_read = static_cast<bool>(std::getline(actual_lines, actual_line));
    if(!is_expected_line_read && !is_actual_line_read) {
      return;
    }
    if(is_expected_line_read != is_actual_line_read || expected_line != actual_line) {
      ADD_FAILURE() << what << " differ at line " << line
                    << "\n  expected: " << (is_expected_line_read ? expected_line : "<end of document>")
                    << "\n  actual:   " << (is_actual_line_read ? actual_line : "<end of document>");
      return;
    }
  }
}

void ExpectRecorded(const std::filesystem::path& path, const YAML::Node& recorded) {
  if(!std::filesystem::exists(path)) {
    throw std::runtime_error(std::format("No scenario file '{}'", path.string()));
  }
  if(std::getenv("RECORD_REFERENCE_OUTPUT") != nullptr) {
    const std::string authored = AuthoredText(path);
    ExpectOwnTest(path, YAML::Load(authored));
    // The whole text first: opening the file truncates it, and Emit can throw.
    const std::string text = authored + Emit(recorded);
    std::ofstream out(path);
    out << text;
    if(!out.good()) {
      throw std::runtime_error(std::format("Failed to write '{}'", path.string()));
    }
    std::cout << "Recorded " << path << "\n";
    return;
  }
  const YAML::Node doc = YAML::LoadFile(path.string());
  ExpectOwnTest(path, doc);
  if(!doc["output"]) {
    ADD_FAILURE() << "No recorded output in " << path
                  << "; record it by running the test binary with RECORD_REFERENCE_OUTPUT=1";
    return;
  }
  if(std::getenv("SCHEDULER_CHECK_RECORDINGS") == nullptr) {
    return;
  }
  for(const auto& key : {"input", "output"}) {
    if(recorded[key]) {
      ExpectSameDocument(
          doc[key], recorded[key], std::format("recorded {} of {}", key, path.filename().string()));
    }
  }
}

}  // namespace volley::scheduler::test::scenarios
</file>

