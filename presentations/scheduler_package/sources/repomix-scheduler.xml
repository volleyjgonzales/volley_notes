#include "scheduler/utils.hpp"

#include <common/math_utils.hpp>
#include <common_ros/pose_utils.hpp>
#include <memory>
#include <stdx/expected.hpp>

#include "scheduler/format.hpp"

namespace volley {

stdx::Expected<DiscreteGarageState> ValidateBaseState(
    const interfaces::msg::DiscreteGarageState& state, const Layout& layout) {
  DiscreteGarageState garage_state;
  auto [success, message] = garage_state.Set(state);
  if(!success) {
    return stdx::Unexpected(message);
  }

  for(const auto& [payload_id, payload] : garage_state.GetPayloads()) {
    auto resource_index_opt = layout.GetSmallestEnclosingResourceSizeIndex(
        payload.payload.length_m, payload.payload.width_m, payload.payload.height_m);
    if(!resource_index_opt.has_value()) {
      return stdx::Unexpected(
          "Payload {} does not fit into any resource size windows for this layout! Length: {}, Width: {}, "
          "Height: {}",
          payload_id, std::to_string(payload.payload.length_m), std::to_string(payload.payload.width_m),
          std::to_string(payload.payload.height_m));
    }
  }

  for(const auto& [agv_id, agv] : garage_state.GetAgvs()) {
    if(!layout.HasGaragePose(agv.pose)) {
      return stdx::Unexpected("{} is on non-existent pose: {}", AgvId(agv_id), agv.pose);
    }
  }
  for(const auto& [tray_id, tray] : garage_state.GetTrays()) {
    if(!layout.HasGaragePose(tray.pose)) {
      return stdx::Unexpected("{} is on non-existent pose: {}", TrayId(tray_id), tray.pose);
    }
  }

  return garage_state;
}

bool IsCarryingTray(const interfaces::msg::DiscreteAgvState& agv) {
  return agv.tray_id != 0;
}

bool HasPayload(const interfaces::msg::DiscreteTrayState& tray) {
  return tray.payload_id != kEmptyGuid;
}

interfaces::msg::GaragePose MakeInboundPose(const interfaces::msg::GarageNode& node) {
  return ConstructGaragePose(node.id, static_cast<int16_t>(Wrap(GetInboundHeading(node))));
}

int16_t ReverseHeading(int heading) {
  return static_cast<int16_t>(ReciprocalAngle(heading));
}

interfaces::msg::GaragePose ReversePoseHeading(const interfaces::msg::GaragePose& pose) {
  auto turned = pose;
  turned.heading = ReverseHeading(pose.heading);
  return turned;
}

bool IsSameOrOppositeHeading(int heading_a, int heading_b) {
  return IsAngleOrReciprocal(heading_a, heading_b);
}

void KeepTrayHeadingIfEquivalent(interfaces::msg::GaragePose& dest, int16_t tray_heading) {
  if(IsSameOrOppositeHeading(tray_heading, dest.heading)) {
    dest.heading = tray_heading;
  }
}

}  // namespace volley
</file>

<file path="src/validation.cpp">
#include <interfaces/msg/garage_pose.hpp>
#include <motion_planner/garage_graph_pathing.hpp>
#include <unordered_set>

#include "scheduler/format.hpp"
#include "scheduler/scheduler.hpp"

namespace volley::scheduler {

struct CandidateMove {
  CollisionEntityId_t collision_id = 0;
  uint16_t agv_id = 0;
  std::optional<uint16_t> tray_id = std::nullopt;
  interfaces::msg::GaragePose start_pose;
  interfaces::msg::GaragePose dest;
};

stdx::Result Scheduler::ValidateEventSequence(PlanContextSPtr ctx) const {
  const auto events = ctx->event_dag.GetEventsInTopologicalOrder();
  if(!events.has_value()) {
    return stdx::Unexpected("Invalid topological ordering");
  }
  auto working_state = ctx->initial_state;
  for(const auto& event : *events) {
    if(const auto* bay_transition = dynamic_cast<const BayTransition*>(event.get())) {
      if(!IsBayOdpAreaClear(bay_transition->GetBayId(), working_state)) {
        return stdx::Unexpected("Invalid bay transition! {}", std::to_string(*event));
      }
    }
    else if(const auto* agv_move = dynamic_cast<const AgvMove*>(event.get())) {
      const auto agv = working_state.GetAgv(agv_move->GetAgvId()).value();
      const auto collision_id = CollisionEntityIdFromAgvState(agv, working_state, *layout_);
      // No destination means a lift change: there is no destination or path to check.
      if(const auto dest_opt = agv_move->GetDest()) {
        const auto move_check = ValidateMoveDestinationAndPath(ctx, working_state,
            {.collision_id = collision_id, .agv_id = agv.id, .start_pose = agv.pose, .dest = *dest_opt});
        if(!move_check) {
          return stdx::Unexpected(
              "Invalid destination for {} .: {}", std::to_string(*event), move_check.error());
        }
      }
    }
    else if(const auto* tray_move = dynamic_cast<const TrayMove*>(event.get())) {
      const auto tray = working_state.GetTray(tray_move->GetTrayId().value()).value();
      const auto collision_id = CollisionEntityIdFromTrayState(tray, working_state, *layout_);
      const auto dest_opt = tray_move->GetDest();
      if(!dest_opt.has_value()) {
        return stdx::Unexpected("Tray move doesn't have destination! {}", std::to_string(*event));
      }
      const auto move_check = ValidateMoveDestinationAndPath(ctx, working_state,
          {.collision_id = collision_id,
              .agv_id = tray.agv_id,
              .tray_id = tray.id,
              .start_pose = tray.pose,
              .dest = *dest_opt});
      if(!move_check) {
        return stdx::Unexpected(
            "Invalid destination for {} .: {}", std::to_string(*event), move_check.error());
      }
    }

    auto [success, message] = event->ApplyTo(working_state);
    if(!success) {
      return stdx::Unexpected(
          "Failed to apply {} to working state. Reason: {}", std::to_string(*event), message);
    }
  }

  return {};
}

stdx::Result Scheduler::ValidateMoveDestinationAndPath(
    PlanContextSPtr ctx, const DiscreteGarageState& working_state, const CandidateMove& move) const {
  auto dest_vertex_opt = motion_graph_.GetVertexFromPose(move.dest);
  if(!dest_vertex_opt.has_value()) {
    return stdx::Unexpected("Tried to move to a destination that doesn't exist: {}", move.dest);
  }
  auto dest_vertex = *dest_vertex_opt;
  const auto keep_out_filter_or = ctx->FindKeepOutFilter(move.collision_id);
  if(!keep_out_filter_or) {
    return stdx::Unexpected(keep_out_filter_or.error());
  }
  const auto& keep_out_filter = keep_out_filter_or->get();
  if(!keep_out_filter.IsEnabled(dest_vertex)) {
    return stdx::Unexpected("Tried to move to a disabled location: {}", move.dest);
  }

  std::unordered_set<uint16_t> ignore_trays;
  if(move.tray_id.has_value()) {
    ignore_trays.insert(*move.tray_id);
  }
  auto path_filter = BuildStaticObstacleFilter(move.collision_id, motion_graph_, working_state,
      collision_table_, ignore_trays, {move.agv_id}, std::unordered_set<uint16_t>());
  if(!path_filter.IsEnabled(dest_vertex)) {
    return stdx::Unexpected("Requested to move to {} but it's occupied.", move.dest);
  }

  std::vector<interfaces::msg::GaragePose> pose_path =
      FindPosePath(motion_graph_, move.start_pose, move.dest, cost_model_, path_filter);
  if(pose_path.empty()) {
    return stdx::Unexpected("Cannot find path from {} to {}", move.start_pose, move.dest);
  }

  return {};
}

}  // namespace volley::scheduler
</file>

