// Committed actions will run, so their AGVs, the nodes their AGV commands start and end on, their bays and
// their chargers are not available to this plan. The paths between and VRCs are not excluded.
DiscreteGarageState ExcludeCommittedResources(
    DiscreteGarageState state, std::span<const interfaces::msg::ActionNode> committed_actions) {
  for(const auto& committed_action : committed_actions) {
    switch(committed_action.type) {
    case interfaces::msg::ActionNode::TYPE_AGV_COMMAND:
      state.SetAgvDisabled(committed_action.agv_id);
      state.SetNodeDisabled(committed_action.agv_command.src.pose.node_id);
      state.SetNodeDisabled(committed_action.agv_command.dst.pose.node_id);
      break;
    case interfaces::msg::ActionNode::TYPE_BAY_COMMAND:
      state.SetBayDisabled(committed_action.bay_id);
      break;
    case interfaces::msg::ActionNode::TYPE_VECS_COMMAND:
      state.SetVecsDisabled(committed_action.vecs_id);
      break;
    default:
      break;
    }
  }
  return state;
}

// The job's PROCESS_RETRIEVE bay action; the bay reports the payload delivered for it.
const interfaces::msg::ActionNode* FindPayloadDeliveryAction(
    std::span<const interfaces::msg::ActionNode> actions, const interfaces::msg::Guid& job_id) {
  const auto action = std::ranges::find_if(actions, [&](const interfaces::msg::ActionNode& action_node) {
    return action_node.type == interfaces::msg::ActionNode::TYPE_BAY_COMMAND &&
           action_node.job_id == job_id &&
           action_node.bay_command.command_type == interfaces::msg::BayCommand::COMMAND_TYPE_PROCESS_RETRIEVE;
  });
  return action == actions.end() ? nullptr : &*action;
}

void LogMotionCostAudit(cost::CostVector& audit, const rclcpp::Logger& logger) {
  audit.eval();
  const float total_seconds = audit.value().count();
  LOG_INFO(logger, "CHUGG cost audit total={:g}s entries={}", total_seconds, audit.entries_.size());
  LOG_INFO(logger, "audit_csv,index,seconds,cumulative,description");
  float cumulative_seconds = 0.0f;
  size_t entry_index = 0;
  for(const auto& entry : audit.entries_) {
    const float seconds = entry.duration_.count();
    cumulative_seconds += seconds;
    LOG_INFO(
        logger, "audit_csv,{},{:g},{:g},{}", entry_index, seconds, cumulative_seconds, entry.explanation_);
    ++entry_index;
  }
  if(std::abs(cumulative_seconds - total_seconds) > 1e-3f) {
    LOG_WARN(logger, "audit print drift: running={:g} total={:g} (entries={})", cumulative_seconds,
        total_seconds, audit.entries_.size());
  }
}

}  // namespace

Scheduler::Scheduler(std::string layout_filepath, rclcpp::Logger logger, const SchedulerParams& params) :
    layout_(std::make_shared<Layout>(layout_filepath)),
    motion_graph_(PoseGraph(layout_)),
    collision_table_(motion_graph_, logger),
    logger_(logger),
    cost_model_(params.motion_cost),
    target_insert_ready_bay_fraction_(params.target_insert_ready_bay_fraction),
    is_cost_audit_enabled_(params.is_cost_audit_enabled) {
  StorePreferredPayloadHeadingsForRetrieval();
}

void Scheduler::StorePreferredPayloadHeadingsForRetrieval() {
  // A retrieve tries bays from the back of bay_prioritization first.
  const std::vector<uint16_t>& bay_prioritization = layout_->GetBayPrioritization();
  if(bay_prioritization.empty()) {
    return;
  }

  const uint16_t preferred_retrieve_bay_id = bay_prioritization.back();
  const auto bay_inbound_heading_opt = layout_->GetBayInboundHeading(preferred_retrieve_bay_id);
  if(!bay_inbound_heading_opt.has_value()) {
    LOG_ERROR(logger_, "Cannot calculate retrieval headings, bay {} has no inbound heading",
        preferred_retrieve_bay_id);
    return;
  }

  const auto preferred_retrieval_heading = ReverseHeading(bay_inbound_heading_opt.value());
  const interfaces::msg::GaragePose preferred_bay_pose =
      ConstructGaragePose(preferred_retrieve_bay_id, preferred_retrieval_heading);

  for(const interfaces::msg::GarageNode& node : layout_->GetNodes()) {
    if(node.type != interfaces::msg::GarageNode::TYPE_PARKING) {
      continue;
    }

    const std::vector<int16_t> allowed_node_headings = GetAllowedHeadings(node);

    if(std::ranges::find(allowed_node_headings, preferred_retrieval_heading) == allowed_node_headings.end()) {
      continue;
    }

    // A heading the layout allows may still be unreachable for a tray (disallowed_edge_orientation).
    const interfaces::msg::GaragePose parking_pose =
        ConstructGaragePose(node.id, preferred_retrieval_heading);
    if(FindPosePath(motion_graph_, parking_pose, preferred_bay_pose, cost_model_).empty()) {
      continue;
    }

    motion_graph_.SetRetrievalHeading(node.id, preferred_retrieval_heading);
  }
}

interfaces::msg::PlanResponse Scheduler::Plan(
    const interfaces::msg::PlanRequest& request_data, const rclcpp::Time& now) const {
  interfaces::msg::PlanResponse response;

  response.id = request_data.id;

  const auto validated_state = ValidateBaseState(request_data.base_state, *layout_);
  if(!validated_state) {
    response.success = false;
    response.message = "Invalid base state in plan request! " + validated_state.error();
    LOG_WARN(logger_, "{}", response.message);
    return response;
  }
  const auto& committed_actions = request_data.base_schedule.nodes;
  auto initial_state = ExcludeCommittedResources(validated_state.value(), committed_actions);

  const auto ctx = std::make_shared<PlanContext>(request_data.id, std::move(initial_state), now);

  ctx->keep_out_filter_by_footprint =
      BuildKeepOutFilters(motion_graph_, ctx->initial_state, collision_table_);

  for(const interfaces::msg::SchedulerJob& job : request_data.pending_jobs) {
    // Expansion adds events before its last check can fail; a failed job must leave none behind. The
    // copy shares the event objects: expansion never changes an existing event.
    const auto context_before_job = *ctx;
    if(const auto expansion = ExpandJob(ctx, job)) {
      ctx->AddScheduledJob(job);
    }
    else {
      *ctx = context_before_job;
      const auto& [message, is_retryable] = expansion.error();
      response.scheduled_jobs.push_back(MakeFailedJob(job, message, is_retryable));
      // A failed insert still leaves the garage to clean up.
      if(job.type == interfaces::msg::SchedulerJob::TYPE_INSERT && clean_garage_request_fn_) {
        clean_garage_request_fn_();
      }
    }
  }

  const auto fail_all_jobs = [&](std::string response_message, const std::string& job_message) {
    response.success = true;
    response.message = std::move(response_message);
    for(const auto& scheduled_job : ctx->scheduled_jobs) {
      response.scheduled_jobs.push_back(MakeFailedJob(scheduled_job.job, job_message));
    }
    return response;
  };

  if(ctx->scheduled_jobs.empty()) {
    response.success = true;
    response.message = "No jobs succeeded to plan";
    return response;
  }

  if(const auto tray_assignment = AssignTrays(ctx); !tray_assignment) {
    return fail_all_jobs("Failed tray assignments: " + tray_assignment.error(), tray_assignment.error());
  }

  PrintDagIfEnabled(ctx->event_dag, *ctx, "after_tray_assignments");
  if(const auto agv_assignment = AssignAgvs(ctx); !agv_assignment) {
    return fail_all_jobs("Failed AGV assignments: " + agv_assignment.error(), agv_assignment.error());
  }

  // TODO(any): Planning may fail without RemoveRedundantEdges() here; calling it after tray assignment
  // instead breaks AGV assignment.
  if(const auto reduced = ctx->event_dag.RemoveRedundantEdges(); !reduced) {
    return fail_all_jobs("Failed to reduce the event graph: " + reduced.error(), reduced.error());
  }
  PrintDagIfEnabled(ctx->event_dag, *ctx, "after_agv_assignments");

  // The motion planner fails ungracefully on bad event ordering, so check it first.
  if(const auto sanity_check = ValidateEventSequence(ctx); !sanity_check) {
    const auto failure = "Pre-motion planning sanity check failed: " + sanity_check.error();
    return fail_all_jobs(failure, failure);
  }

  auto final_state_opt = PlanMotions(ctx);
  if(!final_state_opt.has_value()) {
    const std::string failure = "CHUGG failed to find a solution, event dag may be infeasible";
    return fail_all_jobs(failure, failure);
  }
  const auto& final_state = final_state_opt.value();

  auto action_graph = BuildActionGraph(ctx, final_state);
  if(!action_graph) {
    const auto failure = "Failed to build the action graph: " + action_graph.error();
    return fail_all_jobs(failure, failure);
  }
  auto action_nodes = std::move(action_graph).value();

  for(auto& scheduled_job : ctx->scheduled_jobs) {
    scheduled_job.job.state = interfaces::msg::SchedulerJob::STATE_EXECUTING;
    scheduled_job.job.state_name = "STATE_EXECUTING";

    if(scheduled_job.job.type == interfaces::msg::SchedulerJob::TYPE_RETRIEVE) {
      if(const auto* payload_delivery_action =
              FindPayloadDeliveryAction(action_nodes, scheduled_job.job.guid)) {
        scheduled_job.bay_id = payload_delivery_action->bay_id;
        scheduled_job.bay_arrival_node_guid = payload_delivery_action->guid;
      }
      else {
        // TODO(any): Fail the job instead of reporting it as executing.
        LOG_ERROR(logger_, "No process retrieve action node found for retrieve job");
      }
    }
    response.scheduled_jobs.push_back(scheduled_job);
  }

  response.schedule.nodes = std::move(action_nodes);
  response.success = true;
  return response;
}

stdx::Expected<void, JobFailure> Scheduler::ExpandJob(
    PlanContextSPtr ctx, const interfaces::msg::SchedulerJob& job) const {
  const auto job_index = ctx->scheduled_jobs.size();
  switch(job.type) {
  case interfaces::msg::SchedulerJob::TYPE_MOVE_AGV:
    return ExpandAgvMoveJob(ctx, job.agv_id, job.destination, job_index);
  case interfaces::msg::SchedulerJob::TYPE_RETRIEVE:
    return ExpandRetrieveJob(ctx, job.payload_id, job_index);
  case interfaces::msg::SchedulerJob::TYPE_REPARK_TRAY:
  case interfaces::msg::SchedulerJob::TYPE_MOVE_TRAY:
    return ExpandReparkTrayJob(ctx, job.tray_id, job_index, job.allow_reciprocal, job.destination);
  case interfaces::msg::SchedulerJob::TYPE_INSERT:
    return ExpandInsertJob(ctx, job.bay_id, job_index);
  case interfaces::msg::SchedulerJob::TYPE_READY_FOR_INSERT:
    return ExpandReadyForInsertJob(ctx, job.bay_id, job_index);
  case interfaces::msg::SchedulerJob::TYPE_READY_FOR_RETRIEVE:
    return ExpandReadyForRetrieveJob(ctx, job.bay_id, job_index);
  case interfaces::msg::SchedulerJob::TYPE_CLEAN_GARAGE:
    return ExpandCleanGarageJob(ctx, job_index);
  case interfaces::msg::SchedulerJob::TYPE_REBALANCE_GARAGE:
    return ExpandRebalanceGarageJob(ctx, job_index);
  case interfaces::msg::SchedulerJob::TYPE_CHARGE_AGV:
    return ExpandAgvChargeJob(ctx, job.agv_id, job_index);
  case interfaces::msg::SchedulerJob::TYPE_TRANSITION_BAY_TO_INSERT:
    return ExpandBayTransitionJob(
        ctx, job.bay_id, interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_INSERT, job_index);
  case interfaces::msg::SchedulerJob::TYPE_TRANSITION_BAY_TO_RETRIEVE:
    return ExpandBayTransitionJob(
        ctx, job.bay_id, interfaces::msg::BayCommand::COMMAND_TYPE_TRANSITION_TO_RETRIEVE, job_index);
  case interfaces::msg::SchedulerJob::TYPE_CHARGE_PAYLOAD:
    return ExpandChargePayloadJob(ctx, job.payload_id, job_index);
  default:
    return Fail("Unknown job type {}({})", job.type, job.type_name);
  }
}

std::optional<ContinuousState> Scheduler::PlanMotions(PlanContextSPtr ctx) const {
  ContinuousState initial_trajectories(ctx->initial_state, collision_table_, *layout_, ctx->start_time);

  // The same edge durations seed the A* heuristic, which is inadmissible under run-extension cost,
  // so paths may be suboptimal; accepted for search speed (ComputeEdgeMarginalDurations is too loose).
  auto edge_durations = ComputeEdgeDurations(motion_graph_, cost_model_);

  auto heuristics = ComputeAllPairsShortestPathCosts(
      motion_graph_, edge_durations, Interval::Duration(0), Interval::Duration::max());

  Chugg motion_planner(motion_graph_, collision_table_, ctx->event_dag, initial_trajectories, edge_durations,
      heuristics, cost_model_, logger_);

  cost::CostVector audit;
  cost::CostVector* audit_ptr = is_cost_audit_enabled_ ? &audit : nullptr;
  auto trajectories_opt = motion_planner.SolveSequential(audit_ptr);

  if(audit_ptr && !audit.entries_.empty()) {
    LogMotionCostAudit(audit, logger_);
  }

  if(!trajectories_opt) {
    LOG_ERROR(logger_, "CHUGG failed to find a solution, event dag may be infeasible");
  }
  return trajectories_opt;
}

interfaces::msg::ScheduledJobData Scheduler::MakeFailedJob(
    const interfaces::msg::SchedulerJob& job, const std::string& failure_message, bool is_retryable) const {
  interfaces::msg::ScheduledJobData scheduled_job {};
  scheduled_job.job = job;
  scheduled_job.job.retain_job = is_retryable;
  scheduled_job.job.state = interfaces::msg::SchedulerJob::STATE_ERROR;
  scheduled_job.job.state_name = "STATE_ERROR";
  scheduled_job.job.note = failure_message;

  LOG_WARN(logger_, "Failed job: {} with message: {}", std::to_string(job), failure_message);

  return scheduled_job;
}

bool Scheduler::SetBayReadinessRatioCallback(interfaces::srv::SetFloat32::Request::SharedPtr request,
    interfaces::srv::SetFloat32::Response::SharedPtr response) {
  if(!std::isfinite(request->value) || request->value < 0.0 || request->value > 1.0) {
    response->success = false;
    response->message = "Cannot accept Bay Readiness Ratio: " + std::to_string(request->value) +
                        " must be between 0.0 and 1.0";
    LOG_WARN(logger_, "{}", response->message);
    return false;
  }

  const bool is_fraction_changed = request->value != target_insert_ready_bay_fraction_;
  target_insert_ready_bay_fraction_ = request->value;
  response->success = true;
  return is_fraction_changed;
}

interfaces::msg::GaragePose Scheduler::MakeBayInboundPose(uint16_t bay_id) const {
  return ConstructGaragePose(bay_id, static_cast<int16_t>(layout_->GetBayInboundHeading(bay_id).value()));
}

bool Scheduler::IsBayOdpAreaClear(uint16_t bay_id, const DiscreteGarageState& working_state) const {
  const auto odp_filter = BuildStaticObstacleFilter(common::EnumInteger(CollisionEntityId::BAY_ODP),
      motion_graph_, working_state, collision_table_, {}, {}, {});
  return odp_filter.IsEnabled(motion_graph_.GetVertexFromPose(MakeBayInboundPose(bay_id)).value());
}

bool Scheduler::IsParkingWithoutBayOrCharger(
    const DiscreteGarageState& working_state, uint32_t node_id) const {
  if(working_state.GetVecs(node_id) || working_state.GetBay(node_id)) {
    return false;
  }
  const auto node_opt = layout_->GetNodeById(node_id);
  return node_opt && node_opt->type == interfaces::msg::GarageNode::TYPE_PARKING;
}

stdx::Expected<uint8_t> Scheduler::GetFirstSystemFloor(uint16_t bay_id) const {
  const auto floors = layout_->GetBaySystemFloors(bay_id);
  if(!floors.has_value()) {
    return stdx::Unexpected("b{} has no system floor", bay_id);
  }
  if(floors->empty()) {
    return stdx::Unexpected("b{} has an empty list of system floors", bay_id);
  }
  return floors->front();
}

interfaces::msg::VersionInfo::UniquePtr Scheduler::GetVersionInfo(const rclcpp::Time& now) const {
  auto version_info = std::make_unique<interfaces::msg::VersionInfo>();
  version_info->header.stamp = now;
  version_info->name = "scheduler";
  version_info->release = GetRelease();
  version_info->gitsha = GetGitsha();
  version_info->layout_md5sum = layout_->GetMD5Sum();
  return version_info;
}

