#pragma once

#include <chrono>
#include <common_ros/collision_geometry.hpp>
#include <common_ros/discrete_garage_state.hpp>
#include <common_ros/ros_utils.hpp>
#include <functional>
#include <interfaces/msg/garage_entity_id.hpp>
#include <interfaces/msg/guid.hpp>
#include <interfaces/msg/scheduled_job_data.hpp>
#include <interfaces/msg/scheduler_job.hpp>
#include <memory>
#include <motion_planner/interval.hpp>
#include <motion_planner/static_graph_filtering.hpp>
#include <planner_core/event_dag.hpp>
#include <planner_core/schedule_events.hpp>
#include <rclcpp/time.hpp>
#include <stdx/expected.hpp>
#include <unordered_map>
#include <vector>

namespace volley::scheduler {

struct PlanContext {
  PlanContext(
      const interfaces::msg::Guid& request_id, DiscreteGarageState initial_state, const rclcpp::Time& now) :
      request_id(request_id),
      initial_state(std::move(initial_state)),
      start_time(std::chrono::nanoseconds(now.nanoseconds())) { }

  void AddScheduledJob(const interfaces::msg::SchedulerJob& job) { scheduled_jobs.emplace_back().job = job; }

  void ChainAfterLastEntityEvent(
      const interfaces::msg::GarageEntityId& entity, const ScheduleEventSPtr& event) {
    auto& last_event = last_event_by_entity[entity];
    if(last_event != nullptr) {
      event_dag.AddDependency(last_event, event);
    }
    last_event = event;
  }

  /// Adds `event` and chains it after its entity's last event; a tray move without a tray yet has no entity
  /// and is only added.
  void AddChainedEvent(const ScheduleEventSPtr& event) {
    event_dag.AddEvent(event);
    if(const auto entity = event->GetGarageEntityId()) {
      ChainAfterLastEntityEvent(*entity, event);
    }
  }

  void OrderAfterJobLeafEvents(const ScheduleEventSPtr& event) {
    for(const auto& leaf : event_dag.GetLeafEvents()) {
      if(leaf != event && leaf->GetJobIndex() == event->GetJobIndex()) {
        event_dag.AddDependency(leaf, event);
      }
    }
  }

  [[nodiscard]] stdx::Expected<std::reference_wrapper<const GraphFilterProperties>> FindKeepOutFilter(
      CollisionEntityId_t collision_id) const {
    const auto it = keep_out_filter_by_footprint.find(collision_id);
    if(it == keep_out_filter_by_footprint.end()) {
      return stdx::Unexpected("No keep-out filter for footprint {}", collision_id);
    }
    return std::cref(it->second);
  }

  interfaces::msg::Guid request_id;
  DiscreteGarageState initial_state;
  Interval::Timepoint start_time;
  std::unordered_map<CollisionEntityId_t, GraphFilterProperties> keep_out_filter_by_footprint;
  ScheduleEventDag event_dag;
  std::vector<interfaces::msg::ScheduledJobData> scheduled_jobs;
  std::unordered_map<interfaces::msg::GarageEntityId, ScheduleEventSPtr> last_event_by_entity;
  std::unordered_map<uint16_t, ScheduleEventSPtr> first_event_by_tray;
};

using PlanContextSPtr = std::shared_ptr<PlanContext>;

}  // namespace volley::scheduler
</file>

