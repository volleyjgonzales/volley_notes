<file path="test/src/utils/bay_rebalancing_tests.cpp">
#include <gtest/gtest.h>

#include <common_ros/discrete_garage_state.hpp>
#include <common_ros/ros_utils.hpp>
#include <cstdint>
#include <interfaces/msg/bay_report.hpp>
#include <interfaces/msg/discrete_bay_state.hpp>
#include <interfaces/msg/discrete_garage_state.hpp>
#include <interfaces/msg/discrete_payload_state.hpp>
#include <interfaces/msg/discrete_tray_state.hpp>
#include <unordered_map>
#include <vector>

#include "scheduler/bay_rebalancing.hpp"

namespace volley::scheduler::test {

namespace {

struct Bay {
  uint16_t id;
  uint8_t state;
  bool is_disabled = false;
};

/// A tray standing on the node of the same id; with a payload when @p is_loaded.
struct Tray {
  uint16_t id;
  uint32_t node_id;
  bool is_loaded = false;
};

/// @return A garage state with @p bays and @p trays, nothing else; a tray whose node is a bay's id
/// stands in that bay.
[[nodiscard]] DiscreteGarageState MakeState(const std::vector<Bay>& bays, const std::vector<Tray>& trays) {
  interfaces::msg::DiscreteGarageState msg;
  for(const auto& bay : bays) {
    interfaces::msg::DiscreteBayState bay_msg;
    bay_msg.id = bay.id;
    bay_msg.state = bay.state;
    bay_msg.disabled = bay.is_disabled;
    msg.bays.push_back(bay_msg);
  }
  for(const auto& tray : trays) {
    interfaces::msg::DiscreteTrayState tray_msg;
    tray_msg.id = tray.id;
    tray_msg.pose = ConstructGaragePose(tray.node_id, 90);
    if(tray.is_loaded) {
      tray_msg.payload_id = MakeGuid(0, tray.id);
      interfaces::msg::DiscretePayloadState payload_msg;
      payload_msg.payload.id = tray_msg.payload_id;
      payload_msg.payload.mass = 1000.0F;
      payload_msg.payload.length_m = 5.0F;
      payload_msg.payload.width_m = 2.2F;
      payload_msg.payload.height_m = 1.5F;
      payload_msg.tray_id = tray.id;
      msg.payloads.push_back(payload_msg);
    }
    msg.trays.push_back(tray_msg);
  }
  DiscreteGarageState state;
  state.Set(msg);
  return state;
}

constexpr uint8_t kReadyToInsert = interfaces::msg::BayReport::STATE_READY_TO_INSERT;
constexpr uint8_t kReadyToRetrieve = interfaces::msg::BayReport::STATE_READY_TO_RETRIEVE;
constexpr uint8_t kProcessingInsert = interfaces::msg::BayReport::STATE_PROCESSING_INSERT;
constexpr uint8_t kProcessingRetrieve = interfaces::msg::BayReport::STATE_PROCESSING_RETRIEVE;

}  // namespace

TEST(BayRebalancing, ClassifiesBay) {
  // clang-format off
  // ClassifyBay(state, is_tray_in_bay, is_payload_in_bay)
  EXPECT_EQ(BayClassification::INSERT_NEEDS_EMPTY_TRAY,           ClassifyBay(kReadyToInsert, false, false));
  EXPECT_EQ(BayClassification::INSERT_READY,                       ClassifyBay(kReadyToInsert, true, false));
  EXPECT_EQ(BayClassification::NOT_USABLE,                         ClassifyBay(kReadyToInsert, false, true));
  EXPECT_EQ(BayClassification::INSERT_NEEDS_EMPTY_TRAY,           ClassifyBay(kReadyToInsert, true, true));
  EXPECT_EQ(BayClassification::RETRIEVE_READY,                     ClassifyBay(kReadyToRetrieve, false, false));
  EXPECT_EQ(BayClassification::RETRIEVE_NEEDS_TRAY_REMOVAL,         ClassifyBay(kReadyToRetrieve, true, false));
  EXPECT_EQ(BayClassification::NOT_USABLE,                         ClassifyBay(kReadyToRetrieve, false, true));
  EXPECT_EQ(BayClassification::RETRIEVE_NEEDS_TRAY_REMOVAL,         ClassifyBay(kReadyToRetrieve, true, true));
  EXPECT_EQ(BayClassification::NOT_USABLE,                         ClassifyBay(kProcessingInsert, false, false));
  EXPECT_EQ(BayClassification::NOT_USABLE,                         ClassifyBay(kProcessingInsert, false, true));
  EXPECT_EQ(BayClassification::NOT_USABLE,                         ClassifyBay(kProcessingInsert, true, false));
  EXPECT_EQ(BayClassification::INSERT_IN_PROGRESS, ClassifyBay(kProcessingInsert, true, true));
  EXPECT_EQ(BayClassification::NOT_USABLE,                         ClassifyBay(kProcessingRetrieve, false, false));
  EXPECT_EQ(BayClassification::NOT_USABLE,                         ClassifyBay(kProcessingRetrieve, false, true));
  EXPECT_EQ(BayClassification::NOT_USABLE,                         ClassifyBay(kProcessingRetrieve, true, false));
  EXPECT_EQ(BayClassification::RETRIEVE_IN_PROGRESS,               ClassifyBay(kProcessingRetrieve, true, true));
  // clang-format on
}

TEST(BayRebalancing, DisabledBaysAreNotUsable) {
  const auto state = MakeState({{1, kReadyToRetrieve, true}, {2, kReadyToRetrieve, true}}, {});

  const auto classifications = ClassifyBays(state);

  EXPECT_EQ(BayClassification::NOT_USABLE, classifications.at(1));
  EXPECT_EQ(BayClassification::NOT_USABLE, classifications.at(2));
}

TEST(BayRebalancing, ClassifiesBays) {
  const auto state =
      MakeState({{1, kReadyToInsert}, {2, kReadyToInsert}, {3, kReadyToInsert}, {4, kReadyToRetrieve}},
          {{101, 2}, {102, 3, true}});

  const auto classifications = ClassifyBays(state);

  ASSERT_EQ(4u, classifications.size());
  // No tray
  EXPECT_EQ(BayClassification::INSERT_NEEDS_EMPTY_TRAY, classifications.at(1));
  // An empty tray
  EXPECT_EQ(BayClassification::INSERT_READY, classifications.at(2));
  // A loaded tray
  EXPECT_EQ(BayClassification::INSERT_NEEDS_EMPTY_TRAY, classifications.at(3));
  // No tray
  EXPECT_EQ(BayClassification::RETRIEVE_READY, classifications.at(4));
}

TEST(BayRebalancing, SplitsBaysByRatio) {
  // (ratio, eligible bays, empty trays) -> (insert-ready, retrieve-ready)
  const struct {
    float ratio;
    int eligible_bays;
    int empty_trays;
    int insert;
    int retrieve;
  } cases[] = {
      {0.5F, 4, 4, 2, 2},
      {0.5F, 4, 1, 1, 3},  // no more insert-ready bays than empty trays
      {0.5F, 4, 0, 0, 4},
      {0.5F, 3, 4, 2, 1},
      {0.33F, 3, 4, 1, 2},
      {0.0F, 4, 4, 0, 4},
      {1.0F, 4, 4, 4, 0},
      {1.5F, 4, 4, 4, 0},  // a ratio above one is capped
      {0.5F, 1, 4, 1, 0},
      {1.0F, 1, 4, 1, 0},
      {0.0F, 1, 4, 0, 1},
      {0.5F, 2, 4, 1, 1},
      {0.0F, 2, 4, 0, 2},
      {1.0F, 2, 4, 2, 0},
  };
  for(const auto& c : cases) {
    const auto [insert, retrieve] = CalculateDesiredBaySplit(c.ratio, c.eligible_bays, c.empty_trays);
    EXPECT_EQ(c.insert, insert) << "ratio " << c.ratio << ", " << c.eligible_bays << " bays, "
                                << c.empty_trays << " empty trays";
    EXPECT_EQ(c.retrieve, retrieve) << "ratio " << c.ratio << ", " << c.eligible_bays << " bays, "
                                    << c.empty_trays << " empty trays";
  }
}

TEST(BayRebalancing, TransitionsOnlyAsNeeded) {
  const std::vector<uint16_t> prioritization = {1, 2, 3, 4};
  using Classifications = std::unordered_map<uint16_t, BayClassification>;

  {
    // Already as desired
    const Classifications classifications = {{1, BayClassification::INSERT_READY},
        {2, BayClassification::INSERT_READY}, {3, BayClassification::RETRIEVE_READY},
        {4, BayClassification::RETRIEVE_READY}};
    const auto [to_insert, to_retrieve] = ComputeBayRebalancingActions(classifications, prioritization, 2, 2);
    EXPECT_TRUE(to_insert.empty());
    EXPECT_TRUE(to_retrieve.empty());
  }
  {
    // The split is satisfied even though it is the reverse of the prioritization
    const Classifications classifications = {{1, BayClassification::RETRIEVE_READY},
        {2, BayClassification::RETRIEVE_READY}, {3, BayClassification::INSERT_READY},
        {4, BayClassification::INSERT_READY}};
    const auto [to_insert, to_retrieve] = ComputeBayRebalancingActions(classifications, prioritization, 2, 2);
    EXPECT_TRUE(to_insert.empty());
    EXPECT_TRUE(to_retrieve.empty());
  }
  {
    // One more insert-ready bay: the first retrieve-ready bay in prioritization order transitions
    const Classifications classifications = {{1, BayClassification::RETRIEVE_READY},
        {2, BayClassification::RETRIEVE_READY}, {3, BayClassification::INSERT_READY},
        {4, BayClassification::INSERT_READY}};
    const auto [to_insert, to_retrieve] = ComputeBayRebalancingActions(classifications, prioritization, 3, 1);
    ASSERT_EQ(1u, to_insert.size());
    EXPECT_EQ(1u, to_insert[0]);
    EXPECT_TRUE(to_retrieve.empty());
  }
  {
    // One more retrieve-ready bay: the last insert-ready bay in prioritization order transitions
    const Classifications classifications = {{1, BayClassification::RETRIEVE_READY},
        {2, BayClassification::RETRIEVE_READY}, {3, BayClassification::INSERT_READY},
        {4, BayClassification::INSERT_READY}};
    const auto [to_insert, to_retrieve] = ComputeBayRebalancingActions(classifications, prioritization, 1, 3);
    EXPECT_TRUE(to_insert.empty());
    ASSERT_EQ(1u, to_retrieve.size());
    EXPECT_EQ(4u, to_retrieve[0]);
  }
  {
    // Bays whose tray must change all transition, in prioritization order
    const Classifications classifications = {{1, BayClassification::RETRIEVE_NEEDS_TRAY_REMOVAL},
        {2, BayClassification::RETRIEVE_NEEDS_TRAY_REMOVAL}, {3, BayClassification::INSERT_NEEDS_EMPTY_TRAY},
        {4, BayClassification::INSERT_NEEDS_EMPTY_TRAY}};
    const auto [to_insert, to_retrieve] = ComputeBayRebalancingActions(classifications, prioritization, 2, 2);
    ASSERT_EQ(2u, to_insert.size());
    EXPECT_EQ(1u, to_insert[0]);
    EXPECT_EQ(2u, to_insert[1]);
    ASSERT_EQ(2u, to_retrieve.size());
    EXPECT_EQ(4u, to_retrieve[0]);
    EXPECT_EQ(3u, to_retrieve[1]);
  }
}

TEST(BayRebalancing, RetrievesInProgressCountAsInsertReady) {
  const std::unordered_map<uint16_t, BayClassification> classifications = {
      {1, BayClassification::RETRIEVE_IN_PROGRESS}, {2, BayClassification::RETRIEVE_IN_PROGRESS},
      {3, BayClassification::RETRIEVE_READY}, {4, BayClassification::RETRIEVE_READY}};
  const auto [to_insert, to_retrieve] = ComputeBayRebalancingActions(classifications, {1, 2, 3, 4}, 2, 2);
  EXPECT_TRUE(to_insert.empty());
  EXPECT_TRUE(to_retrieve.empty());
}

TEST(BayRebalancing, BaysInProgressGetNoTransitions) {
  const std::unordered_map<uint16_t, BayClassification> classifications = {
      {1, BayClassification::RETRIEVE_IN_PROGRESS}, {2, BayClassification::RETRIEVE_IN_PROGRESS},
      {3, BayClassification::RETRIEVE_IN_PROGRESS}, {4, BayClassification::INSERT_IN_PROGRESS}};
  const auto [to_insert, to_retrieve] = ComputeBayRebalancingActions(classifications, {1, 2, 3, 4}, 2, 2);
  EXPECT_TRUE(to_insert.empty());
  EXPECT_TRUE(to_retrieve.empty());
}

TEST(BayRebalancing, RatioOneInsertsBothBays) {
  const auto state = MakeState({{1, kReadyToRetrieve}, {2, kReadyToRetrieve}}, {{101, 10}, {102, 11}});

  const auto [to_insert, to_retrieve] = ComputeBayRebalancingActions(state, {1, 2}, 1.0F);

  EXPECT_EQ(2u, to_insert.size());
  EXPECT_TRUE(to_retrieve.empty());
}

TEST(BayRebalancing, SkipsADisabledBay) {
  const auto state = MakeState({{1, kReadyToRetrieve}, {2, kReadyToRetrieve, true}}, {{101, 10}, {102, 11}});

  const auto [to_insert, to_retrieve] = ComputeBayRebalancingActions(state, {1, 2}, 1.0F);

  EXPECT_EQ(1u, to_insert.size());
  EXPECT_TRUE(to_retrieve.empty());
}

// A bay mid-retrieve cannot be commanded, even when the ratio asks for more retrieve-ready bays.
TEST(BayRebalancing, LeavesRetrieveInProgressAlone) {
  const auto state = MakeState({{1, kProcessingRetrieve}, {2, kReadyToRetrieve}}, {{101, 1, true}});

  const auto classifications = ClassifyBays(state);
  ASSERT_EQ(2u, classifications.size());
  EXPECT_EQ(BayClassification::RETRIEVE_IN_PROGRESS, classifications.at(1));
  EXPECT_EQ(BayClassification::RETRIEVE_READY, classifications.at(2));

  const auto [to_insert, to_retrieve] = ComputeBayRebalancingActions(state, {1, 2}, 0.0F);

  EXPECT_TRUE(to_insert.empty());
  EXPECT_TRUE(to_retrieve.empty());
}

}  // namespace volley::scheduler::test
</file>

<file path="test/src/utils/empty_tray_count_tests.cpp">
#include <gtest/gtest.h>

#include <common_ros/discrete_garage_state.hpp>
#include <common_ros/discrete_garage_state_utils.hpp>
#include <common_ros/ros_utils.hpp>
#include <cstdint>
#include <interfaces/msg/node_disabledness_changed.hpp>
#include <interfaces/msg/payload_existence_changed.hpp>
#include <interfaces/msg/tray_disabledness_changed.hpp>
#include <interfaces/msg/tray_existence_changed.hpp>

namespace volley::scheduler::test {

namespace {

void AddTray(DiscreteGarageState& state, uint16_t tray_id, uint32_t node_id) {
  interfaces::msg::TrayExistenceChanged added {};
  added.added = true;
  added.tray_id = tray_id;
  added.node_id = node_id;
  added.heading = 0;
  ASSERT_TRUE(state.OnEvent(added).first);
}

void AddPayload(DiscreteGarageState& state, uint16_t tray_id) {
  interfaces::msg::PayloadExistenceChanged added {};
  added.payload_id = MakeGuid(0, tray_id).bytes;
  added.added = true;
  added.tray_id = tray_id;
  ASSERT_TRUE(state.OnEvent(added).first);
}

void DisableTray(DiscreteGarageState& state, uint16_t tray_id) {
  interfaces::msg::TrayDisablednessChanged disabled {};
  disabled.tray_id = tray_id;
  disabled.disable = true;
  ASSERT_TRUE(state.OnEvent(disabled).first);
}

void DisableNode(DiscreteGarageState& state, uint32_t node_id) {
  interfaces::msg::NodeDisablednessChanged disabled {};
  disabled.node_id = node_id;
  disabled.disable = true;
  ASSERT_TRUE(state.OnEvent(disabled).first);
}

}  // namespace

TEST(CountEmptyTrays, CountsEmptyEnabledTrays) {
  DiscreteGarageState state;
  for(uint16_t tray_id = 1; tray_id <= 4; ++tray_id) {
    AddTray(state, tray_id, tray_id);
  }

  // All four trays are empty and nothing is disabled
  EXPECT_EQ(4, CountEmptyTrays(state));

  AddPayload(state, 1);
  AddPayload(state, 2);

  // Two trays carry a payload
  EXPECT_EQ(2, CountEmptyTrays(state));

  // Disabling a loaded tray and an unrelated node changes nothing
  DisableTray(state, 1);
  DisableNode(state, 15);
  EXPECT_EQ(2, CountEmptyTrays(state));

  // A disabled empty tray does not count
  DisableTray(state, 3);
  EXPECT_EQ(1, CountEmptyTrays(state));

  // Nor does an empty tray on a disabled node
  DisableNode(state, 4);
  EXPECT_EQ(0, CountEmptyTrays(state));
}

}  // namespace volley::scheduler::test
</file>

