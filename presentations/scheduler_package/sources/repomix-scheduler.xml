static void ReadMotionCostParams(cost::MotionCostParams& motion_cost, NodeSPtr node) {
  motion_cost.locomote.speed = node->Param<float>("agv.performance_limits.locomote.speed");
  motion_cost.locomote.loaded_speed = node->Param<float>("agv.performance_limits.locomote.loaded_speed");
  motion_cost.locomote.accel = node->Param<float>("agv.performance_limits.locomote.accel");
  motion_cost.strafe.speed = node->Param<float>("agv.performance_limits.strafe.speed");
  motion_cost.strafe.loaded_speed = node->Param<float>("agv.performance_limits.strafe.loaded_speed");
  motion_cost.strafe.accel = node->Param<float>("agv.performance_limits.strafe.accel");
  motion_cost.rotate.speed = node->Param<float>("agv.performance_limits.rotate.speed");
  motion_cost.rotate.loaded_speed = node->Param<float>("agv.performance_limits.rotate.loaded_speed");
  motion_cost.rotate.accel = node->Param<float>("agv.performance_limits.rotate.accel");
  motion_cost.vrc_transit.speed = node->Param<float>("vrc.performance_limits.transit.speed");
  motion_cost.vrc_transit.accel = node->Param<float>("vrc.performance_limits.transit.accel");
  motion_cost.events.agv_lift_up = node->Param<float>("agv.lift.up_time");
  motion_cost.events.agv_lift_down = node->Param<float>("agv.lift.down_time");
  motion_cost.events.bay_door_open = node->Param<float>("bay.door.open_time");
  motion_cost.events.bay_door_close = node->Param<float>("bay.door.close_time");
  motion_cost.events.bay_wait_to_open = node->Param<float>("bay.door.wait_to_open_time");
  motion_cost.events.vecs_transition = node->Param<float>("vecs.transition_time");
  motion_cost.events.vrc_door_open = node->Param<float>("vrc.door.open_time");
  motion_cost.events.vrc_door_close = node->Param<float>("vrc.door.close_time");
  motion_cost.events.agv_wheel_turn = node->Param<float>("agv.wheel_turn_time");
}

class SchedulerComponent : public Component {
public:
  explicit SchedulerComponent(const rclcpp::NodeOptions& options) {
    auto node = std::make_shared<Node>("scheduler", options);
    const auto logger = node->get_logger();

    std::string layout_name;
    scheduler::SchedulerParams params = {};
    try {
      layout_name = node->Param<std::string>("layout");
      params.is_cost_audit_enabled = node->Param<bool>("scheduler.cost_audit", true);
      params.target_insert_ready_bay_fraction = node->Param<float>("scheduler.bay_readiness_ratio");
      ReadMotionCostParams(params.motion_cost, node);
    }
    catch(const std::exception& e) {
      LOG_ERROR(logger, "Failed to read the scheduler parameters: {}", e.what());
      exit(EXIT_FAILURE);
    }

    const auto layout_filepath_or = GetLayoutPathByName(layout_name);
    if(!layout_filepath_or.has_value()) {
      LOG_ERROR(logger, "{}", layout_filepath_or.error());
      exit(EXIT_FAILURE);
    }
    const auto& layout_filepath = layout_filepath_or.value();

    scheduler_node_ = std::make_unique<scheduler::SchedulerRos>(params, layout_filepath, node);

    SetNode(node);
  }

private:
  std::unique_ptr<scheduler::SchedulerRos> scheduler_node_;
};

}  // namespace volley

#include <rclcpp_components/register_node_macro.hpp>
RCLCPP_COMPONENTS_REGISTER_NODE(volley::SchedulerComponent)
