[[nodiscard]] Scenario Load(const std::filesystem::path& path);

/// `Load` without the ownership check, for a check that spans every file of a suite.
[[nodiscard]] Scenario Read(const std::filesystem::path& path);

/// Throw unless @p doc names the running test: a stage test writes to several files, and a file
/// of another test must be neither compared with nor overwritten.
void ExpectOwnTest(const std::filesystem::path& path, const YAML::Node& doc);

/// @return The authored part of the file at @p path: everything above its first `input:` or
/// `output:` line, kept as written.
[[nodiscard]] std::string AuthoredText(const std::filesystem::path& path);

