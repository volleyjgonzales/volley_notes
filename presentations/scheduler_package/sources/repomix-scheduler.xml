  EXPECT_THROW(YAML::Load("{type: RETRIEVE, payload: not-a-guid}").as<SchedulerJob>(), std::runtime_error);
}

TEST(ScenarioYaml, DecodesBaseScheduleCommand) {
  const auto command =
      YAML::Load("{agv_id: 1, from: {node_id: 2066, heading: 90}, to: {node_id: 2067, heading: 90}}")
          .as<ActionNode>();
  EXPECT_EQ(command.type, ActionNode::TYPE_AGV_COMMAND);
  EXPECT_EQ(command.agv_id, 1);
  EXPECT_EQ(command.agv_command.src.pose.node_id, 2066u);
  EXPECT_EQ(command.agv_command.dst.pose.node_id, 2067u);
}

TEST(ScenarioYaml, DecodesParams) {
  const auto params = YAML::Load("{target_insert_ready_bay_fraction: 0.5}").as<SchedulerParams>();
  EXPECT_FLOAT_EQ(params.target_insert_ready_bay_fraction, 0.5f);
  EXPECT_EQ(params.is_cost_audit_enabled, SchedulerParams().is_cost_audit_enabled);
}

TEST(ScenarioYaml, DecodesRequest) {
  const auto request = YAML::Load(
      "{jobs: [{type: MOVE_AGV, agv_id: 1}, {type: INSERT}], "
      "base_schedule: [{agv_id: 1, from: {node_id: 1, heading: 0}, to: {node_id: 2, heading: 0}}]}")
                           .as<scenarios::Request>();
  ASSERT_EQ(request.jobs.size(), 2u);
  EXPECT_EQ(request.jobs[0].type, SchedulerJob::TYPE_MOVE_AGV);
  EXPECT_EQ(request.jobs[1].type, SchedulerJob::TYPE_INSERT);
  ASSERT_EQ(request.base_schedule.size(), 1u);
  EXPECT_EQ(request.base_schedule[0].agv_command.dst.pose.node_id, 2u);

  const auto empty = YAML::Load("{}").as<scenarios::Request>();
  EXPECT_TRUE(empty.jobs.empty());
  EXPECT_TRUE(empty.base_schedule.empty());
}

