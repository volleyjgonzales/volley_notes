namespace volley::scheduler::test::scenarios {
namespace {

/// Keeps all but errors out of the test output, where a failure shows the recorded diff instead;
/// SCHEDULER_TEST_LOG=1 brings the rest back.
[[nodiscard]] bool QuietLogging() {
  if(std::getenv("SCHEDULER_TEST_LOG") != nullptr) {
    return false;
  }
  for(const char* name : {"scheduler", "garage_graph", "pose_graph"}) {
    rclcpp::get_logger(name).set_level(rclcpp::Logger::Level::Error);
  }
  return true;
}

}  // namespace

std::shared_ptr<const Scheduler> SharedScheduler(
    const std::filesystem::path& layout_path, const SchedulerParams& params) {
  // One scheduler per layout and per value of the scalar parameters, target_insert_ready_bay_fraction and
  // is_cost_audit_enabled; motion_cost is left out of the key, it has no printable identity and no scenario
  // changes it from the default.
  static std::map<std::string, std::shared_ptr<const Scheduler>> schedulers;
  const auto key = std::format("{}|{}|{}", layout_path.string(), params.target_insert_ready_bay_fraction,
      params.is_cost_audit_enabled);
  auto& scheduler = schedulers[key];
  if(!scheduler) {
    [[maybe_unused]] static const bool kIsQuiet = QuietLogging();  // once, before the first build
    scheduler = std::make_shared<const Scheduler>(layout_path, rclcpp::get_logger("scheduler"), params);
  }
  return scheduler;
}

}  // namespace volley::scheduler::test::scenarios
</file>

