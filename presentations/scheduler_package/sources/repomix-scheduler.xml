namespace volley::scheduler::test {

TEST(CleanGarageJob, AgvInTheWay) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
}

TEST(CleanGarageJob, DoesNotMoveAgvsUnderTrays) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;

  const auto& schedule = run.response.schedule;
  EXPECT_EQ(schedule.nodes.size(), 0);
}

// CLEAN_GARAGE must repark trays that were stashed on Waypoints by the tier-2
// fallback in ResolveBlockingTrays. Around bay B2068 of 275_sunrise_b the waypoints are W2069,
// W2070 and W2064 and the stalls P2075, P2066 and P2067.
TEST(CleanGarageJob, UnstashesTrayFromWaypoint) {
  const auto run = scenarios::Plan();
  EXPECT_TRUE(run.response.success) << run.response.message;
  ASSERT_EQ(run.response.scheduled_jobs.size(), 1u);
  EXPECT_EQ(run.response.scheduled_jobs[0].job.state, interfaces::msg::SchedulerJob::STATE_EXECUTING);

  // At least one AGV command picks the tray up at the waypoint and carries it to a stall.
  const std::set<uint32_t> parkings = {2075u, 2066u, 2067u};
  bool is_unstash_move_found = false;
  for(const auto& action : run.response.schedule.nodes) {
    if(action.type != interfaces::msg::ActionNode::TYPE_AGV_COMMAND) {
      continue;
    }
    const auto& cmd = action.agv_command;
    if(cmd.src.pose.node_id == 2070 && parkings.count(cmd.dst.pose.node_id) > 0 && cmd.dst.lift) {
      is_unstash_move_found = true;
      break;
    }
  }
  EXPECT_TRUE(is_unstash_move_found)
      << "CLEAN_GARAGE did not produce an AGV move from W2070 to a parking node";
}

TEST(CleanGarageJob, Deterministic) {
  scenarios::ExpectDeterministic();
}

