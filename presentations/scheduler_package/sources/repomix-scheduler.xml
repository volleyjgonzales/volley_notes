namespace volley::scheduler::test::initial_states {

/// The state a scenario starts from: a layout and what stands in it, read from
/// test/scenarios/initial_states/<layout>/<name>.yaml (test/scenarios/README.md describes the file).
struct InitialState {
  /// The layout's file, for Scheduler's constructor.
  std::filesystem::path layout_path;
  DiscreteGarageState state;
};

/// Load test/scenarios/initial_states/<name>.yaml, @p name being "<layout>/<file>".
/// @throws std::runtime_error when the file, the layout or the state is invalid, which fails the test.
[[nodiscard]] InitialState Load(std::string_view name);

