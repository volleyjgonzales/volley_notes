namespace volley::scheduler::test::scenarios {

/// The `request` of a plan scenario, decoded: the jobs in file order, without GUID or registration
/// time, and the AGV commands already in the schedule.
struct Request {
  std::vector<interfaces::msg::SchedulerJob> jobs;
  std::vector<interfaces::msg::ActionNode> base_schedule;
};

/// Throw when @p map has a key outside @p allowed: the files are written by hand, and a mistyped key
/// would otherwise read as the field's default.
void ExpectKeys(const YAML::Node& map, std::span<const std::string_view> allowed, std::string_view what);

}  // namespace volley::scheduler::test::scenarios

/// How the scenario files spell the scheduler's types (test/scenarios/README.md): `node.as<T>()`
/// for a pose, a job, a base-schedule command, the scheduler parameters and the request. Every
/// decode refuses a key it does not know and throws with the reason, which the loader prefixes with
/// the file.
namespace YAML {

// NOLINTBEGIN(readability-identifier-naming): `decode` is the name yaml-cpp looks up.

template <>
struct convert<interfaces::msg::GaragePose> {
  static bool decode(const Node& node, interfaces::msg::GaragePose& pose);
};

template <>
struct convert<interfaces::msg::SchedulerJob> {
  static bool decode(const Node& node, interfaces::msg::SchedulerJob& job);
};

