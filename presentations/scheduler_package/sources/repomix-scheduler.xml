    EXPECT_FALSE(response->success);
    EXPECT_EQ(scheduler.GetSchedulerReport(now)->bay_readiness_ratio, 0.5f);
  }

  {
    const auto request = std::make_shared<interfaces::srv::SetFloat32::Request>();
    request->value = 1.5f;
