TEST(AgvAssignment, OrdersLiftsAroundBayTransitions) {
  const auto garage = scenarios::Stage("agv_assignment").initial;

  SchedulerParams params {.target_insert_ready_bay_fraction = 0.5};
  const auto scheduler = scenarios::SharedScheduler(garage.layout_path, params);
  interfaces::msg::Guid request_id = MakeGuid(0, 0xDEADBEEF);
  const auto ctx = std::make_shared<PlanContext>(request_id, garage.state, scenarios::kNow);
  const auto tray_move1 = std::make_shared<TrayMove>(0u);
  tray_move1->SetTrayId(1);
  tray_move1->SetDest(ConstructGaragePose(2068, 0));
  ctx->event_dag.AddEvent(tray_move1);
  interfaces::msg::DiscreteBayState src_bay_state;
  src_bay_state.id = 2068;
  src_bay_state.state = 2;  // Ready to Retrieve
  interfaces::msg::BayCommand cmd {};
  cmd.command_type = 2;  // processing retrieve
  const auto bay_transition = std::make_shared<BayTransition>(1u, src_bay_state, cmd);
  ctx->event_dag.AddEvent(bay_transition);
  ctx->event_dag.AddDependency(tray_move1, bay_transition);

  // Transition the bay back to ready to retrieve
  cmd.command_type = 3;     // to RFI
  src_bay_state.state = 3;  // Ready For Insert
  const auto bay_transition2 = std::make_shared<BayTransition>(2u, src_bay_state, cmd);

  ctx->event_dag.AddEvent(bay_transition2);
  ctx->event_dag.AddDependency(bay_transition, bay_transition2);

  const auto tray_move2 = std::make_shared<TrayMove>(2u);
  tray_move2->SetTrayId(1);
  tray_move2->SetDest(ConstructGaragePose(2066, 90));
  ctx->event_dag.AddEvent(tray_move2);
  ctx->event_dag.AddDependency(bay_transition2, tray_move2);

  const auto dag_before_agv = scenarios::Dag(*ctx);
  const auto agv_assignment = scheduler->AssignAgvs(ctx);
  scenarios::ExpectStage("agv_assignment", dag_before_agv, *ctx);
  EXPECT_TRUE(agv_assignment) << agv_assignment.error();
  // Verify the dependencies between the AGV lift and the bay transition
  const auto topo_ordering = ctx->event_dag.GetTopologicalOrdering();
  ASSERT_TRUE(topo_ordering.has_value());
  // The lift that starts the second move must follow the bay transition.
  bool is_agv_move_lift_found = false;
  for(const auto& event_vert : topo_ordering.value()) {
    const auto event = ctx->event_dag.GetEvent(event_vert);
    if(event->GetType() == ScheduleEventType::BAY_TRANSITION) {
      for(const auto& out_event : ctx->event_dag.GetChildren(event_vert)) {
        if(out_event->GetType() == ScheduleEventType::AGV_MOVE) {
          const auto agv_move = dynamic_cast<AgvMove*>(out_event.get());
          ASSERT_NE(agv_move, nullptr);
          const auto* lift = std::get_if<interfaces::msg::AgvLiftChanged>(&agv_move->GetDiscreteChange());
          if(lift != nullptr && lift->raised) {
            is_agv_move_lift_found = true;
          }
        }
      }
    }
  }
  ASSERT_TRUE(is_agv_move_lift_found)
      << "Bay transition event does not have the AGV move (lift) as an out edge";
}

}  // namespace volley::scheduler::test
