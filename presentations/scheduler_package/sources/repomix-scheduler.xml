// The keys of the scenario files, and the keys each map may hold.
constexpr auto kNodeId = "node_id"sv;
constexpr auto kHeading = "heading"sv;
constexpr std::string_view kPoseKeys[] = {kNodeId, kHeading};

constexpr auto kType = "type"sv;
constexpr auto kAgvId = "agv_id"sv;
constexpr auto kBayId = "bay_id"sv;
constexpr auto kTrayId = "tray_id"sv;
