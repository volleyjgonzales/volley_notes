struct DiscreteGarageEventHasher {
  size_t operator()(const DiscreteGarageEventMsg& event) const {
    size_t result = std::hash<std::string>()(event.type);
    // Hash bytes in size_t chunks
    for(size_t i = 0; i < (event.buffer.size() / sizeof(size_t)); i++) {
      // NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast,cppcoreguidelines-pro-bounds-pointer-arithmetic)
      size_t chunk = reinterpret_cast<const size_t*>(event.buffer.data())[i];
      result = volley::HashCombine(result, chunk);
    }

    // Hash last few bytes if present
    size_t bytes_left = event.buffer.size() % sizeof(size_t);
    if(bytes_left) {
      size_t chunk = 0;
      for(size_t i = bytes_left; i > 0; i--) {
        chunk += static_cast<size_t>(event.buffer[event.buffer.size() - i - 1]) << i * 8;
      }
      result = volley::HashCombine(result, chunk);
    }
    return result;
  };
};

