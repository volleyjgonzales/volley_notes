#pragma once
#include <yaml-cpp/yaml.h>

#include <cstdint>
#include <cstring>
#include <optional>
#include <tuple>
#include <vrc_interfaces/msg/gate_report.hpp>
#include <vrc_interfaces/msg/gate_state.hpp>
#include <vrc_interfaces/msg/vrc_state.hpp>

#include "common_ros/common_ros_msgs.hpp"
#include "common_ros/print_utils.hpp"
#include "common_ros/ros_utils.hpp"

// Serialize DiscreteGarageState and its sub components to YAML, with a versioned
// component. In the main garage only ever serialize to the latest version of each
// message. Attempt to read old messages if a sensible default can be deduced.
// If not, throw an exception.
//
// The standalone garage tracker recovery tool will catch said exception and write a YAML file
// indicating which fields need to be amended. Once amended the tool can also be used
// to load a state from YAML, verify it loads correctly, then write a snapshot to the mysql
// database. Once done the new version of the software can run.

// Encoder and decoder convert from ros messages to YAML supporting versioning for fields
// so that older snapshots can be loaded into newer versions, and that newer versions can
// be serialized into YAML of the older format. When encoding or decoding fails, instead
// of erroring out, parsing continues, building a node with placeholders indicating which
// fields need to be updated in order to parse correctly into the requested yaml version.

// Current VALID YAML Format DiscreteGarageState Example:
// is_faulted: true
// agvs:
//   - id: 1
//     state: "\x04"
//     lift: true
//     pose:
//       node_id: 101
//       heading: 90
//     tray_id: 101
//     disabled: false
// bays:
//   - id: 1
//     state: "\x02"
// trays:
//   - id: 101
//     pose:
//       node_id: 101
//       heading: -90
//     agv_id: 1
//     payload_id:
//       string: 00000000-0000-0000-0000-00000000CAFE
//     disabled: false
// payloads:
//   - payload:
//       id:
//         string: 00000000-0000-0000-0000-00000000C0DE
//       mass: 900
//       length_m: 4
//       width_m: 2.1
//       height_m: 1.4
//     tray_id: 301
//     reciprocal_to_tray: false
//     charging: false
// hash: 1640572270227573849

// And some examples where the data fails to parse, and how it would be annotated
// is_faulted: true
// agvs:
//  -  id: <<<MISSING>>>
//     state: "string instead of byte" <<<FAILED TO PARSE>>>
//     lift: true
//     pose:
//       node_id: 101
//       heading: 90
//     tray_id: 101
//     disabled: false
// payloads:
//   - payload:
//       id:
//         string: 32 <<<INVALID GUID>>>
//       mass: 900
//       length_m: 4
//       width_m: 2.1
//       height_m: 1.4
//     tray_id: 301
//     reciprocal_to_tray: false
//     charging: false

namespace volley {

// Update this value whenever there is a change to the ROS Messages required for serializing and
// deserializing a discrete garage state
constexpr uint32_t kLatestYamlEncodingVersion = 5;

// Serialize DiscreteGarageState to a YAML object of requested version (Default is latest version)
// If the requested version is an older format, attempt to match that version. If we don't have
// enough information to fill out a field of that requested version, return a failure, but update
// the YAML node with missing fields, with the content "MISSING". The garage tracker tool will
// provide this file to the user to be manually corrected with appropriate values, so that a garage
// can be started at the requested version.
// Whenever new fields or breaking changes to YAML encoding happen, update the encode functions here
// and volley::DiscreteGarageState::Hash function to match
std::tuple<bool, YAML::Node> EncodeVersionedYaml(
    const DiscreteGarageStateMsg& rhs, uint32_t target_version = kLatestYamlEncodingVersion);

// Decode a DiscreteGarageState from a YAML representation, keeping an internal representation of
// the YAML of the current version. If a field is missing in the YAML that doesn't have a sensible
// default, mark the decode as a failure, but continue parsing, updating the internal YAML of the
// current version to include a MISSING placeholder. Allowing the garage_tracker_recovery to provide
// that to a user to manually update so that a garage can be started without losing data or in an
// indeterminate state.
//
// node       : Input YAML::Node to recursively parse and decode representing the type T
// rhs        : Output target for the decoded YAML node
// placeholder: Input/Output parameter.
// version    : YAML Version expected, controls which fields to expect to find and which defaults to
// use.
// Decode templates publicly visible for GTest purposes

template <typename T>
bool Decode(const YAML::Node& node, T& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(const YAML::Node& node, GuidMsg& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(const YAML::Node& node, GaragePoseMsg& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(const YAML::Node& node, DiscreteAgvStateMsg& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(const YAML::Node& node, DiscreteTrayStateMsg& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(const YAML::Node& node, DiscreteBayStateMsg& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(const YAML::Node& node, DiscreteVecsStateMsg& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(
    const YAML::Node& node, vrc_interfaces::msg::VrcState& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(
    const YAML::Node& node, vrc_interfaces::msg::GateState& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(
    const YAML::Node& node, vrc_interfaces::msg::GateReport& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(const YAML::Node& node, DiscreteVrcStateMsg& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(const YAML::Node& node, PayloadMsg& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(const YAML::Node& node, DiscretePayloadStateMsg& rhs, YAML::Node& placeholder, uint32_t version);
template <>
bool Decode(const YAML::Node& node, DiscreteGarageStateMsg& rhs, YAML::Node& placeholder, uint32_t version);

template <typename T>
std::tuple<std::optional<T>, YAML::Node> DecodeVersionedYaml(const YAML::Node& root) {
  uint32_t latest_version = kLatestYamlEncodingVersion;
  T result {};
  YAML::Node placeholder_result;
  try {
    if(!root["version"]) {
      placeholder_result["version"] = "<<<MISSING>>>";
      return std::make_tuple(std::nullopt, std::move(placeholder_result));
    }

    auto version = root["version"].as<uint32_t>();
    if(version > latest_version) {
      placeholder_result["version"] =
          "Cannot parse -- version " + std::to_string(version) + " is newer than this build.";
      return std::make_tuple(std::nullopt, std::move(placeholder_result));
    }

    placeholder_result["version"] = version;

    bool success = Decode(root, result, placeholder_result, version);
    if(success) {
      return std::make_tuple(std::move(result), std::move(placeholder_result));
    }
    else {
      return std::make_tuple(std::nullopt, std::move(placeholder_result));
    }
  }
  catch(const YAML::Exception& e) {
    placeholder_result["unknown_error"] = e.what();
    return std::make_tuple(std::nullopt, std::move(placeholder_result));
  }
}

// Utility function for decoding fields which are tied to specific versions.
// Recursively calls decode to structured YAML parsing.
//
// val_ref : the field in the ROS message which is being set
// node : the YAML::Node which is expected to exist in the version range
// placeholder : the YAML node which contains a placeholder representation of all missing /
// unparsable values in case parsing fails
// default_value : will be set if the field is missing in
// the YAML or we are in a version which doesn't contain the field
// version_introduced : Try to decode value if version is this value or greater
// version_deprecated : From this version on, no longer try to decode the value
// Returns SUCCESS if value is decoded, SKIPPED if the field
// wasn't in the expected version, and FAILED if the field is expected but not decoded

enum DecodeStatus { FAILURE = 0, SUCCESS = 1, SKIPPED = 2 };

template <typename FieldType>
DecodeStatus VersionedFieldDecode(FieldType& val_ref, YAML::Node node, YAML::Node placeholder,
    uint32_t version, std::optional<FieldType> default_value = std::nullopt, uint32_t version_introduced = 0u,
    uint32_t version_deprecated = std::numeric_limits<uint32_t>::max()) {
  std::optional<FieldType> value_to_use = std::nullopt;

  if(default_value) {
    value_to_use = default_value.value();
  }

  // Expected for version
  if(version >= version_introduced and version < version_deprecated) {
    if(node) {
      FieldType decoded_value {};
      if(Decode(node, decoded_value, placeholder, version)) {
        value_to_use = decoded_value;
      }
      else {
        value_to_use = std::nullopt;  // If we fail to decode an expected value that is
      }  // present, don't use the default since theres
    }
    if(value_to_use) {
      val_ref = value_to_use.value();
      if(node) {
        placeholder = node;
      }
      return DecodeStatus::SUCCESS;
    }
    else {
      if(!placeholder) {
        placeholder = "<<<MISSING>>>";
      }
      return DecodeStatus::FAILURE;
    }
  }
  else {
    if(node)  // Field is unexpectedly present -- not sure what to do here, if everything else
              // is sane, I guess do nothing?
    {
      placeholder = "<<<UNEXPECTED>>>";
      // Can't fail to decode a valid state at this point
      return DecodeStatus::FAILURE;
    }
    // If there is a default then this is a "success" if not then the field isn't expected from
    // the version and it is skipped which is still treated like a success, the value is just
    // left initialized, which is zeroed for ROS messages.
    //
    // We need to differentiate in the case of deprecated values, which when loading into a new
    // version we might want to capture and use that value to set new values
    //
    // On the other hand we want to SKIP new values which don't exist in the current version
    // without failing, and SKIP deprecated values whos information we don't need to use.
    if(value_to_use) {
      val_ref = value_to_use.value();
      return DecodeStatus::SUCCESS;
    }
    else {
      return DecodeStatus::SKIPPED;
    }
  }
}

}  // namespace volley
