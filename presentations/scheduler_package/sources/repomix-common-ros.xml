BoolStringPair DiscreteGarageState::OnEvent(const VrcExistenceChangedMsg& event) {
  const uint32_t vrc_id = event.discrete_state.id;
  if(event.added) {
    // VRC Added

    // The VRC id must be positive
    if(vrc_id == 0) {
      return FailedEvent("VRC id must be positive");
    }

    // Ensure that the VRC does not already exist
    if(HasVrc(vrc_id)) {
      return FailedEvent("vrc" + std::to_string(vrc_id) + " already exists");
    }

    // Add the VRC
    vrcs_[vrc_id] = event.discrete_state;
    return SucceededEvent();
  }
  else {
    // VRC Removed

    // Ensure that the VRC exists
    if(!HasVrc(vrc_id)) {
      return FailedEvent("vrc" + std::to_string(vrc_id) + " not found");
    }

    // Ensure that the event information matches the VRC state information.
    const auto& vrc = vrcs_[vrc_id];
    if(vrc.state.value != event.discrete_state.state.value ||
        vrc.current_floor != event.discrete_state.current_floor ||
        vrc.requested_floor != event.discrete_state.requested_floor) {
      return FailedEvent(
          "vrc" + std::to_string(vrc_id) + " removal event did not match its state: " +
          (vrc.state.value != event.discrete_state.state.value ? " state " : "") +
          (vrc.current_floor != event.discrete_state.current_floor ? " current_floor " : "") +
          (vrc.requested_floor != event.discrete_state.requested_floor ? " requested_floor" : ""));
    }

    // Remove the VRC
    if(vrcs_.erase(vrc_id) != 1) {
      return FailedEvent("Failed to erase vrc" + std::to_string(vrc_id));
    }

    return SucceededEvent();
  }
}

BoolStringPair DiscreteGarageState::OnEvent(const VrcStateChangedMsg& event) {
  const uint16_t vrc_id = event.current_discrete_state.id;

  if(vrc_id != event.next_discrete_state.id) {
    return FailedEvent("vrc" + std::to_string(vrc_id) + " does not match ID in provided next state: vrc" +
                       std::to_string(event.next_discrete_state.id));
  }

  // Ensure that the VRC exists
  if(!HasVrc(vrc_id)) {
    return FailedEvent("vrc" + std::to_string(vrc_id) + " not found");
  }

  // Ensure that the VRC is in the specified current state, and its next state is something
  // different. NOTE: We do not check for invalid transitions, only no-ops.
  // TODO(justin): should we consider other checks (e.g. checks on current and goal floors, etc)
  DiscreteVrcStateMsg& vrc = vrcs_[vrc_id];
  const DiscreteVrcStateMsg next_vrc = event.next_discrete_state;
  if(vrc.state.value != event.current_discrete_state.state.value) {
    return FailedEvent("vrc" + std::to_string(vrc_id) + " not currently in state " +
                       std::to_string(event.current_discrete_state.state.value) + " but in " +
                       std::to_string(vrc.state.value));
  }
  else if(vrc.state.value == next_vrc.state.value) {
    return FailedEvent("vrc" + std::to_string(vrc_id) + " is already in target state");
  }

  vrc = next_vrc;
  return SucceededEvent();
}

BoolStringPair DiscreteGarageState::OnEvent(const TrayExistenceChangedMsg& event) {
  if(event.added) {
    // Tray added

    // The id must be positive
    if(event.tray_id == 0) {
      return FailedEvent("Tray id must be positive");
    }

    // Ensure that the tray does not already exist
    if(HasTray(event.tray_id)) {
      return FailedEvent("tray " + std::to_string(event.tray_id) + " already exists");
    }

    // If we are placing on an AGV, ensure that said AGV already exists,
    // and if it does, that it is lifted and does not have a tray.
    // Also verify that the tray is parallel to the AGV.
    if(event.agv_id != 0) {
      if(!HasAgv(event.agv_id)) {
        return FailedEvent("a" + std::to_string(event.agv_id) + " not found");
      }

      auto& agv = agvs_[event.agv_id];
      if(!agv.lift) {
        return FailedEvent("a" + std::to_string(event.agv_id) + " must be lifted to receive placed tray");
      }
      else if(agv.tray_id != 0) {
        return FailedEvent(
            "a" + std::to_string(event.agv_id) + " is already carrying tray " + std::to_string(agv.tray_id));
      }
      else if(!volley::IsAngleOrReciprocal(agv.pose.heading, event.heading)) {
        return FailedEvent(
            "a" + std::to_string(event.agv_id) + " is not parallel to tray " + std::to_string(event.tray_id));
      }
      else if(agv.pose.node_id != event.node_id) {
        return FailedEvent(
            "a" + std::to_string(event.agv_id) + " is not on same node as " + std::to_string(event.tray_id));
      }

      // Update the AGV to point to the tray.
      agv.tray_id = event.tray_id;
    }

    // Add the tray
    // Note that we do not check for pose validity, intersection with other agents, etc.
    // We ensure that we modify the local version so that when we zero the memory, we are
    // zeroing out what actually is stored.
    DiscreteTrayStateMsg empty_tray;
    trays_.emplace(event.tray_id, empty_tray);
    DiscreteTrayStateMsg& tray = trays_[event.tray_id];

    // Clear all bytes to zero, including padding bytes.
    // This is to ensure correct hashing in Hash.
    // NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast)
    auto memory = reinterpret_cast<uint8_t*>(&tray);
    std::memset(memory, 0x00, sizeof(tray));

    tray.id = event.tray_id;
    tray.pose.node_id = event.node_id;
    tray.pose.heading = static_cast<int16_t>(volley::Wrap(event.heading));
    tray.agv_id = event.agv_id;
    tray.disabled = event.disabled;

    return SucceededEvent();
  }
  else {  // Tray removed
    // Ensure that the tray exists
    if(!HasTray(event.tray_id)) {
      return FailedEvent("tray " + std::to_string(event.tray_id) + " not found");
    }

    // If we are removing from atop an AGV, ensure that said AGV already exists,
    // and if it does, that it has this tray.
    if(event.agv_id != 0) {
      if(!HasAgv(event.agv_id)) {
        return FailedEvent("a" + std::to_string(event.agv_id) + " not found");
      }

      auto& agv = agvs_[event.agv_id];
      if(agv.tray_id != event.tray_id) {
        return FailedEvent(
            "a" + std::to_string(event.agv_id) + " is not carrying tray " + std::to_string(agv.tray_id));
      }

      // Remove the tray from the AGV
      agv.tray_id = 0;
    }

    // Ensure that the removed tray does not have a payload
    auto& tray = trays_[event.tray_id];
    if(tray.payload_id != kEmptyGuid) {
      return FailedEvent("tray " + std::to_string(event.tray_id) + " has a payload");
    }

    // Ensure that the event information matches the tray state information.
    if(tray.pose.node_id != event.node_id || tray.pose.heading != event.heading ||
        tray.agv_id != event.agv_id || tray.disabled != event.disabled) {
      return FailedEvent("a" + std::to_string(event.agv_id) + " removal event did not match its state: " +
                         (tray.pose.node_id != event.node_id ? " node_id " : "") +
                         (tray.pose.heading != event.heading ? " heading " : "") +
                         (tray.agv_id != event.agv_id ? " agv_id " : "") +
                         (tray.disabled != event.disabled ? " disabled" : ""));
    }

    // Remove the tray
    if(trays_.erase(event.tray_id) != 1) {
      return FailedEvent("Failed to erase tray " + std::to_string(event.tray_id));
    }

    return SucceededEvent();
  }
}

BoolStringPair DiscreteGarageState::OnEvent(const TrayDisablednessChangedMsg& event) {
  // Ensure that the tray exists
  if(!HasTray(event.tray_id)) {
    return FailedEvent("tray " + std::to_string(event.tray_id) + " not found");
  }

  // Ensure that the tray is not in the target state
  auto& tray = trays_[event.tray_id];
  if(tray.disabled == event.disable) {
    return FailedEvent("tray " + std::to_string(event.tray_id) + " already has desired disabledness");
  }

  tray.disabled = event.disable;
  return SucceededEvent();
}

BoolStringPair DiscreteGarageState::OnEvent(const TrayPoseSetManuallyMsg& event) {
  // NOTE: We do not check for intersections, pose validity, etc.

  // Ensure that the tray exists
  if(!HasTray(event.tray_id)) {
    return FailedEvent("t" + std::to_string(event.tray_id) + " not found");
  }

  // Ensure that the tray is at the correct current pose
  auto& tray = trays_[event.tray_id];
  if(tray.pose.node_id != event.node_id_curr || tray.pose.heading != event.heading_curr) {
    return FailedEvent("t" + std::to_string(event.tray_id) + " should be at " +
                       std::to_string(event.node_id_curr) + "@" + std::to_string(event.heading_curr) +
                       " but is at " + std::to_string(tray.pose.node_id) + "@" +
                       std::to_string(tray.pose.heading));
  }

  // Ensure that the next pose is different
  if(event.heading_next == event.heading_curr && event.node_id_next == event.node_id_curr) {
    return FailedEvent("t" + std::to_string(event.tray_id) + " moving in-place at " +
                       std::to_string(event.node_id_curr) + "@" + std::to_string(event.heading_curr));
  }

  // Save this for later
  uint16_t orig_agv_id = tray.agv_id;

  // If the destination has a raised AGV, update that AGV too.
  for(auto& [agv_id, agv] : agvs_) {
    if(agv.pose.node_id == event.node_id_next && agv.pose.heading == event.heading_next) {
      if(agv.lift) {
        // Fail if the destination has a raised AGV with a tray
        if(agv.tray_id != 0) {
          return FailedEvent("t" + std::to_string(event.tray_id) + " moving to " +
                             std::to_string(event.node_id_curr) + "@" + std::to_string(event.heading_curr) +
                             " would be placed on a" + std::to_string(agv_id) + ", which already has tray t" +
                             std::to_string(agv.tray_id));
        }

        // Update
        agv.tray_id = event.tray_id;
        tray.agv_id = agv_id;
      }
      break;  // exit out of loop
    }
  }

  // If the tray is on an AGV, remove it from that AGV.
  if(orig_agv_id != 0) {
    agvs_[orig_agv_id].tray_id = 0;
  }

  // Update the tray
  tray.pose.node_id = event.node_id_next;
  tray.pose.heading = event.heading_next;

  return SucceededEvent();
}

BoolStringPair DiscreteGarageState::OnEvent(const PayloadExistenceChangedMsg& event) {
  if(event.added) {
    // Payload added

    GuidMsg payload_id;
    payload_id.bytes = event.payload_id;

    // Payload id cannot be the empty GUID
    if(payload_id == kEmptyGuid) {
      return FailedEvent("Payload cannot have an empty GUID");
    }

    if(HasPayload(payload_id)) {
      return FailedEvent("Payload " + std::to_string(payload_id) + " already exists");
    }

    // Grab the payload's tray.
    if(!HasTray(event.tray_id)) {
      return FailedEvent("Could not find t" + std::to_string(event.tray_id) + " for payload " +
                         std::to_string(payload_id) + "!");
    }
    auto& tray = trays_[event.tray_id];

    // That tray must be empty.
    if(tray.payload_id != kEmptyGuid) {
      return FailedEvent("Tray t" + std::to_string(event.tray_id) +
                         " already has a payload: " + std::to_string(payload_id) + "!");
    }

    // Add the payload
    // We ensure that we modify the local version so that when we zero the memory, we are
    // zeroing out what actually is stored.
    DiscretePayloadStateMsg empty_payload;
    payloads_.emplace(payload_id, empty_payload);
    DiscretePayloadStateMsg& payload_state = payloads_[payload_id];

    // Clear all bytes to zero, including padding bytes.
    // This is to ensure correct hashing in Hash.
    // NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast)
    auto memory = reinterpret_cast<uint8_t*>(&payload_state);
    std::memset(memory, 0x00, sizeof(payload_state));

    auto& payload = payload_state.payload;
    payload.id.bytes = event.payload_id;
    payload.mass = event.mass;
    payload.length_m = event.length_m;
    payload.width_m = event.width_m;
    payload.height_m = event.height_m;
    payload.ev_charge_requested = event.ev_charge_requested;
    payload_state.charging = event.charging;

    // Add the payload to the tray and vice-versa
    tray.payload_id = payload.id;
    payload_state.tray_id = tray.id;
    payload_state.reciprocal_to_tray = event.reciprocal_to_tray;

    // Add the payload to our state
    return SucceededEvent();
  }
  else {
    // Payload removed

    GuidMsg payload_id;
    payload_id.bytes = event.payload_id;

    if(!HasPayload(payload_id)) {
      return FailedEvent("Payload " + std::to_string(payload_id) + " not found");
    }

    const auto& payload_state = payloads_.at(payload_id);
    const auto& payload = payload_state.payload;

    // Ensure that the event information matches the payload state information.
    if(payload.mass != event.mass || payload.length_m != event.length_m || payload.width_m != event.width_m ||
        payload.height_m != event.height_m || payload.ev_charge_requested != event.ev_charge_requested ||
        payload_state.tray_id != event.tray_id ||
        payload_state.reciprocal_to_tray != event.reciprocal_to_tray) {
      return FailedEvent(
          "Payload " + std::to_string(payload_id) +
          " removal event did not match its state: " + (payload.mass != event.mass ? " mass " : "") +
          (payload.length_m != event.length_m ? " length_m " : "") +
          (payload.width_m != event.width_m ? " width_m " : "") +
          (payload.height_m != event.height_m ? " height_m " : "") +
          (payload.ev_charge_requested != event.ev_charge_requested ? " ev_charge_requested " : "") +
          (payload_state.tray_id != event.tray_id ? " tray_id " : "") +
          (payload_state.reciprocal_to_tray != event.reciprocal_to_tray ? " reciprocal_to_tray" : ""));
    }

    // Ensure that our tray exists, then remove the payload from the tray.
    if(!HasTray(payload_state.tray_id)) {
      return FailedEvent("Payload " + std::to_string(payload_id) + " is not on a tray!");
    }
    auto& tray = trays_[payload_state.tray_id];

    if(tray.payload_id != payload_id) {
      return FailedEvent("t" + std::to_string(tray.id) + " is not carrying " + std::to_string(payload_id));
    }

    // Remove the payload from the tray
    tray.payload_id = kEmptyGuid;

    // Remove the payload
    if(payloads_.erase(payload_id) != 1) {
      return FailedEvent("Failed to erase payload " + std::to_string(payload_id));
    }

    return SucceededEvent();
  }
}

BoolStringPair DiscreteGarageState::OnEvent(const NodeDisablednessChangedMsg& event) {
  // Ensure that the node is not in the target state
  if(IsNodeDisabled(event.node_id) == event.disable) {
    return FailedEvent("node " + std::to_string(event.node_id) + " already has desired disabledness");
  }

  // Take action
  if(event.disable) {
    disabled_nodes_.emplace(event.node_id);
  }
  else {
    disabled_nodes_.erase(event.node_id);
  }

  return SucceededEvent();
}

DiscreteGarageStateMsg DiscreteGarageState::GetDiscreteGarageStateMessage() const {
  DiscreteGarageStateMsg result {};
  result.is_faulted = IsFaulted();
  result.hash = Hash();
  result.agvs.reserve(agvs_.size());
  for(auto const& [id, agv] : agvs_) {
    result.agvs.emplace_back(agv);
  }
  result.bays.reserve(bays_.size());
  for(auto const& [id, bay] : bays_) {
    result.bays.emplace_back(bay);
  }
  result.vexen.reserve(vexen_.size());
  for(auto const& [id, vecs] : vexen_) {
    result.vexen.emplace_back(vecs);
  }
  result.vrcs.reserve(vrcs_.size());
  for(auto const& [id, vrc] : vrcs_) {
    result.vrcs.emplace_back(vrc);
  }
  result.trays.reserve(trays_.size());
  for(auto const& [id, tray] : trays_) {
    result.trays.emplace_back(tray);
  }
  result.payloads.reserve(payloads_.size());
  for(auto const& [id, payload] : payloads_) {
    result.payloads.emplace_back(payload);
  }
  for(uint32_t node_id : disabled_nodes_) {
    result.disabled_nodes.emplace_back(node_id);
  }
  return result;
}

YAML::Node DiscreteGarageState::GetYaml() const {
  return YAML::Load(interfaces::msg::to_yaml(GetDiscreteGarageStateMessage()));
}

