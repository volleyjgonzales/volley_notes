// It would be fun to make valid for an arbitrary number of boost geometry classes to be
// held by the variant. But for now we only need 2
class ComparableGeometry {
public:
  // Don't let forwarding reference greedily grab a ComparableGeometry
  // away from the copy / move constructor.
  template <typename PolyType,
      typename Test = std::enable_if_t<
          !std::is_same<ComparableGeometry, typename std::remove_reference<PolyType>::type>::value, void>>
  // NOLINTNEXTLINE(google-explicit-constructor)
  ComparableGeometry(PolyType&& poly) : geometry_(poly) { }

  ComparableGeometry Translate(double x, double y) const {
    return std::visit(
        [this, x, y](auto&& arg) -> ComparableGeometry { return Translate(arg, x, y); }, geometry_);
  }

  ComparableGeometry Rotate(double degree) const {
    return std::visit(
        [this, degree](auto&& arg) -> ComparableGeometry { return Rotate(arg, degree); }, geometry_);
  }

  // Compare to another ComparableGeometry
  bool Intersects(const ComparableGeometry& other) const {
    return std::visit(
        [this](auto&& geo, auto&& other_geo) -> bool { return boost::geometry::intersects(geo, other_geo); },
        geometry_, other.geometry_);
  }
  // Compare to any comparable boost geometry
  template <typename T>
  bool Intersects(const T& other) const {
    return std::visit(
        [this, other](auto&& geo) -> bool { return boost::geometry::intersects(geo, other); }, geometry_);
  }

  // Convert to a Polygon
  Polygon AsPolygon() const {
    return std::visit([this](auto&& arg) -> Polygon { return AsPolygon(arg); }, geometry_);
  }

  void Print() const {
    std::visit([this](auto&& geometry) { Print(geometry); }, geometry_);
  }

  void AddToGnuPlot(std::ostream& stream, std::string style) const {
    std::visit(
        [this, &stream, &style](auto&& geometry) { AddToGnuPlot(geometry, stream, style); }, geometry_);
  }

private:
  void Print(const Polygon& p) const {
    for(const auto& point : p.outer()) {
      std::cout << "(" << point.get<0>() << "," << point.get<1>() << ") ";
    }
    std::cout << std::endl;
  }
  void Print(const MultiPolygon& mp) const {
    size_t idx = 0;
    for(const auto& poly : mp) {
      std::cout << "Polygon " << idx++ << ": ";
      Print(poly);
    }
  }

  void AddToGnuPlot(const Polygon& p, std::ostream& stream, const std::string& style) const {
    // TODO(Gunther) Static poly_id aint great
    static int poly_id = 1;
    stream << "set object " << poly_id++ << " polygon from ";
    auto p_it = p.outer().begin();
    stream << p_it->get<0>() << ", " << p_it->get<1>();
    p_it++;
    while(p_it != p.outer().end()) {
      stream << " to " << p_it->get<0>() << ", " << p_it->get<1>();
      p_it++;
    }
    stream << style << std::endl;
  }

  void AddToGnuPlot(const MultiPolygon& mp, std::ostream& stream, const std::string& style) const {
    for(const auto& poly : mp) {
      AddToGnuPlot(poly, stream, style);
    }
  }

  // Convert all non-polygon boost types to a convex hull polygon
  template <typename T>
  Polygon AsPolygon(const T& geometry) const {
    Polygon hull;
    boost::geometry::convex_hull(geometry, hull);
    return hull;
  }
  Polygon AsPolygon(const Polygon& poly) const { return poly; }

  // Translate any applicable boost geometry type to (x, y)
  template <typename PolyType>
  ComparableGeometry Translate(const PolyType& poly, double x, double y) const {
    PolyType result;
    boost::geometry::strategy::transform::translate_transformer<double, 2, 2> translate(x, y);
    boost::geometry::transform(poly, result, translate);
    return ComparableGeometry(std::move(result));
  }

  // Rotate any applicable boost geometry type x degrees.
  // Note this rotates the entire geometry around the origin, not its centroid.
  template <typename PolyType>
  ComparableGeometry Rotate(const PolyType& poly, double degree) const {
    PolyType result;
    boost::geometry::strategy::transform::rotate_transformer<boost::geometry::degree, double, 2, 2> rotate(
        degree);
    boost::geometry::transform(poly, result, rotate);
    return ComparableGeometry(std::move(result));
  }

  std::variant<Polygon, MultiPolygon> geometry_;
};

class CollisionEntity {
public:
  CollisionEntity(CollisionEntityId_t id, LayoutSPtr layout) : collision_id_(id), layout_(layout) { }

  virtual ~CollisionEntity() = default;

  CollisionEntity(CollisionEntity&& other) = default;
  CollisionEntity(const CollisionEntity& other) = default;
  CollisionEntity& operator=(const CollisionEntity& other) = default;
  CollisionEntity& operator=(CollisionEntity&& other) = default;

  virtual CollisionEntityId_t GetCollisionEntityId() const { return collision_id_; }

  ComparableGeometry PolyAtPose(const GaragePoseMsg& pose) const { return PolyAtPose(BasePoly(), pose); }

  ComparableGeometry PolyAtEdge(const GaragePoseMsg& src, const GaragePoseMsg& dst) const {
    return PolyAtEdge(BasePoly(), src, dst);
  }

  Circle CircleAtPose(const GaragePoseMsg& pose) const {
    const auto node = GetLayout()->GetNodeById(pose.node_id).value();
    return {node.x, node.y, GetBoundingRadius()};
  }

  Circle CircleAtEdge(const GaragePoseMsg& src, const GaragePoseMsg& dst) const;

  void Print() const { BasePoly().Print(); }

protected:
  // Generic translation of polygon to pose
  virtual ComparableGeometry PolyAtPose(ComparableGeometry poly, const GaragePoseMsg& pose) const {
    const auto node = layout_->GetNodeById(pose.node_id).value();
    return poly.Rotate(pose.heading).Translate(node.x, node.y);
  }

  // Always returns a polygon, since edge geometry captures the whole edge of a polygon in motion,
  // meaning multipolygon shapes are represented by their convex hull without losing info.
  Polygon PolyAtEdge(ComparableGeometry cg, const GaragePoseMsg& src, const GaragePoseMsg& dst) const;

  virtual ComparableGeometry BasePoly() const = 0;

  LayoutSPtr GetLayout() const { return layout_; }

  double GetBoundingRadius() const { return bounding_radius_; }

  void SetBoundingRadius(double radius) {
    if(radius <= 0.0) {
      throw std::invalid_argument("Radius " + std::to_string(radius) + " must be positive!");
    }
    bounding_radius_ = radius;
  }

private:
  CollisionEntityId_t collision_id_;
  LayoutSPtr layout_;
  double bounding_radius_ = 0.0;
};

