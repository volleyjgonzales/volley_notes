#include <common/constants.hpp>
#include <common_ros/geometry_visualization.hpp>

namespace volley {

const std::string kEdgeStyle = "fc rgb 'green' fillstyle transparent solid 0.1 border lt -1";
const std::string kPoseStyle = "fc rgb 'blue' fillstyle transparent solid 0.1 border lt -1";

std::string GenerateLayoutPlot(const volley::GarageGraph& gg, std::ostream& gnuplot_stream) {
  LayoutSPtr layout = gg.GetLayout();
  std::string nodes_fname = "/tmp/" + layout->GetName() + "_nodes.dat";
  std::string edges_fname = "/tmp/" + layout->GetName() + "_edges.dat";
  std::ofstream nodes(nodes_fname);
  std::ofstream edges(edges_fname);

  gnuplot_stream << "unset border" << std::endl;
  gnuplot_stream << "unset key" << std::endl;
  gnuplot_stream << "unset xtics" << std::endl;
  gnuplot_stream << "unset ytics" << std::endl;

  float max_x = 0.0f, max_y = 0.0f, min_x = 0.0f, min_y = 0.0f;
  for(const auto& node : layout->GetNodes()) {
    max_x = std::max(node.x, max_x);
    min_x = std::min(node.x, min_x);
    max_y = std::max(node.y, max_y);
    min_y = std::min(node.y, min_y);
    nodes << node.x << " " << node.y << " \"" << node.id << "\"" << std::endl;
  }

  for(auto [e_it, e_end] = gg.GetEdges(); e_it != e_end; e_it++) {
    auto src = gg.GetPoseFromVertex(e_it->m_source).value();
    auto dst = gg.GetPoseFromVertex(e_it->m_target).value();
    auto src_node = layout->GetNodeById(src.node_id).value();
    auto dst_node = layout->GetNodeById(dst.node_id).value();

    if(src_node == dst_node) {
      // Draw rotation circle edge
      auto poly = volley::RotationCirclePoly(src_node.x, src_node.y, kAgvDefaultDistToRotLineSensor);
      for(const auto& point : poly.outer()) {
        edges << point.get<0>() << " " << point.get<1>() << std::endl;
      }
    }
    else {
      edges << src_node.x << " " << src_node.y << std::endl
            << dst_node.x << " " << dst_node.y << std::endl
            << std::endl;
    }
  }

  nodes.close();
  edges.close();

  // Set fixed width and range to fit entire layout
  gnuplot_stream << "set yrange [" << min_y - 6.0 << " : " << max_y + 6.0 << "]" << std::endl;
  gnuplot_stream << "set xrange [" << min_x - 6.0 << " : " << max_x + 6.0 << "]" << std::endl;
  gnuplot_stream << "set view equal xy" << std::endl;
  gnuplot_stream << "set size ratio -1" << std::endl;
  gnuplot_stream << "set terminal pdf size " << std::abs(max_y) + std::abs(min_y) + 6.0 << ","
                 << std::abs(max_x) + std::abs(min_x) + 6.0 << std::endl;

  // Set layout styles
  gnuplot_stream << "set style line 1 pt 7 ps 1 lc rgb \"red\"" << std::endl;
  gnuplot_stream << "set style line 2 lt .5 lc rgb \"black\"" << std::endl;
  std::stringstream ss;

  ss << "\"" << edges_fname << "\" with lines linestyle 2";
  ss << ", ";
  ss << "\"" << nodes_fname << R"(" with labels point linestyle 1 offset char 1,.5 font ",20",)";
  // Terminal string to be added to plot/splot
  return ss.str();
}

std::string DrawLayout(const GarageGraph& gg) {
  LayoutSPtr layout = gg.GetLayout();
  std::string gnuplot_script_fname = "/tmp/" + gg.GetLayout()->GetName() + "_gnuplot.in";
  std::ofstream gnuplot_script(gnuplot_script_fname);
  gnuplot_script << "set title '" << gg.GetLayout()->GetName() << "' noenhanced" << std::endl;
  gnuplot_script << "set output '" << layout->GetName() << ".pdf'" << std::endl;
  auto layout_data = GenerateLayoutPlot(gg, gnuplot_script);
  gnuplot_script << "plot " << layout_data << std::endl;
  gnuplot_script.close();
  return gnuplot_script_fname;
}

void DrawRootLocation(std::ostream& gnuplot_script, const std::unique_ptr<CollisionEntity>& entity,
    const CollisionTable::Pose& location) {
  entity->PolyAtPose(location).AddToGnuPlot(gnuplot_script, kPoseStyle);
}
void DrawRootLocation(std::ostream& gnuplot_script, const std::unique_ptr<CollisionEntity>& entity,
    const CollisionTable::Edge& location) {
  entity->PolyAtEdge(location[0], location[1]).AddToGnuPlot(gnuplot_script, kEdgeStyle);
}

}  // namespace volley
