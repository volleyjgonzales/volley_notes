// Used in the two Call*Service functions below.
using namespace std::chrono_literals;
template <typename Service>
bool WaitForService(std::shared_ptr<rclcpp::Client<Service>> client, const rclcpp::Logger& logger,
    std::chrono::milliseconds max_wait_time) {
  if(max_wait_time == 0ms) {
    return client->service_is_ready();
  }

  std::string name = client->get_service_name();

  const std::chrono::milliseconds wait_dt = std::min(500ms, max_wait_time);
  std::chrono::milliseconds wait_time = 0ms;
  while(!client->wait_for_service(wait_dt)) {
    if(!rclcpp::ok()) {
      ERRORS(logger, "Interrupted while waiting for the service: " << name << ". Exiting.");
      return false;
    }

    wait_time += wait_dt;
    if(wait_time >= max_wait_time) {
      ERRORS(logger, "Timed out while waiting for the service: " << name << ". Exiting.");
      return false;
    }

    INFOS(logger, "service: " << name << " not available, waiting again...");
  }

  return true;
}

// Helper function for calling a service where we only want to print the service response
// client - service client
// request - service request
// logger - ROS logger for logging response and issues
// response_callback - An optional function that is called when the shared response future returns
// Note that the all but the first template argument should be automatically deducible, such that an
// example call would look like:
// volley::CallAsync<interfaces::srv::UserInsert::Response>(client, request,
// node_->get_logger());
template <typename ServiceResponse, typename Service, typename ServiceRequest>
bool CallAsync(std::shared_ptr<rclcpp::Client<Service>> client, const ServiceRequest& request,
    const rclcpp::Logger& logger, bool print_response = true,
    std::function<void(std::shared_future<std::shared_ptr<ServiceResponse>>)> response_callback =
        std::function<void(std::shared_future<std::shared_ptr<ServiceResponse>>)>(),
    std::chrono::milliseconds max_wait_time = 5s) {
  // Ensure the service is available
  if(!WaitForService(client, logger, max_wait_time)) {
    return false;
  }

  std::string name = client->get_service_name();

  using ServiceResponseFuture = std::shared_future<std::shared_ptr<ServiceResponse>>;
  auto response_received_callback = [logger, name, print_response, response_callback](
                                        ServiceResponseFuture future) {
    if(!future.valid()) {
      return;
    }
    auto result = future.get();
    if(print_response) {
      PrintServiceResponse(logger, name, result->success, result->message);
    }
    if(response_callback) {
      response_callback(future);
    }
  };
  auto future_result = client->async_send_request(request, response_received_callback);

  return true;
}

// Helper function for calling a service and waiting for the response (i.e. blocking)
//
// This function can be very dangerous if you don't know what you're doing. It will cause a deadlock
// if not configured properly. The following two conditions MUST be met before using this function:
//    1. The callback group associated with the client cannot be the same MutuallyExclusive callback
//    group that is associated with the callback from which this function is called.
//    2. The node must be spun with a multithreaded executor.
// See https://docs.ros.org/en/lyrical/How-To-Guides/Using-callback-groups.html#id4 for details.
//
// Params:
//     client - service client
//     request - service request
//     logger - ROS logger for logging response and issues
//
// Returns:
//     An optional shared pointer to the service response. If the service call failed, the optional
//     will be empty.
//
// Notes:
//     - All but the first template argument should be automatically deducible, such that an
//           example call would look like:
//           volley::Call<interfaces::srv::UserInsert::Response>(client, request,
//           node_->get_logger());
template <typename ServiceResponse, typename Service, typename ServiceRequest>
std::optional<std::shared_ptr<ServiceResponse>> Call(std::shared_ptr<rclcpp::Client<Service>> client,
    const ServiceRequest& request, const rclcpp::Logger& logger,
    std::chrono::milliseconds wait_for_service_existence_time = 1s,
    std::chrono::milliseconds wait_for_service_completion_time = 5s) {
  // Ensure the service is available
  if(!WaitForService(client, logger, wait_for_service_existence_time)) {
    return {};
  }

  std::string name = client->get_service_name();

  auto result_future = client->async_send_request(request);
  // timeout to guarantee a graceful finish
  std::future_status status = result_future.wait_for(wait_for_service_completion_time);
  if(status == std::future_status::ready && result_future.valid()) {
    return result_future.get();
  }

  WARNS(logger, "Failed to call service: " << name << ". Future status: " << common::EnumName(status));

  return {};
}
}  // namespace volley

