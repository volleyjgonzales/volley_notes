#include <common_ros/manual_timer.hpp>

namespace volley {

ManualTimer::ManualTimer(const std::chrono::nanoseconds& period, const rclcpp::Time& now,
    const std::function<void(const rclcpp::Time& now)>& callback) :
    period_(period), time_of_next_call_(now + period), callback_(callback) {
}

void ManualTimer::Tick(const rclcpp::Time& now) {
  while(now >= time_of_next_call_) {
    callback_(now);
    time_of_next_call_ += period_;
  }
}

