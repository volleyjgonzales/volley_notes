#pragma once

#include <Eigen/Core>
#include <common/math_utils.hpp>
#include <common_ros/common_ros_msgs.hpp>

namespace volley {

constexpr float kDefaultXYTolerance = 1e-2f;
constexpr float kDefaultYawTolerance = 1e-1f;
constexpr float kDefaultXYL2Tolerance = kDefaultXYTolerance * M_SQRT2;

// Rotate the x/y values in pose by the yaw contained in pose
std::pair<double, double> InertialToBody(const GeometricPoseMsg& pose);

// Default pose tolerance values.
GeometricPoseMsg GetDefaultPoseTolerance();

// True if pose a is near pose b in all three dimensions.
bool IsNear(const GeometricPoseMsg& a, const GeometricPoseMsg& b,
    const GeometricPoseMsg& tolerance = GetDefaultPoseTolerance());

bool IsNearGeometricPose(const GeometricPoseMsg& a, const GeometricPoseMsg& b,
    double xy_tol = std::numeric_limits<double>::epsilon(),
    double yaw_tol = std::numeric_limits<double>::epsilon());

// Specialization of the math_utils IsNearToAngleOrReciprocal for GaragePose
inline bool IsAngleOrReciprocal(const GaragePoseMsg& a, const GaragePoseMsg& b) {
  return a.node_id == b.node_id && volley::IsAngleOrReciprocal(a.heading, b.heading);
}

// True if pose a is near pose b in all three dimensions, matching yaw with 180 deg offsets.
bool IsNearOrReciprocal(const GeometricPoseMsg& a, const GeometricPoseMsg& b,
    const GeometricPoseMsg& tolerance = GetDefaultPoseTolerance());

bool IsZero(const GeometricPoseMsg& input, double xy_tol = std::numeric_limits<double>::epsilon(),
    double yaw_tol = std::numeric_limits<double>::epsilon());

bool IsZero(const TwistMsg& input, double xy_tol = std::numeric_limits<double>::epsilon(),
    double yaw_tol = std::numeric_limits<double>::epsilon());

// Calculate the L2 linear and signed angular distance between two poses
std::pair<Eigen::Vector2d, volley::Angle> CalcDistFromPose(
    const GeometricPoseMsg& p1, const GeometricPoseMsg& p2);

// Get the L2-distance between poses a and b
float PoseDistance(const GeometricPoseMsg& a, const GeometricPoseMsg& b);

// Construct a pose from a garage node and a heading (in degrees).
GeometricPoseMsg ConstructPose(const GarageNodeMsg& node, int heading);

// Construct a garage pose
GaragePoseMsg ConstructGaragePose(uint32_t node_id, int16_t heading);

// Create a pose with reciprocal heading
GaragePoseMsg ReciprocalGaragePose(const GaragePoseMsg& pose);

// Construct a sized pose
SizedPoseMsg ConstructSizedPose(const GaragePoseMsg& pose, int resource_size_index);
SizedPoseMsg ConstructSizedPose(uint32_t node_id, int16_t heading, int resource_size_index);

AgvGoalMsg ConstructAgvGoal(const GaragePoseMsg& pose, bool lift);
AgvGoalMsg ConstructAgvGoal(uint32_t node_id, int16_t heading, bool lift);

// Return the list of allowed headings for this node, sorted in ascending order.
std::vector<int16_t> GetAllowedHeadings(const GarageNodeMsg& node);

// A comparator for use in a std::map if we want to use Poses as keys
// Poses are stored first by node_id, then by heading
struct GaragePoseComparator {
  bool operator()(const GaragePoseMsg& lhs, const GaragePoseMsg& rhs) const {
    if(lhs.node_id == rhs.node_id) {
      return lhs.heading < rhs.heading;
    }
    return lhs.node_id < rhs.node_id;
  }
};

}  // namespace volley
</file>

