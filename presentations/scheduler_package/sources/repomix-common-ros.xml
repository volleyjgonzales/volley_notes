//! @brief Returns whether the provided garage node belongs to a VRC
bool IsVrcNode(const GarageNodeMsg& node, const Layout& layout) {
  return layout.GetVrcForNodeId(node.id).has_value();
}

//! @brief Returns whether the edge defined by the @c src_node and @c dst_node has either node belonging to a
//! VRC
bool IsEdgeOnVrc(const GarageNodeMsg& src_node, const GarageNodeMsg& dst_node, const Layout& layout) {
  return IsVrcNode(src_node, layout) || IsVrcNode(dst_node, layout);
}

