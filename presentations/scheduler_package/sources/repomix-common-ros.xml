std::string GarageSafetyChecker::BlockerToString(const BlockingEntity& blocker) const {
  return blocker.second == ActionNodeMsg {}
             ? std::to_string(blocker.first)
             : std::format("{} from {}", std::to_string(blocker.first), std::to_string(blocker.second));
}

BoolStringPair GarageSafetyChecker::ApplyIfSafeOrSelf(const CollisionTable::PoseOrEdge& location,
    CollisionEntityId_t collision_id, const BlockingEntity& entity, bool is_lifted) {
  std::string blockers_string;
  auto blockers = safety_checker_.GetBlockers(location, collision_id, is_lifted);
  if(blockers) {
    for(const auto& blocker : *blockers) {
      if(blocker.first != entity.first) {
        blockers_string += std::format(" {}", BlockerToString(blocker));
      }
    }
  }

  if(blockers_string.empty()) {
    safety_checker_.AddOccupant(location, collision_id, entity, is_lifted);
    return {true, ""};
  }
  return {false, std::format("Failed to apply {}: Blocked by {}", BlockerToString(entity), blockers_string)};
}

BoolStringPair GarageSafetyChecker::OnEvent(
    const DiscreteGarageEventMsg& event, const DiscreteGarageState& state) {
  if(event.type == "AgvExistenceChanged") {
    auto discrete_garage_event_opt = Deserialize<AgvExistenceChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value(), state);
    }
  }
  else if(event.type == "AgvLiftChanged") {
    auto discrete_garage_event_opt = Deserialize<AgvLiftChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value(), state);
    }
  }
  else if(event.type == "AgvPoseChanged") {
    auto discrete_garage_event_opt = Deserialize<AgvPoseChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value(), state);
    }
  }
  else if(event.type == "BayExistenceChanged") {
    auto discrete_garage_event_opt = Deserialize<BayExistenceChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value(), state);
    }
  }
  else if(event.type == "BayStateChanged") {
    auto discrete_garage_event_opt = Deserialize<BayStateChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value(), state);
    }
  }
  else if(event.type == "TrayExistenceChanged") {
    auto discrete_garage_event_opt = Deserialize<TrayExistenceChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value(), state);
    }
  }
  else if(event.type == "TrayPoseSetManually") {
    auto discrete_garage_event_opt = Deserialize<TrayPoseSetManuallyMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value(), state);
    }
  }
  else if(event.type == "PayloadExistenceChanged") {
    auto discrete_garage_event_opt = Deserialize<PayloadExistenceChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value(), state);
    }
  }
  // Other events don't impact safety checker state

  return {true, ""};
}

BoolStringPair GarageSafetyChecker::OnEvent(
    const AgvExistenceChangedMsg& event, const DiscreteGarageState& state) {
  if(event.added) {
    // DGS handles all the lifty stuff already, if it was added lifted, its
    // already carrying a tray in the state.
    auto agv_opt = state.GetAgv(event.agv_id);
    if(!agv_opt) {
      return {false, "Unknown AGV with ID: " + std::to_string(event.agv_id)};
    }
    auto agv = agv_opt.value();

    if(!gg_.HasPose(agv.pose)) {
      return {true, ""};
    }

    auto collision_id = CollisionEntityIdFromAgvState(agv, state, *(gg_.GetLayout()));
    return ApplyIfSafeOrSelf(agv.pose, collision_id, {volley::AgvId(agv.id), ActionNodeMsg {}}, agv.lift);
  }
  else {
    // If the AGV was lifted, we need to find the tray, that has since been lowered (why, idk)
    // and place it back in the safety checker after removing the AGV from the safety checker
    // with the collision id from the tray that it was previously carrying

    std::optional<DiscreteTrayStateMsg> tray_opt;
    auto event_pose = ConstructGaragePose(event.node_id, event.heading);
    if(event.lift) {
      if(event.tray_id == 0) {
        // Should be handled by DGS but just in case...
        // TODO(Gunther): This might not be an error, I think we can lift w/o a tray
        // and then remove the lifted AGV and not have it be an error
        return {false,
            "error removing a" + std::to_string(event.agv_id) + ": no tray id provided but agv was lifted"};
      }
      tray_opt = state.GetTrayOnNode(event.tray_id);
      if(!tray_opt) {
        return {false,
            "error removing a" + std::to_string(event.agv_id) + ": no tray on node but agv was lifted"};
      }

      auto tray = tray_opt.value();
      if(!IsAngleOrReciprocal(tray.pose, event_pose)) {
        return {false, "error removing a" + std::to_string(event.agv_id) +
                           ": tray supposedly lifted by the agv has a heading that does "
                           "not match agv heading"};
      }
    }

    safety_checker_.ClearOccupant({volley::AgvId(event.agv_id), ActionNodeMsg {}});

    if(tray_opt) {
      auto tray_collision_id = CollisionEntityIdFromTrayState(tray_opt.value(), state, *(gg_.GetLayout()));

      // Something is seriously wrong if we fail here, the AGV carrying the tray should
      // have had the same collision entity id as the tray, so if the AGV was safe, the
      // tray should have been too.
      return ApplyIfSafeOrSelf(
          tray_opt->pose, tray_collision_id, {volley::TrayId(tray_opt->id), ActionNodeMsg {}}, false);
      // TODO(Gunther): Revert the revert if the above fails here and elsewhere
    }
  }
  return {true, ""};
}

BoolStringPair GarageSafetyChecker::OnEvent(
    const AgvLiftChangedMsg& event, const DiscreteGarageState& state) {
  auto agv_opt = state.GetAgv(event.agv_id);

  if(!agv_opt) {
    return {false, "a" + std::to_string(event.agv_id) + " does not exist"};
  }

  auto agv = agv_opt.value();

  if(event.raised) {
    // If raised, remove the Tray and AGV from the safety checker and add the AGV back
    // with the trays collision entity id

    auto tray_opt = state.GetTray(agv.tray_id);

    // We can lift w/ no tray -- in that case we don't need to do anything
    // but this is an error edge case where now technically the AGV has a
    // collision entity id of an AGV but the arms will collide with a tray,
    // big TODO here to fix that one day and maybe just use TRAY geometry
    if(tray_opt) {
      auto tray = tray_opt.value();

      safety_checker_.ClearOccupant({volley::AgvId(agv.id), ActionNodeMsg {}});
      safety_checker_.ClearOccupant({volley::TrayId(tray.id), ActionNodeMsg {}});

      // This should never fail, if the AGV and Tray were safe before, they should be
      // safe now
      return ApplyIfSafeOrSelf(agv.pose, CollisionEntityIdFromTrayState(tray, state, *(gg_.GetLayout())),
          {volley::AgvId(agv.id), ActionNodeMsg {}}, true);
    }
  }
  else {
    // Otherwise remove the AGV with the tray collision entity from the
    // safety checker and add the tray back in with the collision entity id
    // from the AGV then add the AGV back in with an AGV collision entity.

    auto tray_opt = state.GetTrayOnNode(agv.pose.node_id);
    if(tray_opt) {
      auto tray = tray_opt.value();
      if(!IsAngleOrReciprocal(tray.pose, agv.pose)) {
        return {false, "a" + std::to_string(event.agv_id) +
                           " lowered but tray has a heading that does not match agv heading"};
      }

      auto collision_id = CollisionEntityIdFromTrayState(tray, state, *(gg_.GetLayout()));
      safety_checker_.ClearOccupant({volley::AgvId(agv.id), ActionNodeMsg {}});

      auto [is_safe, message] =
          ApplyIfSafeOrSelf(tray.pose, collision_id, {volley::TrayId(tray.id), ActionNodeMsg {}}, false);
      if(!is_safe) {
        return {false, message};
      }

      return ApplyIfSafeOrSelf(agv.pose, common::EnumInteger(volley::CollisionEntityId::AGV),
          {volley::AgvId(agv.id), ActionNodeMsg {}}, false);
    }
  }
  return {true, ""};
}

BoolStringPair GarageSafetyChecker::OnEvent(
    const AgvPoseChangedMsg& event, const DiscreteGarageState& state) {
  auto agv_opt = state.GetAgv(event.agv_id);
  if(!agv_opt) {
    return {false, "a" + std::to_string(event.agv_id) + " does not exist"};
  }
  auto agv = agv_opt.value();

  auto collision_id = CollisionEntityIdFromAgvState(agv, state, *(gg_.GetLayout()));

  auto source_pose = ConstructGaragePose(event.node_id_curr, event.heading_curr);
  auto target_pose = ConstructGaragePose(event.node_id_next, event.heading_next);

  safety_checker_.ClearOccupant({volley::AgvId(agv.id), ActionNodeMsg {}});

  auto [success, msg] =
      ApplyIfSafeOrSelf(target_pose, collision_id, {volley::AgvId(agv.id), ActionNodeMsg {}}, agv.lift);

  if(!success) {
    // Undo the reversion
    safety_checker_.AddOccupant(
        source_pose, collision_id, {volley::AgvId(agv.id), ActionNodeMsg {}}, agv.lift);
    return {false, msg};
  }

  return {true, ""};
}

BoolStringPair GarageSafetyChecker::OnEvent(
    const BayExistenceChangedMsg& event, const DiscreteGarageState& state) {
  if(event.added) {
    auto bay_opt = state.GetBay(event.bay_id);
    if(!bay_opt) {
      return {false, "b" + std::to_string(event.bay_id) + " does not exist after being added"};
    }
    auto bay = bay_opt.value();
    auto bay_pose = ConstructGaragePose(
        bay.id, static_cast<int16_t>(gg_.GetLayout()->GetBayInboundHeading(bay.id).value()));

    if(bay.state != BayReportMsg::STATE_READY_TO_RETRIEVE) {
      auto [is_safe, message] =
          ApplyIfSafeOrSelf(bay_pose, static_cast<CollisionEntityId_t>(CollisionEntityId::BAY_ODP),
              {volley::BayId(bay.id), ActionNodeMsg {}}, false);

      if(!is_safe) {
        std::string error_message =
            "b" + std::to_string(event.bay_id) + " added in state that wasn't READY_TO_RETRIEVE: ";
        return {false, error_message + message};
      }
    }
  }
  else {
    // Not sure this ever really gets hit but...
    // auto bay_pose = ConstructGaragePose(event.bay_id,
    // gg_.GetLayout()->GetBayInboundHeading(event.bay_id).value());
    return {false, "didn't bother to implement this"};
  }
  return {true, ""};
}

BoolStringPair GarageSafetyChecker::OnEvent(const BayStateChangedMsg& event, const DiscreteGarageState&) {
  auto bay_pose = ConstructGaragePose(
      event.bay_id, static_cast<int16_t>(gg_.GetLayout()->GetBayInboundHeading(event.bay_id).value()));
  // If we're transitioning out of READY_TO_RETRIEVE, we need to add the ODP from the safety
  // checker
  if(event.state_curr == BayReportMsg::STATE_READY_TO_RETRIEVE) {
    return ApplyIfSafeOrSelf(bay_pose, static_cast<CollisionEntityId_t>(CollisionEntityId::BAY_ODP),
        {volley::BayId(event.bay_id), ActionNodeMsg {}}, false);
  }
  else if(event.state_next == BayReportMsg::STATE_READY_TO_RETRIEVE) {
    safety_checker_.ClearOccupant({volley::BayId(event.bay_id), ActionNodeMsg {}});
  }

  return {true, ""};
}

BoolStringPair GarageSafetyChecker::OnEvent(
    const TrayExistenceChangedMsg& event, const DiscreteGarageState& state) {
  if(event.added) {
    auto tray_opt = state.GetTray(event.tray_id);
    if(!tray_opt) {
      return {false, "t" + std::to_string(event.tray_id) + " does not exist after being added"};
    }
    auto tray = tray_opt.value();
    auto tray_collision_id = CollisionEntityIdFromTrayState(tray, state, *(gg_.GetLayout()));

    if(tray.agv_id != 0) {
      auto agv_opt = state.GetAgv(tray.agv_id);
      if(!agv_opt) {
        return {false, "t" + std::to_string(event.tray_id) + " added being carried by a" +
                           std::to_string(tray.agv_id) + " but it does not exist"};
      }

      auto agv = agv_opt.value();
      // Remove the AGV from the safety checker and add it back with the trays collision
      // entity id
      safety_checker_.ClearOccupant({volley::AgvId(agv.id), ActionNodeMsg {}});

      return ApplyIfSafeOrSelf(agv.pose, tray_collision_id, {volley::AgvId(agv.id), ActionNodeMsg {}}, true);
    }
    else {
      return ApplyIfSafeOrSelf(
          tray.pose, tray_collision_id, {volley::TrayId(tray.id), ActionNodeMsg {}}, false);
    }
  }
  else {
    // Tray removed
    if(event.agv_id) {
      // An AGV was carrying this tray, so we need to find it, and then change its collision
      // entity id back to AGV.
      // TODO(Gunther): LIFTED_AGV

      auto agv_opt = state.GetAgv(event.agv_id);
      if(!agv_opt) {
        return {false, "t" + std::to_string(event.tray_id) + " removed being carried by a" +
                           std::to_string(event.agv_id) + " but it does not exist"};
      }
      auto agv = agv_opt.value();

      auto tray_pose = ConstructGaragePose(event.node_id, event.heading);

      if(!IsAngleOrReciprocal(tray_pose, agv.pose)) {
        return {false, "t" + std::to_string(event.tray_id) + " removed being carried by a" +
                           std::to_string(event.agv_id) +
                           " but the tray has a heading that does not match agv heading"};
      }

      safety_checker_.ClearOccupant({volley::AgvId(agv.id), ActionNodeMsg {}});
      return ApplyIfSafeOrSelf(agv.pose, static_cast<CollisionEntityId_t>(CollisionEntityId::AGV),
          {volley::AgvId(agv.id), ActionNodeMsg {}}, true);
    }
    else {
      safety_checker_.ClearOccupant({volley::TrayId(event.tray_id), ActionNodeMsg {}});
    }
  }
  return {true, ""};
}

BoolStringPair GarageSafetyChecker::OnEvent(
    const TrayPoseSetManuallyMsg& event, const DiscreteGarageState& state) {
  auto start_pose = ConstructGaragePose(event.node_id_curr, event.heading_curr);
  auto end_pose = ConstructGaragePose(event.node_id_next, event.heading_next);

  auto tray_opt = state.GetTray(event.tray_id);
  if(!tray_opt) {
    return {false, "t" + std::to_string(event.tray_id) + " does not exist"};
  }
  if(end_pose != tray_opt->pose) {
    // State is updated first, so something is very wrong if we hit here
    return {false, "t" + std::to_string(event.tray_id) + " moved to a pose that does not match its pose"};
  }

  auto tray = tray_opt.value();
  auto tray_collision_id = CollisionEntityIdFromTrayState(tray, state, *(gg_.GetLayout()));

  // Need to find an AGV, if any, that we were being lifted by on the start pose.
  std::optional<DiscreteAgvStateMsg> agv_opt;
  for(const auto& [agv_id, agv] : state.GetAgvs()) {
    if(agv.pose == start_pose) {
      agv_opt = agv;
      break;
    }
  }

  if(agv_opt) {
    // Replace tray collision id w/ lifted AGV
    safety_checker_.ClearOccupant({volley::AgvId(agv_opt->id), ActionNodeMsg {}});
    // If this fails run for the hills.
    return ApplyIfSafeOrSelf(start_pose, static_cast<CollisionEntityId_t>(CollisionEntityId::AGV),
        {volley::AgvId(agv_opt->id), ActionNodeMsg {}}, true);
  }
  else {
    safety_checker_.ClearOccupant({volley::TrayId(event.tray_id), ActionNodeMsg {}});
  }

  // This is needs improvement, if we teleported to a lifted AGV, update that AGV
  if(tray.agv_id != 0) {
    // Remove tray collision body from agv and instead apply agv collision body
    agv_opt = state.GetAgv(tray.agv_id);
    if(!agv_opt) {
      return {
          false, "ERROR: GarageSafetyChecker::OnEvent agv_opt = state.GetAgv(tray.agv_id) did not get agv"};
    }

    auto agv = agv_opt.value();
    if(end_pose != agv.pose) {
      return {false, "ERROR: GarageSafetyChecker::OnEvent end_pose != agv.pose"};
    }

    safety_checker_.ClearOccupant({volley::AgvId(tray.agv_id), ActionNodeMsg {}});

    return ApplyIfSafeOrSelf(
        tray.pose, tray_collision_id, {volley::AgvId(tray.agv_id), ActionNodeMsg {}}, true);
  }
  else {
    return ApplyIfSafeOrSelf(
        tray.pose, tray_collision_id, {volley::TrayId(tray.id), ActionNodeMsg {}}, false);
  }
  return {true, ""};
}
BoolStringPair GarageSafetyChecker::OnEvent(
    const PayloadExistenceChangedMsg& event, const DiscreteGarageState& state) {
  auto tray_opt = state.GetTray(event.tray_id);
  if(!tray_opt) {
    return {false, "t" + std::to_string(event.tray_id) + " does not exist"};
  }
  auto tray = tray_opt.value();

  auto entity_id = volley::TrayId(tray.id);

  if(tray.agv_id != 0) {
    auto agv_opt = state.GetAgv(tray.agv_id);
    if(!agv_opt) {
      return {false, "t" + std::to_string(event.tray_id) + " is being carried by a" +
                         std::to_string(tray.agv_id) + " but it does not exist"};
    }
    entity_id = volley::AgvId(agv_opt->id);
  }

  if(event.added) {
    auto tray_collision_id = CollisionEntityIdFromTrayState(tray, state, *(gg_.GetLayout()));
    // Revert the old TRAY size and apply the new payload size
    safety_checker_.ClearOccupant({entity_id, ActionNodeMsg {}});
    return ApplyIfSafeOrSelf(tray.pose, tray_collision_id, {entity_id, ActionNodeMsg {}}, tray.agv_id != 0);
  }
  else {
    safety_checker_.ClearOccupant({entity_id, ActionNodeMsg {}});

    return ApplyIfSafeOrSelf(tray.pose, static_cast<CollisionEntityId_t>(CollisionEntityId::TRAY),
        {entity_id, ActionNodeMsg {}}, tray.agv_id != 0);
  }
  return {true, ""};
}

BoolStringPair GarageSafetyChecker::Set(const DiscreteGarageState& state) {
  // We guard ourselves against potential inconsistencies in a garage state message
  // by checking each event for success and returning whether we were able to apply all of them.

  bool success = true;
  std::string message = "";

  auto state_msg = state.GetDiscreteGarageStateMessage();

  for(const auto& agv : state_msg.agvs) {
    auto add_event = GetAddEvent(agv);
    // Remove any tray this AGV is carrying so that we do not try to add an
    // AGV with an unknown tray. We'll add the tray to it later correctly.
    add_event.tray_id = 0;
    std::tie(success, message) = OnEvent(add_event, state);
    if(!success) {
      return std::make_pair(false, message);
    }
  }
  for(const auto& bay : state_msg.bays) {
    std::tie(success, message) = OnEvent(GetAddEvent(bay), state);
    if(!success) {
      return std::make_pair(false, message);
    }
  }
  for(const auto& tray : state_msg.trays) {
    std::tie(success, message) = OnEvent(GetAddEvent(tray), state);
    if(!success) {
      return std::make_pair(false, message);
    }
  }
  for(const auto& payload : state_msg.payloads) {
    std::tie(success, message) = OnEvent(GetAddEvent(payload), state);
    if(!success) {
      return std::make_pair(false, message);
    }
  }
  // Success
  return std::make_pair(true, message);
}

void GarageSafetyChecker::Reset() {
  safety_checker_.ClearAll();
}

BoolStringPair GarageSafetyChecker::IsSafe(
    const ActionNodeMsg& node, const DiscreteGarageState& state) const {
  if(node.type == ActionNodeMsg::TYPE_VRC_COMMAND) {
    // A BLift's VRC carriage IS the bay -- the bay's own state machine actively manages doors
    // and patron interaction whenever it isn't sitting idle, so only allow the VRC to move
    // while the bay is in one of the known-idle states; default to blocking for everything else
    // (including boot/error states)
    const auto vrc = gg_.GetLayout()->GetVrc(node.vrc_id);
    if(vrc.has_value()) {
      for(const auto& vrc_node : vrc->nodes) {
        if(vrc_node.type != GarageNodeMsg::TYPE_BLIFT) {
          continue;
        }
        const auto bay = state.GetBay(static_cast<uint16_t>(vrc_node.id));
        const bool bay_is_idle = bay.has_value() && (bay->state == BayReportMsg::STATE_READY_TO_RETRIEVE ||
                                                        bay->state == BayReportMsg::STATE_VEHICLE_INSERTED);
        if(!bay_is_idle) {
          return {false, "VRC r" + std::to_string(node.vrc_id) + " command blocked: b" +
                             std::to_string(vrc_node.id) + " is not in an idle state (state " +
                             (bay.has_value() ? std::to_string(bay->state) : "unknown") + ")"};
        }
      }
    }
  }

  const auto location = GetLocationFromActionNode(node);

  // A nullopt location represents an action that does not occupy any physical space, so we can return true
  // without any further safety checks
  if(!location.has_value()) {
    return {true, ""};
  }

  const auto entity_id = GetEntityIdFromActionNode(node);
  const auto collision_id = GetCollisionEntityIdFromActionNode(node, state);

  const auto blockers = safety_checker_.GetBlockers(location.value(), collision_id,
      collision_id != static_cast<CollisionEntityId_t>(CollisionEntityId::AGV));

  if(!blockers.has_value()) {
    return {true, blockers.error()};
  }

  // We expect the action node to be blocked at the very least by its own entity from the
  // discrete garage state, or a previously dispatched command to bring the AGV to this
  // nodes source state. These checks should all be handled elsewhere in Dispatch / Agv land so
  // we aren't too careful here, since instead we'd have to not only verify that the source
  // pose is owned by the AGV, but also that the AGV is in the correct state to be at that pose
  // and isn't owning the pose by happenstance of some other dispatched command.
  //
  // Bay commands don't have this requirement, since a bay in READY_TO_INSERT won't have
  // any collision entity.
  for(const auto& blocker : blockers.value()) {
    if(blocker.first != entity_id) {
      return {
          false, "Action Node " + std::to_string(node) + " blocked by entity " + BlockerToString(blocker)};
    }
  }

  return {true, ""};
}

BoolStringPair GarageSafetyChecker::Apply(const ActionNodeMsg& node, const DiscreteGarageState& state) {
  const auto [is_safe, message] = IsSafe(node, state);
  if(!is_safe) {
    return {false, "Action Node is not safe to apply: " + message};
  }

  const auto location = GetLocationFromActionNode(node);
  // A nullopt location represents an action that does not occupy any physical space, so we can return true
  // without any further safety checks
  if(!location.has_value()) {
    return {true, ""};
  }

  const auto collision_id = GetCollisionEntityIdFromActionNode(node, state);
  const auto result =
      safety_checker_.AddOccupant(location.value(), collision_id, {GetEntityIdFromActionNode(node), node},
          collision_id != static_cast<CollisionEntityId_t>(CollisionEntityId::AGV));

  if(!result.has_value()) {
    return {false, result.error()};
  }

  return {true, ""};
}

BoolStringPair GarageSafetyChecker::CompleteAction(
    const ActionNodeMsg& node, const DiscreteGarageState& /*state*/) {
  safety_checker_.ClearOccupant({GetEntityIdFromActionNode(node), node});
  return {true, ""};
}

std::ostream& operator<<(std::ostream& os, const GarageSafetyChecker::BlockingEntity& entity) {
  os << "Entity: " << std::to_string(entity.first) << ", Node: " << std::to_string(entity.second);
  return os;
}

}  // namespace volley
