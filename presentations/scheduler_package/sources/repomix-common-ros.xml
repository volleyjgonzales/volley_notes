std::filesystem::path CollisionTable::GetCacheFilePath(
    const std::string& layout_name, const std::string& layout_md5) {
  const char* home = std::getenv("HOME");
  // Handle the rare case where HOME isn't set and just write collision table file to /tmp
  if(home == nullptr) {
    home = "/tmp";
  }

  const std::filesystem::path dir = std::filesystem::path(home) / ".cache" / "volley";

  std::filesystem::create_directories(dir);
  const std::string filename = layout_name + "_collision_table_" + layout_md5 + ".json";
  return dir / filename;
}

void CollisionTable::SaveTable() {
  const std::string layout_name = gg_.GetLayout()->GetName();
  INFOS(logger_, "Saving collision table for layout " << layout_name << " to file " << cache_file_path_);

  const std::string error_prefix = "Failed to save collision table to file: ";

  std::string json_str;
  try {
    json jpp;
    json jpe;
    json jep;
    json jee;
    to_json(jpp, ppmap_);
    to_json(jpe, pemap_);
    to_json(jep, epmap_);
    to_json(jee, eemap_);
    json j;
    j["pose_pose_map"] = jpp;
    j["pose_edge_map"] = jpe;
    j["edge_pose_map"] = jep;
    j["edge_edge_map"] = jee;
    // Write the whole string to the file.
    json_str = j.dump();
  }
  catch(const std::exception& ex) {
    WARNS(logger_, error_prefix << ex.what());
    return;
  }
  catch(...) {
    WARNS(logger_, error_prefix << "unknown exception serializing collision table to json");
    return;
  }

  FILE* file = ::fopen(cache_file_path_.c_str(), "wb");  // NOLINT
  if(!file) {
    WARNS(logger_, error_prefix << "failed to open file");
    return;
  }

  const size_t written = ::fwrite(json_str.data(), sizeof(char), json_str.size(), file);
  ::fclose(file);  // NOLINT
  if(written <= 0) {
    WARNS(logger_,
        error_prefix << "failed to write file, bytes written " << written << " of " << json_str.size());
    return;
  }

  // Prune old cache files for this layout, keeping only a number of files at or below the threshold size
  const std::filesystem::path cache_dir = cache_file_path_.parent_path();
  std::vector<std::filesystem::path> layout_files;
  for(const auto& entry : std::filesystem::directory_iterator(cache_dir)) {
    // Collect only files whose name starts with the layout_name
    if(entry.is_regular_file() && entry.path().filename().string().rfind(layout_name, 0) == 0) {
      layout_files.push_back(entry.path());
    }
  }

  if(layout_files.size() > kMaxCacheSizePerLayout) {
    // Sort files by last write time in order to delete by age order
    std::sort(layout_files.begin(), layout_files.end(), [](const auto& a, const auto& b) {
      return std::filesystem::last_write_time(a) < std::filesystem::last_write_time(b);
    });

    for(size_t i = 0; i < layout_files.size() - kMaxCacheSizePerLayout; ++i) {
      INFOS(logger_, "Deleting old cache file: " << layout_files.at(i));
      std::filesystem::remove(layout_files.at(i));
    }
  }

  INFOS(logger_, "Successfully saved collision table");
}

bool CollisionTable::LoadTable() {
  const std::string layout_name = gg_.GetLayout()->GetName();
  INFOS(logger_, "Loading collision table for layout " << layout_name << " from file " << cache_file_path_);

  const std::string error_prefix = "Could not load cached collision table: ";

  struct stat stbuf;  // NOLINT
  memset(&stbuf, 0, sizeof(stbuf));
  const bool exists = stat(cache_file_path_.c_str(), &stbuf) == 0;
  if(!exists) {
    WARNS(logger_, error_prefix << "file does not exist");
    return false;
  }

  if(stbuf.st_size <= 0) {
    WARNS(logger_, error_prefix << "file is empty or invalid size");
    return false;
  }

  // Read whole file contents to a string
  // Using std::ifstream, std::stringstream is inefficient for large files
  FILE* file = fopen(cache_file_path_.c_str(), "rb");  // NOLINT
  if(!file) {
    WARNS(logger_, error_prefix << "failed to open file");
    return false;
  }

  std::string contents;
  contents.resize(stbuf.st_size + 1);
  contents[stbuf.st_size] = 0;
  size_t readsize = fread(&contents[0], 1, contents.size(), file);
  fclose(file);  // NOLINT

  if(readsize <= 0 || contents.empty()) {
    WARNS(logger_, error_prefix << "failed to read file");
    return false;
  }

  try {
    json j = json::parse(contents);
    from_json(j.at("pose_pose_map"), ppmap_);
    from_json(j.at("pose_edge_map"), pemap_);
    from_json(j.at("edge_pose_map"), epmap_);
    from_json(j.at("edge_edge_map"), eemap_);
  }
  catch(const std::exception& ex) {
    WARNS(logger_, error_prefix << ex.what());
    return false;
  }
  catch(...) {
    WARNS(logger_, error_prefix << "unknown exception parsing collision table json");
    return false;
  }

  INFOS(logger_, "Successfully loaded collision table");
  return true;
}

