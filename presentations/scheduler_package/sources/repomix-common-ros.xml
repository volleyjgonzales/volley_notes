<file path="include/common_ros/garage_occupancy_checker.hpp">
#pragma once

#include <functional>
#include <stdx/expected.hpp>
#include <unordered_set>

#include "common_ros/collision_geometry.hpp"
#include "common_ros/garage_graph.hpp"

namespace volley {

//! @brief A class that tracks which garage entities occupy which locations in the garage graph and provides
//! methods to check which existing occupants block new, potential entities from being added to locations.
//! @tparam OccupantT The type of the occupants being tracked
//! @tparam OccupantEq Equality function for OccupantT (defaults to std::equal_to)
//! @tparam OccupantHash Hash function for OccupantT (defaults to std::hash)
template <typename OccupantT, typename OccupantEq = std::equal_to<OccupantT>,
    typename OccupantHash = std::hash<OccupantT>>
class GarageOccupancyChecker {
public:
  using OccupantSet = std::unordered_set<OccupantT, OccupantHash, OccupantEq>;

  //! @brief Constructor that stores the provided collision table and garage graph and builds up a set of
  //! collision entities from the collision table
  GarageOccupancyChecker(const CollisionTable& collision_table, const GarageGraph& gg) :
      collision_table_(collision_table), gg_(gg), entities_(collision_table.BuildEntityTable(gg_)) { }

  //! @brief Returns the set of occupants that block (or collide with) the provided collision entity type at
  //! the provided location.
  //! @param[in] location The location to query for blocking occupants
  //! @param[in] collision_entity_id The ID of the collision entity used to query at the location
  //! @param[in] lifted Whether the collision entity is "lifted" by an AGV
  //! @return A set of blocking occupants for a valid location, or an Unexpected error if the
  //! location is not part of the garage graph
  stdx::Expected<OccupantSet> GetBlockers(const CollisionTable::PoseOrEdge& location,
      CollisionEntityId_t collision_entity_id, bool lifted = false) const {
    if(!occupancy_state_.contains(location)) {
      // Nothing is recorded at this location yet, but location could still be valid so check and only return
      // Unexpected if not in garage graph
      if(!IsValidLocation(location)) {
        return stdx::Unexpected(
            std::format("GetBlockers called with a location that is not in the garage graph: {}",
                std::to_string(location)));
      }
      return OccupantSet {};
    }

    const auto& occupant_map = occupancy_state_.at(location);

    // Whether the occupant to add should be represented as a tray on the ground (not lifted by AGV)
    const bool is_tray_on_ground = IsEntityATrayOnGround(collision_entity_id, lifted);

    OccupantSet blockers;

    for(const auto& [occupant, blockage] : occupant_map) {
      const bool is_agv_occupant =
          blockage.occupant_collision_id == static_cast<CollisionEntityId_t>(CollisionEntityId::AGV);

      // Add blocker if the location's occupant blocks/collides with the provided collision entity type
      if(blockage.blocked_collision_ids.contains(collision_entity_id)) {
        // Do not add blocker if the occupant is an AGV and the provided collision entity is NOT a lifted tray
        if(is_agv_occupant && is_tray_on_ground) {
          continue;
        }
        blockers.insert(occupant);
      }

      // A non-lifted tray/payload will not collide with an AGV via their footprints, instead an AGV collides
      // with a tray/payload via the TRAY_LEGS collision entity. Therefore, must also check if the occupant
      // AGV collides with TRAY_LEGS here.
      if(is_agv_occupant && is_tray_on_ground &&
          blockage.blocked_collision_ids.contains(
              static_cast<CollisionEntityId_t>(CollisionEntityId::TRAY_LEGS))) {
        blockers.insert(occupant);
      }
    }

    return blockers;
  }

  //! @brief Adds an occupant of the provided collision entity type to the occupancy map at the provided
  //! location
  //! @note This method does NOT perform a check to see if the added occupant collides with existing
  //! occupants. Thus, it is possible to have multiple occupants in collision at the same location. Therefore,
  //! clients should use @c GetBlockers prior to adding occupants if they wish to check if a prospective
  //! occupant will cause a collision.
  //! @param[in] location The location in the garage graph to add the entity
  //! @param[in] collision_entity_id The collision entity ID (or type) of the occupant/entity
  //! @param[in] occupant The templated occupant object
  //! @param[in] lifted Whether the occupant/entity is lifted by an AGV
  //! @return An Unexpected error if @p location is not part of the garage graph; otherwise void on success.
  stdx::Result AddOccupant(const CollisionTable::PoseOrEdge& location,
      CollisionEntityId_t collision_entity_id, const OccupantT& occupant, bool lifted = false) {
    if(!IsValidLocation(location)) {
      return stdx::Unexpected(
          std::format("AddOccupant called with a location that is not in the garage graph: {}",
              std::to_string(location)));
    }

    // Whether the occupant to add should be represented as a tray on the ground (not lifted by AGV)
    const bool is_tray_on_ground = IsEntityATrayOnGround(collision_entity_id, lifted);

    for(const auto& entity : entities_) {
      // Trays/payloads that are NOT lifted are a special case:
      // A non-lifted tray/payload will not collide with an AGV via their footprints, instead an AGV collides
      // with a tray/payload via the TRAY_LEGS collision entity. Therefore, we overwrite the collision entity
      // type to be TRAY_LEGS only in this case.
      auto collision_entity_id_to_use = collision_entity_id;
      if(is_tray_on_ground &&
          entity->GetCollisionEntityId() == static_cast<CollisionEntityId_t>(CollisionEntityId::AGV)) {
        collision_entity_id_to_use = static_cast<CollisionEntityId_t>(CollisionEntityId::TRAY_LEGS);
      }

      const auto blocked_collision_id = entity->GetCollisionEntityId();
      // Use std::visit to unwrap the variant and call the proper Pose/Edge overload of CollisionTable::Query
      const auto [poses, edges] = std::visit(
          [&](const auto& loc) {
            return collision_table_.Query(collision_entity_id_to_use, blocked_collision_id, loc);
          },
          location);

      for(const auto& pose : poses) {
        MarkLocationOccupied(pose, occupant, collision_entity_id, blocked_collision_id);
      }
      for(const auto& edge : edges) {
        MarkLocationOccupied(edge, occupant, collision_entity_id, blocked_collision_id);
      }
    }
    return {};
  }

  //! @brief Clear the provided occupant from the occupancy map. The occupant will no longer claim/own any
  //! locations within the occupancy map.
  //! @brief occupant The templated occupant object
  void ClearOccupant(const OccupantT& occupant) {
    if(!occupant_index_.contains(occupant)) {
      return;
    }

    const std::unordered_set<CollisionTable::PoseOrEdge>& occupied_locations = occupant_index_.at(occupant);
    for(const auto& location : occupied_locations) {
      if(!occupancy_state_.contains(location)) {
        continue;
      }

      OccupantBlockageMap& occupant_map = occupancy_state_.at(location);
      // Remove the occupant from the locations occupant blockage map
      occupant_map.erase(occupant);
      // If the occupant blockage map is empty (no more occupants at location), remove location from occupancy
      // state
      if(occupant_map.empty()) {
        occupancy_state_.erase(location);
      }
    }

    occupant_index_.erase(occupant);
  }

  //! @brief Clear all occupants from the occupancy map
  void ClearAll() {
    occupancy_state_.clear();
    occupant_index_.clear();
  }

private:
  //! @brief Stores the information about a blockage due to an occupant at a single location in the occupancy
  //! map
  struct OccupantBlockage {
    //! The collision ID/type of the occupant causing the blockage
    CollisionEntityId_t occupant_collision_id = 0;
    //! The set of collision IDs/types that are/would be blocked by the occupant at this location
    std::unordered_set<CollisionEntityId_t> blocked_collision_ids;
  };

  //! Alias that maps an occupant to the blockage it causes at a particular location
  using OccupantBlockageMap = std::unordered_map<OccupantT, OccupantBlockage, OccupantHash, OccupantEq>;

  //! @brief Whether the entity should be represented as a tray on the ground (not lifted by AGV)
  //! @note A payload should also be treated as a tray given it must be placed on a tray
  static bool IsEntityATrayOnGround(CollisionEntityId_t entity_id, bool lifted) {
    return !lifted && (entity_id == static_cast<CollisionEntityId_t>(CollisionEntityId::TRAY) ||
                          entity_id >= static_cast<CollisionEntityId_t>(CollisionEntityId::PAYLOAD));
  }

  //! @brief Whether the given location exist in the garage graph
  bool IsValidLocation(const CollisionTable::PoseOrEdge& location) const {
    return std::visit([this](const auto& loc) { return IsValidLocation(loc); }, location);
  }

  //! @brief Whether the given pose (node + heading) exists in the garage graph.
  bool IsValidLocation(const CollisionTable::Pose& pose) const { return gg_.HasPose(pose); }

  //! @brief Whether the given edge's two endpoints are connected by an edge in the garage graph.
  bool IsValidLocation(const CollisionTable::Edge& edge) const {
    return gg_.GetEdgeFromPoses(edge[0], edge[1]).has_value();
  }

  //! @brief Helper method that marks a certain collision entity at a location as occupied/blocked by the
  //! provided occupant
  //! @param[in] location The location in the occupancy map
  //! @param[in] occupant The templated occupant object that is blocking the entity of type
  //! @c blocked_collision_id
  //! @param[in] occupant_collision_id The collision entity ID/type of the occupant
  //! @param[in] blocked_collision_id The collision entity ID/type of the blocked entity
  void MarkLocationOccupied(const CollisionTable::PoseOrEdge& location, const OccupantT& occupant,
      CollisionEntityId_t occupant_collision_id, CollisionEntityId_t blocked_collision_id) {
    auto& occ = occupancy_state_[location][occupant];
    occ.occupant_collision_id = occupant_collision_id;
    occ.blocked_collision_ids.insert(blocked_collision_id);
    occupant_index_[occupant].insert(location);
  }

  //! Maps location in the garage graph to a sub-map of occupant to collision entity types blocked by the
  //! occupant at that location
  std::unordered_map<CollisionTable::PoseOrEdge, OccupantBlockageMap> occupancy_state_;

  //! Maps occupant to the set of locations that it blocks/occupies (where blocks/occupies means the occupant
  //! collides with at least one other collision entity). This object acts as a reverse index (compared to
  //! @c occupancy_state_) that can be used by @c ClearOccupant to quickly lookup which locations an occupant
  //! occupies rather than iterating over all locations in @c occupancy_state_
  std::unordered_map<OccupantT, std::unordered_set<CollisionTable::PoseOrEdge>, OccupantHash, OccupantEq>
      occupant_index_;

  //! The collision table used to query for collisions between entities in the garage graph
  const CollisionTable& collision_table_;

  //! The garage graph is used to store all valid "locations" (garage poses and edges between poses) within
  //! the garage
  const GarageGraph& gg_;

  //! The fixed set of collision entities in the garage
  std::vector<std::unique_ptr<CollisionEntity>> entities_;
};

}  // namespace volley
</file>

