#include <common/constants.hpp>
#include <common/geometry_utils.hpp>
#include <common/math_utils.hpp>
#include <common_ros/pose_utils.hpp>

namespace volley {

std::pair<double, double> InertialToBody(const GeometricPoseMsg& pose) {
  return volley::InertialToBody(pose.x, pose.y, pose.yaw);
}

bool IsZero(const GeometricPoseMsg& input, double xy_tol, double yaw_tol) {
  return volley::IsZero<double>(input.x, xy_tol) && volley::IsZero<double>(input.y, xy_tol) &&
         volley::IsZero<double>(input.yaw, yaw_tol);
}

bool IsZero(const TwistMsg& input, double xy_tol, double yaw_tol) {
  return volley::IsZero<double>(input.x, xy_tol) && volley::IsZero<double>(input.y, xy_tol) &&
         volley::IsZero<double>(input.yaw, yaw_tol);
}

bool IsNearGeometricPose(
    const GeometricPoseMsg& a, const GeometricPoseMsg& b, double xy_tol, double yaw_tol) {
  return volley::IsNear<double>(a.x, b.x, xy_tol) && volley::IsNear<double>(a.y, b.y, xy_tol) &&
         volley::IsAngleNear<double>(a.yaw, b.yaw, yaw_tol);
}

std::pair<Eigen::Vector2d, volley::Angle> CalcDistFromPose(
    const GeometricPoseMsg& p1, const GeometricPoseMsg& p2) {
  Eigen::Vector2d linear_distance {p2.x - p1.x, p2.y - p1.y};
  volley::Angle angular_distance = volley::Angle(p2.yaw) - volley::Angle(p1.yaw);
  return std::make_pair(linear_distance, angular_distance);
}

GeometricPoseMsg GetDefaultPoseTolerance() {
  GeometricPoseMsg tolerance;
  tolerance.x = kDefaultXYTolerance;
  tolerance.y = kDefaultXYTolerance;
  tolerance.yaw = kDefaultYawTolerance;
  return tolerance;
}

bool IsNear(const GeometricPoseMsg& a, const GeometricPoseMsg& b, const GeometricPoseMsg& tolerance) {
  return volley::IsNear(a.x, b.x, tolerance.x) && volley::IsNear(a.y, b.y, tolerance.y) &&
         volley::IsAngleNear(a.yaw, b.yaw, tolerance.yaw);
}

bool IsNearOrReciprocal(
    const GeometricPoseMsg& a, const GeometricPoseMsg& b, const GeometricPoseMsg& tolerance) {
  bool matches_x = volley::IsNear(a.x, b.x, tolerance.x);
  bool matches_y = volley::IsNear(a.y, b.y, tolerance.y);
  bool matches_yaw = volley::IsNearToAngleOrReciprocal(a.yaw, b.yaw, tolerance.yaw);
  return matches_x && matches_y && matches_yaw;
}

float PoseDistance(const GeometricPoseMsg& a, const GeometricPoseMsg& b) {
  return std::hypot(a.x - b.x, a.y - b.y);
}

GeometricPoseMsg ConstructPose(const GarageNodeMsg& node, int heading) {
  auto pose = GeometricPoseMsg {};
  pose.x = node.x;
  pose.y = node.y;
  pose.yaw = static_cast<float>(heading * kDeg2Rad);
  return pose;
}

GaragePoseMsg ConstructGaragePose(uint32_t node_id, int16_t heading) {
  GaragePoseMsg pose;
  pose.node_id = node_id;
  pose.heading = heading;
  return pose;
}

GaragePoseMsg ReciprocalGaragePose(const GaragePoseMsg& pose) {
  GaragePoseMsg recip;

  recip.node_id = pose.node_id;
  recip.heading = volley::ReciprocalAngle(pose.heading);

  return recip;
}

SizedPoseMsg ConstructSizedPose(const GaragePoseMsg& pose, int resource_size_index) {
  SizedPoseMsg sized_pose;
  sized_pose.pose = pose;
  sized_pose.resource_size_index = resource_size_index;
  return sized_pose;
}

SizedPoseMsg ConstructSizedPose(uint32_t node_id, int16_t heading, int resource_size_index) {
  return ConstructSizedPose(ConstructGaragePose(node_id, heading), resource_size_index);
}

AgvGoalMsg ConstructAgvGoal(const GaragePoseMsg& pose, bool lift) {
  AgvGoalMsg agv_goal;
  agv_goal.pose = pose;
  agv_goal.lift = lift;
  return agv_goal;
}

AgvGoalMsg ConstructAgvGoal(uint32_t node_id, int16_t heading, bool lift) {
  return ConstructAgvGoal(ConstructGaragePose(node_id, heading), lift);
}

std::vector<int16_t> GetAllowedHeadings(const GarageNodeMsg& node) {
  std::vector<int16_t> headings;

  // Node headings in GarageNode are in degrees, 0:179.
  // We include each heading and its reciprocal.
  for(uint16_t heading : node.headings) {
    headings.emplace_back(volley::Wrap(heading));
    headings.emplace_back(volley::Wrap(heading + 180));
  }

  // Sort the headings in ascending order
  std::sort(headings.begin(), headings.end());

  return headings;
}

}  // namespace volley
</file>

