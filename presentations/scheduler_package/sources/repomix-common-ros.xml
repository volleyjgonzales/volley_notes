// A comparator for use in a std::map if we want to use edges as keys
// Note that we treat edges as bidirectional.
struct EdgeComparator {
  bool operator()(const EdgeMsg& lhs, const EdgeMsg& rhs) const {
    uint32_t lhs_a = std::min(lhs.src, lhs.dst);
    uint32_t lhs_b = std::max(lhs.src, lhs.dst);
    uint32_t rhs_a = std::min(rhs.src, rhs.dst);
    uint32_t rhs_b = std::max(rhs.src, rhs.dst);
    if(lhs_a == rhs_a) {
      return lhs_b < rhs_b;
    }
    return lhs_a < rhs_a;
  }
};

