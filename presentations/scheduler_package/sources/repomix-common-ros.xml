#include "common_ros/versioned_state_buffer.hpp"

namespace volley {

YAML::Node Encode(const DiscreteGarageStateMsg& rhs, uint32_t target_version);
YAML::Node Encode(const DiscreteAgvStateMsg& rhs, uint32_t target_version);
YAML::Node Encode(const DiscreteTrayStateMsg& rhs, uint32_t target_version);
YAML::Node Encode(const DiscreteBayStateMsg& rhs, uint32_t target_version);
YAML::Node Encode(const DiscreteVecsStateMsg& rhs, uint32_t target_version);
YAML::Node Encode(const DiscretePayloadStateMsg& rhs, uint32_t target_version);
YAML::Node Encode(const PayloadMsg& rhs, uint32_t target_version);
YAML::Node Encode(const GuidMsg& rhs, uint32_t target_version);
YAML::Node Encode(const GaragePoseMsg& rhs, uint32_t target_version);
YAML::Node Encode(const DiscreteVrcStateMsg& rhs, uint32_t target_version);
YAML::Node Encode(const vrc_interfaces::msg::VrcState& rhs, uint32_t target_version);
YAML::Node Encode(const vrc_interfaces::msg::GateReport& rhs, uint32_t target_version);
YAML::Node Encode(const vrc_interfaces::msg::GateState& rhs, uint32_t target_version);

// Returns success, if not successful the YAML::Node will contain annotations as to what failed
// to encode.
// TODO(Gunther) Right now there isn't a risk of failing to encode, leaving the above function
// to be tailored a little bit depending on what encoding failures actually are possible as they
// come up.

std::tuple<bool, YAML::Node> EncodeVersionedYaml(const DiscreteGarageStateMsg& rhs, uint32_t target_version) {
  YAML::Node result = Encode(rhs, target_version);
  return std::make_tuple(true, std::move(result));
}

YAML::Node Encode(const DiscreteGarageStateMsg& rhs, uint32_t target_version) {
  YAML::Node root;
  root["version"] = target_version;
  root["is_faulted"] = rhs.is_faulted;
  for(const DiscreteAgvStateMsg& agv : rhs.agvs) {
    root["agvs"].push_back(Encode(agv, target_version));
  }
  for(const DiscreteBayStateMsg& bay : rhs.bays) {
    root["bays"].push_back(Encode(bay, target_version));
  }
  for(const DiscreteTrayStateMsg& tray : rhs.trays) {
    root["trays"].push_back(Encode(tray, target_version));
  }
  if(target_version > 2) {
    for(const DiscreteVecsStateMsg& vecs : rhs.vexen) {
      root["vexen"].push_back(Encode(vecs, target_version));
    }
  }
  for(const DiscretePayloadStateMsg& payload : rhs.payloads) {
    root["payloads"].push_back(Encode(payload, target_version));
  }
  if(target_version >= 5) {
    for(const DiscreteVrcStateMsg& vrc : rhs.vrcs) {
      root["vrcs"].push_back(Encode(vrc, target_version));
    }
  }
  for(uint32_t disabled_node : rhs.disabled_nodes) {
    root["disabled_nodes"].push_back(disabled_node);
  }
  root["hash"] = rhs.hash;
  return root;
}

YAML::Node Encode(const DiscreteAgvStateMsg& rhs, uint32_t target_version) {
  YAML::Node node;
  node["id"] = rhs.id;
  node["state"] = static_cast<unsigned>(rhs.state);
  node["lift"] = rhs.lift;
  node["pose"] = Encode(rhs.pose, target_version);
  node["tray_id"] = rhs.tray_id;
  node["disabled"] = rhs.disabled;
  return node;
}

YAML::Node Encode(const DiscreteTrayStateMsg& rhs, uint32_t target_version) {
  YAML::Node node;
  node["id"] = rhs.id;
  node["pose"] = Encode(rhs.pose, target_version);
  node["agv_id"] = rhs.agv_id;
  node["payload_id"] = Encode(rhs.payload_id, target_version);
  node["disabled"] = rhs.disabled;
  return node;
}
YAML::Node Encode(const DiscreteBayStateMsg& rhs, uint32_t target_version) {
  YAML::Node node;
  node["id"] = rhs.id;
  node["state"] = static_cast<unsigned>(rhs.state);
  if(target_version > 1) {
    node["disabled"] = rhs.disabled;
  }
  return node;
}
YAML::Node Encode(const DiscreteVecsStateMsg& rhs, uint32_t /*target_version*/) {
  YAML::Node node;
  node["id"] = rhs.id;
  node["state"] = static_cast<unsigned>(rhs.state);
  node["disabled"] = rhs.disabled;
  return node;
}
YAML::Node Encode(const DiscretePayloadStateMsg& rhs, uint32_t target_version) {
  YAML::Node node;
  node["payload"] = Encode(rhs.payload, target_version);
  node["tray_id"] = rhs.tray_id;
  node["reciprocal_to_tray"] = rhs.reciprocal_to_tray;
  node["charging"] = rhs.charging;
  return node;
}
YAML::Node Encode(const PayloadMsg& rhs, uint32_t target_version) {
  YAML::Node node;
  node["id"] = Encode(rhs.id, target_version);
  node["mass"] = rhs.mass;
  node["length_m"] = rhs.length_m;
  node["width_m"] = rhs.width_m;
  node["height_m"] = rhs.height_m;
  if(target_version > 3) {
    node["ev_charge_requested"] = rhs.ev_charge_requested;
  }
  return node;
}

YAML::Node Encode(const GuidMsg& rhs, uint32_t /*target_version*/) {
  YAML::Node node;
  node["string"] = std::to_string(rhs);
  return node;
}
YAML::Node Encode(const GaragePoseMsg& rhs, uint32_t /*target_version*/) {
  YAML::Node node;
  node["node_id"] = rhs.node_id;
  node["heading"] = rhs.heading;
  return node;
}
YAML::Node Encode(const DiscreteVrcStateMsg& rhs, uint32_t target_version) {
  YAML::Node node;
  node["id"] = rhs.id;
  node["state"] = Encode(rhs.state, target_version);
  for(const vrc_interfaces::msg::GateReport& gate : rhs.gates) {
    node["gates"].push_back(Encode(gate, target_version));
  }
  node["current_floor"] = rhs.current_floor;
  node["requested_floor"] = rhs.requested_floor;
  return node;
}
YAML::Node Encode(const vrc_interfaces::msg::VrcState& rhs, uint32_t /*target_version*/) {
  YAML::Node node;
  node["value"] = static_cast<unsigned>(rhs.value);
  return node;
}
YAML::Node Encode(const vrc_interfaces::msg::GateReport& rhs, uint32_t target_version) {
  YAML::Node node;
  node["floor"] = rhs.floor;
  node["state"] = Encode(rhs.state, target_version);
  return node;
}
YAML::Node Encode(const vrc_interfaces::msg::GateState& rhs, uint32_t /*target_version*/) {
  YAML::Node node;
  node["value"] = static_cast<unsigned>(rhs.value);
  return node;
}

// ============================================================================================
// Decoder implementation

// Decode raw values. Versioned fields
template <typename T>
bool Decode(const YAML::Node& node, T& rhs, YAML::Node& placeholder, uint32_t /*version*/) {
  if(node) {
    try {
      rhs = node.as<T>();
      return true;
    }
    catch(const YAML::BadConversion& e) {
      placeholder = node.as<std::string>() + std::string(" <<<FAILED TO PARSE>>>");
    }
  }
  else {
    placeholder = "<<<MISSING>>>";
  }
  return false;
}

// Explicit templatization required for `uint64_t` in latest gcc
template <>
bool Decode(const YAML::Node& node, uint64_t& rhs, YAML::Node& placeholder, uint32_t /*version*/) {
  if(node) {
    try {
      rhs = node.as<uint64_t>();
      return true;
    }
    catch(const YAML::BadConversion& e) {
      placeholder = node.as<std::string>() + std::string(" <<<FAILED TO PARSE>>>");
    }
  }
  else {
    placeholder = "<<<MISSING>>>";
  }
  return false;
}

// Need a specific function for uint8_t since encoding as unsigned char under the hood causes
// problems reading 0 as '0' or writing '\x00'
template <>
bool Decode(const YAML::Node& node, uint8_t& rhs, YAML::Node& placeholder, uint32_t /*version*/) {
  if(node) {
    try {
      rhs = node.as<unsigned>();
      return true;
    }
    catch(const YAML::BadConversion& e) {
      placeholder = node.as<std::string>() + std::string(" <<<FAILED TO PARSE>>>");
    }
  }
  else {
    placeholder = "<<<MISSING>>>";
  }
  return false;
}

template <>
bool Decode(const YAML::Node& node, GuidMsg& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  std::string guid_string;
  success = VersionedFieldDecode(guid_string, node["string"], placeholder["string"], version) && success;
  if(success) {
    auto guid_opt = ParseGuid(guid_string);
    if(guid_opt) {
      rhs = guid_opt.value();
    }
    else {
      success = false;
      placeholder["string"] = guid_string + " <<<INVAID GUID>>>";
    }
  }
  return success;
}

template <>
bool Decode(const YAML::Node& node, GaragePoseMsg& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  success = VersionedFieldDecode(rhs.node_id, node["node_id"], placeholder["node_id"], version) && success;
  success = VersionedFieldDecode(rhs.heading, node["heading"], placeholder["heading"], version) && success;
  return success;
}

template <>
bool Decode(const YAML::Node& node, DiscreteAgvStateMsg& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  success = VersionedFieldDecode(rhs.id, node["id"], placeholder["id"], version) && success;
  success = VersionedFieldDecode(rhs.state, node["state"], placeholder["state"], version) && success;
  success = VersionedFieldDecode(rhs.lift, node["lift"], placeholder["lift"], version) && success;
  success = VersionedFieldDecode(rhs.pose, node["pose"], placeholder["pose"], version) && success;
  success =
      VersionedFieldDecode(rhs.tray_id, node["tray_id"], placeholder["tray_id"], version, {0}) && success;
  success = VersionedFieldDecode(rhs.disabled, node["disabled"], placeholder["disabled"], version) && success;
  return success;
}

template <>
bool Decode(const YAML::Node& node, DiscreteTrayStateMsg& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  success = VersionedFieldDecode(rhs.id, node["id"], placeholder["id"], version) && success;
  success = VersionedFieldDecode(rhs.pose, node["pose"], placeholder["pose"], version) && success;
  success = VersionedFieldDecode(rhs.agv_id, node["agv_id"], placeholder["agv_id"], version, {0u}) && success;
  success = VersionedFieldDecode(rhs.payload_id, node["payload_id"], placeholder["payload_id"], version,
                {volley::kEmptyGuid}) &&
            success;
  success = VersionedFieldDecode(rhs.disabled, node["disabled"], placeholder["disabled"], version) && success;

  return success;
}

template <>
bool Decode(const YAML::Node& node, DiscreteBayStateMsg& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  success = VersionedFieldDecode(rhs.id, node["id"], placeholder["id"], version) && success;
  success = VersionedFieldDecode(rhs.state, node["state"], placeholder["state"], version) && success;
  success =
      VersionedFieldDecode(rhs.disabled, node["disabled"], placeholder["disabled"], version, {false}, 2u) &&
      success;
  return success;
}

template <>
bool Decode(const YAML::Node& node, DiscreteVecsStateMsg& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  success = VersionedFieldDecode(rhs.id, node["id"], placeholder["id"], version) && success;
  success = VersionedFieldDecode(rhs.state, node["state"], placeholder["state"], version) && success;
  success =
      VersionedFieldDecode(rhs.disabled, node["disabled"], placeholder["disabled"], version, {false}, 3u) &&
      success;
  return success;
}

template <>
bool Decode(const YAML::Node& node, PayloadMsg& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  success = VersionedFieldDecode(rhs.id, node["id"], placeholder["id"], version) && success;
  success = VersionedFieldDecode(rhs.mass, node["mass"], placeholder["mass"], version) && success;
  success = VersionedFieldDecode(rhs.length_m, node["length_m"], placeholder["length_m"], version) && success;
  success = VersionedFieldDecode(rhs.width_m, node["width_m"], placeholder["width_m"], version) && success;
  success = VersionedFieldDecode(rhs.height_m, node["height_m"], placeholder["height_m"], version) && success;
  success = VersionedFieldDecode(rhs.ev_charge_requested, node["ev_charge_requested"],
                placeholder["ev_charge_requested"], version, std::optional<bool>(false), 4u) &&
            success;
  return success;
}

template <>
bool Decode(const YAML::Node& node, DiscretePayloadStateMsg& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  success = VersionedFieldDecode(rhs.payload, node["payload"], placeholder["payload"], version) && success;
  success = VersionedFieldDecode(rhs.tray_id, node["tray_id"], placeholder["tray_id"], version) && success;
  success = VersionedFieldDecode(rhs.reciprocal_to_tray, node["reciprocal_to_tray"],
                placeholder["reciprocal_to_tray"], version) &&
            success;
  success = VersionedFieldDecode(rhs.charging, node["charging"], placeholder["charging"], version) && success;
  return success;
}

template <>
bool Decode(
    const YAML::Node& node, vrc_interfaces::msg::VrcState& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  success = VersionedFieldDecode(rhs.value, node["value"], placeholder["value"], version) && success;
  return success;
}

template <>
bool Decode(
    const YAML::Node& node, vrc_interfaces::msg::GateState& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  success = VersionedFieldDecode(rhs.value, node["value"], placeholder["value"], version) && success;
  return success;
}

template <>
bool Decode(
    const YAML::Node& node, vrc_interfaces::msg::GateReport& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  success = VersionedFieldDecode(rhs.floor, node["floor"], placeholder["floor"], version) && success;
  success = VersionedFieldDecode(rhs.state, node["state"], placeholder["state"], version) && success;
  return success;
}

template <>
bool Decode(const YAML::Node& node, DiscreteVrcStateMsg& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  success = VersionedFieldDecode(rhs.id, node["id"], placeholder["id"], version) && success;
  success = VersionedFieldDecode(rhs.state, node["state"], placeholder["state"], version) && success;
  for(const YAML::Node& gate : node["gates"]) {
    rhs.gates.push_back(vrc_interfaces::msg::GateReport {});
    YAML::Node local_placeholder;
    placeholder["gates"].push_back(local_placeholder);
    success = VersionedFieldDecode(rhs.gates.back(), gate, local_placeholder, version) && success;
  }
  success =
      VersionedFieldDecode(rhs.current_floor, node["current_floor"], placeholder["current_floor"], version) &&
      success;
  success = VersionedFieldDecode(
                rhs.requested_floor, node["requested_floor"], placeholder["requested_floor"], version) &&
            success;
  return success;
}

template <>
bool Decode(const YAML::Node& node, DiscreteGarageStateMsg& rhs, YAML::Node& placeholder, uint32_t version) {
  bool success = true;
  success =
      VersionedFieldDecode(rhs.is_faulted, node["is_faulted"], placeholder["is_faulted"], version) && success;
  for(const YAML::Node& agv : node["agvs"]) {
    rhs.agvs.push_back(DiscreteAgvStateMsg {});
    YAML::Node local_placeholder;
    placeholder["agvs"].push_back(local_placeholder);
    success = VersionedFieldDecode(rhs.agvs.back(), agv, local_placeholder, version) && success;
  }
  for(const YAML::Node& bay : node["bays"]) {
    rhs.bays.push_back(DiscreteBayStateMsg {});
    YAML::Node local_placeholder;
    placeholder["bays"].push_back(local_placeholder);
    success = VersionedFieldDecode(rhs.bays.back(), bay, local_placeholder, version) && success;
  }
  for(const YAML::Node& tray : node["trays"]) {
    rhs.trays.push_back(DiscreteTrayStateMsg {});
    YAML::Node local_placeholder;
    placeholder["trays"].push_back(local_placeholder);
    success = VersionedFieldDecode(rhs.trays.back(), tray, local_placeholder, version) && success;
  }
  for(const YAML::Node& vecs : node["vexen"]) {
    rhs.vexen.push_back(DiscreteVecsStateMsg {});
    YAML::Node local_placeholder;
    placeholder["vexen"].push_back(local_placeholder);
    success = VersionedFieldDecode(rhs.vexen.back(), vecs, local_placeholder, version) && success;
  }
  for(const YAML::Node& payload : node["payloads"]) {
    rhs.payloads.push_back(DiscretePayloadStateMsg {});
    YAML::Node local_placeholder;
    placeholder["payloads"].push_back(local_placeholder);
    success = VersionedFieldDecode(rhs.payloads.back(), payload, local_placeholder, version) && success;
  }
  for(const YAML::Node& vrc : node["vrcs"]) {
    rhs.vrcs.push_back(DiscreteVrcStateMsg {});
    YAML::Node local_placeholder;
    placeholder["vrcs"].push_back(local_placeholder);
    success = VersionedFieldDecode(rhs.vrcs.back(), vrc, local_placeholder, version) && success;
  }
  for(const YAML::Node& node_id : node["disabled_nodes"]) {
    rhs.disabled_nodes.push_back(0);
    YAML::Node local_placeholder;
    placeholder["disabled_nodes"].push_back(local_placeholder);
    success = VersionedFieldDecode(rhs.disabled_nodes.back(), node_id, local_placeholder, version) && success;
  }

  // Don't fail if hash isn't present in yaml, use 0 as a default value. The resulting garage
  // state won't start in the central server, but the garage_tracker_recovery will be able to
  // calculate the correct hash prior to the uploading of the state to mysql.
  success = VersionedFieldDecode(rhs.hash, node["hash"], placeholder["hash"], version, {0}) && success;
  return success;
}
}  // namespace volley
