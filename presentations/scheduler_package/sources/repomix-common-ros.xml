class PayloadEntity : public CollisionEntity {
public:
  explicit PayloadEntity(size_t window_id, const ParkingWindowMsg& window, LayoutSPtr layout) :
      CollisionEntity(common::EnumInteger(CollisionEntityId::PAYLOAD), layout),
      window_idx_(window_id),
      window_(window) {
    CalculateBoundingRadius();
  }

  size_t GetWindow() const { return window_idx_; }

  CollisionEntityId_t GetCollisionEntityId() const override {
    return static_cast<CollisionEntityId_t>(CollisionEntityId::PAYLOAD) +
           static_cast<CollisionEntityId_t>(window_idx_);
  }

private:
  ComparableGeometry BasePoly() const override {
    return RectangleFromSize(window_.length_m, window_.width_m);
  }
  size_t window_idx_;
  ParkingWindowMsg window_;

  void CalculateBoundingRadius() {
    // Bounding radius is the distance from the center to the corner of the payload
    SetBoundingRadius(volley::CalculateSquareRadius(window_.length_m, window_.width_m));
  }
};

class CollisionTable {
public:
  using Pose = GaragePoseMsg;
  using Edge = std::array<Pose, 2u>;
  using PoseOrEdge = std::variant<Pose, Edge>;  // a single "cell" in the table (either a pose or an edge)
  using PoseSet = std::unordered_set<Pose>;
  using EdgeSet = std::unordered_set<Edge>;
  using LayoutHash = size_t;
  // using PlotFn = std::function<void(std::ostream&)>;

  template <typename FixedState, typename QueriedState>
  using ResMap = std::unordered_map<size_t,
      std::unordered_map<FixedState, std::unordered_map<size_t, std::unordered_set<QueriedState>>>>;
  template <typename FixedState, typename QueriedState>
  using LayoutResourceMap = std::unordered_map<LayoutHash, ResMap<FixedState, QueriedState>>;

  using PosePoseMap = ResMap<Pose, Pose>;
  using PoseEdgeMap = ResMap<Pose, Edge>;
  using EdgePoseMap = ResMap<Edge, Pose>;
  using EdgeEdgeMap = ResMap<Edge, Edge>;

  // Maximum number of collision table files per layout to store in the local filesystem cache before pruning
  // oldest files
  static const uint8_t kMaxCacheSizePerLayout;

  // Build collision table from the garage graph
  CollisionTable(const GarageGraph& garage_graph, const rclcpp::Logger& logger);

  // NOTE: Right now this won't distinguish between invalid queries (ie resource idx doesn't
  // exist in this garage) and valid queries where the actual combination doesn't conflict,
  // since we don't initialize empty vectors for the vast majority of non-conflicting sets.
  // TODO(Gunther): Differentiate between non-existent and non-conflicting queries.
  // TODO(Gunther): Use a unified collision entity id everywhere.
  std::tuple<const PoseSet, const EdgeSet> Query(
      CollisionEntityId_t fixed_resource, CollisionEntityId_t queried_resource, const Pose& location) const {
    PoseSet poses;
    EdgeSet edges;

    try {
      poses = ppmap_.at(fixed_resource).at(location).at(queried_resource);
    }
    catch(std::out_of_range&) {
      // No conflicts.
    }

    try {
      edges = pemap_.at(fixed_resource).at(location).at(queried_resource);
    }
    catch(std::out_of_range&) {
      // No conflicts.
    }
    return {std::move(poses), std::move(edges)};
  }
  std::tuple<const PoseSet, const EdgeSet> Query(
      CollisionEntityId_t fixed_resource, CollisionEntityId_t queried_resource, const Edge& location) const {
    PoseSet poses;
    EdgeSet edges;

    try {
      poses = epmap_.at(fixed_resource).at(location).at(queried_resource);
    }
    catch(std::out_of_range&) {
      // No conflicts.
    }

    try {
      edges = eemap_.at(fixed_resource).at(location).at(queried_resource);
    }
    catch(std::out_of_range&) {
      // No conflicts.
    }
    return {std::move(poses), std::move(edges)};
  }

  // Explicit check implementation of above, checking a single location directly
  // Returns true if a fixed resource at a fixed location precludes an entity of the queried
  // resource type to exist at the queried location.
  // TODO(Gunther): Differentiate between non-existent and non-conflicting queries.
  // TODO(Gunther): Use a unified collision entity id everywhere.
  bool Query(CollisionEntityId_t fixed_resource, CollisionEntityId_t queried_resource, const Pose& location,
      const Pose& queried_location) const {
    std::unordered_set<Pose> locations;

    try {
      locations = ppmap_.at(fixed_resource).at(location).at(queried_resource);
    }
    catch(std::out_of_range&) {
      return false;  // No conflicts.
    }

    return locations.find(queried_location) != locations.end();
  }
  bool Query(CollisionEntityId_t fixed_resource, CollisionEntityId_t queried_resource, const Pose& location,
      const Edge& queried_location) const {
    std::unordered_set<Edge> locations;

    try {
      locations = pemap_.at(fixed_resource).at(location).at(queried_resource);
    }
    catch(std::out_of_range&) {
      return false;  // No conflicts.
    }

    return locations.find(queried_location) != locations.end();
  }
  bool Query(CollisionEntityId_t fixed_resource, CollisionEntityId_t queried_resource, const Edge& location,
      const Pose& queried_location) const {
    std::unordered_set<Pose> locations;

    try {
      locations = epmap_.at(fixed_resource).at(location).at(queried_resource);
    }
    catch(std::out_of_range&) {
      return false;  // No conflicts.
    }

    return locations.find(queried_location) != locations.end();
  }
  bool Query(CollisionEntityId_t fixed_resource, CollisionEntityId_t queried_resource, const Edge& location,
      const Edge& queried_location) const {
    std::unordered_set<Edge> locations;

    try {
      locations = eemap_.at(fixed_resource).at(location).at(queried_resource);
    }
    catch(std::out_of_range&) {
      return false;  // No conflicts.
    }

    return locations.find(queried_location) != locations.end();
  }

  // Public so it can be used in visualization stuff.
  // Alternatively we can cache the table and return a const reference to it.
  std::vector<std::unique_ptr<CollisionEntity>> BuildEntityTable(const GarageGraph& gg) const;

  // AHG
  const GarageGraph& GetGraph() const { return gg_; }

  static std::filesystem::path GetCacheFilePath(
      const std::string& layout_name, const std::string& layout_md5);

private:
  BoolStringPair BuildTable(const GarageGraph& gg);

  bool LoadTable();

  void SaveTable();

  // Debug table build
  const rclcpp::Logger& logger_;
  LayoutHash layout_id_;
  const GarageGraph& gg_;
  std::filesystem::path cache_file_path_;

  PosePoseMap ppmap_;
  PoseEdgeMap pemap_;
  EdgePoseMap epmap_;
  EdgeEdgeMap eemap_;
};

