<file path="include/common_ros/node.hpp">
#pragma once

#include <common/topic.hpp>
#include <common_ros/roslog.hpp>
#include <rclcpp/node.hpp>

namespace volley {

// This simplifies and reduces duplicate code for: ROS topics, ROS QoS, and ROS parameters.
// See ROS doc: https://docs.ros2.org/foxy/api/rclcpp/classrclcpp_1_1Node.html
class Node : public rclcpp::Node {
public:
  explicit Node(std::string node_name, const rclcpp::NodeOptions& options = rclcpp::NodeOptions());

  Node(std::string node_name, std::string node_namespace,
      const rclcpp::NodeOptions& options = rclcpp::NodeOptions());

  using SharedPtr = std::shared_ptr<Node>;

  template <typename T>
  T Param(const std::string& name, T default_value = T {}) {
    try {
      declare_parameter(name, rclcpp::Parameter {name, default_value}.get_type());
    }
    catch(rclcpp::exceptions::ParameterAlreadyDeclaredException&) {
      // Ignore this exception. It's fine if the parameter is already declared.
    }
    try {
      return get_parameter(name).get_value<T>();
    }
    catch(rclcpp::exceptions::ParameterUninitializedException& e) {
      WARNS(get_logger(), "Parameter " << name
                                       << " hasn't been set so using default. Are "
                                          "you missing a parameter in a launch file?");
    }
    return default_value;
  }

  template <typename MessageT, typename AllocatorT = std::allocator<void>,
      typename PublisherT = rclcpp::Publisher<MessageT, AllocatorT>>
  std::shared_ptr<PublisherT> CreatePub(const volley::Topic& topic) {
    return create_publisher<MessageT>(topic.Name(), *topic.qos_ptr());
  }

  template <typename MessageT, typename AllocatorT = std::allocator<void>,
      typename PublisherT = rclcpp::Publisher<MessageT, AllocatorT>>
  std::shared_ptr<PublisherT> CreatePub(const char* prefix, const volley::Topic& topic) {
    return create_publisher<MessageT>(std::string(prefix) + topic.Name(), *topic.qos_ptr());
  }

  // The publisher has a different QoS than all the subscribers. An unusual thing to do.
  template <typename MessageT, typename AllocatorT = std::allocator<void>,
      typename PublisherT = rclcpp::Publisher<MessageT, AllocatorT>>
  std::shared_ptr<PublisherT> CreatePub(const volley::Topic& topic, const rclcpp::QoS& qos) {
    return create_publisher<MessageT>(topic.Name(), qos);
  }

  template <typename MessageT, typename CallbackT, typename AllocatorT = std::allocator<void>,
      typename SubscriptionT = rclcpp::Subscription<MessageT, AllocatorT>>
  std::shared_ptr<SubscriptionT> CreateSub(const volley::Topic& topic, CallbackT&& callback) {
    return create_subscription<MessageT>(topic.Name(), *topic.qos_ptr(), std::forward<CallbackT>(callback));
  }

  // e.g. Subscribe to "/central/" + "report"
  template <typename MessageT, typename CallbackT, typename AllocatorT = std::allocator<void>,
      typename SubscriptionT = rclcpp::Subscription<MessageT, AllocatorT>>
  std::shared_ptr<SubscriptionT> CreateSub(
      const char* prefix, const volley::Topic& topic, CallbackT&& callback) {
    return create_subscription<MessageT>(
        std::string(prefix) + topic.Name(), *topic.qos_ptr(), std::forward<CallbackT>(callback));
  }
};

// Read a parameter that the component cannot function without. Wraps any exception thrown
// by Node::Param<T> with a clearer message that names the offending key, so the failure log
// is immediately actionable. Intended for component / node constructors where a missing or
// malformed param should abort startup rather than silently default.
template <typename T>
T RequiredParam(Node& node, const std::string& key) {
  try {
    return node.Param<T>(key);
  }
  catch(const std::exception& e) {
    throw std::runtime_error("Failed to read required param '" + key + "': " + e.what());
  }
}

// Read a parameter that has a documented default. Same exception-wrapping as RequiredParam,
// but signals at the callsite that the param is optional and what the fallback is.
template <typename T>
T OptionalParam(Node& node, const std::string& key, T default_value) {
  try {
    return node.Param<T>(key, default_value);
  }
  catch(const std::exception& e) {
    throw std::runtime_error("Failed to read optional param '" + key + "': " + e.what());
  }
}

}  // namespace volley

using NodeSPtr = std::shared_ptr<volley::Node>;

// Example:
// NodeSPtr node = std::make_shared<volley::Node>("node_name", node_options);

// Alternative:
// using namespace volley;
// NodeSPtr node = std::make_shared<Node>("node_name", node_options);
</file>

<file path="include/common_ros/polygon_utils.hpp">
#pragma once

#include <boost/geometry.hpp>
#include <common_ros/common_ros_msgs.hpp>
#include <map>

namespace volley {
class PoseGraph;
}  // namespace volley

namespace volley {
class Layout;

using Point2d = boost::geometry::model::point<double, 2, boost::geometry::cs::cartesian>;
using Polygon = boost::geometry::model::polygon<Point2d>;

// Create a rectangular polygon with the given origin, heading, and dimensions.
Polygon CreateRectangularPolygon(
    double x, double y, double heading_deg, double length_along_heading, double width);

// Create a polygon to approximate a circle.
// Circles are sized conservatively such that an ideal circle would be entirely within this polygon.
Polygon CreateCircularPolygon(double x, double y, double radius);

/*
The planner has to reason about the volumes that garage entities occupy, but does so in a discrete
manner. This method computes the information necessary for reasoning about which poses, of which
sizes, overlap with which other poses, of various sizes.

For each pose and resource size, we compute the set of poses that we can possibly intersect,
including the size buffer, and store the smallest resource size for each pose that we can
possibly intersect with.

We produce a return value that is a nested set of vectors such that retval[i][j] is the list of
overlapping sized poses for the ith pose and resource size index j. Each entry in that list is the
smallest sized pose that still overlaps with our source sized pose. The poses are in the same
ascending order as is stored in the pose graph.

Note that this procedure does not compute edge transition overlaps. Today we assume that
only knowing these pose overlaps is sufficient.

Note that, for rotation nodes, we use circular bounding polygons instead of rectangular
polygons.
*/
std::vector<std::vector<std::vector<SizedPoseMsg>>> CalcOverlappingSizedPoses(
    const volley::Layout& layout, const std::vector<GaragePoseMsg>& poses);

}  // namespace volley
</file>

<file path="include/common_ros/pose_graph.hpp">
#pragma once
#include <common_ros/common_ros_msgs.hpp>
#include <common_ros/layout.hpp>
#include <common_ros/pose_utils.hpp>
#include <map>
#include <optional>
#include <vector>

namespace volley {

/*
A PoseGraph is the data structure representing the connectivity of poses that AGVs transition
between in a garage. Each node in the tape layout has a node_id, for which multiple headings are
valid. Due to symmetry, if heading A is valid, A + 180, the "reciprocal heading", is also allowed.

The pose graph in a garage is static and unchanging.

The AGV can move forward, back, left, right, rotate left or right, and ride a VRC up or down.
As such, each pose has at most eight neighbors.

VRC_UP/VRC_DOWN are kept distinct from the four planar directions because two VRC neighbors of
the same pose share the same x/y, so a bearing-based classification would assign them to the
same planar slot and silently lose one of them (typically the downward edge).

Note that the destination pose for a right rotation and left rotation may be the same.
That occurs on a rotation node with only one valid heading + reciprocal heading.
*/
enum class PoseNeighbor : uint8_t {
  FORWARD = 0,
  RIGHT = 1,
  BACK = 2,
  LEFT = 3,
  ROT_RIGHT = 4,  // clockwise
  ROT_LEFT = 5,   // counterclockwise
  VRC_UP = 6,     // VRC transition to the next-higher floor
  VRC_DOWN = 7,   // VRC transition to the next-lower floor
};

// The index assigned to neighboring pose indices that do not exist
constexpr int kInvalidIndex = -1;

// The resource size index for an AGV
// Today, this is the same size as an empty tray.
constexpr int kResourceSizeIndexAgv = 0;

// The resource size index for an empty tray
constexpr int kResourceSizeIndexTray = 0;

// Convert a pose index to its base index in a 6*N array.
int GetBasePoseEdgeIndex(int pose_index);

class PoseGraph {
public:
  explicit PoseGraph(LayoutSPtr layout);

  // Whether the pose graph contains the given pose
  bool HasPose(const GaragePoseMsg& pose) const;

  // Return the number of nodes
  unsigned int NumNodes() const { return layout_->GetNodes().size(); }

  // Return the number of poses
  unsigned int NumPoses() const { return poses_.size(); }

  // Get the pose for the given pose index
  // NOTE: This lookup can fail if the given pose index is invalid
  //       We assume that we never try to look up an invalid pose index
  const GaragePoseMsg& GetPose(int pose_index) const;

  // Getters
  LayoutSPtr GetLayout() const { return layout_; }
  const std::vector<GaragePoseMsg>& GetPoses() const { return poses_; }

  // Get the pose index for this pose, or kInvalidIndex if it is invalid
  int GetPoseIndex(const GaragePoseMsg& pose) const;

  // Get the specified neighbor for the given pose, if it exists
  std::optional<GaragePoseMsg> GetNeighborPose(int pose_index, PoseNeighbor neighbor) const;

  // Get the specified neighbor for the given pose, if it exists
  std::optional<GaragePoseMsg> GetNeighborPose(GaragePoseMsg pose, PoseNeighbor neighbor) const;

  // Get the set of overlapping sized poses for the given pose index (which is assumed to be
  // valid or equal to kInvalidIndex), and the given resource size index. If the resource size
  // index is bad, we return an empty list.
  const std::vector<SizedPoseMsg>& GetOverlappingSizedPoses(
      int pose_index, uint8_t resource_size_index) const;

  // Each bay has one edge connecting its pose to the greater pose graph.
  // This edge will always be a LEFT action from the bay's primary pose,
  // as the system interior door is in the +y direction in the bay's primary pose.
  // This method returns the outbound pose.
  std::optional<GaragePoseMsg> GetBayOutboundPose(uint16_t bay_id) const;

private:
  // The garage layout
  LayoutSPtr layout_;

  // All poses
  // We store poses in order first by node_id, then by heading
  // A pose index is the index of the pose in this list
  std::vector<GaragePoseMsg> poses_;

  // A map of a pose to its index in poses_
  std::map<GaragePoseMsg, int, GaragePoseComparator> pose_indices_;

  // For each pose, the indices of its six potential neighbors (see PoseNeighbor)
  // These are stored in a flat array of length 6*|poses|
  // The right neighbor pose index of pose i is pose_neighbors_[6i + (int)(PoseNeighbor.RIGHT)]
  // If the index is kInvalidIndex, then that edge does not exist
  std::vector<int> pose_neighbors_;

  // For each pose and each resource size allowed on that pose, the list of smallest conflicting
  // sized poses.
  std::vector<std::vector<std::vector<SizedPoseMsg>>> overlapping_sized_poses_;
};

}  // namespace volley

using PoseGraphSPtr = std::shared_ptr<volley::PoseGraph>;
using PoseGraphCSPtr = std::shared_ptr<const volley::PoseGraph>;

// Example:
// PoseGraphCSPtr pose_graph = std::make_shared<const volley::PoseGraph>(layout_);

// Alternative:
// using namespace volley;
// PoseGraphCSPtr pose_graph = std::make_shared<const PoseGraph>(layout_);
</file>

