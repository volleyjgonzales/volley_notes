#include "common_ros/tape_layout.hpp"

#include <common/constants.hpp>

#include "common_ros/common_ros_msgs.hpp"
#include "common_ros/layout.hpp"

namespace volley {

// Length of a tape extension needed at a non-middle node [m].
constexpr double kTapeExtra = 6 * kIn2M;  // We add an extra 6 inches to each tape extension
constexpr double kTapeExtensionLong = kAgvDistToFrontLineSensor + kTapeExtra;
constexpr double kTapeExtensionShort = kAgvDistToSideLineSensor + kTapeExtra;

// Loop through a vector of segments and return a new vector of segments when two segments can be
// consolidated. Two segments can be consolidated when they share an endpoint and they are
// collinear.
std::optional<std::vector<volley::Segment>> ConsolidateOnce(std::vector<volley::Segment> segments) {
  for(unsigned int i = 0; i < segments.size(); i++) {
    for(unsigned int j = 0; j < segments.size(); j++) {
      if(i == j) {
        continue;
      }
      volley::Segment si = segments.at(i);
      volley::Segment sj = segments.at(j);

      if(si.floor == sj.floor && AreParallel(si, sj)) {
        // Segments are on the same floor and parallel. We can consolidate if they share a point
        std::optional<volley::Segment> s_union = {};
        if(volley::IsNear(si.p1, sj.p1)) {
          s_union = volley::Segment {si.p2, sj.p2, si.floor};
        }
        else if(volley::IsNear(si.p2, sj.p1)) {
          s_union = volley::Segment {si.p1, sj.p2, si.floor};
        }
        else if(volley::IsNear(si.p1, sj.p2)) {
          s_union = volley::Segment {si.p2, sj.p1, si.floor};
        }
        else if(volley::IsNear(si.p2, sj.p2)) {
          s_union = volley::Segment {si.p1, sj.p1, si.floor};
        }

        if(s_union.has_value()) {
          // Erase the two segments in question and add the consolidated one
          // Be careful about the order of erasing. We erase the larger index first so the
          // smaller index still refers to the correct element when it gets erased.
          if(i > j) {
            segments.erase(segments.begin() + i);
            segments.erase(segments.begin() + j);
          }
          else {
            segments.erase(segments.begin() + j);
            segments.erase(segments.begin() + i);
          }
          segments.emplace_back(s_union.value());
          return segments;
        }
      }
    }
  }

  // Nothing to consolidate
  return {};
}

std::vector<volley::Segment> ConsolidateSegments(std::vector<volley::Segment> segments) {
  // Loop and consolidate segments one at a time until there are no more that can be consolidated
  while(true) {
    auto s_opt = ConsolidateOnce(segments);
    if(!s_opt.has_value()) {
      // The segments list is fully consolidated
      break;
    }
    segments = s_opt.value();
  }

  return segments;
}

std::vector<volley::Segment> ComputeCircularTapeSegments(const GarageNodeMsg& node, double r) {
  std::vector<volley::Segment> segments;
  Eigen::Vector2d center {node.x, node.y};

  double d_angle = 2 * M_PI / kNumTapeSegmentsInCircle;
  for(unsigned int i = 0; i < kNumTapeSegmentsInCircle; i++) {
    volley::Angle a1 {i * d_angle};
    volley::Angle a2 {(i + 1) * d_angle};
    volley::Segment s {Eigen::Vector2d {r * std::cos(a1.value), r * std::sin(a1.value)},
        Eigen::Vector2d {r * std::cos(a2.value), r * std::sin(a2.value)}, node.floor};

    // Extend the tape by a bit in each direction to ensure the outside ends of the tape meet
    double outside_gap = kTapeWidth / 2 * std::sqrt(2 * (1 - std::cos(d_angle)));
    double tape_ext = outside_gap / 2;
    double tape_heading = std::atan2((s.p2 - s.p1).y(), (s.p2 - s.p1).x());
    s.p1.x() -= tape_ext * std::cos(tape_heading);
    s.p1.y() -= tape_ext * std::sin(tape_heading);
    s.p2.x() += tape_ext * std::cos(tape_heading);
    s.p2.y() += tape_ext * std::sin(tape_heading);

    // Set the tape segment to be around the node center
    s.p1 += center;
    s.p2 += center;
    segments.emplace_back(s);
  }

  return segments;
}

void AddExtensionNode(unsigned int base_node_index, const Eigen::Vector2d& direction,
    std::vector<GarageNodeMsg>* nodes, graph* g) {
  GarageNodeMsg base_node = nodes->at(base_node_index);

  // First, check if the extension direction is perpendicular to a valid heading for the node. If
  // it is, we use a long tape extension (AGV heading is zero out the right side of the vehicle).
  // If not, we use a short one.
  bool inline_with_heading = false;
  for(const auto& heading : base_node.headings) {
    auto [ux, uy] = volley::BodyToInertial(1, 0, kDeg2Rad * heading);
    if(volley::ArePerpendicular(direction, Eigen::Vector2d {ux, uy})) {
      inline_with_heading = true;
    }
  }
  double tape_length = inline_with_heading ? kTapeExtensionLong : kTapeExtensionShort;

  // Extension node is the base node plus the extension length in the direction of the extension
  Eigen::Vector2d node_ext {base_node.x, base_node.y};
  node_ext += direction.normalized() * tape_length;

  GarageNodeMsg node {};
  node.x = static_cast<float>(node_ext.x());
  node.y = static_cast<float>(node_ext.y());
  node.floor = base_node.floor;
  node.type = node.TYPE_UNKNOWN;

  nodes->emplace_back(node);

  // Add edge from the node index to the new node we just added to the vector
  boost::add_edge(base_node_index, nodes->size() - 1, *g);
}

std::pair<std::vector<volley::Segment>, std::vector<volley::Segment>> ComputeTapeSegments(
    const Layout& layout) {
  std::vector<GarageNodeMsg> tape_nodes =
      layout.GetNodes();  // Make a copy for iterating over the true graph nodes

  graph tape_graph = layout.GetGraph();  // Make a copy for adding new tape nodes to

  const size_t initial_node_count = tape_nodes.size();
  for(unsigned int node_index = 0; node_index < initial_node_count; ++node_index) {
    // Algorithm outline:
    //   - For each node, look at all the neighbors
    //   - For each neighbor, see if there is another neighbor of the same root node that
    //       forms an edge parallel or perpendicular to the current edge
    //   - If there is no parallel edge, add an extension opposite the current neighbor
    //   - If there is no perpendicular edge, add two extensions perpendicular to the current
    //       neighbor
    //   - If any new nodes were added, start the neighbor search again with the updated nodes
    auto neighbors = boost::adjacent_vertices(node_index, tape_graph);
    for(auto ni : make_iterator_range(neighbors)) {
      bool has_parallel_edge = false;
      bool has_perpendicular_edge = false;

      // Edge from node_index to neighbor i
      const auto& ni1 = tape_nodes.at(node_index);
      const auto& ni2 = tape_nodes.at(ni);

      // Do not add segment between lift-like nodes on different floors.
      // BLift nodes (Bay + Lift) also pair with Lift/BLift terminals across floors via VRCs.
      auto is_lift_like = [](const GarageNodeMsg& n) {
        return n.type == GarageNodeMsg::TYPE_LIFT || n.type == GarageNodeMsg::TYPE_BLIFT;
      };
      if(is_lift_like(ni1) && is_lift_like(ni2) && (ni1.floor != ni2.floor)) {
        continue;
      }

      volley::Segment ei = GetEdge(ni1, ni2);
      for(auto nj : make_iterator_range(neighbors)) {
        if(ni == nj) {
          continue;
        }

        // Edge from node_index to neighbor j
        const auto& nj1 = tape_nodes.at(node_index);
        const auto& nj2 = tape_nodes.at(nj);
        volley::Segment ej = GetEdge(nj1, nj2);
        if(AreParallel(ei, ej)) {
          has_parallel_edge = true;
        }
        if(ArePerpendicular(ei, ej)) {
          has_perpendicular_edge = true;
        }
      }

      if(!has_parallel_edge) {
        // Add an extension node in the opposite direction from this edge
        AddExtensionNode(node_index, -ei.direction, &tape_nodes, &tape_graph);
      }

      // This node has no edges perpendicular to the current edge. Add some
      if(!has_perpendicular_edge) {
        Eigen::Vector2d perp_direction = {-ei.direction.y(), ei.direction.x()};
        AddExtensionNode(node_index, perp_direction, &tape_nodes, &tape_graph);
        AddExtensionNode(node_index, -perp_direction, &tape_nodes, &tape_graph);
      }

      if(!has_perpendicular_edge || !has_parallel_edge) {
        // We added new node(s). Search this node again.
        node_index -= 1;
        break;
      }
    }
  }

  // Get the tape segments for this graph
  std::vector<volley::Segment> linear_tape_segments;
  boost::graph_traits<graph>::edge_iterator ei, ei_end;
  for(std::tie(ei, ei_end) = edges(tape_graph); ei != ei_end; ++ei) {
    auto src_node = tape_nodes[source(*ei, tape_graph)];
    auto dst_node = tape_nodes[target(*ei, tape_graph)];
    linear_tape_segments.emplace_back(GetEdge(src_node, dst_node));
  }

  // Finally, check for rotation nodes and add rotation segments
  std::vector<volley::Segment> rotation_tape_segments;
  for(const auto& node : layout.GetNodes()) {
    if(node.rotation_allowed) {
      std::vector<volley::Segment> rotation_segments =
          ComputeCircularTapeSegments(node, layout.GetTapeCircleRadius());
      rotation_tape_segments.insert(
          rotation_tape_segments.end(), rotation_segments.begin(), rotation_segments.end());
    }
  }

  return std::make_pair(linear_tape_segments, rotation_tape_segments);
}

// Note: If greater computation efficiency is desired in this algorithm, we could bootstrap the
// computation with the last segment found. If some tolerance is low enough, we would return that
// same segment again
std::optional<volley::Segment> GetClosestSegment(
    const std::vector<volley::Segment>& segments, const GeometricPoseMsg& pose, double yaw_offset) {
  double min_distance = std::numeric_limits<double>::infinity();
  Eigen::Vector2d p {pose.x, pose.y};
  std::optional<volley::Segment> closest_segment = {};

  double target_yaw = volley::Wrap(pose.yaw + yaw_offset);

  // Only find segments that are "close" to our desired yaw. We are very generous with what is
  // considered close enough.
  double angle_tolerance = 25 * kDeg2Rad;

  for(const auto& s : segments) {
    if(volley::IsNearToAngleOrReciprocal<double>(s.heading, target_yaw, angle_tolerance)) {
      double d = GetMinimumDistance(p, s);
      if(d < min_distance) {
        min_distance = d;
        closest_segment = s;
      }
    }
  }

  // If we have found a closest segment, ensure we return the segment such that the heading aligns
  // with our target yaw
  if(closest_segment.has_value() &&
      !volley::IsAngleNear(closest_segment.value().heading, target_yaw, angle_tolerance)) {
    // volley::Segment is pointing the wrong direction, return the opposite segment
    closest_segment.value() = volley::Segment {closest_segment.value().p2, closest_segment.value().p1};
  }

  return closest_segment;
}

std::vector<volley::Segment> ComputeAllConsolidatedTapeSegments(const Layout& layout) {
  auto [linear_segments, rotation_segments] = ComputeTapeSegments(layout);
  linear_segments = ConsolidateSegments(linear_segments);
  linear_segments.insert(linear_segments.end(), rotation_segments.begin(), rotation_segments.end());
  return linear_segments;
}

std::vector<volley::Segment> ComputeAllLinearConsolidatedTapeSegments(const Layout& layout) {
  return ConsolidateSegments(ComputeTapeSegments(layout).first);
}

}  // namespace volley
