#include <math.h>

#include <common/constants.hpp>
#include <common/math_utils.hpp>
#include <common_ros/agv_motion_type.hpp>
#include <common_ros/layout.hpp>

namespace volley {

// Given and source and destination node and a heading, determine if the requested move between the
// two is a LOCOMOTE or a STRAFE
std::optional<AgvMotionType> IsLocomoteOrStrafe(
    const GarageNodeMsg& src_node, const GarageNodeMsg& dst_node, double heading) {
  // If the nodes are on different floors, this cannot be a locomote or strafe
  if(src_node.floor != dst_node.floor) {
    return {};
  }

  const double edge_heading = atan2(dst_node.y - src_node.y, dst_node.x - src_node.x);
  const bool locomote = volley::IsNearToAngleOrReciprocal(edge_heading, heading + M_PI_2, 1e-3);
  const bool strafe = volley::IsNearToAngleOrReciprocal(edge_heading, heading, 1e-3);

  if(locomote + strafe != 1) {
    return {};
  }

  if(locomote) {
    return AgvMotionType::LOCOMOTE;
  }

  return AgvMotionType::STRAFE;
}

bool IsMoveType(const AgvMotionType& command_type) {
  return command_type == AgvMotionType::LOCOMOTE || command_type == AgvMotionType::STRAFE ||
         command_type == AgvMotionType::ROTATE || command_type == AgvMotionType::VRC_MOVE ||
         command_type == AgvMotionType::STOP_NOW || command_type == AgvMotionType::CENTER;
}

AgvMotionType GetMotionType(const AgvGoalMsg& src, const AgvGoalMsg& dst, const volley::Layout& layout) {
  AgvMotionType type = AgvMotionType::CENTER;

  // A valid command will be a rotation, a translation, a lift, a center, or a VRC move.
  // If it is a rotation, the node_id's and lifts must match.
  // If it is a translation, the headings and lifts must match.
  // If it is a lift, the nodes_id's and headings must match
  // If it is a center, the node_id's, headings, and lifts must match
  const bool node_ids_equal = src.pose.node_id == dst.pose.node_id;
  const bool headings_equal = src.pose.heading == dst.pose.heading;
  const bool lifts_equal = src.lift == dst.lift;

  // Two or more of these things must be equal
  if(node_ids_equal + headings_equal + lifts_equal < 2) {
    throw std::invalid_argument {
        "GetMotionType() Must be a rotation, translation, lift, center, or VRC move"};
  }

  // First, handle types that don't always require known poses
  if(node_ids_equal && headings_equal) {
    type = AgvMotionType::LIFT;
    if(lifts_equal) {
      type = AgvMotionType::CENTER;
    }
    // If both poses are uninitialized, we can't and don't need to assign any more variables
    if(src.pose == GaragePoseMsg {} && dst.pose == GaragePoseMsg {}) {
      return type;
    }
  }

  // We know the nodes are valid because the poses exist
  GarageNodeMsg src_node = layout.GetNodeById(src.pose.node_id).value();
  GarageNodeMsg dst_node = layout.GetNodeById(dst.pose.node_id).value();

  if(headings_equal && lifts_equal && !node_ids_equal) {
    if(src_node.floor != dst_node.floor) {
      return AgvMotionType::VRC_MOVE;
    }
    if(!layout.HasEdge(src.pose.node_id, dst.pose.node_id)) {
      throw std::invalid_argument {"GetMotionType() Edge does not exist"};
    }

    auto command_type_opt = IsLocomoteOrStrafe(src_node, dst_node, src.pose.heading * kDeg2Rad);
    if(!command_type_opt.has_value()) {
      throw std::invalid_argument {"GetMotionType() Edge traversal is not perpendicular to where we are."};
    }
    type = command_type_opt.value();
  }
  else if(node_ids_equal && lifts_equal && !headings_equal) {
    type = AgvMotionType::ROTATE;
    if(!src_node.rotation_allowed) {
      throw std::invalid_argument {"GetMotionType() Rotation requested on a non-rotation node!"};
    }
  }
  return type;
}

AgvMotionType GetMotionType(const AgvCommandMsg& command, const Layout& layout) {
  return GetMotionType(command.src, command.dst, layout);
}

const char* AgvMotionTypeStr(const AgvMotionType& type) {
  switch(type) {
  case AgvMotionType::CENTER:
    return "CENTER";
  case AgvMotionType::LOCOMOTE:
    return "LOCOMOTE";
  case AgvMotionType::STRAFE:
    return "STRAFE";
  case AgvMotionType::ROTATE:
    return "ROTATE";
  case AgvMotionType::LIFT:
    return "LIFT";
  case AgvMotionType::VRC_MOVE:
    return "VRC_MOVE";
  case AgvMotionType::STOP_NOW:
    return "STOP_NOW";
  case AgvMotionType::STOP_AT_NEXT_POSE:
    return "STOP_AT_NEXT_POSE";
  }
  return "UNKNOWN";
}

