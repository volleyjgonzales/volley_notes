void from_string(const std::string& str, CollisionTable::Pose& pose) {
  // "39@-90"
  uint32_t node_id = 0;
  int32_t heading = 0;
  sscanf(str.c_str(), "%u@%d", &node_id, &heading);
  pose.node_id = node_id;
  pose.heading = heading;
}

void from_string(const std::string& str, CollisionTable::Edge& edge) {
  // "(10@0,11@0)"
  uint32_t node_id0 = 0;
  int32_t heading0 = 0;
  uint32_t node_id1 = 0;
  int32_t heading1 = 0;
  sscanf(str.c_str(), "(%u@%d,%u@%d)", &node_id0, &heading0, &node_id1, &heading1);
  edge[0].node_id = node_id0;
  edge[0].heading = heading0;
  edge[1].node_id = node_id1;
  edge[1].heading = heading1;
}

// Serialization for GaragePose
void to_json(json& j, const GaragePoseMsg& pose) {
  j = json {{"node_id", pose.node_id}, {"heading", pose.heading}};
}

void from_json(const json& j, GaragePoseMsg& pose) {
  j.at("node_id").get_to(pose.node_id);
  j.at("heading").get_to(pose.heading);
}

// Serialization for Edge (std::array<Pose, 2>)
void to_json(json& j, const CollisionTable::Edge& edge) {
  json r;
  to_json(r[0], edge[0]);
  to_json(r[1], edge[1]);
  j = r;
}

void from_json(const json& j, CollisionTable::Edge& edge) {
  from_json(j.at(0), edge[0]);
  from_json(j.at(1), edge[1]);
}

void to_json(json& j, const CollisionTable::PoseSet& pset) {
  json a;
  for(const auto& p : pset) {
    json i;
    to_json(i, p);
    a.push_back(i);
  }
  j = a;
}

void to_json(json& j, const CollisionTable::EdgeSet& eset) {
  json a;
  for(const auto& e : eset) {
    json i;
    to_json(i, e);
    a.push_back(i);
  }
  j = a;
}

void from_json(const json& j, CollisionTable::PoseSet& pset) {
  for(const auto& jval : j) {
    CollisionTable::Pose pose;
    from_json(jval, pose);
    pset.emplace(pose);
  }
}

void from_json(const json& j, CollisionTable::EdgeSet& eset) {
  for(const auto& jval : j) {
    CollisionTable::Edge edge;
    from_json(jval, edge);
    eset.emplace(edge);
  }
}

// Serialization for ResMap
template <typename FixedState, typename QueriedState>
void to_json(json& j, const CollisionTable::ResMap<FixedState, QueriedState>& res_map) {
  for(const auto& [size_t_key, fixed_map] : res_map) {
    json fixed_json;
    for(const auto& [fixed_state, queried_map] : fixed_map) {
      json queried_json;
      for(const auto& [inner_key, queried_set] : queried_map) {
        json jqs;
        to_json(jqs, queried_set);
        queried_json[std::to_string(inner_key)] = jqs;
      }
      std::string fskey = std::to_string(fixed_state);
      fixed_json[fskey] = queried_json;
    }
    std::string sizekey = std::to_string(size_t_key);
    j[sizekey] = fixed_json;
  }
}

template <typename FixedState, typename QueriedState>
void from_json(const json& j, CollisionTable::ResMap<FixedState, QueriedState>& res_map) {
  for(const auto& [size_t_key, fixed_json] : j.items()) {
    size_t outer_key = std::stoull(size_t_key);
    typename CollisionTable::ResMap<FixedState, QueriedState>::mapped_type fixed_map;
    for(const auto& [jkey, fixed_item] : fixed_json.items()) {
      FixedState fixed_key;
      from_string(jkey, fixed_key);
      std::unordered_map<size_t, std::unordered_set<QueriedState>> queried_map;
      for(const auto& [jfi, queried] : fixed_item.items()) {
        size_t inner_key = std::stoull(jfi);
        std::unordered_set<QueriedState> queried_set;
        from_json(queried, queried_set);
        queried_map[inner_key] = queried_set;
      }
      fixed_map[fixed_key] = queried_map;
    }
    res_map[outer_key] = fixed_map;
  }
}
