template <>
struct std::hash<std::array<GaragePoseMsg, 2>> {
  size_t operator()(const std::array<GaragePoseMsg, 2>& edge) const {
    size_t result = 0;

    for(const auto& pose : edge) {
      boost::hash_combine(result, std::hash<GaragePoseMsg>()(pose));
    }
    return result;
  }
};

