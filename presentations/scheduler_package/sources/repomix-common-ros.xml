#include <common_ros/discrete_garage_state_utils.hpp>

namespace volley {

bool IsTrayAvailable(const DiscreteTrayStateMsg& tray, const std::set<uint32_t>& disabled_nodes) {
  // A tray only counts as available if it has no payload, is not carried by an AGV, is enabled
  // and is on an enabled node
  bool empty = tray.payload_id == volley::kEmptyGuid;
  bool node_disabled = disabled_nodes.find(tray.pose.node_id) != disabled_nodes.end();
  bool lifted_by_agv = tray.agv_id != 0;
  return (empty && !(node_disabled || tray.disabled || lifted_by_agv));
}

std::vector<DiscreteTrayStateMsg> GetEmptyTrays(const DiscreteGarageState& state) {
  std::vector<DiscreteTrayStateMsg> empty_trays;
  for(const auto& [_, tray] : state.GetTrays()) {
    if(IsTrayAvailable(tray, state.GetDisabledNodes())) {
      empty_trays.push_back(tray);
    }
  }

  return empty_trays;
}

unsigned int CountEmptyTrays(const DiscreteGarageState& state) {
  unsigned int n_empty_trays = 0;
  const std::set<uint32_t>& disabled_nodes = state.GetDisabledNodes();
  for(const auto& [_, tray] : state.GetTrays()) {
    n_empty_trays += IsTrayAvailable(tray, disabled_nodes);
  }

  return n_empty_trays;
}

CollisionEntityId_t CollisionEntityIdFromPayloadState(
    const DiscretePayloadStateMsg& payload_state, const Layout& layout) {
  // Get the appropriate resource size for the payload. Note that we assume
  // the payload fits in some resource size window; will cause a bad optional
  // access error if not.
  CollisionEntityId_t collision_id =
      common::EnumInteger(CollisionEntityId::PAYLOAD) +
      layout
          .GetSmallestEnclosingResourceSizeIndex(
              payload_state.payload.length_m, payload_state.payload.width_m, payload_state.payload.height_m)
          .value();
  return collision_id;
}

CollisionEntityId_t CollisionEntityIdFromTrayState(
    const DiscreteTrayStateMsg& tray_state, const DiscreteGarageState& dgs, const Layout& layout) {
  // We assume that the tray exists in the dgs.
  // Start with a tray
  CollisionEntityId_t collision_id = common::EnumInteger(CollisionEntityId::TRAY);
  if(tray_state.payload_id != kEmptyGuid) {
    // It has a payload, so get the appropriate resource size for it. Note
    // that the ...FromPayloadState() function assumes the payload fits in
    // some resource size window in the layout and will cause a bad optional
    // access error if not.
    auto payload = dgs.GetPayload(tray_state.payload_id).value();
    collision_id = CollisionEntityIdFromPayloadState(payload, layout);
  }
  return collision_id;
}

CollisionEntityId_t CollisionEntityIdFromAgvState(
    const DiscreteAgvStateMsg& agv_state, const DiscreteGarageState& dgs, const Layout& layout) {
  CollisionEntityId_t collision_id = common::EnumInteger(CollisionEntityId::AGV);
  // We assume that the AGV exists in the dgs.
  auto tray_opt = dgs.GetTray(agv_state.tray_id);
  if(tray_opt.has_value()) {
    // Note that if the tray has a payload, we assume that the payload fits
    // in some resource size window in the layout. Will cause a bad
    // optional access error if not.
    collision_id = CollisionEntityIdFromTrayState(tray_opt.value(), dgs, layout);
  }
  return collision_id;
}

}  // namespace volley
