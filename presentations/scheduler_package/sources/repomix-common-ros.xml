#pragma once
#include <common/types.hpp>
#include <optional>

#include "common_ros/collision_geometry.hpp"
#include "common_ros/common_ros_msgs.hpp"
#include "common_ros/discrete_garage_state.hpp"
#include "common_ros/discrete_garage_state_utils.hpp"
#include "common_ros/garage_graph.hpp"
#include "common_ros/garage_occupancy_checker.hpp"

namespace volley {

class GarageSafetyChecker {
public:
  GarageSafetyChecker(const CollisionTable& collision_table, const GarageGraph& gg) :
      collision_table_(collision_table), gg_(gg), safety_checker_(collision_table, gg) { }

  BoolStringPair OnEvent(const DiscreteGarageEventMsg& event, const DiscreteGarageState& state);
  BoolStringPair Set(const DiscreteGarageState& state);
  void Reset();

  BoolStringPair IsSafe(const ActionNodeMsg& node, const DiscreteGarageState& state) const;
  BoolStringPair Apply(const ActionNodeMsg& node, const DiscreteGarageState& state);
  BoolStringPair CompleteAction(const ActionNodeMsg& node, const DiscreteGarageState& state);

  // Subset of DiscreteGarageEvents that are relevant for safety checking
  BoolStringPair OnEvent(const AgvExistenceChangedMsg& event, const DiscreteGarageState& state);
  BoolStringPair OnEvent(const AgvLiftChangedMsg& event, const DiscreteGarageState& state);
  BoolStringPair OnEvent(const AgvPoseChangedMsg& event, const DiscreteGarageState& state);
  BoolStringPair OnEvent(const BayExistenceChangedMsg& event, const DiscreteGarageState& state);
  BoolStringPair OnEvent(const BayStateChangedMsg& event, const DiscreteGarageState& state);
  BoolStringPair OnEvent(const TrayExistenceChangedMsg& event, const DiscreteGarageState& state);
  BoolStringPair OnEvent(const TrayPoseSetManuallyMsg& event, const DiscreteGarageState& state);
  BoolStringPair OnEvent(const PayloadExistenceChangedMsg& event, const DiscreteGarageState& state);

  const GarageGraph& GetGarageGraph() { return gg_; }

private:
  const CollisionTable& collision_table_;
  const GarageGraph& gg_;
  using BlockingEntity = std::pair<GarageEntityIdMsg, ActionNodeMsg>;

  class BlockingEntityEqual {
  public:
    bool operator()(const BlockingEntity& a, const BlockingEntity& b) const {
      // Only compare a subset of ActionNode fields because the status can be changed while the node is still
      // equal
      return a.first == b.first && a.second.guid == b.second.guid && a.second.job_id == b.second.job_id;
    }
  };

  class BlockingEntityHash {
  public:
    std::size_t operator()(const BlockingEntity& entity) const {
      return std::hash<GarageEntityIdMsg> {}(entity.first) ^ std::hash<GuidMsg> {}(entity.second.guid);
    }
  };

  GarageOccupancyChecker<BlockingEntity, BlockingEntityEqual, BlockingEntityHash> safety_checker_;

  std::string BlockerToString(const BlockingEntity& blocker) const;

  std::optional<CollisionTable::PoseOrEdge> GetLocationFromActionNode(const ActionNodeMsg& node) const {
    // Currently we only return a location for AGV and BAY commands and intentially skip actions related to
    // VRC and VECS. This is because the VRC occupancy is not considered in our scheduler/motion planner (may
    // change in the future) and the VECS does not occupy any physical space/cause collisions.
    switch(node.type) {
    case ActionNodeMsg::TYPE_AGV_COMMAND: {
      auto command_msg = node.agv_command;
      if(command_msg.src.pose == command_msg.dst.pose) {
        return command_msg.src.pose;
      }
      return CollisionTable::Edge {command_msg.src.pose, command_msg.dst.pose};
    }
    case ActionNodeMsg::TYPE_BAY_COMMAND: {
      return ConstructGaragePose(
          node.bay_id, static_cast<int16_t>(gg_.GetLayout()->GetBayInboundHeading(node.bay_id).value()));
    }
    }

    return {};
  }

  GarageEntityIdMsg GetEntityIdFromActionNode(const ActionNodeMsg& node) const {
    switch(node.type) {
    case ActionNodeMsg::TYPE_AGV_COMMAND:
      return volley::AgvId(node.agv_id);
    case ActionNodeMsg::TYPE_BAY_COMMAND:
      return volley::BayId(node.bay_id);
    case ActionNodeMsg::TYPE_VECS_COMMAND:
      return volley::VecsId(node.vecs_id);
    default:
      return GarageEntityIdMsg {};
    }
  }

  CollisionEntityId_t GetCollisionEntityIdFromActionNode(
      const ActionNodeMsg& node, const DiscreteGarageState& state) const {
    switch(node.type) {
    case ActionNodeMsg::TYPE_AGV_COMMAND:

      if(node.agv_command.src.pose == node.agv_command.dst.pose) {
        return static_cast<CollisionEntityId_t>(CollisionEntityId::AGV);
      }

      return CollisionEntityIdFromAgvState(state.GetAgv(node.agv_id).value(), state, *(gg_.GetLayout()));
    case ActionNodeMsg::TYPE_BAY_COMMAND:
      return static_cast<CollisionEntityId_t>(CollisionEntityId::BAY_ODP);
    // TODO(someone) handle vecs command here
    default:
      // TODO(Gunther): Real error
      return CollisionEntityId_t {99u};
    }
  }

  BoolStringPair ApplyIfSafeOrSelf(const CollisionTable::PoseOrEdge& location,
      CollisionEntityId_t collision_id, const BlockingEntity& entity, bool is_lifted);

  friend std::ostream& operator<<(std::ostream& os, const GarageSafetyChecker::BlockingEntity& entity);
};

std::ostream& operator<<(std::ostream& os, const GarageSafetyChecker::BlockingEntity& entity);

}  // namespace volley
</file>

<file path="include/common_ros/geometry_visualization.hpp">
#pragma once
#include <common_ros/collision_geometry.hpp>

namespace volley {

extern const std::string kEdgeStyle;
extern const std::string kPoseStyle;

// Generates the base layout stuff. This should live in anon namespace in cpp file
// but the templated DrawQuery depends on it. Gross.
std::string GenerateLayoutPlot(const volley::GarageGraph& gg, std::ostream& gnuplot_stream);

// Draws the Layout returning the gnuplot script generated.
std::string DrawLayout(const GarageGraph& gg);

void DrawRootLocation(std::ostream& gnuplot_script, const std::unique_ptr<CollisionEntity>& entity,
    const CollisionTable::Pose& location);
void DrawRootLocation(std::ostream& gnuplot_script, const std::unique_ptr<CollisionEntity>& entity,
    const CollisionTable::Edge& location);

// Draws the output of a singular collision table query.
template <typename T>
// NOLINTNEXTLINE(google-runtime-references)
std::string DrawQuery(
    const GarageGraph& gg, CollisionTable& table, size_t fixed, size_t queried, const T& location) {
  auto entity_table = table.BuildEntityTable(gg);
  auto [poses, edges] = table.Query(fixed, queried, location);
  LayoutSPtr layout = gg.GetLayout();
  std::string query_as_string = ResourceName(*layout, fixed) + "_at_" + std::to_string(location) +
                                "_collides_with_" + ResourceName(*layout, queried);

  std::string gnuplot_script_fname =
      "/tmp/" + gg.GetLayout()->GetName() + "_" + query_as_string + "_gnuplot.in";
  std::ofstream gnuplot_script(gnuplot_script_fname);

  gnuplot_script << "set title '" << gg.GetLayout()->GetName() << "' noenhanced" << std::endl;
  gnuplot_script << "set output '" << layout->GetName() + "_" + query_as_string << ".pdf'" << std::endl;

  auto layout_data = GenerateLayoutPlot(gg, gnuplot_script);

  // TODO(Gunther): Generic PolyAtLocation option in CollisionEntity
  DrawRootLocation(gnuplot_script, entity_table[fixed], location);

  for(auto edge : edges) {
    entity_table[queried]->PolyAtEdge(edge[0], edge[1]).AddToGnuPlot(gnuplot_script, kEdgeStyle);
  }
  for(auto pose : poses) {
    entity_table[queried]->PolyAtPose(pose).AddToGnuPlot(gnuplot_script, kPoseStyle);
  }
  gnuplot_script << "plot " << layout_data << std::endl;
  gnuplot_script.close();
  return gnuplot_script_fname;
}
}  // namespace volley
</file>

<file path="include/common_ros/layout.hpp">
#pragma once

#include <boost/graph/adjacency_list.hpp>
#include <boost/graph/graphviz.hpp>
#include <common/geometry_utils.hpp>
#include <cstdint>
#include <filesystem>
#include <interfaces/msg/garage_node.hpp>
#include <map>
#include <memory>
#include <optional>
#include <stdx/expected.hpp>
#include <vector>

#include "common_ros/common_ros_msgs.hpp"
#include "common_ros/pose_utils.hpp"

// Forward declaration of YAML library so that only the
// common_ros lib needs to link against yaml-cpp

// NOLINTNEXTLINE(readability-identifier-naming)
namespace YAML {
class Node;
};

namespace volley {

// https://www.boost.org/doc/libs/1_84_0/libs/graph/doc/adjacency_list.html
using graph = boost::adjacency_list<boost::listS, boost::vecS, boost::undirectedS>;

// Get the inbound heading for the given node.
// Charge and bay nodes are expected to only have a single valid heading in [0,179] in their
// layout files. We have to use `faces_reciprocal` to determine which reflection of this
// heading is the correct one. For a bay node, this is the heading that a payload facing into
// the garage interior will have on insert. For a charge node, this is the heading that an AGV
// must have when charging.
// Note: We do not check the node type.
// If faces_reciprocal is false, an AGV with that heading has a +y axis facing the system
// interior door.
// If faces_reciprocal is true, an AGV with that heading has a +y axis facing the
// patron access door.
int GetInboundHeading(const GarageNodeMsg& node);

// Given two nodes, return the edge between them as a line segment
volley::Segment GetEdge(const GarageNodeMsg& n1, const GarageNodeMsg& n2);

// A structure representing a vertical reciprocating conveyor (i.e. VRC) in the site layout
struct Vrc {
  uint32_t id;
  uint32_t root_node_id;
  std::vector<interfaces::msg::GarageNode> nodes;
};

class Layout {
public:
  explicit Layout(const std::filesystem::path& file);
  explicit Layout(YAML::Node layout_yaml);

  // Whether the layout has a node of the given id
  bool HasNode(uint32_t node_id) const;

  // Whether the given node_id and heading is valid.
  bool HasGaragePose(const GaragePoseMsg& pose) const;

  // Whether the layout has an edge between the src and dst node ids.
  bool HasEdge(uint32_t src, uint32_t dst) const;

  // If the given edge exists and has a disallowed edge orientation, return it.
  // Note that this disallowed orientation will be in the range [0,180), and applies to both
  // its heading and its reciprocal.
  std::optional<uint16_t> GetDisallowedEdgeOrientation(uint32_t src, uint32_t dst) const;

  const std::vector<uint16_t>& GetBayPrioritization() const { return bay_prioritization_; }

  std::optional<uint8_t> GetBayInsertFloor(uint16_t bay_id) const;
  std::optional<std::vector<uint8_t>> GetBaySystemFloors(uint16_t bay_id) const;

  // If the edge from src to dst (considering headings) could end up in a bay without changing
  // directions (i.e. this edge is collinear with a bay edge), return the current L2 distance to
  // the closest such bay. Otherwise, return null. Also return true if the edge from src to dst is
  // pointing towards that bay.
  // Note that dst can be any node and not necessarily a bay.
  std::optional<std::pair<double, bool>> GetDistanceToClosestValidBay(
      const GaragePoseMsg& src, const GaragePoseMsg& dst, const GeometricPoseMsg& pose) const;

  // Whether the layout has a straight line in SO2 between poses p1, p2, and p3. Thus, in SO2, a
  // "straight line" also includes rotations that can be stitched together (0 to 90, then 90 to
  // 180, for instance).
  bool IsStraightLine(const GaragePoseMsg& p1, const GaragePoseMsg& p2, const GaragePoseMsg& p3) const;

  // Obtain the md5sum of the loaded layout file.
  const std::string& GetMD5Sum() const { return md5sum_; }

  // Return a vector of nodes, in ascending order by node id.
  const std::vector<GarageNodeMsg>& GetNodes() const { return nodes_; }

  // Get the ids of all nodes that have the given node type.
  const std::vector<uint32_t>& GetNodeIdsOfType(GarageNodeMsg::_type_type node_type) const;

  // Get the ids of all nodes that act as bays (TYPE_BAY plus TYPE_BLIFT).
  // BLift nodes carry the same bay-setup metadata (insert_floor, system_floors,
  // prioritization) and need bay state machines, collision bodies, etc.
  std::vector<uint32_t> GetBayLikeNodeIds() const;

  std::optional<GarageNodeMsg> GetNodeById(uint32_t node_id) const;

  const std::vector<GarageFloorMsg> GetFloors() const { return floors_; }
  std::optional<GarageFloorMsg> GetFloorById(uint32_t floor_id) const;
  std::optional<GarageFloorMsg> GetFloorForNode(const GarageNodeMsg& node) const {
    return GetFloorById(node.floor);
  }
  /// @return The floor containing the node with @p node_id, or `std::nullopt` if the node is unknown.
  std::optional<GarageFloorMsg> GetFloorByNodeId(uint32_t node_id) const {
    const auto node = GetNodeById(node_id);
    if(!node.has_value()) {
      return {};
    }
    return GetFloorForNode(node.value());
  }

  std::optional<float> GetFloorZForNodeId(const uint32_t node_id) const;
  std::optional<float> GetFloorZForFloorId(const uint32_t floor_id) const;

  const std::vector<ParkingWindowMsg>& GetResourceWindows() const { return resource_windows_; }

  // TODO(Gunther): This shouldn't be a signed int
  std::optional<ParkingWindowMsg> GetResourceWindow(int resource_size_index) const;
  std::optional<ParkingWindowMsg> GetResourceWindow(const std::string& name) const;

  // Same as GetResourceWindow, but additionally apply our size buffer to the returned window.
  std::optional<ParkingWindowMsg> GetBufferedResourceWindow(int resource_size_index) const;
  std::optional<ParkingWindowMsg> GetBufferedResourceWindow(const std::string& name) const;

  const graph& GetGraph() const { return graph_; }

  // Get the neighboring nodes
  std::vector<GarageNodeMsg> GetNeighboringNodes(uint32_t node_id) const;

  // Given a garage pose, return the geometric pose that this pose corresponds to (if it exists).
  std::optional<GeometricPoseMsg> GetGeometricPoseAtPose(const GaragePoseMsg& garage_pose) const;

  // If we are close enough to a node, and close enough to one of its headings,
  // return the corresponding garage pose.
  // NOTE - this is inefficient as we iterate over all nodes every time.
  std::optional<GaragePoseMsg> GetPoseAtGeometricPose(const GeometricPoseMsg& geometric_pose,
      const GeometricPoseMsg& tolerance = GetDefaultPoseTolerance()) const;

  // Given a previous garage pose and a current geometric pose, find the garage pose that we are
  // closest to provided that the pose is a neighbor of the pose provided. We do not enforce the
  // same constraints that the controller might enforce. For instance, the returned garage pose
  // may contain both a different node and a different heading from the last pose provided.
  std::optional<GaragePoseMsg> GetClosestNeighboringPose(
      const GaragePoseMsg& last_pose, const GeometricPoseMsg& current_geometry_pose) const;

  // Get the index of the smallest resource size index that contains a resource with the given
  // dimensions, or kInvalidIndex if none exists. `height` defaults to 0 (sentinel: "unconstrained")
  // and a window with `height_m == 0` is also treated as unconstrained — these together preserve
  // legacy behavior for layouts that don't specify per-window heights.
  std::optional<int> GetSmallestEnclosingResourceSizeIndex(
      double length, double width, double height = 0.0) const;

  // If the bay_id exists, returns the inbound heading of that bay. See GetInboundHeading.
  std::optional<int> GetBayInboundHeading(uint32_t bay_id) const;

  GarageLayoutMsg GetGarageLayout() const;

  double GetTapeCircleRadius() const { return tape_circle_radius_; }

  const std::string& GetName() const { return name_; }

  std::optional<Vrc> GetVrc(const uint32_t vrc_id) const;
  std::vector<Vrc> GetVrcs() const;

  std::optional<Vrc> GetVrcForNodeId(const uint32_t node_id) const;

  /// @return True if the given @p node_id is a member of a VRC, false otherwise.
  bool IsVrcNode(uint32_t node_id) const;

  /// @return All GarageFloor entries for the given @p node_id , or an empty vector if the node is not in any
  /// VRC.
  std::vector<GarageFloorMsg> GetFloorsForVrcNode(uint32_t node_id) const;

  /// @return The root GarageNode of the given @p node_id , or nullopt if not a VRC typed node.
  std::optional<GarageNodeMsg> GetRootNodeForVrcNode(uint32_t node_id) const;

private:
  // Get the node that is closest to the given point among the list of possible nodes.
  // Returns nullopt if no node is within an L2-distance given by tolerance.
  std::optional<GarageNodeMsg> GetClosestNode(float x, float y,
      const std::vector<GarageNodeMsg>& possible_nodes,
      float tolerance = std::numeric_limits<float>::infinity()) const;

  // The layout name
  std::string name_;

  // The md5sum of the layout file when it was opened
  std::string md5sum_;

  // The radius of the tape circles used in this layout. Defaults to the value in
  // kDefaultTapeCircleRadius in case the layout doesn't need to specify it.
  double tape_circle_radius_ = kDefaultTapeCircleRadius;

  // The node graph
  graph graph_;

  // List of nodes, in ascending order by node_id
  std::vector<GarageNodeMsg> nodes_;

  // Map of node id to its index in nodes_
  std::map<uint32_t, uint32_t> node_id_to_index_;

  // Map of node type (see GarageNode.TYPE_*) to the ids of the nodes with that type
  std::map<GarageNodeMsg::_type_type, std::vector<uint32_t>> node_ids_by_type_;

  // List of floors, in arbitrary order
  std::vector<GarageFloorMsg> floors_;

  // Map of floor id to its index in the list of floors
  std::map<uint8_t, uint32_t> floor_id_to_index_;

  // The parking window buffer
  ParkingWindowMsg parking_window_buffer_;

  // The parking windows, in increasing order.
  // Note that we automatically include a "TRAY" parking window at the nominal tray size.
  std::vector<ParkingWindowMsg> resource_windows_;

  // Map of parking window name to its index in parking_windows_.
  std::map<std::string, uint32_t> resource_name_to_index_;

  // Set of disallowed edge orientations, stored as a map of edge -> heading.
  std::map<std::pair<uint32_t, uint32_t>, int16_t> disallowed_edge_orientations_;

  // List of Bay IDs that denotes state preference. First bay in the vector is most
  // preferred to be in Ready for Insert, last bay is most preferred to be in
  // Ready for Retrieve.
  std::vector<uint16_t> bay_prioritization_;

  std::unordered_map<uint16_t, uint8_t> bay_insert_floors_;
  std::unordered_map<uint16_t, std::vector<uint8_t>> bay_system_floors_;

  std::unordered_map<uint32_t, Vrc> vrcs_;
};

