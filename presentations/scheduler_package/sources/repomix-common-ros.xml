class TrayEntity : public CollisionEntity {
public:
  explicit TrayEntity(LayoutSPtr layout) :
      CollisionEntity(common::EnumInteger(CollisionEntityId::TRAY), layout) {
    CalculateBoundingRadius();
  }

private:
  ComparableGeometry BasePoly() const override { return RectangleFromSize(kTrayLength, kTrayWidth); }

  void CalculateBoundingRadius() {
    // Bounding radius is the distance from the center to the corner of the tray
    SetBoundingRadius(volley::CalculateSquareRadius(kTrayLength, kTrayWidth));
  }
};

