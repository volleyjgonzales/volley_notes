BoolStringPair DiscreteGarageState::OnEvent(const FaultStateChangedMsg& event) {
  if(is_faulted_ == event.faulted) {
    return FailedEvent("Garage is already faulted");
  }

  is_faulted_ = event.faulted;
  return SucceededEvent();
}

BoolStringPair DiscreteGarageState::OnEvent(const AgvExistenceChangedMsg& event) {
  if(event.added) {
    // AGV Added

    // The AGV id must be positive
    if(event.agv_id == 0) {
      return FailedEvent("AGV id must be positive");
    }

    // Ensure that the AGV does not already exist
    if(HasAgv(event.agv_id)) {
      return FailedEvent("AGV " + std::to_string(event.agv_id) + " already exists");
    }

    // If the AGV has a tray id, it must be lifted and the tray must exist.
    // Also verify that the AGV and tray are parallel, on the same node.
    if(event.tray_id != 0) {
      if(!event.lift) {
        return FailedEvent("a" + std::to_string(event.agv_id) + " has t" + std::to_string(event.tray_id) +
                           " but is lowered");
      }
      else if(!HasTray(event.tray_id)) {
        return FailedEvent("a" + std::to_string(event.agv_id) + " has t" + std::to_string(event.tray_id) +
                           " but it does not exist");
      }

      auto& tray = trays_[event.tray_id];
      GaragePoseMsg agv_pose;
      agv_pose.node_id = event.node_id;
      agv_pose.heading = event.heading;
      if(!IsAngleOrReciprocal(agv_pose, tray.pose)) {
        return FailedEvent("a" + std::to_string(event.agv_id) + " has an incompatible pose wrt tray " +
                           std::to_string(event.tray_id));
      }

      // Place the tray on the AGV
      tray.agv_id = event.agv_id;
    }

    // Add the AGV
    // Note that we do not check for pose validity, intersection with other agents, etc.
    // We ensure that we modify the local version so that when we zero the memory, we are
    // zeroing out what actually is stored.
    DiscreteAgvStateMsg empty_agv;
    agvs_.emplace(event.agv_id, empty_agv);
    DiscreteAgvStateMsg& agv = agvs_[event.agv_id];

    // Clear all bytes to zero, including padding bytes.
    // This is to ensure correct hashing in Hash.
    // NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast)
    auto memory = reinterpret_cast<uint8_t*>(&agv);
    std::memset(memory, 0x00, sizeof(agv));

    agv.id = event.agv_id;
    agv.state = event.state;
    agv.pose.node_id = event.node_id;
    agv.pose.heading = static_cast<int16_t>(volley::Wrap(event.heading));
    agv.lift = event.lift;
    agv.tray_id = event.tray_id;
    agv.disabled = event.disabled;

    return SucceededEvent();
  }
  else {
    // AGV Removed

    // Ensure that the AGV exists
    if(!HasAgv(event.agv_id)) {
      return FailedEvent("a" + std::to_string(event.agv_id) + " not found");
    }

    // Ensure that the event information matches the AGV state information.
    auto& agv = agvs_[event.agv_id];
    if(agv.state != event.state || agv.pose.node_id != event.node_id || agv.pose.heading != event.heading ||
        agv.lift != event.lift || agv.tray_id != event.tray_id || agv.disabled != event.disabled) {
      return FailedEvent(
          "a" + std::to_string(event.agv_id) +
          " removal event did not match its state: " + (agv.state != event.state ? " state " : "") +
          (agv.pose.node_id != event.node_id ? " node_id " : "") +
          (agv.pose.heading != event.heading ? " heading " : "") + (agv.lift != event.lift ? " lift " : "") +
          (agv.tray_id != event.tray_id ? " tray_id " : "") +
          (agv.disabled != event.disabled ? " disabled" : ""));
    }

    // Remove the AGV
    if(agvs_.erase(event.agv_id) != 1) {
      return FailedEvent("Failed to erase a" + std::to_string(event.agv_id));
    }

    // If the AGV had a tray id, lower it.
    if(event.tray_id != 0) {
      trays_[event.tray_id].agv_id = 0;
    }

    return SucceededEvent();
  }
}

BoolStringPair DiscreteGarageState::OnEvent(const AgvDisablednessChangedMsg& event) {
  // Ensure that the AGV exists
  if(!HasAgv(event.agv_id)) {
    return FailedEvent("a" + std::to_string(event.agv_id) + " not found");
  }

  // Ensure that the AGV was in the opposite state prior to this event
  auto& agv = agvs_[event.agv_id];
  if(agv.disabled == event.disable) {
    return FailedEvent("a" + std::to_string(event.agv_id) + " already has desired disabledness");
  }

  agv.disabled = event.disable;
  return SucceededEvent();
}

BoolStringPair DiscreteGarageState::OnEvent(const AgvLiftChangedMsg& event) {
  // Ensure that the AGV exists
  if(!HasAgv(event.agv_id)) {
    return FailedEvent("a" + std::to_string(event.agv_id) + " not found");
  }

  // Ensure that the AGV had the correct lift state prior to this event
  auto& agv = agvs_[event.agv_id];
  if(agv.lift == event.raised) {
    return FailedEvent("a" + std::to_string(event.agv_id) + " already has target lift state");
  }

  // Handle the tray based on whether we are raising or lowering
  if(event.raised) {
    // If there is a tray over the AGV, attach it.
    for(auto& [tray_id, tray] : trays_) {
      if(tray.pose.node_id == agv.pose.node_id) {
        if(!volley::IsAngleOrReciprocal(tray.pose.heading, agv.pose.heading)) {
          return FailedEvent("a" + std::to_string(event.agv_id) +
                             " raised under a tray that is not parallel with it! " +
                             std::to_string(agv.pose.heading) + " vs. " + std::to_string(tray.pose.heading));
        }

        // attach it
        tray.agv_id = agv.id;
        agv.tray_id = tray_id;
      }
    }
  }
  else {  // lowering
    // If there is a tray on the AGV, drop it.
    if(agv.tray_id != 0) {
      if(!HasTray(agv.tray_id)) {
        return FailedEvent("t" + std::to_string(agv.tray_id) + " not found");
      }

      auto& tray = trays_[agv.tray_id];
      tray.agv_id = 0;
      agv.tray_id = 0;
    }
  }

  agv.lift = event.raised;
  return SucceededEvent();
}

BoolStringPair DiscreteGarageState::OnEvent(const AgvPoseChangedMsg& event) {
  // NOTE: We do not check for intersections, pose validity, etc.

  // Ensure that the AGV exists
  if(!HasAgv(event.agv_id)) {
    return FailedEvent("a" + std::to_string(event.agv_id) + " not found");
  }

  // Ensure that the AGV is at the correct current pose
  auto& agv = agvs_[event.agv_id];
  if(agv.pose.node_id != event.node_id_curr || agv.pose.heading != event.heading_curr) {
    return FailedEvent("a" + std::to_string(event.agv_id) + " should be at " +
                       std::to_string(event.node_id_curr) + "@" + std::to_string(event.heading_curr) +
                       " but is at " + std::to_string(agv.pose.node_id) + "@" +
                       std::to_string(agv.pose.heading));
  }

  // Ensure that the next pose is different
  if(event.heading_next == event.heading_curr && event.node_id_next == event.node_id_curr) {
    return FailedEvent("a" + std::to_string(event.agv_id) + " moving in-place at " +
                       std::to_string(event.node_id_curr) + "@" + std::to_string(event.heading_curr));
  }

  // If the AGV is carrying a tray, update the tray too.
  if(agv.tray_id != 0) {
    if(!HasTray(agv.tray_id)) {
      return FailedEvent("tray " + std::to_string(agv.tray_id) + " not found");
    }

    // Note that if the tray is opposite the AGV, it will continue to be after the move too.
    auto& tray = trays_[agv.tray_id];
    bool is_reciprocal_to_agv = tray.pose.heading != agv.pose.heading;
    tray.pose.node_id = event.node_id_next;
    tray.pose.heading = event.heading_next;
    if(is_reciprocal_to_agv) {
      tray.pose.heading = static_cast<int16_t>(volley::Wrap(tray.pose.heading + 180));
    }
  }

  // See if we are moving an AGV onto the same node as another AGV. There is never a scenario
  // where this would make sense.
  for(auto [agv_id, other_agv] : GetAgvs()) {
    if(agv_id == event.agv_id) {
      // ignore self
      continue;
    }
    if(other_agv.pose.node_id == event.node_id_next) {
      return FailedEvent("a" + std::to_string(event.agv_id) + "'s destination pose " +
                         std::to_string(ConstructGaragePose(event.node_id_next, event.heading_next)) +
                         " is on the same node as a" + std::to_string(agv_id) + ": " +
                         std::to_string(other_agv.pose));
    }
  }

  // Update the AGV
  agv.pose.node_id = event.node_id_next;
  agv.pose.heading = event.heading_next;

  return SucceededEvent();
}

BoolStringPair DiscreteGarageState::OnEvent(const AgvStateChangedMsg& event) {
  // Ensure that the AGV exists
  if(!HasAgv(event.agv_id)) {
    return FailedEvent("a" + std::to_string(event.agv_id) + " not found");
  }

  // Ensure that the AGV is in the specified current state, and its next state is something
  // different. NOTE: We do not check for invalid transitions, only no-ops.
  auto& agv = agvs_[event.agv_id];
  if(agv.state != event.state_curr) {
    return FailedEvent("a" + std::to_string(event.agv_id) + " not currently in state " +
                       std::to_string(event.state_curr) + " but in " + std::to_string(agv.state));
  }
  else if(agv.state == event.state_next) {
    return FailedEvent(
        "a" + std::to_string(event.agv_id) + " is already in state " + std::to_string(event.state_next));
  }

  agv.state = event.state_next;
  return SucceededEvent();
}

BoolStringPair DiscreteGarageState::OnEvent(const BayDisablednessChangedMsg& event) {
  // Ensure that the bay exists
  if(!HasBay(event.bay_id)) {
    return FailedEvent("b" + std::to_string(event.bay_id) + " not found");
  }

  // Ensure that the bay was in the opposite state prior to this event
  auto& bay = bays_[event.bay_id];
  if(bay.disabled == event.disable) {
    return FailedEvent("b" + std::to_string(event.bay_id) + " already has desired disabledness");
  }

  // Ensure that the bay's node is in the correct disabled state prior to this event
  bool node_disabled = disabled_nodes_.find(event.bay_id) != disabled_nodes_.end();
  if(node_disabled != event.disable) {
    return FailedEvent("Node " + std::to_string(event.bay_id) + " does not match b" +
                       std::to_string(event.bay_id) + "'s desired disabledness");
  }

  bay.disabled = event.disable;
  return SucceededEvent();
}

