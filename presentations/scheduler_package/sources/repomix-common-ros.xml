#include <common_ros/print_utils.hpp>

namespace std {

// NOLINTNEXTLINE
std::string to_string(const ActionNodeMsg& node) {
  std::ostringstream os;
  os << "ID: " << std::to_string(node.guid);
  os << " Job ID: " << std::to_string(node.job_id);
  os << " Duration: " << std::to_string(node.duration);
  os << " Parents: ";
  for(auto parent : node.parents) {
    os << std::to_string(parent) << ", ";
  }
  os << (node.outside_split ? " Outside " : " Inside") << " Split";

  // Only print relevant fields for each type
  os << " Type: ";
  switch(node.type) {
  case ActionNodeMsg::TYPE_AGV_COMMAND:
    os << "AGV Command ";
    os << std::to_string(volley::AgvId(node.agv_id)) << " ";
    os << std::to_string(node.agv_command);
    break;
  case ActionNodeMsg::TYPE_BAY_COMMAND:
    os << "Bay Command ";
    os << std::to_string(volley::BayId(node.bay_id)) << " ";
    os << std::to_string(node.bay_command);
    break;
  case ActionNodeMsg::TYPE_VECS_COMMAND:
    os << "VECS Command ";
    os << std::to_string(volley::VecsId(node.vecs_id)) << " ";
    os << std::to_string(node.vecs_command);
    break;
  default:
    os << "Unknown ActionNode type: " << std::to_string(node.type);
    break;
  }

  // Node status
  os << " Status: ";
  switch(node.status) {
  case ActionNodeMsg::STATUS_NOT_RECEIVED:
    os << "NOT RECEIVED";
    break;
  case ActionNodeMsg::STATUS_RECEIVED:
    os << "RECEIVED";
    break;
  case ActionNodeMsg::STATUS_COMPLETED:
    os << "COMPLETED";
    break;
  default:
    os << "Unknown ActionNode status: " << std::to_string(node.status);
    break;
  }

  return os.str();
}

// NOLINTNEXTLINE
std::string to_string(const AgvCommandMsg& command) {
  return std::to_string(command.src) + " -> " + std::to_string(command.dst);
}

// NOLINTNEXTLINE
std::string to_string(const BayCommandMsg& command) {
  std::ostringstream os;
  switch(command.command_type) {
  case BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT:
    os << "Transition to Insert";
    break;
  case BayCommandMsg::COMMAND_TYPE_PROCESS_RETRIEVE:
    os << "Process Retrieve";
    break;
  case BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE:
    os << "Transition to Retrieve";
    break;
  case BayCommandMsg::COMMAND_TYPE_MOVE_LIFT_TO_FLOOR:
    os << "Move Lift to Floor " << std::to_string(command.floor);
    break;
  default:
    os << "Unknown BayCommand type: " << std::to_string(command.command_type);
    break;
  }

  return os.str();
}

// NOLINTNEXTLINE
std::string to_string(const VecsCommandMsg& command) {
  std::ostringstream os;
  switch(command.command_type) {
  case VecsCommandMsg::COMMAND_TYPE_START_CHARGING:
    os << "Start charging";
    break;
  case VecsCommandMsg::COMMAND_TYPE_STOP_CHARGING:
    os << "Stop charging";
    break;
  default:
    os << "Unknown VecsCommand type: " << std::to_string(command.command_type);
    break;
  }

  return os.str();
}

// NOLINTNEXTLINE
std::string to_string(const GuidMsg& guid) {
  // ex: "936DA01F-9ABD-4d9d-80C7-02AF85C822A8"
  std::ostringstream os;
  // Output integers with uppercase base 16, do not prepend 0x, and pad to width with 0.
  os << std::hex << std::uppercase << std::noshowbase << std::setfill('0');
  os << std::setw(2) << static_cast<int>(guid.bytes.at(0));
  os << std::setw(2) << static_cast<int>(guid.bytes.at(1));
  os << std::setw(2) << static_cast<int>(guid.bytes.at(2));
  os << std::setw(2) << static_cast<int>(guid.bytes.at(3));
  os << "-";
  os << std::setw(2) << static_cast<int>(guid.bytes.at(4));
  os << std::setw(2) << static_cast<int>(guid.bytes.at(5));
  os << "-";
  os << std::setw(2) << static_cast<int>(guid.bytes.at(6));
  os << std::setw(2) << static_cast<int>(guid.bytes.at(7));
  os << "-";
  os << std::setw(2) << static_cast<int>(guid.bytes.at(8));
  os << std::setw(2) << static_cast<int>(guid.bytes.at(9));
  os << "-";
  os << std::setw(2) << static_cast<int>(guid.bytes.at(10));
  os << std::setw(2) << static_cast<int>(guid.bytes.at(11));
  os << std::setw(2) << static_cast<int>(guid.bytes.at(12));
  os << std::setw(2) << static_cast<int>(guid.bytes.at(13));
  os << std::setw(2) << static_cast<int>(guid.bytes.at(14));
  os << std::setw(2) << static_cast<int>(guid.bytes.at(15));
  return os.str();
}

// NOLINTNEXTLINE
std::string to_string(const GarageEntityIdMsg& id) {
  return id.entity_type + std::to_string(id.id);
}

// NOLINTNEXTLINE
std::string to_string(const GarageEventMsg& event) {
  std::ostringstream os;
  os << "EVENT(" << event.type << "," << event.agv_id << "," << event.bay_id << "," << event.tray_id << ","
     << event.payload_id << "," << event.command_id << ")";

  return os.str();
}

// NOLINTNEXTLINE
std::string to_string(const PayloadMsg& payload) {
  std::ostringstream os;

  os << "Payload: " << std::to_string(payload.id);
  os << " Mass [kg]: " << std::to_string(payload.mass);
  os << " Length [m]: " << std::to_string(payload.length_m);
  os << " Width [m]: " << std::to_string(payload.width_m);
  os << " Height [m]: " << std::to_string(payload.height_m);
  os << " EV charge requested: " << std::to_string(payload.ev_charge_requested);

  return os.str();
