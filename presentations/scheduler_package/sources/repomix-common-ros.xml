#include <common/constants.hpp>
#include <common/enum.hpp>
#include <common/math_utils.hpp>
#include <common_ros/layout.hpp>
#include <common_ros/polygon_utils.hpp>
#include <common_ros/pose_graph.hpp>
#include <rclcpp/rclcpp.hpp>
#include <unordered_map>

namespace volley {

using Node = GarageNodeMsg;
using Pose = GaragePoseMsg;

// This tolerance is used when calculating edges. A translation must
// lie within this angular tolerance in order to be accepted as a valid edge.
// This prevents, for example, a forward move to a destination node from deviating
// too much to the left or right.
constexpr double kAngleToleranceRad = 0.1;  // ~5.7 deg

int GetBasePoseEdgeIndex(int pose_index) {
  return pose_index * static_cast<int>(common::EnumCount<PoseNeighbor>());
}

PoseGraph::PoseGraph(LayoutSPtr layout) : layout_(layout) {
  auto logger = rclcpp::get_logger("pose_graph");

  // Generate our poses
  for(const auto& node : layout_->GetNodes()) {
    // NOTE: Headings are stored in ascending order.
    auto headings = GetAllowedHeadings(node);
    if(headings.size() == 0) {
      // All nodes must support at least one heading
      throw std::runtime_error("Node " + std::to_string(node.id) + "does not have any headings!");
    }
    for(int16_t heading : headings) {
      Pose pose = ConstructGaragePose(node.id, heading);
      pose_indices_.emplace(pose, poses_.size());
      poses_.emplace_back(pose);
    }
  }

  // Build a node_id -> (vrc_id, floor) lookup so VRC neighbor pairs can be detected without
  // iterating every VRC for every neighbor classification.
  std::unordered_map<uint32_t, std::pair<uint32_t, uint8_t>> vrc_membership;
  for(const auto& vrc : layout_->GetVrcs()) {
    for(const auto& node : vrc.nodes) {
      vrc_membership.emplace(node.id, std::make_pair(vrc.id, node.floor));
    }
  }

  // Generate all pose neighbors
  {
    int n_poses = static_cast<int>(poses_.size());
    size_t max_n_edges = n_poses * common::EnumCount<PoseNeighbor>();
    pose_neighbors_.resize(max_n_edges, kInvalidIndex);

    for(int pose_index = 0; pose_index < n_poses; pose_index++) {
      int b = GetBasePoseEdgeIndex(pose_index);
      const auto& pose = poses_.at(pose_index);
      const auto node = layout_->GetNodeById(pose.node_id).value();
      double heading_rad = pose.heading * kDeg2Rad;

      auto src_vrc_it = vrc_membership.find(node.id);

      // Iterate over translations
      for(const Node& node_dest : layout_->GetNeighboringNodes(node.id)) {
        // Destination pose has the same heading
        Pose pose_dest = ConstructGaragePose(node_dest.id, pose.heading);

        // The heading must also be valid for the destination node.
        if(pose_indices_.find(pose_dest) == pose_indices_.end()) {
          continue;
        }

        // VRC pairs must be classified by floor, not bearing. Two VRC nodes share x/y, so
        // bearing-based classification would put both up/down neighbors in the same planar slot
        // and silently drop one (typically the downward edge — see SW2 issue with VRC down moves).
        if(src_vrc_it != vrc_membership.end()) {
          auto dst_vrc_it = vrc_membership.find(node_dest.id);
          if(dst_vrc_it != vrc_membership.end() && dst_vrc_it->second.first == src_vrc_it->second.first) {
            PoseNeighbor vrc_dir =
                (node_dest.floor > node.floor) ? PoseNeighbor::VRC_UP : PoseNeighbor::VRC_DOWN;
            int slot = b + common::EnumInteger(vrc_dir);
            int prev = pose_neighbors_[slot];
            pose_neighbors_[slot] = pose_indices_.at(pose_dest);
            RCLCPP_INFO(logger,
                "VRC neighbor classified: pose(node=%u, h=%d, floor=%u) -> pose(node=%u, h=%d, floor=%u) "
                "as %s (vrc_id=%u)%s",
                node.id, pose.heading, node.floor, node_dest.id, pose.heading, node_dest.floor,
                (vrc_dir == PoseNeighbor::VRC_UP) ? "VRC_UP" : "VRC_DOWN", src_vrc_it->second.first,
                (prev != kInvalidIndex) ? " [WARN: overwrote prior VRC slot]" : "");
            continue;
          }
        }

        // Skip edges with disallowed orientations.
        auto deo = layout_->GetDisallowedEdgeOrientation(pose.node_id, node_dest.id);
        if(deo.has_value() && volley::IsAngleOrReciprocal(deo.value(), pose.heading)) {
          continue;
        }

        double bearing_from_source_rad = std::atan2(node_dest.y - node.y, node_dest.x - node.x);
        double relative_bearing = volley::SignedAngleDist(heading_rad, bearing_from_source_rad);

        // Detect when a planar slot is being overwritten — the historical VRC bug masqueraded as
        // multiple neighbors mapping to the same slot. Now that VRC is split out, this should not
        // fire; if it does, it indicates a layout authoring problem.
        auto warn_if_overwriting = [&](PoseNeighbor dir) {
          int slot = b + common::EnumInteger(dir);
          if(pose_neighbors_[slot] != kInvalidIndex) {
            RCLCPP_WARN(logger,
                "Pose(node=%u, h=%d) planar slot already occupied while assigning new neighbor "
                "node=%u — silent loss of an edge.",
                node.id, pose.heading, node_dest.id);
          }
        };

        if(volley::AngleDist(relative_bearing, 0.0) < kAngleToleranceRad) {
          warn_if_overwriting(PoseNeighbor::FORWARD);
          pose_neighbors_[b + common::EnumInteger(PoseNeighbor::FORWARD)] = pose_indices_.at(pose_dest);
        }
        else if(volley::AngleDist(relative_bearing, M_PI_2) < kAngleToleranceRad) {
          warn_if_overwriting(PoseNeighbor::LEFT);
          pose_neighbors_[b + common::EnumInteger(PoseNeighbor::LEFT)] = pose_indices_.at(pose_dest);
        }
        else if(volley::AngleDist(relative_bearing, M_PI) < kAngleToleranceRad) {
          warn_if_overwriting(PoseNeighbor::BACK);
          pose_neighbors_[b + common::EnumInteger(PoseNeighbor::BACK)] = pose_indices_.at(pose_dest);
        }
        else if(volley::AngleDist(relative_bearing, -M_PI_2) < kAngleToleranceRad) {
          warn_if_overwriting(PoseNeighbor::RIGHT);
          pose_neighbors_[b + common::EnumInteger(PoseNeighbor::RIGHT)] = pose_indices_.at(pose_dest);
        }
        else {
          throw std::runtime_error("Edge " + std::to_string(node.id) + " <-> " +
                                   std::to_string(node_dest.id) + " with invalid translation connection!");
        }
      }

      // Construct left and right rotations
      if(node.rotation_allowed) {
        // Find the smallest left and right rotations
        double min_rot_left = 2 * M_PI;
        double min_rot_right = 2 * M_PI;

        for(int16_t heading_dest : GetAllowedHeadings(node)) {
          if(heading_dest == pose.heading) {
            continue;  // skip ourselves
          }

          Pose pose_dest = ConstructGaragePose(node.id, heading_dest);
          double heading_dest_rad = heading_dest * kDeg2Rad;
          double cw_dist = volley::ClockwiseAngleDistance(heading_rad, heading_dest_rad);
          double ccw_dist = volley::CounterClockwiseAngleDistance(heading_rad, heading_dest_rad);
          if(cw_dist < min_rot_right) {
            min_rot_right = cw_dist;
            pose_neighbors_[b + common::EnumInteger(PoseNeighbor::ROT_RIGHT)] = pose_indices_.at(pose_dest);
          }
          if(ccw_dist < min_rot_left) {
            min_rot_left = ccw_dist;
            pose_neighbors_[b + common::EnumInteger(PoseNeighbor::ROT_LEFT)] = pose_indices_.at(pose_dest);
          }
        }
      }
    }
  }

  // Compute the overlapping sizes poses
  overlapping_sized_poses_ = CalcOverlappingSizedPoses(*layout_, poses_);
}

bool PoseGraph::HasPose(const Pose& pose) const {
  return pose_indices_.find(pose) != pose_indices_.end();
}

const Pose& PoseGraph::GetPose(int pose_index) const {
  return poses_.at(pose_index);
}

int PoseGraph::GetPoseIndex(const Pose& pose) const {
  auto it = pose_indices_.find(pose);
  if(it == pose_indices_.end()) {
    return kInvalidIndex;
  }
  return it->second;
}

std::optional<Pose> PoseGraph::GetNeighborPose(int pose_index, PoseNeighbor neighbor) const {
  if(pose_index < 0 || pose_index >= static_cast<int>(poses_.size())) {
    return std::nullopt;
  }
  int b = GetBasePoseEdgeIndex(pose_index);
  int neighbor_pose_index = pose_neighbors_.at(b + common::EnumInteger(neighbor));
  if(neighbor_pose_index == kInvalidIndex) {
    return std::nullopt;
  }
  return poses_.at(neighbor_pose_index);
}

std::optional<Pose> PoseGraph::GetNeighborPose(Pose pose, PoseNeighbor neighbor) const {
  return GetNeighborPose(GetPoseIndex(pose), neighbor);
}

const std::vector<SizedPoseMsg>& PoseGraph::GetOverlappingSizedPoses(
    int pose_index, uint8_t resource_size_index) const {
  if(pose_index == kInvalidIndex || resource_size_index >= overlapping_sized_poses_.at(pose_index).size()) {
    static const auto kEmptyVec = std::vector<SizedPoseMsg>();
    return kEmptyVec;  // we return a reference (&), so point to a static empty list
  }

  return overlapping_sized_poses_.at(pose_index).at(resource_size_index);
}

std::optional<Pose> PoseGraph::GetBayOutboundPose(uint16_t bay_id) const {
  // Construct the bay's primary (inbound) pose
  auto bay_node_opt = layout_->GetNodeById(bay_id);
  if(!bay_node_opt.has_value()) {
    return std::nullopt;
  }
  const auto& bay_node = bay_node_opt.value();
  int16_t bay_heading = bay_node.headings.front();
  if(bay_node.faces_reciprocal) {
    bay_heading = static_cast<int16_t>(volley::Wrap(bay_heading + 180));
  }
  Pose bay_primary_pose = ConstructGaragePose(bay_node.id, bay_heading);
  return GetNeighborPose(bay_primary_pose, PoseNeighbor::LEFT);
}

}  // namespace volley
