#include <stdio.h>

#include <common_ros/print_graph.hpp>
#include <fstream>
#include <iostream>
#include <sstream>

namespace volley {

void WriteStringToFile(const std::string& filename, const std::string& contents) {
  std::ofstream file(filename);
  // NOLINTNEXTLINE(bugprone-narrowing-conversions,cppcoreguidelines-narrowing-conversions)
  file.write(contents.c_str(), contents.size());
  file.close();
}

// Requires: sudo apt-get install libgraph-easy-perl
// Print a graph to the log
void PrintGraph(
    const std::string& label, const std::string& dotcontents, rclcpp::Logger logger, const char* color) {
#if 1
  // Write the dot file to a temp file.
  std::string filename = "/tmp/" + label + ".dot";
  WriteStringToFile(filename, dotcontents);

  // Run Graphviz graph-easy commmand line tool on the dot file to get the ASCII DAG.
  char command[512];
  memset(command, 0, sizeof(command));

  // Requires: sudo apt-get install libgraph-easy-perl
  //"cat graph.dot | graph-easy --as=ascii"  // --as=boxart
  sprintf(command, "cat %s | graph-easy --as=boxart", filename.c_str());
  FILE* pipe = popen(command, "r");
  if(!pipe) {
    return;
  }
#else
  // Run Graphviz graph-easy commmand line tool on the dot file to get the ASCII DAG.
  std::string command = "echo \"";
  command += dotcontents;
  command += "\" | graph-easy --as=boxart";

  // Requires: sudo apt-get install libgraph-easy-perl
  FILE* pipe = popen(command.c_str(), "r");
  if(!pipe) {
    return;
  }
#endif

  // Read ASCII DAG output from Graphviz graph-easy tool.
  std::string asciidag;
  char buffer[2048];
  memset(buffer, 0, sizeof(buffer));
  while(fgets(buffer, sizeof(buffer), pipe) != nullptr) {
    if(0 == strcmp(buffer, "\n")) {
      continue;
    }
    char* chr = buffer;
    while(*chr) {
      if(*chr == '\n' || *chr == 0x0D || *chr == 0x0A) {
        *chr = ' ';  // remove newline, carriage return, line feed
      }
      chr++;
    }
    asciidag += "   ";  // indent spaces
    asciidag += buffer;
    asciidag += "\n";  // newline
    memset(buffer, 0, sizeof(buffer));
  }
  const char* resetcolor = "\033[0m";  // Reset color

  // Print the ASCII DAG to the terminal, with color.
  INFOF(logger, "\n%s   %s\n%s%s", color, label.c_str(), asciidag.c_str(), resetcolor);

  // Close the pipe
  pclose(pipe);

#if 1
  // Delete the temp file
  remove(filename.c_str());
#endif
}

}  // namespace volley
