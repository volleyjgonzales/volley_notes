struct Circle {
  double x;
  double y;
  double radius;

  Circle(double x, double y, double radius) : x(x), y(y), radius(radius) {
    if(radius < 0.0) {
      throw std::invalid_argument("Radius " + std::to_string(radius) + " must be positive!");
    }
  }

  bool CircleIntersects(const Circle& other) const {
    double distance_squared = (x - other.x) * (x - other.x) + (y - other.y) * (y - other.y);
    double radius_sum = radius + other.radius;
    // Compare squared distances to avoid sqrt
    return distance_squared < radius_sum * radius_sum;
  }
};

