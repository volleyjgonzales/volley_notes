<file path="include/common_ros/discrete_garage_event_io.hpp">
#pragma once

#include <common_ros/common_ros_msgs.hpp>
#include <cstring>  // std::memcpy
#include <optional>
#include <rclcpp/serialization.hpp>
#include <rclcpp/serialized_message.hpp>
#include <utility>

// Serialization routines for discrete garage events

namespace volley {

template <typename T>
std::optional<DiscreteGarageEventMsg> Serialize(const T& discrete_garage_event) {
  rclcpp::SerializedMessage serialized_message;
  auto serialization = rclcpp::Serialization<T>();
  try {
    serialization.serialize_message(&discrete_garage_event, &serialized_message);
  }
  catch(...) {
    // Failed to serialize
    rcutils_reset_error();  // reset error now that we've "handled" it.
    return std::nullopt;
  }

  // Construct our event
  DiscreteGarageEventMsg event;

  // `event.type` will have the form "interfaces/msg/AgvStateChanged".
  // We cut off the leading "interfaces/msg/".
  event.type = rosidl_generator_traits::name<T>();  // data_type
  event.type = event.type.substr(event.type.find_last_of("/") + 1);

  // Serialize the message into the event
  auto serialized_message_t = serialized_message.get_rcl_serialized_message();
  event.buffer.resize(serialized_message_t.buffer_length);
  std::memcpy(event.buffer.data(), serialized_message_t.buffer, serialized_message_t.buffer_length);

  return event;
}

template <typename T>
std::optional<T> Deserialize(const DiscreteGarageEventMsg& event) {
  // We will be deserializing the message from event.buffer
  size_t n_bytes = event.buffer.size();
  rclcpp::SerializedMessage serialized_message(n_bytes);

  // Deserialize the event
  T discrete_garage_event;

  // Copy the data into our serialized message
  auto& serialized_message_t = serialized_message.get_rcl_serialized_message();
  std::memcpy(serialized_message_t.buffer, event.buffer.data(), n_bytes);
  serialized_message_t.buffer_length = n_bytes;

  auto serialization = rclcpp::Serialization<T>();
  try {
    serialization.deserialize_message(&serialized_message, &discrete_garage_event);
  }
  catch(...) {
    // Failed to deserialize
    rcutils_reset_error();  // reset error now that we've "handled" it.
    return std::nullopt;
  }

  return discrete_garage_event;
}

}  // namespace volley
</file>

