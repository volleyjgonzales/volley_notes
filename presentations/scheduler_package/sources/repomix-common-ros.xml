<file path="include/common_ros/discrete_garage_state.hpp">
#pragma once
#include <common/types.hpp>
#include <map>
#include <set>
#include <string>

#include "common_ros/common_ros_msgs.hpp"
#include "common_ros/ros_utils.hpp"
#include "common_ros/versioned_state_buffer.hpp"

namespace volley {

// Events are all reversible, and all events are their own inverse.
AgvExistenceChangedMsg Reverse(const AgvExistenceChangedMsg& event);
AgvDisablednessChangedMsg Reverse(const AgvDisablednessChangedMsg& event);
AgvPoseChangedMsg Reverse(const AgvPoseChangedMsg& event);
AgvLiftChangedMsg Reverse(const AgvLiftChangedMsg& event);
AgvStateChangedMsg Reverse(const AgvStateChangedMsg& event);
BayDisablednessChangedMsg Reverse(const BayDisablednessChangedMsg& event);
BayExistenceChangedMsg Reverse(const BayExistenceChangedMsg& event);
BayStateChangedMsg Reverse(const BayStateChangedMsg& event);
VecsDisablednessChangedMsg Reverse(const VecsDisablednessChangedMsg& event);
VecsExistenceChangedMsg Reverse(const VecsExistenceChangedMsg& event);
VecsStateChangedMsg Reverse(const VecsStateChangedMsg& event);
VrcExistenceChangedMsg Reverse(const VrcExistenceChangedMsg& event);
VrcStateChangedMsg Reverse(const VrcStateChangedMsg& event);
TrayExistenceChangedMsg Reverse(const TrayExistenceChangedMsg& event);
TrayDisablednessChangedMsg Reverse(const TrayDisablednessChangedMsg& event);
TrayPoseSetManuallyMsg Reverse(const TrayPoseSetManuallyMsg& event);
PayloadExistenceChangedMsg Reverse(const PayloadExistenceChangedMsg& event);
std::optional<DiscreteGarageEventMsg> Reverse(const DiscreteGarageEventMsg& event);
NodeDisablednessChangedMsg Reverse(const NodeDisablednessChangedMsg& event);

// Convenience methods for converting from discrete states to add events
FaultStateChangedMsg GetFaultedEvent(bool is_faulted = true);
AgvExistenceChangedMsg GetAddEvent(const DiscreteAgvStateMsg& agv);
BayExistenceChangedMsg GetAddEvent(const DiscreteBayStateMsg& bay);
TrayExistenceChangedMsg GetAddEvent(const DiscreteTrayStateMsg& tray);
VecsExistenceChangedMsg GetAddEvent(const DiscreteVecsStateMsg& vecs);
VrcExistenceChangedMsg GetAddEvent(const DiscreteVrcStateMsg& vrc);
PayloadExistenceChangedMsg GetAddEvent(const DiscretePayloadStateMsg& payload_state);

/*
A discrete garage state represents a Volley garage where all entities are on their nodes and
all continuous values are at finite states, in the manner that the scheduler reasons about them.
The scheduling system reasons about discrete state transitions. This state representation allows
us to apply valid state transitions and keep track of their effects. For example, moving an AGV that
has a tray will affect the tray and its payload.

This state representation uses event sourcing. That is, all changes to the state are represented as
events, and events happen in series. If we know the starting state and the event log, then we can
reconstruct the state over time. Furthermore, all events are reversible, so if we know the event log
and any intermediate state, we can reconstruct the state over all time as well.

Calling OnEvent will attempt to apply the given state. State will not be mutated if the event
cannot be applied, and will be mutated if the event was applied.

All events are implemented as ROS messages in the interfaces package.
Representing them as ROS messages allows us to use ROS's built-in serialization and deserialization
routines.
*/
class DiscreteGarageState {
public:
  // Construct an empty garage state
  DiscreteGarageState() = default;

  bool IsFaulted() const { return is_faulted_; }

  void SetAgvDisabled(uint32_t agv_id);
  void SetBayDisabled(uint32_t bay_id);
  void SetVecsDisabled(uint32_t vecs_id);
  void SetNodeDisabled(uint32_t node_id);

  // Returns true if the given node is in the list of disabled nodes.
  // Note that we do not check for node validity. A non-existent node will not be disabled.
  bool IsNodeDisabled(uint32_t node_id) const;

  bool HasAgv(uint16_t agv_id) const;
  bool HasBay(uint16_t bay_id) const;
  bool HasTray(uint16_t tray_id) const;
  bool HasVecs(uint16_t vecs_id) const;
  bool HasVrc(uint16_t vrc_id) const;
  bool HasPayload(const GuidMsg& payload_id) const;

  size_t GetNumAgvs() const { return agvs_.size(); }
  size_t GetNumBays() const { return bays_.size(); }
  size_t GetNumVexen() const { return vexen_.size(); }
  size_t GetNumTrays() const { return trays_.size(); }
  size_t GetNumPayloads() const { return payloads_.size(); }
  size_t GetNumVrcs() const { return vrcs_.size(); }

  std::optional<DiscreteAgvStateMsg> GetAgv(uint16_t agv_id) const;
  std::optional<DiscreteBayStateMsg> GetBay(uint16_t bay_id) const;
  std::optional<DiscreteTrayStateMsg> GetTray(uint16_t tray_id) const;
  std::optional<DiscreteVecsStateMsg> GetVecs(uint16_t vecs_id) const;
  std::optional<DiscreteVrcStateMsg> GetVrc(uint16_t vrc_id) const;
  std::optional<DiscretePayloadStateMsg> GetPayload(const GuidMsg& payload_id) const;

  std::optional<DiscreteTrayStateMsg> GetTrayOnNode(uint32_t node_id) const;
  std::optional<DiscreteAgvStateMsg> GetAgvOnNode(uint32_t node_id) const;

  const std::map<uint16_t, DiscreteAgvStateMsg>& GetAgvs() const { return agvs_; }
  const std::map<uint16_t, DiscreteBayStateMsg>& GetBays() const { return bays_; }
  std::map<uint16_t, DiscreteBayStateMsg> GetEnabledBays() const;
  const std::map<uint16_t, DiscreteVecsStateMsg>& GetVexen() const { return vexen_; }
  std::map<uint16_t, DiscreteVecsStateMsg> GetEnabledVexen() const;
  const std::map<uint16_t, DiscreteVrcStateMsg>& GetVrcs() const { return vrcs_; }
  const std::map<uint16_t, DiscreteTrayStateMsg>& GetTrays() const { return trays_; }
  const std::map<const GuidMsg, DiscretePayloadStateMsg, GuidComparator>& GetPayloads() const {
    return payloads_;
  }
  const std::set<uint32_t>& GetDisabledNodes() const { return disabled_nodes_; }

  // Compute a hash for the current discrete state.
  // This hash allows us to quickly determine (with near, but not absolute certainty) whether
  // two discrete garage states are equal.
  // The hash method used here requires computing the hash from scratch after every event.
  // Note that we rely on the fact that std::map iterates over items in ascending order.
  // Hashing also takes a version parameter to compute the hash of a discrete garage state
  // as if it were loaded in an old version of the software. This is useful to verify that
  // when loading from an older Snapshot we still loaded everything correctly. It also allows
  // the garage_tracker_recovery to back compute hashes when creating older snapshots if the
  // garage software needs to be downgraded.
  uint64_t Hash(uint32_t version = kLatestYamlEncodingVersion) const;

  // Clear the current state
  void Clear();

  // Set the state from the given discrete garage state. This call can fail if the ROS message
  // contains inconsistent state information. We return true on success.
  BoolStringPair Set(const DiscreteGarageStateMsg& state);

  // Set from yaml representation.
  BoolStringPair Set(YAML::Node node);

  // Set the state from the given discrete garage state. This call is always expected to succeed,
  // as discrete garage states are structured maintain valid states.
  void Set(const DiscreteGarageState& state);

  // Convert the DiscreteGarageState to a ROS Message
  DiscreteGarageStateMsg GetDiscreteGarageStateMessage() const;

  // Convert the DiscreteGarageState to a YAML Node
  YAML::Node GetYaml() const;

  // Apply the given event.
  // Returns true if applying the event succeeded.
  // Returns false if applying the event failed, in which case state was not changed.
  // The returned pair includes a string that can explain why an event failed to be applied.
  BoolStringPair OnEvent(const DiscreteGarageEventMsg& event);
  BoolStringPair OnEvent(const FaultStateChangedMsg& event);
  BoolStringPair OnEvent(const AgvExistenceChangedMsg& event);
  BoolStringPair OnEvent(const AgvDisablednessChangedMsg& event);
  BoolStringPair OnEvent(const AgvLiftChangedMsg& event);
  BoolStringPair OnEvent(const AgvPoseChangedMsg& event);
  BoolStringPair OnEvent(const AgvStateChangedMsg& event);
  BoolStringPair OnEvent(const BayDisablednessChangedMsg& event);
  BoolStringPair OnEvent(const BayExistenceChangedMsg& event);
  BoolStringPair OnEvent(const BayStateChangedMsg& event);
  BoolStringPair OnEvent(const VecsDisablednessChangedMsg& event);
  BoolStringPair OnEvent(const VecsExistenceChangedMsg& event);
  BoolStringPair OnEvent(const VecsStateChangedMsg& event);
  BoolStringPair OnEvent(const VrcExistenceChangedMsg& event);
  BoolStringPair OnEvent(const VrcStateChangedMsg& event);
  BoolStringPair OnEvent(const TrayExistenceChangedMsg& event);
  BoolStringPair OnEvent(const TrayDisablednessChangedMsg& event);
  BoolStringPair OnEvent(const TrayPoseSetManuallyMsg& event);
  BoolStringPair OnEvent(const PayloadExistenceChangedMsg& event);
  BoolStringPair OnEvent(const NodeDisablednessChangedMsg& event);

private:
  // Whether the discrete garage state has some sort of issue
  bool is_faulted_ = false;

  // Note that we use std::map because we depend on entity ordering in Hash.
  std::map<uint16_t, DiscreteAgvStateMsg> agvs_;
  std::map<uint16_t, DiscreteBayStateMsg> bays_;
  std::map<uint16_t, DiscreteVecsStateMsg> vexen_;
  std::map<uint16_t, DiscreteVrcStateMsg> vrcs_;
  std::map<uint16_t, DiscreteTrayStateMsg> trays_;
  std::map<const GuidMsg, DiscretePayloadStateMsg, GuidComparator> payloads_;
  std::set<uint32_t> disabled_nodes_;
};

}  // namespace volley

namespace std {
// NOLINTNEXTLINE
std::string to_string(const volley::DiscreteGarageState& state);
}  // namespace std
</file>

<file path="include/common_ros/garage_graph.hpp">
#pragma once

#include <array>
#include <boost/function.hpp>
#include <boost/graph/adjacency_list.hpp>
#include <boost/graph/filtered_graph.hpp>
#include <boost/property_map/property_map.hpp>
#include <common_ros/layout.hpp>
#include <common_ros/pose_graph.hpp>
#include <common_ros/pose_utils.hpp>
#include <stdexcept>

template <>
struct std::hash<GaragePoseMsg> {
  std::size_t operator()(const GaragePoseMsg& pose) const {
    std::size_t result = 0;
    boost::hash_combine(result, pose.node_id);
    boost::hash_combine(result, pose.heading);
    return result;
  }
};

namespace volley {

// C++ does not provide an easy way to iterate over an enum class. Here, we put each member of
// PoseNeighbor into an array, so we can easily iterate over them
static const std::array<PoseNeighbor, 8> kPoseNeighbors = {PoseNeighbor::FORWARD, PoseNeighbor::RIGHT,
    PoseNeighbor::BACK, PoseNeighbor::LEFT, PoseNeighbor::ROT_RIGHT, PoseNeighbor::ROT_LEFT,
    PoseNeighbor::VRC_UP, PoseNeighbor::VRC_DOWN};

enum class TransitionType : uint8_t {
  LOCOMOTE = 0,
  STRAFE = 1,
  ROTATION = 2,
  VRC_TRANSITION = 3,
};

// Edge property encodes edge type and information about length and AGV movement type
struct Transition {
  Transition() = default;
  Transition(double length, TransitionType type) : length(length), type(type) { }
  double length = 0.0;  // [m] for strafes and locomotes, [rad] for rotations
  TransitionType type = TransitionType::LOCOMOTE;
};

// Defines GarageGraphs internal graph representation
// This is a Boost adjacency_list with vertices/edges stored in boost vectors
// The vertex property map contains information about the corresponding pose
// There are two edge property maps, one specifying that boost::edge_index_t is size_t
// and the other contains Transition information about that edge
using BoostPoseGraph = boost::adjacency_list<boost::vecS, boost::vecS, boost::bidirectionalS, GaragePoseMsg,
    boost::property<boost::edge_index_t, std::size_t, Transition>>;

/*
The GarageGraph is a more useful version of the PoseGraph which represents the connectivity of poses
within a given layout. The GarageGraph uses a Boost Adjacency List for fast lookup of poses and
transitions.
*/
class GarageGraph {
public:
  using Vertex = BoostPoseGraph::vertex_descriptor;
  using Edge = BoostPoseGraph::edge_descriptor;

  // vector property maps based on vertex and edge index
  template <typename T>
  using VertexVectorPropertyMap =
      boost::vector_property_map<T, boost::property_map<BoostPoseGraph, boost::vertex_index_t>::type>;
  template <typename T>
  using EdgeVectorPropertyMap =
      boost::vector_property_map<T, boost::property_map<BoostPoseGraph, boost::edge_index_t>::type>;

  explicit GarageGraph(const PoseGraph& pose_graph);

  // Layout properties
  unsigned int NumVertices() const { return boost::num_vertices(base_graph_); }
  unsigned int NumEdges() const { return boost::num_edges(base_graph_); }

  // Getters
  LayoutSPtr GetLayout() const { return layout_; }
  bool HasPose(const GaragePoseMsg& pose) const {
    return pose_to_vertex_.find(pose) != pose_to_vertex_.end();
  }
  bool HasVertex(const Vertex& vertex) const {
    // Boost adjacency list always has contiguous valued vertices from [0, num_vertices)
    // Since Vertex type is unsigned it is guaranteed to be >= 0 automatically.
    return vertex < NumVertices();
  }
  bool HasEdge(const Edge& edge) const;
  const BoostPoseGraph& GetBaseGraph() const { return base_graph_; }

  std::optional<Vertex> GetVertexFromPose(const GaragePoseMsg& pose) const;
  std::optional<GaragePoseMsg> GetPoseFromVertex(const Vertex& vertex) const;

  std::optional<std::array<GaragePoseMsg, 2>> GetPosesFromEdge(const Edge& edge) const;

  std::array<GaragePoseMsg, 2> GetFromGraphRep(const Edge& edge) const {
    return GetPosesFromEdge(edge).value();
  }
  GaragePoseMsg GetFromGraphRep(const Vertex& vertex) const { return GetPoseFromVertex(vertex).value(); }

  Vertex GetFromGarageRep(const GaragePoseMsg& pose) const { return GetVertexFromPose(pose).value(); }
  Edge GetFromGarageRep(const std::array<GaragePoseMsg, 2>& poses) const {
    return GetEdgeFromPoses(poses[0], poses[1]).value();
  }

  std::optional<Edge> GetEdgeFromVertices(const Vertex& src, const Vertex& dst) const;
  std::optional<Edge> GetEdgeFromPoses(const GaragePoseMsg& src, const GaragePoseMsg& dst) const;

  // Iterators
  // Note: These functions return a pair consisting of (iterator_start, iterator_end)
  std::pair<BoostPoseGraph::vertex_iterator, BoostPoseGraph::vertex_iterator> GetVertices() const {
    return boost::vertices(base_graph_);
  }
  std::pair<BoostPoseGraph::edge_iterator, BoostPoseGraph::edge_iterator> GetEdges() const {
    return boost::edges(base_graph_);
  }
  // Get in/out edges
  // boost::in/out_edges() seems to have undefined behavior when the vertex doesn't exist.
  // Here we deviate a bit from our normal behavior of returning an optional and throw an
  // exception
  std::pair<BoostPoseGraph::in_edge_iterator, BoostPoseGraph::in_edge_iterator> GetInEdges(
      const Vertex& vertex) const {
    if(!HasVertex(vertex)) {
      throw std::invalid_argument("Vertex does not exist: " + std::to_string(vertex));
    }
    return boost::in_edges(vertex, base_graph_);
  }
  std::pair<BoostPoseGraph::out_edge_iterator, BoostPoseGraph::out_edge_iterator> GetOutEdges(
      const Vertex& vertex) const {
    if(!HasVertex(vertex)) {
      throw std::invalid_argument("Vertex does not exist: " + std::to_string(vertex));
    }
    return boost::out_edges(vertex, base_graph_);
  }

  // Get all vertices in the graph of a specific node type
  std::vector<Vertex> GetVerticesOfType(unsigned int type) const;

  // Get all valid AGV charge poses
  std::vector<GaragePoseMsg> GetAgvChargePoses() const;

  // Get all Bay door poses
  // Assumes all bays have the same ODP/garage door structure with 1 edge connecting to the inside
  // of the garage
  std::vector<GaragePoseMsg> GetBayDoorPoses() const;

  // Return index of given edge
  std::optional<size_t> GetEdgeIndex(const Edge& edge) const;

  // Get the x, y, yaw [rad] pose
  std::optional<GeometricPoseMsg> LocationFromGaragePose(const GaragePoseMsg& garage_pose) const;
  std::optional<GeometricPoseMsg> LocationFromVertex(const Vertex& vertex) const;

  // Get the GarageNode corresponding to this Vertex
  std::optional<GarageNodeMsg> GarageNodeFromVertex(const Vertex& vertex) const;

  // Get all vertices at a GarageNode
  std::vector<Vertex> GetVerticesAtGarageNode(const GarageNodeMsg& node) const;

  // Get edge descriptors from src and dst poses/vertices
  std::optional<Edge> EdgeFromVertices(const Vertex& src, const Vertex& dst) const;
  std::optional<Edge> EdgeFromPoses(const GaragePoseMsg& src, const GaragePoseMsg& dst) const;

  // Get the transition for a given edge
  std::optional<Transition> GetTransition(const Edge& edge) const;

  // Get pair of vertices (src, dst) from edge index
  std::optional<std::pair<Vertex, Vertex>> VerticesFromEdgeIndex(size_t edge_index) const;

  // Return a vector vertex property map, indexed with default vertex index
  template <typename T>
  VertexVectorPropertyMap<T> MakeVertexVectorPropertyMap(std::optional<T> default_val = std::nullopt) const {
    VertexVectorPropertyMap<T> prop(num_vertices(base_graph_));
    if(default_val) {
      for(auto [iter_curr, iter_end] = GetVertices(); iter_curr != iter_end; ++iter_curr) {
        auto vert = *iter_curr;
        boost::put(prop, vert, default_val.value());
      }
    }
    return prop;
  }

  // Return a vector edge property map, indexed with edge_index_
  template <typename T>
  EdgeVectorPropertyMap<T> MakeEdgeVectorPropertyMap(std::optional<T> default_val = std::nullopt) const {
    EdgeVectorPropertyMap<T> prop(num_edges(base_graph_), edge_index_);
    if(default_val) {
      for(auto [iter_curr, iter_end] = GetEdges(); iter_curr != iter_end; ++iter_curr) {
        auto edge = *iter_curr;
        boost::put(prop, edge, default_val.value());
      }
    }
    return prop;
  }

  /// @brief Sets/stores the optimal retrieval heading for the given node
  void SetRetrievalHeading(uint32_t node_id, int16_t heading) { node_retrieval_heading_[node_id] = heading; }

  /// @return The optimal retrieval heading for the given node, or nullopt if the heading has not been set
  std::optional<int16_t> GetRetrievalHeading(uint32_t node_id) const;

private:
  // Helper function to add an edge to the graph
  void AddEdge(const GaragePoseMsg& src, const GaragePoseMsg& dst, const PoseNeighbor& pose_neighbor);

  // Determines if the movement between the two poses is locomoting or strafing. Assumes that the
  // movement between the poses is not a rotation
  TransitionType LocomoteOrStrafe(const GeometricPoseMsg& src, const GeometricPoseMsg& dst) const;

  // The garage layout
  LayoutSPtr layout_;

  // Base boost graph representation of the pose graph
  BoostPoseGraph base_graph_;

  // insane edge index property map
  boost::property_map<BoostPoseGraph, boost::edge_index_t>::type edge_index_;

  // Map of GaragePose to Vertex index
  std::unordered_map<GaragePoseMsg, Vertex> pose_to_vertex_;

  // List of Vertices by edge index
  std::vector<std::pair<Vertex, Vertex>> edge_index_to_vertices_;

  // Payload optimal heading for retrieval, per each parking space node.
  std::unordered_map<uint32_t, int16_t> node_retrieval_heading_;
};

}  // namespace volley

using GarageGraphSPtr = std::shared_ptr<volley::GarageGraph>;

// Example:
// GarageGraphSPtr garage_graph_ = std::make_shared<const volley::GarageGraph>(pose_graph_);

