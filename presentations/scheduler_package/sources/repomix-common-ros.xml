#include <cmath>
#include <common_ros/garage_graph.hpp>
#include <common_ros/layout.hpp>
#include <common_ros/pose_utils.hpp>
#include <rclcpp/rclcpp.hpp>

namespace volley {

GarageGraph::GarageGraph(const PoseGraph& pose_graph) : layout_(pose_graph.GetLayout()) {
  auto logger = rclcpp::get_logger("garage_graph");

  // initialize internal edge index prop map
  edge_index_ = boost::get(boost::edge_index, base_graph_);

  // Add poses and edges to the graph
  for(const auto& pose : pose_graph.GetPoses()) {
#pragma GCC diagnostic push
// disable boost::optional ... m_storage may be used uninitialized
// This is related to GCC.
// See also:  https://github.com/boostorg/function/issues/27
// See also:
// https://stackoverflow.com/questions/21755206/how-to-get-around-gcc-void-b-4-may-be-used-uninitialized-in-this-funct
// See also:  https://gcc.gnu.org/bugzilla/show_bug.cgi?id=106922
#pragma GCC diagnostic ignored "-Wmaybe-uninitialized"
    auto vert = boost::add_vertex(pose, base_graph_);
#pragma GCC diagnostic pop
    pose_to_vertex_[pose] = vert;
  }

  // Need a second loop so that the pose_to_vertex map gets populated first.
  for(const auto& pose : pose_graph.GetPoses()) {
    // We can use the PoseGraph's PoseNeighbors to add edges to the graph. For each pose, check
    // if it has a neighbor in each of the possible directions. If it does, add an edge
    // between the two poses.
    for(auto pose_neighbor : kPoseNeighbors) {
      auto dest_pose_opt = pose_graph.GetNeighborPose(pose, pose_neighbor);
      if(dest_pose_opt.has_value()) {
        AddEdge(pose, dest_pose_opt.value(), pose_neighbor);
      }
    }
  }

  // Mark edges between VRC floor nodes as VRC_TRANSITION type, and audit bidirectionality.
  // The audit (matching-heading pairs only) acts as a regression check on the VRC_UP/VRC_DOWN
  // split in PoseGraph and gives clear evidence the bidirectional fix is in place.
  size_t vrc_edge_count = 0;
  size_t vrc_pair_count = 0;
  for(const auto& vrc : layout_->GetVrcs()) {
    for(size_t i = 0; i + 1 < vrc.nodes.size(); ++i) {
      const auto& node_a = vrc.nodes[i];
      const auto& node_b = vrc.nodes[i + 1];
      for(int16_t heading_a : GetAllowedHeadings(node_a)) {
        for(int16_t heading_b : GetAllowedHeadings(node_b)) {
          GaragePoseMsg pose_a = ConstructGaragePose(node_a.id, heading_a);
          GaragePoseMsg pose_b = ConstructGaragePose(node_b.id, heading_b);
          auto edge_ab = GetEdgeFromPoses(pose_a, pose_b);
          if(edge_ab.has_value()) {
            base_graph_[edge_ab.value()].type = TransitionType::VRC_TRANSITION;
          }
          auto edge_ba = GetEdgeFromPoses(pose_b, pose_a);
          if(edge_ba.has_value()) {
            base_graph_[edge_ba.value()].type = TransitionType::VRC_TRANSITION;
          }
          if(heading_a != heading_b) {
            continue;
          }
          ++vrc_pair_count;
          if(edge_ab.has_value()) {
            ++vrc_edge_count;
          }
          else {
            RCLCPP_ERROR(logger, "Missing VRC edge: %u(h=%d) -> %u(h=%d) (vrc_id=%u)", node_a.id, heading_a,
                node_b.id, heading_b, vrc.id);
          }
          if(edge_ba.has_value()) {
            ++vrc_edge_count;
          }
          else {
            RCLCPP_ERROR(logger, "Missing VRC edge: %u(h=%d) -> %u(h=%d) (vrc_id=%u)", node_b.id, heading_b,
                node_a.id, heading_a, vrc.id);
          }
        }
      }
    }
  }
  RCLCPP_INFO(logger, "GarageGraph VRC audit: %zu/%zu directed VRC edges present (expected 2x pair count)",
      vrc_edge_count, 2 * vrc_pair_count);
}

bool GarageGraph::HasEdge(const GarageGraph::Edge& edge) const {
  GarageGraph::Vertex src(edge.m_source);
  GarageGraph::Vertex dst(edge.m_target);
  if(!HasVertex(src) || !HasVertex(dst)) {
    return false;
  }
  return boost::edge(edge.m_source, edge.m_target, base_graph_).second;
}

std::optional<GarageGraph::Vertex> GarageGraph::GetVertexFromPose(const GaragePoseMsg& pose) const {
  if(!HasPose(pose)) {
    return std::nullopt;
  }
  return pose_to_vertex_.at(pose);
}

std::optional<GaragePoseMsg> GarageGraph::GetPoseFromVertex(const GarageGraph::Vertex& vertex) const {
  if(!HasVertex(vertex)) {
    return std::nullopt;
  }
  return boost::get(boost::vertex_bundle, base_graph_)[vertex];
}

std::optional<std::array<GaragePoseMsg, 2>> GarageGraph::GetPosesFromEdge(const Edge& edge) const {
  auto edge_idx_opt = GetEdgeIndex(edge);
  if(!edge_idx_opt.has_value()) {
    return std::nullopt;
  }
  auto [src, dst] = VerticesFromEdgeIndex(edge_idx_opt.value()).value();
  return std::array<GaragePoseMsg, 2> {GetPoseFromVertex(src).value(), GetPoseFromVertex(dst).value()};
}

std::optional<GarageGraph::Edge> GarageGraph::GetEdgeFromVertices(
    const Vertex& src, const Vertex& dst) const {
  auto get_edge = boost::edge(src, dst, base_graph_);
  if(get_edge.second) {
    return get_edge.first;
  }
  return std::nullopt;
}

std::optional<GarageGraph::Edge> GarageGraph::GetEdgeFromPoses(
    const GaragePoseMsg& src, const GaragePoseMsg& dst) const {
  auto src_opt = GetVertexFromPose(src);
  if(!src_opt) {
    return std::nullopt;
  }
  auto dst_opt = GetVertexFromPose(dst);
  if(!dst_opt) {
    return std::nullopt;
  }
  return GetEdgeFromVertices(src_opt.value(), dst_opt.value());
}

std::vector<GarageGraph::Vertex> GarageGraph::GetVerticesOfType(unsigned int type) const {
  std::vector<GarageGraph::Vertex> vertices;
  for(auto [iter_curr, iter_end] = GetVertices(); iter_curr != iter_end; ++iter_curr) {
    auto node_opt = GarageNodeFromVertex(*iter_curr);
    if(node_opt.has_value() && node_opt->type == type) {
      vertices.push_back(*iter_curr);
    }
  }

  return vertices;
}

std::vector<GaragePoseMsg> GarageGraph::GetAgvChargePoses() const {
  std::vector<GaragePoseMsg> poses;
  for(auto node_id : layout_->GetNodeIdsOfType(GarageNodeMsg::TYPE_AGV_CHARGE)) {
    if(layout_->GetNodeById(node_id).has_value()) {
      poses.push_back(ConstructGaragePose(
          node_id, static_cast<int16_t>(GetInboundHeading(layout_->GetNodeById(node_id).value()))));
    }
  }

  return poses;
}

std::vector<GaragePoseMsg> GarageGraph::GetBayDoorPoses() const {
  std::vector<GaragePoseMsg> poses;
  for(auto node_id : layout_->GetBayLikeNodeIds()) {
    if(layout_->GetNodeById(node_id).has_value()) {
      poses.push_back(ConstructGaragePose(
          node_id, static_cast<int16_t>(GetInboundHeading(layout_->GetNodeById(node_id).value()))));
    }
  }

  return poses;
}

std::optional<size_t> GarageGraph::GetEdgeIndex(const Edge& edge) const {
  if(!HasEdge(edge)) {
    return std::nullopt;
  }
  return edge_index_[edge];
}

std::optional<GeometricPoseMsg> GarageGraph::LocationFromGaragePose(const GaragePoseMsg& garage_pose) const {
  auto node_opt = layout_->GetNodeById(garage_pose.node_id);
  if(!node_opt.has_value()) {
    return std::nullopt;
  }
  return ConstructPose(node_opt.value(), garage_pose.heading);
}

std::optional<GeometricPoseMsg> GarageGraph::LocationFromVertex(const GarageGraph::Vertex& vertex) const {
  if(!HasVertex(vertex)) {
    return std::nullopt;
  }
  return LocationFromGaragePose(boost::get(boost::vertex_bundle, base_graph_)[vertex]);
}

std::optional<GarageNodeMsg> GarageGraph::GarageNodeFromVertex(const GarageGraph::Vertex& vertex) const {
  if(!HasVertex(vertex)) {
    return std::nullopt;
  }
  return layout_->GetNodeById(boost::get(boost::vertex_bundle, base_graph_)[vertex].node_id);
}

std::vector<GarageGraph::Vertex> GarageGraph::GetVerticesAtGarageNode(const GarageNodeMsg& node) const {
  std::vector<GarageGraph::Vertex> vertices;
  for(int16_t heading : GetAllowedHeadings(node)) {
    auto pose = ConstructGaragePose(node.id, heading);
    // If the node doesn't exist in the GarageGraph, then the returned vector will be empty.
    if(HasPose(pose)) {
      vertices.push_back(pose_to_vertex_.at(pose));
    }
  }

  return vertices;
}

std::optional<GarageGraph::Edge> GarageGraph::EdgeFromVertices(
    const GarageGraph::Vertex& src, const GarageGraph::Vertex& dst) const {
  // It seems like boost::edge may crash if the src and dest don't exist in the graph
  if(!HasVertex(src) || !HasVertex(dst)) {
    return std::nullopt;
  }

  auto [edge, exists] = boost::edge(src, dst, base_graph_);
  if(!exists) {
    return std::nullopt;
  }
  return edge;
}

std::optional<GarageGraph::Edge> GarageGraph::EdgeFromPoses(
    const GaragePoseMsg& src, const GaragePoseMsg& dst) const {
  if(!HasPose(src) || !HasPose(dst)) {
    return std::nullopt;
  }
  return EdgeFromVertices(pose_to_vertex_.at(src), pose_to_vertex_.at(dst));
}

std::optional<Transition> GarageGraph::GetTransition(const GarageGraph::Edge& edge) const {
  if(!HasEdge(edge)) {
    return std::nullopt;
  }

  return base_graph_[edge];
}

std::optional<std::pair<GarageGraph::Vertex, GarageGraph::Vertex>> GarageGraph::VerticesFromEdgeIndex(
    size_t edge_index) const {
  // Make sure edge index exists
  if(edge_index >= edge_index_to_vertices_.size()) {
    return std::nullopt;
  }

  return edge_index_to_vertices_[edge_index];
}

std::optional<int16_t> GarageGraph::GetRetrievalHeading(uint32_t node_id) const {
  if(!node_retrieval_heading_.contains(node_id)) {
    return {};
  }
  return node_retrieval_heading_.at(node_id);
}

void GarageGraph::AddEdge(
    const GaragePoseMsg& src, const GaragePoseMsg& dst, const PoseNeighbor& pose_neighbor) {
  auto src_geometric = layout_->GetGeometricPoseAtPose(src).value();
  auto dst_geometric = layout_->GetGeometricPoseAtPose(dst).value();

  // Create the Transition between the poses. Transition ID is current number of edges
  Transition transition;
  if(pose_neighbor == PoseNeighbor::ROT_LEFT || pose_neighbor == PoseNeighbor::ROT_RIGHT) {
    // If this edge is a rotation, the transition length represents the rotation distance in
    // radians
    transition.type = TransitionType::ROTATION;
    transition.length = volley::AngleDist(src_geometric.yaw, dst_geometric.yaw);
  }
  else if(pose_neighbor == PoseNeighbor::VRC_UP || pose_neighbor == PoseNeighbor::VRC_DOWN) {
    // VRC length is the absolute floor-to-floor height from the layout; the cost model
    // turns it into a duration with a trapezoid velocity profile.
    transition.type = TransitionType::VRC_TRANSITION;
    auto src_z = layout_->GetFloorZForNodeId(src.node_id);
    auto dst_z = layout_->GetFloorZForNodeId(dst.node_id);
    if(!src_z || !dst_z) {
      throw std::invalid_argument(
          "VRC edge endpoint missing floor z in layout: src node_id=" + std::to_string(src.node_id) +
          " dst node_id=" + std::to_string(dst.node_id));
    }
    transition.length = std::abs(dst_z.value() - src_z.value());
  }
  else {
    transition.type = LocomoteOrStrafe(src_geometric, dst_geometric);
    transition.length = PoseDistance(src_geometric, dst_geometric);
  }

  // Add edge to graph and update edge index
  size_t next_edge_index = boost::num_edges(base_graph_);
  Edge e;
  bool added = false;
  std::tie(e, added) =
      boost::add_edge(pose_to_vertex_[src], pose_to_vertex_[dst], {next_edge_index, transition}, base_graph_);
  boost::put(edge_index_, e, next_edge_index);

  edge_index_to_vertices_.emplace_back(
      std::pair<GarageGraph::Vertex, GarageGraph::Vertex>(pose_to_vertex_[src], pose_to_vertex_[dst]));
}

TransitionType GarageGraph::LocomoteOrStrafe(const GeometricPoseMsg& src, const GeometricPoseMsg& dst) const {
  auto dx = dst.x - src.x;
  auto dy = dst.y - src.y;
  auto angle_of_motion = atan2(dy, dx);

  // src.yaw is set by Layout::GetGeometricPoseAtPose() as `kDeg2Rad * heading`, which leaves
  // it in *Volley* heading convention (heading 0 = +y, CCW positive) — NOT the math /
  // atan2 convention (0 = +x). Comparing the two directly was off by π/2 and caused every
  // LOCOMOTE to be classified as STRAFE and vice-versa. Add the offset to put both sides
  // in the same frame before measuring the angular separation. Equivalent and consistent
  // with `IsLocomoteOrStrafe` in agv_motion_type.cpp, which already used this convention.
  auto math_yaw = M_PI_2 + src.yaw;
  auto relative_heading = volley::AngleDist<double>(math_yaw, angle_of_motion);
  auto dist = hypot(dx, dy);

  auto dist_locomote = dist * abs(cos(relative_heading));
  auto dist_strafe = dist * abs(sin(relative_heading));

  if(dist_locomote > dist_strafe) {
    return TransitionType::LOCOMOTE;
  }
  else {
    return TransitionType::STRAFE;
  }
}

