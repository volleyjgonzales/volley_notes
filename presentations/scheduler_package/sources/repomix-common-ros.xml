  best_effort_qos.durability_volatile();
  return best_effort_qos;
}

rclcpp::QoS GetReliableQoS(size_t history_depth) {
  rclcpp::QoS reliable_qos(history_depth);
  reliable_qos.reliable();
  reliable_qos.durability_volatile();
  return reliable_qos;
}

rclcpp::QoS GetLatchingQoS(size_t history_depth) {
  rclcpp::QoS latching_qos(history_depth);
  latching_qos.transient_local();
  return latching_qos;
}

void PrintEvent(const rclcpp::Logger& logger, const GarageEventMsg& event) {
