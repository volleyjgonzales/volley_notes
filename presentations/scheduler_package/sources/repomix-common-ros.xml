#include "common_ros/layout.hpp"

#include <yaml-cpp/yaml.h>

#include <algorithm>
#include <common/constants.hpp>
#include <common/geometry_utils.hpp>
#include <common/math_utils.hpp>
#include <common/md5.hpp>
#include <exception>
#include <filesystem>
#include <format>
#include <interfaces/msg/garage_node.hpp>
#include <limits>
#include <queue>
#include <site_config/paths.hpp>
#include <stdexcept>
#include <stdx/expected.hpp>
#include <string>

#include "common_ros/common_ros_msgs.hpp"
#include "common_ros/roslog.hpp"

namespace {

bool IsLiftNode(const GarageNodeMsg& node) {
  return node.type == GarageNodeMsg::TYPE_LIFT || node.type == GarageNodeMsg::TYPE_BLIFT;
}

}  // namespace

namespace volley {

int GetInboundHeading(const GarageNodeMsg& node) {
  return node.headings.at(0) + node.faces_reciprocal * 180;
}

volley::Segment GetEdge(const GarageNodeMsg& n1, const GarageNodeMsg& n2) {
  if(n1.floor != n2.floor && !(IsLiftNode(n1) && IsLiftNode(n2))) {
    throw std::invalid_argument(
        std::format("Segments between nodes on different floors must be between lift nodes: "
                    "(id={}, type={}, x={}, y={}) and (id={}, type={}, x={}, y={})",
            n1.id, n1.type, n1.x, n1.y, n2.id, n2.type, n2.x, n2.y));
  }

  const uint32_t floor = IsLiftNode(n1) ? n2.floor : n1.floor;
  return volley::Segment {Eigen::Vector2d {n1.x, n1.y}, Eigen::Vector2d {n2.x, n2.y}, floor};
}

// Given a yaw in radians and a list of possible node headings in degrees, find the heading
// (including reciprocals) that yaw is closest too.
std::optional<int16_t> GetClosestHeading(double yaw_rad, std::vector<int16_t> possible_headings,
    double tolerance_rad = std::numeric_limits<double>::infinity()) {
  auto min_angle = std::numeric_limits<double>::infinity();
  auto min_heading = std::numeric_limits<int>::max();
  for(int16_t heading_deg : possible_headings) {
    // Check if yaw matches the heading or its reciprocal
    volley::Angle heading {heading_deg * kDeg2Rad};
    volley::Angle heading_reciprocal {heading_deg * kDeg2Rad + M_PI};
    volley::Angle yaw {yaw_rad};
    double dyaw = std::abs((heading - yaw)).value;
    double dyaw_reciprocal = std::abs((heading_reciprocal - yaw)).value;

    if(dyaw < tolerance_rad && dyaw < min_angle) {
      min_angle = dyaw;
      min_heading = heading_deg;
    }

    if(dyaw_reciprocal < tolerance_rad && dyaw_reciprocal < min_angle) {
      min_angle = dyaw_reciprocal;
      min_heading = heading_deg + 180;
    }
  }

  if(min_heading != std::numeric_limits<int>::max()) {
    return static_cast<int16_t>(volley::Wrap(min_heading));
  }

  return {};
}

Layout::Layout(YAML::Node layout_yaml) {
  // Save the scenario name
  name_ = layout_yaml["name"].as<std::string>();

  // Extract the parking window buffer
  auto buffer_yaml = layout_yaml["parking_window_buffer"];
  parking_window_buffer_.name = "buffer";
  parking_window_buffer_.length_m = buffer_yaml["length_m"].as<float>();
  parking_window_buffer_.width_m = buffer_yaml["width_m"].as<float>();

  // Extract the parking windows.
  //
  // `height_m` is optional. When omitted, the field stays 0 (sentinel for "not provided");
  // GetSmallestEnclosingResourceSizeIndex treats height_m == 0 as height-unconstrained. When
  // provided, the value must not exceed the physical bay clearance (kBayHeight).
  for(const auto& yaml_node : layout_yaml["parking_windows"]) {
    ParkingWindowMsg parking_window {};
    parking_window.name = yaml_node["name"].as<std::string>();
    parking_window.length_m = yaml_node["length_m"].as<float>();
    parking_window.width_m = yaml_node["width_m"].as<float>();
    if(yaml_node["height_m"]) {
      parking_window.height_m = yaml_node["height_m"].as<float>();
      if(parking_window.height_m > kBayHeight) {
        throw std::runtime_error(std::format(
            "Parking window '{}' has height_m={} which exceeds the physical bay clearance kBayHeight={}",
            parking_window.name, parking_window.height_m, kBayHeight));
      }
    }
    resource_windows_.emplace_back(parking_window);
  }

  // Include the standard tray size.
  {
    ParkingWindowMsg parking_window {};
    parking_window.name = "TRAY";
    parking_window.length_m = kTrayLength;
    parking_window.width_m = kTrayWidth;
    parking_window.height_m = kTrayHeight;
    resource_windows_.emplace_back(parking_window);
  }

  // Sort the resource windows by area
  std::sort(resource_windows_.begin(), resource_windows_.end(),
      [](const ParkingWindowMsg& a, const ParkingWindowMsg& b) {
        double area_a = a.length_m * a.width_m;
        double area_b = b.length_m * b.width_m;
        return area_a < area_b;  // increasing order
      });

  // Verify that "TRAY" is the smallest
  if(resource_windows_.at(0).name != "TRAY") {
    throw std::runtime_error("A parking window smaller than the default tray size was found!");
  }

  // Verify that resource windows fit inside one another.
  for(size_t i = 0; i + 1 < resource_windows_.size(); i++) {
    auto a = resource_windows_.at(i);
    auto b = resource_windows_.at(i + 1);
    if(a.length_m > b.length_m || a.width_m > b.width_m) {
      throw std::runtime_error("Parking windows do not nest within one another!");
    }
    else if(a.length_m == b.length_m && a.width_m == b.width_m) {
      throw std::runtime_error("Parking windows of equal size found!");
    }
  }

  // Construct resource_name_to_index_
  for(size_t i = 0; i < resource_windows_.size(); i++) {
    resource_name_to_index_.emplace(resource_windows_.at(i).name, i);
  }

  // Extract the rotation circle tape radius if it exists
  if(layout_yaml["rotation_circle_tape_radius"]) {
    tape_circle_radius_ = layout_yaml["rotation_circle_tape_radius"].as<double>();
  }

  // Store the bay prioritization as a priority queue of pairs (prioritization value, bay id) that
  // gets sorted in order of descending prioritization value
  std::priority_queue<std::pair<int, uint16_t>> bay_prioritization_pq;

  // If floors are specified in the layout file, parse them. Otherwise, assume just a single default floor
  // with ID and z set to 0.
  if(layout_yaml["floors"]) {
    for(const auto& yaml_floor : layout_yaml["floors"]) {
      GarageFloorMsg floor {};
      floor.id = yaml_floor["id"].as<uint32_t>();
      floor.z = yaml_floor["z"].as<float>();

      floors_.emplace_back(floor);
    }
  }
  else {
    GarageFloorMsg floor;
    floor.id = 0;
    floor.z = 0;
    floors_.push_back(floor);
  }

  // Floors too
  for(size_t i = 0; i < floors_.size(); i++) {
    floor_id_to_index_[floors_.at(i).id] = i;
  }

  // Extract the nodes
  for(const auto& yaml_node : layout_yaml["nodes"]) {
    GarageNodeMsg node {};
    node.id = yaml_node["id"].as<uint32_t>();
    node.x = yaml_node["x"].as<float>();
    node.y = yaml_node["y"].as<float>();
    if(yaml_node["floor"]) {
      node.floor = yaml_node["floor"].as<uint32_t>();
    }
    else {
      node.floor = 0;
    }

    auto node_type = yaml_node["type"].as<std::string>();
    if(node_type == "Bay" || node_type == "BLift") {
      // A BLift is a Bay that is also a Lift (VRC) terminal. It uses the
      // same bay setup (prioritization, insert_floor, system_floors) as a
      // plain Bay; the distinction is exposed via node.type so that lift
      // routing can also treat it as a lift node.
      node.type = (node_type == "BLift") ? GarageNodeMsg::TYPE_BLIFT : GarageNodeMsg::TYPE_BAY;
      auto bay_id = yaml_node["id"].as<uint16_t>();
      // If the bay does not have a prioritization value defined in the layout file, give it a
      // neutral value of 0
      int value = 0;
      if(yaml_node["prioritization_value"]) {
        value = yaml_node["prioritization_value"].as<int>();
      }

      if(yaml_node["insert_floor"]) {
        bay_insert_floors_[bay_id] = yaml_node["insert_floor"].as<uint8_t>();
      }
      else {
        bay_insert_floors_[bay_id] = node.floor;
      }

      if(yaml_node["system_floors"]) {
        bay_system_floors_[bay_id] = yaml_node["system_floors"].as<std::vector<uint8_t>>();
      }
      else {
        bay_system_floors_[bay_id] = {node.floor};
      }

      node.insert_floor = bay_insert_floors_[bay_id];
      node.system_floors = bay_system_floors_[bay_id];

      bay_prioritization_pq.push(std::pair<int, uint16_t>(value, bay_id));
    }
    else if(node_type == "Waypoint") {
      node.type = GarageNodeMsg::TYPE_WAYPOINT;
    }
    else if(node_type == "AgvCharge") {
      node.type = GarageNodeMsg::TYPE_AGV_CHARGE;
    }
    else if(node_type == "EvCharge") {
      node.type = GarageNodeMsg::TYPE_EV_CHARGE;
    }
    else if(node_type == "Parking") {
      node.type = GarageNodeMsg::TYPE_PARKING;
    }
    else if(node_type == "Lift") {
      node.type = GarageNodeMsg::TYPE_LIFT;
    }
    else {
      ERRORF(rclcpp::get_logger(""), "UNKNOWN  node type: %s", node_type.c_str());
      throw std::runtime_error("Invalid node_type found in the layout file!");
    }

    if(node_ids_by_type_.find(node.type) == node_ids_by_type_.end()) {
      node_ids_by_type_.emplace(node.type, std::vector<uint32_t>());
    }
    node_ids_by_type_.at(node.type).emplace_back(node.id);

    node.max_resource_size = yaml_node["max_resource_size"].as<std::string>();

    {  // look up the resource size index
      auto it = resource_name_to_index_.find(node.max_resource_size);
      if(it == resource_name_to_index_.end()) {
        throw std::runtime_error(
            "Node " + std::to_string(node.id) + " has unknown resource size " + node.max_resource_size);
      }
      node.max_resource_size_index = it->second;
    }

    node.rotation_allowed = yaml_node["rotation_allowed"].as<bool>();

    for(const auto& yaml_heading : yaml_node["headings"]) {
      node.headings.emplace_back(yaml_heading.as<uint16_t>());
    }

    // Sort the headings to help ensure determinism
    std::sort(node.headings.begin(), node.headings.end());

    if(yaml_node["faces_reciprocal"]) {
      node.faces_reciprocal = yaml_node["faces_reciprocal"].as<bool>();
    }

    nodes_.emplace_back(node);
  }

  // Sort the nodes by node_id
  std::sort(nodes_.begin(), nodes_.end(), [](const GarageNodeMsg& a, const GarageNodeMsg& b) {
    return a.id < b.id;  // increasing order
  });

  // Construct our indices
  for(size_t i = 0; i < nodes_.size(); i++) {
    node_id_to_index_[nodes_.at(i).id] = i;
  }

  // Extract the edges
  for(const auto& yaml_edge : layout_yaml["edges"]) {
    auto src = yaml_edge["src"].as<int>();
    auto dst = yaml_edge["dst"].as<int>();
    auto a = std::min(src, dst);
    auto b = std::max(src, dst);
    boost::add_edge(node_id_to_index_[a], node_id_to_index_[b], graph_);

    // Store any disallowed edge orientations
    if(YAML::Node disallowed_edge_orientation = yaml_edge["disallowed_edge_orientation"]) {
      disallowed_edge_orientations_.emplace(std::make_pair(a, b), disallowed_edge_orientation.as<uint32_t>());
    }
  }

  // Store the bay ids in order of state preference. The first bay is most preferred to be in
  // ready for insert, the last most preferred to be ready for retrieve
  while(!bay_prioritization_pq.empty()) {
    auto bay_id = bay_prioritization_pq.top().second;
    bay_prioritization_.push_back(bay_id);
    bay_prioritization_pq.pop();
  }

  // Extract VRCs
  if(layout_yaml["vrcs"]) {
    for(const auto& vrc_yaml : layout_yaml["vrcs"]) {
      Vrc vrc;
      vrc.id = vrc_yaml["id"].as<uint32_t>();
      vrc.root_node_id = vrc_yaml["root_node"].as<uint32_t>();
      for(const uint32_t node_id : vrc_yaml["nodes"].as<std::vector<uint32_t>>()) {
        const auto node = GetNodeById(node_id);
        if(!node.has_value()) {
          throw std::runtime_error("Unknown node ID specified for VRC with id=" + std::to_string(vrc.id));
        }
        vrc.nodes.push_back(std::move(node.value()));
      }
      // Sort the VRC nodes by floor
      std::sort(vrc.nodes.begin(), vrc.nodes.end(), [](const GarageNodeMsg& a, const GarageNodeMsg& b) {
        return a.floor < b.floor;  // increasing order
      });

      // Add edges between adjacent floors of the VRC
      for(std::size_t i = 0; i < vrc.nodes.size() - 1; i++) {
        const auto a = std::min(vrc.nodes[i].id, vrc.nodes[i + 1].id);
        const auto b = std::max(vrc.nodes[i].id, vrc.nodes[i + 1].id);
        boost::add_edge(node_id_to_index_[a], node_id_to_index_[b], graph_);
      }

      vrcs_[vrc.id] = std::move(vrc);
    }
  }
}

Layout::Layout(const std::filesystem::path& file) : Layout(YAML::LoadFile(file)) {
  // Set the md5sum.
  md5sum_ = volley::GetMD5Sum(file).value_or("");
}

bool Layout::HasNode(uint32_t node_id) const {
  return node_id_to_index_.find(node_id) != node_id_to_index_.end();
}

bool Layout::HasGaragePose(const GaragePoseMsg& pose) const {
  if(!HasNode(pose.node_id)) {
    return false;
  }

  for(const auto& heading : nodes_.at(node_id_to_index_.at(pose.node_id)).headings) {
    if(volley::IsAngleOrReciprocal(pose.heading, heading)) {
      return true;
    }
  }

  return false;
}

bool Layout::HasEdge(uint32_t src, uint32_t dst) const {
  if(!HasNode(src) || !HasNode(dst)) {
    return false;
  }

  // We only have a legal self-edge if we can rotate
  if(src == dst) {
    return GetNodeById(src)->rotation_allowed;
  }

  return boost::edge(node_id_to_index_.at(src), node_id_to_index_.at(dst), graph_).second;
}

std::optional<uint16_t> Layout::GetDisallowedEdgeOrientation(uint32_t src, uint32_t dst) const {
  auto a = std::min(src, dst);
  auto b = std::max(src, dst);
  auto it = disallowed_edge_orientations_.find(std::make_pair(a, b));
  if(it == disallowed_edge_orientations_.end()) {
    return std::nullopt;
  }
  return it->second;
}

// Note: as implemented, this function just checks if the current edge is collinear with an edge
// from a bay. The algorithm does not confirm that the edge is connected to the bay (it might be
// collinear but then be routed around a post in the garage, for instance). When we have a pose
// graph representation of the layout here, we could easily and quickly verify that the edges are
// connected and all intermediate edges are collinear.
std::optional<std::pair<double, bool>> Layout::GetDistanceToClosestValidBay(
    const GaragePoseMsg& src, const GaragePoseMsg& dst, const GeometricPoseMsg& pose) const {
  // If the edge in question doesn't exist, no reason to continue
  if(!HasEdge(src.node_id, dst.node_id)) {
    return {};
  }

  // Segment we are checking against. We know that the src and dst nodes exist.
  volley::Segment edge = GetEdge(GetNodeById(src.node_id).value(), GetNodeById(dst.node_id).value());

  std::optional<std::pair<double, bool>> return_values = {};
  auto min_dist = std::numeric_limits<double>::infinity();

  auto bay_node_ids = GetBayLikeNodeIds();
  for(const auto& bay_node_id : bay_node_ids) {
    auto bay_node = GetNodeById(bay_node_id).value();
    GeometricPoseMsg bay_pose {};
    bay_pose.x = bay_node.x;
    bay_pose.y = bay_node.y;

    // Check that the dst pose above matches with the bay heading. If not, no reason to keep
    // searching through this bay
    if(!volley::IsAngleOrReciprocal(dst.heading, bay_node.headings[0])) {
      continue;
    }

    // Look at all the edges coming out of the bay node. If any of them are collinear with the
    // edge in question, find the distance to the node and store it if it is the minimum so far
    auto neighboring_nodes = GetNeighboringNodes(bay_node_id);
    for(const auto& ni : neighboring_nodes) {
      volley::Segment bay_edge = GetEdge(bay_node, ni);  // Edge from a node to the bay
      if(AreCollinear(bay_edge, edge)) {
        double dist_to_bay = CalcDistFromPose(pose, bay_pose).first.norm();
        if(dist_to_bay < min_dist) {
          min_dist = dist_to_bay;
          bool moving_towards_bay = not AreSameDirection(bay_edge, edge);
          return_values = std::make_pair(dist_to_bay, moving_towards_bay);
        }
      }
    }
  }

  return return_values;
}

bool Layout::IsStraightLine(const GaragePoseMsg& p1, const GaragePoseMsg& p2, const GaragePoseMsg& p3) const {
  // First, check for if these are two successive rotations
  // For successive rotations, the node id's will all be the same and the headings will all be
  // different
  bool node_ids_same = p1.node_id == p2.node_id && p2.node_id == p3.node_id;
  bool headings_unique = p1.heading != p2.heading && p2.heading != p3.heading && p1.heading != p3.heading;
  if(node_ids_same && headings_unique) {
    // check if the two heading differences are in the same direction
    double p1top2 = volley::SignedAngleDist(p2.heading, p1.heading);
    double p3top2 = volley::SignedAngleDist(p3.heading, p2.heading);
    return volley::SameSign(p1top2, p3top2);
  }

  // Now, check if these form a straight linear line
  // Check if the nodes are unique
  if(p1.node_id == p2.node_id || p2.node_id == p3.node_id || p1.node_id == p3.node_id) {
    return false;
  }

  // Check if the headings are different
  if(p1.heading != p2.heading || p2.heading != p3.heading) {
    return false;
  }

  // Check if the proper edges exist
  if(!HasEdge(p1.node_id, p2.node_id) || !HasEdge(p2.node_id, p3.node_id)) {
    return false;
  }

  // Note: we know the nodes exist here because we did the edge checks above
  GarageNodeMsg n1 = GetNodeById(p1.node_id).value();
  GarageNodeMsg n2 = GetNodeById(p2.node_id).value();
  GarageNodeMsg n3 = GetNodeById(p3.node_id).value();

  return AreParallel(GetEdge(n1, n2), GetEdge(n2, n3));
}

const std::vector<uint32_t>& Layout::GetNodeIdsOfType(GarageNodeMsg::_type_type node_type) const {
  if(node_ids_by_type_.find(node_type) == node_ids_by_type_.end()) {
    static std::vector<uint32_t> dummy;
    return dummy;
  }
  return node_ids_by_type_.at(node_type);
}

std::vector<uint32_t> Layout::GetBayLikeNodeIds() const {
  std::vector<uint32_t> ids = GetNodeIdsOfType(GarageNodeMsg::TYPE_BAY);
  const auto& blift_ids = GetNodeIdsOfType(GarageNodeMsg::TYPE_BLIFT);
  ids.insert(ids.end(), blift_ids.begin(), blift_ids.end());
  return ids;
}

std::optional<GarageNodeMsg> Layout::GetNodeById(uint32_t node_id) const {
  if(HasNode(node_id)) {
    return nodes_[node_id_to_index_.at(node_id)];
  }
  return std::nullopt;
}

std::optional<GarageFloorMsg> Layout::GetFloorById(uint32_t floor_id) const {
  auto it = floor_id_to_index_.find(floor_id);
  if(it == floor_id_to_index_.end()) {
    return std::nullopt;
  }
  return floors_[it->second];
}

std::optional<float> Layout::GetFloorZForNodeId(const uint32_t node_id) const {
  if(!HasNode(node_id)) {
    return std::nullopt;
  }

  const GarageNodeMsg node = nodes_[node_id_to_index_.at(node_id)];
  const auto floor = GetFloorById(node.floor);

  if(!floor.has_value()) {
    return std::nullopt;
  }

  return floor.value().z;
}

std::optional<float> Layout::GetFloorZForFloorId(const uint32_t floor_id) const {
  const auto floor = GetFloorById(floor_id);
  if(!floor.has_value()) {
    return 0.0;
  }
  return floor.value().z;
}

std::optional<ParkingWindowMsg> Layout::GetResourceWindow(int resource_size_index) const {
  if(0 <= resource_size_index && resource_size_index < static_cast<int>(resource_windows_.size())) {
    return resource_windows_.at(resource_size_index);
  }
  return std::nullopt;
}

std::optional<ParkingWindowMsg> Layout::GetResourceWindow(const std::string& name) const {
  auto it = resource_name_to_index_.find(name);
  if(it != resource_name_to_index_.end()) {
    const uint32_t index = it->second;
    return resource_windows_.at(index);
  }
  return std::nullopt;
}

std::optional<ParkingWindowMsg> GetBufferedResourceWindowHelper(
    std::optional<ParkingWindowMsg> window_opt, const ParkingWindowMsg& parking_window_buffer) {
  if(window_opt.has_value()) {
    ParkingWindowMsg window = window_opt.value();
    ParkingWindowMsg buffered_window {};
    buffered_window.name = window.name;
    buffered_window.length_m = window.length_m + parking_window_buffer.length_m;
    buffered_window.width_m = window.width_m + parking_window_buffer.width_m;
    return buffered_window;
  }
  return std::nullopt;
}

std::optional<ParkingWindowMsg> Layout::GetBufferedResourceWindow(int resource_size_index) const {
  auto window_opt = GetResourceWindow(resource_size_index);
  return GetBufferedResourceWindowHelper(window_opt, parking_window_buffer_);
}

std::optional<ParkingWindowMsg> Layout::GetBufferedResourceWindow(const std::string& name) const {
  auto window_opt = GetResourceWindow(name);
  return GetBufferedResourceWindowHelper(window_opt, parking_window_buffer_);
}

std::optional<GarageNodeMsg> Layout::GetClosestNode(
    float x, float y, const std::vector<GarageNodeMsg>& possible_nodes, float tolerance) const {
  float min_dist = tolerance;
  std::optional<GarageNodeMsg> best_node = {};
  for(const auto& node : possible_nodes) {
    float dist = std::hypot(x - node.x, y - node.y);
    if(dist < min_dist) {
      best_node = node;
      min_dist = dist;
    }
  }

  return best_node;
}

std::optional<GeometricPoseMsg> Layout::GetGeometricPoseAtPose(const GaragePoseMsg& garage_pose) const {
  if(!HasGaragePose(garage_pose)) {
    // This garage pose does not exist!
    return std::nullopt;
  }

  auto node = GetNodeById(garage_pose.node_id).value();
  GeometricPoseMsg geometric_pose {};
  geometric_pose.x = node.x;
  geometric_pose.y = node.y;
  geometric_pose.yaw = static_cast<float>(kDeg2Rad * garage_pose.heading);

  return geometric_pose;
}

std::optional<GaragePoseMsg> Layout::GetPoseAtGeometricPose(
    const GeometricPoseMsg& geometric_pose, const GeometricPoseMsg& tolerance) const {
  // Get the closest node.
  auto node =
      GetClosestNode(geometric_pose.x, geometric_pose.y, nodes_, std::hypot(tolerance.x, tolerance.y));
  if(node) {
    // Get the closest heading
    auto heading = GetClosestHeading(geometric_pose.yaw, node.value().headings, tolerance.yaw);
    if(heading) {
      GaragePoseMsg garage_pose;
      garage_pose.node_id = node.value().id;
      garage_pose.heading = heading.value();
      return garage_pose;
    }
  }
  return std::nullopt;
}

std::vector<GarageNodeMsg> Layout::GetNeighboringNodes(uint32_t node_id) const {
  std::vector<GarageNodeMsg> neighboring_nodes;
  if(!HasNode(node_id)) {
    // The node_id is invalid. It doesn't have any neighbors
    return neighboring_nodes;
  }

  uint32_t src_node_index = node_id_to_index_.at(node_id);
  GarageNodeMsg src_node = nodes_.at(src_node_index);
  for(const auto& neighbor_index : make_iterator_range(boost::adjacent_vertices(src_node_index, graph_))) {
    neighboring_nodes.emplace_back(nodes_.at(neighbor_index));
  }

  return neighboring_nodes;
}

std::optional<GaragePoseMsg> Layout::GetClosestNeighboringPose(
    const GaragePoseMsg& last_pose, const GeometricPoseMsg& current_geometry_pose) const {
  if(!HasNode(last_pose.node_id)) {
    // The last node is invalid. No reason to proceed.
    return {};
  }

  // First, find which node we are closest to in x/y distance. We will check the last pose and the
  // neighbors
  std::vector<GarageNodeMsg> possible_nodes = GetNeighboringNodes(last_pose.node_id);
  possible_nodes.emplace_back(nodes_.at(node_id_to_index_.at(last_pose.node_id)));  // Include itself
  auto closest_node = GetClosestNode(current_geometry_pose.x, current_geometry_pose.y, possible_nodes);
  std::optional<GaragePoseMsg> closest_pose = {};
  if(closest_node) {
    // Get the closest heading
    auto heading = GetClosestHeading(current_geometry_pose.yaw, closest_node.value().headings);
    if(heading) {
      GaragePoseMsg pose {};
      pose.node_id = closest_node.value().id;
      pose.heading = heading.value();
      closest_pose = pose;
    }
  }

  return closest_pose;
}

std::optional<int> Layout::GetSmallestEnclosingResourceSizeIndex(
    double length, double width, double height) const {
  // Resources are stored in increasing order, so
  // we can return the first one that works.
  for(size_t i = 0; i < resource_windows_.size(); ++i) {
    const auto& resource_window = resource_windows_.at(i);
    // A window with height_m == 0 is treated as height-unconstrained — this preserves legacy
    // behavior for layouts that don't specify per-window heights. The caller can also pass
    // height == 0 to skip the height check entirely.
    const bool height_fits = resource_window.height_m == 0.0f || height <= resource_window.height_m;
    if(length <= resource_window.length_m && width <= resource_window.width_m && height_fits) {
      return i;
    }
  }

  return std::nullopt;
}

std::optional<int> Layout::GetBayInboundHeading(uint32_t bay_id) const {
  auto node_opt = GetNodeById(bay_id);

  if(!node_opt.has_value() || (node_opt.value().type != GarageNodeMsg::TYPE_BAY &&
                                  node_opt.value().type != GarageNodeMsg::TYPE_BLIFT)) {
    // This bay_id is not a node or this node is not a bay (or blift)
    return {};
  }

  return volley::Wrap(GetInboundHeading(node_opt.value()));
}

GarageLayoutMsg Layout::GetGarageLayout() const {
  GarageLayoutMsg layout;

  layout.name = name_;

  layout.nodes = nodes_;

  boost::graph_traits<graph>::edge_iterator ei, ei_end;
  for(std::tie(ei, ei_end) = edges(graph_); ei != ei_end; ++ei) {
    EdgeMsg edge;
    edge.src = source(*ei, graph_);
    edge.dst = target(*ei, graph_);
    layout.edges.emplace_back(edge);
  }

  layout.buffer = parking_window_buffer_;
  for(const auto& window : resource_windows_) {
    layout.resource_windows.emplace_back(window);
  }

  return layout;
}

std::optional<uint8_t> Layout::GetBayInsertFloor(uint16_t bay_id) const {
  if(auto it = bay_insert_floors_.find(bay_id); it != bay_insert_floors_.end()) {
    return it->second;
  }
  return std::nullopt;
}

std::optional<std::vector<uint8_t>> Layout::GetBaySystemFloors(uint16_t bay_id) const {
  if(auto it = bay_system_floors_.find(bay_id); it != bay_system_floors_.end()) {
    return it->second;
  }
  return std::nullopt;
}

std::optional<Vrc> Layout::GetVrc(const uint32_t vrc_id) const {
  if(vrcs_.find(vrc_id) == vrcs_.end()) {
    return std::nullopt;
  }

  return vrcs_.at(vrc_id);
}

std::vector<Vrc> Layout::GetVrcs() const {
  std::vector<Vrc> vrcs;
  vrcs.reserve(vrcs_.size());
  for(const auto& [id, vrc] : vrcs_) {
    vrcs.push_back(vrc);
  }
  return vrcs;
}

std::optional<Vrc> Layout::GetVrcForNodeId(const uint32_t node_id) const {
  for(const auto& [id, vrc] : vrcs_) {
    for(const auto& node : vrc.nodes) {
      if(node.id == node_id) {
        return vrc;
      }
    }
  }

  return {};
}

bool Layout::IsVrcNode(uint32_t node_id) const {
  return GetVrcForNodeId(node_id).has_value();
}

std::optional<GarageNodeMsg> Layout::GetRootNodeForVrcNode(const uint32_t node_id) const {
  const auto vrc = GetVrcForNodeId(node_id);
  if(!vrc.has_value()) {
    return {};
  }
  return GetNodeById(vrc->root_node_id);
}

std::vector<GarageFloorMsg> Layout::GetFloorsForVrcNode(uint32_t node_id) const {
  const auto vrc = GetVrcForNodeId(node_id);
  if(!vrc.has_value()) {
    return {};
  }
  std::vector<GarageFloorMsg> floors;
  for(const auto& node : vrc.value().nodes) {
    if(const auto floor = GetFloorById(node.floor); floor.has_value()) {
      floors.emplace_back(floor.value());
    }
  }
  return floors;
}

stdx::Expected<std::filesystem::path> GetLayoutPathByName(const std::string& layout_name) {
  return site_config::GetLayoutPathByName(layout_name);
}

stdx::Expected<LayoutSPtrConst> GetLayoutByName(const ::std::string& layout_name) {
  const auto layout_filepath_or = GetLayoutPathByName(layout_name);
  if(!layout_filepath_or.has_value()) {
    return stdx::Unexpected(layout_filepath_or.error());
  }

  return std::make_shared<Layout>(layout_filepath_or.value());
}

