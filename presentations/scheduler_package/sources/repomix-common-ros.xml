#include <common_ros/collision_geometry.hpp>
#include <common_ros/geometry_visualization.hpp>
#include <common_ros/layout.hpp>
#include <cstdlib>
#include <iostream>

// Saving my poor fingers from typing volley:: over and over again
// NOLINTNEXTLINE
using namespace volley;

// Clang tidy complains something here can throw an exception, but it's not
// clear what it is.
// NOLINTNEXTLINE(bugprone-exception-escape)
int main(int argc, char** argv) {
  rclcpp::init(argc, argv);
  std::string layout_name;
  std::cout << "Enter layout name: ";
  std::cin >> layout_name;

  const auto layout_filepath_or = GetLayoutPathByName(layout_name);
  if(!layout_filepath_or.has_value()) {
    std::cerr << layout_filepath_or.error() << std::endl;
    return EXIT_FAILURE;
  }
  const auto& layout_filepath = layout_filepath_or.value();

  LayoutSPtr layout = std::make_shared<volley::Layout>(layout_filepath);
  PoseGraph pg(layout);
  GarageGraph gg(pg);
  CollisionTable table(gg, rclcpp::get_logger("collision_vis_tool"));

  auto entity_table = table.BuildEntityTable(gg);

  std::cout << "Collision Entities: " << std::endl;
  for(size_t id = 0; id < entity_table.size(); ++id) {
    std::cout << id << ": " << ResourceName(*layout, id) << std::endl;
  }

  // TODO(Gunther): Use GetOpt for one off queries
  while(true) {
    unsigned collision_id = 0;
    unsigned query_id = 0;
    std::cout << "Enter Fixed Collision ID: ";
    std::cin >> collision_id;
    std::cout << "Enter Queried Collision ID: ";
    std::cin >> query_id;
    std::cout << "Pose or Edge?" << std::endl;
    std::string type;
    std::cin >> type;
    while(type != "Pose" && type != "Edge") {
      std::cout << "Invalid type. Enter Pose or Edge." << std::endl;
      type.clear();
      std::cin >> type;
    }
    CollisionTable::PoseOrEdge location;

    if(type == "Pose") {
      CollisionTable::Pose pose;
      std::cout << "Enter node_id: ";
      std::cin >> pose.node_id;
      std::cout << "Enter heading: ";
      std::cin >> pose.heading;
      location = pose;
    }
    else {
      CollisionTable::Edge edge;
      std::cout << "Enter src node_id: ";
      std::cin >> edge[0].node_id;
      std::cout << "Enter src heading: ";
      std::cin >> edge[0].heading;
      std::cout << "Enter dst node_id: ";
      std::cin >> edge[1].node_id;
      std::cout << "Enter dst heading: ";
      std::cin >> edge[1].heading;
      location = edge;
    }

    std::string query_filename;

    std::visit(
        [&](auto&& arg) { query_filename = DrawQuery(gg, table, collision_id, query_id, arg); }, location);

    std::cout << "Query saved to " << query_filename << std::endl;
    std::cout << "Enter 'q' to quit or any other key to continue: ";
    std::string quit;
    std::cin >> quit;
    if(quit == "q") {
      break;
    }
  }
}
