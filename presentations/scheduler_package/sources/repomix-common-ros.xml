uint64_t HashCombineBytes(uint64_t hash, const uint8_t* bytes, size_t n_bytes) {
  for(unsigned int i = 0; i < n_bytes; i++) {
    // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
    hash = volley::HashCombine(hash, bytes[i]);
  }
  return hash;
}

uint64_t DiscreteGarageState::Hash(uint32_t version) const {
  uint64_t hash = 0;
  if(is_faulted_) {
    hash = volley::HashCombine(hash, is_faulted_);
  }

  for(const auto& [_, agv] : agvs_) {
    hash = volley::HashCombine(hash, agv.id);
    hash = volley::HashCombine(hash, agv.state);
    hash = volley::HashCombine(hash, agv.lift);
    hash = volley::HashCombine(hash, agv.pose.node_id);
    hash = volley::HashCombine(hash, agv.pose.heading);
    hash = volley::HashCombine(hash, agv.tray_id);
    hash = volley::HashCombine(hash, agv.disabled);
  }

  for(const auto& [_, bay] : bays_) {
    hash = volley::HashCombine(hash, bay.id);
    hash = volley::HashCombine(hash, bay.state);
    if(version > 1) {
      hash = volley::HashCombine(hash, bay.disabled);
    }
  }

  if(version > 2) {
    for(const auto& [_, vecs] : vexen_) {
      hash = volley::HashCombine(hash, vecs.id);
      hash = volley::HashCombine(hash, vecs.state);
      hash = volley::HashCombine(hash, vecs.disabled);
    }
  }

  if(version > 4) {
    for(const auto& [_, vrc] : vrcs_) {
      hash = volley::HashCombine(hash, vrc.id);
      hash = volley::HashCombine(hash, vrc.state.value);
      hash = volley::HashCombine(hash, vrc.current_floor);
      hash = volley::HashCombine(hash, vrc.requested_floor);
      for(const auto& gate_report : vrc.gates) {
        hash = volley::HashCombine(hash, gate_report.floor);
        hash = volley::HashCombine(hash, gate_report.state.value);
      }
    }
  }

  for(const auto& [_, tray] : trays_) {
    hash = volley::HashCombine(hash, tray.id);
    hash = volley::HashCombine(hash, tray.pose.node_id);
    hash = volley::HashCombine(hash, tray.pose.heading);
    hash = volley::HashCombine(hash, tray.agv_id);
    hash = HashCombineBytes(hash, tray.payload_id.bytes.data(), 16ul);
    hash = volley::HashCombine(hash, tray.disabled);
  }

  for(const auto& [_, payload] : payloads_) {
    hash = HashCombineBytes(hash, payload.payload.id.bytes.data(), 16ul);
    hash = volley::HashCombine(hash, static_cast<uint64_t>(payload.payload.mass));
    hash = volley::HashCombine(hash, static_cast<uint64_t>(payload.payload.length_m));
    hash = volley::HashCombine(hash, static_cast<uint64_t>(payload.payload.width_m));
    hash = volley::HashCombine(hash, static_cast<uint64_t>(payload.payload.height_m));
    if(version > 3) {
      hash = volley::HashCombine(hash, static_cast<bool>(payload.payload.ev_charge_requested));
    }
    hash = volley::HashCombine(hash, payload.tray_id);
    hash = volley::HashCombine(hash, payload.reciprocal_to_tray);
    hash = volley::HashCombine(hash, payload.charging);
  }

  for(const uint32_t node_id : disabled_nodes_) {
    hash = volley::HashCombine(hash, node_id);
  }
  return hash;
}

void DiscreteGarageState::Clear() {
  is_faulted_ = false;
  agvs_.clear();
  bays_.clear();
  vexen_.clear();
  vrcs_.clear();
  trays_.clear();
  payloads_.clear();
  disabled_nodes_.clear();
}

BoolStringPair DiscreteGarageState::Set(const DiscreteGarageStateMsg& garage_state) {
  // We guard ourselves against potential inconsistencies in a garage state message
  // by checking each event for success and returning whether we were able to apply all of them.

  Clear();

  bool success = true;
  std::string message = "";

  if(garage_state.is_faulted) {
    std::tie(success, message) = OnEvent(GetFaultedEvent(true));
    if(!success) {
      return std::make_pair(success, message);
    }
  }
  for(const auto& agv : garage_state.agvs) {
    auto add_event = GetAddEvent(agv);
    // Remove any tray this AGV is carrying so that we do not try to add an
    // AGV with an unknown tray. We'll add the tray to it later correctly.
    add_event.tray_id = 0;
    std::tie(success, message) = OnEvent(add_event);
    if(!success) {
      return std::make_pair(false, message);
    }
  }
  for(const auto& bay : garage_state.bays) {
    std::tie(success, message) = OnEvent(GetAddEvent(bay));
    if(!success) {
      return std::make_pair(false, message);
    }
  }
  for(const auto& vecs : garage_state.vexen) {
    std::tie(success, message) = OnEvent(GetAddEvent(vecs));
    if(!success) {
      return std::make_pair(false, message);
    }
  }
  for(const auto& vrc : garage_state.vrcs) {
    std::tie(success, message) = OnEvent(GetAddEvent(vrc));
    if(!success) {
      return std::make_pair(false, message);
    }
  }
  for(const auto& tray : garage_state.trays) {
    std::tie(success, message) = OnEvent(GetAddEvent(tray));
    if(!success) {
      return std::make_pair(false, message);
    }
  }
  for(const auto& payload : garage_state.payloads) {
    std::tie(success, message) = OnEvent(GetAddEvent(payload));
    if(!success) {
      return std::make_pair(false, message);
    }
  }
  for(const uint32_t node_id : garage_state.disabled_nodes) {
    NodeDisablednessChangedMsg node_disabledness_changed;
    node_disabledness_changed.node_id = node_id;
    node_disabledness_changed.disable = true;

    std::tie(success, message) = OnEvent(node_disabledness_changed);
    if(!success) {
      return std::make_pair(false, message);
    }
  }

  // Success
  return std::make_pair(true, message);
}

// Sets the DiscreteGarageState from a YAML::Node representation. If a field is
// missing that does not have a default value, this function will return an
// error. Creating the YAML via rosidl_generator_traits::to_yaml will ensure
// that all fields are present. A unit test will fail if this function is broken
// by an update to the DiscreteGarageState.msg and will need to be updated here.
BoolStringPair DiscreteGarageState::Set(YAML::Node node) {
  DiscreteGarageStateMsg state_msg;
  try {
    state_msg.is_faulted = node["is_faulted"].as<bool>(false);
    for(const auto& agv : node["agvs"]) {
      DiscreteAgvStateMsg agv_msg;
      agv_msg.id = agv["id"].as<uint16_t>();
      agv_msg.state = agv["state"].as<uint16_t>(AgvReportMsg::STATE_BOOTING);
      agv_msg.pose.node_id = agv["pose"]["node_id"].as<uint32_t>();
      agv_msg.pose.heading = agv["pose"]["heading"].as<int16_t>();
      agv_msg.lift = agv["lift"].as<bool>(false);
      agv_msg.tray_id = agv["tray_id"].as<uint16_t>(0u);
      agv_msg.disabled = agv["disabled"].as<bool>(false);
      state_msg.agvs.emplace_back(std::move(agv_msg));
    }

    for(const auto& bay : node["bays"]) {
      DiscreteBayStateMsg bay_msg;
      bay_msg.id = bay["id"].as<uint16_t>();
      bay_msg.state = bay["state"].as<uint16_t>(BayReportMsg::STATE_BOOTING);
      bay_msg.disabled = bay["disabled"].as<bool>(false);
      state_msg.bays.emplace_back(std::move(bay_msg));
    }

    for(const auto& vecs : node["vexen"]) {
      DiscreteVecsStateMsg vecs_msg;
      vecs_msg.id = vecs["id"].as<uint16_t>();
      vecs_msg.state = vecs["state"].as<uint16_t>(VecsReportMsg::BOOTING);
      vecs_msg.disabled = vecs["disabled"].as<bool>(false);
      state_msg.vexen.emplace_back(std::move(vecs_msg));
    }

    for(const auto& vrc : node["vrcs"]) {
      DiscreteVrcStateMsg vrc_msg;
      vrc_msg.id = vrc["id"].as<uint16_t>();
      vrc_msg.state.value = vrc["state"]["value"].as<uint8_t>(0u);
      if(vrc["gates"]) {
        for(const auto& gate : vrc["gates"]) {
          vrc_interfaces::msg::GateReport gate_report_msg;
          gate_report_msg.floor = gate["floor"].as<uint16_t>(0);
          gate_report_msg.state.value =
              gate["state"]["value"].as<uint8_t>(vrc_interfaces::msg::GateState::STATE_UNKNOWN);
          vrc_msg.gates.emplace_back(gate_report_msg);
        }
      }
      vrc_msg.current_floor = vrc["current_floor"].as<uint16_t>(0u);
      vrc_msg.requested_floor = vrc["requested_floor"].as<uint16_t>(0u);
      state_msg.vrcs.emplace_back(std::move(vrc_msg));
    }

    for(const auto& tray : node["trays"]) {
      DiscreteTrayStateMsg tray_msg;
      tray_msg.id = tray["id"].as<uint16_t>();
      tray_msg.pose.node_id = tray["pose"]["node_id"].as<uint32_t>();
      tray_msg.pose.heading = tray["pose"]["heading"].as<int16_t>();
      tray_msg.agv_id = tray["agv_id"].as<uint16_t>(0u);
      if(tray["payload_id"]) {
        if(tray["payload_id"].IsSequence()) {
          auto byte_itr = tray_msg.payload_id.bytes.begin();
          for(const auto& byte : tray["payload_id"]) {
            *(byte_itr++) = byte.as<unsigned>();
          }
        }
        else if(tray["payload_id"].IsMap() && tray["payload_id"]["bytes"]) {
          auto byte_itr = tray_msg.payload_id.bytes.begin();
          for(const auto& byte : tray["payload_id"]["bytes"]) {
            *(byte_itr++) = byte.as<unsigned>();
          }
        }
        else {
          const auto guid_opt = volley::ParseGuid(tray["payload_id"].as<std::string>());
          if(guid_opt) {
            tray_msg.payload_id = guid_opt.value();
          }
        }
      }
      tray_msg.disabled = tray["disabled"].as<bool>(false);
      state_msg.trays.emplace_back(std::move(tray_msg));
    }

    for(const auto& payload : node["payloads"]) {
      DiscretePayloadStateMsg payload_msg;
      auto byte_itr = payload_msg.payload.id.bytes.begin();
      if(payload["payload"]["id"]) {
        const YAML::Node& payload_id = payload["payload"]["id"];
        if(payload_id.IsMap() && payload_id["bytes"]) {
          for(const auto& byte : payload_id["bytes"]) {
            *(byte_itr++) = byte.as<unsigned>();
          }
        }
        else {
          const auto guid_opt = volley::ParseGuid(payload_id.as<std::string>());
          if(guid_opt) {
            payload_msg.payload.id = guid_opt.value();
          }
        }
      }
      payload_msg.payload.mass = payload["payload"]["mass"].as<float>();
      payload_msg.payload.length_m = payload["payload"]["length_m"].as<float>();
      payload_msg.payload.width_m = payload["payload"]["width_m"].as<float>();
      payload_msg.payload.height_m = payload["payload"]["height_m"].as<float>();

      // This one yaml key-value is not indented.  But payload is redundantly indented.
      // Assume humans not very good at reading/writeing yaml. So check both possible
      // structures.
      if(payload["payload"]["tray_id"]) {
        payload_msg.tray_id = payload["payload"]["tray_id"].as<uint16_t>(0u);
      }
      else if(payload["tray_id"]) {
        payload_msg.tray_id = payload["tray_id"].as<uint16_t>(0u);
      }

      if(payload["payload"]["reciprocal_to_tray"]) {
        payload_msg.reciprocal_to_tray = payload["payload"]["reciprocal_to_tray"].as<bool>(false);
      }
      else if(payload["reciprocal_to_tray"]) {
        payload_msg.reciprocal_to_tray = payload["reciprocal_to_tray"].as<bool>(false);
      }

      payload_msg.payload.ev_charge_requested = payload["payload"]["ev_charge_requested"].as<bool>(false);

      payload_msg.charging = payload["charging"].as<bool>(false);
      // printf( "DiscreteGarageState::Set   payload %s   belongs to tray %s\n",
      //     std::to_string(payload_msg.payload.id).c_str(),
      //     std::to_string(payload_msg.tray_id).c_str());
      state_msg.payloads.emplace_back(std::move(payload_msg));
    }
    if(node["disabled_nodes"]) {
      state_msg.disabled_nodes = node["disabled_nodes"].as<std::vector<uint32_t>>();
    }
    state_msg.hash = node["hash"].as<uint64_t>(0u);
  }
  catch(const YAML::Exception& e) {
    return std::make_pair(false, std::string("YAML Parsing failed: ") + e.what());
  }

  return Set(state_msg);
}

void DiscreteGarageState::Set(const DiscreteGarageState& garage_state) {
  // Garage states are structured to only ever contain valid state.
  // As such, setting from another garage state should always succeed.

  Clear();

  if(garage_state.IsFaulted()) {
    OnEvent(GetFaultedEvent(true));
  }
  for(const auto& [agv_id, agv] : garage_state.GetAgvs()) {
    auto add_event = GetAddEvent(agv);
    // Remove any tray this AGV is carrying so that we do not try to add an
    // AGV with an unknown tray. We'll add the tray to it later correctly.
    add_event.tray_id = 0;
    OnEvent(add_event);
  }
  for(const auto& [bay_id, bay] : garage_state.GetBays()) {
    OnEvent(GetAddEvent(bay));
  }
  for(const auto& [vecs_id, vecs] : garage_state.GetVexen()) {
    OnEvent(GetAddEvent(vecs));
  }
  for(const auto& [vrc_id, vrc] : garage_state.GetVrcs()) {
    OnEvent(GetAddEvent(vrc));
  }
  for(const auto& [tray_id, tray] : garage_state.GetTrays()) {
    OnEvent(GetAddEvent(tray));
  }
  for(const auto& [payload_id, payload] : garage_state.GetPayloads()) {
    OnEvent(GetAddEvent(payload));
  }
  for(const uint32_t node_id : garage_state.GetDisabledNodes()) {
    NodeDisablednessChangedMsg node_disabledness_changed;
    node_disabledness_changed.node_id = node_id;
    node_disabledness_changed.disable = true;
    OnEvent(node_disabledness_changed);
  }
}

BoolStringPair DiscreteGarageState::OnEvent(const DiscreteGarageEventMsg& event) {
  if(event.type == "FaultStateChanged") {
    auto discrete_garage_event_opt = Deserialize<FaultStateChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value());
    }
  }
  else if(event.type == "AgvExistenceChanged") {
    auto discrete_garage_event_opt = Deserialize<AgvExistenceChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value());
    }
  }
  else if(event.type == "AgvDisablednessChanged") {
    auto discrete_garage_event_opt = Deserialize<AgvDisablednessChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value());
    }
  }
  else if(event.type == "AgvLiftChanged") {
    auto discrete_garage_event_opt = Deserialize<AgvLiftChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value());
    }
  }
  else if(event.type == "AgvPoseChanged") {
    auto discrete_garage_event_opt = Deserialize<AgvPoseChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return OnEvent(discrete_garage_event_opt.value());
