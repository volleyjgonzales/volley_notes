std_msgs::msg::ColorRGBA Color(float r, float g, float b, float a) {
  std_msgs::msg::ColorRGBA color {};
  color.r = volley::Clamp(r, 0.0f, 1.0f);
  color.g = volley::Clamp(g, 0.0f, 1.0f);
  color.b = volley::Clamp(b, 0.0f, 1.0f);
  color.a = volley::Clamp(a, 0.0f, 1.0f);
  return color;
}

std_msgs::msg::ColorRGBA Color(int r, int g, int b, float a) {
  std_msgs::msg::ColorRGBA color {};
  color.r = volley::Clamp(static_cast<float>(r) / 255.0f, 0.0f, 1.0f);
  color.g = volley::Clamp(static_cast<float>(g) / 255.0f, 0.0f, 1.0f);
  color.b = volley::Clamp(static_cast<float>(b) / 255.0f, 0.0f, 1.0f);
  color.a = volley::Clamp(a, 0.0f, 1.0f);
  return color;
}

std_msgs::msg::ColorRGBA Lerp(
    const std_msgs::msg::ColorRGBA& color_a, const std_msgs::msg::ColorRGBA& color_b, float t) {
  return Color(color_a.r * (1 - t) + color_b.r * t, color_a.g * (1 - t) + color_b.g * t,
      color_a.b * (1 - t) + color_b.b * t, color_a.a * (1 - t) + color_b.a * t);
}

rclcpp::QoS GetBestEffortQoS(size_t history_depth) {
  rclcpp::QoS best_effort_qos(history_depth);
