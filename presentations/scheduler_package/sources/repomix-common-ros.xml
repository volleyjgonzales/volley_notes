<file path="include/common_ros/repeated_data_checker.hpp">
#pragma once

#include <chrono>
#include <rclcpp/time.hpp>

namespace volley {

// Class for checking if a data source is being received but the contents are not changing when we
// think they should be.
template <typename T>
class RepeatedDataChecker {
public:
  RepeatedDataChecker(const std::chrono::nanoseconds& expiration_duration, const rclcpp::Time& now) :
      expiration_duration_(expiration_duration), last_change_time_(now) { }

  // True if the value hasn't changed for more than expiration_duration_
  bool IsStale(const T& value, const rclcpp::Time& now) {
    if(value != prior_value_) {
      last_change_time_ = now;
    }
    prior_value_ = value;

    return std::chrono::nanoseconds {(now - last_change_time_).nanoseconds()} > expiration_duration_;
  }

private:
  T prior_value_ {};

  std::chrono::nanoseconds expiration_duration_;

  rclcpp::Time last_change_time_;
};

}  // namespace volley
</file>

