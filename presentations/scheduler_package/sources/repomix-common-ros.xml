    }
  }
  else if(event.type == "PayloadExistenceChanged") {
    auto discrete_garage_event_opt = Deserialize<PayloadExistenceChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return Serialize(Reverse(discrete_garage_event_opt.value()));
    }
  }
  else if(event.type == "NodeDisablednessChanged") {
    auto discrete_garage_event_opt = Deserialize<NodeDisablednessChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return Serialize(Reverse(discrete_garage_event_opt.value()));
    }
  }
  else if(event.type == "VrcExistenceChanged") {
    auto discrete_garage_event_opt = Deserialize<VrcExistenceChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return Serialize(Reverse(discrete_garage_event_opt.value()));
    }
  }
  else if(event.type == "VrcStateChanged") {
    auto discrete_garage_event_opt = Deserialize<VrcStateChangedMsg>(event);
    if(discrete_garage_event_opt.has_value()) {
      return Serialize(Reverse(discrete_garage_event_opt.value()));
    }
  }

  return std::nullopt;
}

FaultStateChangedMsg GetFaultedEvent(bool is_faulted) {
  FaultStateChangedMsg event {};
  event.faulted = is_faulted;
  return event;
}

