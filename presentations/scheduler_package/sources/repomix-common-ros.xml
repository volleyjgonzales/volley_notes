  os << "AGVs:";
  for(const auto& agv : state.agvs) {
    os << "\n\t" << std::to_string(agv);
  }
  os << "\nBays:";
  for(const auto& bay : state.bays) {
    os << "\n\t" << std::to_string(bay);
  }
  os << "\nTrays:";
  for(const auto& tray : state.trays) {
    os << "\n\t" << std::to_string(tray);
  }
  os << "\nPayloads:";
  for(const auto& payload : state.payloads) {
    os << "\n\t" << std::to_string(payload);
  }
  if(state.vexen.size()) {
    os << "\nVexen:";
    for(const auto& vecs : state.vexen) {
      os << "\n\t" << std::to_string(vecs);
    }
  }
  if(state.vrcs.size()) {
    os << "\nVRCs:";
    for(const auto& vrc : state.vrcs) {
      os << "\n\tv" << vrc.id << " current_floor=" << vrc.current_floor
         << " requested_floor=" << vrc.requested_floor;
    }
  }
  if(state.disabled_nodes.size()) {
    os << "\nDisabled nodes:";
    for(const auto& node_id : state.disabled_nodes) {
      os << "\n\t" << std::to_string(node_id);
    }
  }

  return os.str();
}

