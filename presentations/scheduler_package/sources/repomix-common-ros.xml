#include <common/constants.hpp>
#include <common_ros/layout.hpp>
#include <common_ros/polygon_utils.hpp>
#include <stdexcept>

namespace volley {

namespace bg = boost::geometry;
namespace trans = boost::geometry::strategy::transform;

// The number of segments used when constructing polygons that approximate circles.
constexpr int kNumSegmentsForCirclePolygons = 32;

Polygon CreateRectangularPolygon(
    double x, double y, double heading_deg, double length_along_heading, double width) {
  double half_length = length_along_heading / 2;
  double half_width = width / 2;

  Polygon poly;
  bg::append(poly.outer(), Point2d(-half_length, -half_width));
  bg::append(poly.outer(), Point2d(-half_length, half_width));
  bg::append(poly.outer(), Point2d(half_length, half_width));
  bg::append(poly.outer(), Point2d(half_length, -half_width));
  bg::append(poly.outer(), Point2d(-half_length, -half_width));

  // Rotate wrt the origin by heading
  // Note that boost rotates clockwise, and our headings are counter-clockwise.
  Polygon poly2;
  trans::rotate_transformer<boost::geometry::degree, double, 2, 2> rotate(-heading_deg);
  bg::transform(poly, poly2, rotate);

  // Translate to its origin
  trans::translate_transformer<double, 2, 2> translate(x, y);
  bg::transform(poly2, poly, translate);

  return poly;
}

Polygon CreateCircularPolygon(double x, double y, double radius) {
  if(radius <= 0.0) {
    throw std::invalid_argument("Radius " + std::to_string(radius) + " must be positive!");
  }

  // We use an increased radius such that a circle of radius `radius` is inscribed in our polygon.
  double dtheta_rad = 2 * M_PI / kNumSegmentsForCirclePolygons;
  double buffered_radius = radius / std::cos(dtheta_rad / 2.0);

  Polygon poly;
  for(int i = 0; i <= kNumSegmentsForCirclePolygons; i++) {
    double theta_rad = i * dtheta_rad;
    // NOTE: Clockwise winding
    double x2 = buffered_radius * std::cos(-theta_rad);
    double y2 = buffered_radius * std::sin(-theta_rad);
    bg::append(poly.outer(), Point2d(x2, y2));
  }

  // Translate to its origin
  Polygon poly2;
  trans::translate_transformer<double, 2, 2> translate(x, y);
  bg::transform(poly, poly2, translate);

  return poly2;
}

std::vector<std::vector<std::vector<SizedPoseMsg>>> CalcOverlappingSizedPoses(
    const Layout& layout, const std::vector<GaragePoseMsg>& poses) {
  // Create polygons of each size (plus buffer) for each pose in the graph
  // pose_polygons[i][j] contains the polygon for the ith pose and jth resource size
  std::vector<std::vector<Polygon>> pose_polygons;
  for(const auto& pose : poses) {
    std::vector<Polygon> polygons_by_size;

    // We assume the poses are all valid.
    const auto node = layout.GetNodeById(pose.node_id).value();
    for(int i = 0; i <= node.max_resource_size_index; i++) {
      auto window_opt = layout.GetBufferedResourceWindow(i);
      if(!window_opt.has_value()) {
        // We failed to get a window. Fall back to the largest window size.
        window_opt = layout.GetResourceWindows().back();
      }

      const auto& window = window_opt.value();

      if(node.rotation_allowed) {
        // If rotation is allowed, get a circular polygon.
        double radius = std::hypot(window.width_m / 2.0, window.length_m / 2.0);
        polygons_by_size.emplace_back(CreateCircularPolygon(node.x, node.y, radius));
      }
      else {
        // Otherwise use a standard rectangle.
        // NOTE: Everything is a crab, so our parking window lengths are our pose widths.
        polygons_by_size.emplace_back(
            CreateRectangularPolygon(node.x, node.y, pose.heading, window.width_m, window.length_m));
      }
    }
    pose_polygons.emplace_back(polygons_by_size);
  }

  // Compute the overlapping polygons for each pose and sized pose thereof
  int n_poses = static_cast<int>(poses.size());
  std::vector<std::vector<std::vector<SizedPoseMsg>>> overlapping_sized_poses;
  for(int pose_index_src = 0; pose_index_src < n_poses; pose_index_src++) {
    std::vector<std::vector<SizedPoseMsg>> overlapping_sized_poses_for_pose;
    const auto& polygons_by_size_src = pose_polygons.at(pose_index_src);
    // NOLINTNEXTLINE(modernize-loop-convert)
    for(int resource_size_index_src = 0;
        resource_size_index_src < static_cast<int>(polygons_by_size_src.size()); resource_size_index_src++) {
      const auto& poly_src = polygons_by_size_src.at(resource_size_index_src);
      std::vector<SizedPoseMsg> overlapping_sized_poses_for_sized_pose;
      for(int pose_index_dst = 0; pose_index_dst < n_poses; pose_index_dst++) {
        const auto& polygons_by_size_dst = pose_polygons.at(pose_index_dst);

        // Find the smallest size that overlaps, if any
        // NOLINTNEXTLINE(modernize-loop-convert)
        for(int resource_size_index_dst = 0;
            resource_size_index_dst < static_cast<int>(polygons_by_size_dst.size());
            resource_size_index_dst++) {
          const auto& poly_dst = polygons_by_size_dst.at(resource_size_index_dst);
          if(bg::intersects(poly_src, poly_dst)) {
            // We found it
            const auto& pose_dst = poses.at(pose_index_dst);
            overlapping_sized_poses_for_sized_pose.emplace_back(
                ConstructSizedPose(pose_dst, resource_size_index_dst));
            break;  // done with this pose_dst
          }
        }
      }

      overlapping_sized_poses_for_pose.emplace_back(overlapping_sized_poses_for_sized_pose);
    }
    overlapping_sized_poses.emplace_back(overlapping_sized_poses_for_pose);
  }

  return overlapping_sized_poses;
}

}  // namespace volley
