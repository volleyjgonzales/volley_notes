template <typename T, typename T2>
std::string CollisionToString(volley::CollisionEntityId_t fixed_resource, T& fixed_location,
    volley::CollisionEntityId_t test_resource, T2& test_location, const volley::Layout& layout) {
  std::stringstream ss;
  ss << ResourceName(layout, fixed_resource) << "@" << fixed_location << " -- "
     << ResourceName(layout, test_resource) << "@" << test_location;
  return ss.str();
}

Polygon RectangleFromSize(double width, double length) {
  Polygon poly;
  boost::geometry::append(poly.outer(), Point2d(-length / 2, -width / 2));
  boost::geometry::append(poly.outer(), Point2d(length / 2, -width / 2));
  boost::geometry::append(poly.outer(), Point2d(length / 2, width / 2));
  boost::geometry::append(poly.outer(), Point2d(-length / 2, width / 2));
  boost::geometry::append(poly.outer(), Point2d(-length / 2, -width / 2));
  return poly;
}

Polygon RotationCirclePoly(double x, double y, double radius) {
  constexpr int num_circle_segments = 32;
  if(radius <= 0.0) {
    throw std::invalid_argument("Radius " + std::to_string(radius) + " must be positive!");
  }

  // We use an increased radius such that a circle of radius `radius` is inscribed in our polygon.
  double dtheta_rad = 2 * M_PI / num_circle_segments;
  double buffered_radius = radius / std::cos(dtheta_rad / 2.0);

  Polygon poly;
  for(int i = 0; i <= num_circle_segments; i++) {
    double theta_rad = i * dtheta_rad;
    // NOTE: Clockwise winding
    double x2 = buffered_radius * std::cos(-theta_rad);
    double y2 = buffered_radius * std::sin(-theta_rad);
    boost::geometry::append(poly.outer(), Point2d(x2, y2));
  }

  // Translate to its origin
  Polygon poly2;
  boost::geometry::strategy::transform::translate_transformer<double, 2, 2> translate(x, y);
  boost::geometry::transform(poly, poly2, translate);

  return poly2;
}

std::string ResourceName(const volley::Layout& layout, CollisionEntityId_t resource) {
  if(resource < common::EnumInteger(CollisionEntityId::PAYLOAD)) {
    return common::EnumNameString(common::EnumValue<CollisionEntityId>(resource));
  }
  auto res_opt =
      layout.GetResourceWindow(static_cast<int>(resource) - common::EnumInteger(CollisionEntityId::PAYLOAD));
  if(!res_opt) {
    return "Resource Unknown";
  }
  return res_opt->name;
}

Circle CollisionEntity::CircleAtEdge(const GaragePoseMsg& src, const GaragePoseMsg& dst) const {
  // we assume the circle is the sum of the distance between the dst and src plus two times the
  // radius of the bounding circle as a rough approximation
  const auto node_src = layout_->GetNodeById(src.node_id).value();
  const auto node_dst = layout_->GetNodeById(dst.node_id).value();
  double distance =
      std::sqrt(std::pow(node_src.x - node_dst.x, 2.0) + std::pow(node_src.y - node_dst.y, 2.0));
  return {
      (node_src.x + node_dst.x) / 2.0, (node_src.y + node_dst.y) / 2.0, distance / 2.0 + GetBoundingRadius()};
}

Polygon CollisionEntity::PolyAtEdge(
    ComparableGeometry cg, const GaragePoseMsg& src, const GaragePoseMsg& dst) const {
  Polygon poly = cg.AsPolygon();

  // If rotation node, construct a "circle" polygon
  if(src.node_id == dst.node_id) {
    const auto node = layout_->GetNodeById(src.node_id).value();
    double max_diff = 0.0;
    auto iter = poly.outer().begin();
    while(iter != poly.outer().end()) {
      auto next_iter = iter + 1;
      while(next_iter != poly.outer().end()) {
        if(boost::geometry::distance(*iter, *next_iter) > max_diff) {
          max_diff = boost::geometry::distance(*iter, *next_iter);
        }
        next_iter++;
      }
      iter++;
    }
    return RotationCirclePoly(node.x, node.y, max_diff / 2);
  }
  // Otherwise combine the outer shell of the two polygons
  MultiPolygon combined({PolyAtPose(poly, src).AsPolygon(), PolyAtPose(poly, dst).AsPolygon()});
  Polygon hull;
  boost::geometry::convex_hull(combined, hull);
  return hull;
}

ComparableGeometry TrayLegsEntity::BasePoly() const {
  // Construct a multi polygon consisting of 4 tray legs at each corner.
  MultiPolygon legs;
  auto const tray_leg_base = RectangleFromSize(kTrayLegLength, kTrayLegLength);
  constexpr double tray_length_offset = kTrayLength / 2;
  constexpr double tray_width_offset = kTrayWidth / 2;

  constexpr std::array<std::pair<double, double>, 4> leg_locations = {
      {{-tray_width_offset, -tray_length_offset}, {-tray_width_offset, tray_length_offset},
          {tray_width_offset, tray_length_offset}, {tray_width_offset, -tray_length_offset}}};

  for(const auto& [x, y] : leg_locations) {
    Polygon leg;
    boost::geometry::strategy::transform::translate_transformer<double, 2, 2> translate(x, y);
    boost::geometry::transform(tray_leg_base, leg, translate);
    legs.emplace_back(std::move(leg));
  }
  return legs;
}

void TrayLegsEntity::CalculateBoundingRadius() {
  // Bounding radius for legs is the same as the tray for the broad phase check.
  SetBoundingRadius(volley::CalculateSquareRadius(kTrayLength, kTrayLength));
}

ComparableGeometry BayOdpEntity::PolyAtPose(ComparableGeometry poly, const GaragePoseMsg& pose) const {
  // Always put the ODP at the inbound heading, regardless of the pose orientation
  // in the bay.

  auto node_opt = GetLayout()->GetNodeById(pose.node_id);
  if(!node_opt) {
    throw std::runtime_error("Node ID " + std::to_string(pose.node_id) + " not found.");
  }
  const auto node = node_opt.value();

  auto heading_opt = GetLayout()->GetBayInboundHeading(pose.node_id);
  if(!heading_opt) {
    throw std::runtime_error("Bay ID " + std::to_string(pose.node_id) + " not found.");
  }
  return poly.Rotate(-1 * heading_opt.value()).Translate(node.x, node.y);
}

ComparableGeometry BayOdpEntity::BasePoly() const {
  // 2" is plenty long (inuendo not intended) for the ODP
  Polygon odp = RectangleFromSize(2 * kIn2M, kGarageDoorWidth);
  Polygon odp_trans;
  // Translate from node center out.
  // Negative direction = TOWARDS inbound heading
  // I think this is right? who knows.
  auto odp_from_center = (.5 * kBayLength) + 1 * kIn2M;
  boost::geometry::strategy::transform::translate_transformer<double, 2, 2> translate(0, odp_from_center);
  boost::geometry::transform(odp, odp_trans, translate);
  return odp_trans;
}

void BayOdpEntity::CalculateBoundingRadius() {
  // Bounding radius is the distance from the center to the corner of the ODP
  auto odp_length = kBayLength + kIn2M;
  SetBoundingRadius(volley::CalculateSquareRadius(odp_length, kGarageDoorWidth));
}

// *****************************************************************************
// CollisionTable

CollisionTable::CollisionTable(const GarageGraph& garage_graph, const rclcpp::Logger& logger) :
    logger_(logger),
    layout_id_(std::hash<std::string> {}(garage_graph.GetLayout()->GetName())),
    gg_(garage_graph),
    cache_file_path_(GetCacheFilePath(gg_.GetLayout()->GetName(), gg_.GetLayout()->GetMD5Sum())) {
  if(!LoadTable()) {
    INFOS(logger_, "Building collision table from garage graph " << gg_.GetLayout()->GetName());
    auto [built, err_msg] = BuildTable(garage_graph);
    if(!built) {
      throw std::runtime_error("Failed to build collision table from garage graph: " + err_msg);
    }
    SaveTable();
  }
}

std::vector<std::unique_ptr<CollisionEntity>> CollisionTable::BuildEntityTable(const GarageGraph& gg) const {
  std::vector<std::unique_ptr<CollisionEntity>> entity_table;
  // Construct entity table. Once table is built we won't need these.
  entity_table.emplace_back(std::make_unique<AgvEntity>(gg.GetLayout()));
  entity_table.emplace_back(std::make_unique<TrayEntity>(gg.GetLayout()));
  entity_table.emplace_back(std::make_unique<BayOdpEntity>(gg.GetLayout()));
  entity_table.emplace_back(std::make_unique<TrayLegsEntity>(gg.GetLayout()));

  std::sort(entity_table.begin(), entity_table.end(),
      [](const std::unique_ptr<CollisionEntity>& a, const std::unique_ptr<CollisionEntity>& b) {
        return a->GetCollisionEntityId() < b->GetCollisionEntityId();
      });

  for(size_t window_idx = 0; window_idx < gg.GetLayout()->GetResourceWindows().size(); window_idx++) {
    auto window = gg.GetLayout()->GetResourceWindow(static_cast<int>(window_idx)).value();
    entity_table.emplace_back(std::make_unique<PayloadEntity>(window_idx, window, gg.GetLayout()));
  }

  return entity_table;
}

BoolStringPair CollisionTable::BuildTable(const GarageGraph& gg) {
  auto entity_table = BuildEntityTable(gg);

  // TODO(Gunther): Only build queries we'll ever make. ie: ignore AGV -> TrayLegs since a fixed
  // AGV and a moving TrayLeg
  //                will be handled by AGV -> Tray.
  // TODO(Gunther): Treat poses & reciprocals as the same key
  for(auto [it, end] = gg.GetVertices(); it != end; it++) {
    INFOF(logger_, "Building collision table.  Vertex ID: %s", std::to_string(*it).c_str());
    const auto fixed_pose_opt = gg.GetPoseFromVertex(*it);
    if(!fixed_pose_opt.has_value()) {
      return std::make_pair(false, std::format("Vertex does not exist in GarageGraph. Vertex ID: {}", *it));
    }
    const GaragePoseMsg fixed_pose = fixed_pose_opt.value();

    const auto fixed_node_opt = gg.GetLayout()->GetNodeById(fixed_pose.node_id);
    if(!fixed_node_opt.has_value()) {
      return std::make_pair(
          false, std::format("Vertex does not exist as node in layout. Vertex ID: {}", *it));
    }
    const GarageNodeMsg fixed_node = fixed_node_opt.value();

    for(size_t fixed_resource = 0; fixed_resource < entity_table.size(); fixed_resource++) {
      if(fixed_resource == common::EnumInteger(CollisionEntityId::BAY_ODP)) {
        // Skip poses that aren't in bays
        if(fixed_node.type != GarageNodeMsg::TYPE_BAY) {
          continue;
        }
      }

      auto fixed_poly = entity_table[fixed_resource]->PolyAtPose(fixed_pose);
      Circle fixed_circle = entity_table[fixed_resource]->CircleAtPose(fixed_pose);

      // Bays are checked first, and bays don't collide with themselves
      // so just skip that check by starting at 1
      for(size_t conflicting_resource = 1u; conflicting_resource < entity_table.size();
          conflicting_resource++) {
        for(auto conflicting_it = gg.GetVertices().first; conflicting_it != end; conflicting_it++) {
          auto conflicting_opt = gg.GetPoseFromVertex(*conflicting_it);
          if(!conflicting_opt.has_value()) {
            return std::make_pair(
                false, std::format("Vertex does not exist in GarageGraph. Vertex ID: {}", *conflicting_it));
          }
          const Pose conflicting_pose = conflicting_opt.value();

          const auto conflicting_node_opt = gg.GetLayout()->GetNodeById(conflicting_pose.node_id);
          if(!conflicting_node_opt.has_value()) {
            return std::make_pair(
                false, std::format("Vertex does not exist as node in layout. Vertex ID: {}", *it));
          }
          const GarageNodeMsg conflicting_node = conflicting_node_opt.value();

          // Nodes on different floors do not collide unless both are VRC nodes
          const bool both_on_vrc =
              IsVrcNode(fixed_node, *gg.GetLayout()) && IsVrcNode(conflicting_node, *gg.GetLayout());
          if((fixed_node.floor != conflicting_node.floor) && !both_on_vrc) {
            continue;
          }

          Circle conflicting_circle = entity_table[conflicting_resource]->CircleAtPose(conflicting_pose);
          if(!fixed_circle.CircleIntersects(conflicting_circle)) {
            continue;
          }

          auto conflicting_poly = entity_table[conflicting_resource]->PolyAtPose(conflicting_pose);
          if(fixed_poly.Intersects(conflicting_poly)) {
            LOG_DEBUG(logger_, "Found pose collision {}",
                CollisionToString(
                    fixed_resource, fixed_pose, conflicting_resource, conflicting_pose, *(gg.GetLayout())));
            // Fill in table and reciprocals
            ppmap_[fixed_resource][fixed_pose][conflicting_resource].emplace(conflicting_pose);
            ppmap_[conflicting_resource][conflicting_pose][fixed_resource].emplace(fixed_pose);

            if(logger_.get_effective_level() == Level::Debug) {
              // Edges aren't done yet.
              auto const [q_pose, _] = Query(fixed_resource, conflicting_resource, fixed_pose);
              std::ostringstream query_oss, conflict_oss;
              query_oss << q_pose;
              LOG_DEBUG(logger_, "Query after adding to table: {}", query_oss.str());
              conflict_oss << ppmap_.at(fixed_resource).at(fixed_pose).at(conflicting_resource);
              LOG_DEBUG(logger_, "Raw map contents: {}", conflict_oss.str());
            }
          }
        }

        for(auto [e_it, e_end] = gg.GetEdges(); e_it != e_end; ++e_it) {
          const auto src_opt = gg.GetPoseFromVertex(e_it->m_source);
          const auto dst_opt = gg.GetPoseFromVertex(e_it->m_target);
          if(!src_opt.has_value() || !dst_opt.has_value()) {
            return std::make_pair(false, std::format("Vertex does not exist in GarageGraph. Vertex ID: {} {}",
                                             !src_opt.has_value() ? std::to_string(e_it->m_source) : "",
                                             !dst_opt.has_value() ? std::to_string(e_it->m_target) : ""));
          }
          const GaragePoseMsg src = src_opt.value();
          const GaragePoseMsg dst = dst_opt.value();

          const auto src_node_opt = gg.GetLayout()->GetNodeById(src.node_id);
          const auto dst_node_opt = gg.GetLayout()->GetNodeById(dst.node_id);
          if(!src_node_opt.has_value() || !dst_node_opt.has_value()) {
            return std::make_pair(
                false, std::format("Vertex does not exist as node in layout. Vertex ID: {} {}",
                           !src_node_opt.has_value() ? std::to_string(e_it->m_source) : "",
                           !dst_node_opt.has_value() ? std::to_string(e_it->m_target) : ""));
          }
          const GarageNodeMsg src_node = src_node_opt.value();
          const GarageNodeMsg dst_node = dst_node_opt.value();

          // Edges where both nodes are not on the same floor as the fixed node do not collide
          const bool both_on_vrc =
              IsVrcNode(fixed_node, *gg.GetLayout()) && IsEdgeOnVrc(src_node, dst_node, *gg.GetLayout());
          if((src_node.floor != fixed_node.floor) && (dst_node.floor != fixed_node.floor) && !both_on_vrc) {
            continue;
          }

          Circle conflicting_circle = entity_table[conflicting_resource]->CircleAtEdge(src, dst);

          if(!fixed_circle.CircleIntersects(conflicting_circle)) {
            continue;
          }

          Edge edge {src, dst};
          auto conflicting_poly = entity_table[conflicting_resource]->PolyAtEdge(src, dst);
          if(fixed_poly.Intersects(conflicting_poly)) {
            LOG_DEBUG(logger_, "Found edge collision {}",
                CollisionToString(fixed_resource, fixed_pose, conflicting_resource, edge, *(gg.GetLayout())));
            pemap_[fixed_resource][fixed_pose][conflicting_resource].emplace(edge);
            epmap_[conflicting_resource][edge][fixed_resource].emplace(fixed_pose);

            if(logger_.get_effective_level() == Level::Debug) {
              // Edges aren't done yet.
              auto const [q_pose, q_edge] = Query(fixed_resource, conflicting_resource, fixed_pose);
              std::ostringstream query_oss, conflict_oss;
              query_oss << q_pose << " -- " << q_edge;
              LOG_DEBUG(logger_, "Query after adding to table: {}", query_oss.str());
              conflict_oss << pemap_.at(fixed_resource).at(fixed_pose).at(conflicting_resource);
              LOG_DEBUG(logger_, "Raw map contents: [{}]", conflict_oss.str());
            }
          }
        }
      }
    }
  }

  // Calculate Edge-Edge collisions.

  for(auto [fixed_it, fixed_end] = gg.GetEdges(); fixed_it != fixed_end; ++fixed_it) {
    auto fixed_src_opt = gg.GetPoseFromVertex(fixed_it->m_source);
    auto fixed_dst_opt = gg.GetPoseFromVertex(fixed_it->m_target);
    if(!fixed_src_opt.has_value() || !fixed_dst_opt.has_value()) {
      return std::make_pair(false, std::format("Vertex does not exist in GarageGraph. Vertex ID: {} {}",
                                       !fixed_src_opt.has_value() ? std::to_string(fixed_it->m_source) : "",
                                       !fixed_dst_opt.has_value() ? std::to_string(fixed_it->m_target) : ""));
    }

    INFOF(logger_, "Building collision table.  Edge: %s - %s ", std::to_string(fixed_it->m_source).c_str(),
        std::to_string(fixed_it->m_target).c_str());

    const auto fixed_src = fixed_src_opt.value();
    const auto fixed_dst = fixed_dst_opt.value();

    const auto fixed_src_node_opt = gg.GetLayout()->GetNodeById(fixed_src.node_id);
    const auto fixed_dst_node_opt = gg.GetLayout()->GetNodeById(fixed_dst.node_id);
    if(!fixed_src_node_opt.has_value() || !fixed_dst_node_opt.has_value()) {
      return std::make_pair(
          false, std::format("Vertex does not exist as node in layout. Vertex ID: {} {}",
                     !fixed_src_node_opt.has_value() ? std::to_string(fixed_it->m_source) : "",
                     !fixed_dst_node_opt.has_value() ? std::to_string(fixed_it->m_target) : ""));
    }
    const GarageNodeMsg fixed_src_node = fixed_src_node_opt.value();
    const GarageNodeMsg fixed_dst_node = fixed_dst_node_opt.value();

    Edge fixed_edge {fixed_src, fixed_dst};
    for(size_t fixed_resource = 0; fixed_resource < entity_table.size(); fixed_resource++) {
      if(fixed_resource == common::EnumInteger(CollisionEntityId::BAY_ODP)) {
        // Bays don't move on edges
        continue;
      }
      auto fixed_poly = entity_table[fixed_resource]->PolyAtEdge(fixed_src, fixed_dst);
      Circle fixed_circle = entity_table[fixed_resource]->CircleAtEdge(fixed_src, fixed_dst);
      // this represents the polygon of the fixed entity at the edge
      for(size_t conflicting_resource = fixed_resource; conflicting_resource < entity_table.size();
          conflicting_resource++) {
        if(conflicting_resource == common::EnumInteger(CollisionEntityId::BAY_ODP)) {
          // Bays don't move on edges
          continue;
        }
        for(auto e_it = gg.GetEdges().first; e_it != fixed_end; ++e_it) {
          auto src_opt = gg.GetPoseFromVertex(e_it->m_source);
          auto dst_opt = gg.GetPoseFromVertex(e_it->m_target);
          if(!src_opt.has_value() || !dst_opt.has_value()) {
            return std::make_pair(false, std::format("Vertex does not exist in GarageGraph. Vertex ID: {} {}",
                                             !src_opt.has_value() ? std::to_string(e_it->m_source) : "",
                                             !dst_opt.has_value() ? std::to_string(e_it->m_target) : ""));
          }
          auto src = src_opt.value();
          auto dst = dst_opt.value();

          const auto src_node_opt = gg.GetLayout()->GetNodeById(src.node_id);
          const auto dst_node_opt = gg.GetLayout()->GetNodeById(dst.node_id);
          if(!src_node_opt.has_value() || !dst_node_opt.has_value()) {
            return std::make_pair(
                false, std::format("Vertex does not exist as node in layout. Vertex ID: {} {}",
                           !src_node_opt.has_value() ? std::to_string(e_it->m_source) : "",
                           !dst_node_opt.has_value() ? std::to_string(e_it->m_target) : ""));
          }
          const GarageNodeMsg src_node = src_node_opt.value();
          const GarageNodeMsg dst_node = dst_node_opt.value();

          // Edges on different floors do not collide unless both edges are on the VRC
          const bool both_on_vrc = IsEdgeOnVrc(fixed_src_node, fixed_dst_node, *gg.GetLayout()) &&
                                   IsEdgeOnVrc(src_node, dst_node, *gg.GetLayout());
          if((fixed_src_node.floor != src_node.floor) && (fixed_src_node.floor != dst_node.floor) &&
              (fixed_dst_node.floor != src_node.floor) && (fixed_dst_node.floor != dst_node.floor) &&
              !both_on_vrc) {
            continue;
          }

          Circle conflicting_circle = entity_table[conflicting_resource]->CircleAtEdge(src, dst);
          if(!fixed_circle.CircleIntersects(conflicting_circle)) {
            continue;
          }

          Edge edge {src, dst};

          auto conflicting_poly = entity_table[conflicting_resource]->PolyAtEdge(src, dst);

          if(fixed_poly.Intersects(conflicting_poly)) {
            LOG_DEBUG(logger_, "Found edge-edge collision {}",
                CollisionToString(fixed_resource, fixed_edge, conflicting_resource, edge, *(gg.GetLayout())));
            eemap_[fixed_resource][fixed_edge][conflicting_resource].emplace(edge);
            eemap_[fixed_resource][edge][conflicting_resource].emplace(fixed_edge);
            eemap_[conflicting_resource][edge][fixed_resource].emplace(fixed_edge);
            eemap_[conflicting_resource][fixed_edge][fixed_resource].emplace(edge);
          }
        }
      }
    }
  }
  return std::make_pair(true, "");
}

