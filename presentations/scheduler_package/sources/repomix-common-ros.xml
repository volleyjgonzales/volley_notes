  // NOTE: Some events might be severe. We nevertheless always use RCLCPP_INFO.
  INFOS(logger, std::to_string(event));
}

void PrintServiceResponse(
    const rclcpp::Logger& logger, std::string service_name, bool success, std::string message) {
  std::string header = "Service: \"" + service_name + "\" called. Response: ";
  if(success) {
    RCLCPP_DEBUG_STREAM(logger, header + message);
  }
  else {
    ERRORS(logger, header + message);
  }
}

std::chrono::nanoseconds GetMessageStaleness(const std_msgs::msg::Header& header, const rclcpp::Time& now) {
  rclcpp::Time header_time {header.stamp.sec, header.stamp.nanosec, now.get_clock_type()};
  return std::chrono::nanoseconds {(now - header_time).nanoseconds()};
}

std::chrono::nanoseconds GetDt(const std_msgs::msg::Header& h1, const std_msgs::msg::Header& h2) {
  rclcpp::Time h1_time {h1.stamp.sec, h1.stamp.nanosec};
  rclcpp::Time h2_time {h2.stamp.sec, h2.stamp.nanosec};
  return std::chrono::nanoseconds {(h2_time - h1_time).nanoseconds()};
}

std::optional<GuidMsg> ParseGuid(const std::string& string) {
  // The string must be 36 characters long
  if(string.size() != 36) {
    return std::nullopt;
  }

  GuidMsg guid {};

  // ex: "936DA01F-9ABD-4d9d-80C7-02AF85C822A8"
  unsigned int b = 0;
  bool first_nibble = true;
  for(int four_nibble_block_index_start : {0, 4, 9, 14, 19, 24, 28, 32}) {
    for(int j = 0; j < 4; j++) {
      char c = string.at(four_nibble_block_index_start + j);
      uint8_t nibble = 0x00;
      if(c >= '0' && c <= '9') {
        nibble = c - '0';
      }
      else if(c >= 'a' && c <= 'f') {
        nibble = c - 'a' + 10;
      }
      else if(c >= 'A' && c <= 'F') {
        nibble = c - 'A' + 10;
      }
      else {
        return std::nullopt;  // failed to parse nibble
      }

      // Set the nibble and advance our state
      if(first_nibble) {
        guid.bytes[b] = nibble << 4;
      }
      else {
        guid.bytes[b] |= (nibble & 0x0F);
        b++;  // done with byte - advance
      }
      first_nibble = !first_nibble;
    }
  }

  return guid;
}

std::string GuidToString(const GuidMsg& guid) {
  static constexpr std::string_view kHex = "0123456789ABCDEF";
  std::string s;
  s.reserve(36);
  for(int i = 0; i < 16; i++) {
    if(i == 4 || i == 6 || i == 8 || i == 10) {
      s += '-';
    }
    s += kHex.at((guid.bytes.at(i) >> 4) & 0xF);
    s += kHex.at(guid.bytes.at(i) & 0xF);
  }
  return s;
}

GuidMsg MakeGuid(uint64_t left, uint64_t right) {
  GuidMsg guid {};
  guid.bytes[0] = left >> 56;
  guid.bytes[1] = (left >> 48) & 0xFF;
  guid.bytes[2] = (left >> 40) & 0xFF;
  guid.bytes[3] = (left >> 32) & 0xFF;
  guid.bytes[4] = (left >> 24) & 0xFF;
  guid.bytes[5] = (left >> 16) & 0xFF;
  guid.bytes[6] = (left >> 8) & 0xFF;
  guid.bytes[7] = left & 0xFF;
  guid.bytes[8] = right >> 56;
  guid.bytes[9] = (right >> 48) & 0xFF;
  guid.bytes[10] = (right >> 40) & 0xFF;
  guid.bytes[11] = (right >> 32) & 0xFF;
  guid.bytes[12] = (right >> 24) & 0xFF;
  guid.bytes[13] = (right >> 16) & 0xFF;
  guid.bytes[14] = (right >> 8) & 0xFF;
  guid.bytes[15] = right & 0xFF;
  return guid;
}

GuidMsg MakeGuid(const std::array<uint8_t, 16>& bytes) {
  GuidMsg guid;
  guid.bytes = bytes;
  return guid;
}

uint64_t GetGuidLow64Bytes(const GuidMsg& guid) {
  uint64_t retval = 0;
  std::memcpy(&retval, &guid.bytes[8], sizeof(retval));
  retval = htobe64(retval);  // change endianness
  return retval;
}

