<file path="interfaces/msg/AgvState.msg">
std_msgs/Header header

uint8 INTERSECTION_NOT_CENTERED = 0   # Not centered at an intersection
uint8 INTERSECTION_MOVE_CENTERED = 1  # Centered at intersection enough to move to another intersection
uint8 INTERSECTION_TRAY_CENTERED = 2  # Centered at intersection enough to place or pick up a tray

# The state of the AGV relative to an observable intersection. While this state can instantaneously
#  be inferred from from the other values in this message, this status contains some additional
#  debouncing to account for potential estimation noise.
uint8 intersection_status  # See INTERSECTION_* values defined above

bool is_stopped  # True if the vehicle velocities are below the specified thresholds. Debounced.

GeometricPose geometric_pose  # Global-frame pose.
Twist velocity_body           # Body-frame velocities.
Accel accel_body              # Body-frame accelerations.
float32[4] lift_fractions     # Lift fractions of each individual actuator where 0 -> down, 1 -> up

uint32 floor                # Id of the floor the AGV is on

# Body-frame covariance for (x_body, x_body), (y_body, y_body) and (yaw, yaw). Useful for debugging.
GeometricPose body_pose_covariance

# Flags indicating if the uncertainty around the geometric pose in a given body-frame axis is low
#  enough to be trustworthy for the controller
bool controllable_x
bool controllable_y
bool controllable_yaw

# Continuously estimated discrete pose. Note that this estimate is decoupled from the controller and
#  so will update *before* the agv is all the way over this pose. The pose updates as soon as the
#  sensors are all confident that they see an intersection.
GaragePose garage_pose

bool motors_enabled  # True if all the motors are operational and enabled

# Gyro biases. In the order specified in LineSensorId in agv_devices.hpp
float32[6] gyro_biases

# Slip parameters (see the doc "Mecanum Wheeled Robot Kinematics and Dynamics" in the sim folder for details)
float32 alpha_w  # Wheel slip
float32 alpha_r  # Roller slip
float32 alpha_c  # Slip about the roller point of contact
</file>

