<file path="interfaces/msg/GarageLayout.msg">
# A Garage layout is the graph over which AGVs (and thus trays and payloads) traverse
# Edges are undirected

# If an edge connects two nodes, then it is assumed that we can transition along that edge
# with any heading that is allowed in each node.
# For example, if node A allows headings {0,45,90}
#             and node B allows headings {45, 90}
# then an edge A <-> B means we can traverse with headings {45,90}

# We can point out exceptions to this edge connectivity by including disallowed edge orientations

std_msgs/Header header
string name
GarageNode[] nodes
GarageFloor[] floors
Edge[] edges
DisallowedEdgeOrientation[] disallowed_edge_orientations

ParkingWindow buffer # The parking window buffer dimensions - small buffer applied when computing constraints
ParkingWindow[] resource_windows # The resource sizes allowed for nodes in the garage.
</file>

<file path="interfaces/msg/GarageNode.msg">
uint8 TYPE_UNKNOWN = 0
uint8 TYPE_PARKING = 1
uint8 TYPE_WAYPOINT = 2
uint8 TYPE_LIFT = 3
uint8 TYPE_BAY = 4
uint8 TYPE_AGV_CHARGE = 5
uint8 TYPE_EV_CHARGE = 6
uint8 TYPE_BLIFT = 7

# A garage node is a fixed vertex in the garage to which AGVs can move

uint32 id

# location in east-north-up [m]
float32 x
float32 y

# Id of the floor the node is on
uint8 floor

# See the node types below
uint8 type

# The maximum parking window that this node supports
string max_resource_size

# The index of the maximum resource size that this node supports
uint8 max_resource_size_index

# Only for Bay nodes: High positive values -> high preference to be ready for insert. Low negative values -> high preference to be ready for retrieve
int16 bay_prioritization

# Whether we allow rotation on this node
bool rotation_allowed

# The headings that an AGV may have on this node.
# Guaranteed to have at least one heading.
# Headings are in degrees, 0:179, in increasing order.
# Headings can all be flipped by 180.
int16[] headings

# A bay or charge node is expected to only have a single valid heading in [0,179]
# If this value is false, the bay's outer door faces that direction, and an AGV on a charge node must have this heading.
# If this value is true, the bay's outer door faces 180 opposite that direction.
bool faces_reciprocal

# Only for Bay nodes: The floor at which the patron inserts, and all reachable system floors
# for the standard "bay" configuration this should be `floor` and `[floor]` meaning we insert and retrieve at a single, same floor.
# When loading from yaml insert_floor = floor and system_floors = [floor] by default if not set.

uint8 insert_floor
uint8[] system_floors
