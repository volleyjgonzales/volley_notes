<file path="agv_interfaces/msg/NodeAccuracy.msg">
# AGV node accuracy.

# Identifier of the node the offset values are measured against.
uint32 node_id

# Heading of the node in the garage frame, +x (east), +y (north), +z (up).
int16 node_heading_deg

# x-axis offset from the node origin, in the AGV frame.
float64 x_offset_m

# False if x_offset_m could not be computed.
bool x_offset_valid false

# y-axis offset from the node origin, in the AGV frame.
float64 y_offset_m

# False if y_offset_m could not be computed.
bool y_offset_valid false

# Heading offset from the node origin, in the AGV frame (CCW positive).
float64 yaw_offset_rad

# False if yaw_offset_rad could not be computed.
bool yaw_offset_valid false

# Informational message, e.g. for invalid fields.
string message
</file>

