VrcState state

# Human readable state description
string state_description

GateReport[] gates

# If state.value is STATE_IDLE this represents the current floor the VRC is on
# If not, this represents the last floor the VRC was idle on or passed while moving
uint16 current_floor

# If state.value is STATE_MOVING this represents the floor the VRC is moving to
# If not, this will be set to the current_floor
uint16 requested_floor

# Positive distance from the lowest indexed floor in meters
float32 carriage_height_m
</file>

