<file path="interfaces/CMakeLists.txt">
cmake_minimum_required(VERSION 3.28)
project(interfaces)

find_package(volley_cmake REQUIRED)
volley_package()

file(
  GLOB_RECURSE interface_files
  CONFIGURE_DEPENDS
  RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}"
  "msg/*.msg"
  "srv/*.srv"
  "action/*.action"
)

rosidl_generate_interfaces(
  ${PROJECT_NAME}
  ${interface_files}
  DEPENDENCIES
    geometry_msgs
    std_msgs
    vrc_interfaces
)

ament_export_dependencies(rosidl_default_runtime)

volley_ament_auto_package()
</file>

