<file path="interfaces/msg/AgvCommand.msg">
# Commands for an AGV in the garage

# The full source and destination nodes and lift states are specified in every command. The AGV
#   software will reject any command that does not end up strictly being one of the following:
#  - Translate: src.pose.node_id != dst.pose.node_id; src.pose.heading == dst.pose.heading;
#               src.lift == dst.lift
#  - Rotate: src.pose.node_id == dst.pose.node_id; src.pose.heading != dst.pose.heading;
#               src.lift == dst.lift
#  - Lift: src.pose.node_id == dst.pose.node_id; src.pose.heading == dst.pose.heading;
#               src.lift != dst.lift
#  - Center: src == dst

# Every command has a unique GUID string that we can use to keep track of it
string id

# There may be other poses between src and dst
AgvGoal src
AgvGoal dst
</file>

