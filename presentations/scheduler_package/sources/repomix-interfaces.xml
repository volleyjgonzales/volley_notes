<file path="vrc_interfaces/action/VrcMove.action">
# Action for moving a Vertical Reciprocating Conveyor (VRC) to a target floor

# Goal
uint16 requested_floor
---

# Result
# If succeeded: current floor matches requested floor
# Else: current floor is the last floor the VRC was positioned at
uint16 current_floor
string message
---

# Feedback
# Positive distance from the lowest indexed floor in meters
uint16 current_floor
float32 carriage_height_m
</file>

