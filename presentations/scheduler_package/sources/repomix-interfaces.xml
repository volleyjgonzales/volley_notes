<file path="interfaces/msg/VehicleBayPose.msg">
# Error flag definitions. Must be powers of two to fit in the error_flags bitfield.
uint16 ERROR_FLAG_NONE = 0
uint16 ERROR_FLAG_OVERWEIGHT = 1             # Vehicle is over its maximum permitted weight
uint16 ERROR_FLAG_TOO_LONG = 2               # Vehicle is too long
uint16 ERROR_FLAG_TOO_WIDE = 4               # Vehicle is too wide
uint16 ERROR_FLAG_WHEELBASE_TOO_LONG = 8     # Vehicle wheelbase is too long
uint16 ERROR_FLAG_LIDAR_PATRON_TRIPPED = 16  # The Patron lidar is tripped
uint16 ERROR_FLAG_LIDAR_SYSTEM_TRIPPED = 32  # The System lidar is tripped
uint16 ERROR_FLAG_LIDAR_RIGHT_TRIPPED = 64   # The Right lidar is tripped
uint16 ERROR_FLAG_LIDAR_LEFT_TRIPPED = 128   # The Left lidar is tripped
uint16 ERROR_FLAG_TIRE_PATRON_TRIPPED = 256  # The Patron tire sensor is tripped
uint16 ERROR_FLAG_TIRE_SYSTEM_TRIPPED = 512  # The System tire sensor is tripped
uint16 ERROR_FLAG_TOO_TALL = 1024            # Vehicle is too tall to park

std_msgs/Header header

# Vehicle physical characteristics (depending on the sensing configuration of the bay we may not
# be able to measure these)
float32 height    # [m]
float32 width     # [m]
float32 length    # [m]
float32 wheelbase # [m]
float32 mass      # [kg]

# Location of the vehicle relative to the center of the tray
float32 x # [m] Along the tray length, + toward the system side
float32 y # [m] Along the tray width, + toward the left side (facing system)

# Velocity of the vehicle
float32 x_dot # [m/s]
float32 y_dot # [m/s]

# Values from the axle counter used for debugging missed axles
float32 mass_total_mean               # [kg]
float32 mass_total_standard_deviation # [kg]
float32 mass_delta                    # [kg]
float32 mass_before_tire_sensor_trip  # [kg]

# Discrete estimated states
bool vehicle_identified  # Do the sensors detect the presence of a vehicle?
bool tires_on_tray       # Do we sense the tires fully on the tray?
bool bounding_box_clear  # Is the laser bounding box clear?
bool tray_present        # Do we sense a tray in the bay?
uint8 num_axles_on_tray  # How many vehicle axles are on the tray

# Cumulative states. Based on all of the above, is/was the vehicle properly parked in the bay?
bool vehicle_is_properly_parked   # Real-time, does the vehicle meet all of the criteria for being parked?
bool vehicle_was_properly_parked  # While the vehicle was driving in, was it at one point properly parked?

# Error flags
uint16 error_flags  # Bitfield of error flags. See ERROR_FLAG_* definitions.
</file>

<file path="interfaces/msg/VersionInfo.msg">
std_msgs/Header header

# Entity name, such as "a16" for an AGV or "b2" for a bay.
# The central cluster's name is "central".
string name

# Human-readable readable release tag, usually a semver. Ex: v0.1.70
# The release tag is not guaranteed to uniquely identify the software version, but
# is a quick human-readable reference. Please use the gitsha below for the exact version.
string release

# The software version is contained in the GITSHA, which is a 40-character hex string,
# for example f50b51e4602e6ecff349bc12216b572bbd25181e.
# Each entity docker container is expected to have an env var "GITSHA" that contains this string.
string<=40 gitsha

# An md5sum of the layout file, which is a 32-character hex string,
# for example 2d084710e3b8c1656d5ae01da9d4e008
string<=32 layout_md5sum
</file>

