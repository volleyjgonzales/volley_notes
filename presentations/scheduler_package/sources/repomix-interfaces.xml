<file path="interfaces/msg/AgvReport.msg">
# Note: due to the way we store the State in the GarageTracker, state values should not be
# renumbered. New states should be added to the end of the list, taking new values.
uint8 STATE_BOOTING = 0
uint8 STATE_HARDWARE_VALIDATION = 1
uint8 STATE_NOT_LOCALIZED = 2
uint8 STATE_CENTERING = 3
uint8 STATE_STOPPED = 4
uint8 STATE_ACTIVE = 5
uint8 STATE_JOYSTICK = 6
uint8 STATE_ERROR = 7

uint8 LIFT_STATE_UNKNOWN = 0
uint8 LIFT_STATE_DOWN = 1
uint8 LIFT_STATE_IN_BETWEEN = 2
uint8 LIFT_STATE_UP = 3

std_msgs/Header header
string name # AGV namespace
uint16 agv_id
uint8 state # Top-level vehicle state. See STATE_* enum above
string state_string # Human-readable version of state
string fault_reason # Reason for fault, if any. In the case of multiple faults, only the first is displayed
bool is_moving
bool is_charging
uint8 lift_state # See LIFT_STATE enum above
uint16 tray_id # ID of the tray which the robot is currently under
uint32 installation_id
float32 battery_fraction # 0.0 -> 0% charged, 1.0 -> 100% charged
AgvGoal garage_pose_and_lift # Most recent fully complete garage pose
GeometricPose pose
GeometricPose next_pose # The destination pose; set to current pose if the vehicle has no active new destination
AgvGoal current_goal
string current_goal_type
string current_goal_id
AgvGoal next_goal
string next_goal_type
string next_goal_id
AgvGoal final_goal # The final goal. Might be equal to current_goal or next_goal depending on how many goals are in the queue.
string final_goal_type
string final_goal_id
