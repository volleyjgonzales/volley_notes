<file path="interfaces/msg/GarageEvent.msg">
# Garage events are special occurrences. They are often associated with service calls.
# These events are written to /rosout. (See PrintEvent in ros_utils.) with the format:
#   EVENT(type,agv_id,bay_id,tray_id,payload_id)
# For example, an EVENT_BAY_ENQUEUE with bay 3 might produce:
#   "EVENT(2,0,3,0,00000000-0000-0000-0000-000000001234,)"

# These events get timestamps because we write them to /rosout.
# They are thus parsed as Log messages, which have the fields:
# rcl_interfaces.msg.Log
#     stamp::builtin_interfaces.msg.Time,
#     level::int     indicates debug/info/warn/error/fatal
#     name::string   ex: 'bay.b1001.patron.patron_door'
#     msg::string
#     file::string
#     function::string
#     line::int

uint16 EVENT_UNKNOWN = 0

# (sim-only) A payload was inserted into the patron queue
# Populates payload_id
uint16 EVENT_PATRON_ENQUEUE = 1

# (sim-only) A payload was inserted into a bay's arrival queue
# Populates payload_id and bay_id
uint16 EVENT_BAY_ENQUEUE = 2

# A customer confirmed their payload to be inserted into the garage system
# Populates payload_id and bay_id
uint16 EVENT_CUSTOMER_CONFIRMED_BAY_INSERT = 3

# A customer requested that their payload be retrieved from the garage
# Populates payload_id
uint16 EVENT_RETRIEVE = 4

# A payload was delivered to a bay and the AGV is out of the way
# Populates bay_id
uint16 EVENT_PAYLOAD_DELIVERED = 5

# A customer confirmed that they will receive their payload at a bay
# Populates bay_id
uint16 EVENT_CUSTOMER_CONFIRMED_BAY_RETRIEVE = 6

# The parking service told the dispatcher that the payload can be removed
# This occurs when the payload has been driven from the bay and the bay
# is in READY_TO_RETRIEVE.
# Populates bay_id
uint16 EVENT_PAYLOAD_REMOVED_FROM_BAY = 7

# An AGV command was overwritten.
# Populates agv_id
uint16 EVENT_AGV_COMMAND_OVERWRITTEN = 100

# An AGV received a stop command, and it was accepted
# Populates agv_id
uint16 EVENT_AGV_STOP_ACCEPTED = 101

# An AGV received a stop now command, and it was accepted
# Populates agv_id
uint16 EVENT_AGV_STOP_NOW_ACCEPTED = 102

# AGV received localized event
# Populates agv_id
uint16 EVENT_AGV_LOCALIZED = 103

# AGV received activate event
# Populates agv_id
uint16 EVENT_AGV_ACTIVATE = 104

# AGV received enable joystick event
# Populates agv_id
uint16 EVENT_AGV_ENABLE_JOYSTICK = 105

# AGV received disable joystick event
# Populates agv_id
uint16 EVENT_AGV_DISABLE_JOYSTICK = 106

# AGV received fault event
# Populates agv_id
uint16 EVENT_AGV_FAULT = 107

# AGV received lift up event
# Populates agv_id, command_id
uint16 EVENT_AGV_LIFT_UP_COMPLETED = 108

# AGV received lift down event
# Populates agv_id, command_id
uint16 EVENT_AGV_LIFT_DOWN_COMPLETED = 109

# AGV started charging
# Populates agv_id, command_id
uint16 EVENT_AGV_CHARGING_STARTED = 110

# AGV stopped charging
# Populates agv_id, command_id
uint16 EVENT_AGV_CHARGING_STOPPED = 111

# An AGV's battery fraction was set in sim
uint16 EVENT_SIM_AGV_BATTERY_FRACTION_SET = 201

# A collision was detected.
uint16 EVENT_SIM_AGV_COLLISION = 999

# The event type that specifies what occurred.
uint16 type

# Optionally specify relevant entities
uint16 agv_id
uint16 bay_id
uint16 tray_id
string payload_id
string command_id
</file>

