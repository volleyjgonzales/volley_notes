<file path="interfaces/msg/ActionNode.msg">
# A node in a Schedule

# Types
uint8 TYPE_AGV_COMMAND = 1
uint8 TYPE_BAY_COMMAND = 2
uint8 TYPE_VECS_COMMAND = 3
uint8 TYPE_VRC_COMMAND = 4

# Status
uint8 STATUS_NOT_RECEIVED = 0 # Action has not been acknowledged as received by the entity
uint8 STATUS_RECEIVED = 1 # Action has been acknowledged as received by the entity
uint8 STATUS_COMPLETED = 2 # Action is complete

Guid guid # this node's unique identifier
Guid job_id # the guid for the job this node is associated with
uint8 type # see the TYPE_* enum above
uint32[] parents # Indices of the parent nodes that this node depends on
float32 duration # The action duration, in seconds. Note that some actions have infinite duration.
uint8 status # see the STATUS_* enum above
bool outside_split # if true, this node is outside the split in the schedule while waiting on the plan call response and will not be sent

# The following fields are only set when appropriate for the given type.
# For example, `agv_id` is only set for TYPE_AGV_COMMAND

# AGV command
uint32 agv_id
AgvCommand agv_command

# Bay command
uint32 bay_id
BayCommand bay_command

# Vecs Command
uint32 vecs_id
VecsCommand vecs_command

# VRC Command
uint32 vrc_id
VrcCommand vrc_command
</file>

