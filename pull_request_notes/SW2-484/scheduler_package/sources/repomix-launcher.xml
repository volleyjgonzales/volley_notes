import os


def get_artifacts_dir() -> str:
    """Returns the artifacts directory, defaulting to artifacts/ under the ROS home directory."""
    artifacts_dir = os.environ.get("ARTIFACTS_DIR")
    if not artifacts_dir:
        artifacts_dir = os.path.join(get_ros_home_dir(), "artifacts")

    return artifacts_dir


def get_ros_home_dir() -> str:
    """Returns the ROS home directory, defaulting to ~/.ros when ROS_HOME is unset."""
    ros_home = os.environ.get("ROS_HOME")
    if not ros_home:
        ros_home = os.path.join(os.path.expanduser("~"), ".ros")

    return ros_home
