#!/usr/bin/env python3
"""
Input a layout yaml file. Output generated layout visual.

Draws every node labeled with its node ID, and a line for every edge.
Node shape indicates node type:
  Waypoint   -> circle
  Parking    -> square
  AgvCharge  -> triangle
  EvCharge   -> triangle (different color)
  Bay        -> star (larger)
  Lift/BLift -> diamond

Example:
ros2 run launcher layout_plotter 5675_pecos_combined
ros2 run launcher layout_plotter 5675_pecos_combined -o /tmp/5675_pecos_combined.png --show
"""
import sys

import click
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D

import common_py.layout
from common_py.layout import NODE_TYPE_MAP

from pathlib import Path

NODE_STYLE = {
    "Waypoint": {"marker": "o", "color": "tab:blue", "size": 120},
    "Parking": {"marker": "s", "color": "tab:green", "size": 120},
    "AgvCharge": {"marker": "^", "color": "tab:orange", "size": 160},
    "EvCharge": {"marker": "^", "color": "tab:red", "size": 160},
    "Bay": {"marker": "*", "color": "tab:purple", "size": 320},
    "Lift": {"marker": "D", "color": "tab:brown", "size": 200},
    "BLift": {"marker": "D", "color": "tab:pink", "size": 200},
}
DEFAULT_STYLE = {"marker": "x", "color": "black", "size": 120}

GRID_LINE_COLOR = "#e5e5e5"
EDGE_LINE_COLOR = "#999999"


def plot_grid(ax, layout, node_ids, label_nodes=True, show_grid=False):
    node_by_id = {node_id: layout.get_node(node_id) for node_id in node_ids}

    if show_grid:
        ax.grid(True, color=GRID_LINE_COLOR, linewidth=0.5, zorder=0)
        ax.set_axisbelow(True)

    for src_index, dst_index in layout.graph.edges():
        src = layout.nodes[src_index]
        dst = layout.nodes[dst_index]
        if src.id not in node_by_id or dst.id not in node_by_id:
            continue
        ax.plot(
            [src.x, dst.x],
            [src.y, dst.y],
            color=EDGE_LINE_COLOR,
            linewidth=1,
            zorder=1,
        )

    seen_types = set()
    for node in node_by_id.values():
        type_name = NODE_TYPE_MAP.inverse.get(node.type, "Unknown")
        style = NODE_STYLE.get(type_name, DEFAULT_STYLE)
        seen_types.add(type_name)
        ax.scatter(
            node.x,
            node.y,
            marker=style["marker"],
            color=style["color"],
            s=style["size"],
            edgecolors="black",
            linewidths=0.5,
            zorder=2,
        )
        if node.rotation_allowed:
            ax.scatter(
                node.x,
                node.y,
                marker="o",
                facecolors="none",
                edgecolors="black",
                linewidths=1,
                s=style["size"] * 2.2,
                zorder=1.5,
            )
        if label_nodes:
            ax.annotate(
                str(node.id),
                (node.x, node.y),
                textcoords="offset points",
                xytext=(9, 0),
                ha="left",
                va="center",
                fontsize=7,
                zorder=3,
            )

    legend_handles = [
        Line2D(
            [0],
            [0],
            marker=NODE_STYLE.get(type_name, DEFAULT_STYLE)["marker"],
            color="w",
            markerfacecolor=NODE_STYLE.get(type_name, DEFAULT_STYLE)["color"],
            markeredgecolor="black",
            markersize=10,
            label=type_name,
        )
        for type_name in sorted(seen_types)
    ]
    if any(node.rotation_allowed for node in node_by_id.values()):
        legend_handles.append(
            Line2D(
                [0],
                [0],
                marker="o",
                color="w",
                markerfacecolor="none",
                markeredgecolor="black",
                markersize=12,
                label="Rotation allowed",
            )
        )
    ax.legend(handles=legend_handles, loc="upper right", fontsize=8)
    ax.set_aspect("equal", adjustable="datalim")
    ax.set_xlabel("X (m)")
    ax.set_ylabel("Y (m)")


def plot_nodes(layout, title, label_nodes=True, show_grid=False):
    floors = sorted({node.floor for node in layout.nodes})
    fig, axes = plt.subplots(
        1, len(floors), figsize=(9 * len(floors), 9), squeeze=False
    )
    axes = axes[0]

    for ax, floor in zip(axes, floors):
        node_ids = [node.id for node in layout.nodes if node.floor == floor]
        plot_grid(ax, layout, node_ids, label_nodes=label_nodes, show_grid=show_grid)
        ax_title = title
        if len(floors) > 1:
            ax_title += f" - floor {floor}"
        ax.set_title(ax_title)

    fig.tight_layout()
    return fig


@click.command()
@click.argument("layout_name", type=click.STRING)
@click.option(
    "-o",
    "--output",
    default=None,
    help="Output image path (default: <layout_name>.png)",
)
@click.option(
    "--show",
    is_flag=True,
    help="Open an interactive window in addition to saving the image",
)
@click.option("--no-labels", is_flag=True, help="Don't label nodes with their ID")
@click.option("--grid", "show_grid", is_flag=True, help="Show faint XY grid lines")
def render_layout(layout_name, output, show, no_labels, show_grid):
    """
    Renders a layout yaml file to an image. The LAYOUT_NAME can be specified by a name
    (e.g. 5675_pecos_combined) or by a full path to the layout yaml file
    (e.g. src/config/site_config/layouts/5675_pecos_combined.yaml).
    """

    layout = common_py.layout.load_layout(layout_name)
    layout_path = Path(layout_name)
    fig = plot_nodes(
        layout, title=layout_path.stem, label_nodes=not no_labels, show_grid=show_grid
    )

    if output is None:
        output = layout_path.with_suffix(".png")
    fig.savefig(output, dpi=150)
    print(f"Wrote file {output}")

    if show:
        plt.show()


def main():
    try:
        render_layout()
    except Exception as e:
        print("Failed to generate the layout image:", e)
        sys.exit(127)


if __name__ == "__main__":
    main()
