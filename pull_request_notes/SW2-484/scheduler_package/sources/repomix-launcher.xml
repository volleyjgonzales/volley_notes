#!/usr/bin/env python3
# pylint: disable=E1120, R0913

"""Helpful utility for generating layouts"""

from pathlib import Path
import click
import yaml
from common_py.layout_generation import generate_stacked_corridors

from interfaces.msg import ParkingWindow


@click.command()
@click.argument("layout_filename", required=1)
@click.argument("corridor_length", type=int, required=1)
@click.argument("corridor_depth", type=int, required=1)
@click.option("--num_bays", type=int, default=1)
@click.option("--parking_window_width", default=2.2)
@click.option("--parking_window_length", default=5.2)
@click.option("--parking_perimeter_buffer", default=0.25)
def generate_corridor_layout(
    layout_filename,
    corridor_length,
    corridor_depth,
    num_bays,
    parking_window_width,
    parking_window_length,
    parking_perimeter_buffer,
):
    pw = ParkingWindow()
    pw.width_m = parking_window_width
    pw.length_m = parking_window_length
    pw.name = "STANDARD"
    buffer = ParkingWindow()
    buffer.length_m = parking_perimeter_buffer
    buffer.width_m = parking_perimeter_buffer
    layout = generate_stacked_corridors(
        num_bays, corridor_length, corridor_depth, pw, ParkingWindow(), buffer
    )
    layout.name = Path(layout_filename).stem
    yml = layout.as_yaml()
    with open(layout_filename, "w") as f:
        f.write(
            "# ------------------------------------------\n"
            "# | Auto-generated using generate_layout.py | \n"
            "# ------------------------------------------\n"
        )
        yaml.dump(yml, f)
        f.close()


if __name__ == "__main__":
    generate_corridor_layout()
</file>

