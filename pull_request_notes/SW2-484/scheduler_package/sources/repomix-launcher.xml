import os

from launch_ros.actions import Node
from launch_ros.descriptions import ComposableNode

PROXY_NAME = "hito_proxy"


def _get_hito_proxy_env_as_params():
    """Map connection environment variables to hito_proxy ROS params, skipping unset ones."""
    env_to_param = {
        "MQTT_BROKER_HOST": ("mqtt_broker_host", str),
        "MQTT_BROKER_PORT": ("mqtt_broker_port", int),
        "MAP_SERVER_HOST": ("map_server_host", str),
        "MAP_SERVER_PORT": ("map_server_port", int),
    }
    connection_params = {}
    for env_var, (param_name, param_type) in env_to_param.items():
        value = os.environ.get(env_var)
        if value is not None:
            connection_params[param_name] = param_type(value)
    return connection_params


def get_standalone_nodes(params):
    launch_description_entities = [
        Node(
            package="central_api",
            executable="rest_api",
            parameters=[params, {"introspection_mode": "metadata"}],
            output="screen",
            emulate_tty=True,
            remappings=[
                ("/rosout", "/central/rosout"),
            ],
        )
    ]

    # Add the HITO AGV proxy node for non-simulation runs
    if not params.get("is_simulation"):
        launch_description_entities.append(
            Node(
                package="agvhito",
                executable="proxy_node",
                name=PROXY_NAME,
                parameters=[
                    params,
                    _get_hito_proxy_env_as_params(),
                ],
                remappings=[
                    ("/rosout", f"/{PROXY_NAME}/rosout"),
                ],
            )
        )

    return launch_description_entities


def get_composable_nodes(params):
    composable_nodes = [
        ComposableNode(
            package="central",
            plugin="central::AgvMonitorComponent",
            namespace="central",
            name="agv_monitor",
            parameters=[params],
            remappings=[
                ("/rosout", "/central/rosout"),
            ],
        ),
        ComposableNode(
            package="central",
            plugin="central::SafetyHardwareMonitorComponent",
            namespace="central",
            name="safety_hardware_monitor",
            parameters=[params],
            remappings=[
                ("/rosout", "/central/rosout"),
            ],
        ),
        ComposableNode(
            package="central",
            plugin="central::ConsistencyMonitorComponent",
            namespace="central",
            name="consistency_monitor",
            parameters=[params],
            remappings=[
                ("/rosout", "/central/rosout"),
            ],
        ),
        ComposableNode(
            package="central",
            plugin="central::DispatchComponent",
            namespace="central",
            name="dispatcher",
            parameters=[params],
            remappings=[
                ("/rosout", "/central/rosout"),
            ],
        ),
        ComposableNode(
            package="central",
            plugin="central::GarageTrackerComponent",
            namespace="central",
            name="garage_tracker",
            parameters=[params],
            remappings=[
                ("/rosout", "/central/rosout"),
            ],
        ),
        ComposableNode(
            package="central",
            plugin="central::GarageMonitorComponent",
            namespace="central",
            name="garage_monitor",
            parameters=[params],
            remappings=[
                ("/rosout", "/central/rosout"),
            ],
        ),
        ComposableNode(
            package="scheduler",
            plugin="volley::SchedulerComponent",
            namespace="scheduler",
            name="scheduler",
            parameters=[params],
            remappings=[
                ("/rosout", "/central/rosout"),
            ],
        ),
    ]

    return composable_nodes
