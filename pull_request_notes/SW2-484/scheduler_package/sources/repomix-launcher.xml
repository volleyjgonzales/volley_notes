# The launch file that launches a simulation

# pylint: disable=too-many-branches, too-many-statements, too-many-locals
# pylint: disable=too-many-public-methods, too-few-public-methods, too-many-lines, too-many-instance-attributes

import common_py.layout
import common_py.pose_graph
import common_py.processing.grid_generation as grid_generation
import common_py.scenario
import os
import re
import tempfile
from datetime import datetime, timezone
from common_py.general_utils import merge_params_dict
from ament_index_python.packages import get_package_share_directory
from launch.actions import (
    GroupAction,
    IncludeLaunchDescription,
    RegisterEventHandler,
    Shutdown,
)
from launch.event_handlers import OnProcessExit
from launch.launch_description_sources import AnyLaunchDescriptionSource
from launch_ros.actions import (
    ComposableNodeContainer,
    Node,
    PushRosNamespace,
    SetParameter,
    SetRemap,
)
from launch_ros.descriptions import ComposableNode
from launch_ros.substitutions import FindPackageShare

from launcher import bay_nodes
from launcher import vecs_nodes
from launcher import vrc_nodes
from launcher import central_nodes
from launcher import paths
from launcher import utils
import copy


def write_grid_to_file(layout, layout_md5sum):
    """
    Generate a temporary grid XML file, of the sort consumed by the NOC.
    The grid file is written to a temp file, and the name of which is returned.
    """

    grid = grid_generation.generate_grid_for_layout(layout, layout_md5sum)

    # Write out the config XML to a file in our temp directory.
    filepath = os.path.join(tempfile.gettempdir(), "grid.xml")
    grid_generation.write_xml_element_to_utf8(grid, filepath)

    return filepath


def load_params_and_initial_conditions(scenario_filepath):
    """
    Construct our ROS parameters dictionary, which maps node names to node parameter dictionaries.
    We first load the default parameters file, launcher/params/params.yaml.
    We then load our scenario file, which contains the layout and may contain parameter overrides.
    """

    # Make sure that any simulated environment has the GITSHA variable set for
    # the consistency monitor
    os.environ.setdefault("GITSHA", "unknown")

    # Choose a fixed default domain ID if unset.
    if "ROS_DOMAIN_ID" not in os.environ:
        os.environ["ROS_DOMAIN_ID"] = "75"

    # Load the scenario and parameters
    scenario = common_py.scenario.load_scenario(scenario_filepath)
    params, _ = utils.load_params(
        "sim", layout=scenario["layout"], installation_id=9998, use_sim_time=True
    )

    initial_conditions = common_py.scenario.load_initial_conditions(scenario)

    # A scenario may carry its own node param overrides, which win over the param files
    params = merge_params_dict(params, scenario.get("params", {}))

    return params, initial_conditions


def get_sim_clock_node(params, real_time_factor=1.0, clock_publish_period_ms=5.0):
    """Launch the SimClock node: the single /clock publisher for the simulation.

    Standalone process (not in shared "sim" container) to minimize lost-wakeup stalls

    use_sim_time is forced False here regardless of the shared params dict -- the clock source
    must run on wall time, since it *produces* simulated time for every other node. Drive the
    sim faster than real time by raising real_time_factor (1.0 = real time, 10.0 = 10x, 0 = paused).
    """
    return Node(
        package="sim",
        executable="sim_clock_node",
        namespace="sim",
        name="clock",
        parameters=[
            params,
            {
                "use_sim_time": False,
                "real_time_factor": real_time_factor,
                "clock_publish_period_ms": clock_publish_period_ms,
            },
        ],
        output="screen",
        emulate_tty=True,
        remappings=[
            ("/rosout", "/sim/rosout"),
        ],
    )


# pylint: disable=too-many-arguments
# pylint: disable=too-many-locals
def get_sim_launch_description_entities(
    params,
    initial_conditions,
    scenario_filepath,
    record_artifacts=True,
    artifacts_output_dir=None,
    artifact_basename=None,
    run_visualization=True,
    run_rviz=True,
    use_remote_meshes=False,
    remote_mesh_prefix=None,
    real_time_factor=1.0,
):
    launch_description_entities = []
    composable_nodes = []

    # SimClock publishes /clock (optionally faster than real time). It runs as its own
    # process, since all other sim nodes depend on it
    sim_clock_node = get_sim_clock_node(params, real_time_factor=real_time_factor)
    launch_description_entities.append(sim_clock_node)

    # Trigger launch shutdown on an unexpected exit, but not during a clean teardown.
    launch_description_entities.append(
        RegisterEventHandler(
            OnProcessExit(
                target_action=sim_clock_node,
                on_exit=lambda event, context: (
                    None
                    if context.is_shutdown
                    else [
                        Shutdown(reason=f"SimClock exited with code {event.returncode}")
                    ]
                ),
            )
        )
    )

    agvs = copy.deepcopy(initial_conditions["agvs"])

    # Launch the agvs
    for agv in agvs:
        agv_id = agv["id"]
        composable_nodes.append(
            ComposableNode(
                package="agvhito",
                plugin="volley::agvhito::sim::SimAgvComponent",
                name="sim",
                namespace=f"agv/a{agv_id}",
                parameters=[
                    params,
                    {
                        "agv_id": agv_id,
                        "initial_node_id": agv["garage_pose"]["node_id"],
                        "initial_heading": agv["garage_pose"]["heading"],
                        "initial_lifted": agv.get("lift_fraction", 0.0) == 1.0,
                    },
                ],
                remappings=[
                    ("/rosout", f"/agv/a{agv_id}" + "/rosout"),
                ],
            )
        )

    # Simulator owns the global concerns (collisions, patrons, scenario events)
    composable_nodes.append(
        ComposableNode(
            package="sim",
            plugin="volley::sim::SimulatorComponent",
            namespace="sim",
            name="sim_world",
            parameters=[params, {"simulator.scenario": scenario_filepath}],
            remappings=[
                ("/rosout", "/sim/rosout"),
            ],
        )
    )

    # Launch the bays
    for bay_id, core_nodes in bay_nodes.get_core_composable_nodes(params).items():
        core_nodes = core_nodes + [
            ComposableNode(
                package="sim",
                plugin="volley::sim::BaySimComponent",
                name="bay_sim",
                namespace=f"/bay/b{bay_id}",
                parameters=[params, {"bay_id": bay_id}],
                remappings=[
                    ("/rosout", "/sim/rosout"),
                ],
            )
        ]

        launch_description_entities.append(
            ComposableNodeContainer(
                name="b" + str(bay_id) + "_nodes",
                package="rclcpp_components",
                executable="component_container",
                arguments=["--executor-type", "multi-threaded"],
                exec_name="sim-b" + str(bay_id),
                namespace="sim",
                composable_node_descriptions=core_nodes,
                output="screen",
                emulate_tty=True,
                remappings=[
                    ("/rosout", "/sim/rosout"),
                ],
            )
        )

    # Launch the vexen
    for vecs_id, vecs_core_nodes in vecs_nodes.get_vecs_sim_nodes(params).items():
        for node in vecs_core_nodes:
            print(f"adding vecs node: v{vecs_id}")
            launch_description_entities.append(node)

    # Launch the VRCs
    for vrc_sim_nodes in vrc_nodes.get_vrc_sim_nodes(
        params, initial_conditions
    ).values():
        for node in vrc_sim_nodes:
            launch_description_entities.append(node)

    if run_visualization:
        vis_params = {"use_remote_meshes": use_remote_meshes}
        # Only pass the prefix through when it was given, so the node falls back to its own default.
        if remote_mesh_prefix:
            vis_params["remote_mesh_prefix"] = remote_mesh_prefix

        visualizer_node = Node(
            package="vis",
            namespace="vis",
            executable="visualizer_node",
            name="visualizer",
            parameters=[params, vis_params],
            output="screen",
            emulate_tty=True,
            remappings=[
                ("/rosout", "/sim/rosout"),
            ],
        )
        launch_description_entities.append(visualizer_node)

        foxglove_launch_file = os.path.join(
            get_package_share_directory("foxglove_bridge"),
            "launch",
            "foxglove_bridge_launch.xml",
        )
        launch_description_entities.append(
            IncludeLaunchDescription(
                AnyLaunchDescriptionSource(foxglove_launch_file),
            )
        )

        if run_rviz:
            launch_description_entities.append(
                Node(package="rviz2", executable="rviz2")
            )

    # Launch the central nodes
    launch_description_entities.append(
        ComposableNodeContainer(
            name="central_sim_nodes",
            package="rclcpp_components",
            executable="component_container",
            arguments=["--executor-type", "multi-threaded"],
            exec_name="sim-central",
            namespace="sim",
            composable_node_descriptions=central_nodes.get_composable_nodes(params),
            output="screen",
            emulate_tty=True,
            remappings=[
                ("/rosout", "/sim/rosout"),
            ],
        )
    )
    launch_description_entities.extend(central_nodes.get_standalone_nodes(params))

    if record_artifacts:
        launch_description_entities.append(
            GroupAction(
                [
                    PushRosNamespace("sim"),
                    SetRemap("/rosout", "/sim/rosout"),
                    SetParameter(name="use_sim_time", value=True),
                    IncludeLaunchDescription(
                        FindPackageShare("launcher") / "launch" / "recorder.launch.xml",
                        launch_arguments={
                            "output_dir": artifacts_output_dir,
                            "basename": artifact_basename or "sim",
                            "regex": ".*",
                            "split_duration_sec": "0",
                        }.items(),
                    ),
                ]
            )
        )

    # Start all the composable nodes
    sim_node = ComposableNodeContainer(
        name="sim_nodes",
        package="rclcpp_components",
        executable="component_container",
        arguments=["--executor-type", "multi-threaded"],
        exec_name="sim",
        namespace="sim",
        composable_node_descriptions=composable_nodes,
        output="screen",
        emulate_tty=True,
        remappings=[
            ("/rosout", "/sim/rosout"),
        ],
    )
    launch_description_entities.append(sim_node)

    # Trigger launch shutdown on an unexpected exit, but not during a clean teardown.
    launch_description_entities.append(
        RegisterEventHandler(
            OnProcessExit(
                target_action=sim_node,
                on_exit=lambda event, context: (
                    None
                    if context.is_shutdown
                    else [
                        Shutdown(
                            reason=f"Simulator exited with code {event.returncode}"
                        )
                    ]
                ),
            )
        )
    )

    return launch_description_entities


RE_PARAM_VIS = re.compile(r"vis:=(\S+)")
RE_PARAM_RVIZ = re.compile(r"rviz:=(\S+)")
RE_PARAM_SCENARIO = re.compile(r"scenario:=(\S+)")
RE_PARAM_RECORD_ARTIFACTS = re.compile(r"record_artifacts:=(\S+)")
RE_PARAM_ENABLE_DISPATCH_CHARGING_MODE = re.compile(
    r"enable_dispatch_charging_mode:=(\S+)"
)
RE_PARAM_PRINTDAGS = re.compile(r"printdags:=(\S+)")
RE_PARAM_ARTIFACTS_OUTPUT_DIR = re.compile(r"artifacts_output_dir:=(\S+)")
RE_PARAM_ARTIFACT_BASENAME = re.compile(r"artifact_basename:=(\S+)")
RE_PARAM_USE_REMOTE_MESHES = re.compile(r"use_remote_meshes:=(\S+)")
# Base URL the visualizer prepends to mesh filenames when use_remote_meshes is on. Unset means the
# visualizer's built-in default.
RE_PARAM_REMOTE_MESH_PREFIX = re.compile(r"remote_mesh_prefix:=(\S+)")
# Simulated-time / wall-time ratio for the clock-driven sim (1 = real time, >1 = faster)
RE_PARAM_REAL_TIME_FACTOR = re.compile(r"real_time_factor:=(\S+)")
# Whether the simulated bay node will automatically confirm payload inserts
RE_PARAM_AUTO_CONFIRM_INSERT = re.compile(r"auto_confirm_insert:=(\S+)")
# GarageDirtiness() threshold above which an idle garage queues a CleanGarageJob
RE_PARAM_GARAGE_DIRTINESS_THRESHOLD_RATIO = re.compile(
    r"garage_dirtiness_threshold_ratio:=(\S+)"
)


# pylint: disable=too-many-arguments,too-many-branches
def get_sim_launch_description(
    args,
    vis_default,
    scenario=None,
    artifacts_output_dir=None,
    artifact_basename=None,
    param_overrides=None,
    real_time_factor=1.0,
):
    # Extract arguments
    run_visualization = vis_default
    run_rviz = True
    record_artifacts = False
    use_remote_meshes = False
    remote_mesh_prefix = None
    enable_dispatch_charging_mode = True
    printdags = False
    # None means "not passed on the command line", so params.yaml keeps its default
    auto_confirm_insert = None
    garage_dirtiness_threshold_ratio = None

    for arg in args[2:]:
        m = RE_PARAM_VIS.match(arg)
        if m:
            run_visualization = utils.string_to_bool(m[1])
            continue
        m = RE_PARAM_RVIZ.match(arg)
        if m:
            run_rviz = utils.string_to_bool(m[1])
            continue
        m = RE_PARAM_SCENARIO.match(arg)
        if m:
            scenario = m[1]
            continue
        m = RE_PARAM_RECORD_ARTIFACTS.match(arg)
        if m:
            record_artifacts = utils.string_to_bool(m[1])
            continue
        m = RE_PARAM_ENABLE_DISPATCH_CHARGING_MODE.match(arg)
        if m:
            enable_dispatch_charging_mode = utils.string_to_bool(m[1])
            continue
        m = RE_PARAM_PRINTDAGS.match(arg)
        if m:
            printdags = utils.string_to_bool(m[1])
            continue
        if m := RE_PARAM_ARTIFACTS_OUTPUT_DIR.match(arg):
            artifacts_output_dir = m[1]
            continue
        if m := RE_PARAM_ARTIFACT_BASENAME.match(arg):
            artifact_basename = m[1]
            continue
        if m := RE_PARAM_USE_REMOTE_MESHES.match(arg):
            use_remote_meshes = utils.string_to_bool(m[1])
            continue
        if m := RE_PARAM_REMOTE_MESH_PREFIX.match(arg):
            remote_mesh_prefix = m[1]
            continue
        if m := RE_PARAM_REAL_TIME_FACTOR.match(arg):
            real_time_factor = float(m[1])
            continue
        if m := RE_PARAM_AUTO_CONFIRM_INSERT.match(arg):
            auto_confirm_insert = utils.string_to_bool(m[1])
            continue
        if m := RE_PARAM_GARAGE_DIRTINESS_THRESHOLD_RATIO.match(arg):
            garage_dirtiness_threshold_ratio = float(m[1])
            continue

    if not artifacts_output_dir:
        # Filesystem safe ISO 8601 timestamp (excluding milliseconds)
        timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        artifacts_output_dir = os.path.join(paths.get_artifacts_dir(), timestamp)

    print(
        f"Parsed arguments: run_visualization={run_visualization}, scenario={scenario}, "
        f"record_artifacts={record_artifacts}, real_time_factor={real_time_factor}, "
        f"auto_confirm_insert={'default' if auto_confirm_insert is None else auto_confirm_insert}"
    )

    if os.path.isfile(scenario):
        scenario_file = scenario
    else:
        scenario_file = os.path.join(
            get_package_share_directory("scenario"), "scenarios", scenario
        )

    params, initial_conditions = load_params_and_initial_conditions(scenario_file)

    # This is simulation.
    params["is_simulation"] = True

    # Override any needed parameters
    if param_overrides is not None:
        params = merge_params_dict(params, param_overrides)

    if auto_confirm_insert is not None:
        params["simulator"]["auto_confirm_insert"] = auto_confirm_insert

    if enable_dispatch_charging_mode is False:
        params["enable_dispatch_charging_mode"] = enable_dispatch_charging_mode

    if garage_dirtiness_threshold_ratio is not None:
        params["dispatch"][
            "garage_dirtiness_threshold_ratio"
        ] = garage_dirtiness_threshold_ratio

    params["printdags"] = printdags

    scenario_name = os.path.basename(scenario_file)

    scenario = common_py.scenario.load_scenario(scenario_file)
    scenario_events = scenario["events"]

    # Load the layout file
    layout = common_py.layout.load_layout(scenario["layout"])

    launch_description_entities = get_sim_launch_description_entities(
        params,
        initial_conditions,
        scenario_file,
        record_artifacts=record_artifacts,
        artifacts_output_dir=artifacts_output_dir,
        artifact_basename=artifact_basename,
        run_visualization=run_visualization,
        run_rviz=run_rviz,
        use_remote_meshes=use_remote_meshes,
        remote_mesh_prefix=remote_mesh_prefix,
        real_time_factor=real_time_factor,
    )

    return (
        launch_description_entities,
        initial_conditions,
        layout,
        scenario_events,
        scenario_name,
    )
