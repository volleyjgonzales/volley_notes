<?xml version="1.0"?>
<!--
  Standalone recorder that writes a selected set of topics, services and actions to mcap artifact(s).
-->

<launch>
  <!-- Required launch arguments -->
  <arg name="basename"
       description="Directory created under output_dir as well as the prefix for recorded mcap files"/>

  <arg name="output_dir"
       description="Parent directory the basename is created in"/>

  <!-- Defaulted launch arguments -->
  <!-- The custom_data param reject an empty array, so default to a single placeholder entry -->
  <arg name="custom_data"
       default="[unset=]"
       description="Artifact metadata as a YAML list of key=value strings"/>

  <arg name="exclude_regex"
       default=""
       description="Drops topics matched by this regex"/>

  <arg name="node_name"
       default="recorder"
       description="Node name, must be unique within the namespace"/>

  <arg name="regex"
       default=".*"
       description="Topic selection, matched against fully qualified topic names"/>

  <arg name="split_duration_sec"
       default="600"
       description="Split the bag after this many seconds, 0 to disable"/>

  <arg name="split_size_bytes"
       default="0"
       description="Split the bag after this many bytes, 0 to disable"/>


  <node pkg="rosbag2_transport" exec="recorder" name="$(var node_name)" output="screen" emulate_tty="true">
    <!-- Remap recorder event topics to the nodes "private" namespace -->
    <remap from="events/rosbag2_messages_lost" to="~/events/rosbag2_messages_lost"/>
    <remap from="events/write_split" to="~/events/write_split"/>

    <param name="storage.custom_data" type="yaml" value="$(var custom_data)"/>
    <param name="storage.max_bagfile_duration" type="int" value="$(var split_duration_sec)"/>
    <param name="storage.max_bagfile_size" type="int" value="$(var split_size_bytes)"/>
    <param name="storage.storage_id" type="str" value="mcap"/>
    <param name="storage.storage_preset_profile" type="str" value="zstd_fast"/>
    <param name="storage.uri" type="str" value="$(var output_dir)/$(var basename)"/>

    <param name="record.exclude_regex" type="str" value="$(var exclude_regex)"/>
    <param name="record.regex" type="str" value="$(var regex)"/>

    <!-- The regex and exclude_regex are used for topic matching, disable all record options -->
    <param name="record.all_actions" type="bool" value="false"/>
    <param name="record.all_services" type="bool" value="false"/>
    <param name="record.all_topics" type="bool" value="false"/>

    <!-- Runtime recording does not have TTY, so disable keyboard controls -->
    <param name="record.disable_keyboard_controls" type="bool" value="true"/>

    <!-- Ensure topics that appear after this node launches are captured -->
    <param name="record.is_discovery_disabled" type="bool" value="false"/>
  </node>
</launch>
