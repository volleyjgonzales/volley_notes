from launch_ros.actions import Node
from launch_ros.descriptions import ComposableNode
from common_py.layout import load_layout


def get_vecs_sim_nodes(params):
    """Returns a map of all core VECS nodes by vecs_id.
    Primary purpose for sim launcher"""
    vecs_id_to_core_nodes = dict()
    layout = load_layout(params["vecs"]["layout"])

    for vecs_id in layout.get_ev_charge_ids():
        print(f"vecs_id: v{str(vecs_id)}")
        vecs_id_to_core_nodes[vecs_id] = make_core_nodes(vecs_id, params)
        vecs_id_to_core_nodes[vecs_id].append(
            Node(
                package="vecs",
                namespace="vecs/v" + str(vecs_id),
                executable="vecs_sim_node",
                name="vecs_sim_node",
                parameters=[params, {"vecs_id": vecs_id}],
                output="screen",
                emulate_tty=True,
                remappings=[
                    ("/rosout", "/vecs/v" + str(vecs_id) + "/rosout"),
                ],
            )
        )

    return vecs_id_to_core_nodes


def make_core_nodes(vecs_id, params):
    vecs_name = "v" + str(vecs_id)
    core_nodes = [
        Node(
            package="vecs",
            namespace="vecs/" + vecs_name,
            executable="vecs_node",
            name="vecs_node",
            parameters=[params, {"vecs_id": vecs_id}],
            output="screen",
            emulate_tty=True,
            remappings=[
                ("/rosout", "/vecs/" + vecs_name + "/rosout"),
            ],
        )
    ]
    return core_nodes


def get_composable_hardware_driver_nodes(params):
    """Returns a map of all hardware driver VECS nodes by vecs_id.
    Primary purpose for sim launcher"""
    vecs_id_to_composable_driver_nodes = dict()
    layout = load_layout(params["vecs"]["layout"])

    for vecs_id in layout.get_ev_charge_ids():
        vecs_id_to_composable_driver_nodes[vecs_id] = make_composable_driver_nodes(
            vecs_id, params
        )

    return vecs_id_to_composable_driver_nodes


def make_composable_driver_nodes(vecs_id, params):
    vecs_name = "v" + str(vecs_id)
    driver_nodes = [
        ComposableNode(
            package="vecs",
            namespace="vecs/" + vecs_name,
            plugin="vecs::io::VecsIoComponent",
            name="vecs_io_node",
            parameters=[params, {"vecs_id": vecs_id}],
            remappings=[
                ("/rosout", "/vecs/" + vecs_name + "/rosout"),
            ],
        ),
        ComposableNode(
            package="vecs",
            namespace="vecs/" + vecs_name,
            plugin="vecs::evse::VecsEvseComponent",
            name="vecs_evse_node",
            parameters=[params, {"vecs_id": vecs_id}],
            remappings=[
                ("/rosout", "/vecs/" + vecs_name + "/rosout"),
            ],
        ),
    ]
    return driver_nodes
