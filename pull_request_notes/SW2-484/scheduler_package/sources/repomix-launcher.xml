import os
from glob import glob
from setuptools import setup

package_name = "launcher"

setup(
    name=package_name,
    version="0.0.1",
    packages=[package_name],
    data_files=[
        # Install marker file in the package index
        ("share/ament_index/resource_index/packages", ["resource/" + package_name]),
        # Include our package.xml file
        ("share/" + package_name, ["package.xml"]),
        # Install all launch files.
        # ROS recommended Python glob pattern to match .py, .xml and .yaml launch files
        (
            os.path.join("share", package_name, "launch"),
            glob(os.path.join("launch", "**", "*launch.[pxy][yma]*"), recursive=True),
        ),
        # Install all param files.
        (
            os.path.join("share", package_name, "params"),
            glob(os.path.join("params/**/*.yaml"), recursive=True),
        ),
    ],
    install_requires=["setuptools"],
    zip_safe=True,
    maintainer="dev",
    maintainer_email="sw@volleyautomation.com",
    description="Launch files and associated material",
    license="proprietary",
    extras_require={
        "test": [
            "pytest",
        ],
    },
    entry_points={
        "console_scripts": [
            "layout_plotter = launcher.layout_plotter:main",
        ],
    },
)
