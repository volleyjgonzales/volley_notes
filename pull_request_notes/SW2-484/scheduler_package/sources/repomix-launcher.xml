import unittest
from unittest import mock
import os

from launcher import utils
import launch.substitutions


class TestParamLoadAndMerge(unittest.TestCase):
    """Testing loading and merging parameters"""

    def test_load_param_file(self):
        """Test loading a param file"""

        # Confirm we can load the default params file
        params = utils.load_param_file("params.yaml")

        # Sanity-check a few values
        self.assertEqual(params["bay"]["io_link"]["master1"]["devices_in_ports"][0], 0)

        # Loading a non-existent file should raise an exception
        self.assertRaises(FileNotFoundError, utils.load_param_file, "_params_.yaml")

    def test_load_params(self):
        params, device_id = utils.load_params(
            "agv", layout="415_east_grand_ave", installation_id=1234
        )

        # Sanity-check a few values.
        # Layout, installation_id, and use_sim_time are set in all param dictionaries
        for _, value in params.items():
            if isinstance(value, dict):
                self.assertEqual(value["layout"], "415_east_grand_ave")
                self.assertEqual(value["installation_id"], 1234)
                self.assertFalse(value["use_sim_time"])
        self.assertEqual(params["layout"], "415_east_grand_ave")
        self.assertEqual(params["installation_id"], 1234)
        self.assertFalse(params["use_sim_time"])
        # Device_id is zero because we didn't set the env var
        self.assertEqual(device_id, 0)

        # Bay device params are overridden by the layout-specific params
        # (params_415_east_grand_ave.yaml)
        self.assertEqual(params["bay"]["io_link"]["master1"]["devices_in_ports"][0], 31)

        # Confirm that a different layout has different values
        params, device_id = utils.load_params(
            "central", layout="1355_fulton", installation_id=4321, use_sim_time=True
        )
        self.assertEqual(params["garage_monitor"]["layout"], "1355_fulton")
        self.assertEqual(params["garage_monitor"]["installation_id"], 4321)
        self.assertTrue(params["garage_monitor"]["use_sim_time"])
        self.assertEqual(device_id, 0)

        # Params overridden by the layout-specific params (params_1355_fulton.yaml)
        self.assertEqual(params["bay"]["io_link"]["master1"]["devices_in_ports"][0], 11)

        # We can load nonsensical layouts as long as they are directly specified
        params, device_id = utils.load_params(
            "central", layout="abcdefghigk", installation_id=42
        )
        self.assertEqual(params["garage_monitor"]["layout"], "abcdefghigk")
        self.assertEqual(params["garage_monitor"]["installation_id"], 42)
        self.assertEqual(device_id, 0)

        # No params overridden by the layout-specific params
        self.assertEqual(params["bay"]["io_link"]["master1"]["devices_in_ports"][0], 0)

    # An AGV-specific params_a<N>.yaml override file is optional. When none exists, loading
    # must still succeed and leave the layout/device-type layers in place.
    @mock.patch.dict(
        os.environ,
        {"LAYOUT": "415_east_grand_ave", "INSTALLATION_ID": "2222", "DEVICE_ID": "9"},
    )
    def test_load_params_agv_specific_missing_ok(self):
        params, device_id = utils.load_params("agv")
        self.assertEqual(device_id, 9)
        self.assertEqual(params["agv"]["layout"], "415_east_grand_ave")
        # Still overridden by the layout file (params_415_east_grand_ave.yaml)
        self.assertEqual(params["bay"]["io_link"]["master1"]["devices_in_ports"][0], 31)

    @mock.patch.dict(
        os.environ,
        {"LAYOUT": "415_east_grand_ave", "INSTALLATION_ID": "2222", "DEVICE_ID": "42"},
    )
    def test_load_params_env_vars(self):
        params, device_id = utils.load_params("bay", use_sim_time=True)
        self.assertEqual(params["bay"]["layout"], "415_east_grand_ave")
        self.assertEqual(params["bay"]["installation_id"], 2222)
        self.assertTrue(params["bay"]["use_sim_time"])
        self.assertEqual(device_id, 42)

    # In this test we load a valid layout, but one that doesn't have a parameter override.
    # Because we are loading parameters using env variables the system assumes we are
    # running in production mode and will not start with the missing file.
    @mock.patch.dict(
        os.environ,
        {"LAYOUT": "tiny_log", "INSTALLATION_ID": "2", "DEVICE_ID": "88"},
    )
    def test_load_params_env_vars_bad_layout(self):
        self.assertRaises(FileNotFoundError, utils.load_params, "bay")

    @mock.patch.dict(
        os.environ,
        {"LAYOUT": "415_east_grand_ave", "INSTALLATION_ID": "2"},
    )
    def test_load_params_missing_device_id_ok(self):
        params, device_id = utils.load_params("bay")
        self.assertEqual(params["bay"]["layout"], "415_east_grand_ave")
        self.assertEqual(params["bay"]["installation_id"], 2)
        self.assertEqual(device_id, 0)

    @mock.patch.dict(
        os.environ,
        {"LAYOUT": "415_east_grand_ave"},
    )
    def test_load_params_installation_id_required(self):
        os.environ.pop("INSTALLATION_ID", None)
        self.assertRaises(
            launch.substitutions.substitution_failure.SubstitutionFailure,
            utils.load_params,
            "bay",
        )

    @mock.patch.dict(
        os.environ,
        {"INSTALLATION_ID": "2"},
    )
    def test_load_params_layout_required(self):
        os.environ.pop("LAYOUT", None)
        self.assertRaises(
            launch.substitutions.substitution_failure.SubstitutionFailure,
            utils.load_params,
            "bay",
        )
