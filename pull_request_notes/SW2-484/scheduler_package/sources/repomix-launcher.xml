from launch_ros.descriptions import ComposableNode
import common_py.layout
from interfaces.msg import GarageNode


def _find_vrc_id_for_bay(layout, bay_id):
    """Return the VRC id whose node list contains bay_id, or None."""
    for vrc in layout.vrcs:
        if bay_id in vrc.get("nodes", []):
            return vrc["id"]
    return None


def get_core_composable_nodes(params):
    # Get the core composable nodes
    bay_id_to_core_nodes = dict()
    layout = common_py.layout.load_layout(params["bay"]["layout"])
    for bay_id in layout.get_bay_ids():
        bay_node = layout.get_node(bay_id)
        # Use BliftStateMachineComponent when the bay needs multi-floor handling. Two
        # orthogonal triggers, both needed:
        #   - type == TYPE_BLIFT: the new "bay node IS the lift terminal" case (e.g.
        #     38 Gramercy node 26). The legacy system_floors clauses don't fire here
        #     because system_floors and insert_floor default to [node.floor].
        #   - len(system_floors) > 1, or system_floors[0] != insert_floor: pre-BLift
        #     case for regular type: Bay nodes whose system doors live on a different
        #     floor than the bay itself (Pecos-style "Bay above, separate Lift below").
        if (
            bay_node.type == GarageNode.TYPE_BLIFT
            or len(bay_node.system_floors) > 1
            or bay_node.system_floors[0] != bay_node.insert_floor
        ):
            state_machine_plugin = "bay::BliftStateMachineComponent"
        else:
            state_machine_plugin = "bay::StateMachineComponent"

        # For a TYPE_BLIFT the bay's "lift" is a VRC commanded by the scheduler as part of
        # AGV cross-floor plans, so the bay must NOT command the lift itself — it observes
        # the lift's reports and waits for the carriage to arrive. Legacy multi-floor
        # Bay+Lift installations keep driving the lift internally (false here).
        bay_state_machine_params = {
            "bay_id": bay_id,
            "bay.external_lift_driver": bay_node.type == GarageNode.TYPE_BLIFT,
        }

        core_nodes = [
            ComposableNode(
                package="bay",
                plugin=state_machine_plugin,
                name="bay_state_machine",
                namespace="/bay/b" + str(bay_id),
                parameters=[bay_state_machine_params, params],
                remappings=[
                    ("/rosout", "/bay/b" + str(bay_id) + "/rosout"),
                ],
            ),
            ComposableNode(
                package="bay",
                plugin="bay::VehicleEstimatorComponent",
                name="vehicle_estimator",
                namespace="/bay/b" + str(bay_id),
                parameters=[params],
                remappings=[
                    ("/rosout", "/bay/b" + str(bay_id) + "/rosout"),
                ],
            ),
            ComposableNode(
                package="bay",
                plugin="bay::BayGuidanceComponent",
                name="bay_guidance",
                namespace="/bay/b" + str(bay_id),
                parameters=[params],
                remappings=[
                    ("/rosout", "/bay/b" + str(bay_id) + "/rosout"),
                ],
            ),
        ]

        # BLift nodes are bays AND lifts. The bay state machine's LiftInterface
        # speaks LiftReport, but the actual hardware moving vehicles between
        # floors is a VRC that publishes VrcReport. Spawn a bridge per BLift
        # that maps /vrc/r{vrc_id}/report -> /lift/l{bay_id}/report.
        if bay_node.type == GarageNode.TYPE_BLIFT:
            vrc_id = _find_vrc_id_for_bay(layout, bay_id)
            if vrc_id is None:
                raise RuntimeError(
                    f"BLift bay {bay_id} has no matching VRC in layout.vrcs"
                )
            core_nodes.append(
                ComposableNode(
                    package="bay",
                    plugin="bay::VrcLiftBridgeComponent",
                    name="vrc_lift_bridge",
                    namespace="/bay/b" + str(bay_id),
                    parameters=[params],
                    remappings=[
                        ("/rosout", "rosout"),
                        ("lift/report", f"/lift/l{bay_id}/report"),
                        ("lift/move", f"/lift/l{bay_id}/move"),
                        ("vrc/report", f"/vrc/r{vrc_id}/report"),
                        ("vrc/move", f"/vrc/r{vrc_id}/move"),
                    ],
                )
            )
        bay_id_to_core_nodes[bay_id] = core_nodes

    return bay_id_to_core_nodes


def get_driver_composable_nodes(params):
    # Get the hardware driver composable nodes
    bay_id_to_driver_nodes = dict()
    layout = common_py.layout.load_layout(params["bay"]["layout"])
    for bay_id in layout.get_bay_ids():
        driver_nodes = [
            ComposableNode(
                package="bay",
                plugin="bay::PlcControlComponent",
                name="plc_control",
                namespace="/bay/b" + str(bay_id),
                parameters=[params, {"bay_id": bay_id}],
                remappings=[
                    ("/rosout", "/bay/b" + str(bay_id) + "/rosout"),
                ],
            ),
            ComposableNode(
                package="bay",
                plugin="bay::IoLinkDriverComponent",
                name="io_link_driver",
                namespace="/bay/b" + str(bay_id),
                parameters=[params],
                remappings=[
                    ("/rosout", "/bay/b" + str(bay_id) + "/rosout"),
                ],
            ),
            ComposableNode(
                package="bay",
                plugin="bay::LoadCellDriverComponent",
                name="load_cell_driver",
                namespace="/bay/b" + str(bay_id),
                parameters=[params],
                remappings=[
                    ("/rosout", "/bay/b" + str(bay_id) + "/rosout"),
                ],
            ),
        ]

        bay_id_to_driver_nodes[bay_id] = driver_nodes

    return bay_id_to_driver_nodes
