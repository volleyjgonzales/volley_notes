import os
import unittest
from unittest import mock

from launcher import paths

_ARTIFACTS_DIR = "/tmp/artifacts"
_ROS_HOME_DIR = "/tmp/ros_home"


class TestGetArtifactsDir(unittest.TestCase):
    def test_env_override(self):
        """ARTIFACTS_DIR is used as-is when set."""
        with mock.patch.dict(os.environ, {"ARTIFACTS_DIR": _ARTIFACTS_DIR}):
            self.assertEqual(paths.get_artifacts_dir(), _ARTIFACTS_DIR)

    def test_ros_home_default(self):
        """An empty ARTIFACTS_DIR falls back to artifacts/ under ROS_HOME."""
        with mock.patch.dict(
            os.environ, {"ARTIFACTS_DIR": "", "ROS_HOME": _ROS_HOME_DIR}
        ):
            self.assertEqual(
                paths.get_artifacts_dir(), os.path.join(_ROS_HOME_DIR, "artifacts")
            )


class TestGetRosHomeDir(unittest.TestCase):
    def test_env_override(self):
        """ROS_HOME is used as-is when set."""
        with mock.patch.dict(os.environ, {"ROS_HOME": _ROS_HOME_DIR}):
            self.assertEqual(paths.get_ros_home_dir(), _ROS_HOME_DIR)

    def test_home_default(self):
        """An empty ROS_HOME falls back to .ros under HOME."""
        home_dir = "/home/tester"
        with mock.patch.dict(os.environ, {"ROS_HOME": "", "HOME": home_dir}):
            self.assertEqual(paths.get_ros_home_dir(), os.path.join(home_dir, ".ros"))
