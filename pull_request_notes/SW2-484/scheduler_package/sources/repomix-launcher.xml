# The launch file run on the central garage server

from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription, LaunchDescriptionEntity
from launch.actions import DeclareLaunchArgument, GroupAction, IncludeLaunchDescription
from launch.launch_description_sources import AnyLaunchDescriptionSource
from launch.substitutions import LaunchConfiguration
from launch_ros.actions import ComposableNodeContainer, Node, PushRosNamespace, SetRemap
from launch_ros.substitutions import FindPackageShare

from launcher import central_nodes
from launcher import paths
from launcher import utils
import os


def _get_otel_env_params():
    host = os.environ.get("OTEL_ENDPOINT_HOST", "")
    port = os.environ.get("OTEL_ENDPOINT_PORT", "")
    return {"metrics": {"otel_endpoint": host + ":" + port if host else ""}}


def generate_launch_description() -> LaunchDescription:
    # Load params and launch the nodes
    # Uses a multithreaded ComposableNodeContainer because the dispatcher uses blocking
    # service calls.
    params, _ = utils.load_params("central")

    launch_description_entities: list[LaunchDescriptionEntity] = []

    launch_description_entities.extend(central_nodes.get_standalone_nodes(params))

    composable_nodes = central_nodes.get_composable_nodes(params)

    launch_description_entities.append(
        ComposableNodeContainer(
            name="central_nodes",
            package="rclcpp_components",
            executable="component_container",
            arguments=["--executor-type", "multi-threaded"],
            exec_name="central",
            namespace="central",
            composable_node_descriptions=composable_nodes,
            output="screen",
            emulate_tty=True,
            remappings=[
                ("/rosout", "/central/rosout"),
            ],
        )
    )

    launch_description_entities.append(
        Node(
            package="central",
            namespace="central",
            executable="metrics_recorder",
            name="metrics",
            parameters=[params, _get_otel_env_params()],
            output="screen",
            emulate_tty=True,
        )
    )

    # Vis node is needed for supporting Foxglove as the new NOC.
    visualizer_node = Node(
        package="vis",
        namespace="vis",
        executable="visualizer_node",
        name="visualizer",
        parameters=[params],
        output="screen",
        emulate_tty=True,
        remappings=[
            ("/rosout", "/vis/rosout"),
        ],
    )
    launch_description_entities.append(visualizer_node)

    # Foxglove bridge for supporting the NOC
    foxglove_launch_file = os.path.join(
        get_package_share_directory("foxglove_bridge"),
        "launch",
        "foxglove_bridge_launch.xml",
    )
    launch_description_entities.append(
        IncludeLaunchDescription(
            AnyLaunchDescriptionSource(foxglove_launch_file),
        )
    )

    artifacts_output_dir = LaunchConfiguration("artifacts_output_dir")

    declare_artifacts_output_dir = DeclareLaunchArgument(
        "artifacts_output_dir",
        default_value=paths.get_artifacts_dir(),
        description="Parent directory for recorded central artifacts",
    )

    recorder = GroupAction(
        [
            PushRosNamespace("central"),
            SetRemap("/rosout", "/central/rosout"),
            IncludeLaunchDescription(
                FindPackageShare("launcher") / "launch" / "recorder.launch.xml",
                launch_arguments=[
                    ("output_dir", artifacts_output_dir),
                    ("basename", "central"),
                    # Record everything except those that have specific recorders
                    ("regex", ".*"),
                    ("exclude_regex", "^/bay/"),
                ],
            ),
        ]
    )

    ld = LaunchDescription()

    # Add declared launch arguments before entities or other actions that depend on them
    ld.add_action(declare_artifacts_output_dir)

    for entity in launch_description_entities:
        ld.add_entity(entity)

    ld.add_action(recorder)

    return ld
