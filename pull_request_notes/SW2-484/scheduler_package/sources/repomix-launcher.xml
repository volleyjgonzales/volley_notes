<file path="params/params.yaml">
---
agv:
  # Firmware version specification used to ensure firmware compatibility.
  firmware_version_spec: ^2.0.0
  performance_limits:
    # General speed/accel limits
    restricted_node_speed_multiplier: 0.4 # Multiplier used when src or dst node is restricted (bay, charger, lift,)
    locomote:
      speed: 1.0 # m/s
      loaded_speed: 0.8 # m/s. Applied instead of speed when the vehicle is loaded
      accel: 0.2 # m/s^2
    strafe:
      speed: 0.6 # m/s
      loaded_speed: 0.32 # m/s. Applied instead of speed when the vehicle is loaded
      accel: 0.2 # m/s^2
    rotate:
      speed: 0.17 # rad/s
      loaded_speed: 0.136 # rad/s. Applied instead of speed when the vehicle is loaded
      accel: 0.035 # rad/s^2

  # AGV lift durations. Shared source of truth between the scheduler's cost model and the
  # AGV sim, so the time the planner budgets matches the time sim actually holds the lift.
  lift:
    up_time: 6.0 # [s] time for AGV to raise its lift
    down_time: 6.0 # [s] time for AGV to lower its lift
  # Duration to reorient AGV drive wheels when switching between LOCOMOTE / STRAFE / ROTATE.
  wheel_turn_time: 1.75 # [s]

agv_monitor:
  low_agv_battery_fraction_threshold: 0.1 # Disable AGVs with battery fractions below this value

bay:
  plc:
    ip: '192.168.1.33' # IP address of the PLC
    port: 502 # Port to talk to the PLC over
  load_cells:
    # A modbus-proxy is used to connect to the MCS-08EN load cell digitizer
    # Following values are set to the modbus-proxy and NOT the digitizer
    address: '192.168.1.50'
    port: 5020
    scale: 0.01 # Factor to multiply raw readings by to convert to kg. Ex: 0.01 for 10kN load cells. 0.001 for 5kN load cells.
  floor_spec: ''
  io_link:
    port: 502
    num_masters: 2
    master1:
      address: '192.168.1.60'
      # Array of IoLinkDevices plugged into specific ports in master. Set to EMPTY if a port is empty.
      # First entry is the device plugged into port X01, second is port X02, and so forth.
      devices_in_ports: [0, 0, 0, 0, 0, 0, 0, 0]
    master2:
      address: '192.168.1.62'
      devices_in_ports: [0, 0, 0, 0, 0, 0, 0, 0]

  estimator:
    process_noise:
      velocity: 0.1 # Process noise on vehicle velocity (x and y), std deviation [m/s^(3/2)]
    measurement_noise:
      load_cells: 10.0 #  Measurement noise for load cells, std deviation [kg]
    sensor_bounding_box: # Size of bounding box configured for bay in which cars are accepted [m]
      length_m: 4.5 # Old east grand ave sizes default required still for tests.
      width_m: 2.0
    height_lidar: # Mounting heights of the bay's height-check 2D lidars, above the tray [m]
      tall_m: 1.97
      mid_m: 1.82
      short_m: 1.67

  # Bay door event durations used by the scheduler when costing bay transitions.
  door:
    open_time: 4.0 # [s] time for bay door to open
    close_time: 4.0 # [s] time for bay door to close
    wait_to_open_time: 10.0 # [s] wait before opening the bay door

dispatch:
  garage_dirtiness_threshold_ratio: 0.10 # GarageDirtiness() threshold to queue a CleanGarageJob while idle

garage_monitor:
  status_period_ms: 10000

garage_tracker:
  write_to_mysql: true
  mysql:
    port: 3306 # Default port used by mysql
    host: 'mysql'
    user: 'scheduler'
    password: 'password'
    database: 'scheduler'

lift:
  type: 'autoquip'
  hostname: 192.168.1.10
  port: 502

scheduler:
  bay_readiness_ratio: 0.5 # fraction of bays we wish to be ready-to-insert
  cost_audit: false # if true, emit CSV per-segment cost audit lines for each plan

simulator:
  # When false, the sim leaves the insert for something outside it to confirm (the app, the REST
  # API, or a manual /bay/b{bay_id}/confirm_insert call) rather than auto confirming on the
  # patron's behalf
  auto_confirm_insert: true

vecs:
  io: # IO PLC for LEDs, buttons, etc
    ip: '192.168.1.100'
    port: 502
  evse: # Electric Vehicle Supply Equipment. Charges EV
    ip: '192.168.1.110'
    port: 502
  # VECS transition duration used by the scheduler when costing VECS events.
  transition_time: 120.0 # [s]

# Vertical Reciprocating Conveyor (VRC) motion params used by the scheduler when costing
# floor-to-floor moves, and by the VRC sim driver. Hardware driver config lives in the `lift:`
# section below. All VRC gates use the same open/close timing.
vrc:
  performance_limits:
    transit:
      speed: 0.254 # [m/s] (50 ft/min, per autoquip spec)
      accel: 0.2 # [m/s^2] placeholder, AGV-equivalent
  door:
    open_time: 5.0 # [s] time for any VRC gate to open
    close_time: 5.0 # [s] time for any VRC gate to close
</file>

