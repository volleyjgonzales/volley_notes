#!/usr/bin/env python3
# pylint: disable=E1120

import os
import click
from common_py.layout import load_layout, get_layout_filepath
from common_py.shell_utils import get_md5sum
from common_py.processing.grid_generation import (
    generate_grid_for_layout,
    write_xml_element_to_utf8,
)


# Load the layout and generate the grid
@click.command()
@click.argument("layout_name", required=1)
@click.argument("xml_output_path", required=0, default=None)
def layout_yaml_to_xml(layout_name, xml_output_path):
