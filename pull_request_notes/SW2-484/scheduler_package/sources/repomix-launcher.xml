import os
import yaml
from common_py.general_utils import merge_params_dict

from ament_index_python.packages import get_package_share_directory
from launch.substitutions import EnvironmentVariable
from launch import LaunchContext


ENV_VAR__DEVICE_ID = "DEVICE_ID"
ENV_VAR__LAYOUT = "LAYOUT"
ENV_VAR__INSTALLATION_ID = "INSTALLATION_ID"


def string_to_bool(s):
    return s.lower() in [
        "true",
        "1",
        "t",
        "y",
        "yes",
        "yeah",
        "yup",
        "certainly",
        "uh-huh",
    ]


# Load a parameter file from the launcher/params directory
def load_param_file(file_name):
    params_file = os.path.join(
        get_package_share_directory("launcher"), "params", file_name
    )
    # Note: we are not handling the exception that will be thrown if the file does not exist as,
    # in most cases, we'd like to exit the program if this happens.
    with open(params_file, "r") as f:
        params = yaml.load(f, Loader=yaml.FullLoader)

    return params if params is not None else {}


# Load parameters in most generic to most specific order. Allows for more specific files to
# override more generic ones.
def load_params(device_type, layout=None, installation_id=None, use_sim_time=False):
    # If layout and installation_id are not passed in, we are running a production system.
    production = layout is None and installation_id is None

    # Load layout and installation_id if they are not passed in
    if layout is None:
        layout = str(EnvironmentVariable(ENV_VAR__LAYOUT).perform(LaunchContext()))
    if installation_id is None:
        installation_id = int(
            EnvironmentVariable(ENV_VAR__INSTALLATION_ID).perform(LaunchContext())
        )

    # Always load the device id. This gets ignored in the sim and so defaulting to zero is ok
    device_id = int(
        EnvironmentVariable(ENV_VAR__DEVICE_ID, default_value="0").perform(
            LaunchContext()
        )
    )

    # Load the default parameters
    params = load_param_file("params.yaml")

    # Merge in the device-specific params file
    device_specific_params = load_param_file("params_" + device_type + ".yaml")
    params = merge_params_dict(params, device_specific_params)

    # Merge in the layout-specific params file if such a file exists
    try:
        installation_params = load_param_file("params_" + layout + ".yaml")
        params = merge_params_dict(params, installation_params)
    except FileNotFoundError:
        if production:
            print(
                f"ERROR: Running a production system with layout {layout}. Requires a "
                f"params_{layout}.yaml parameter override file in the params/installations "
                f"folder, but that file was not found. Exiting."
            )
            raise

    # Merge in the device-specific params file if such a file exists. This file is not required.
    name = device_type[0] + str(device_id)
    try:
        device_params = load_param_file("params_" + name + ".yaml")
        params = merge_params_dict(params, device_params)
    except FileNotFoundError:
        pass

    # Parameters that all nodes should know about
    common_params = {
        "layout": layout,
        "installation_id": installation_id,
        "use_sim_time": use_sim_time,
    }

    # Merge the common params into all other param sets. Also add them at the top layer
    for name, param_dict in params.items():
        params[name] = merge_params_dict(param_dict, common_params)
    params = merge_params_dict(params, common_params)

    return params, device_id
