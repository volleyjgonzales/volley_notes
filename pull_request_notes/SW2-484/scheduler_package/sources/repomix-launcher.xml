from launch_ros.actions import Node
from common_py.layout import load_layout


def get_vrc_sim_nodes(params, initial_conditions=None):
    """Returns a map of VRC nodes by vrc_id for the sim launcher."""
    layout = load_layout(params["layout"])

    floor_ids = [f.id for f in layout.floors]
    floor_z_positions = [f.z for f in layout.floors]

    vrc_params = params.get("vrc", {})
    transit = vrc_params.get("performance_limits", {}).get("transit", {})
    door = vrc_params.get("door", {})

    initial_floors_by_id = {
        vrc["id"]: vrc["initial_floor"]
        for vrc in (initial_conditions or {}).get("vrcs", [])
        if "initial_floor" in vrc
    }

    vrc_id_to_nodes = {}
    for vrc in layout.vrcs:
        vrc_id = vrc["id"]
        print(f"adding vrc node: /vrc/r{vrc_id}/manager")
        vrc_id_to_nodes[vrc_id] = [
            Node(
                package="vrc",
                executable="vrc",
                name="manager",
                namespace="/vrc/r" + str(vrc_id),
                parameters=[
                    {
                        "id": vrc_id,
                        "config.floors": floor_ids,
                        "config.floor_z_positions": floor_z_positions,
                        "performance_limits.transit.speed": transit["speed"],
                        "performance_limits.transit.accel": transit["accel"],
                        "door.open_time": door["open_time"],
                        "door.close_time": door["close_time"],
                        "initial.floor": initial_floors_by_id.get(vrc_id, -1),
                        "use_sim_time": params.get("use_sim_time", False),
                    }
                ],
                output="screen",
                emulate_tty=True,
                remappings=[
                    ("/rosout", "/vrc/r" + str(vrc_id) + "/rosout"),
                ],
            )
        ]

    return vrc_id_to_nodes
