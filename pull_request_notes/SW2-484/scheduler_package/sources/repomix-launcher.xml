# Launch the ROS2 bag play, and the Volley visualization node, and the Foxglove bridge.
# https://answers.ros.org/question/409285/

import sys
import re
import os
from launch import LaunchDescription
from launch.actions import ExecuteProcess
from launch_ros.actions import Node

RE_PARAM_BAGFILE = re.compile(r"bagfile:=(\S+)")


def generate_launch_description():
    bagfile = ""
    args = sys.argv
    for arg in args[2:]:
        m = RE_PARAM_BAGFILE.match(arg)
        if m:
            bagfile = m[1]
            continue

    if not os.path.exists(bagfile):
        print(f"bagplay.launch.py Error: file not found {bagfile}")
        raise FileNotFoundError(f"Bag file not found: {bagfile}")

    launch_description_entities = []

    visualizer_node = Node(
        package="vis",
        namespace="vis",
        executable="visualizer_node",
        name="visualizer",
        parameters=[{"use_remote_meshes": False}],
        output="screen",
        emulate_tty=True,
        remappings=[
            ("/rosout", "/sim/rosout"),
        ],
    )
    launch_description_entities.append(visualizer_node)

    foxglove_bridge = ExecuteProcess(
        cmd=["ros2", "launch", "foxglove_bridge", "foxglove_bridge_launch.xml"]
    )
    launch_description_entities.append(foxglove_bridge)

    bagplayer = ExecuteProcess(
        cmd=[
            "ros2",
            "bag",
            "play",
            "--loop",
            bagfile,
        ],
        output="screen",
    )
    launch_description_entities.append(bagplayer)

    return LaunchDescription(launch_description_entities)
