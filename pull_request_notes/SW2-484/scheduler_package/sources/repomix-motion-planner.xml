#include "motion_planner/static_graph_filtering.hpp"

#include <unordered_map>
#include <unordered_set>

#include "common_ros/discrete_garage_state_utils.hpp"

namespace volley {

GraphFilterProperties::GraphFilterProperties(const volley::GarageGraph& graph,
    const std::unordered_set<volley::CollisionTable::Pose>& disabled_poses,
    const std::unordered_set<volley::CollisionTable::Edge>& disabled_edges) :
    vertex_filter_(graph.MakeVertexVectorPropertyMap<bool>(true)),
    edge_filter_(graph.MakeEdgeVectorPropertyMap<bool>(true)) {
  // Set edge/vertex properties corresponding to poses/edges
  for(const volley::CollisionTable::Edge& edge : disabled_edges) {
    auto e_opt = graph.EdgeFromPoses(edge[0], edge[1]);
    if(e_opt.has_value()) {
      AddProperty(e_opt.value(), false);
    }
    else {
      throw std::invalid_argument(
          "Edge " + std::to_string(edge[0]) + ", " + std::to_string(edge[1]) + " not found in graph");
    }
  }
  for(const auto& pose : disabled_poses) {
    auto v_opt = graph.GetVertexFromPose(pose);
    if(v_opt.has_value()) {
      AddProperty(v_opt.value(), false);
    }
    else {
      throw std::invalid_argument("Pose " + std::to_string(pose) + " not found in graph");
    }
  }
}

GraphFilterProperties GetStaticFilter(const volley::CollisionEntityId_t& collision_id,
    const volley::GarageGraph& gg, const volley::DiscreteGarageState& dgs,
    const volley::CollisionTable& ctable, const std::unordered_set<uint16_t>& ignore_trays,
    const std::unordered_set<uint16_t>& ignore_agvs, const std::unordered_set<uint16_t>& ignore_bays) {
  if(gg.GetLayout()->GetMD5Sum() != ctable.GetGraph().GetLayout()->GetMD5Sum()) {
    throw std::invalid_argument("Constraint table layout mismatched with graph layout");
  }

  std::unordered_set<volley::CollisionTable::Edge> disabled_edges;
  std::unordered_set<volley::CollisionTable::Pose> disabled_poses;

  const auto& disabled_nodes = dgs.GetDisabledNodes();

  // Set of all disabled nodes corresponding to disabled entities or
  // nodes that are specifically disabled in the DGS
  std::set<uint32_t> all_disabled_nodes;
  all_disabled_nodes.insert(disabled_nodes.begin(), disabled_nodes.end());

  // Filter areas where trays/payloads conflict with this payload type
  for(const auto& [tray_id, tray_state] : dgs.GetTrays()) {
    if(tray_state.disabled) {
      all_disabled_nodes.insert(tray_state.pose.node_id);
    }
    if(ignore_trays.find(tray_id) != ignore_trays.end()) {
      // Ignore any moving trays in this filter
      continue;
    }
    // Want all the places that this resource type can't be, if the other
    // payload type is at tray_pose.
    auto other_collision_id = volley::CollisionEntityIdFromTrayState(tray_state, dgs, *(gg.GetLayout()));
    if(collision_id == common::EnumInteger(volley::CollisionEntityId::AGV)) {
      // Agv w/ lift down collides with tray legs, not payload or tray
      other_collision_id = common::EnumInteger(volley::CollisionEntityId::TRAY_LEGS);
    }
    auto [poses, edges] = ctable.Query(other_collision_id, collision_id, tray_state.pose);
    disabled_poses.insert(poses.begin(), poses.end());
    disabled_edges.insert(edges.begin(), edges.end());
  }

  // Filter areas where agvs conflict with this payload type
  for(const auto& [agv_id, agv_state] : dgs.GetAgvs()) {
    if(agv_state.disabled) {
      all_disabled_nodes.insert(agv_state.pose.node_id);
    }
    if(ignore_agvs.find(agv_id) != ignore_agvs.end()) {
      // Ignore any moving AGVs in this filter
      continue;
    }
    // Want all the places that this resource type can't be, if an AGV is at agv_pose.
    auto adjust_collision_id = collision_id;
    if(collision_id >= common::EnumInteger(volley::CollisionEntityId::AGV)) {
      // We use 'TRAY' instead of payload type since the AGV would collide with the
      // outer perimeter of a tray (legs) before it would hit the payload
      adjust_collision_id = common::EnumInteger(volley::CollisionEntityId::TRAY);
    }

    auto [poses, edges] = ctable.Query(
        common::EnumInteger(volley::CollisionEntityId::AGV), adjust_collision_id, agv_state.pose);

    disabled_poses.insert(poses.begin(), poses.end());
    disabled_edges.insert(edges.begin(), edges.end());
  }

  // Filter areas where bays conflict with this payload type
  for(const auto& [bay_id, bay_state] : dgs.GetBays()) {
    if(bay_state.disabled) {
      all_disabled_nodes.insert(bay_id);
    }
    if(ignore_bays.find(bay_id) != ignore_bays.end()) {
      // Ignore any moving bays in this filter
      continue;
    }
    // Bays in ready-to-retrieve don't collide
    if(bay_state.state == BayReportMsg::STATE_READY_TO_RETRIEVE) {
      continue;
    }

    auto bay_head = gg.GetLayout()->GetBayInboundHeading(bay_id).value();
    auto bay_pose = volley::ConstructGaragePose(bay_id, static_cast<int16_t>(bay_head));

    // Want all the places that this payload type can't be, if the bay is not ready to retrieve
    auto [poses, edges] =
        ctable.Query(common::EnumInteger(volley::CollisionEntityId::BAY_ODP), collision_id, bay_pose);

    disabled_poses.insert(poses.begin(), poses.end());
    disabled_edges.insert(edges.begin(), edges.end());
  }

  // Filter all disabled areas
  for(const auto& node_id : all_disabled_nodes) {
    auto garage_node_opt = gg.GetLayout()->GetNodeById(node_id);
    // ffs
    if(!garage_node_opt) {
      throw std::invalid_argument(
          "Discrete garage state has a disabled node that does not exist in the layout " +
          std::to_string(node_id));
    }
    auto garage_node = garage_node_opt.value();

    // For disabled nodes we assume the entire volume corresponding to the largest entity type
    // is disabled
    auto max_win_idx = static_cast<volley::CollisionEntityId_t>(garage_node.max_resource_size_index);
    auto disabled_entity_collision_id = common::EnumInteger(volley::CollisionEntityId::TRAY);
    if(max_win_idx > 0) {
      // adjust collision id to match payload
      disabled_entity_collision_id = common::EnumInteger(volley::CollisionEntityId::PAYLOAD) + max_win_idx;
    }

    // Disable volume for all possible orientations
    for(auto head : garage_node.headings) {
      auto disabled_entity_pose = volley::ConstructGaragePose(node_id, head);
      auto [poses, edges] = ctable.Query(disabled_entity_collision_id, collision_id, disabled_entity_pose);

      disabled_poses.insert(poses.begin(), poses.end());
      disabled_edges.insert(edges.begin(), edges.end());
    }
  }

  if(collision_id >= common::EnumInteger(volley::CollisionEntityId::PAYLOAD)) {
    // Filter all poses that don't support a resource of this size
    size_t resource_window_idx = collision_id - common::EnumInteger(volley::CollisionEntityId::PAYLOAD);
    for(const auto& vertex : boost::make_iterator_range(gg.GetVertices())) {
      auto pose = gg.GetPoseFromVertex(vertex).value();
      if(resource_window_idx > gg.GetLayout()->GetNodeById(pose.node_id)->max_resource_size_index) {
        // WARNS(rclcpp::get_logger("static_graph_filtering"),
        //     "Pose " << std::to_string(pose) << " does not support resource size " << resource_window_idx);
        disabled_poses.insert(pose);
        for(const auto& edge : boost::make_iterator_range(gg.GetInEdges(vertex))) {
          disabled_edges.insert(gg.GetFromGraphRep(edge));
        }
        for(const auto& edge : boost::make_iterator_range(gg.GetOutEdges(vertex))) {
          disabled_edges.insert(gg.GetFromGraphRep(edge));
        }
      }
    }
  }

  return {gg, disabled_poses, disabled_edges};
}

std::unordered_map<volley::CollisionEntityId_t, GraphFilterProperties> GetAllStaticFilters(
    const volley::GarageGraph& gg, const volley::DiscreteGarageState& dgs,
    const volley::CollisionTable& ctable, const std::unordered_set<uint16_t>& ignore_trays,
    const std::unordered_set<uint16_t>& ignore_agvs, const std::unordered_set<uint16_t>& ignore_bays) {
  std::unordered_map<volley::CollisionEntityId_t, GraphFilterProperties> collision_id_filters;

  // Always compute the filter for AGVs and empty Tray
  auto agv_filter = GetStaticFilter(common::EnumInteger(volley::CollisionEntityId::AGV), gg, dgs, ctable,
      ignore_trays, ignore_agvs, ignore_bays);
  collision_id_filters.insert({common::EnumInteger(volley::CollisionEntityId::AGV), std::move(agv_filter)});

  auto tray_filter = GetStaticFilter(common::EnumInteger(volley::CollisionEntityId::TRAY), gg, dgs, ctable,
      ignore_trays, ignore_agvs, ignore_bays);
  collision_id_filters.insert({common::EnumInteger(volley::CollisionEntityId::TRAY), std::move(tray_filter)});

  // Get the filter for payload windows in the DGS
  for(const auto& [curr_tray_id, curr_tray_state] : dgs.GetTrays()) {
    volley::CollisionEntityId_t collision_id =
        volley::CollisionEntityIdFromTrayState(curr_tray_state, dgs, *(gg.GetLayout()));
    // Don't need to compute it for this resource size if we already have it
    if(collision_id_filters.find(collision_id) != collision_id_filters.end()) {
      continue;
    }
    auto payload_filter =
        GetStaticFilter(collision_id, gg, dgs, ctable, ignore_trays, ignore_agvs, ignore_bays);
    collision_id_filters.insert({collision_id, std::move(payload_filter)});
  }

  return collision_id_filters;
}

std::unordered_map<volley::CollisionEntityId_t, GraphFilterProperties> GetDisabledEntitiesFilters(
    const volley::GarageGraph& gg, const volley::DiscreteGarageState& dgs,
    const volley::CollisionTable& ctable) {
  std::unordered_set<uint16_t> ignore_agvs;
  std::unordered_set<uint16_t> ignore_trays;
  std::unordered_set<uint16_t> ignore_bays;

  const auto& disabled_nodes = dgs.GetDisabledNodes();
  // ignore all entities that are not disabled or are not on disabled nodes
  for(const auto& [agv_id, agv_state] : dgs.GetAgvs()) {
    // If agv is not disabled and not on a disabled node, ignore in filter
    if(disabled_nodes.find(agv_state.pose.node_id) == disabled_nodes.end() && !agv_state.disabled) {
      ignore_agvs.insert(static_cast<uint16_t>(agv_id));
    }
  }
  for(const auto& [tray_id, tray_state] : dgs.GetTrays()) {
    // If tray is not disabled and not on a disabled node, ignore in filter
    if(disabled_nodes.find(tray_state.pose.node_id) == disabled_nodes.end() && !tray_state.disabled) {
      ignore_trays.insert(static_cast<uint16_t>(tray_id));
    }
  }
  for(const auto& [bay_id, bay_state] : dgs.GetBays()) {
    // If bay is not disabled and not on a disabled node, ignore in filter
    if(disabled_nodes.find(static_cast<uint16_t>(bay_id)) == disabled_nodes.end() && !bay_state.disabled) {
      ignore_bays.insert(static_cast<uint16_t>(bay_id));
    }
  }

  return GetAllStaticFilters(gg, dgs, ctable, ignore_trays, ignore_agvs, ignore_bays);
}

}  // namespace volley
