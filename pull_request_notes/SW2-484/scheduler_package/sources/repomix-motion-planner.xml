#include "motion_planner/garage_graph_pathing.hpp"

#include <cost_functions/motion_run.hpp>

namespace volley {

namespace {
Interval::Duration ToIntervalDuration(cost::SecondsF seconds) {
  return std::chrono::duration_cast<Interval::Duration>(seconds);
}
}  // namespace

volley::GarageGraph::EdgeVectorPropertyMap<Interval::Duration> GetEdgeDurations(
    const volley::GarageGraph& garage_graph, const cost::MotionCostModel& cost_model) {
  // Create an EdgeVectorPropertyMap to store the durations
  auto edge_durations = garage_graph.MakeEdgeVectorPropertyMap<Interval::Duration>(Interval::Duration(0));

  // Iterate over all edges in the garage_graph
  for(auto [edge_iter, edge_end] = garage_graph.GetEdges(); edge_iter != edge_end; ++edge_iter) {
    auto edge = *edge_iter;

    // Get the transition for the current edge
    std::optional<volley::Transition> transition = garage_graph.GetTransition(edge);

    if(transition) {
      Interval::Duration duration = ToIntervalDuration(cost_model.Duration(transition.value()));
      boost::put(edge_durations, edge, duration);
    }
    else {
      throw std::invalid_argument("Input garage graph does not have Transition defined for all edges");
    }
  }

  return edge_durations;
}

volley::GarageGraph::EdgeVectorPropertyMap<Interval::Duration> GetEdgeMarginalDurations(
    const volley::GarageGraph& garage_graph, const cost::MotionCostModel& cost_model) {
  auto edge_durations = garage_graph.MakeEdgeVectorPropertyMap<Interval::Duration>(Interval::Duration(0));
  for(auto [edge_iter, edge_end] = garage_graph.GetEdges(); edge_iter != edge_end; ++edge_iter) {
    auto edge = *edge_iter;
    auto transition_opt = garage_graph.GetTransition(edge);
    if(!transition_opt) {
      throw std::invalid_argument("Input garage graph does not have Transition defined for all edges");
    }
    const auto& transition = transition_opt.value();
    const auto limits = cost_model.VelocityLimitsFor(transition.type, /*is_agv_loaded=*/false);
    const float marginal_seconds = static_cast<float>(transition.length) / limits.speed;
    boost::put(edge_durations, edge, ToIntervalDuration(cost::SecondsF(marginal_seconds)));
  }
  return edge_durations;
}

bool GarageGraphEnvironment::OnExpansion(
    const volley::GarageGraph::Vertex& state, const Interval::Duration&, const SearchMetaData&) {
  if(target_) {
    return state == target_.value();
  }
  return false;
}

std::vector<std::pair<volley::GarageGraph::Vertex, Interval::Duration>> GarageGraphEnvironment::GetNeighbors(
    const volley::GarageGraph::Vertex& state) {
  std::vector<std::pair<volley::GarageGraph::Vertex, Interval::Duration>> neighbors;
  for(auto [edge_iter, edge_end] = graph_.GetOutEdges(state); edge_iter != edge_end; ++edge_iter) {
    auto edge = *edge_iter;
    // If we are using filters, don't consider traversing this edge if it's not enabled
    if(filters_.has_value()) {
      if(!filters_->IsEnabled(edge)) {
        continue;
      }
    }
    auto transition = graph_.GetTransition(edge);
    if(transition) {
      auto dst_vertex = boost::target(edge, graph_.GetBaseGraph());
      // If we are using filters, don't consider this neighbor if it's not enabled
      if(filters_.has_value()) {
        if(!filters_->IsEnabled(dst_vertex)) {
          continue;
        }
      }
      // GarageGraphEnvironment is the non-SIPP single-source search backing GetPosePath, used
      // only to discover *topology* (the path of poses to traverse). Per-edge full-Trapezoid
      // weight is fine here because the consumer ConvertPosePathToTrajectory immediately
      // recomputes the chosen path's *timing* with run-coalesced trapezoids. Ring 3b's
      // path-dependent edge costs live in SippEnvironment, which is the search that interacts
      // with deconfliction and so needs path-dependent costs to stay self-consistent.
      Interval::Duration cost = ToIntervalDuration(cost_model_.Duration(transition.value()));
      neighbors.emplace_back(dst_vertex, cost);
    }
  }
  return neighbors;
}

std::vector<GaragePoseMsg> GetPosePath(const volley::GarageGraph& graph, const GaragePoseMsg& source,
    const GaragePoseMsg& target, const cost::MotionCostModel& cost_model,
    std::optional<GraphFilterProperties> filters) {
  // Get the source and target vertices from the GaragePoses
  auto source_vertex = graph.GetVertexFromPose(source);
  auto target_vertex = graph.GetVertexFromPose(target);

  if(!source_vertex || !target_vertex) {
    // If either source or target vertex is not found, return an empty path
    return {};
  }

  // Construct the GarageGraphEnvironment
  GarageGraphEnvironment env(graph, cost_model, target_vertex.value(), filters);

  // Call SingleSourceSearch
  auto solution = SingleSourceSearch(source_vertex.value(), Interval::Duration::zero(), env);

  // Get the path from the solution
  auto path_optional = solution.GetPath(target_vertex.value());

  if(!path_optional) {
    // If no path is found, return an empty path
    return {};
  }

  // Convert the path from vertices to GaragePoses
  std::vector<GaragePoseMsg> pose_path;
  for(const auto& [vertex, cost] : path_optional.value()) {
    auto pose_optional = graph.GetPoseFromVertex(vertex);
    if(pose_optional) {
      pose_path.push_back(pose_optional.value());
    }
  }

  return pose_path;
}

namespace {
// Build a MotionRun-style label "<entity> <KIND> <start> -> <end> (<n> edges)"
// for the audit log. One row per coalesced run instead of one per edge.
std::string RunLabel(const cost::MotionRun& run, const GarageEntityIdMsg& entity_id) {
  const char* kind = "?";
  switch(run.type) {
  case volley::TransitionType::LOCOMOTE:
    kind = "LOCOMOTE";
    break;
  case volley::TransitionType::STRAFE:
    kind = "STRAFE";
    break;
  case volley::TransitionType::ROTATION:
    kind = "ROTATE";
    break;
  case volley::TransitionType::VRC_TRANSITION:
    kind = "VRC";
    break;
  }
  return std::to_string(entity_id) + " " + kind + " " + std::to_string(run.poses.front()) + " -> " +
         std::to_string(run.poses.back()) + " (" + std::to_string(run.poses.size() - 1) + " edges)";
}
}  // namespace

Trajectory ConvertPosePathToTrajectory(const std::vector<GaragePoseMsg>& pose_path,
    const volley::GarageGraph& graph, const cost::MotionCostModel& cost_model,
    const Interval::Timepoint& start_time, const GarageEntityIdMsg& entity_id,
    volley::CollisionEntityId_t collision_id, size_t action_id, cost::CostVector* audit, bool is_agv_loaded) {
  Trajectory trajectory;
  if(pose_path.size() < 2) {
    return trajectory;
  }

  // Group consecutive collinear/codirectional edges into runs so a chain of
  // N pose-pairs that the AGV sweeps through without stopping costs one
  // Trapezoid over the run's total length, not N independent trapezoids.
  // Per-edge Motions are still emitted (so deconfliction at intermediate
  // nodes stays correct) but each Motion's interval is a sub-slice of the
  // single run trapezoid via TimeAtDistance.
  auto runs = cost::CoalesceMotionRuns(pose_path, graph);

  Interval::Timepoint current_time = start_time;
  for(const auto& run : runs) {
    const auto limits = cost_model.VelocityLimitsFor(run.type, is_agv_loaded);
    const float total_length = static_cast<float>(run.total_length);

    cost::SecondsF run_duration =
        audit ? cost_model.Duration(run, *audit, RunLabel(run, entity_id), is_agv_loaded)
              : cost_model.Duration(run, is_agv_loaded);

    // Walk the run's edges and assign each its sub-interval based on the
    // continuous trapezoidal arclength integral.
    float cum = 0.0f;
    float prev_t = 0.0f;
    for(size_t i = 0; i + 1 < run.poses.size(); ++i) {
      const auto& curr_pose = run.poses[i];
      const auto& next_pose = run.poses[i + 1];

      auto edge_opt = graph.EdgeFromPoses(curr_pose, next_pose);
      auto transition = graph.GetTransition(edge_opt.value()).value();
      cum += static_cast<float>(transition.length);
      const bool is_last_edge_of_run = (i + 2 == run.poses.size());
      const float next_t = is_last_edge_of_run
                               ? run_duration.count()
                               : cost::TimeAtDistance(cum, total_length, limits.speed, limits.accel);

      AgvPoseChangedMsg pose_changed;
      pose_changed.agv_id = entity_id.id;
      pose_changed.node_id_curr = curr_pose.node_id;
      pose_changed.heading_curr = curr_pose.heading;
      pose_changed.node_id_next = next_pose.node_id;
      pose_changed.heading_next = next_pose.heading;

      Interval::Duration sub_begin = ToIntervalDuration(cost::SecondsF(prev_t));
      Interval::Duration sub_end = ToIntervalDuration(cost::SecondsF(next_t));
      Interval interval(current_time + sub_begin, current_time + sub_end);
      trajectory.AddMotion(Motion(entity_id, interval, collision_id, action_id, pose_changed));
      prev_t = next_t;
    }
    current_time += ToIntervalDuration(run_duration);
  }

  return trajectory;
}

}  // namespace volley
