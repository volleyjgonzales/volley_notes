<file path="include/motion_planner/safe_interval_table.hpp">
#pragma once

#include <chrono>
#include <common/types.hpp>
#include <common_ros/collision_geometry.hpp>
#include <common_ros/garage_graph.hpp>
#include <motion_planner/interval.hpp>
#include <optional>
#include <set>
#include <stdexcept>
#include <string>
#include <unordered_map>
#include <variant>

namespace volley {

class SafeIntervalTable {
public:
  template <typename T>  // volley::GarageGraph::Edge/Vertex
  using TableEntryKey = std::pair<volley::CollisionEntityId_t, T>;

  struct TableEntryKeyHasher {
    std::size_t operator()(const TableEntryKey<volley::GarageGraph::Edge>& key) const {
      std::size_t result = 0;
      boost::hash_combine(result, boost::hash_value(key.first));
      boost::hash_combine(result, boost::hash_value(key.second.m_source));
      boost::hash_combine(result, boost::hash_value(key.second.m_target));
      return result;
    };
    std::size_t operator()(const TableEntryKey<volley::GarageGraph::Vertex>& key) const {
      std::size_t result = 0;
      boost::hash_combine(result, boost::hash_value(key.first));
      boost::hash_combine(result, boost::hash_value(key.second));
      return result;
    };
  };

  template <typename T>  // volley::GarageGraph::Edge/Vertex
  using IntervalTableMap = std::unordered_map<TableEntryKey<T>, IntervalSet, TableEntryKeyHasher>;

  template <typename T>
  const IntervalTableMap<T>& GetIntervalMapConst() const;

  template <typename T>
  IntervalTableMap<T>& GetIntervalMap();

  template <typename T>
  IntervalSet& GetIntervalSet(const TableEntryKey<T>& key) {
    auto& interval_map = GetIntervalMap<T>();
    if(interval_map.find(key) == interval_map.end()) {
      throw std::invalid_argument("key does not exist in interval maps");
    }
    return interval_map.at(key);
  }

  template <typename T>
  const IntervalSet& GetIntervalSetConst(const TableEntryKey<T>& key) const {
    auto& interval_map = GetIntervalMapConst<T>();
    if(interval_map.find(key) == interval_map.end()) {
      throw std::invalid_argument("key does not exist in interval maps");
    }
    return interval_map.at(key);
  }

  // Update safe IntervalSet for a given (id, vertex/edge) with a constraint. If
  // an entry doesn't exist for the input, create an IntervalSet for that entry
  // and carve that Set.
  template <typename T>  // volley::GarageGraph::Edge/Vertex
  void AddConstraint(const TableEntryKey<T>& key, const Interval& constraint) {
    auto& interval_map = GetIntervalMap<T>();
    if(interval_map.find(key) == interval_map.end()) {
      InitializeKeyIfNonExistent(key);
    }

    IntervalSet& intervals = GetIntervalSet<T>(key);

    // No change if constraint ends before safe intervals start or it starts
    // after safe intervals end.
    if(constraint.StrictlyBefore(*intervals.begin()) || intervals.rbegin()->StrictlyBefore(constraint)) {
      return;
    }
    intervals.CarveInterval(constraint);
  }

  // Finds the soonest safe interval from a given timestep with a minimum
  // given duration. Note that earliest_start does not have to be within a
  // safe interval (i.e. isn't necessarily the required start time); this
  // function will find one at or after that time where the duration fits.
  // Will return std::nullopt if there is no such safe interval.
  template <typename T>  // volley::GarageGraph::Edge/Vertex
  std::optional<Interval> FindSafeInterval(const TableEntryKey<T>& key,
      const Interval::Timepoint& earliest_start, const Interval::Duration& duration) const {
    // If key does not exist return min,max interval
    //  (guaranteed to contain query interval)
    auto& interval_map = GetIntervalMapConst<T>();
    if(interval_map.find(key) == interval_map.end()) {
      return Interval(Interval::Timepoint::min(), Interval::Timepoint::max());
    }

    const IntervalSet& intervals = GetIntervalSetConst<T>(key);
    // If the timestep plus duration goes beyond last safe interval, early
    // exit.
    if(earliest_start + duration > intervals.rbegin()->GetTimes().second) {
      return std::nullopt;
    }
    for(const Interval& safe_interval : intervals) {
      const auto [start, end] = safe_interval.GetTimes();
      // If it starts and ends in a safe interval, return that interval.
      if(start <= earliest_start && earliest_start <= end && start <= (earliest_start + duration) &&
          (earliest_start + duration) <= end) {
        return safe_interval;
      }
      // If it starts before the safe interval and will definitely fit in that
      // interval, return that interval.
      if(earliest_start < start && safe_interval.GetDuration() >= duration) {
        return safe_interval;
      }
    }
    // No valid interval exists.
    return std::nullopt;
  }

  // Returns true if the interval to check is not wholly contained by any safe
  // interval for the given key, and false otherwise.
  template <typename T>  // volley::GarageGraph::Edge/Vertex
  bool IsIntervalConstrained(const TableEntryKey<T>& key, const Interval& check) const {
    // if key doesn't exist then it is not constrained
    auto& interval_map = GetIntervalMapConst<T>();
    if(interval_map.find(key) == interval_map.end()) {
      return false;
    }

    const IntervalSet& intervals = GetIntervalSetConst<T>(key);

    // If check interval ends before the first safe interval or begins after the
    // last, then it is constrained ( not safe).
    if(check.StrictlyBefore(*intervals.begin()) || intervals.rbegin()->StrictlyBefore(check)) {
      return true;
    }

    const auto& [check_start, check_end] = check.GetTimes();
    for(const Interval& safe_interval : intervals) {
      // Intervals are sorted. The start and end both need to be within the
      // current safe interval to be safe.
      const auto& [start, end] = safe_interval.GetTimes();
      if(start <= check_start && check_start <= end && start <= check_end && check_end <= end) {
        return false;
      }
      // If the check interval's start time is before the current safe
      // interval's end time, but it wasn't wholly contained already, it cannot
      // be safe. Early exit.
      if(check_start <= end) {
        return true;
      }
    }
    return true;
  }

  template <typename T>  // volley::GarageGraph::Edge/Vertex
  IntervalSet GetAllSafeIntervals(const volley::CollisionEntityId_t& id, const T& location) const {
    auto key = std::make_pair(id, location);
    auto& interval_map = GetIntervalMapConst<T>();
    if(auto interval_it = interval_map.find(key); interval_it != interval_map.end()) {
      return interval_it->second;
    }
    return IntervalSet(Interval(Interval::Timepoint::min(), Interval::Timepoint::max()));
  }

private:
  IntervalTableMap<volley::GarageGraph::Edge> edge_intervals_;
  IntervalTableMap<volley::GarageGraph::Vertex> vertex_intervals_;

  // If the given key does not exist in the interval table, add an IntervalSet
  // for it consisting of one interval spanning all time, allowing it to then
  // be carved/modified as constraints are added.
  template <typename T>
  void InitializeKeyIfNonExistent(const TableEntryKey<T>& key) {
    auto& interval_sets = GetIntervalMap<T>();
    IntervalSet& intervals = interval_sets[key];  // This will create an empty set if nonexistent
    // The default for a key with no constraints is to not exist in the table.
    // In this case, we should create an interval spanning all time to be able
    // to return it.
    if(intervals.Size() == 0) {
      intervals.AddInterval(Interval(Interval::Timepoint::min(), Interval::Timepoint::max()));
    }
  }
};

template <>
const SafeIntervalTable::IntervalTableMap<volley::GarageGraph::Vertex>&
SafeIntervalTable::GetIntervalMapConst<volley::GarageGraph::Vertex>() const;
template <>
const SafeIntervalTable::IntervalTableMap<volley::GarageGraph::Edge>&
SafeIntervalTable::GetIntervalMapConst<volley::GarageGraph::Edge>() const;

template <>
SafeIntervalTable::IntervalTableMap<volley::GarageGraph::Vertex>&
SafeIntervalTable::GetIntervalMap<volley::GarageGraph::Vertex>();
template <>
SafeIntervalTable::IntervalTableMap<volley::GarageGraph::Edge>&
SafeIntervalTable::GetIntervalMap<volley::GarageGraph::Edge>();

// similar to to_string method but includes Poses rather than just vertex ids
std::string SafeIntervalTableString(const volley::SafeIntervalTable& sit, const volley::GarageGraph& gg);

}  // namespace volley

namespace std {

// NOLINTNEXTLINE(readability-identifier-naming)
std::string to_string(const volley::SafeIntervalTable& sit);

}  // namespace std
