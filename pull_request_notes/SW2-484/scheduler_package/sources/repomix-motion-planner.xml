namespace volley {

// Interval

Interval::Interval(Timepoint begin, Timepoint end) {
  if(begin <= end) {
    begin_ = begin;
    end_ = end;
  }
  else {
    begin_ = begin;
    end_ = end;
    throw std::runtime_error("Interval begin comes after Interval end! : " + std::to_string(*this));
  }
}

Interval::Duration Interval::GetDuration() const {
  return std::chrono::duration_cast<Duration>(end_ - begin_);
}

std::string DurationToSecondsString(const Interval::Duration& duration, int precision) {
  std::chrono::duration<double> seconds = std::chrono::duration_cast<std::chrono::duration<double>>(duration);
  std::ostringstream oss;
  oss << std::fixed << std::setprecision(precision) << seconds.count();

  return oss.str();
}

std::string TimepointToSecondsString(const Interval::Timepoint& timepoint, int precision) {
  if(timepoint == Interval::Timepoint::max()) {
    return "inf";
  }

  auto duration = timepoint.time_since_epoch();
  auto seconds = std::chrono::duration_cast<std::chrono::duration<double>>(duration);

  std::ostringstream oss;
  oss << std::fixed << std::setprecision(precision) << seconds.count();

  return oss.str();
}

std::string IntervalToSecondsString(const Interval& interval, int precision, int digits) {
  std::string begin_str = TimepointToSecondsString(interval.GetBegin(), precision);
  std::string end_str = TimepointToSecondsString(interval.GetEnd(), precision);

  // NOLINTNEXTLINE
  auto TruncateString = [](std::string& str, size_t len) {
    if(str.length() > len) {
      str = str.substr(str.length() - len);
    }
  };

  if(digits > 0) {
    TruncateString(begin_str, digits + 1);  // +1 to account for '.'
    TruncateString(end_str, digits + 1);
  }

  std::ostringstream oss;
  oss << "[" << begin_str << ", " << end_str << "]";

  return oss.str();
}

std::string IntervalToNanosecondsString(const Interval& interval) {
  std::ostringstream oss;
  oss << "["
      << std::chrono::duration_cast<std::chrono::nanoseconds>(interval.GetBegin().time_since_epoch()).count()
      << ", "
      << std::chrono::duration_cast<std::chrono::nanoseconds>(interval.GetEnd().time_since_epoch()).count()
      << "]";

  return oss.str();
}

//--------------------
// Interval Set

// Adds interval to set if there is no overlap
bool IntervalSet::AddInterval(const Interval& interval) {
  if(intervals_.empty()) {
    intervals_.insert(interval);
    return true;
  }

  // First interval which starts after interval.
  auto it = intervals_.lower_bound(interval);
  if(it == intervals_.end()) {
    it--;
    if(it->StrictlyBefore(interval)) {
      // Insert into end
      intervals_.insert(intervals_.end(), interval);
      return true;
    }
    else {
      return false;
    }
  }
  else if(interval.StrictlyBefore(*it)) {
    if(it != intervals_.begin()) {
      it--;
      if(!it->StrictlyBefore(interval)) {
        // If the prior overlaps with the new interval, reject.
        return false;
      }
    }
    intervals_.insert(interval);
    return true;
  }
  else {
    return false;
  }
  // Should never be here
  return false;
}

// Adds interval to set, merging any overlapping intervals
void IntervalSet::MergeInterval(const Interval& interval) {
  auto merged_interval = interval;
  // First interval which starts after interval.
  auto it = intervals_.lower_bound(merged_interval);
  auto following = it;
  if(it != intervals_.begin()) {
    auto prior = --it;
    // if (!prior->StrictlyBefore(merged_interval))
    if((!prior->StrictlyBefore(merged_interval)) || (prior->GetEnd() == merged_interval.GetBegin())) {
      // Merge with prior merged_interval
      merged_interval = Interval(prior->GetTimes().first, merged_interval.GetTimes().second);
      intervals_.erase(prior);
    }
  }
  while(following != intervals_.end() && not merged_interval.StrictlyBefore(*following)) {
    // Merge with following merged_interval
    merged_interval = Interval(merged_interval.GetTimes().first, following->GetTimes().second);
    following = intervals_.erase(following);
  }
  intervals_.insert(merged_interval);
}

// Cuts into interval set, shortening overlapping intervals and removing wholly
// contained intervals. Ensures a gap in the interval set corresponding to the
// interval argument.
void IntervalSet::CarveInterval(const Interval& interval) {
  // First interval which starts after interval.
  auto it = intervals_.lower_bound(interval);
  auto following = it;
  if(it != intervals_.begin()) {
    auto prior = --it;
    if(!prior->StrictlyBefore(interval)) {
      // Cut into prior interval
      auto new_prior = Interval(prior->GetTimes().first, interval.GetTimes().first);
      if(prior->GetTimes().second > interval.GetTimes().second) {
        // Prior has extra time after carve interval as well
        auto new_following = Interval(interval.GetTimes().second, prior->GetTimes().second);
        intervals_.insert(new_following);
      }
      // Must alwasy erase first, otherwise insert will fail, since
      // intervals_ is only sorted by begin time.
      intervals_.erase(prior);
      intervals_.insert(new_prior);
    }
  }

  while(following != intervals_.end() && not interval.StrictlyBefore(*following)) {
    // Cut into following interval
    if(following->GetTimes().second > interval.GetTimes().second) {
      // Following has extra time after carve interval as well
      auto new_following = Interval(interval.GetTimes().second, following->GetTimes().second);
      intervals_.insert(new_following);
    }
    following = intervals_.erase(following);
  }
}

// Remove exact interval, if it exists
bool IntervalSet::RemoveInterval(const Interval& interval) {
  auto it = intervals_.find(interval);
  // Intervals are only sorted by beginning, so we need to check if these are
  // equal. Enforcing no overlapping intervals is the job of Add/Merge/Carve
  if(it != intervals_.end() && *it == interval) {
    intervals_.erase(it);
    return true;
  }
  return false;
}

void IntervalSet::RemoveOverlappingIntervals(const Interval& interval) {
  // Need to check the prior interval since it could start before but end
  // after the queried interval;
  auto it = intervals_.lower_bound(interval);
  if(it != intervals_.begin()) {
    it--;
    if(!it->StrictlyBefore(interval)) {
      it = intervals_.erase(it);
    }
    else {
      it++;
    }
  }
  while(it != intervals_.end() && !interval.StrictlyBefore(*it)) {
    it = intervals_.erase(it);
  }
}

