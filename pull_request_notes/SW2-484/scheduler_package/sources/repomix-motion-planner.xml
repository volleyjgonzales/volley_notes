#include "motion_planner/continuous_state.hpp"

#include <common_ros/discrete_garage_event_io.hpp>
#include <common_ros/discrete_garage_state_utils.hpp>

namespace volley {

ContinuousState::ContinuousState(const volley::DiscreteGarageState& initial_state,
    const volley::CollisionTable& table, const volley::Layout& layout,
    std::optional<Interval::Timepoint> now_time) :
    initial_state_(initial_state), table_(table) {
  // NOTE / TODO (mark): we set initial 'stationary' action id to 999999 here
  // initial 'motion' doesn't actually correspond to an action so the id doesn't
  // matter but this could obviously be improved (action id maybe should be an optional?)
  size_t stationary_action_id = 999999;

  Interval::Timepoint stationary_until;
  if(now_time) {
    stationary_until = now_time.value();
  }
  else {
    // Also vomit
    stationary_until = std::chrono::system_clock::now();
  }

  for(const auto& [agv_id, agv] : initial_state.GetAgvs()) {
    Trajectory traj;

    auto agv_collision_id = volley::CollisionEntityIdFromAgvState(agv, initial_state, layout);

    traj.AddMotion(Motion(volley::AgvId(agv_id), Interval(Interval::Timepoint::min(), stationary_until),
        agv_collision_id, stationary_action_id, agv.pose));
    trajectories_.emplace(std::make_pair(volley::AgvId(agv_id), std::move(traj)));
  }
  for(const auto& [bay_id, bay] : initial_state.GetBays()) {
    size_t bay_collision_id = common::EnumInteger(volley::CollisionEntityId::BAY_ODP);
    Trajectory traj;
    BayStateChangedMsg change;
    change.bay_id = bay_id;
    change.state_curr = bay.state;
    change.state_next = bay.state;
    traj.AddMotion(Motion(volley::BayId(bay_id), Interval(Interval::Timepoint::min(), stationary_until),
        bay_collision_id, stationary_action_id, change));
    trajectories_.emplace(std::make_pair(volley::BayId(bay_id), std::move(traj)));
  }
  for(const auto& [vecs_id, vecs] : initial_state.GetVexen()) {
    // TODO(some poor f*cker) make a real collision entity ID for vexen
    size_t vecs_collision_id = common::EnumInteger(volley::CollisionEntityId::TRAY_LEGS);
    Trajectory traj;
    VecsStateChangedMsg change;
    change.vecs_id = vecs_id;
    change.state_curr = vecs.state;
    change.state_next = vecs.state;
    traj.AddMotion(Motion(volley::VecsId(vecs_id), Interval(Interval::Timepoint::min(), stationary_until),
        vecs_collision_id, stationary_action_id, change));
    trajectories_.emplace(std::make_pair(volley::VecsId(vecs_id), std::move(traj)));
  }
  for(const auto& [vrc_id, vrc] : initial_state.GetVrcs()) {
    // VRC does not occupy physical space — use TRAY_LEGS as a placeholder collision id
    size_t vrc_collision_id = common::EnumInteger(volley::CollisionEntityId::TRAY_LEGS);
    Trajectory traj;
    VrcStateChangedMsg change;
    change.current_discrete_state = vrc;
    change.next_discrete_state = vrc;
    traj.AddMotion(Motion(volley::VrcId(vrc_id), Interval(Interval::Timepoint::min(), stationary_until),
        vrc_collision_id, stationary_action_id, change));
    trajectories_.emplace(std::make_pair(volley::VrcId(vrc_id), std::move(traj)));
  }

  // Tray trajectories are only for placed trays
  // TODO (mark): maybe should always have a trajectory, however when doing collision checks in
  // CHUGG we will only focus on the stationary intervals
  // (agv trajectories will catch moving tray collisions)
  for(const auto& [tray_id, tray] : initial_state.GetTrays()) {
    if(tray.agv_id == 0) {
      auto tray_collision_id = volley::CollisionEntityIdFromTrayState(tray, initial_state, layout);
      Trajectory traj;
      // Infinite wait
      traj.AddMotion(Motion(volley::TrayId(tray_id), Interval(Interval::Timepoint::min(), stationary_until),
          tray_collision_id, stationary_action_id, tray.pose));
      trajectories_.emplace(std::make_pair(volley::TrayId(tray_id), std::move(traj)));
    }
  }

  // TODO (mark): payloads are implicitly represented by collision id in motions for tray
  // trajectories but there is no specific payload id attached. Collision checking in CHUGG
  // doesn't care about payload id so this doesn't really matter but is it weird to not specify
  // them here at all?
}

std::optional<volley::DiscreteGarageState> ContinuousState::GetEndState() const {
  volley::DiscreteGarageState end_state;
  end_state.Set(initial_state_);

  struct EndSorter {
    bool operator()(const Motion& a, const Motion& b) const {
      return a.GetInterval().GetTimes().second < b.GetInterval().GetTimes().second;
    }
  };

  std::set<Motion, EndSorter> all_motions;

  // Need to sort all motions by end time before applying
  // so that they can all apply properly. If these fail then
  // that means the trajectories are invalid for the given
  // initial state.
  for(const auto& [entity_id, traj] : trajectories_) {
    for(const auto& motion : traj) {
      auto event = motion.GetDelta();
      // Ignore wait trajectories
      if(event) {
        all_motions.insert(motion);
      }
    }
  }

  for(const auto& motion : all_motions) {
    // Motions may contain non-delta states like idling, don't apply these
    if(motion.IsIdle()) {
      continue;
    }
    auto event = motion.GetDelta().value();
    auto [success, msg] = end_state.OnEvent(event);
    if(!success) {
      std::cout << "Failed to apply event: " << msg << std::endl;
      return std::nullopt;
    }
  }

  return end_state;
}

std::vector<std::pair<Motion, Motion>> ContinuousState::CheckCollisions() const {
  return ContinuousState::CheckCollisions(trajectories_, table_);
}

bool ContinuousState::CheckMotionCollision(
    const Motion& left, const Motion& right, const volley::CollisionTable& table) {
  // Motions not overlapping in time do not collide
  if(left.GetInterval().StrictlyBefore(right.GetInterval()) ||
      right.GetInterval().StrictlyBefore(left.GetInterval())) {
    return false;
  }

  const auto& left_ent = left.GetEntityId();
  const auto& right_ent = right.GetEntityId();

  // Vexen don't collide with anything for now :thonk:
  if(left_ent.entity_type == "v" || right_ent.entity_type == "v") {
    return false;
  }

  // Bays don't collide with each other
  if(left_ent.entity_type == "b" && right_ent.entity_type == "b") {
    return false;
  }

  // Bays in ReadyToRetrieve don't collide
  if(BayIsReadyToRetrieve(left) || BayIsReadyToRetrieve(right)) {
    return false;
  }

  const auto& left_loc = left.GetLocation();
  const auto& right_loc = right.GetLocation();
  auto left_cid = left.GetCollisionId();
  auto right_cid = right.GetCollisionId();

  LayoutSPtr layout = table.GetGraph().GetLayout();

  // TODO (mark): these if elses are repetitive and could be simplified
  if(left_ent.entity_type == "b" && (right_ent.entity_type == "a" || right_ent.entity_type == "t")) {
    // Get correct bay heading/pose
    // TODO (mark): Very awkward we have to do this at all
    auto bay_head_opt = layout->GetBayInboundHeading(left_ent.id);
    if(!bay_head_opt) {
      throw std::invalid_argument("Bay does not have an inbound heading defined by layout.");
    }
    Motion::Pose bay_pose;
    bay_pose.node_id = left_ent.id;
    bay_pose.heading = static_cast<int16_t>(bay_head_opt.value());

    // TODO (mark): HACK, this should not be necessary, query seems to think tray in bay
    // collides with ODP, this is a bug in collision table I think
    if(right_ent.entity_type == "t") {
      auto tray_pose = std::get<Motion::Pose>(right_loc);
      if(tray_pose.node_id == bay_pose.node_id) {
        return false;
      }
    }

    // Bay is fixed resource in query checks
    return std::visit(
        [table, left_cid, right_cid, &bay_pose](
            auto&& other_loc) -> bool { return table.Query(left_cid, right_cid, bay_pose, other_loc); },
        right_loc);
  }
  else if(right_ent.entity_type == "b" && (left_ent.entity_type == "a" || left_ent.entity_type == "t")) {
    auto bay_head_opt = layout->GetBayInboundHeading(right_ent.id);
    if(!bay_head_opt) {
      throw std::invalid_argument("Bay does not have an inbound heading defined by layout.");
    }
    Motion::Pose bay_pose;
    bay_pose.node_id = right_ent.id;
    bay_pose.heading = static_cast<int16_t>(bay_head_opt.value());

    // TODO (mark): HACK, this should not be necessary, query seems to think tray in bay
    // collides with ODP, this is a bug in collision table I think
    if(left_ent.entity_type == "t") {
      auto tray_pose = std::get<Motion::Pose>(left_loc);
      if(tray_pose.node_id == bay_pose.node_id) {
        return false;
      }
    }

    return std::visit(
        [table, left_cid, right_cid, &bay_pose](
            auto&& other_loc) -> bool { return table.Query(right_cid, left_cid, bay_pose, other_loc); },
        left_loc);
  }
  else if(left_ent.entity_type == "t" && right_ent.entity_type == "a") {
    // tray resource is TRAY_LEGS if agv is free
    if(right_cid == common::EnumInteger(volley::CollisionEntityId::AGV)) {
      left_cid = common::EnumInteger(volley::CollisionEntityId::TRAY_LEGS);
    }
    return std::visit(
        [table, left_cid, right_cid](auto&& tray_loc, auto&& agv_loc) -> bool {
          return table.Query(left_cid, right_cid, tray_loc, agv_loc);
        },
        left_loc, right_loc);
  }
  else if(left_ent.entity_type == "a" && right_ent.entity_type == "t") {
    // tray resource is TRAY_LEGS if agv is free
    if(left_cid == common::EnumInteger(volley::CollisionEntityId::AGV)) {
      right_cid = common::EnumInteger(volley::CollisionEntityId::TRAY_LEGS);
    }
    return std::visit(
        [table, left_cid, right_cid](auto&& agv_loc, auto&& tray_loc) -> bool {
          return table.Query(left_cid, right_cid, agv_loc, tray_loc);
        },
        left_loc, right_loc);
  }
  else {
    // Both AGV or both TRAY
    return std::visit(
        [table, left_cid, right_cid](auto&& left_location, auto&& right_location) -> bool {
          return table.Query(left_cid, right_cid, left_location, right_location);
        },
        left_loc, right_loc);
  }

  return false;
}

std::vector<std::pair<Motion, Motion>> ContinuousState::CheckCollisions(
    const TrajectoryMap& trajectories, const volley::CollisionTable& table) {
  std::vector<std::pair<Motion, Motion>> conflicts;

  for(auto current = trajectories.begin(); current != trajectories.end(); current++) {
    for(auto other = std::next(current); other != trajectories.end(); other++) {
      for(const auto& current_motion : current->second) {
        for(const auto& other_motion : other->second) {
          bool collides = CheckMotionCollision(current_motion, other_motion, table);

          if(collides) {
            conflicts.emplace_back(std::make_pair(current_motion, other_motion));
          }
        }
      }
    }
  }
  return conflicts;
}

bool ContinuousState::BayIsReadyToRetrieve(const Motion& motion) {
  if(motion.GetEntityId().entity_type != "b") {
    return false;
  }

  auto garage_event_opt = motion.GetDelta();
  if(!garage_event_opt) {
    throw std::invalid_argument("Bay Motion does not contain a discrete garage event");
  }
  auto bay_change_opt = volley::Deserialize<BayStateChangedMsg>(garage_event_opt.value());
  if(!bay_change_opt) {
    throw std::invalid_argument("Unable to deserialize delta to BayStateChanged");
  }

  return (bay_change_opt.value().state_curr == BayReportMsg::STATE_READY_TO_RETRIEVE &&
          bay_change_opt.value().state_next == BayReportMsg::STATE_READY_TO_RETRIEVE);
}

}  // namespace volley
