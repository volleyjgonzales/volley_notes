#include "motion_planner/safe_interval_table.hpp"

#include "common/enum.hpp"

namespace volley {

template <>
const SafeIntervalTable::IntervalTableMap<volley::GarageGraph::Vertex>&
SafeIntervalTable::GetIntervalMapConst<volley::GarageGraph::Vertex>() const {
  return vertex_intervals_;
}
template <>
const SafeIntervalTable::IntervalTableMap<volley::GarageGraph::Edge>&
SafeIntervalTable::GetIntervalMapConst<volley::GarageGraph::Edge>() const {
  return edge_intervals_;
}

template <>
SafeIntervalTable::IntervalTableMap<volley::GarageGraph::Vertex>&
SafeIntervalTable::GetIntervalMap<volley::GarageGraph::Vertex>() {
  return vertex_intervals_;
}
template <>
SafeIntervalTable::IntervalTableMap<volley::GarageGraph::Edge>&
SafeIntervalTable::GetIntervalMap<volley::GarageGraph::Edge>() {
  return edge_intervals_;
}

std::string SafeIntervalTableString(const volley::SafeIntervalTable& sit, const volley::GarageGraph& gg) {
  std::string out = "";
  out += "Vertex intervals:\n";
  for(const auto& [key, interval_set] : sit.GetIntervalMapConst<volley::GarageGraph::Vertex>()) {
    out += "Collision entity " + volley::ResourceName(*(gg.GetLayout()), key.first);
    auto pose_opt = gg.GetPoseFromVertex(key.second);
    std::string pose_str = (pose_opt.has_value() ? std::to_string(pose_opt.value())
                                                 : " does not exist! ID: " + std::to_string(key.second));
    out += " at vertex " + pose_str;
    out += "\nsafe intervals:\n";
    for(const auto& interval : interval_set) {
      out += std::to_string(interval) + "\n";
    }
  }
  out += "\nEdge intervals:\n";
  for(const auto& [key, interval_set] : sit.GetIntervalMapConst<volley::GarageGraph::Edge>()) {
    out += "Collision entity " + volley::ResourceName(*(gg.GetLayout()), key.first);
    auto edge_source_opt = gg.GetPoseFromVertex(key.second.m_source);
    auto edge_target_opt = gg.GetPoseFromVertex(key.second.m_target);
    std::string edge_source_str =
        (edge_source_opt.has_value() ? std::to_string(edge_source_opt.value())
                                     : " does not exist! ID: " + std::to_string(key.second.m_source));
    std::string edge_target_str =
        (edge_target_opt.has_value() ? std::to_string(edge_target_opt.value())
                                     : " does not exist! ID: " + std::to_string(key.second.m_target));
    out += " at edge " + edge_source_str + " -> " + edge_target_str;
    out += "\nsafe intervals:\n";
    for(const auto& interval : interval_set) {
      out += std::to_string(interval) + "\n";
    }
  }
  return out;
};

}  // namespace volley

namespace std {

// NOLINTNEXTLINE(readability-identifier-naming)
std::string to_string(const volley::SafeIntervalTable& sit) {
  std::string out = "";
  out += "Vertex intervals:\n";
  for(const auto& [key, interval_set] : sit.GetIntervalMapConst<volley::GarageGraph::Vertex>()) {
    out += "Collision entity id" + std::to_string(key.first);
    out += " at vertex " + std::to_string(key.second);
    out += "\nsafe intervals:\n";
    for(const auto& interval : interval_set) {
      out += std::to_string(interval) + "\n";
    }
  }
  out += "\nEdge intervals:\n";
  for(const auto& [key, interval_set] : sit.GetIntervalMapConst<volley::GarageGraph::Edge>()) {
    out += "Collision entity id" + std::to_string(key.first);
    out += " at edge " + std::to_string(key.second.m_source) + " -> " + std::to_string(key.second.m_target);
    out += "\nsafe intervals:\n";
    for(const auto& interval : interval_set) {
      out += std::to_string(interval) + "\n";
    }
  }
  return out;
};

}  // namespace std
