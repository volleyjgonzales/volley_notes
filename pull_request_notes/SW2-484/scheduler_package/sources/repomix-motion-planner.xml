<file path="include/motion_planner/trajectory.hpp">
#pragma once
#include <common/types.hpp>
#include <common/utils.hpp>
#include <common_ros/collision_geometry.hpp>
#include <common_ros/ros_utils.hpp>
#include <motion_planner/interval.hpp>
#include <motion_planner/motion_planner_msgs.hpp>
#include <set>
#include <variant>

namespace volley {

// Pairs a time interval with a location, a collision body and a single discrete state change or
// a wait
class Motion {
public:
  // Use from Collision table / common source when merged.
  using Pose = GaragePoseMsg;
  using Edge = std::array<GaragePoseMsg, 2>;
  using CollisionEntityId_t = volley::CollisionEntityId_t;

  // TODO(Gunther): Unified collision id
  // Non-action motion. Can wait on a pose but not an edge.
  Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id, size_t action_id,
      Pose location) :
      entity_id_(entity_id),
      interval_(interval),
      collision_id_(collision_id),
      action_id_(action_id),
      location_(location),
      is_idle_(true) { };

  Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id, size_t action_id,
      Edge location);
  Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id, size_t action_id,
      AgvPoseChangedMsg delta);
  Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id, size_t action_id,
      AgvLiftChangedMsg delta, Pose location);
  Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id, size_t action_id,
      BayStateChangedMsg delta);
  Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id, size_t action_id,
      VecsStateChangedMsg delta);
  Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id, size_t action_id,
      VrcStateChangedMsg delta);

  const std::variant<Pose, Edge>& GetLocation() const { return location_; }

  const std::optional<DiscreteGarageEventMsg>& GetDelta() const { return delta_; }

  // true if motion represents idling in a state
  bool IsIdle() const { return is_idle_; }

  // Motions are sorted by start, but can overlap across different trajectories
  bool operator<(const Motion& other) const { return interval_.Before(other.GetInterval()); }
  const Interval& GetInterval() const { return interval_; }

  //
  bool operator==(const Motion& other) const {
    return entity_id_ == other.entity_id_ && interval_ == other.interval_ &&
           collision_id_ == other.collision_id_ && action_id_ == other.action_id_ && delta_ == other.delta_ &&
           location_ == other.location_;
  }

  const GarageEntityIdMsg& GetEntityId() const { return entity_id_; }
  CollisionEntityId_t GetCollisionId() const { return collision_id_; }
  size_t GetActionId() const { return action_id_; }

  // Returns a copy of this Motion with its interval replaced. Used by
  // CoalesceTrajectory to rewrite per-edge timing without re-deriving the
  // (already serialized) delta from a typed message.
  Motion WithInterval(const Interval& new_interval) const {
    Motion copy = *this;
    copy.interval_ = new_interval;
    return copy;
  }

  // Returns location_ if location_ is pose, otherwise returns edge target pose
  const Pose& GetTargetPose() const {
    if(std::holds_alternative<Edge>(location_)) {
      return std::get<Edge>(location_)[1];
    }
    return std::get<Pose>(location_);
  }

  // Returns location_ if location_ is pose, otherwise returns edge target pose
  const Pose& GetSourcePose() const {
    if(std::holds_alternative<Edge>(location_)) {
      return std::get<Edge>(location_)[0];
    }
    return std::get<Pose>(location_);
  }

private:
  GarageEntityIdMsg entity_id_;
  Interval interval_;
  CollisionEntityId_t collision_id_;
  size_t action_id_;
  std::optional<DiscreteGarageEventMsg> delta_;
  std::variant<Pose, Edge> location_;
  bool is_idle_;
};

class Trajectory {
public:
  // TODO(Gunther): Default to infinite interval
  Trajectory() = default;

  using Iterator = typename std::set<Motion>::iterator;
  using ConstIterator = typename std::set<Motion>::const_iterator;
  // Returns false if motion fails to be added
  bool AddMotion(const Motion& motion);

  bool RemoveMotion(const Motion& motion);

  bool RemoveMotion(Iterator motion_it) {
    trajectory_.erase(motion_it);
    return true;
  }

  std::set<Motion> FindInInterval(const Interval& interval);
  // Is remove needed?
  std::set<Motion> RemoveInInterval(const Interval& interval);
  std::optional<Interval> GetInterval() const;

  // Range based for loop directly gives motions
  // NOLINTNEXTLINE(readability-identifier-naming)
  Iterator begin() { return trajectory_.begin(); }
  // NOLINTNEXTLINE(readability-identifier-naming)
  ConstIterator begin() const { return trajectory_.cbegin(); }
  // NOLINTNEXTLINE(readability-identifier-naming)
  Iterator end() { return trajectory_.end(); }
  // NOLINTNEXTLINE(readability-identifier-naming)
  ConstIterator end() const { return trajectory_.cend(); }

  // TODO(Gunther): Get rid of these eventually
  // NOLINTNEXTLINE(readability-identifier-naming)
  typename std::set<Motion>::reverse_iterator rbegin() { return trajectory_.rbegin(); }
  // NOLINTNEXTLINE(readability-identifier-naming)
  typename std::set<Motion>::const_reverse_iterator rbegin() const { return trajectory_.crbegin(); }
  // NOLINTNEXTLINE(readability-identifier-naming)
  typename std::set<Motion>::reverse_iterator rend() { return trajectory_.rend(); }
  // NOLINTNEXTLINE(readability-identifier-naming)
  typename std::set<Motion>::const_reverse_iterator rend() const { return trajectory_.crend(); }

private:
  std::set<Motion> trajectory_;
};

struct PoseHasher {
  size_t operator()(const Motion::Pose& pose) { return volley::HashCombine(pose.node_id, pose.heading); }
};

struct EdgeHasher {
  size_t operator()(const Motion::Edge& edge) {
    PoseHasher p_hasher;
    return volley::HashCombine(p_hasher(edge[0]), p_hasher(edge[1]));
  }
};

PoseHasher CreateHasher(const Motion::Pose&);
EdgeHasher CreateHasher(const Motion::Edge&);

struct MotionHasher {
  size_t operator()(const Motion& motion) const {
    size_t result = 0ul;
    volley::GarageEntityIdHasher entity_hash;
    auto [start, end] = motion.GetInterval().GetTimes();
    result = volley::HashCombine(result, entity_hash(motion.GetEntityId()));
    result = volley::HashCombine(result, start.time_since_epoch().count());
    result = volley::HashCombine(result, end.time_since_epoch().count());
    result = volley::HashCombine(result, motion.GetCollisionId());
    result = volley::HashCombine(result, motion.GetActionId());

    auto delta_opt = motion.GetDelta();
    if(delta_opt) {
      volley::DiscreteGarageEventHasher hasher;
      result = volley::HashCombine(result, hasher(delta_opt.value()));
    }

    result = volley::HashCombine(result, std::visit(
                                             [](auto&& loc) -> size_t {
                                               auto hasher = CreateHasher(loc);
                                               return hasher(loc);
                                             },
                                             motion.GetLocation()));

    return result;
  }
};

}  // namespace volley

