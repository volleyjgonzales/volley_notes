<file path="include/motion_planner/blocking_tray_search.hpp">
#pragma once

#include <common_ros/collision_geometry.hpp>
#include <common_ros/discrete_garage_state.hpp>
#include <common_ros/garage_graph.hpp>
#include <common_ros/layout.hpp>
#include <common_ros/pose_utils.hpp>
#include <cost_functions/motion_cost_model.hpp>
#include <motion_planner/interval.hpp>
#include <optional>
#include <vector>

#include "motion_planner/path_search.hpp"
#include "motion_planner/static_graph_filtering.hpp"

namespace volley {

struct BlockingTrayState {
  volley::GarageGraph::Vertex vert {};
  std::set<uint16_t> blocking_trays;

  bool operator==(const BlockingTrayState& other) const { return vert == other.vert; }
};

// Finds a min path to a vertex (or all vertices) in the graph with
// the least amount of blocking trays. Optionally limits the number of blocking trays
// so that we can abort early if there is no solution with less than max_blocking_trays
//
// Assumes that all edges or poses can be traversed, and relies on the filters to
// avoid disabled poses or edges either because they are disabled in the base
// state, overlap with trays we don't want to consider blocking or don't fit
// the collision id of the searched entity.
class BlockingTraySearchEnvironment : public SearchEnvironment<BlockingTrayState, Interval::Duration> {
public:
  BlockingTraySearchEnvironment(uint16_t tray_id,  // This is the tray we are trying to move.
      size_t collision_id, const volley::GarageGraph& graph, const volley::CollisionTable& table,
      const volley::DiscreteGarageState& base_state, const cost::MotionCostModel& cost_model,
      const std::optional<volley::GarageGraph::Vertex>& target = std::nullopt,
      std::optional<GraphFilterProperties> filters = std::nullopt,
      std::optional<size_t> max_blocking_trays = std::nullopt) :
      tray_id_(tray_id),
      collision_id_(collision_id),
      graph_(graph),
      table_(table),
      base_state_(base_state),
      cost_model_(cost_model),
      target_(target),
      filters_(filters),
      max_blocking_trays_(max_blocking_trays) { }

  ~BlockingTraySearchEnvironment() override = default;
  BlockingTraySearchEnvironment(const BlockingTraySearchEnvironment&) = delete;
  BlockingTraySearchEnvironment& operator=(const BlockingTraySearchEnvironment&) = delete;
  BlockingTraySearchEnvironment& operator=(BlockingTraySearchEnvironment&&) = delete;
  BlockingTraySearchEnvironment(BlockingTraySearchEnvironment&&) = delete;

  bool OnExpansion(const BlockingTrayState& state, const Interval::Duration&, const SearchMetaData&) override;

  std::vector<std::pair<BlockingTrayState, Interval::Duration>> GetNeighbors(
      const BlockingTrayState& state) override;

  Interval::Duration GetHeuristic(const BlockingTrayState&) override {
    // TODO(Gunther): Use the layout to get the euclidian distance to the target.
    return Interval::Duration::zero();
  }

  void OnDiscovery(const BlockingTrayState&, const Interval::Duration&) override { }
  void OnUpdate(const BlockingTrayState&, const Interval::Duration&, const Interval::Duration&) override { }

protected:
  size_t GetCollisionId() const { return collision_id_; }
  const volley::GarageGraph& GetGraph() const { return graph_; }
  const volley::CollisionTable& GetTable() const { return table_; }
  const volley::DiscreteGarageState& GetBaseState() const { return base_state_; }
  const cost::MotionCostModel& GetCostModel() const { return cost_model_; }

private:
  uint16_t tray_id_;
  size_t collision_id_;

  const volley::GarageGraph& graph_;
  const volley::CollisionTable& table_;
  const volley::DiscreteGarageState& base_state_;
  const cost::MotionCostModel& cost_model_;
  std::optional<volley::GarageGraph::Vertex> target_;
  std::optional<GraphFilterProperties> filters_;
  std::optional<size_t> max_blocking_trays_;
};

// Runs a (currently heuristic-less) search to find an open space in the garage to move a tray to.
// The search will try to find a path to the open space with the least amount of blocking trays.
// Using the same GetNeighbors function as BlockingTraySearchEnvironment, but with a different
// OnExpansion function to accept any valid open space.
class OpenSpaceSearchEnvironment : public BlockingTraySearchEnvironment {
public:
  OpenSpaceSearchEnvironment(uint16_t tray_id,  // This is the tray we are trying to move.
      size_t collision_id, const volley::GarageGraph& graph, const volley::CollisionTable& table,
      const volley::DiscreteGarageState& base_state, const cost::MotionCostModel& cost_model,
      const VertexCollisionIdMap& illegal_poses = {},
      std::optional<GraphFilterProperties> filters = std::nullopt,
      std::optional<size_t> max_blocking_trays = std::nullopt, bool enforce_retrieval_heading = false,
      bool allow_waypoint_stash = false);

  bool OnExpansion(const BlockingTrayState& state, const Interval::Duration&, const SearchMetaData&) override;

  Interval::Duration GetHeuristic(const BlockingTrayState&) override {
    // Zero heuristic, so we run a breadth-first search. We don't have basis to bias
    // the open spaced search in any particular direction at this point.
    return Interval::Duration::zero();
  }

  bool GetChargePayload() const { return ev_charge_payload_; }

private:
  VertexCollisionIdMap illegal_poses_;

  // Indicates that we are trying to find a parking spot for a "EV charge requested" payload.
  // We will use this flag in OnExpansion(...) to check for an available VECS
  bool ev_charge_payload_ = false;

  // Whether this search should enforce that a solution for the tray pose should have a heading that matches
  // the desired retrieval orientation
  bool enforce_retrieval_heading_ = false;
  // Whether the angle of the payload is the reciprocal of the tray angle
  bool payload_reciprocal_to_tray_ = false;
  // Height of the payload being placed. 0 = "no height constraint" (sentinel).
  float payload_height_m_ = 0.0f;
  // When true, also accept TYPE_WAYPOINT nodes as valid open-space targets, so that a tray
  // can be temporarily stashed on a transit-lane node when no parking is reachable. The
  // caller is responsible for planning a subsequent move from the waypoint to a real parking
  // node so the tray does not permanently occupy a transit lane.
  bool allow_waypoint_stash_ = false;
};

// Searches from the starting pose and tries to find an empty tray which can be moved
// to the starting pose with the least amount of blocking trays.
class EmptyTraySearchEnvironment : public BlockingTraySearchEnvironment {
public:
  EmptyTraySearchEnvironment(const volley::GarageGraph& graph, const volley::CollisionTable& table,
      const volley::DiscreteGarageState& base_state, const cost::MotionCostModel& cost_model,
      std::optional<GraphFilterProperties> filters = std::nullopt,
      std::optional<size_t> max_blocking_trays = std::nullopt) :
      BlockingTraySearchEnvironment(0u, common::EnumInteger(volley::CollisionEntityId::TRAY), graph, table,
          base_state, cost_model, std::nullopt, filters, max_blocking_trays) { }

  bool OnExpansion(const BlockingTrayState& state, const Interval::Duration&, const SearchMetaData&) override;

  Interval::Duration GetHeuristic(const BlockingTrayState&) override { return Interval::Duration::zero(); }
};

}  // namespace volley

template <>
struct std::hash<volley::BlockingTrayState> {
  std::size_t operator()(const volley::BlockingTrayState& state) const {
    // Don't hash blocking trays for now, so we can collapse the nodes in the search.
    // We have no preferences for which blocking tray to move at this point
    return std::hash<volley::GarageGraph::Vertex>()(state.vert);
  }
};
</file>

<file path="include/motion_planner/chugg.hpp">
#pragma once
#include <common/types.hpp>
#include <cost_functions/motion_cost_model.hpp>
#include <rclcpp/rclcpp.hpp>

#include "common_ros/collision_geometry.hpp"
#include "common_ros/discrete_garage_state_utils.hpp"
#include "motion_planner/continuous_state.hpp"
#include "motion_planner/garage_graph_pathing.hpp"
#include "motion_planner/sipp_agv.hpp"
#include "motion_planner/static_graph_filtering.hpp"
#include "planner_core/event_dag.hpp"

namespace volley {

// CHUGG (Constrained Huge Unknown Graph alGorithm) uses conflict-based search
// to deconflict agents and their motions. The low-level motion planner it uses,
// SIPP (Safe Interval Path Planning), keeps track of the when locations are
// free or not free by computing and updating safe time intervals.
class Chugg {
  using CollisionTable = volley::CollisionTable;
  using DiscreteGarageState = volley::DiscreteGarageState;
  using GarageGraph = volley::GarageGraph;
  using EdgeCosts = volley::GarageGraph::EdgeVectorPropertyMap<Interval::Duration>;
  using CollisionId = volley::CollisionEntityId_t;
  using ScheduleEventDag = volley::ScheduleEventDag;
  using GraphConstraints = std::unordered_map<volley::CollisionEntityId_t, GraphFilterProperties>;
  using ScheduleEvent = volley::ScheduleEvent;
  using EventType = volley::ScheduleEventType;

public:
  // TODO (mark): Simplify inputs with schedule context object
  Chugg(const GarageGraph& graph, const CollisionTable& geometry, const ScheduleEventDag& event_dag,
      const ContinuousState& initial_trajectories,
      const GarageGraph::EdgeVectorPropertyMap<Interval::Duration>& edge_costs,
      const SippEnvironment::HeuristicMap& heuristics, const cost::MotionCostModel& cost_model,
      rclcpp::Logger logger = rclcpp::get_logger(""));

  // Solve trajectories.
  // If `audit` is non-null, per-event cost contributions (graph-edge motions, bay door / VECS /
  // VRC carriage events, lift events) are pushed into it with descriptive labels.
  std::optional<ContinuousState> SolveSequential(cost::CostVector* audit = nullptr);
  std::optional<ContinuousState> SolveCbs();

private:
  const GarageGraph& graph_;
  const CollisionTable& geometry_;
  const ScheduleEventDag& event_dag_;
  const ContinuousState& init_traj_;
  const EdgeCosts& edge_costs_;
  const SippEnvironment::HeuristicMap& heuristics_;
  const cost::MotionCostModel& cost_model_;

  rclcpp::Logger logger_;

  // Optional audit sink set for the duration of a SolveSequential call. nullptr means no audit.
  cost::CostVector* audit_ = nullptr;

  // Topological order of the event dag
  std::vector<ScheduleEventDag::Vertex> event_order_;

  // Graph filter properties for every collision entity type
  // Used as 'static' constraints for avoiding non-moving entities.
  // NOTE: maybe we could/should combine GraphConstraints/SafeIntervalTable into one object
  GraphConstraints constraints_;

  // Earliest time of new planned information
  Interval::Timepoint planning_start_;

  // All entities that have new events targeting them, these entities will have updated
  // trajectories in the output ContinuousState
  std::unordered_set<GarageEntityIdMsg, volley::GarageEntityIdHasher> dynamic_entities_;

  // TODO (mark): Aggregate Low level planner (Sipp) Meta data
  // # of calls to SIPP
  // total node expansions in SIPP
  // total time spent in low-level planning

  // TODO (mark): CBS related states

  // Node id counter (CBS)
  size_t next_node_id_ = 0;

  // Metadata for search (CBS)
  size_t n_nodes_pushed_ = 0;

  // TODO (mark): aggregated low-level (Sipp) meta data

  // Plans events from event dag using a combination of SippAgv
  // and application of events to state
  // bool PlanNode(Node& plan_me, Node& parent);

  // TODO (mark): Node is really for CBS, but it is used in the sequential planning
  // functions because it was convenient at the time (initialization is 99% the same as CBS)
  struct Node {
    // Trajectories for dynamic part of continuous state (only moving elements)
    ContinuousState::TrajectoryMap trajectories;
    // Agv constraint/goal state handlers
    std::unordered_map<int, SippAgv> planners;

    // Primary cost values
    // Last moving time in all trajectories
    Interval::Timepoint makespan = Interval::Timepoint::min();
    // Sum of moving durations of all agvs
    Interval::Duration flowtime = Interval::Duration(0);

    // TODO (mark): Secondary cost values
    // Duration gap between this node and parents
    //    this.flowtime - parent.flowtime (or makespan)
    // Interval::Duration cost_gap;
    // Heuristic estimate of collision overlap to fix
    //    parent.collisions_to_go - resolved_collision duration
    // Interval::Duration collisions_to_go;

    // Unique id for this node, Chugg generates these sequentially
    size_t node_id = 0;

    Node() = default;

    // Copies agv goals/landmarks/constraints, everything else default
    Node(const Node& parent, size_t node_id) : planners(parent.planners), node_id(node_id) {
      for(const auto& [ent, traj] : parent.trajectories) {
        trajectories[ent] = Trajectory();
      }
    }

    Node(const Node& other) = default;
    ~Node() = default;

    Node& operator=(const Node&) = delete;
    Node(Node&&) = default;
    Node& operator=(Node&&) = default;

    bool operator==(const Node& other) const { return node_id == other.node_id; }
  };

  // ~~~~~~~~~~~~~~~~~~~~ Sequential Planning Methods ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  // Sequential planning functions
  // Agv move and pickup/dropoff
  bool PlanEventSequential(Node& node, ScheduleEventDag::Vertex event_id,
      std::shared_ptr<volley::AgvMove> agv_event, const DiscreteGarageState& working_state);

  // Agv move while carrying tray
  bool PlanEventSequential(Node& node, ScheduleEventDag::Vertex event_id,
      std::shared_ptr<volley::TrayMove> tray_event, const DiscreteGarageState& working_state);

  // Bay commands
  bool PlanEventSequential(Node& node, ScheduleEventDag::Vertex event_id,
      std::shared_ptr<volley::BayTransition> bay_event, const DiscreteGarageState& working_state);

  // VECS commands
  bool PlanEventSequential(Node& node, ScheduleEventDag::Vertex event_id,
      std::shared_ptr<volley::VecsTransition> vecs_event, const DiscreteGarageState& working_state);

  // VRC commands
  bool PlanEventSequential(Node& node, ScheduleEventDag::Vertex event_id,
      std::shared_ptr<volley::VrcTransition> vrc_event, const DiscreteGarageState& working_state);

  // Plans all new events
  bool PlanNodeSequential(Node& node);

  // Updates current set of safe intervals to include sequential planning assumption
  // that entities are fixed at their current ending location
  // Returns copy of original safe intervals before assumed constraints were added
  SafeIntervalTable SetEventSafeIntervals(
      Node& node, const DiscreteGarageState& working_state, uint16_t event_agv, uint16_t event_tray);

  // ~~~~~~~~~~~~~~~~~~~~~~~~ CBS Planning Methods ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  // Node structure for CBS
  // Priority queue sorters
  // TODO (mark): use parent-cost-gap tiebreaker rather than flowtime/makespan tiebreaker
  // TODO (mark): focal queue comparitor(s) based on estimated remaining collision duration
  struct NodeFlowtimeComparitor {
    bool operator()(const Node& a, const Node& b) {
      if(a.flowtime == b.flowtime) {
        return a.makespan < b.makespan;
      }
      return a.flowtime < b.flowtime;
    }
  };

  struct NodeMakespanComparitor {
    bool operator()(const Node& a, const Node& b) {
      if(a.makespan == b.makespan) {
        return a.flowtime < b.flowtime;
      }
      return a.makespan < b.makespan;
    }
  };

  // Branches parent and proposes resolution(s) to collision
  std::vector<Node> ResolveCollisions(Node& parent, std::vector<std::pair<Motion, Motion>> collisions);

  // Resolves agv-agv type collision, returns branching disjoint split resolution nodes
  std::vector<Node> ResolveAgvAgvCollision(Node& parent, std::pair<Motion, Motion> collision);

  // Copies agv planner data (constraints & goal defs) and increments next node id
  Node BranchNode(Node& parent);

  // TODO (science): Corridor Symmetry enhancement
  // Checks if collision is in a narrow corridor ("corridor-type symmetrical conflict")
  // bool IsCorridorCollision(Node& parent, std::pair<Motion, Motion> collision);

  // Finds the entrance and exit points to the corridor for both agents
  //  nullopt if only one teriminal exists ("target-type symmetrical conflict")
  // using CorridorTerminals = std::pair<std::optional<Motion>, std::optional<Motion>>;
  // std::pair<CorridorTerminals, CorridorTerminals> GetCorridorTerminals
  //      (Node& parent, std::pair<Motion, Motion> collision)

  // Resolves corridor collision by constraining one agent to not enter
  // the corridor until the other agent exits. (disjoint split type rule)
  // std::vector<Node> ResolveCorridorCollision(Node& parent, std::pair<CorridorTerminals,
  // CorridorTerminals> corridor_collision)

  // ~~~~~~~~~~~~~~~~~~~~~ Common Methods & Utilities ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  // Initializes node data structure with all parameters that are needed to solve
  // new events. (For both CBS and Sequential)
  Node MakeRootNode();

  // Get a copy of static constraints
  // TODO (mark): This function should live with GraphFilterProperties and
  // static filtering functions
  GraphConstraints GetStaticConstraintsCopy();

  // Helper function for adding pose constraints to static constraint set
  // to deconflict an entity with entity type my_id with an entity
  // with type avoid_id sitting at avoid_pose
  void AddStaticPoseConstraints(GraphConstraints& g_constraints, CollisionId my_id, CollisionId avoid_id,
      const Motion::Pose& avoid_pose);

  // Deconflict all other agvs with this motion
  void DeconflictAgvs(Node& node, const Motion& deconflict);

  // Current time for a given entity. Returns last timepoint in new part of trajectory
  // stored in node, or the initial planning time
  Interval::Timepoint EntityCurrentTime(Node& node, const GarageEntityIdMsg& ent);

  // Gets dependency completion time for an event from node trajectories
  Interval::Timepoint GetDependencyCompletionTime(Node& node, ScheduleEventDag::Vertex event_id);

  // Dag helper functions, should probably live elsewhere
  GarageEntityIdMsg GetEventEntity(std::shared_ptr<ScheduleEvent> event);

  // Returns ContinuousState updated with node trajectories
  ContinuousState GetUpdatedContinuousState(const Node& node);

  // check basic solvability of event dag and stores topological event order
  void InitializeEventOrder();

  // Determines planning start time, dynamic & moving entities, and initial static constraints
  // also resets any stats tracking
  void SolveInitialization();

  // Used in SolveInitialization for determining entities that move during new plan
  std::unordered_set<uint16_t> GetMovableAgvs();
  Interval::Timepoint GetEarliestAgvStart(std::unordered_set<uint16_t> moving_agvs);
  std::unordered_set<uint16_t> GetTraysMovingAfter(const Interval::Timepoint& after);
  std::unordered_set<uint16_t> GetBaysMovingAfter(const Interval::Timepoint& after);
  std::unordered_set<uint16_t> GetVexenMovingAfter(const Interval::Timepoint& after);
};

}  // namespace volley
</file>

<file path="include/motion_planner/coalesce_trajectory.hpp">
#pragma once

#include <common_ros/garage_graph.hpp>
#include <cost_functions/motion_cost_model.hpp>
#include <motion_planner/trajectory.hpp>

namespace volley {

// Walks a Trajectory and rebuilds it so that runs of consecutive abutting,
// codirectional / same-rotation Edge motions occupy a single coalesced
// trapezoid in time. Per-edge Motions are kept (so collision deconfliction
// at intermediate nodes stays correct) but each Motion's interval is a
// sub-slice of the run's continuous trapezoid via TimeAtDistance.
//
// Invariants preserved:
//   - Motion identity (entity, collision id, action id, location, delta) is
//     unchanged.
//   - Motion ordering and the count of Motions are unchanged.
//   - Original gaps between motions (e.g. SIPP wheel-turn shifts) are
//     preserved verbatim.
//   - Idle / lift / non-Edge motions pass through untouched, but later
//     motions are re-anchored to absorb the time saved by run coalescing.
Trajectory CoalesceTrajectory(const Trajectory& trajectory, const GarageGraph& graph,
    const cost::MotionCostModel& cost_model, bool is_agv_loaded = false);

}  // namespace volley
</file>

<file path="include/motion_planner/continuous_state.hpp">
#pragma once
#include <common/types.hpp>
#include <common_ros/collision_geometry.hpp>
#include <common_ros/discrete_garage_state.hpp>
#include <common_ros/discrete_garage_state_utils.hpp>
#include <common_ros/ros_utils.hpp>
#include <interfaces/msg/garage_entity_id.hpp>
#include <motion_planner/trajectory.hpp>

namespace volley {
class ContinuousState {
public:
  using TrajectoryMap = std::unordered_map<GarageEntityIdMsg, Trajectory, volley::GarageEntityIdHasher>;

  ContinuousState(const volley::DiscreteGarageState& initial_state, const volley::CollisionTable& table,
      const volley::Layout& layout, std::optional<Interval::Timepoint> now_time = std::nullopt);

  void SetTrajectory(const GarageEntityIdMsg& entity_id, Trajectory traj) {
    trajectories_[entity_id] = std::move(traj);
  }

  const TrajectoryMap& GetTrajectories() const { return trajectories_; }

  // TODO (mark):  manipulate trajectories in object.
  TrajectoryMap& GetTrajectoryMap() { return trajectories_; }

  const volley::DiscreteGarageState& GetInitialState() const { return initial_state_; }

  std::optional<volley::DiscreteGarageState> GetEndState() const;

  // Checks for any collisions in trajectories_
  std::vector<std::pair<Motion, Motion>> CheckCollisions() const;

  // Checks all motions in trajectory map for collisions
  static std::vector<std::pair<Motion, Motion>> CheckCollisions(
      const TrajectoryMap&, const volley::CollisionTable&);

  // Checks if two motions collide
  static bool CheckMotionCollision(
      const Motion& left, const Motion& right, const volley::CollisionTable& table);

  // Checks if Motion corresponds to a bay that is idling in ready to retrieve
  // The ODP doesn't collide with anything in this state
  static bool BayIsReadyToRetrieve(const Motion& motion);

private:
  TrajectoryMap trajectories_;
  volley::DiscreteGarageState initial_state_;
