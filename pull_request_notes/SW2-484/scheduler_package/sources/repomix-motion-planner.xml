#include "motion_planner/trajectory.hpp"

// For to_string, move that somewhere more common
#include <common_ros/collision_geometry.hpp>
#include <common_ros/discrete_garage_event_io.hpp>

namespace volley {

Motion::Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id,
    size_t action_id, AgvPoseChangedMsg delta) :
    entity_id_(entity_id),
    interval_(interval),
    collision_id_(collision_id),
    action_id_(action_id),
    delta_(volley::Serialize(delta)),
    is_idle_(false) {
  if(delta.node_id_curr == delta.node_id_next && delta.heading_curr == delta.heading_next) {
    throw std::runtime_error("AgvPoseChanged delta must have different poses");
  }
  else {
    Edge edge {volley::ConstructGaragePose(delta.node_id_curr, delta.heading_curr),
        volley::ConstructGaragePose(delta.node_id_next, delta.heading_next)};
    location_ = edge;
  }
}

Motion::Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id,
    size_t action_id, Edge edge) :
    entity_id_(entity_id),
    interval_(interval),
    collision_id_(collision_id),
    action_id_(action_id),
    location_(edge),
    is_idle_(false) {
  if(edge[0].node_id == edge[1].node_id && edge[0].heading == edge[1].heading) {
    throw std::runtime_error("Edge source and target poses must be different");
  }

  AgvPoseChangedMsg pose_change;
  pose_change.agv_id = entity_id.id;
  pose_change.node_id_curr = edge[0].node_id;
  pose_change.heading_curr = edge[0].heading;
  pose_change.node_id_next = edge[1].node_id;
  pose_change.heading_next = edge[1].heading;

  delta_ = volley::Serialize(pose_change);
}

Motion::Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id,
    size_t action_id, AgvLiftChangedMsg delta, Pose location) :
    entity_id_(entity_id),
    interval_(interval),
    collision_id_(collision_id),
    action_id_(action_id),
    delta_(volley::Serialize(delta)),
    location_(location),
    is_idle_(false) {
}

Motion::Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id,
    size_t action_id, BayStateChangedMsg delta) :
    entity_id_(entity_id),
    interval_(interval),
    collision_id_(collision_id),
    action_id_(action_id),
    delta_(volley::Serialize(delta)),
    is_idle_(delta.state_next == delta.state_curr) {
  Pose bay_pose;
  bay_pose.node_id = delta.bay_id;
  // bay_pose.heading = 90;
  // Heading doesn't matter for bay for now
  // TODO(Gunther): Use a different object w/ door state as part of collision
  // table optimization refactor.
  location_ = bay_pose;
}

Motion::Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id,
    size_t action_id, VecsStateChangedMsg delta) :
    entity_id_(entity_id),
    interval_(interval),
    collision_id_(collision_id),
    action_id_(action_id),
    delta_(volley::Serialize(delta)),
    is_idle_(delta.state_next == delta.state_curr) {
  Pose vecs_pose;
  vecs_pose.node_id = delta.vecs_id;
  // Heading doesn't matter for now
  location_ = vecs_pose;
}

Motion::Motion(GarageEntityIdMsg entity_id, Interval interval, CollisionEntityId_t collision_id,
    size_t action_id, VrcStateChangedMsg delta) :
    entity_id_(entity_id),
    interval_(interval),
    collision_id_(collision_id),
    action_id_(action_id),
    delta_(volley::Serialize(delta)),
    is_idle_(delta.next_discrete_state.state.value == delta.current_discrete_state.state.value &&
             delta.next_discrete_state.current_floor == delta.current_discrete_state.current_floor) {
  Pose vrc_pose;
  vrc_pose.node_id = delta.current_discrete_state.id;
  // Heading doesn't matter for VRC
  location_ = vrc_pose;
}

std::optional<Interval> Trajectory::GetInterval() const {
  if(trajectory_.empty()) {
    return std::nullopt;
  }

  auto start = trajectory_.begin()->GetInterval().GetTimes().first;
  auto end = trajectory_.rbegin()->GetInterval().GetTimes().second;
  return Interval(start, end);
}

bool Trajectory::AddMotion(const Motion& motion) {
  if(trajectory_.empty()) {
    trajectory_.insert(motion);
    return true;
  }
  // First motion which starts after motion.
  auto it = trajectory_.lower_bound(motion);
  if(it == trajectory_.end()) {
    it--;
    if(it->GetInterval().StrictlyBefore(motion.GetInterval())) {
      // Insert into end
      trajectory_.insert(trajectory_.end(), motion);
      return true;
    }
    else {
      return false;
    }
  }
  else if(motion.GetInterval().StrictlyBefore(it->GetInterval())) {
    if(it != trajectory_.begin()) {
      it--;
      if(!it->GetInterval().StrictlyBefore(motion.GetInterval())) {
        // If the prior overlaps with the new interval, reject.
        return false;
      }
    }
    trajectory_.insert(motion);
    return true;
  }
  else {
    return false;
  }
}

bool Trajectory::RemoveMotion(const Motion& motion) {
  return trajectory_.erase(motion);
}

std::set<Motion> Trajectory::FindInInterval(const Interval& interval) {
  std::set<Motion> found;
  // first occurrence of an interval overlapping or after interval
  auto it = std::find_if(trajectory_.begin(), trajectory_.end(),
      [interval](const Motion& m) { return !m.GetInterval().StrictlyBefore(interval); });
  // Return all motions overlapping with said interval.
  while(it != trajectory_.end() && !interval.StrictlyBefore(it->GetInterval())) {
    found.insert(*it);
    it++;
  }
  return found;
}

std::set<Motion> Trajectory::RemoveInInterval(const Interval& interval) {
  std::set<Motion> removed = FindInInterval(interval);
  for(const auto& m : removed) {
    RemoveMotion(m);
  }
  return removed;
}

PoseHasher CreateHasher(const Motion::Pose&) {
  return {};
}
EdgeHasher CreateHasher(const Motion::Edge&) {
  return {};
}

}  // namespace volley

namespace std {

// NOLINTNEXTLINE(readability-identifier-naming)
std::string to_string(const volley::Motion& motion) {
  std::string result = "Motion(";
  auto loc_string =
      std::visit([](auto&& loc) -> std::string { return std::to_string(loc); }, motion.GetLocation());

  result += "entity_id: ";
  result += std::to_string(motion.GetEntityId());
  result += ", location ";
  result += loc_string;
  result += ", during ";
  result += std::to_string(motion.GetInterval());
  result += ", action_id: ";
  result += std::to_string(motion.GetActionId());
  result += ", collision_id: ";
  result += std::to_string(motion.GetCollisionId());
  result += ")";
  return result;
}
}  // namespace std
