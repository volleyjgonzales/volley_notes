#include <planner_core/schedule_events.hpp>
#include <stdexcept>
#include <variant>

namespace volley {

// SippAgv is an interface for SIPP to compute trajectories for a sequence of AGV events
// It can be used stand-alone but includes trajectory-initialization logic to be used in CHUGG

// May be better to define a simpler AgvEvents struct that contains events and constraints
// for a single agv and have a Trajectory = PlanAgvTrajectory(Context, AgvEvents) func

class SippAgv {
public:
  using CollisionEntityId_t = volley::CollisionEntityId_t;
  using GarageGraph = volley::GarageGraph;
  using CollisionTable = volley::CollisionTable;
  using ScheduleEvent = volley::ScheduleEvent;
  using GraphConstraints = std::unordered_map<CollisionEntityId_t, GraphFilterProperties>;
  using SippSolution = SearchSolution<SippState, Interval::Duration, std::hash<SippState>>;

  // This requires trajectory planning graph, geometry, costs, heutristics
  // and specific agv initial_state, initial_time. motion_params (Ring 3b) drives the
  // path-dependent edge costing inside SippEnvironment.
  SippAgv(const GarageGraph& graph, const CollisionTable& geometry,
      const GarageGraph::EdgeVectorPropertyMap<Interval::Duration>& edge_costs,
      const SippEnvironment::HeuristicMap& heuristics, const DiscreteAgvStateMsg& initial_state,
      const Interval::Timepoint& initial_time,
      Interval::Duration wheel_turn_time = Interval::Duration::zero(),
      cost::MotionCostParams motion_params = cost::MotionCostParams {});

  SippAgv(const SippAgv& other) = default;

  SippAgv& operator=(const SippAgv&) = delete;
  SippAgv(SippAgv&&) = default;
  SippAgv& operator=(SippAgv&&) = default;

  ~SippAgv() = default;

  // Trajectory planning functions

  // Plans and returns trajectory for all events consistent with landmarks/constraints
  std::optional<Trajectory> PlanTrajectory(const GraphConstraints& constraints);

  // Plans trajectory for a subset of events.
  // plan_events should be a contiguous sub-sequence of events added by AddEventGoal
  // in a valid order. yes this is awkward
  std::optional<Trajectory> PlanEvents(std::vector<size_t> plan_events, const DiscreteAgvStateMsg& init_state,
      const Interval::Timepoint& init_time, const GraphConstraints& constraints);

  // TODO (mark): In Plan* functions above, check cached trajectory and only plan for required
  // goals
  //  Ex. if we have
  //  [landmark A]...[landmark B]...landmark[C]
  //     and cached traj is inconsistent w/ safe intervals between landmark A and B, then we only
  //     replan goals after landmark A up to and including landmark B, and the rest can be copied

  // Converts an event to a SippGoal
  // It is assumed the events are added in the order they should be accomplished
  void AddEventGoal(
      std::shared_ptr<const volley::AgvMove> event, size_t event_id, CollisionEntityId_t collision_id);

  void AddEventGoal(std::shared_ptr<const volley::TrayMove> event, size_t event_id,
      CollisionEntityId_t collision_id, bool agv_reciprocal);

  // Adds a landmark goal
  // in CHUGG, this motion is from this AGVs prior trajectory
  void AddLandmarkGoal(const Motion& motion);

  // Adds a constraint to disallow a particular motion
  // in CHUGG, the input motion is one of this AGVs prior motions (negative disjoint branch)
  void AddAvoidConstraint(const Motion& motion);

  // Adds all constraints to deconflict with particular motion
  // in CHUGG, the input motion is a different AGVs motion we want to avoid (positive disjoint
  // branch, that other agv has this motion as a landmark or initial fixed motion)
  void AddDeconflictConstraints(const Motion& motion);

  GarageEntityIdMsg GetEntityId() const { return volley::AgvId(initial_state_.id); }

  const Interval::Timepoint GetInitialTime() const { return initial_time_; }

  GaragePoseMsg GetInitialPose() const { return initial_state_.pose; }

  // Hacky getter setter for SIT used in sequential planning calls to PlanEvents
  const SafeIntervalTable& GetSafeIntervalTable() const { return sit_; }
  void SetSafeIntervalTable(SafeIntervalTable&& sit) { sit_ = sit; }

private:
  const GarageGraph& graph_;
  const CollisionTable& geometry_;
  const GarageGraph::EdgeVectorPropertyMap<Interval::Duration>& edge_costs_;
  const SippEnvironment::HeuristicMap& heuristics_;
  const DiscreteAgvStateMsg initial_state_;
  const Interval::Timepoint initial_time_;
  const Interval::Duration wheel_turn_time_;
  const cost::MotionCostParams motion_params_;

  SafeIntervalTable sit_;

  // TODO (mark): Refactor Event/Goal/Landmark goal tracking
  //       Should just generate SIPP goal on demand from sequence of events/landmark motions
  //       rather than converting and storing SIPP goals explicilty
  //       Currently just done this way to match python impl.
  std::vector<std::pair<SippGoal, size_t>> all_goals_;
  std::unordered_map<size_t, std::shared_ptr<const ScheduleEvent>> all_events_;

  // All collision entity ids this AGV uses for all events (used by AddDeconflictConstraints)
  std::set<CollisionEntityId_t> all_collision_ids_;

  // Helper funcs for adding constraints to sit from pose or pair of poses (motion pose/edge)
  void AddLocationConstraint(CollisionEntityId_t type,
      const std::variant<Motion::Pose, Motion::Edge>& location, const Interval& interval);

  // Convert sipp solution to trajectory format
  Trajectory SolutionToTrajectory(SippSolution& solution,
      std::unordered_map<size_t, std::shared_ptr<const ScheduleEvent>> all_events,
      std::vector<std::pair<SippGoal, size_t>> all_goals);

  // Helper func for constructing SippGoal from AgvMove discrete event
  SippGoal GoalFromDiscreteChange(const AgvLiftChangedMsg& change, CollisionEntityId_t collision_id);
  SippGoal GoalFromDiscreteChange(const AgvPoseChangedMsg& change, CollisionEntityId_t collision_id);
};
}  // namespace volley
