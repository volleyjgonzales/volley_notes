#include "motion_planner/agv_hiding_search.hpp"

using namespace std::chrono_literals;
namespace volley {

bool AgvSearchEnvironment::OnExpansion(
    const GaragePoseMsg& state, const Interval::Duration&, const SearchMetaData&) {
  // If the state matches a tray pose or reciprocal tray pose, add it to the valid destinations
  auto tray_opt = base_state_.GetTrayOnNode(state.node_id);
  if(tray_opt) {
    auto tray = tray_opt.value();
    if(volley::IsAngleOrReciprocal(tray.pose, state)) {
      valid_destinations_.emplace_back(state);
    }
  }
  // Always return false for now so search finds all possible spaces
  return false;
}

std::vector<std::pair<GaragePoseMsg, Interval::Duration>> AgvSearchEnvironment::GetNeighbors(
    const GaragePoseMsg& state) {
  std::vector<std::pair<GaragePoseMsg, Interval::Duration>> neighbors;
  auto state_vert = graph_.GetVertexFromPose(state).value();

  for(const auto& edge : boost::make_iterator_range(graph_.GetOutEdges(state_vert))) {
    auto next_vert = boost::target(edge, graph_.GetBaseGraph());
    auto next_pose = graph_.GetPoseFromVertex(next_vert).value();
    if(filters_.IsEnabled(edge) and filters_.IsEnabled(next_vert)) {
      if(graph_.GetTransition(edge)) {
        // auto cost  = edge_durations_[edge];
        // TODO(Gunther): Use graph edge costs somehow
        neighbors.emplace_back(std::make_pair(next_pose, 1s));
      }
    }
  }
  return neighbors;
}

Interval::Duration AgvSearchEnvironment::GetHeuristic(const GaragePoseMsg&) {
  return 0s;
}

// For Each AGV, find all possible desinations
// then in order of cost, apply the agv move, and do the same for each subsequent AGV
std::pair<bool, std::unordered_map<uint16_t, GaragePoseMsg>> HideOneAgv(
    const volley::DiscreteGarageState& base_state, const volley::CollisionTable& table,
    std::unordered_set<uint16_t> agvs_to_assign) {
  if(agvs_to_assign.empty()) {
    return {true, {}};
  }

  for(uint16_t agv_id : agvs_to_assign) {
    auto agv_state = base_state.GetAgv(agv_id).value();
    volley::CollisionEntityId_t agv_cid = common::EnumInteger(volley::CollisionEntityId::AGV);
    auto filter = GetStaticFilter(agv_cid, table.GetGraph(), base_state, table, {}, {agv_id}, {});

    AgvSearchEnvironment env(base_state, table.GetGraph(), filter);
    auto agv_pose = agv_state.pose;
    GaragePoseMsg start_state = agv_pose;

    // TODO(Gunther): "Fun" optimization is a version of SingleSourceSearch
    // which returns an iterator instead so you can run it until each valid
    // solution, and then only continue the search if the next agv hasn't a
    // valid solution.
    auto solution = volley::SingleSourceSearch(start_state, volley::Interval::Duration(0), env);
    for(const auto& dest : env.GetSortedDestinations()) {
      auto working_state = base_state;
      if(agv_pose != dest) {
        AgvPoseChangedMsg pose_change;
        pose_change.agv_id = agv_id;
        pose_change.node_id_curr = agv_pose.node_id;
        pose_change.heading_curr = agv_pose.heading;
        pose_change.node_id_next = dest.node_id;
        pose_change.heading_next = dest.heading;
        auto [applied, msg] = working_state.OnEvent(pose_change);
        if(!applied) {
          std::cerr << "Failed to apply pose change: " << msg << std::endl;
          continue;
        }
      }
      auto agvs_to_assign_next = agvs_to_assign;
      agvs_to_assign_next.erase(agv_id);

      auto [success, next_agv_destinations] = HideOneAgv(working_state, table, agvs_to_assign_next);
      if(success) {
        next_agv_destinations[agv_id] = dest;
        return {true, next_agv_destinations};
      }
    }
  }
  return {false, {}};
}

std::pair<bool, std::unordered_map<uint16_t, GaragePoseMsg>> HideAgvs(
    const volley::DiscreteGarageState& base_state, const volley::CollisionTable& table) {
  std::unordered_set<uint16_t> agvs_to_assign;
  for(const auto& agv : base_state.GetAgvs()) {
    if(agv.second.disabled) {
      continue;
    }
    agvs_to_assign.insert(agv.first);
  }
  return HideOneAgv(base_state, table, agvs_to_assign);
}

}  // namespace volley
</file>

<file path="src/blocking_tray_search.cpp">
#include "motion_planner/blocking_tray_search.hpp"

#include "common_ros/discrete_garage_state_utils.hpp"

using namespace std::chrono_literals;

namespace volley {

bool BlockingTraySearchEnvironment::OnExpansion(
    const BlockingTrayState& state, const Interval::Duration&, const SearchMetaData&) {
  // Expanding this node implies that we found its lowest cost, so we don't need
  // to check blocking trays
  if(target_) {
    return target_.value() == state.vert;
  }
  return false;
}

std::vector<std::pair<BlockingTrayState, Interval::Duration>> BlockingTraySearchEnvironment::GetNeighbors(
    const BlockingTrayState& state) {
  std::vector<std::pair<BlockingTrayState, Interval::Duration>> neighbors;

  for(auto [edge_iter, edge_end] = graph_.GetOutEdges(state.vert); edge_iter != edge_end; ++edge_iter) {
    auto edge = *edge_iter;

    // Filters should catch all cases where we can't move to the edge
    // due to disabled nodes or edges, occlusions from trays we don't want to move,
    // or due to poses not supporting our payload size
    if(filters_ && !filters_->IsEnabled(edge)) {
      continue;
    }

    auto transition = graph_.GetTransition(edge);
    if(transition) {
      BlockingTrayState neighbor;
      neighbor.vert = boost::target(edge, graph_.GetBaseGraph());
      neighbor.blocking_trays = state.blocking_trays;
      Interval::Duration cost =
          std::chrono::duration_cast<Interval::Duration>(cost_model_.Duration(transition.value()));

      // Check for conficts using the collision table
      // Find all trays which collide with the tray on the edge
      auto garage_edge = graph_.GetPosesFromEdge(edge).value();
      // We could be smarter about this and only check the trays that are near the edge
      // but also the lookups are constant time so it doesn't really matter.
      for(const auto& [tray_id, tray] : base_state_.GetTrays()) {
        if(tray_id == tray_id_) {
          continue;
        }
        volley::CollisionEntityId_t other_collision_id =
            volley::CollisionEntityIdFromTrayState(tray, base_state_, *(graph_.GetLayout()));
        if(table_.Query(other_collision_id, collision_id_, tray.pose, garage_edge)) {
          // If this is a new blocking tray, add it to the set and increase the cost
          if(neighbor.blocking_trays.insert(tray.id).second) {
            // TODO(Any): No more magic numbers, use real data to determine
            // at what point it makes more sense to repark vs route around
            cost += 30s;
          }
        }
      }

      if(!max_blocking_trays_ || neighbor.blocking_trays.size() <= max_blocking_trays_.value()) {
        neighbors.emplace_back(std::move(neighbor), cost);
      }
    }
  }
  return neighbors;
}

OpenSpaceSearchEnvironment::OpenSpaceSearchEnvironment(uint16_t tray_id, size_t collision_id,
    const volley::GarageGraph& graph, const volley::CollisionTable& table,
    const volley::DiscreteGarageState& base_state, const cost::MotionCostModel& cost_model,
    const VertexCollisionIdMap& illegal_poses, std::optional<GraphFilterProperties> filters,
    std::optional<size_t> max_blocking_trays, bool enforce_retrieval_heading, bool allow_waypoint_stash) :

    BlockingTraySearchEnvironment(tray_id, collision_id, graph, table, base_state, cost_model, std::nullopt,
        filters, max_blocking_trays),
    illegal_poses_(illegal_poses),
    allow_waypoint_stash_(allow_waypoint_stash) {
  // set ev_charge_payload_: figure out if tray_id is carrying a payload that needs charging
  auto tray_opt = base_state.GetTray(tray_id);
  if(!tray_opt.has_value()) {
    RCLCPP_ERROR(rclcpp::get_logger(""),
        "OpenSpaceSearchEnvironment::OpenSpaceSearchEnvironment tray_opt has no "
        "value. Is the tray_id in the garage state?");
    return;
  }

  auto payload_id = tray_opt.value().payload_id;
  if(payload_id == volley::kEmptyGuid) {
    return;  // the tray_id is not carrying anything
  }

  auto payload_opt = base_state.GetPayload(payload_id);
  if(!payload_opt.has_value()) {
    RCLCPP_ERROR(rclcpp::get_logger(""),
        "OpenSpaceSearchEnvironment::OpenSpaceSearchEnvironment  payload_opt has no "
        "value. Is the payload_id in the garage state?");
    return;
  }

  // Only update enforce of retrieval heading if there is a payload
  enforce_retrieval_heading_ = enforce_retrieval_heading;
  payload_reciprocal_to_tray_ = payload_opt->reciprocal_to_tray;
  payload_height_m_ = payload_opt->payload.height_m;

  if(payload_opt.value().payload.ev_charge_requested) {
    ev_charge_payload_ = true;
  }
}

bool OpenSpaceSearchEnvironment::OnExpansion(
    const BlockingTrayState& state, const Interval::Duration&, const SearchMetaData&) {
  // Check if pose is an open parking space that the tray fits in
  auto pose = GetGraph().GetPoseFromVertex(state.vert).value();
  auto node = GetGraph().GetLayout()->GetNodeById(pose.node_id).value();

  const bool is_parking_or_charge =
      node.type == GarageNodeMsg::TYPE_PARKING || node.type == GarageNodeMsg::TYPE_EV_CHARGE;
  const bool is_stashable_waypoint = allow_waypoint_stash_ && node.type == GarageNodeMsg::TYPE_WAYPOINT;
  if(!is_parking_or_charge && !is_stashable_waypoint) {
    //  Not an interesting node
    return false;
  }

  auto tray_opt = GetBaseState().GetTrayOnNode(pose.node_id);
  if(tray_opt) {
    // There is already a tray parked here
    return false;
  }

  // Check if we intersect ANY illegal poses.
  // Query Root Tray collision ID for illegal pose (using the set of illegal pose + collision id)
  // vs tray we're finding space for collision id @ pose. Don't need to worry about recip pose.

  // The reason this isn't filtered out, is that we allow moving the tray on a path through these
  // poses, just don't allow parking the tray here as a final destination.
  for(const auto& [ill_vert, ill_collisionid] : illegal_poses_) {
    auto ill_pose = GetGraph().GetPoseFromVertex(ill_vert).value();
    if(GetTable().Query(ill_collisionid, GetCollisionId(), ill_pose, pose)) {
      // While this neighbor is valid for us to move through, it intersects with a pose
      // we've deemed illegal for a final pose, so we need to keep searching from here.
      return false;
    }
  }

  // Only accept poses at the node's retrieval heading so destination selection accounts for
  // the full rotation path cost, not just the same-heading path.
  if(enforce_retrieval_heading_) {
    const auto retrieval_angle = GetGraph().GetRetrievalHeading(pose.node_id);
    if(retrieval_angle.has_value()) {
      int16_t rh = retrieval_angle.value();
      if(payload_reciprocal_to_tray_) {
        rh = volley::ReciprocalAngle(rh);
      }
      if(pose.heading != rh) {
        return false;
      }
    }
  }

  // If we're carrying an "EV charge requested" payload, check that this parking spot has
  // an available VECS. A waypoint stash is purely transient and never charges the payload,
  // so it bypasses this check; the follow-up repark search (parking-only) will route the
  // payload to a real EV charge spot.
  if(ev_charge_payload_ && !is_stashable_waypoint) {
    if(node.type != GarageNodeMsg::TYPE_EV_CHARGE) {
      // skip this spot, since this spot does not have a VECS
      return false;
    }

    if(pose.heading < 0 || pose.heading > 90) {
      // skip this spot, since this spot because we need the trayble to be facing the VECS
      return false;
    }
  }

  // Height check: a payload taller than the parking window's height envelope must not park here.
  // Sentinel 0 on either side means "no constraint."
  if(payload_height_m_ > 0.0f) {
    auto window = GetGraph().GetLayout()->GetResourceWindow(node.max_resource_size_index);
    if(window.has_value() && window->height_m > 0.0f && payload_height_m_ > window->height_m) {
      return false;
    }
  }

  // TODO(Gunther): Encode depth by quick and dirty checking if there is a neighbor that is also
  // valid and has a larger depth (distance from a waypoint node)
  return true;
}

bool EmptyTraySearchEnvironment::OnExpansion(
    const BlockingTrayState& state, const Interval::Duration&, const SearchMetaData&) {
  // Check if the current vertex has an empty tray
  auto tray_opt = GetBaseState().GetTrayOnNode(GetGraph().GetPoseFromVertex(state.vert).value().node_id);
  if(tray_opt && tray_opt->payload_id == volley::kEmptyGuid) {
    return true;
  }
  return false;
}

}  // namespace volley
</file>

<file path="src/chugg_cbs.cpp">
#include "motion_planner/chugg.hpp"

namespace volley {

std::optional<ContinuousState> Chugg::SolveCbs() {
  // Initialize static constraints and moving entity info
  SolveInitialization();

  // Initialize root node and agv planner info
  Node root = MakeRootNode();

  // Populate trajectories
  // TODO (mark): cbs plan node
  // PlanNode(root, root);

  bool feasible = PlanNodeSequential(root);

  if(!feasible) {
    return std::nullopt;
  }

  // Initialize search queue
  std::priority_queue<Node, std::vector<Node>, Chugg::NodeFlowtimeComparitor> queue;
  queue.push(root);

  while(queue.size() > 0) {
    Node next = queue.top();  // std::move
    queue.pop();

    // Check collisions
    auto collisions = ContinuousState::CheckCollisions(next.trajectories, geometry_);

    // Info print TODO (mark): Verbosity settings
    for(auto& [entity, new_traj] : next.trajectories) {
      INFOS(logger_, "~~~~~~~~~~ Updated " << std::to_string(entity) << " Trajectory Segment ~~~~~~~~~~");
      for(auto& motion : new_traj) {
        INFOS(logger_, "   " << std::to_string(motion));
      }
    }

    // Exit when done
    if(collisions.size() == 0) {
      return GetUpdatedContinuousState(next);
    }

    // For sequential planning the rest of this code should never hit
    // TODO (mark): remove this when cbs is done
    if(collisions.size() >= 1) {
      ERRORS(logger_, "Found collision between " << std::to_string(collisions[0].first) << "\n and \n"
                                                 << std::to_string(collisions[0].second));

      return std::nullopt;
    }

    // Propose Resolutions
    auto resolutions = ResolveCollisions(next, collisions);

    // Add resolutions to queue
    for(auto res : resolutions) {
      // Check if resolution was feasible before pushing
      queue.push(res);
      n_nodes_pushed_++;
    }
  }

  // We exhausted queue and did not find a solution
  return std::nullopt;
}

std::vector<Chugg::Node> Chugg::ResolveCollisions(
    Node& parent, std::vector<std::pair<Motion, Motion>> collisions) {
  // pick a collision to resolve
  // TODO (mark): collision selection heuristic
  auto resolve_me = collisions[0];

  // Agv-agv collision, disjoint splitting rule
  if(resolve_me.first.GetEntityId().entity_type == "a" &&
      resolve_me.second.GetEntityId().entity_type == "a") {
    return ResolveAgvAgvCollision(parent, resolve_me);
  }
  else {
    throw std::logic_error("TODO");
  }
  // TODO (mark): "b","a", "a",b' for bay collisions
  //   For now always resolve s.t. agv avoids bay door (no branching)
  // also "t", "a" and "a", "t"
  //   For now always resolve s.t. agv avoids placed tray (no branching)
  return {};
}

std::vector<Chugg::Node> Chugg::ResolveAgvAgvCollision(Node& parent, std::pair<Motion, Motion> collision) {
  // TODO (mark): Check if collision is part of a corridor collision set
  //              & do corridor collision rule

  // pick a positive agent for disjoint split
  // TODO (mark): positive agent selection heuristic and/or randomized selection
  auto positive_motion = collision.first;

  // Create resolutions
  Node positive = BranchNode(parent);
  Node negative = BranchNode(parent);

  // Positive resolution
  //  Landmark for positive agent, deconflict other agvs
  positive.planners.at(positive_motion.GetEntityId().id).AddLandmarkGoal(positive_motion);

  // For all other agvs add deconflict
  DeconflictAgvs(parent, positive_motion);

  // Negative resolution
  //  Avoid motion for positive agent
  negative.planners.at(positive_motion.GetEntityId().id).AddAvoidConstraint(positive_motion);

  // Plan trajectories & update costs
  // PlanNode(positive, parent);
  // PlanNode(negative, parent);

  return {positive, negative};
}

Chugg::Node Chugg::BranchNode(Node& parent) {
  // copy node agv planner data and set new node id
  Node branch(parent, next_node_id_);
  next_node_id_++;
  return branch;
}

}  // namespace volley
