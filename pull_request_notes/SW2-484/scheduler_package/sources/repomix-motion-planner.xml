<file path="src/chugg_common.cpp">
#include <queue>

#include "motion_planner/chugg.hpp"

namespace volley {

Chugg::Chugg(const GarageGraph& graph, const CollisionTable& geometry, const ScheduleEventDag& event_dag,
    const ContinuousState& initial_trajectories,
    const GarageGraph::EdgeVectorPropertyMap<Interval::Duration>& edge_costs,
    const SippEnvironment::HeuristicMap& heuristics, const cost::MotionCostModel& cost_model,
    rclcpp::Logger logger) :
    graph_(graph),
    geometry_(geometry),
    event_dag_(event_dag),
    init_traj_(initial_trajectories),
    edge_costs_(edge_costs),
    heuristics_(heuristics),
    cost_model_(cost_model),
    logger_(logger) {
  // Topo order of dag, also check that it can be reasoned with
  // NOLINTNEXTLINE
  InitializeEventOrder();
}

void Chugg::InitializeEventOrder() {
  // Get topological ordering
  // NOLINTNEXTLINE
  auto event_order_opt = event_dag_.GetTopologicalOrdering();
  if(!event_order_opt) {
    throw std::logic_error("Input event dag does not have a valid topological ordering");
  }
  event_order_ = event_order_opt.value();

  // Check that event dag is executable
  // TODO (mark): Some of these checks may have already been done elsewhere, this may not be
  // necessary at all
  // TODO (mark): Check that endpoints for all entities are deconflicted to test feasibility.
  auto working_state = init_traj_.GetEndState().value();
  for(auto event_id : event_order_) {
    // shared ptr to ScheduleEvent
    auto event = event_dag_.GetEventFromVertex(event_id).value();

    if(event->GetType() == EventType::AGV_MOVE) {
      auto agv_event = std::dynamic_pointer_cast<volley::AgvMove>(event);
      // if agv event is a moving event, check if it has a tray. Tray moves should only
      // be specified with TRAY_MOVE event.
      if(std::holds_alternative<AgvPoseChangedMsg>(agv_event->GetDiscreteChange())) {
        auto agv_state = working_state.GetAgv(agv_event->GetAgvId()).value();
        if(agv_state.tray_id != 0) {
          throw std::logic_error(
              "AGV_MOVE AgvPoseChanged occurs when agv has a tray, event "
              "should be an TRAY_MOVE ");
        }
      }
    }
    if(event->GetType() == EventType::TRAY_MOVE) {
      auto tray_event = std::dynamic_pointer_cast<volley::TrayMove>(event);
      auto tray_id_opt = tray_event->GetTrayId();
      if(!tray_id_opt) {
        throw std::logic_error("TRAY_MOVE event has no tray id specified");
      }

      auto agv_id_opt = tray_event->GetAgvId();
      if(!agv_id_opt) {
        throw std::logic_error("TRAY_MOVE event has no agv id specified");
      }

      auto dest_pose_opt = tray_event->GetDest();
      if(!dest_pose_opt) {
        throw std::logic_error("TRAY_MOVE event has no tray destination specified");
      }

      // check that agv and tray are collocated
      auto agv_state = working_state.GetAgv(agv_id_opt.value()).value();
      auto tray_state = working_state.GetTray(tray_id_opt.value()).value();
      if(agv_state.pose.node_id != tray_state.pose.node_id) {
        throw std::logic_error("Agv for TRAY_MOVE is not under tray");
      }
    }
    auto [success, msg] = event->Apply(working_state);
    if(!success) {
      throw std::logic_error("Could not apply event, trajectories are non-computable. Event msg: " + msg);
    }
  }
}

void Chugg::AddStaticPoseConstraints(GraphConstraints& event_constraints, CollisionId my_id,
    CollisionId avoid_id, const Motion::Pose& avoid_pose) {
  CollisionTable::PoseSet poses;
  CollisionTable::EdgeSet edges;

  std::tie(poses, edges) = geometry_.Query(avoid_id, my_id, avoid_pose);

  for(auto& avoid_pose : poses) {
    event_constraints[my_id].AddProperty(graph_.GetVertexFromPose(avoid_pose).value(), false);
  }
  for(auto& avoid_edge : edges) {
    event_constraints[my_id].AddProperty(
        graph_.GetEdgeFromPoses(avoid_edge[0], avoid_edge[1]).value(), false);
  }
}

Chugg::GraphConstraints Chugg::GetStaticConstraintsCopy() {
  GraphConstraints constraints_copy;

  for(const auto& id_constraints : constraints_) {
    auto v_filt = graph_.MakeVertexVectorPropertyMap<bool>();
    auto e_filt = graph_.MakeEdgeVectorPropertyMap<bool>();
    auto [vert_beg, vert_end] = graph_.GetVertices();
    for(auto it = vert_beg; it != vert_end; ++it) {
      v_filt[*it] = constraints_[id_constraints.first].IsEnabled(*it);
    }
    auto [edge_beg, edge_end] = graph_.GetEdges();
    for(auto it = edge_beg; it != edge_end; ++it) {
      e_filt[*it] = constraints_[id_constraints.first].IsEnabled(*it);
    }
    constraints_copy[id_constraints.first] = GraphFilterProperties(std::move(v_filt), std::move(e_filt));
  }
  return constraints_copy;
}

Interval::Timepoint Chugg::EntityCurrentTime(Node& node, const GarageEntityIdMsg& ent) {
  Interval::Timepoint init_time;
  auto init_interval_opt = node.trajectories.at(ent).GetInterval();
  if(!init_interval_opt) {
    // For first events there is no existing trajectory yet; initial time comes from
    // prior trajectory
    init_time = init_traj_.GetTrajectories().at(ent).GetInterval().value().GetEnd();
  }
  else {
    init_time = init_interval_opt.value().GetEnd();
  }
  return init_time;
}

void Chugg::DeconflictAgvs(Node& node, const Motion& deconflict) {
  auto deconflict_ent = deconflict.GetEntityId();
  for(auto& [agv_id, planner] : node.planners) {
    if(deconflict_ent.entity_type == "a" && deconflict_ent.id == agv_id) {
      // Don't deconflict an agv with itself
      continue;
    }
    planner.AddDeconflictConstraints(deconflict);
  }
}

GarageEntityIdMsg Chugg::GetEventEntity(std::shared_ptr<ScheduleEvent> event) {
  GarageEntityIdMsg entity;
  if(event->GetType() == EventType::AGV_MOVE) {
    auto agv_event = std::dynamic_pointer_cast<volley::AgvMove>(event);
    entity.entity_type = "a";
    entity.id = agv_event->GetAgvId();
  }
  else if(event->GetType() == EventType::TRAY_MOVE) {
    auto tray_event = std::dynamic_pointer_cast<volley::TrayMove>(event);
    entity.entity_type = "a";
    entity.id = tray_event->GetAgvId().value();
  }
  else if(event->GetType() == EventType::BAY_TRANSITION) {
    auto bay_event = std::dynamic_pointer_cast<volley::BayTransition>(event);
    entity.entity_type = "b";
    entity.id = bay_event->GetSourceState().id;
  }
  else if(event->GetType() == EventType::VECS_TRANSITION) {
    auto vecs_event = std::dynamic_pointer_cast<volley::VecsTransition>(event);
    entity.entity_type = "v";
    entity.id = vecs_event->GetVecsId();
  }
  else if(event->GetType() == EventType::VRC_TRANSITION) {
    auto vrc_event = std::dynamic_pointer_cast<volley::VrcTransition>(event);
    entity.entity_type = "r";
    entity.id = vrc_event->GetVrcId();
  }
  return entity;
}

Interval::Timepoint Chugg::GetDependencyCompletionTime(Node& node, ScheduleEventDag::Vertex event_id) {
  Interval::Timepoint all_dep_finished = Interval::Timepoint::min();

  auto [edge_begin, edge_end] = event_dag_.GetInEdges(event_id);

  auto event = event_dag_.GetEventFromVertex(event_id).value();
  auto event_entity = GetEventEntity(event);

  for(auto it = edge_begin; it != edge_end; ++it) {
    auto dep_id = it->m_source;
    auto dep_event = event_dag_.GetEventFromVertex(dep_id).value();

    GarageEntityIdMsg dep_entity = GetEventEntity(dep_event);

    // Get completion time of dependency
    // TODO (mark): GetEventInterval or something in Trajectory
    Interval::Timepoint dep_finished = Interval::Timepoint::max();

    for(auto& motion : node.trajectories[dep_entity]) {
      if(motion.GetActionId() == dep_id) {
        dep_finished = motion.GetInterval().GetEnd();
      }
    }

    if(dep_finished == Interval::Timepoint::max()) {
      throw std::logic_error("Dependency has no completion interval");
    }
    if(dep_finished > all_dep_finished) {
      all_dep_finished = dep_finished;
    }
  }
  return all_dep_finished;
}

Chugg::Node Chugg::MakeRootNode() {
  // root node
  Node root;

  // Initialize per-agv per-node 'SippAgv' planner
  auto work_state = init_traj_.GetEndState().value();
  for(const auto& entity : dynamic_entities_) {
    if(entity.entity_type != "a") {
      continue;
    }
    auto agv_state = work_state.GetAgv(entity.id).value();  // kinda getting sick of optional pattern
    const auto& agv_init_traj = init_traj_.GetTrajectories().at(entity);
    Interval::Timepoint agv_init_time = agv_init_traj.GetInterval().value().GetEnd();
    const auto wheel_turn = std::chrono::duration_cast<Interval::Duration>(
        cost::SecondsF(cost_model_.Params().events.agv_wheel_turn));
    root.planners.emplace(entity.id, SippAgv(graph_, geometry_, edge_costs_, heuristics_, agv_state,
                                         agv_init_time, wheel_turn, cost_model_.Params()));
  }

  // Set initial safe intervals for all agvs
  const auto& init_traj_map = init_traj_.GetTrajectories();
  for(const auto& [entity, traj] : init_traj_map) {
    // Every motion overlapping or after the earliest agv new start time
    // creates initial deconfliction constraints for all other agvs
    for(const auto& motion : traj) {
      if(motion.GetInterval().GetEnd() >= planning_start_) {
        DeconflictAgvs(root, motion);
      }
    }
    // If the bay/tray element is not dynamic (has no new events), create constraints to
    // deconflict with it in the future (it stays in place forever after it stops moving in
    // init_traj_)
    if(dynamic_entities_.find(entity) == dynamic_entities_.end()) {
      if(entity.entity_type == "b") {
        auto bay_state = work_state.GetBay(entity.id).value();
        auto bay_end_time = init_traj_map.at(entity).GetInterval().value().GetEnd();
        // Only need to add constraint if bay is closed
        if(bay_state.state != BayReportMsg::STATE_READY_TO_RETRIEVE) {
          // Constructing a motion to use for deconfliction
          // the actual delta and action id is unused here
          BayStateChangedMsg delta;
          delta.bay_id = entity.id;
          delta.state_curr = bay_state.state;
          delta.state_next = BayReportMsg::STATE_READY_TO_INSERT;
          Motion bay_door_is_closed(entity, Interval(bay_end_time, Interval::Timepoint::max()),
              common::EnumInteger(volley::CollisionEntityId::BAY_ODP), 99999, delta);
          // Deconflict all agvs
          DeconflictAgvs(root, bay_door_is_closed);
        }
      }
      else if(entity.entity_type == "t") {
        // Construct stationary motion to deconflict with
        // auto tray_state = work_state.GetTray(entity.id).value();
        auto tray_end_time = init_traj_map.at(entity).GetInterval().value().GetEnd();
        auto tray_coll_id = init_traj_map.at(entity).rbegin()->GetCollisionId();
        auto tray_pose = init_traj_map.at(entity).rbegin()->GetTargetPose();
        Motion tray_just_hangin_out(
            entity, Interval(tray_end_time, Interval::Timepoint::max()), tray_coll_id, 99999, tray_pose);
        // Deconflict all agvs
        DeconflictAgvs(root, tray_just_hangin_out);
      }
      else if(entity.entity_type == "v") {
        // idk if I need anything here
      }
    }
  }

  // Initialize base sequence of sipp goals for all agvs
  for(auto& event_id : event_order_) {
    auto event = event_dag_.GetEventFromVertex(event_id).value();
    if(event->GetType() == EventType::AGV_MOVE) {
      auto agv_event = std::dynamic_pointer_cast<volley::AgvMove>(event);
      auto agv_id = agv_event->GetAgvId();
      auto agv_state = work_state.GetAgv(agv_id).value();
      auto collision_id = volley::CollisionEntityIdFromAgvState(agv_state, work_state, *(graph_.GetLayout()));

      // if lifting event always use corresponding tray collision id
      if(std::holds_alternative<AgvLiftChangedMsg>(agv_event->GetDiscreteChange())) {
        // auto lift_change = std::get<AgvLiftChangedMsg>(agv_event->GetDiscreteChange());
        // Get tray at this position
        auto tray_state_opt = work_state.GetTrayOnNode(agv_state.pose.node_id);
        // Shouldn't ever happen
        if(!tray_state_opt) {
          throw std::logic_error("AGV lift change without tray on the same node as AGV");
        }
        collision_id =
            volley::CollisionEntityIdFromTrayState(tray_state_opt.value(), work_state, *(graph_.GetLayout()));
      }

      root.planners.at(agv_id).AddEventGoal(agv_event, event_id, collision_id);
    }
    else if(event->GetType() == EventType::TRAY_MOVE) {
      auto tray_event = std::dynamic_pointer_cast<volley::TrayMove>(event);
      auto tray_id = tray_event->GetTrayId().value();
      auto agv_id = tray_event->GetAgvId().value();

      auto tray_state = work_state.GetTray(tray_id).value();

      auto collision_id =
          volley::CollisionEntityIdFromTrayState(tray_state, work_state, *(graph_.GetLayout()));

      auto agv_src_pose = work_state.GetAgv(agv_id).value().pose;
      auto tray_src_pose = work_state.GetTray(tray_id).value().pose;

      bool recip = volley::IsReciprocal(agv_src_pose.heading, tray_src_pose.heading);

      root.planners.at(agv_id).AddEventGoal(tray_event, event_id, collision_id, recip);
    }
    else if(event->GetType() == EventType::BAY_TRANSITION) {
      auto bay_event = std::dynamic_pointer_cast<volley::BayTransition>(event);
    }
    event->Apply(work_state);
  }

  // Initialize node trajectory map for all dynamic entities
  //  TODO (Any): potential refactor: trajectories are initialized with the last motion in
  //  the initial trajectory so we don't have to check working state if no new motions have
  //  occurred
  for(auto& ent : dynamic_entities_) {
    root.trajectories.emplace(ent, Trajectory());
  }

  return root;
}

ContinuousState Chugg::GetUpdatedContinuousState(const Node& node) {
  ContinuousState updated_trajs(init_traj_);
  auto& updated_traj_map = updated_trajs.GetTrajectoryMap();
  for(auto& [entity, new_traj] : node.trajectories) {
    for(auto& motion : new_traj) {
      updated_traj_map[entity].AddMotion(motion);
    }
  }
  return updated_trajs;
}

void Chugg::SolveInitialization() {
  next_node_id_ = 0;

  // TODO (mark): initialize stats tracking

  // All agvs that can move
  auto movable_agvs = GetMovableAgvs();
  // Earliest time a movable agv might start moving again
  planning_start_ = GetEarliestAgvStart(movable_agvs);
  // All trays that move after planning start
  auto moving_trays = GetTraysMovingAfter(planning_start_);
  // All bays that move after planning start
  // TODO (mark): add bay logic to static constraints
  auto moving_bays = GetBaysMovingAfter(planning_start_);
  // TODO ( not mark): add VECS logic to static constraints
  auto moving_vecs = GetVexenMovingAfter(planning_start_);

  // Make static constraints graph filter objects
  DiscreteGarageState work_state = init_traj_.GetEndState().value();
  // TODO(Joe) add VECS state code here if the hardware ever takes up real space. Or just to be
  // extra safe
  constraints_ = GetAllStaticFilters(graph_, work_state, geometry_, moving_trays, movable_agvs, moving_bays);
  dynamic_entities_.clear();

  // All movable agvs are considered dynamic regardless if there is an event specifically
  // targeting them
  for(int agv_id : movable_agvs) {
    dynamic_entities_.insert(volley::AgvId(agv_id));
  }

  // Iterate over event dag to find all bays/trays that are dynamic
  //   TODO (mark): prob don't have to actually evolve working state since all info
  //                we need is explicitly stated in events
  auto working_state = init_traj_.GetEndState().value();
  for(auto& event_id : event_order_) {
    auto event = event_dag_.GetEventFromVertex(event_id).value();
    if(event->GetType() == EventType::TRAY_MOVE) {
      auto tray_event = std::dynamic_pointer_cast<volley::TrayMove>(event);
      dynamic_entities_.insert(volley::TrayId(tray_event->GetTrayId().value()));
    }
    else if(event->GetType() == EventType::BAY_TRANSITION) {
      auto bay_event = std::dynamic_pointer_cast<volley::BayTransition>(event);
      dynamic_entities_.insert(volley::BayId(bay_event->GetBayId()));
    }
    else if(event->GetType() == EventType::VECS_TRANSITION) {
      auto vecs_event = std::dynamic_pointer_cast<volley::VecsTransition>(event);
      dynamic_entities_.insert(volley::VecsId(vecs_event->GetVecsId()));
    }
    else if(event->GetType() == EventType::VRC_TRANSITION) {
      auto vrc_event = std::dynamic_pointer_cast<volley::VrcTransition>(event);
      dynamic_entities_.insert(volley::VrcId(vrc_event->GetVrcId()));
    }
    event->Apply(working_state);
  }
}

std::unordered_set<uint16_t> Chugg::GetMovableAgvs() {
  // All non-disabled AGVs are considered moving/movable
  DiscreteGarageState working_state = init_traj_.GetEndState().value();
  std::unordered_set<uint16_t> moving_agvs;
  for(const auto& [agv_id, agv_init_state] : working_state.GetAgvs()) {
    if(!agv_init_state.disabled) {
      moving_agvs.insert(agv_id);
    }
  }
  return moving_agvs;
}

Interval::Timepoint Chugg::GetEarliestAgvStart(std::unordered_set<uint16_t> moving_agvs) {
  // Earliest start-time of all controllable elements
  // Used to set initial safe intervals for start of this chugg session
  Interval::Timepoint plan_start(Interval::Timepoint::max());
  for(const auto& [entity, traj] : init_traj_.GetTrajectories()) {
    if(entity.entity_type != "a") {
      continue;
    }
    if(moving_agvs.find(entity.id) == moving_agvs.end()) {
      // prob not be required if disabled agvs have inf duration trajectory
      continue;
    }
    if(traj.GetInterval().value().GetEnd() < plan_start) {
      plan_start = traj.GetInterval().value().GetEnd();
    }
  }
  return plan_start;
}

std::unordered_set<uint16_t> Chugg::GetBaysMovingAfter(const Interval::Timepoint& after) {
  std::unordered_set<uint16_t> moving_bays;

  // All bays that have motions after start time
  for(const auto& [entity, traj] : init_traj_.GetTrajectories()) {
    if(entity.entity_type != "b") {
      continue;
    }
    for(const auto& motion : traj) {
      if(motion.GetInterval().GetEnd() > after) {
        moving_bays.insert(entity.id);
        break;
      }
    }
  }

  // All bays that have an event
  for(auto event_id : event_order_) {
    // shared ptr to ScheduleEvent
    auto event = event_dag_.GetEventFromVertex(event_id).value();
    if(event->GetType() == EventType::BAY_TRANSITION) {
      auto bay_event = std::dynamic_pointer_cast<volley::BayTransition>(event);
      moving_bays.insert(bay_event->GetSourceState().id);
    }
  }

  return moving_bays;
}

std::unordered_set<uint16_t> Chugg::GetTraysMovingAfter(const Interval::Timepoint& after) {
  // All trays that move after given time
  std::unordered_set<uint16_t> moving_trays;
  for(const auto& [entity, traj] : init_traj_.GetTrajectories()) {
    if(entity.entity_type != "t") {
      continue;
    }
    for(const auto& motion : traj) {
      if(motion.GetInterval().GetEnd() > after) {
        moving_trays.insert(entity.id);
      }
    }
  }

  // All trays that have a new event targeting them
  // this includes AGV lifting events
  DiscreteGarageState working_state = init_traj_.GetEndState().value();
  for(auto event_id : event_order_) {
    auto event = event_dag_.GetEventFromVertex(event_id).value();
    if(event->GetType() == EventType::AGV_MOVE) {
      auto agv_event = std::dynamic_pointer_cast<volley::AgvMove>(event);
      auto agv_state = working_state.GetAgv(agv_event->GetAgvId()).value();
      if(agv_state.tray_id != 0) {
        moving_trays.insert(agv_state.tray_id);
      }
    }
    else if(event->GetType() == EventType::TRAY_MOVE) {
      auto tray_event = std::dynamic_pointer_cast<volley::TrayMove>(event);
      moving_trays.insert(tray_event->GetTrayId().value());
    }
    event->Apply(working_state);
  }
  return moving_trays;
}

std::unordered_set<uint16_t> Chugg::GetVexenMovingAfter(const Interval::Timepoint& after) {
  // All Vexen that move after given time
  std::unordered_set<uint16_t> moving_vexen;
  for(const auto& [entity, traj] : init_traj_.GetTrajectories()) {
    if(entity.entity_type != "v") {
      continue;
    }
    for(const auto& motion : traj) {
      if(motion.GetInterval().GetEnd() > after) {
        moving_vexen.insert(entity.id);
      }
    }
  }

  // All Vexen that have a new event targeting them
  DiscreteGarageState working_state = init_traj_.GetEndState().value();
  for(auto event_id : event_order_) {
    auto event = event_dag_.GetEventFromVertex(event_id).value();
    if(event->GetType() == EventType::VECS_TRANSITION) {
      auto vecs_event = std::dynamic_pointer_cast<volley::VecsTransition>(event);
      moving_vexen.insert(vecs_event->GetVecsId());
    }
    event->Apply(working_state);
  }
  return moving_vexen;
}

