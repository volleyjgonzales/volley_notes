#include <cmath>

#include "motion_planner/chugg.hpp"

namespace volley {

std::optional<ContinuousState> Chugg::SolveSequential(cost::CostVector* audit) {
  audit_ = audit;
  struct AuditScope {
    cost::CostVector** slot;
    ~AuditScope() { *slot = nullptr; }
  } audit_scope {&audit_};

  // Initialize static constraints and moving entity info
  SolveInitialization();

  // Sequential planning root node uses same node structure as CBS
  Node solution_node = MakeRootNode();

  INFOS(logger_, "CHUGG: Solving with sequential planning (not CBS)");

  bool feasible = PlanNodeSequential(solution_node);

  if(!feasible) {
    return std::nullopt;
  }

  // Info print new parts of trajectories
  for(auto& [entity, new_traj] : solution_node.trajectories) {
    INFOS(logger_, "~~~~~~~~~~ Updated " << std::to_string(entity) << " Trajectory Segment ~~~~~~~~~~");
    for(auto& motion : new_traj) {
      INFOS(logger_, "   " << std::to_string(motion));
    }
  }

  // Sanity check for collisions
  auto collisions = ContinuousState::CheckCollisions(solution_node.trajectories, geometry_);

  if(collisions.size() >= 1) {
    ERRORS(logger_, "Proposed solution node contains collision: " << std::to_string(collisions[0].first)
                                                                  << "\n and \n"
                                                                  << std::to_string(collisions[0].second));
    return std::nullopt;
  }

  return GetUpdatedContinuousState(solution_node);
}

bool Chugg::PlanNodeSequential(Node& node) {
  // Plan events in topological order
  auto working_state = init_traj_.GetEndState().value();
  for(auto& event_id : event_order_) {
    auto event = event_dag_.GetEventFromVertex(event_id).value();
    bool plan_success = true;
    if(event->GetType() == EventType::AGV_MOVE) {
      // Plan AGV move event
      auto agv_event = std::dynamic_pointer_cast<volley::AgvMove>(event);
      plan_success = PlanEventSequential(node, event_id, agv_event, working_state);
    }
    else if(event->GetType() == EventType::TRAY_MOVE) {
      // Plan Tray move event
      auto tray_event = std::dynamic_pointer_cast<volley::TrayMove>(event);
      plan_success = PlanEventSequential(node, event_id, tray_event, working_state);
    }
    else if(event->GetType() == EventType::BAY_TRANSITION) {
      auto bay_event = std::dynamic_pointer_cast<volley::BayTransition>(event);
      plan_success = PlanEventSequential(node, event_id, bay_event, working_state);
    }
    else if(event->GetType() == EventType::VECS_TRANSITION) {
      auto vecs_event = std::dynamic_pointer_cast<volley::VecsTransition>(event);
      plan_success = PlanEventSequential(node, event_id, vecs_event, working_state);
    }
    // Advance working state
    auto [success, msg] = event->Apply(working_state);
    if(!success) {
      ERRORS(logger_, "Failed to apply event: " << event->ToString() << " : " << msg);
    }

    plan_success = plan_success & success;
    if(!plan_success) {
      return false;
    }
  }

  // Update flowtime / makespan
  node.flowtime = Interval::Duration(0);
  node.makespan = Interval::Timepoint::min();
  for(auto& [ent, traj] : node.trajectories) {
    if(ent.entity_type != "a") {
      // Only care about agv trajectories for now since that's where the branching happens
      continue;
    }
    auto traj_interval_opt = traj.GetInterval();
    // This will always have a value unless a movable agv has no required motions
    if(traj_interval_opt) {
      node.flowtime += traj_interval_opt.value().GetDuration();
      if(traj_interval_opt.value().GetEnd() > node.makespan) {
        node.makespan = traj_interval_opt.value().GetEnd();
      }
    }
  }
  return true;
}

bool Chugg::PlanEventSequential(Node& node, ScheduleEventDag::Vertex event_id,
    std::shared_ptr<volley::AgvMove> agv_event, const DiscreteGarageState& working_state) {
  auto agv_id = agv_event->GetAgvId();
  auto agv_state = working_state.GetAgv(agv_id).value();
  auto agv_ent = volley::AgvId(agv_id);

  INFOS(logger_, "~~~~~~~~ Chugg Planning " + std::to_string(event_id) + ":: " + std::to_string(*agv_event) +
                     " ~~~~~~~~");

  Interval::Timepoint initial_time = EntityCurrentTime(node, agv_ent);

  // Collision id for event from starting state
  auto collision_id = volley::CollisionEntityIdFromAgvState(agv_state, working_state, *(graph_.GetLayout()));

  // Check when all dependencies are met
  Interval::Timepoint all_dep_finished = GetDependencyCompletionTime(node, event_id);

  // Add idle time if necessary
  if(all_dep_finished > initial_time) {
    Motion wait_for_deps(
        agv_ent, Interval(initial_time, all_dep_finished), collision_id, event_id, agv_state.pose);
    node.trajectories[agv_ent].AddMotion(wait_for_deps);
    initial_time = all_dep_finished;

    // deconflict other agvs with wait
    DeconflictAgvs(node, wait_for_deps);
  }

  // if the event corresponds to agv lifting, set the event tray id to the target tray
  uint16_t tray_id = 0;
  const auto& event_change = agv_event->GetDiscreteChange();
  if(std::holds_alternative<AgvLiftChangedMsg>(event_change)) {
    tray_id = working_state.GetTrayOnNode(agv_state.pose.node_id).value().id;
  }

  // set safe intervals for planning to include sequential planning assumption that entities
  // stay static at their last state
  auto orig_sit = SetEventSafeIntervals(node, working_state, agv_id, tray_id);

  auto traj_segment = node.planners.at(agv_id).PlanEvents({event_id}, agv_state, initial_time, constraints_);

  // reset fixed-location constraints
  node.planners.at(agv_id).SetSafeIntervalTable(std::move(orig_sit));

  if(traj_segment) {
    // Ring 3b: SIPP charges path-dependent edge costs (full Trapezoid on a fresh start,
    // marginal d/v on run extension), so the per-edge intervals it emits already reflect
    // coalesced timing in the *trapezoidal* regime — Trap(d1) + d2/v + ... + dN/v = Trap(D).
    // We do NOT post-process with CoalesceTrajectory here because in the *triangular*
    // regime the per-edge breakdown SIPP produces differs from a TimeAtDistance slicing
    // of one Trap(D), and rewriting the intervals after deconfliction would shift the
    // committed reservations away from what SIPP itself reasoned about. Per-edge
    // deconfliction stays exact; total trajectory duration matches coalesced reality
    // wherever runs are trapezoidal (the dominant case for production layouts).
    Interval::Timepoint prev_motion_end = initial_time;
    for(auto& motion : traj_segment.value()) {
      // Update trajectory and deconflict other agvs
      node.trajectories[agv_ent].AddMotion(motion);
      DeconflictAgvs(node, motion);
      if(audit_) {
        // SIPP shifts the start of a motion past the end of the previous motion when a wheel-turn
        // applies. Surface that gap in the audit so totals add up to the segment makespan.
        const auto wheel_turn_gap = motion.GetInterval().GetBegin() - prev_motion_end;
        if(wheel_turn_gap > Interval::Duration::zero()) {
          cost::MotionCostModel::Event(
              cost::SecondsF(wheel_turn_gap), *audit_, std::to_string(agv_ent) + " AGV wheel-turn");
        }
        cost::MotionCostModel::Event(cost::SecondsF(motion.GetInterval().GetDuration()), *audit_,
            std::to_string(agv_ent) + " AGV motion " + std::to_string(motion));
      }
      prev_motion_end = motion.GetInterval().GetEnd();
    }

    INFOS(logger_, "Successfully planned event for " << std::to_string(volley::AgvId(agv_id)));
  }
  else {
    // TODO (mark): better failure logic
    ERRORS(logger_, "Chugg::PlanEventSequential(AgvMove) no traj_segment. Failed to plan event for "
                        << std::to_string(volley::AgvId(agv_id)));
    return false;
  }

  // If this was a lifting event also update placed interval trajectory for tray
  if(std::holds_alternative<AgvLiftChangedMsg>(agv_event->GetDiscreteChange())) {
    // Get tray at this position
    auto tray_state_opt = working_state.GetTrayOnNode(agv_state.pose.node_id);
    // Shouldn't ever happen
    if(!tray_state_opt) {
      throw std::logic_error("AGV lift change without tray on the same node as AGV");
    }
    auto tray_state = tray_state_opt.value();
    auto tray_ent = volley::TrayId(tray_state.id);
    auto lift_change = std::get<AgvLiftChangedMsg>(agv_event->GetDiscreteChange());
    bool agv_recip = volley::IsReciprocal(agv_state.pose.heading, tray_state.pose.heading);

    if(lift_change.raised) {
      // Picking tray up, it is no longer stationary
      // Update prior stationary interval s.t. it stopped being stationary when picked up
      if(node.trajectories[tray_ent].GetInterval()) {
        auto prior_stationary_motion = *(node.trajectories[tray_ent].rbegin());
        // Update prior stationary interval
        // It stopped being stationary when picked up
        node.trajectories[tray_ent].RemoveMotion(prior_stationary_motion);
        node.trajectories[tray_ent].AddMotion(
            Motion(tray_ent, Interval(prior_stationary_motion.GetInterval().GetBegin(), initial_time),
                prior_stationary_motion.GetCollisionId(), prior_stationary_motion.GetActionId(),
                prior_stationary_motion.GetTargetPose()));
      }
      else {
        // Tray was stationary from the beginning
        auto tray_collision_id =
            volley::CollisionEntityIdFromTrayState(tray_state, working_state, *(graph_.GetLayout()));
        node.trajectories[tray_ent].AddMotion(Motion(
            tray_ent, Interval(planning_start_, initial_time), tray_collision_id, 999999, tray_state.pose));
      }
    }
    else {
      // Dropping tray, it starts being stationary again when dropped off
      auto& last_agv_motion = *(traj_segment.value().rbegin());
      Motion::Pose last_agv_pose = last_agv_motion.GetTargetPose();
      Motion::Pose last_tray_pose = agv_recip ? volley::ReciprocalGaragePose(last_agv_pose) : last_agv_pose;
      // Placing tray, it is stationary from now on (until picked up again, end time is
      // arbitrary)
      node.trajectories[tray_ent].AddMotion(
          Motion(tray_ent, Interval(last_agv_motion.GetInterval().GetEnd(), Interval::Timepoint::max()),
              // last_agv_motion.GetInterval().GetEnd() +
              //     Interval::Duration(std::chrono::seconds(600))),
              collision_id, last_agv_motion.GetActionId(), last_tray_pose));
    }
  }
  return true;
}

bool Chugg::PlanEventSequential(Node& node, ScheduleEventDag::Vertex event_id,
    std::shared_ptr<volley::TrayMove> tray_event, const DiscreteGarageState& working_state) {
  auto agv_id = tray_event->GetAgvId().value();
  auto tray_id = tray_event->GetTrayId().value();
  auto agv_state = working_state.GetAgv(agv_id).value();
  auto tray_state = working_state.GetTray(tray_id).value();
  auto agv_ent = volley::AgvId(agv_id);
  auto tray_ent = volley::TrayId(tray_id);

  INFOS(logger_,
      "~~~~~~~~ Planning " + std::to_string(event_id) + ":: " + std::to_string(*tray_event) + " ~~~~~~~~");

  Interval::Timepoint initial_time = EntityCurrentTime(node, agv_ent);

  // Collision id for event from starting state
  auto collision_id =
      volley::CollisionEntityIdFromTrayState(tray_state, working_state, *(graph_.GetLayout()));

  // Check when all dependencies are met
  Interval::Timepoint all_dep_finished = GetDependencyCompletionTime(node, event_id);

  // Add idle time if necessary
  if(all_dep_finished > initial_time) {
    Motion wait_for_deps(
        agv_ent, Interval(initial_time, all_dep_finished), collision_id, event_id, agv_state.pose);
    node.trajectories[agv_ent].AddMotion(wait_for_deps);
    initial_time = all_dep_finished;

    // deconflict other agvs with wait
    DeconflictAgvs(node, wait_for_deps);
  }

  // set safe intervals for planning to include sequential planning assumption that entities
  // stay static at their last state
  auto orig_sit = SetEventSafeIntervals(node, working_state, agv_id, tray_id);

  // if (logger_) {
  //     INFOS(logger_,
  //                        "Safe interval table: " << SafeIntervalTableString(
  //                            node.planners.at(agv_id).GetSafeIntervalTable(), graph_));
  // }
  // Plan segment
  auto traj_segment = node.planners.at(agv_id).PlanEvents({event_id}, agv_state, initial_time, constraints_);

  // reset fixed-location constraints
  node.planners.at(agv_id).SetSafeIntervalTable(std::move(orig_sit));

  if(traj_segment) {
    // Ring 3b: see AgvMove handler above for rationale — no CoalesceTrajectory call here;
    // SIPP's path-dependent per-edge intervals already telescope to coalesced totals in
    // trapezoidal regime, and rewriting them post-deconfliction is unsafe in triangular.
    Interval::Timepoint prev_motion_end = initial_time;
    // Update AGV trajectory and deconflict
    for(auto& motion : traj_segment.value()) {
      node.trajectories[agv_ent].AddMotion(motion);
      DeconflictAgvs(node, motion);
      if(audit_) {
        const auto wheel_turn_gap = motion.GetInterval().GetBegin() - prev_motion_end;
        if(wheel_turn_gap > Interval::Duration::zero()) {
          cost::MotionCostModel::Event(
              cost::SecondsF(wheel_turn_gap), *audit_, std::to_string(agv_ent) + " AGV wheel-turn");
        }
        cost::MotionCostModel::Event(cost::SecondsF(motion.GetInterval().GetDuration()), *audit_,
            std::to_string(agv_ent) + " tray-move motion " + std::to_string(motion));
      }
      prev_motion_end = motion.GetInterval().GetEnd();
    }
    INFOS(logger_, "Successfully planned event for " << std::to_string(volley::AgvId(agv_id)) << ", "
                                                     << std::to_string(volley::TrayId(tray_id)));
  }
  else {
    ERRORS(logger_, "Failed to plan event for " << std::to_string(volley::AgvId(agv_id)) << ", "
                                                << std::to_string(volley::TrayId(tray_id)));
    return false;
  }

  return true;
}

bool Chugg::PlanEventSequential(Node& node, ScheduleEventDag::Vertex event_id,
    std::shared_ptr<volley::BayTransition> bay_event, const DiscreteGarageState& working_state) {
  auto bay_id = bay_event->GetBayId();
  auto bay_state = working_state.GetBay(bay_id).value();
  auto bay_ent = volley::BayId(bay_id);

  INFOS(logger_,
      "~~~~~~~~ Planning " + std::to_string(event_id) + ":: " + std::to_string(*bay_event) + " ~~~~~~~~");

  Interval::Timepoint initial_time = EntityCurrentTime(node, bay_ent);

  auto collision_id = common::EnumInteger(volley::CollisionEntityId::BAY_ODP);

  // Check when all dependencies are met
  Interval::Timepoint all_dep_finished = GetDependencyCompletionTime(node, event_id);

  // Add idle time if necessary
  if(all_dep_finished > initial_time) {
    BayStateChangedMsg bay_idle;
    bay_idle.bay_id = bay_id;
    bay_idle.state_curr = bay_state.state;
    bay_idle.state_next = bay_state.state;
    Motion wait_for_deps(bay_ent, Interval(initial_time, all_dep_finished), collision_id, event_id, bay_idle);
    node.trajectories[bay_ent].AddMotion(wait_for_deps);
    initial_time = all_dep_finished;

    // deconflict agvs with wait
    DeconflictAgvs(node, wait_for_deps);
  }

  // Add transition(s) for event
  // Currently this only adds 1 transition that moves bay from current state to commanded state
  // but we could include intermediate transition states

  // TODO (mark): more thorough bay durations / state change logic
  //  Duration estimate should include logic about current state
  //  e.x. ProcessingRetrieve->ReadyToInsert should include estimated
  //  patron waiting time

  auto bay_cmd = bay_event->GetCommand().command_type;

  BayStateChangedMsg delta;
  delta.bay_id = bay_id;
  delta.state_curr = bay_state.state;

  double bay_duration = 0.0;
  switch(bay_cmd) {
  case BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT:
    bay_duration = cost_model_.Params().events.bay_door_close;
    delta.state_next = BayReportMsg::STATE_READY_TO_INSERT;
    break;
  case BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE:
    bay_duration = cost_model_.Params().events.bay_door_open + cost_model_.Params().events.bay_wait_to_open;
    delta.state_next = BayReportMsg::STATE_READY_TO_RETRIEVE;
    break;
  case BayCommandMsg::COMMAND_TYPE_PROCESS_RETRIEVE:
    // ProcRetrieve->RTI (or RTR?? TODO (mark): verify this)
    // TODO(someone) make this legit
    bay_duration = 60.0;
    delta.state_next = BayReportMsg::STATE_READY_TO_INSERT;
    break;
  default:
    throw std::logic_error("Bay command is unrecognized");
  }

  Interval::Duration transition_duration =
      std::chrono::duration_cast<Interval::Duration>(std::chrono::duration<double>(bay_duration));

  if(audit_) {
    cost::MotionCostModel::Event(cost::SecondsF(static_cast<float>(bay_duration)), *audit_,
        std::to_string(bay_ent) + " bay door " + std::to_string(static_cast<int>(bay_cmd)));
  }

  Motion bay_transition(bay_ent, Interval(initial_time, transition_duration), collision_id, event_id, delta);

  // For bay closing transitions, add idle time if it is not safe to close yet
  if(bay_cmd == BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT ||
      bay_cmd == BayCommandMsg::COMMAND_TYPE_PROCESS_RETRIEVE) {
    // find next safe transition time
    auto next_safe = initial_time;
    for(auto& [ent, traj] : node.trajectories) {
      for(const auto& motion : traj) {
        if(ContinuousState::CheckMotionCollision(bay_transition, motion, geometry_)) {
          auto end_collision = motion.GetInterval().GetEnd();
          next_safe = end_collision > next_safe ? end_collision : next_safe;
        }
      }
    }

    if(next_safe > initial_time) {
      // Add idle time
      BayStateChangedMsg bay_idle;
      bay_idle.bay_id = bay_id;
      // NOTE: if cmd is insert or proc retrieve the idle state should be ready to retrieve
      // and we don't have to explicitly deconflict this
      bay_idle.state_curr = bay_state.state;
      bay_idle.state_next = bay_state.state;
      Motion wait_for_safe(bay_ent, Interval(initial_time, next_safe), collision_id, event_id, bay_idle);
      node.trajectories[bay_ent].AddMotion(wait_for_safe);
      auto transition_start = next_safe;
      bay_transition =
          Motion(bay_ent, Interval(transition_start, transition_duration), collision_id, event_id, delta);
    }
  }

  node.trajectories.at(bay_ent).AddMotion(bay_transition);

  // Deconflict transition with future agv moves
  // NOTE: If we include intermediate transition states this should be adapted
  // to the sequence of new transitions rather than just the last one
  DeconflictAgvs(node, bay_transition);

  INFOS(logger_, "successfully planned event for " << std::to_string(volley::BayId(bay_id)));

  return true;
}

bool Chugg::PlanEventSequential(Node& node, ScheduleEventDag::Vertex event_id,
    std::shared_ptr<volley::VecsTransition> vecs_event, const DiscreteGarageState& working_state) {
  auto vecs_id = vecs_event->GetVecsId();
  auto vecs_state = working_state.GetVecs(vecs_id).value();
  auto vecs_ent = volley::VecsId(vecs_id);

  INFOS(logger_,
      "~~~~~~~~ Planning " + std::to_string(event_id) + ":: " + std::to_string(*vecs_event) + " ~~~~~~~~");

  Interval::Timepoint initial_time = EntityCurrentTime(node, vecs_ent);

  // :thonk:
  auto collision_id = common::EnumInteger(volley::CollisionEntityId::TRAY_LEGS);

  // Check when all dependencies are met
  Interval::Timepoint all_dep_finished = GetDependencyCompletionTime(node, event_id);

  // Add idle time if necessary
  if(all_dep_finished > initial_time) {
    VecsStateChangedMsg vecs_idle;
    vecs_idle.vecs_id = vecs_id;
    vecs_idle.state_curr = vecs_state.state;
    vecs_idle.state_next = vecs_state.state;
    Motion wait_for_deps(
        vecs_ent, Interval(initial_time, all_dep_finished), collision_id, event_id, vecs_idle);
    node.trajectories[vecs_ent].AddMotion(wait_for_deps);
    initial_time = all_dep_finished;

    // deconflict AGVs with wait
    DeconflictAgvs(node, wait_for_deps);
  }

  // Add transition(s) for event
  // Currently this only adds 1 transition that moves VECS from current state to commanded state
  // but we could include intermediate transition states

  Interval::Duration transition_duration = std::chrono::duration_cast<Interval::Duration>(
      cost::SecondsF(cost_model_.Params().events.vecs_transition));
  if(audit_) {
    cost::MotionCostModel::Event(cost::SecondsF(cost_model_.Params().events.vecs_transition), *audit_,
        std::to_string(vecs_ent) + " VECS transition");
  }
  Motion vecs_transition(vecs_ent, Interval(initial_time, transition_duration), collision_id, event_id,
      vecs_event->GetStateChange());

  node.trajectories.at(vecs_ent).AddMotion(vecs_transition);

  // Deconflict transition with future AGV moves
  // NOTE: If we include intermediate transition states this should be adapted
  // to the sequence of new transitions rather than just the last one
  // This doesn't really do anything yet I think
  DeconflictAgvs(node, vecs_transition);

  INFOS(logger_, "Successfully planned event for " << std::to_string(volley::VecsId(vecs_id)));

  return true;
}

bool Chugg::PlanEventSequential(Node& node, ScheduleEventDag::Vertex event_id,
    std::shared_ptr<volley::VrcTransition> vrc_event, const DiscreteGarageState& working_state) {
  (void)working_state;
  auto vrc_id = vrc_event->GetVrcId();
  auto vrc_ent = volley::VrcId(vrc_id);

  INFOS(logger_,
      "~~~~~~~~ Planning " + std::to_string(event_id) + ":: " + std::to_string(*vrc_event) + " ~~~~~~~~");

  Interval::Timepoint initial_time = EntityCurrentTime(node, vrc_ent);

  // VRC does not occupy physical space; use TRAY_LEGS as placeholder
  auto collision_id = common::EnumInteger(volley::CollisionEntityId::TRAY_LEGS);

  // Check when all dependencies are met
  Interval::Timepoint all_dep_finished = GetDependencyCompletionTime(node, event_id);

  // Add idle time if necessary
  if(all_dep_finished > initial_time) {
    VrcStateChangedMsg vrc_idle;
    vrc_idle.current_discrete_state = vrc_event->GetStateChange().current_discrete_state;
    vrc_idle.next_discrete_state = vrc_idle.current_discrete_state;
    Motion wait_for_deps(vrc_ent, Interval(initial_time, all_dep_finished), collision_id, event_id, vrc_idle);
    node.trajectories[vrc_ent].AddMotion(wait_for_deps);
    initial_time = all_dep_finished;
  }

  // VRC event = close start gate + carriage transit (trapezoid profile from layout floor heights)
  // + open end gate.
  const auto src_floor = vrc_event->GetStateChange().current_discrete_state.current_floor;
  const auto dst_floor = vrc_event->GetStateChange().next_discrete_state.current_floor;
  const auto& layout = *graph_.GetLayout();
  const float src_z = layout.GetFloorZForFloorId(src_floor).value_or(0.0f);
  const float dst_z = layout.GetFloorZForFloorId(dst_floor).value_or(0.0f);
  const volley::Transition transition {std::abs(dst_z - src_z), volley::TransitionType::VRC_TRANSITION};
  const cost::SecondsF door_close_seconds(cost_model_.Params().events.vrc_door_close);
  const cost::SecondsF door_open_seconds(cost_model_.Params().events.vrc_door_open);
  cost::SecondsF transit_seconds;
  if(audit_) {
    cost::MotionCostModel::Event(door_close_seconds, *audit_,
        std::to_string(vrc_ent) + " VRC close gate floor " + std::to_string(src_floor));
    transit_seconds = cost_model_.Duration(transition, *audit_,
        std::to_string(vrc_ent) + " VRC floor " + std::to_string(src_floor) + " -> " +
            std::to_string(dst_floor));
    cost::MotionCostModel::Event(door_open_seconds, *audit_,
        std::to_string(vrc_ent) + " VRC open gate floor " + std::to_string(dst_floor));
  }
  else {
    transit_seconds = cost_model_.Duration(transition);
  }
  const cost::SecondsF total_seconds = door_close_seconds + transit_seconds + door_open_seconds;
  Interval::Duration transition_duration = std::chrono::duration_cast<Interval::Duration>(total_seconds);
  Motion vrc_transition(vrc_ent, Interval(initial_time, transition_duration), collision_id, event_id,
      vrc_event->GetStateChange());

  node.trajectories.at(vrc_ent).AddMotion(vrc_transition);

  INFOS(logger_, "Successfully planned event for " << std::to_string(volley::VrcId(vrc_id)));

  return true;
}

// !!! Modifies node as a side effect and returns the original safe interval table !!!
SafeIntervalTable Chugg::SetEventSafeIntervals(
    Chugg::Node& node, const DiscreteGarageState& working_state, uint16_t event_agv, uint16_t event_tray) {
  // Copy of original constraints
  SafeIntervalTable orig_sit(node.planners.at(event_agv).GetSafeIntervalTable());

  // auto event_constraints = GetStaticConstraintsCopy();

  INFOS(logger_, "Setting safe intervals for event " << std::to_string(volley::AgvId(event_agv)) << ", "
                                                     << std::to_string(volley::TrayId(event_tray)));

  for(auto& [ent, traj] : node.trajectories) {
    // don't 'deconflict' with self
    if(ent == volley::AgvId(event_agv)) {
      continue;
    }
    if(ent == volley::TrayId(event_tray)) {
      continue;
    }

    // Get collision entity for deconfliction
    auto deconflict_id = common::EnumInteger(volley::CollisionEntityId::AGV);
    if(ent.entity_type == "t") {
      auto deconflict_tray_state = working_state.GetTray(ent.id).value();
      if(deconflict_tray_state.agv_id != 0) {
        // Picked up tray deconfliction handled by agv deconfliction
        continue;
      }
      if(event_tray == 0) {
        // Event constraints are for free agv movement, deconflict with tray legs entity
        deconflict_id = common::EnumInteger(volley::CollisionEntityId::TRAY_LEGS);
      }
      else {
        // Event constraints are for a tray movement, deconflict with associated tray
        // collision entity
        deconflict_id =
            CollisionEntityIdFromTrayState(deconflict_tray_state, working_state, *(graph_.GetLayout()));
      }
    }
    else if(ent.entity_type == "a") {
      auto deconflict_agv_state = working_state.GetAgv(ent.id).value();
      deconflict_id =
          CollisionEntityIdFromAgvState(deconflict_agv_state, working_state, *(graph_.GetLayout()));
    }
    else if(ent.entity_type == "b") {
      auto deconflict_bay_state = working_state.GetBay(ent.id).value();
      if(deconflict_bay_state.state == BayReportMsg::STATE_READY_TO_RETRIEVE) {
        // Don't need to deconflict with bays in ready to retrieve
        continue;
      }
      deconflict_id = common::EnumInteger(volley::CollisionEntityId::BAY_ODP);
    }

    // Get end pose and deconfliction time for entity
    Motion::Pose deconflict_pose;
    Interval::Timepoint resting_start;
    // TODO(Gunther): Add `very_verbose` flag
    // if (logger_) {
    //     INFOS(logger_, "Deconflicting with " << std::to_string(ent));
    //     INFOS(logger_, "Collision ID: " <<
    //     std::to_string(deconflict_id)); INFOS(logger_, "Trajectory: ");
    //     for (const auto& motion : traj) {
    //         INFOS(logger_, "   " << std::to_string(motion));
    //     }
    // }

    if(traj.GetInterval()) {
      // Use traj last state
      const auto& last_motion = *traj.rbegin();
      deconflict_pose = last_motion.GetTargetPose();
      resting_start = last_motion.GetInterval().GetEnd();
    }
    else {
      // use initial state
      const auto& init_traj = init_traj_.GetTrajectories().at(ent);
      const auto& last_motion = *init_traj.rbegin();
      deconflict_pose = last_motion.GetTargetPose();
      resting_start = last_motion.GetInterval().GetEnd();
    }

    // TODO(Gunther): Add `very_verbose` flag
    // if (logger_) {
    //     INFOS(logger_, "Deconflict pose: " <<
    //         std::to_string(deconflict_pose));
    //     INFOS(logger_, "Deconflict start: " <<
    //         std::to_string(resting_start));
    //     INFOS(logger_, "Prior SIT:" <<
    //         SafeIntervalTableString(node.planners.at(event_agv).GetSafeIntervalTable(),
    //             graph_));
    // }

    if(ent.entity_type == "b") {
      auto deconflict_bay_state = working_state.GetBay(ent.id).value();
      BayStateChangedMsg bay_change;
      bay_change.bay_id = ent.id;
      bay_change.state_curr = deconflict_bay_state.state;
      bay_change.state_next = deconflict_bay_state.state;

      Motion deconflict_motion(
          ent, Interval(resting_start, Interval::Timepoint::max()), deconflict_id, 99999, bay_change);
      node.planners.at(event_agv).AddDeconflictConstraints(deconflict_motion);
    }
    else if(ent.entity_type == "v") {
      auto deconflict_vecs_state = working_state.GetVecs(ent.id).value();
      VecsStateChangedMsg vecs_change;
      vecs_change.vecs_id = ent.id;
      vecs_change.state_curr = deconflict_vecs_state.state;
      vecs_change.state_next = deconflict_vecs_state.state;

      Motion deconflict_motion(
          ent, Interval(resting_start, Interval::Timepoint::max()), deconflict_id, 99999, vecs_change);
      node.planners.at(event_agv).AddDeconflictConstraints(deconflict_motion);
    }
    else {
      for(const auto& motion : traj) {
        node.planners.at(event_agv).AddDeconflictConstraints(motion);
      }

      Motion resting_motion(
          ent, Interval(resting_start, Interval::Timepoint::max()), deconflict_id, 99999, deconflict_pose);

      INFOS(logger_, "Deconflict motion: " << std::to_string(resting_motion));

      node.planners.at(event_agv).AddDeconflictConstraints(resting_motion);
    }
    // TODO(Gunther): Add `very_verbose` flag
    // if (logger_) {
    //     INFOS(logger_, "Updated SIT:" <<
    //         SafeIntervalTableString(node.planners.at(event_agv).GetSafeIntervalTable(),
    //             graph_));
    // }
  }

  return orig_sit;
}

