<file path="include/motion_planner/path_search.hpp">
#pragma once

#include <boost/heap/fibonacci_heap.hpp>
#include <common/types.hpp>
#include <functional>
#include <iostream>
#include <memory>
#include <optional>
#include <queue>
#include <type_traits>
#include <unordered_map>
#include <unordered_set>
#include <vector>

namespace volley {

constexpr unsigned int kMaxExpansions = 5000000u;

// Search operations meta-metrics
// Used for early stopping in OnExpansion callback and comparing alg updates
struct SearchMetaData {
  size_t n_open = 0;        // total # nodes remaining (or remained) in open set
  size_t n_closed = 0;      // total # nodes closed (pop operations off open set)
  size_t n_discovered = 0;  // total # unique nodes pushed into open set
  size_t n_updated = 0;     // total # neighbor updates (increase key operations in open set)
};

// Abstract base class for providing callbacks at various points in searches
// Primarily provides stopping criteria, neighbors, and heuristics.
// Cost must have defined +- and comparison operators
template <typename State, typename Cost>
class SearchEnvironment {
public:
  SearchEnvironment() = default;

  // clang really wants all 5
  virtual ~SearchEnvironment() = default;
  SearchEnvironment(const SearchEnvironment&) = default;
  SearchEnvironment& operator=(const SearchEnvironment&) = default;
  SearchEnvironment(SearchEnvironment&& other) = default;
  SearchEnvironment& operator=(SearchEnvironment&& other) = default;

  // ~~~~~~~~~~~~~ Mandatory callbacks ~~~~~~~~~~~~~~~~~~
  // These functions have to do something important for the search

  // Called on expansion of node (open set pop).
  // Inputs are expanded state, current cost for the state ('g value'), and state meta data
  // Returns true to terminate search (ex. when finding a goal state), otherwise false to continue
  // search
  virtual bool OnExpansion(const State& state, const Cost& cost, const SearchMetaData& data) = 0;

  // Return neighbors for the node as a pair of neighbor state and cost-to-move to the neighbor
  virtual std::vector<std::pair<State, Cost>> GetNeighbors(const State& state) = 0;

  // Return heuristic cost-to-go from a given state.
  // Return '0' value for Cost type to ignore heuristic in search
  // NOTE: SingleSourceSearch uses closed-set rules,
  //       heuristic must be admissible and consistent to guarantee optimality
  virtual Cost GetHeuristic(const State& state) = 0;

  // ~~~~~~~~~~~~~ Optional Callbacks ~~~~~~~~~~~~~~~~~~
  // These functions are generally for informational purposes
  //  (but could manipulate environment if you want for some reason)

  // Called when a new neighbor is found and is put into open set
  // Inputs are discovered state, and cost so far to that state
  virtual void OnDiscovery(const State&, const Cost&) { }

  // Called when a neighbor is found that already exists in the open set but is updated with
  // a lower cost. Inputs are updated state, old cost, new cost
  virtual void OnUpdate(const State&, const Cost&, const Cost&) { }

  // Called when search is terminated, useful for cleanup or logging
  // (ex. logging search results, or cleaning up meta state)
  virtual void OnTermination() { }
};

// Return info from search
template <typename State, typename Cost, typename StateHash = std::hash<State>>
class SearchSolution {
private:
  State source_;
  std::unordered_map<State, std::tuple<State, Cost, bool>, StateHash> predecessors_;
  SearchMetaData meta_data_;
  // Target only exists for searches that terminate using OnExpansion flag
  // This is useful info for when the goal of the search is not defined as a specific State
  std::optional<State> target_;

public:
  SearchSolution(State source,
      std::unordered_map<State, std::tuple<State, Cost, bool>, StateHash>&& predecessors,
      SearchMetaData meta_data, std::optional<State> target = std::nullopt) :
      source_(source), predecessors_(predecessors), meta_data_(meta_data), target_(target) { }

  // Extracts and returns path to goal from source state of search
  // Vector of <State, Cost to move to this state from previous state>
  // Ex. [<init state, 0>, <next state, 3>], '3' is the cost to move from init to next
  // Total cost of path is sum of all costs in the vector
  // Returns empty optional if no path exists
  std::optional<std::vector<std::pair<State, Cost>>> GetPath(State goal) const {
    if(predecessors_.find(goal) == predecessors_.end()) {
      return std::nullopt;
    }

    // initialize path
    std::vector<std::pair<State, Cost>> path;
    State current = goal;

    // Backtrack from goal to source
    while(true) {
      const auto& [came_from, cost_from, closed] = predecessors_.at(current);
      path.push_back(std::make_pair(current, cost_from));

      // Finish path if we've reached the source; source's predecessor is itself
      if(current == came_from) {
        break;
      }

      current = came_from;
    }

    // Path was constructed from goal to source; reverse it for source to goal
    std::reverse(path.begin(), path.end());
    return path;
  }

  const SearchMetaData& GetMetaData() const { return meta_data_; }

  const State& GetSource() const { return source_; }
  const std::optional<State>& GetTarget() const { return target_; }
};

template <typename State, typename Cost, typename Environment, typename StateHash = std::hash<State>>
SearchSolution<State, Cost, StateHash> SingleSourceSearch(State source, Cost init_cost, Environment& env) {
  static_assert(std::is_base_of<SearchEnvironment<State, Cost>, Environment>::value,
      "Environment must be derived from SearchEnvironment<State, Cost>");

  // Search node structure, wraps state
  struct SearchNode {
    State state;  // node data
    Cost g_val;   // cost-so-far
    Cost f_val;   // expected total cost, g_val + heuristic

    // handle to position in heap
    typename boost::heap::fibonacci_heap<SearchNode>::handle_type handle;

    SearchNode(State state, Cost current_cost, Cost expected_cost) :
        state(state), g_val(current_cost), f_val(expected_cost) { }

    // Open set comparison operator.
    // Note f_ > other._f to sort max-heap (boost heap default) as min-heap
    // subsorting by max-g to indirectly sort by min-heuristic for tie-breaks amongst equal f
    // values (smaller note, if heuristic = 0, this still sorts by min-g as expected)
    bool operator<(const SearchNode& other) const {
      return (f_val != other.f_val) ? (f_val > other.f_val) : (g_val < other.g_val);
    }
  };

  // Operations counter data
  SearchMetaData meta_data;

  // Using fibonacci heap as open set for better amortized decrease/increase key op
  // Note d-ary (or similar) may have better cache performance for Dijkstra-like search
  // Future: performance characterization fib vs others. Perhaps template heap type for
  // customization?
  using OpenSet = typename boost::heap::fibonacci_heap<SearchNode>;
  using OpenSetHandle = typename boost::heap::fibonacci_heap<SearchNode>::handle_type;
  OpenSet open_set;

  // Predecessors map from state visited -> predecessor info, also acts as closed-set
  //  predecessor info: <state came from, cost to move from state to Key state, boolean value if
  //  Key state is closed>
  std::unordered_map<State, std::tuple<State, Cost, bool>, StateHash> predecessors;

  // Mapping of state to position in open set, for quick lookups to see if neighbor state is
  // already in open list
  std::unordered_map<State, OpenSetHandle, StateHash> state_to_open;

  // Utility lambda for pushing new node to open set
  // NOLINTNEXTLINE
  auto PushOpenSet = [&](State state, Cost cost_so_far, Cost expected_cost) {
    OpenSetHandle handle = open_set.push(SearchNode(state, cost_so_far, expected_cost));
    (*handle).handle = handle;  // setting node internal reference to its heap position
    state_to_open.insert(std::make_pair(state, handle));
    meta_data.n_discovered += 1;
    meta_data.n_open = open_set.size();
  };

  // Initialize
  Cost expected_cost = init_cost + env.GetHeuristic(source);
  PushOpenSet(source, init_cost, expected_cost);
  // Source predecessor is itself
  predecessors.insert(std::make_pair(source, std::make_tuple(source, init_cost, false)));

  // A*
  unsigned int num_expansions = 0u;
  while(!open_set.empty()) {
    if(++num_expansions > kMaxExpansions) {
      break;
    }
    // Next node
    SearchNode current = open_set.top();
    bool end_search = env.OnExpansion(current.state, current.g_val, meta_data);

    // Terminate search if OnExpansion says so
    if(end_search) {
      env.OnTermination();
      return SearchSolution<State, Cost, StateHash>(
          source, std::move(predecessors), meta_data, current.state);
    }

    // expand node
    open_set.pop();
    state_to_open.erase(current.state);

    auto iter = predecessors.find(current.state);
    std::get<2>(iter->second) = true;  // close node in pred map
    meta_data.n_closed += 1;
    meta_data.n_open = open_set.size();

    for(auto& neighbor : env.GetNeighbors(current.state)) {
      // Skip neighbor if it is in closed set
      auto closed_iter = predecessors.find(neighbor.first);
      if(closed_iter != predecessors.end() && std::get<2>(closed_iter->second)) {
        continue;
      }

      // Potential g value of neighboring search node
      Cost tentative_g = current.g_val + neighbor.second;

      auto iter = state_to_open.find(neighbor.first);
      if(iter == state_to_open.end()) {
        // Discovered a new node not in open set
        Cost expected_cost = tentative_g + env.GetHeuristic(neighbor.first);
        PushOpenSet(neighbor.first, tentative_g, expected_cost);

        // Mark neighbor as visited and set current node as predecessor
        predecessors.insert(
            std::make_pair(neighbor.first, std::make_tuple(current.state, neighbor.second, false)));

        env.OnDiscovery(neighbor.first, tentative_g);
      }
      else {
        // Neighbor already exists in open set
        auto handle = iter->second;
        if(tentative_g >= (*handle).g_val) {
          // Version of neighbor in open set is better than this one
          continue;
        }

        // This neighbor is better than before, update open set and pred map costs
        Cost old_g = (*handle).g_val;
        Cost delta_g = old_g - tentative_g;
        (*handle).g_val = tentative_g;
        (*handle).f_val = (*handle).f_val - delta_g;
        open_set.increase(handle);
        meta_data.n_updated += 1;

        // Update predecessor map with new cost
        predecessors[neighbor.first] = std::make_tuple(current.state, neighbor.second, false);

        env.OnUpdate(neighbor.first, old_g, neighbor.second);
      }
    }
  }

  env.OnTermination();
  // OnExpansion did not terminate early but we are out of nodes
  return SearchSolution<State, Cost, StateHash>(source, std::move(predecessors), meta_data);
}

}  // namespace volley

namespace std {
// NOLINTNEXTLINE
std::string to_string(const volley::SearchMetaData& meta);
}  // namespace std
</file>

<file path="include/motion_planner/safe_interval_path_planning.hpp">
#pragma once

#include <common/types.hpp>
#include <common_ros/collision_geometry.hpp>
#include <common_ros/garage_graph.hpp>
#include <cost_functions/motion_cost_model.hpp>
#include <motion_planner/path_search.hpp>
#include <motion_planner/safe_interval_table.hpp>
#include <motion_planner/static_graph_filtering.hpp>
#include <motion_planner/trajectory.hpp>
#include <stdexcept>
#include <variant>

namespace volley {

// SippState includes source / target vertex
// Future: for true multi-label this also includes lifting or not and collision id
// for now collision id is fixed and we only use Sipp for movements/waiting
// TODO (mark): getters setters or w/e
class SippState {
public:
  using Vertex = volley::GarageGraph::Vertex;  // size_t

  SippState(Vertex source, Vertex target, Interval interval, size_t goal_index, size_t num_predecessors = 0) :
      source_(source),
      target_(target),
      interval_(interval),
      goal_idx_(goal_index),
      num_predecessors_(num_predecessors) { }

  SippState() :
      source_(0),
      target_(0),
      interval_(Interval(Interval::Timepoint::min(), Interval::Timepoint::max())),
      goal_idx_(0),
      num_predecessors_(0) { }

  const Vertex& GetSource() const { return source_; }
  const Vertex& GetTarget() const { return target_; }
  const Interval& GetInterval() const { return interval_; }
  size_t GetGoalIndex() const { return goal_idx_; }
  size_t GetPredecessorCount() const { return num_predecessors_; }

  bool operator==(const SippState& other) const {
    return source_ == other.source_ && target_ == other.target_ && interval_ == other.interval_ &&
           goal_idx_ == other.goal_idx_ && num_predecessors_ == other.num_predecessors_;
  }

private:
  // source == target if waiting
  Vertex source_;
  Vertex target_;

  // Interval of movement or wait
  Interval interval_;

  // Number of goals at this state
  size_t goal_idx_;

  // Number of predecessors
  size_t num_predecessors_;
};

// For verbose/debug prints in SippEnvironment or wherever
// Uses graph to convert vertices back to pose for readability
std::string SippStateString(const SippState& state, const volley::GarageGraph& graph);

// SippGoal defines path targets for Sipp
// SippGoals define either a vertex to arrive at, an edge to traverse, or a duration to wait
// For wait-type goals, waiting always occurs at the last vertex
//   - This corresponds to lifting-type AGV actions
// SippGoal may be a landmark, in which an interval is also specified
//   - This supports CBS
//   - For vertex-type landmarks, the goal is to arrive at the vertex at the beginning of the
//   interval and stay there until the end of the duration
//   - For edge-type landmarks, the goal is to arrive at the source of the edge at the beginning of
//   the interval and traverse for the duration
// If no landmark interval is specified the goal is to arrive ASAP (default)
// TODO (mark) : loiter-type goal, for AGVs that have no specific goal but need to stay out of the
// way; just find a path to the closest vertex that is safe to stay at forever
class SippGoal {
public:
  using Vertex = volley::GarageGraph::Vertex;
  using Edge = volley::GarageGraph::Edge;

  explicit SippGoal(volley::CollisionEntityId_t collision_id,
      std::optional<std::variant<Vertex, Edge>> target_opt = std::nullopt,
      std::optional<Interval::Duration> wait_duration_opt = std::nullopt,
      std::optional<Interval> landmark_interval_opt = std::nullopt) :
      collision_id_(collision_id),
      target_opt_(target_opt),
      wait_duration_opt_(wait_duration_opt),
      landmark_interval_opt_(landmark_interval_opt) {
    if(target_opt && wait_duration_opt) {
      throw std::invalid_argument("Can not specify both a target location and wait duration");
    }

    if(wait_duration_opt && landmark_interval_opt) {
      throw std::invalid_argument("Can not specify both a wait duration and landmark interval");
    }
  }

  volley::CollisionEntityId_t GetCollisionId() const { return collision_id_; }
  const std::optional<std::variant<Vertex, Edge>>& GetTargetLocation() const { return target_opt_; }
  const std::optional<Interval>& GetLandmarkInterval() const { return landmark_interval_opt_; }
  const std::optional<Interval::Duration>& GetWaitDuration() const { return wait_duration_opt_; }

  std::string ToString(const volley::GarageGraph& graph) const {
    std::string result = "SippGoal: ";
    result += "CollisionId: " + std::to_string(GetCollisionId()) + ", ";
    if(GetTargetLocation()) {
      auto target = GetTargetLocation().value();
      std::visit(
          [&result, graph](
              auto&& arg) { result += "Target: " + std::to_string(graph.GetFromGraphRep(arg)) + ", "; },
          target);
    }
    else if(GetWaitDuration()) {
      result += "WaitDuration: " + std::to_string(GetWaitDuration().value().count());
    }
    else {
      result += "NoTarget";
    }

    if(GetLandmarkInterval()) {
      auto interval = GetLandmarkInterval().value();
      result += ", LandmarkInterval: [" + std::to_string(interval) + "]";
    }
    return result;
  }

private:
  volley::CollisionEntityId_t collision_id_;
  std::optional<std::variant<Vertex, Edge>> target_opt_;
  std::optional<Interval::Duration> wait_duration_opt_;
  std::optional<Interval> landmark_interval_opt_;
};
}  // namespace volley
namespace std {
template <>
struct hash<volley::SippState> {
  std::size_t operator()(const volley::SippState& state) const {
    std::size_t result = 117;
    boost::hash_combine(result, state.GetSource());
    boost::hash_combine(result, state.GetTarget());
    boost::hash_combine(result, state.GetInterval().GetBegin().time_since_epoch().count());
    boost::hash_combine(result, state.GetInterval().GetEnd().time_since_epoch().count());
    boost::hash_combine(result, state.GetGoalIndex());
    return result;
  }
};

}  // namespace std
namespace volley {
class SippEnvironment : public SearchEnvironment<SippState, Interval::Duration> {
public:
  using Neighbors = std::vector<std::pair<SippState, Interval::Duration>>;
  using GarageGraph = volley::GarageGraph;
  using Vertex = GarageGraph::Vertex;
  using Edge = GarageGraph::Edge;
  using EdgeDurations = GarageGraph::EdgeVectorPropertyMap<Interval::Duration>;
  using Transition = volley::Transition;
  using TransitionType = volley::TransitionType;
  using HeuristicMap = std::vector<std::vector<Interval::Duration>>;
  using GraphConstraints = std::unordered_map<volley::CollisionEntityId_t, GraphFilterProperties>;

  // TODO (mark): (maybe) instead of using a bunch of const refs, have optional pointers
  // TODO (mark): also GraphConstraints should be const
  // wheel_turn_time is the per-mode-change AGV wheel reorientation delay; pass zero to disable.
  // motion_params provides the speed/accel pairs needed for path-dependent edge costing
  // (Ring 3b): when an edge extends a parent's run (codirectional locomote/strafe, same-sign
  // rotation at the same node, or same-VRC same-direction VRC ride) the cost is just marginal
  // cruise time `length / vmax`, not a fresh Trapezoid. Defaults are tuned for backward
  // compatibility with existing tests.
  SippEnvironment(const GarageGraph& graph, const EdgeDurations& edge_durations,
      const std::vector<SippGoal>& goals, const SafeIntervalTable& safe_intervals,
      const HeuristicMap& heuristics, const GraphConstraints& constraints,
      Interval::Duration wheel_turn_time = Interval::Duration::zero(),
      cost::MotionCostParams motion_params = cost::MotionCostParams {});

  SippEnvironment(const SippEnvironment& other);

  ~SippEnvironment() override = default;
  SippEnvironment& operator=(const SippEnvironment&) = delete;
  SippEnvironment(SippEnvironment&& other) = default;
  SippEnvironment& operator=(SippEnvironment&& other) = default;

  // Gets neighbors for a parent state
  // Neighbors depend on goal completion criteria and parent movement type
  Neighbors GetNeighbors(const SippState& parent) override;

  // Multi-goal heurstic duration-to-go from current state
  // Computes heuristic for completing current state goal and all future goals
  Interval::Duration GetHeuristic(const SippState& state) override;

  bool OnExpansion(const SippState& state, const Interval::Duration& cost_so_far,
      const SearchMetaData& meta_data) override;

private:
  // Common const refs to constraints and goals
  const GarageGraph& graph_;
  const EdgeDurations& edge_durations_;
  const std::vector<SippGoal>& goals_;
  const SafeIntervalTable& safe_intervals_;
  const HeuristicMap& heuristics_;
  const GraphConstraints& constraints_;
  Interval::Duration wheel_turn_time_;
  cost::MotionCostParams motion_params_;

  // Get edges from the current location and the next interval it is safe to traverse them
  // Only includes edges that are traversable at the current time or in the future
  std::vector<std::pair<Edge, Interval>> GetTraversableEdges(
      const SippState& parent, size_t neighbor_goal_idx) const;

  // Adds all move-on-edge neighbors that can be safely traversed at current time
  void AddTraversalNeighbors(const SippState& parent,
      const std::vector<std::pair<Edge, Interval>>& traversals, size_t neighbor_goal_idx,
      Neighbors& neighbors) const;

  // Adds all wait-at-pose neighbors to wait for an edge to be safe to traverse
  void AddWaitForTraversalNeighbors(const SippState& parent,
      const std::vector<std::pair<Edge, Interval>>& traversals, size_t neighbor_goal_idx,
      Neighbors& neighbors) const;

  // Adds wait at current-pose neighbor for waiting-type goals
  void AddWaitForGoalNeighbor(const SippState& parent, size_t neighbor_goal_idx, Neighbors& neighbors) const;

  // Checks if a state completes its current goal
  bool StateCompletesGoal(const SippState& state) const;

  // Checks if goal for current state is even completable
  // For landmarks this returns false if the interveral exceeds the landmark interval
  bool GoalIsCompletable(const SippState& state) const;

  // Helper func for getting safe intervals
  template <typename Location>
  std::optional<Interval> FindSafeInterval(Location loc, volley::CollisionEntityId_t type,
      const Interval::Timepoint& start, const Interval::Duration& duration) const {
    SafeIntervalTable::TableEntryKey<Location> key = std::make_pair(type, loc);
    auto safe = safe_intervals_.FindSafeInterval(key, start, duration);
    return safe;
  }
};

// Helper function for simple pose pathing (used in tests)

}  // namespace volley
