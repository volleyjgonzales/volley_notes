#pragma once
#include <chrono>
#include <common/types.hpp>
#include <set>
#include <string>

namespace volley {
class Interval {
public:
  using Timepoint = std::chrono::time_point<std::chrono::system_clock>;
  using Duration = Timepoint::duration;

  Interval(Timepoint begin, Timepoint end);
  Interval(Timepoint begin, Duration duration) : Interval(begin, begin + duration) { };

  std::string ToString() const;

  Duration GetDuration() const;

  bool operator!=(const Interval& other) const { return not(*this == other); }
  bool operator==(const Interval& other) const { return begin_ == other.begin_ && end_ == other.end_; }

  bool Overlaps(const Interval& other) const {
    return not(StrictlyBefore(other) || other.StrictlyBefore(*this));
  }

  bool Before(const Interval& other) const { return begin_ < other.begin_; }

  bool StrictlyBefore(const Interval& other) const { return end_ <= other.begin_; }

  bool Contains(const Interval& other) const { return begin_ <= other.begin_ && end_ >= other.end_; }

  std::pair<Timepoint, Timepoint> GetTimes() const { return std::make_pair(begin_, end_); }

  const Timepoint& GetBegin() const { return begin_; }
  const Timepoint& GetEnd() const { return end_; }

private:
  Timepoint begin_, end_;
};

// Formatted string funcs for easier to read debug prints of time stuff
// TODO (mark): maybe these belong somewhere else, Seconds, Nanoseconds, etc could be template arg
// precision: number of decimal digits
std::string DurationToSecondsString(const Interval::Duration& duration, int precision = 2);
std::string TimepointToSecondsString(const Interval::Timepoint& timepoint, int precision = 2);
// digits: cut Timepoint strings to a number of digits (including decimals)
std::string IntervalToSecondsString(const Interval& interval, int precision = 2, int digits = 6);
std::string IntervalToNanosecondsString(const Interval& interval);

class IntervalSet {
public:
  IntervalSet() = default;
  explicit IntervalSet(Interval interval) : intervals_({interval}) { }
  IntervalSet(Interval::Timepoint begin, Interval::Timepoint end) : intervals_({Interval(begin, end)}) { }

  size_t Size() const { return intervals_.size(); }

  // Adds interval to set only if there is no overlap
  bool AddInterval(const Interval& interval);

  // Adds interval to set, merging any overlapping intervals
  void MergeInterval(const Interval& interval);

  // Cuts into interval set, shortening overlapping intervals
  // and removing wholly contained intervals
  void CarveInterval(const Interval& interval);

  // Remove all overlapping intervals from set
  void RemoveOverlappingIntervals(const Interval& interval);

  // Remove interval from set if it exists
  bool RemoveInterval(const Interval& interval);

  // Range based for loop directly gives intervals. Only const iteration allowed.
  // lint rule is disabled because begin and end are the required names for this.
  // NOLINTNEXTLINE(readability-identifier-naming)
  typename std::set<Interval>::const_iterator begin() const { return intervals_.cbegin(); }
  // NOLINTNEXTLINE(readability-identifier-naming)
  typename std::set<Interval>::const_iterator end() const { return intervals_.cend(); }
  // NOLINTNEXTLINE(readability-identifier-naming)
  typename std::set<Interval>::const_reverse_iterator rbegin() const { return intervals_.crbegin(); }

private:
  // Since < wouldn't really make sense for intervals in a general sense, we need a custom
  // comparator.
  struct IntervalSorter {
    bool operator()(const Interval& lhs, const Interval& rhs) const { return lhs.Before(rhs); }
  };
  std::set<Interval, IntervalSorter> intervals_;
};

}  // namespace volley

namespace std {
// NOLINTNEXTLINE(readability-identifier-naming)
std::string to_string(const volley::Interval& interval);
// NOLINTNEXTLINE(readability-identifier-naming)
std::string to_string(const volley::Interval::Timepoint& time);
}  // namespace std
</file>

