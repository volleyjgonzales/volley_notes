namespace volley {

class AgvSearchEnvironment : public SearchEnvironment<GaragePoseMsg, Interval::Duration> {
public:
  AgvSearchEnvironment(const volley::DiscreteGarageState& base_state, const volley::GarageGraph& graph,
      const GraphFilterProperties& filters) :
      base_state_(base_state),
      graph_(graph),
      filters_(filters)  //, edge_durations_(GetEdgeDurations(graph))
                         // TODO(Gunther): Take edge durations as a parameter and calculate them
                         // only once
  { }

  ~AgvSearchEnvironment() override = default;
  AgvSearchEnvironment(const AgvSearchEnvironment&) = delete;
  AgvSearchEnvironment& operator=(const AgvSearchEnvironment&) = delete;
  AgvSearchEnvironment& operator=(AgvSearchEnvironment&&) = delete;
  AgvSearchEnvironment(AgvSearchEnvironment&&) = delete;

  bool OnExpansion(const GaragePoseMsg& state, const Interval::Duration&, const SearchMetaData&) override;
  std::vector<std::pair<GaragePoseMsg, Interval::Duration>> GetNeighbors(const GaragePoseMsg& state) override;
  void OnDiscovery(const GaragePoseMsg&, const Interval::Duration&) override { }
  void OnUpdate(const GaragePoseMsg&, const Interval::Duration&, const Interval::Duration&) override { }

  Interval::Duration GetHeuristic(const GaragePoseMsg&) override;

  const std::vector<GaragePoseMsg>& GetSortedDestinations() const { return valid_destinations_; }

private:
  const volley::DiscreteGarageState& base_state_;
  const volley::GarageGraph& graph_;
  const GraphFilterProperties filters_;
  // volley::GarageGraph::EdgeVectorPropertryMap edge_durations_;
  std::vector<GaragePoseMsg> valid_destinations_;
};

// Searches for a matching with the least amount of AGV moves that results in
// a discrete garage state where all AGVs are hidden under trays.
std::pair<bool, std::unordered_map<uint16_t, GaragePoseMsg>> HideAgvs(
    const volley::DiscreteGarageState& base_state, const volley::CollisionTable& table);

}  // namespace volley
