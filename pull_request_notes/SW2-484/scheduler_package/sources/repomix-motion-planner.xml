namespace {
std::string DateString(volley::Interval::Timepoint time_point) {
  time_t time = std::chrono::system_clock::to_time_t(time_point);
  const auto local_tm = localtime(&time);
  std::stringstream ss;
  ss << std::put_time(local_tm, "%H:%M:%S");
  return ss.str();
}
