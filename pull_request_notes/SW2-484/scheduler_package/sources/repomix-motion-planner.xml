<file path="include/motion_planner/static_graph_filtering.hpp">
#pragma once
#include <common/types.hpp>
#include <common_ros/collision_geometry.hpp>
#include <common_ros/discrete_garage_state.hpp>
#include <common_ros/garage_graph.hpp>

namespace volley {

// Helper functions for filtering GarageGraph nodes/edges

class GraphFilterProperties {
public:
  GraphFilterProperties() = default;

  GraphFilterProperties(const volley::GarageGraph::VertexVectorPropertyMap<bool>& vfilter,
      const volley::GarageGraph::EdgeVectorPropertyMap<bool>& efilter) :
      vertex_filter_(vfilter), edge_filter_(efilter) { }

  GraphFilterProperties(volley::GarageGraph::VertexVectorPropertyMap<bool>&& vfilter,
      volley::GarageGraph::EdgeVectorPropertyMap<bool>&& efilter) :
      vertex_filter_(std::move(vfilter)), edge_filter_(std::move(efilter)) { }

  GraphFilterProperties(const volley::GarageGraph& graph,
      const std::unordered_set<volley::CollisionTable::Pose>& disabled_poses,
      const std::unordered_set<volley::CollisionTable::Edge>& disabled_edges);

  // Note: These functions offer no bounds checking.
  bool IsEnabled(const volley::GarageGraph::Vertex& vertex) const { return vertex_filter_[vertex]; }
  bool IsEnabled(const volley::GarageGraph::Edge& edge) const { return edge_filter_[edge]; }
  void AddProperty(const volley::GarageGraph::Edge& edge, const bool val) { edge_filter_[edge] = val; }
  void AddProperty(const volley::GarageGraph::Vertex& vertex, const bool val) {
    vertex_filter_[vertex] = val;
  }

private:
  volley::GarageGraph::VertexVectorPropertyMap<bool> vertex_filter_;
  volley::GarageGraph::EdgeVectorPropertyMap<bool> edge_filter_;
};

// Returns graph filter property for given collision id type
// The filter property for a vertex or an edge is set to false if the given resource type would be
// in collision with another entity in the input state or if the corresponding pose/edge is
// disabled.
GraphFilterProperties GetStaticFilter(const volley::CollisionEntityId_t& collision_id,
    const volley::GarageGraph& gg, const volley::DiscreteGarageState& dgs,
    const volley::CollisionTable& ctable, const std::unordered_set<uint16_t>& ignore_trays,
    const std::unordered_set<uint16_t>& ignore_agvs, const std::unordered_set<uint16_t>& ignore_bays);

// Returns a dictionary of GraphFilterProperties for all collision id types in the input
// corresponding to the input discrete garage state and information on ignored entities
std::unordered_map<volley::CollisionEntityId_t, GraphFilterProperties> GetAllStaticFilters(
    const volley::GarageGraph& gg, const volley::DiscreteGarageState& dgs,
    const volley::CollisionTable& ctable, const std::unordered_set<uint16_t>& ignored_trays,
    const std::unordered_set<uint16_t>& ignored_agvs, const std::unordered_set<uint16_t>& ignored_bays);

// Returns a dictionary of GraphFilterProperties for all collision id types in the input
// discrete garage states
std::unordered_map<volley::CollisionEntityId_t, GraphFilterProperties> GetDisabledEntitiesFilters(
    const volley::GarageGraph& gg, const volley::DiscreteGarageState& dgs,
    const volley::CollisionTable& ctable);

}  // namespace volley
