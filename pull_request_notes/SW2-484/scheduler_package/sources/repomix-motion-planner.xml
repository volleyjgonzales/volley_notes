SippEnvironment::SippEnvironment(const GarageGraph& graph, const EdgeDurations& edge_durations,
    const std::vector<SippGoal>& goals, const SafeIntervalTable& safe_intervals,
    const HeuristicMap& heuristics, const GraphConstraints& constraints, Interval::Duration wheel_turn_time,
    cost::MotionCostParams motion_params) :
    graph_(graph),
    edge_durations_(edge_durations),
    goals_(goals),
    safe_intervals_(safe_intervals),
    heuristics_(heuristics),
    constraints_(constraints),
    wheel_turn_time_(wheel_turn_time),
    motion_params_(motion_params) {
  // check heuristic map input size
  if(heuristics.size() != graph.NumVertices()) {
    throw std::invalid_argument("Heuristic cost matrix size is not proper size");
  }
  for(auto& h : heuristics) {
    if(h.size() != graph.NumVertices()) {
      throw std::invalid_argument("Heuristic cost matrix size is not proper size");
    }
  }
  // TODO (mark): other validation checks maybe
}

SippEnvironment::SippEnvironment(const SippEnvironment& other) :
    graph_(other.graph_),
    edge_durations_(other.edge_durations_),
    goals_(other.goals_),
    safe_intervals_(other.safe_intervals_),
    heuristics_(other.heuristics_),
    constraints_(other.constraints_),
    wheel_turn_time_(other.wheel_turn_time_),
    motion_params_(other.motion_params_) {
}

SippEnvironment::Neighbors SippEnvironment::GetNeighbors(const SippState& parent) {
  Neighbors neighbors;

  // Check if goal for this node is completable from this state
  // no neighbors if not
  if(!GoalIsCompletable(parent)) {
    return neighbors;
  }

  // Get goal index for neighbor states
  size_t neighbor_goal_idx = parent.GetGoalIndex();
  if(StateCompletesGoal(parent)) {
    neighbor_goal_idx++;
  }

  // All edge traversals at neighbor source vertex now or in the future
  std::vector<std::pair<Edge, Interval>> traversals = GetTraversableEdges(parent, neighbor_goal_idx);

  // Add traversal and wait for traversal for move-to type goals
  // TODO (mark): refactor logic on when waiting-type neighbors are added
  const auto& goal = goals_[neighbor_goal_idx];

  const auto& wait_opt = goal.GetWaitDuration();
  if(!wait_opt) {
    // No wait duration for goal
    // Add all neighbors that corresponding to traversing an edge that is available now
    // These neighbors exist reguardless if parent state is waiting or traversing
    AddTraversalNeighbors(parent, traversals, neighbor_goal_idx, neighbors);

    // For states that are travesing an edge, also add neighbors corresponding to
    // waiting for one of the next traversal edges to become available
    AddWaitForTraversalNeighbors(parent, traversals, neighbor_goal_idx, neighbors);
  }

  // Add neighbor for pure wait type goal, or for move to vertex and wait type landmark goal
  AddWaitForGoalNeighbor(parent, neighbor_goal_idx, neighbors);

  return neighbors;
}

Interval::Duration SippEnvironment::GetHeuristic(const SippState& state) {
  // TODO (mark): Heuristic could also take into consideration the collision id for the goal
  //  need different heuristic matrix for each collision id type

  Vertex current_vertex = state.GetTarget();
  Interval::Duration h_val(0);

  for(auto goal_idx = state.GetGoalIndex(); goal_idx < goals_.size(); ++goal_idx) {
    auto& current_goal = goals_[goal_idx];
    auto goal_target_opt = current_goal.GetTargetLocation();

    if(!goal_target_opt) {
      // Pure wait-type goals do not add to heuristic
      continue;
    }
    auto goal_target = goal_target_opt.value();

    Vertex next_vertex = 0;
    if(std::holds_alternative<Vertex>(goal_target)) {
      next_vertex = std::get<Vertex>(goal_target);
    }
    else if(std::holds_alternative<Edge>(goal_target)) {
      next_vertex = boost::source(std::get<Edge>(goal_target), graph_.GetBaseGraph());
    }
    h_val += heuristics_[current_vertex][next_vertex];

    current_vertex = next_vertex;
  }

  return h_val;
}

bool SippEnvironment::OnExpansion(const SippState& state,
    [[maybe_unused]] const Interval::Duration& cost_so_far, [[maybe_unused]] const SearchMetaData& meta) {
  // check if state completes last goal, we are done if so
  size_t completed_goals = state.GetGoalIndex();

  if(StateCompletesGoal(state)) {
    completed_goals++;
  }

  // end search if state completed last goal
  return completed_goals == goals_.size();
}

bool SippEnvironment::StateCompletesGoal(const SippState& state) const {
  const auto& current_goal_idx = state.GetGoalIndex();
  const auto& target_opt = goals_[current_goal_idx].GetTargetLocation();
  const auto& wait_opt = goals_[current_goal_idx].GetWaitDuration();
  const auto& landmark_opt = goals_[current_goal_idx].GetLandmarkInterval();

  // If goal is waiting, check if state is waiting and duration matches
  if(wait_opt) {
    return (state.GetSource() == state.GetTarget()) &&
           (state.GetInterval().GetDuration() == wait_opt.value());
  }

  // Check if arrival/traversal is met for goto and landmark-type goals
  bool completes_arrival = true;
  if(target_opt) {
    const auto& goal_target = target_opt.value();
    if(std::holds_alternative<Vertex>(goal_target)) {
      // check if state vertex == goal vertex
      completes_arrival = state.GetTarget() == std::get<Vertex>(goal_target);
    }
    else if(std::holds_alternative<Edge>(goal_target) && (state.GetSource() != state.GetTarget())) {
      // check if state edge == goal edge
      Edge edge = graph_.EdgeFromVertices(state.GetSource(), state.GetTarget()).value();
      completes_arrival = edge == std::get<Edge>(goal_target);
    }
    else if(std::holds_alternative<Edge>(goal_target) && (state.GetSource() == state.GetTarget())) {
      // waiting doesn't complete an edge target
      completes_arrival = false;
    }
  }

  // TODO (mark): Check if *next* goal is a lifting/waiting type, and if it is check that it is
  // safe to wait (if not we must keep moving for now). Ideas: Add 'slack' to state, if a goal
  // requires more time to complete allow slack to be used to geneate a waiting state earlier in
  // the path

  // If not a landmark or a wait, just return if we reached target
  if(!landmark_opt) {
    // TODO(Gunther):
    // For sequential planning, we solve one goal at a time. If the goal is a move-to goal, we
    // need to enforce that we can wait at the target location forever. This ensures that we
    // don't "complete" a goal by moving directly into the path of an already planned event.
    if(completes_arrival) {
      Interval remain_interval(state.GetInterval().GetEnd(), Interval::Timepoint::max());
      volley::CollisionEntityId_t collision_id = goals_[current_goal_idx].GetCollisionId();

      // Right now we're just using GetTarget() because sequential planning doesn't
      // automatically generate landmark constraints (i think (maybe not actually))
      auto is_safe_forevermore = not safe_intervals_.IsIntervalConstrained(
          std::make_pair(collision_id, state.GetTarget()), remain_interval);

      // If we're not safe, we can't complete the goal, but moving here is still valid
      return is_safe_forevermore;
    }
    else {
      return false;
    }
  }

  // Goal is a landmark, check interval
  const Interval& goal_interval = landmark_opt.value();
  return (completes_arrival && goal_interval == state.GetInterval());
}

bool SippEnvironment::GoalIsCompletable(const SippState& state) const {
  // Goal is not completable if it is a landmark and current interval exceeds landmark interval
  const auto& landmark_opt = goals_[state.GetGoalIndex()].GetLandmarkInterval();
  if(landmark_opt) {
    const Interval& landmark_interval = landmark_opt.value();
    if(state.GetInterval().GetEnd() > landmark_interval.GetBegin()) {
      return false;
    }
  }
  // Otherwise assume it is completable
  return true;
}

std::vector<std::pair<SippEnvironment::Edge, Interval>> SippEnvironment::GetTraversableEdges(
    const SippState& parent, size_t neighbor_goal_idx) const {
  const Vertex& source_vertex = parent.GetTarget();
  volley::CollisionEntityId_t collision_id = goals_[neighbor_goal_idx].GetCollisionId();

  std::vector<std::pair<Edge, Interval>> traversals;

  auto [edge_begin, edge_end] = graph_.GetOutEdges(source_vertex);
  for(auto it = edge_begin; it != edge_end; ++it) {
    Edge edge = *it;
    auto edge_dur = edge_durations_[edge];
    auto target_vertex = boost::target(edge, graph_.GetBaseGraph());
    auto target_pose = graph_.GetPoseFromVertex(target_vertex).value();

    // Can't traverse edge if target vertex is disabled
    // TODO (mark):  this bound check for collision_id shouldn't be necessary
    //  currently it is a method to deal with ProcessRetrieve occuring before agv lift down
    //  in the retrieve scenario with only 1 tray with a payload (tray constraint doesn't exist)
    if(constraints_.find(collision_id) != constraints_.end()) {
      if(!(constraints_.at(collision_id).IsEnabled(target_vertex))) {
        continue;
      }

      // Can't traverse edge if edge is disabled
      if(!(constraints_.at(collision_id).IsEnabled(edge))) {
        continue;
      }
    }

    // Check that CollisionId fits at the target pose
    LayoutSPtr layout = graph_.GetLayout();
    auto node_msg = layout->GetNodeById(target_pose.node_id).value();

    // TODO(Gunther): Look into making sure we're using static filters here.
    if(collision_id > node_msg.max_resource_size_index +
                          static_cast<volley::CollisionEntityId_t>(volley::CollisionEntityId::PAYLOAD)) {
      continue;
    }

    // Check that the NodeType isn't AgvChargeNode
    if(node_msg.type == GarageNodeMsg::TYPE_AGV_CHARGE &&
        collision_id != static_cast<volley::CollisionEntityId_t>(volley::CollisionEntityId::AGV)) {
      continue;
    }

    // Find next interval it is safe to traverse edge
    Interval::Timepoint edge_start = parent.GetInterval().GetEnd();
    std::optional<Interval> next_edge_interval = std::nullopt;

    while(!next_edge_interval) {
      // Check if edge is ever available after edge_start
      auto edge_safe_opt = FindSafeInterval(edge, collision_id, edge_start, edge_dur);
      if(!edge_safe_opt) {
        break;
      }

      // If not available now, advance time until the minimum time we can start
      if(edge_safe_opt.value().GetBegin() > edge_start) {
        edge_start = edge_safe_opt.value().GetBegin();
      }

      // Check if arrival is ever safe during or after start of edge traversal
      Interval::Timepoint target_arrival = edge_start + edge_dur;
      auto targ_safe_opt =
          FindSafeInterval(target_vertex, collision_id, target_arrival, Interval::Duration(0));
      // Vertex is never safe at or after earliest arrival
      if(!targ_safe_opt) {
        break;
      }

      // if target is safe at proposed arrival, we have a traversable interval
      if(targ_safe_opt.value().GetBegin() <= target_arrival) {
        next_edge_interval = Interval(edge_start, target_arrival);
      }
      else {
        // advance time to next possible time we can arrive at vertex
        edge_start = targ_safe_opt.value().GetBegin() - edge_dur;
      }
    }

    // Add traversable edge if we found a time that it is safe to traverse edge
    if(next_edge_interval) {
      traversals.emplace_back(edge, next_edge_interval.value());
    }
  }

  return traversals;
}

void SippEnvironment::AddTraversalNeighbors(const SippState& parent,
    const std::vector<std::pair<Edge, Interval>>& traversals, size_t neighbor_goal_idx,
    Neighbors& neighbors) const {
  const Interval::Timepoint& current_time = parent.GetInterval().GetEnd();
  // Get parent state 'type', locomote, strafe, rotate, or wait
  // NOTE: LOCMOTE/STRAFE/ROTATE defined as enum types in GarageGraph
  //       we're using a lame magic number for 'waiting' here
  std::optional<Edge> parent_edge_opt = graph_.EdgeFromVertices(parent.GetSource(), parent.GetTarget());
  uint8_t parent_type = 99;  // 99 = waiting, this is lame
  std::optional<Transition> parent_transition;
  if(parent_edge_opt) {
    parent_transition = graph_.GetTransition(parent_edge_opt.value());
    parent_type = static_cast<uint8_t>(parent_transition.value().type);
  }
  // Pre-compute parent edge displacement (linear), parent rotation delta (angular), and
  // parent z delta (VRC) for the run-extension test below. Cheap and only used a few
  // times per neighbor.
  auto layout = graph_.GetLayout();
  Eigen::Vector2d parent_disp {0.0, 0.0};
  int parent_rotation_delta_deg = 0;
  float parent_z_delta = 0.0f;
  std::optional<uint32_t> parent_vrc_id;
  GaragePoseMsg parent_target_pose {};
  if(parent_edge_opt) {
    auto p_src = graph_.GetPoseFromVertex(parent.GetSource()).value();
    auto p_dst = graph_.GetPoseFromVertex(parent.GetTarget()).value();
    parent_target_pose = p_dst;
    if(parent_type == static_cast<uint8_t>(TransitionType::LOCOMOTE) ||
        parent_type == static_cast<uint8_t>(TransitionType::STRAFE)) {
      auto p_src_node = layout->GetNodeById(p_src.node_id);
      auto p_dst_node = layout->GetNodeById(p_dst.node_id);
      if(p_src_node && p_dst_node) {
        parent_disp = Eigen::Vector2d {p_dst_node->x - p_src_node->x, p_dst_node->y - p_src_node->y};
      }
    }
    else if(parent_type == static_cast<uint8_t>(TransitionType::ROTATION)) {
      parent_rotation_delta_deg =
          volley::Wrap(static_cast<int>(p_dst.heading) - static_cast<int>(p_src.heading));
    }
    else if(parent_type == static_cast<uint8_t>(TransitionType::VRC_TRANSITION)) {
      auto p_src_z = layout->GetFloorZForNodeId(p_src.node_id);
      auto p_dst_z = layout->GetFloorZForNodeId(p_dst.node_id);
      if(p_src_z && p_dst_z) {
        parent_z_delta = p_dst_z.value() - p_src_z.value();
      }
      auto p_dst_vrc = layout->GetVrcForNodeId(p_dst.node_id);
      if(p_dst_vrc) {
        parent_vrc_id = p_dst_vrc->id;
      }
    }
  }

  for(auto&& [edge, edge_interval] : traversals) {
    // If edge is not safe to traverse starting now, don't add it as neighbor state
    // Waiting states added in AddWaitForTraversalNeighbors
    if(edge_interval.GetBegin() > current_time) {
      continue;
    }

    // Wheel-turn delay applies whenever the AGV switches between LOCOMOTE / STRAFE / ROTATE.
    // It shifts the actual traversal start (so timing is honest) and adds to the search cost
    // so A* prefers paths with fewer mode changes. The initial state (parent_type == 99,
    // "waiting") and any VRC transition do not pay the cost.
    auto transition_opt = graph_.GetTransition(edge);
    auto transition = transition_opt.value();
    const auto is_drive = [](uint8_t t) {
      return t == static_cast<uint8_t>(TransitionType::LOCOMOTE) ||
             t == static_cast<uint8_t>(TransitionType::STRAFE) ||
             t == static_cast<uint8_t>(TransitionType::ROTATION);
    };
    Interval::Duration wheel_turn = Interval::Duration::zero();
    if(is_drive(parent_type) && is_drive(static_cast<uint8_t>(transition.type)) &&
        parent_type != static_cast<uint8_t>(transition.type)) {
      wheel_turn = wheel_turn_time_;
    }

    // Ring 3b: if this edge extends the parent edge's run (codirectional locomote/strafe,
    // same-sign rotation at the same node, or same-VRC same-direction VRC ride), the AGV
    // is already at vmax and the marginal cost is just cruise time `length / vmax`.
    // Otherwise the AGV is starting from rest and pays the full Trapezoid (precomputed in
    // edge_durations_). Telescopes correctly across an N-edge run: full Trapezoid(d_1) +
    // sum d_i/v_max == Trapezoid(D) for trapezoidal runs.
    bool extends_run = false;
    if(parent_edge_opt && parent_type == static_cast<uint8_t>(transition.type)) {
      auto curr_src = graph_.GetPoseFromVertex(boost::source(edge, graph_.GetBaseGraph())).value();
      auto curr_dst = graph_.GetPoseFromVertex(boost::target(edge, graph_.GetBaseGraph())).value();
      if(transition.type == TransitionType::ROTATION) {
        const int curr_delta =
            volley::Wrap(static_cast<int>(curr_dst.heading) - static_cast<int>(curr_src.heading));
        // Same node + same-sign delta as the parent rotation.
        extends_run = parent_target_pose.node_id == curr_src.node_id &&
                      curr_src.node_id == curr_dst.node_id && parent_rotation_delta_deg != 0 &&
                      curr_delta != 0 && (parent_rotation_delta_deg > 0) == (curr_delta > 0);
      }
      else if(transition.type == TransitionType::VRC_TRANSITION) {
        // Same VRC carriage entity AND same vertical direction. The mock_hw_driver and
        // chugg_sequential's VrcTransition handler both treat a multi-floor ride as one
        // continuous Motion1D — this branch keeps SIPP's edge cost honest with that.
        auto curr_vrc = layout->GetVrcForNodeId(curr_dst.node_id);
        auto curr_src_z = layout->GetFloorZForNodeId(curr_src.node_id);
        auto curr_dst_z = layout->GetFloorZForNodeId(curr_dst.node_id);
        if(parent_vrc_id && curr_vrc && curr_src_z && curr_dst_z && parent_vrc_id.value() == curr_vrc->id &&
            parent_z_delta != 0.0f) {
          const float curr_dz = curr_dst_z.value() - curr_src_z.value();
          extends_run = curr_dz != 0.0f && (parent_z_delta > 0.0f) == (curr_dz > 0.0f);
        }
      }
      else {
        // LOCOMOTE / STRAFE: codirectional displacement on layout coordinates.
        auto src_node = layout->GetNodeById(curr_src.node_id);
        auto dst_node = layout->GetNodeById(curr_dst.node_id);
        if(src_node && dst_node) {
          Eigen::Vector2d curr_disp {dst_node->x - src_node->x, dst_node->y - src_node->y};
          extends_run = volley::AreSameDirection(parent_disp, curr_disp, 0.01);
        }
      }
    }

    const auto vmax_for_type = [&](TransitionType t) -> float {
      switch(t) {
      case TransitionType::LOCOMOTE:
        return motion_params_.locomote.speed;
      case TransitionType::STRAFE:
        return motion_params_.strafe.speed;
      case TransitionType::ROTATION:
        return motion_params_.rotate.speed;
      case TransitionType::VRC_TRANSITION:
        return motion_params_.vrc_transit.speed;
      }
      return 1.0f;
    };

    Interval::Duration edge_cost;
    if(extends_run) {
      const float v = vmax_for_type(transition.type);
      const float cruise_seconds = static_cast<float>(transition.length) / v;
      edge_cost = std::chrono::duration_cast<Interval::Duration>(cost::SecondsF(cruise_seconds));
    }
    else {
      edge_cost = edge_interval.GetDuration();
    }

    // Build the state's actual time interval from the path-dependent edge_cost (NOT
    // edge_interval.GetEnd() which uses the precomputed full Trapezoid). This is what the
    // Motion's interval becomes — both the audit and downstream deconfliction reservations
    // see the run-aware duration.
    Interval shifted_interval(
        edge_interval.GetBegin() + wheel_turn, edge_interval.GetBegin() + wheel_turn + edge_cost);

    Interval::Duration cost = edge_cost + wheel_turn + (kMagicPredecessorCost * parent.GetPredecessorCount());

    // Add state
    auto source_vertex = boost::source(edge, graph_.GetBaseGraph());
    auto target_vertex = boost::target(edge, graph_.GetBaseGraph());
    SippState neighbor_state(
        source_vertex, target_vertex, shifted_interval, neighbor_goal_idx, parent.GetPredecessorCount() + 1);
    neighbors.emplace_back(std::make_pair(neighbor_state, cost));
  }
}

void SippEnvironment::AddWaitForTraversalNeighbors(const SippState& parent,
    const std::vector<std::pair<Edge, Interval>>& traversals, size_t neighbor_goal_idx,
    Neighbors& neighbors) const {
  if(parent.GetSource() == parent.GetTarget() &&
      parent.GetInterval().GetBegin() != parent.GetInterval().GetEnd()) {
    // Don't chain waiting states. If we've already waited, we've generated
    // a wait for all possible traversals and don't need to combinationally
    // generate waits for each possible traversal.
    // 0 duration waiting state is used for initialization, we can wait off that
    return;
  }

  if(traversals.size() == 0) {
    // If there are no possible traversals, there is nothing to wait for
    return;
  }

  const Interval::Timepoint& current_time = parent.GetInterval().GetEnd();

  // waiting location for neighbor is parent target vertex
  const Vertex& src_vertex = parent.GetTarget();
  volley::CollisionEntityId_t collision_id = goals_[neighbor_goal_idx].GetCollisionId();

  // Cost to wait is minimum duration of all possible edge traversals
  // This is to avoid solutions where AGV goes back and forth on an edge
  auto min_traverse_it = std::min_element(traversals.begin(), traversals.end(),
      [](const std::pair<Edge, Interval>& a, const std::pair<Edge, Interval>& b) {
        return a.second.GetDuration() < b.second.GetDuration();
      });
  Interval::Duration wait_cost = min_traverse_it->second.GetDuration() / 2;
  // TODO(Gunther): Above doesn't make any sense to me yet.

  // For each traversal -- if the edge is not currently traversable, add a
  // waiting state that waits for each safe interval to traverse the edge at
  // that point in the future instead. This is so that we generate a minimum
  // number of required wait states without chaining waits -- as well as
  // preventing an explosion of states from waiting at every possible time for
  // a traversable edge.
  for(auto [edge, edge_interval] : traversals) {
    auto all_safe_edge_intervals = safe_intervals_.GetAllSafeIntervals(collision_id, edge);

    auto edge_dur = edge_durations_[edge];
    for(const auto& safe_interval : all_safe_edge_intervals) {
      if(safe_interval.GetBegin() <= current_time && safe_interval.GetEnd() >= current_time + edge_dur) {
        // If the current time is within the safe interval, we can traverse the edge
        // now and don't need to wait
        continue;
      }

      if(std::max(safe_interval.GetBegin(), current_time) + edge_dur >= safe_interval.GetEnd()) {
        // the safe interval is shorter than the edge duration so there
        // is no point in waiting since this edge will never be
        // traversable anyway
        continue;
      }

      auto wait_duration = safe_interval.GetBegin() - current_time;
      auto src_vertex_safe_opt = FindSafeInterval(src_vertex, collision_id, current_time, wait_duration);

      if(!src_vertex_safe_opt || src_vertex_safe_opt.value().GetBegin() > current_time) {
        continue;
      }

      wait_cost = wait_duration / 2 + (kMagicPredecessorCost * parent.GetPredecessorCount());

      // Add wait neighbor state if it is safe to wait at current vertex
      Interval wait_interval(current_time, current_time + wait_duration);
      SippState neighbor_state(
          src_vertex, src_vertex, wait_interval, neighbor_goal_idx, parent.GetPredecessorCount() + 1);

      neighbors.emplace_back(std::make_pair(neighbor_state, wait_cost));
    }
  }
}

void SippEnvironment::AddWaitForGoalNeighbor(
    const SippState& parent, size_t neighbor_goal_idx, Neighbors& neighbors) const {
  const auto& goal = goals_[neighbor_goal_idx];
  const auto& wait_opt = goal.GetWaitDuration();
  const auto& lm_opt = goal.GetLandmarkInterval();
  const auto& targ_opt = goal.GetTargetLocation();

  Vertex current_vertex = parent.GetTarget();
  const auto& current_time = parent.GetInterval().GetEnd();

  // edge goals are not waiting type goals
  if(targ_opt && std::holds_alternative<Edge>(targ_opt.value())) {
    return;
  }

  // if there is no wait duration or landmark interval, not a wait goal
  if(!wait_opt && !lm_opt) {
    return;
  }

  // Waiting duration from wait_opt or from landmark_opt interval duration
  Interval::Duration wait_dur(0);
  if(wait_opt) {
    wait_dur = wait_opt.value();
  }
  else if(lm_opt) {
    wait_dur = lm_opt.value().GetDuration();
    Vertex target_vertex = std::get<Vertex>(targ_opt.value());
    if(current_vertex != target_vertex) {
      // only wait if we are at the landmark waiting location
      return;
    }
  }

  auto wait_safe = FindSafeInterval(current_vertex, goal.GetCollisionId(), current_time, wait_dur);
  if(!wait_safe || wait_safe.value().GetBegin() > current_time) {
    // Don't wait if it's not safe
    return;
  }

  // Add waiting neighbor, cost is 0 to wait for goals that explicitly require it
  Interval wait_interval(current_time, current_time + wait_dur);
  SippState neighbor_state(
      current_vertex, current_vertex, wait_interval, neighbor_goal_idx, parent.GetPredecessorCount() + 1);
  neighbors.emplace_back(std::make_pair(neighbor_state, Interval::Duration(0)));
}

}  // namespace volley
