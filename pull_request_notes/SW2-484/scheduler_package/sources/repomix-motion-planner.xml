#include "motion_planner/sipp_agv.hpp"

#include <rclcpp/rclcpp.hpp>
#include <type_traits>

namespace volley {

SippAgv::SippAgv(const GarageGraph& graph, const CollisionTable& geometry,
    const GarageGraph::EdgeVectorPropertyMap<Interval::Duration>& edge_costs,
    const SippEnvironment::HeuristicMap& heuristics, const DiscreteAgvStateMsg& initial_state,
    const Interval::Timepoint& initial_time, Interval::Duration wheel_turn_time,
    cost::MotionCostParams motion_params) :
    graph_(graph),
    geometry_(geometry),
    edge_costs_(edge_costs),
    heuristics_(heuristics),
    initial_state_(initial_state),
    initial_time_(initial_time),
    wheel_turn_time_(wheel_turn_time),
    motion_params_(motion_params) {
}

std::optional<Trajectory> SippAgv::PlanTrajectory(const GraphConstraints& constraints) {
  GarageGraph::Vertex initial_vertex = graph_.GetVertexFromPose(initial_state_.pose).value();
  Interval initial_interval(initial_time_, initial_time_);
  SippState initial_state(initial_vertex, initial_vertex, initial_interval, 0);

  std::vector<SippGoal> solve_goals;
  for(auto& goal_and_event_id : all_goals_) {
    solve_goals.push_back(goal_and_event_id.first);
  }

  SippEnvironment sipp_env(
      graph_, edge_costs_, solve_goals, sit_, heuristics_, constraints, wheel_turn_time_, motion_params_);
  auto solution = SingleSourceSearch(initial_state, Interval::Duration(0), sipp_env);

  if(solution.GetTarget()) {
    return SolutionToTrajectory(solution, all_events_, all_goals_);
  }

  return std::nullopt;
}

std::optional<Trajectory> SippAgv::PlanEvents(std::vector<size_t> plan_events,
    const DiscreteAgvStateMsg& init_state, const Interval::Timepoint& init_time,
    const GraphConstraints& constraints) {
  GarageGraph::Vertex initial_vertex = graph_.GetVertexFromPose(init_state.pose).value();
  SippState initial_state(initial_vertex, initial_vertex, Interval(init_time, init_time), 0);

  // Sanity check events
  for(auto event_id : plan_events) {
    if(all_events_.find(event_id) == all_events_.end()) {
      throw std::invalid_argument("Event id " + std::to_string(event_id) +
                                  " does not have an associated goal. (Did you use AddEventGoal?)");
    }
  }

  // Add all event and landmark goals corresponding to events ids in plan_events
  std::vector<SippGoal> solve_goals;

  // TODO (mark): refactor goal keeping & SolutionToTrajectoy so we don't need this redudancy
  std::vector<std::pair<SippGoal, size_t>> goal_seq_event_ids;
  for(auto& [goal, event_id] : all_goals_) {
    // eww
    auto it = std::find(plan_events.begin(), plan_events.end(), event_id);
    if(it != plan_events.end()) {
      solve_goals.push_back(goal);
      goal_seq_event_ids.emplace_back(goal, event_id);
    }
  }

  SippEnvironment sipp_env(
      graph_, edge_costs_, solve_goals, sit_, heuristics_, constraints, wheel_turn_time_, motion_params_);
  auto solution = SingleSourceSearch(initial_state, Interval::Duration(0), sipp_env);

  if(!solution.GetTarget()) {
    const auto& meta = solution.GetMetaData();
    auto logger = rclcpp::get_logger("sipp_agv");
    RCLCPP_ERROR_STREAM(logger, "SIPP failed: n_closed=" << meta.n_closed
                                                         << " n_discovered=" << meta.n_discovered
                                                         << " n_goals=" << solve_goals.size());
    RCLCPP_ERROR_STREAM(logger, "  initial pose: " << std::to_string(init_state.pose));
    for(size_t i = 0; i < solve_goals.size(); ++i) {
      const auto& g = solve_goals[i];
      std::string goal_str = g.ToString(graph_);
      if(g.GetTargetLocation() &&
          std::holds_alternative<GarageGraph::Vertex>(g.GetTargetLocation().value())) {
        auto v = std::get<GarageGraph::Vertex>(g.GetTargetLocation().value());
        auto pose_opt = graph_.GetPoseFromVertex(v);
        goal_str += " [vertex=" + std::to_string(v) +
                    " pose=" + (pose_opt ? std::to_string(pose_opt.value()) : "NONE") + "]";
      }
      RCLCPP_ERROR_STREAM(logger, "  goal[" << i << "]: " << goal_str);
    }
    return std::nullopt;
  }

  return SolutionToTrajectory(solution, all_events_, goal_seq_event_ids);
}

Trajectory SippAgv::SolutionToTrajectory(SippSolution& solution,
    std::unordered_map<size_t, std::shared_ptr<const ScheduleEvent>> all_events,
    std::vector<std::pair<SippGoal, size_t>> all_goals) {
  Trajectory trajectory;
  auto agv_id = GetEntityId();
  auto path_opt = solution.GetPath(solution.GetTarget().value());
  if(path_opt) {
    // NOTE: path_opt should always have a value if solution.GetTarget() does
    for(const auto& [state, cost] : path_opt.value()) {
      Interval interval(state.GetInterval());

      if(interval.GetDuration() == Interval::Duration(0)) {
        // First state is 0 duration @ end of initial trajectory
        // Don't need to add this as a 'motion' for trajectory
        continue;
      }

      auto goal_idx = state.GetGoalIndex();
      auto src_pose = graph_.GetPoseFromVertex(state.GetSource()).value();
      auto dst_pose = graph_.GetPoseFromVertex(state.GetTarget()).value();
      auto collision_id = all_goals[goal_idx].first.GetCollisionId();

      auto event_id = all_goals[goal_idx].second;
      auto event = all_events[event_id];

      if(src_pose == dst_pose) {
        if(event->GetType() == volley::ScheduleEventType::AGV_MOVE &&
            std::holds_alternative<AgvLiftChangedMsg>(
                std::dynamic_pointer_cast<const volley::AgvMove>(event)->GetDiscreteChange())) {
          // lift if corresponding event is for lifting
          auto change = std::get<AgvLiftChangedMsg>(
              std::dynamic_pointer_cast<const volley::AgvMove>(event)->GetDiscreteChange());
          Motion motion(agv_id, interval, collision_id, event_id, change, dst_pose);
          trajectory.AddMotion(motion);
        }
        else {
          // wait
          Motion motion(agv_id, interval, collision_id, event_id, dst_pose);
          trajectory.AddMotion(motion);
        }
      }
      else {
        // moving
        Motion motion(agv_id, interval, collision_id, event_id, Motion::Edge {src_pose, dst_pose});
        trajectory.AddMotion(motion);
      }
    }
    return trajectory;
  }
  return trajectory;
}

void SippAgv::AddEventGoal(
    std::shared_ptr<const volley::AgvMove> event, size_t event_id, CollisionEntityId_t collision_id) {
  auto sipp_goal =
      std::visit([this, collision_id](auto&& change) { return GoalFromDiscreteChange(change, collision_id); },
          event->GetDiscreteChange());

  all_goals_.emplace_back(sipp_goal, event_id);
  all_events_[event_id] = std::static_pointer_cast<const ScheduleEvent>(event);
  all_collision_ids_.insert(collision_id);
}

void SippAgv::AddEventGoal(std::shared_ptr<const volley::TrayMove> event, size_t event_id,
    CollisionEntityId_t collision_id, bool agv_reciprocal) {
  // Tray destination
  auto dest_opt = event->GetDest();
  if(!dest_opt) {
    throw std::logic_error("Tray event has no specified destination");
  }

  // Get AGV coordinate discrete change
  AgvPoseChangedMsg change;
  change.agv_id = initial_state_.id;
  change.node_id_next = dest_opt.value().node_id;
  change.heading_next =
      agv_reciprocal ? volley::ReciprocalAngle(dest_opt.value().heading) : dest_opt.value().heading;

  // NOTE: SippGoal doesn't need current pose info to be constructed
  // (later inferred from prior goal in sequence or initial state)

  auto sipp_goal = GoalFromDiscreteChange(change, collision_id);

  all_goals_.emplace_back(sipp_goal, event_id);
  all_events_[event_id] = std::static_pointer_cast<const ScheduleEvent>(event);
  all_collision_ids_.insert(collision_id);
}

SippGoal SippAgv::GoalFromDiscreteChange(const AgvPoseChangedMsg& change, CollisionEntityId_t collision_id) {
  auto target_vertex =
      graph_.GetVertexFromPose(volley::ConstructGaragePose(change.node_id_next, change.heading_next));
  return SippGoal(collision_id, target_vertex);
}

SippGoal SippAgv::GoalFromDiscreteChange(const AgvLiftChangedMsg& change, CollisionEntityId_t collision_id) {
  const auto lift_seconds =
      change.raised ? motion_params_.events.agv_lift_up : motion_params_.events.agv_lift_down;
  auto lift_change_dur = std::chrono::duration_cast<Interval::Duration>(cost::SecondsF(lift_seconds));
  return SippGoal(collision_id, std::nullopt, lift_change_dur);
}

void SippAgv::AddLandmarkGoal(const Motion& motion) {
  // TODO (mark): related to refactoring goals todo, this is an example of why the
  //  current method is lame

  // get insertion point
  auto lm_interval = motion.GetInterval();
  auto lm_event_id = motion.GetActionId();
  auto lm_coll_id = motion.GetCollisionId();

  // lame insertion index logic
  size_t insert_idx = 0;
  for(insert_idx = 0; insert_idx < all_goals_.size(); ++insert_idx) {
    auto& [goal, event_id] = all_goals_[insert_idx];
    if((event_id == lm_event_id && !goal.GetLandmarkInterval()) ||
        (event_id == lm_event_id && goal.GetLandmarkInterval() &&
            lm_interval.GetBegin() < goal.GetLandmarkInterval().value().GetBegin())) {
      // Insert landmarks for the same event id in time-order
      // landmarks always preceed event of that id
      break;
    }
  }

  // make a goal
  auto offset = static_cast<int64_t>(insert_idx);
  auto lm_target = std::visit(
      [this](auto&& loc) -> std::optional<std::variant<SippGoal::Vertex, SippGoal::Edge>> {
        using T = std::decay_t<decltype(loc)>;
        if constexpr(std::is_same_v<T, Motion::Pose>) {
          return graph_.GetVertexFromPose(loc);
        }
        else {
          return graph_.EdgeFromPoses(loc[0], loc[1]);
        }
      },
      motion.GetLocation());
  auto lm_goal =
      std::make_pair(SippGoal(lm_coll_id, lm_target, std::nullopt, motion.GetInterval()), lm_event_id);
  all_goals_.insert(all_goals_.begin() + offset, lm_goal);
}

void SippAgv::AddAvoidConstraint(const Motion& motion) {
  AddLocationConstraint(motion.GetCollisionId(), motion.GetLocation(), motion.GetInterval());
}

void SippAgv::AddDeconflictConstraints(const Motion& motion) {
  // NOTE: assumes tray motions are only for intervals where tray is placed

  // Don't need to deconflict with bay idling in RTR
  if(ContinuousState::BayIsReadyToRetrieve(motion)) {
    return;
  }

  if(motion.GetEntityId().entity_type == "v") {
    return;
  }

  auto avoid_location = motion.GetLocation();
  const auto& avoid_interval = motion.GetInterval();
  CollisionEntityId_t avoid_id = motion.GetCollisionId();
  auto avoid_ent = motion.GetEntityId();

  // Get correct bay pose for bay transitions
  if(avoid_ent.entity_type == "b") {
    auto bay_head_opt = graph_.GetLayout()->GetBayInboundHeading(motion.GetEntityId().id);
    if(!bay_head_opt) {
      throw std::invalid_argument("Bay does not have an inbound heading defined by layout.");
    }
    Motion::Pose bay_pose;
    bay_pose.node_id = avoid_ent.id;
    bay_pose.heading = static_cast<int16_t>(bay_head_opt.value());
    avoid_location = bay_pose;
  }

  // Update safe intervals, avoid all poses/edges that could conflict with motion
  // TODO (mark): technically only need to do this for this agv's collision ids that overlap
  //     with the avoiding motion time interval, this could include 2 different ids
  //    (ex. deconflict motion overlaps with a move-to and pickup motion for this agv)
  //     we just do it for all of this agv's collision ids for now

  for(CollisionEntityId_t my_id : all_collision_ids_) {
    CollisionTable::PoseSet poses;
    CollisionTable::EdgeSet edges;

    // Deconfliction with a placed tray, use tray legs rather than tray collision ids for free
    // agv
    auto query_id = avoid_id;
    if(my_id == common::EnumInteger(volley::CollisionEntityId::AGV) && avoid_ent.entity_type == "t") {
      query_id = common::EnumInteger(volley::CollisionEntityId::TRAY_LEGS);
    }

    std::visit(
        [&](auto&& loc) { std::tie(poses, edges) = geometry_.Query(query_id, my_id, loc); }, avoid_location);

    for(auto& avoid_pose : poses) {
      AddLocationConstraint(my_id, avoid_pose, avoid_interval);
    }
    for(auto& avoid_edge : edges) {
      AddLocationConstraint(my_id, avoid_edge, avoid_interval);
    }
  }
}

void SippAgv::AddLocationConstraint(CollisionEntityId_t type,
    const std::variant<Motion::Pose, Motion::Edge>& location, const Interval& interval) {
  std::visit(
      [this, type, interval](
          auto&& loc) { sit_.AddConstraint(std::make_pair(type, graph_.GetFromGarageRep(loc)), interval); },
      location);
}

}  // namespace volley
