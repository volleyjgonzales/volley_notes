<file path="include/motion_planner/garage_graph_pathing.hpp">
#pragma once
#include <common/types.hpp>
#include <cost_functions/motion_cost_model.hpp>

#include "boost/graph/floyd_warshall_shortest.hpp"
#include "common_ros/garage_graph.hpp"
#include "motion_planner/interval.hpp"
#include "motion_planner/path_search.hpp"
#include "motion_planner/static_graph_filtering.hpp"
#include "motion_planner/trajectory.hpp"

namespace volley {

// Utility functions

// Make an edge property map of trapezoid-profile durations using the supplied cost model.
volley::GarageGraph::EdgeVectorPropertyMap<Interval::Duration> GetEdgeDurations(
    const volley::GarageGraph& garage_graph, const cost::MotionCostModel& cost_model);

// Per-edge marginal cruise-only durations: `length / vmax` for every edge, ignoring accel /
// decel and wheel-turn overhead. The sum along any path is a strict lower bound on the path's
// actual time (each edge's true cost ≥ length/vmax), which makes this map admissible as the
// edge-weight input to GetAllPairsMinCost when feeding SIPP's A* heuristic under Ring 3b's
// path-dependent edge costs.
volley::GarageGraph::EdgeVectorPropertyMap<Interval::Duration> GetEdgeMarginalDurations(
    const volley::GarageGraph& garage_graph, const cost::MotionCostModel& cost_model);

// Distance/Duration map for Heuristics when pathfinding
// return cost matrix is indexed by garage_graph vertices, [src][dst] = cost
// To use this for filtered graphs, modify the input cost map s.t. filtered edges
// and edges touching filtered vertices have 'infinity' cost
template <typename Cost>
std::vector<std::vector<Cost>> GetAllPairsMinCost(const volley::GarageGraph& garage_graph,
    const volley::GarageGraph::EdgeVectorPropertyMap<Cost>& cost_map, const Cost& zero,
    const Cost& infinity) {
  // Get the number of vertices in the garage_graph
  size_t num_vertices = garage_graph.NumVertices();

  // Create a distance matrix to store the shortest path durations
  std::vector<std::vector<Cost>> cost_matrix(num_vertices, std::vector<Cost>(num_vertices));

  // Run the Floyd-Warshall algorithm to calculate all-pairs shortest paths
  // O(#verts^3), could use a more efficient alg here.
  boost::floyd_warshall_all_pairs_shortest_paths(garage_graph.GetBaseGraph(), cost_matrix, cost_map,
      std::less<Cost>(), std::plus<Cost>(), infinity, zero);

  return cost_matrix;
}

// SearchEnvironment for basic vertex->vertex pathing on garage graph
// NOTE: SingeSourceSearch is overkill for this use case, we could just use boost::graph on
//       GarageGraph.base_graph_ with a helper functions for I/O. This is here for a quick
//       method stand-in for Sipp
class GarageGraphEnvironment : public SearchEnvironment<volley::GarageGraph::Vertex, Interval::Duration> {
public:
  explicit GarageGraphEnvironment(const volley::GarageGraph& graph, const cost::MotionCostModel& cost_model,
      std::optional<volley::GarageGraph::Vertex> target = std::nullopt,
      std::optional<GraphFilterProperties> filters = std::nullopt) :
      graph_(graph), cost_model_(cost_model), target_(target), filters_(filters) { }

  GarageGraphEnvironment(const GarageGraphEnvironment& other) :
      graph_(other.graph_),
      cost_model_(other.cost_model_),
      target_(other.target_),
      filters_(other.filters_) { }

  ~GarageGraphEnvironment() override = default;
  GarageGraphEnvironment& operator=(const GarageGraphEnvironment&) = delete;
  GarageGraphEnvironment(GarageGraphEnvironment&& other) = default;
  GarageGraphEnvironment& operator=(GarageGraphEnvironment&& other) = delete;

  bool OnExpansion(
      const volley::GarageGraph::Vertex& state, const Interval::Duration&, const SearchMetaData&) override;

  std::vector<std::pair<volley::GarageGraph::Vertex, Interval::Duration>> GetNeighbors(
      const volley::GarageGraph::Vertex& state) override;

  Interval::Duration GetHeuristic(const volley::GarageGraph::Vertex&) override {
    return Interval::Duration::zero();
  }

  void OnDiscovery(const volley::GarageGraph::Vertex&, const Interval::Duration&) override { }
  void OnUpdate(
      const volley::GarageGraph::Vertex&, const Interval::Duration&, const Interval::Duration&) override { }

private:
  const volley::GarageGraph& graph_;
  const cost::MotionCostModel& cost_model_;
  std::optional<volley::GarageGraph::Vertex> target_;
  std::optional<GraphFilterProperties> filters_;
};

// uses SingleSourceSearch and GarageGraphEnvironment to compute a path between poses
std::vector<GaragePoseMsg> GetPosePath(const volley::GarageGraph& graph, const GaragePoseMsg& source,
    const GaragePoseMsg& target, const cost::MotionCostModel& cost_model,
    std::optional<GraphFilterProperties> filters = std::nullopt);

// Constructs trajectory from pose path, requires sequential poses to be adjacent on the graph
// and uses the cost model's trapezoid profile for time intervals.
// If `audit` is non-null, each per-edge duration is pushed into it with a descriptive label,
// producing a per-segment breakdown of where time goes in the trajectory.
Trajectory ConvertPosePathToTrajectory(const std::vector<GaragePoseMsg>& pose_path,
    const volley::GarageGraph& graph, const cost::MotionCostModel& cost_model,
    const Interval::Timepoint& start_time, const GarageEntityIdMsg& entity_id, volley::CollisionEntityId_t,
    size_t action_id, cost::CostVector* audit = nullptr, bool is_agv_loaded = false);

}  // namespace volley
</file>

