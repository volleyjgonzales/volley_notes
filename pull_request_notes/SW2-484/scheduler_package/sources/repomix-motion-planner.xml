Interval::Duration ToIntervalDuration(cost::SecondsF seconds) {
  return std::chrono::duration_cast<Interval::Duration>(seconds);
}

// Same logic as CoalesceMotionRuns::ExtendsRun but operating on Motion locations
// directly (we don't have a pose path to feed CoalesceMotionRuns yet — we are
// detecting runs while we walk the trajectory).
bool EdgesExtendRun(const Motion::Edge& prev, const Motion::Edge& next, volley::TransitionType type,
    const GarageGraph& graph) {
  if(type == volley::TransitionType::VRC_TRANSITION) {
    // VRC: coalesce only within the same carriage entity going the same vertical
    // direction. Different VRCs or a direction reversal force a stop. See
    // motion_run.cpp::ExtendsRun for the matching pose-path-walking logic.
    auto layout = graph.GetLayout();
    auto prev_vrc = layout->GetVrcForNodeId(prev[1].node_id);
    auto next_vrc = layout->GetVrcForNodeId(next[0].node_id);
    if(!prev_vrc || !next_vrc || prev_vrc->id != next_vrc->id) {
      return false;
    }
    auto z_prev_src = layout->GetFloorZForNodeId(prev[0].node_id);
    auto z_prev_dst = layout->GetFloorZForNodeId(prev[1].node_id);
    auto z_next_src = layout->GetFloorZForNodeId(next[0].node_id);
    auto z_next_dst = layout->GetFloorZForNodeId(next[1].node_id);
    if(!z_prev_src || !z_prev_dst || !z_next_src || !z_next_dst) {
      return false;
    }
    const float prev_dz = z_prev_dst.value() - z_prev_src.value();
    const float next_dz = z_next_dst.value() - z_next_src.value();
    if(prev_dz == 0.0f || next_dz == 0.0f) {
      return false;
    }
    return (prev_dz > 0.0f) == (next_dz > 0.0f);
  }
  if(type == volley::TransitionType::ROTATION) {
    if(prev[1].node_id != next[0].node_id || next[0].node_id != next[1].node_id) {
      return false;
    }
    const int prev_delta =
        volley::Wrap(static_cast<int>(prev[1].heading) - static_cast<int>(prev[0].heading));
    const int next_delta =
        volley::Wrap(static_cast<int>(next[1].heading) - static_cast<int>(next[0].heading));
    if(prev_delta == 0 || next_delta == 0) {
      return false;
    }
    return (prev_delta > 0) == (next_delta > 0);
  }
  // LOCOMOTE / STRAFE: codirectional displacement on layout coordinates.
  auto layout = graph.GetLayout();
  auto prev_src = layout->GetNodeById(prev[0].node_id);
  auto prev_dst = layout->GetNodeById(prev[1].node_id);
  auto next_src = layout->GetNodeById(next[0].node_id);
  auto next_dst = layout->GetNodeById(next[1].node_id);
  if(!prev_src || !prev_dst || !next_src || !next_dst) {
    return false;
  }
  Eigen::Vector2d prev_disp {prev_dst->x - prev_src->x, prev_dst->y - prev_src->y};
  Eigen::Vector2d next_disp {next_dst->x - next_src->x, next_dst->y - next_src->y};
  return volley::AreSameDirection(prev_disp, next_disp, 0.01);
}

// Extracts the TransitionType for a Motion that is on an Edge. Returns nullopt
// if the motion is not an Edge-located motion or the edge isn't in the graph.
std::optional<volley::TransitionType> EdgeTransitionType(const Motion& m, const GarageGraph& graph) {
  if(!std::holds_alternative<Motion::Edge>(m.GetLocation())) {
    return std::nullopt;
  }
  const auto& edge = std::get<Motion::Edge>(m.GetLocation());
  auto edge_opt = graph.EdgeFromPoses(edge[0], edge[1]);
  if(!edge_opt) {
    return std::nullopt;
  }
  auto t_opt = graph.GetTransition(edge_opt.value());
  if(!t_opt) {
    return std::nullopt;
  }
  return t_opt.value().type;
}

double EdgeLength(const Motion::Edge& edge, const GarageGraph& graph) {
  auto edge_opt = graph.EdgeFromPoses(edge[0], edge[1]);
  return graph.GetTransition(edge_opt.value()).value().length;
}

}  // namespace

Trajectory CoalesceTrajectory(const Trajectory& trajectory, const GarageGraph& graph,
    const cost::MotionCostModel& cost_model, bool is_agv_loaded) {
  // Snapshot motions in trajectory order.
  std::vector<Motion> motions;
  for(const auto& m : trajectory) {
    motions.push_back(m);
  }
  Trajectory out;
  if(motions.empty()) {
    return out;
  }

  // Anchor follows the new (coalesced) timeline; original_anchor follows the
  // original trajectory so we can preserve inter-motion gaps verbatim.
  Interval::Timepoint new_anchor = motions.front().GetInterval().GetBegin();
  Interval::Timepoint original_anchor = motions.front().GetInterval().GetBegin();

  size_t i = 0;
  while(i < motions.size()) {
    // Determine run extent [i, run_end).
    size_t run_end = i + 1;
    auto first_type_opt = EdgeTransitionType(motions[i], graph);
    if(first_type_opt) {
      while(run_end < motions.size()) {
        auto next_type_opt = EdgeTransitionType(motions[run_end], graph);
        if(!next_type_opt || next_type_opt.value() != first_type_opt.value()) {
          break;
        }
        // Must abut the previous motion (no wheel-turn or wait gap).
        if(motions[run_end].GetInterval().GetBegin() != motions[run_end - 1].GetInterval().GetEnd()) {
          break;
        }
        const auto& prev_loc = std::get<Motion::Edge>(motions[run_end - 1].GetLocation());
        const auto& curr_loc = std::get<Motion::Edge>(motions[run_end].GetLocation());
        if(prev_loc[1] != curr_loc[0]) {
          break;  // chain is broken
        }
        if(!EdgesExtendRun(prev_loc, curr_loc, first_type_opt.value(), graph)) {
          break;
        }
        ++run_end;
      }
    }

    const size_t run_size = run_end - i;
    if(run_size == 1 || !first_type_opt) {
      // Singleton — pass through, anchored to the new timeline. Keeps idle
      // waits, lifts, and lone Edge motions verbatim in duration.
      const auto duration = motions[i].GetInterval().GetDuration();
      Interval new_interval(new_anchor, new_anchor + duration);
      out.AddMotion(motions[i].WithInterval(new_interval));
      new_anchor += duration;
      original_anchor = motions[i].GetInterval().GetEnd();
    }
    else {
      // Coalesce: one trapezoid over the run's total length, sliced into
      // per-edge sub-intervals.
      const volley::TransitionType type = first_type_opt.value();
      double total_length = 0.0;
      for(size_t k = i; k < run_end; ++k) {
        total_length += EdgeLength(std::get<Motion::Edge>(motions[k].GetLocation()), graph);
      }
      const auto limits = cost_model.VelocityLimitsFor(type, is_agv_loaded);
      const float total_length_f = static_cast<float>(total_length);
      const cost::SecondsF run_duration =
          cost_model.Duration(volley::Transition {total_length, type}, is_agv_loaded);
      float cum = 0.0f;
      float prev_t = 0.0f;
      for(size_t k = i; k < run_end; ++k) {
        const auto edge_len = EdgeLength(std::get<Motion::Edge>(motions[k].GetLocation()), graph);
        cum += static_cast<float>(edge_len);
        const bool last = (k + 1 == run_end);
        const float next_t = last ? run_duration.count()
                                  : cost::TimeAtDistance(cum, total_length_f, limits.speed, limits.accel);
        Interval new_interval(new_anchor + ToIntervalDuration(cost::SecondsF(prev_t)),
            new_anchor + ToIntervalDuration(cost::SecondsF(next_t)));
        out.AddMotion(motions[k].WithInterval(new_interval));
        prev_t = next_t;
      }
      new_anchor += ToIntervalDuration(run_duration);
      original_anchor = motions[run_end - 1].GetInterval().GetEnd();
    }

    // Preserve the original gap to the next motion (e.g. SIPP wheel-turn shifts
    // between drive modes, or SIPP-emitted waits for safe intervals).
    if(run_end < motions.size()) {
      const auto gap = motions[run_end].GetInterval().GetBegin() - original_anchor;
      new_anchor += gap;
    }

    i = run_end;
  }

  return out;
}

}  // namespace volley
