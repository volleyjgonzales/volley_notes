<file path="src/scheduler_ros.cpp">
#include <rclcppx/interface_factories.hpp>
#include <scheduler/scheduler.hpp>
#include <scheduler/scheduler_ros.hpp>

namespace {
using std::chrono_literals::operator""s;
constexpr auto kVersionInfoPeriod = 5s;
constexpr auto kReportPeriod = 5s;
}  // namespace

namespace volley {
using std::chrono_literals::operator""s;

SchedulerRos::SchedulerRos(const SchedulerParams& params, std::string layout_filepath, NodeSPtr node) :
    node_(node) {
  INFOF(node_->get_logger(), "Starting scheduler node.");
  bool printdags = node->Param<bool>("printdags");

  scheduler_ = std::make_shared<Scheduler>(layout_filepath, node->get_logger(), params);
  scheduler_->printdags_ = printdags;

  // Run the publication timers in their own callback group so that the long-running Plan service
  // (default group) cannot block the version-info heartbeat or the report.
  pub_cb_group_ = node_->create_callback_group(rclcpp::CallbackGroupType::MutuallyExclusive);

  version_info_pub_ = node_->create_publisher<VersionInfoMsg>("version_info", 1u);
  version_info_timer_ = node_->create_timer(
      ::kVersionInfoPeriod, [this] { version_info_pub_->publish(scheduler_->GetVersionInfo(node_->now())); },
      pub_cb_group_);

  report_pub_ = node_->create_publisher<SchedulerReportMsg>("report", 1u);
  report_timer_ = node_->create_timer(
      ::kReportPeriod, [this] { report_pub_->publish(scheduler_->GetSchedulerReport(node_->now())); },
      pub_cb_group_);

  plan_srv_ = rclcppx::CreateService<PlanSrv>(
      node_, "plan",
      [this](PlanSrv::Request::SharedPtr request, PlanSrv::Response::SharedPtr response) {
        auto response_msg = scheduler_->Plan(request->request_data, node_->now());
        rclcpp::Time now = node_->now();
        for(auto& job_data : response_msg.scheduled_jobs) {
          job_data.job.time_planned = now;
        }
        response->response_data = std::move(response_msg);
        return response;
      },
      1u);

  // Engineering-only debug toggle, intentionally not introspected.
  debug_printdags_srv_ = node_->create_service<TriggerSrv>(
      "debug/printdags",
      [this](TriggerSrv::Request::SharedPtr request, TriggerSrv::Response::SharedPtr response) {
        (void)request;
        INFOF(node_->get_logger(), "Note: printing DAGs requires 'sudo apt-get install libgraph-easy-perl'");
        scheduler_->PrintDags();
        response->success = true;
        return response;
      },
      1u);

  clean_garage_cli_ = node->create_client<TriggerSrv>("/central/clean_garage", rclcpp::ServicesQoS());
  rebalance_garage_cli_ = node->create_client<TriggerSrv>("/central/rebalance_garage", rclcpp::ServicesQoS());
  bay_to_insert_cli_ = node_->create_client<TransitionBayToInsertSrv>(
      "/central/transition_bay_to_insert", rclcpp::ServicesQoS());
  bay_to_retrieve_cli_ = node_->create_client<TransitionBayToRetrieveSrv>(
      "/central/transition_bay_to_retrieve", rclcpp::ServicesQoS());

  scheduler_->clean_garage_request_fn_ = [this]() {
    // Publish message to dispatch, to enqueue a CleanGarageJob
    if(clean_garage_cli_) {
      auto request = std::make_shared<TriggerSrv::Request>();
      clean_garage_cli_->async_send_request(
          request, [this](std::shared_future<TriggerSrv::Response::SharedPtr> future) { (void)future; });
    }
  };
  scheduler_->rebalance_garage_request_fn_ = [this]() {
    // Publish message to dispatch, to enqueue a RebalanceGarageJob
    if(rebalance_garage_cli_) {
      auto request = std::make_shared<TriggerSrv::Request>();
      rebalance_garage_cli_->async_send_request(
          request, [this](std::shared_future<TriggerSrv::Response::SharedPtr> future) { (void)future; });
    }
  };
  scheduler_->reset_bay_state_request_fn_ = [this](uint16_t bay_id, uint16_t state) {
    if(state == BayReportMsg::STATE_READY_TO_INSERT) {
      if(bay_to_insert_cli_) {
        // Publish message to dispatch, to enqueue a  ReadyForInsertJob
        auto request = std::make_shared<TransitionBayToInsertSrv::Request>();
        request->bay_id = bay_id;
        bay_to_insert_cli_->async_send_request(
            request, [this](std::shared_future<TransitionBayToInsertSrv::Response::SharedPtr> future) {
              (void)future;
            });
      }
    }
    else if(state == BayReportMsg::STATE_READY_TO_RETRIEVE) {
      if(bay_to_retrieve_cli_) {
        // Publish message to dispatch, to enqueue a  ReadyForRetrieveJob
        auto request = std::make_shared<TransitionBayToRetrieveSrv::Request>();
        request->bay_id = bay_id;
        bay_to_retrieve_cli_->async_send_request(
            request, [this](std::shared_future<TransitionBayToRetrieveSrv::Response::SharedPtr> future) {
              (void)future;
            });
      }
    }
    else {
      ERRORF(node_->get_logger(), "Transition to state %d is not supported", state);
    }
  };

  set_bay_readiness_ratio_srv_ = rclcppx::CreateService<SetFloat32Srv>(node_, "set_bay_readiness_ratio",
      [this](SetFloat32Srv::Request::SharedPtr request, SetFloat32Srv::Response::SharedPtr response) {
        bool changed = scheduler_->SetBayReadinessRatioCallback(request, response);
        // If the bay readiness ratio changed, enqueue a job to rebalance the garage.
        // e.g. set the garage for all retrieve jobs, or set the garage for all insert jobs.
        // Assume the dispatch queue has pending jobs, and jobs that are already in progress.
        if(changed && scheduler_->rebalance_garage_request_fn_) {
          scheduler_->rebalance_garage_request_fn_();
        }
      });

  INFOF(node_->get_logger(), "Scheduler node started");
}
}  // namespace volley
</file>

