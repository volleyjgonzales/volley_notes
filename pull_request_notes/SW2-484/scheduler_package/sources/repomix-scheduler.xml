TEST(Scheduler, AmigaStash) {
  volley::DiscreteGarageState state;
  auto [success, msg] = state.Set(YAML::Load(R"YML(
is_faulted: false
agvs:
-
  id: 8
  state: 4
  lift: false
  pose:
    node_id: 8
    heading: 0
-
  id: 1
  state: 4
  lift: false
  pose:
    node_id: 1
    heading: 90
trays:
-
  id: 1
  pose:
    node_id: 1
    heading: 90
-
  id: 2
  pose:
    node_id: 2
    heading: 90
-
  id: 3
  pose:
    node_id: 11
    heading: 0
bays: []
payloads: []
disabled_nodes: []
hash: 0)YML"));

  EXPECT_TRUE(success) << msg;

  using volley::TrayMove;
  const auto layout_filepath_or = GetLayoutPathByName(kTinyLotLayoutName);
  ASSERT_TRUE(layout_filepath_or.has_value()) << layout_filepath_or.error();
  const auto& layout_filepath = layout_filepath_or.value();

  auto logger = rclcpp::get_logger("scheduler");

  Scheduler scheduler(layout_filepath, logger, SchedulerParams {});
  GuidMsg request_id = volley::MakeGuid(0, 0xDEADBEEF);
  auto ctx = std::make_shared<ScheduleContext>(request_id, state, rclcpp::Time());

  // Three tray moves: T2 to 5, T1 to 9, T2 to 1) w/ two AGVs. AGV 1 does 1
  // & 3.
  auto tray_move_1 = std::make_shared<TrayMove>(0u);
  tray_move_1->SetTrayId(2);
  GaragePoseMsg end_pose;
  end_pose.node_id = 5;
  end_pose.heading = 0;
  tray_move_1->SetDest(end_pose);
  ctx->events.AddEvent(tray_move_1);

  auto tray_move_2 = std::make_shared<TrayMove>(1u);
  tray_move_2->SetTrayId(1);
  end_pose.node_id = 9;
  end_pose.heading = 0;
  tray_move_2->SetDest(end_pose);
  ctx->events.AddEvent(tray_move_2);
  ctx->events.AddDependency(tray_move_1, tray_move_2);

  auto tray_move_3 = std::make_shared<TrayMove>(2u);
  tray_move_3->SetTrayId(2);
  end_pose.node_id = 1;
  end_pose.heading = 90;
  tray_move_3->SetDest(end_pose);
  ctx->events.AddEvent(tray_move_3);
  ctx->events.AddDependency(tray_move_2, tray_move_3);

  std::tie(success, msg) = scheduler.DoAgvAssignments(ctx);
  EXPECT_TRUE(success) << msg;

  EXPECT_TRUE(tray_move_1->GetAgvId().has_value()) << msg;
  EXPECT_TRUE(tray_move_2->GetAgvId().has_value()) << msg;
  EXPECT_TRUE(tray_move_3->GetAgvId().has_value()) << msg;

  EXPECT_EQ(tray_move_1->GetAgvId().value(), 1);
  EXPECT_EQ(tray_move_2->GetAgvId().value(), 1);
  EXPECT_EQ(tray_move_3->GetAgvId().value(), 8);

  // Direct tray-move-to-tray-move dependencies do not survive the transitive
  // reduction at the end of DoAgvAssignments because longer per-AGV chains
  // (and, for cross-AGV transfers like tray_move_2 -> tray_move_3, node-arrival
  // dependencies that order the new occupant after the previous occupant's
  // chain) cover the same ordering. The reduced DAG is still topologically
  // equivalent — verified by the apply loop below.
  EXPECT_FALSE(ctx->events.HasDependency(tray_move_1, tray_move_2));
  EXPECT_FALSE(ctx->events.HasDependency(tray_move_2, tray_move_3));

  // Apply all the events to the working state and make sure things end up
  // where they should
  auto new_total_ordering_opt = ctx->events.GetTopologicalOrdering();
  for(const auto& event_vert : new_total_ordering_opt.value()) {
    auto event = ctx->events.GetEventFromVertex(event_vert).value();
    EXPECT_TRUE(event->Apply(ctx->initial_state).first);
  }
  EXPECT_EQ(tray_move_2->GetDest(), ctx->initial_state.GetTray(1)->pose);
  EXPECT_EQ(tray_move_3->GetDest(), ctx->initial_state.GetTray(2)->pose);
};

