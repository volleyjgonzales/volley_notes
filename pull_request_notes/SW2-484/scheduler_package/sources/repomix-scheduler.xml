std::optional<volley::Interval::Duration> Scheduler::GetAgvToTrayAssignmentCost(uint16_t agv_id,
    const volley::TrayMove& move, const volley::DiscreteGarageState& working_state,
    const volley::Interval::Duration& agv_occupied_duration,
    std::optional<volley::GraphFilterProperties> filters) const {
  // Make sure everything we're trying to compute actually exists
  if(!move.GetTrayId().has_value()) {
    WARNS(logger_, "Attempting to get AMIGA cost for a tray move with no tray ID " << std::to_string(move));
    return std::nullopt;
  }
  auto tray_opt = working_state.GetTray(move.GetTrayId().value());
  if(!tray_opt.has_value()) {
    WARNS(logger_,
        "Attempting to get AMIGA cost for a tray move whose tray doesn't exist " << std::to_string(move));
    return std::nullopt;
  }
  if(!layout_->GetNodeById(tray_opt->pose.node_id).has_value()) {
    WARNS(logger_, "Attempting to get AMIGA cost for a tray move whose tray isn't on a valid node "
                       << std::to_string(move));
    return std::nullopt;
  }
  auto agv_opt = working_state.GetAgv(agv_id);
  if(!agv_opt.has_value()) {
    WARNS(logger_, "Attempting to get AMIGA cost for an AGV that doesn't exist " << std::to_string(move));
    return std::nullopt;
  }
  if(!layout_->GetNodeById(agv_opt->pose.node_id).has_value()) {
    WARNS(logger_,
        "Attempting to get AMIGA cost for an AGV that isn't on a valid node " << std::to_string(move));
    return std::nullopt;
  }
  // Say that the assignment is infeasible if AGV is holding a different tray
  if(agv_opt->tray_id != 0 && agv_opt->tray_id != move.GetTrayId().value()) {
    return std::nullopt;
  }
  // Note: this includes the time to lift the tray if not already lifted
  auto moving_cost_opt = GetAgvCurrentPoseToTrayMoveCost(agv_id, move, working_state, filters);
  if(!moving_cost_opt.has_value()) {
    return std::nullopt;
  }
  return agv_occupied_duration + moving_cost_opt.value();
}

std::vector<uint16_t> Scheduler::AgvMatchingEventDeps(
    const std::unordered_map<uint16_t, std::optional<ScheduleEventSPtr>>& event_map,
    const volley::DiscreteGarageState& working_state, const uint16_t agv_id) const {
  if(event_map.empty()) {
    return {};
  }

  auto input_event_opt = event_map.at(agv_id);
  if(!input_event_opt.has_value()) {
    return {};
  }

  auto tray_move = dynamic_cast<volley::TrayMove*>(input_event_opt.value().get());
  if(tray_move == nullptr) {
    return {};
  }

  auto all_agvs = working_state.GetAgvs();
  auto source = working_state.GetTray(tray_move->GetTrayId().value())->pose;

  std::vector<uint16_t> conflicting_agvs;
  for(const auto& [other_agv_id, other_agv] : all_agvs) {
    if(other_agv_id == agv_id) {
      continue;
    }
    if(event_map.find(other_agv_id) == event_map.end()) {
      continue;
    }

    auto fixed_collision_id = CollisionEntityIdFromAgvState(
        working_state.GetAgv(agv_id).value(), working_state, *(gg_.GetLayout()));
    auto queried_collision_id = CollisionEntityIdFromAgvState(
        working_state.GetAgv(other_agv_id).value(), working_state, *(gg_.GetLayout()));

    auto queried_pose = other_agv.pose;

    if(table_.Query(fixed_collision_id, queried_collision_id, source, queried_pose)) {
      INFOS(logger_, "AGV " << agv_id << " conflicts with AGV " << other_agv_id << ". Ordering AGV "
                            << other_agv_id << " before AGV " << agv_id);
      conflicting_agvs.push_back(other_agv_id);
    }
  }

  return conflicting_agvs;
}

volley::DagBase<uint16_t> Scheduler::GetEventDag(
    const std::unordered_map<uint16_t, std::optional<ScheduleEventSPtr>>& event_map,
    const volley::DiscreteGarageState& working_state) const {
  auto dag = volley::DagBase<uint16_t>();
  std::unordered_map<uint16_t, std::optional<volley::DagBase<uint16_t>::Vertex>> agv_vertex_map;

  for(const auto& entry : event_map) {
    uint16_t agv_id = entry.first;
    auto agv_ptr = std::make_shared<uint16_t>(agv_id);
    auto vertex_opt = dag.Add(agv_ptr);
    agv_vertex_map[agv_id] = vertex_opt;
  }

  for(const auto& entry : event_map) {
    uint16_t agv_id = entry.first;
    const auto& event_ptr = entry.second;
    if(event_ptr) {
      std::vector<uint16_t> dependencies = Scheduler::AgvMatchingEventDeps(event_map, working_state, agv_id);

      for(const auto& dep_agv_id : dependencies) {
        auto parent_vert_opt = agv_vertex_map.at(dep_agv_id);
        auto child_vert_opt = agv_vertex_map.at(agv_id);

        if(parent_vert_opt && child_vert_opt) {
          bool res = dag.AddDependency(parent_vert_opt.value(), child_vert_opt.value());

          if(!res) {
            throw std::runtime_error("Failed to add dependency between AGV " + std::to_string(dep_agv_id) +
                                     " and AGV " + std::to_string(agv_id));
          }
        }
        else {
          throw std::runtime_error("Failed to add dependency between AGV. Parent vertex: " +
                                   std::to_string(parent_vert_opt.has_value()) +
                                   ", Child vertex: " + std::to_string(child_vert_opt.has_value()));
        }
      }
    }
  }

  return dag;
}

ScheduleEventSPtr Scheduler::FindAgvDepartureFromNode(ScheduleContextSPtr ctx,
    const volley::ScheduleEventDag::VertexVec& topo, size_t after_idx, uint16_t agv_id, uint32_t node) const {
  using volley::ScheduleEventType;
  for(size_t j = after_idx + 1; j < topo.size(); ++j) {
    auto candidate = ctx->events.GetEventFromVertex(topo[j]).value();
    if(candidate->GetType() == ScheduleEventType::AGV_MOVE) {
      auto* cand_move = dynamic_cast<volley::AgvMove*>(candidate.get());
      if(cand_move->GetAgvId() == agv_id &&
          std::holds_alternative<AgvPoseChangedMsg>(cand_move->GetDiscreteChange()) &&
          std::get<AgvPoseChangedMsg>(cand_move->GetDiscreteChange()).node_id_curr == node) {
        return candidate;
      }
    }
    else if(candidate->GetType() == ScheduleEventType::TRAY_MOVE) {
      auto* cand_tray = dynamic_cast<volley::TrayMove*>(candidate.get());
      if(cand_tray->GetAgvId().has_value() && cand_tray->GetAgvId().value() == agv_id) {
        return candidate;
      }
    }
  }
  return nullptr;
}

bool Scheduler::TryClearBlockedAgvMove(ScheduleContextSPtr ctx,
    const volley::ScheduleEventDag::VertexVec& topo, size_t idx, const ScheduleEventSPtr& event,
    const volley::DiscreteGarageState& working_state) const {
  using volley::ScheduleEventType;

  // Only AGV reposition (pose-change) moves with a destination can be blocked by another AGV body.
  auto* agv_move =
      event->GetType() == ScheduleEventType::AGV_MOVE ? dynamic_cast<volley::AgvMove*>(event.get()) : nullptr;
  if(agv_move == nullptr) {
    return false;
  }
  const auto dest_opt = agv_move->GetDest();
  if(!dest_opt.has_value() || !std::holds_alternative<AgvPoseChangedMsg>(agv_move->GetDiscreteChange())) {
    return false;
  }
  const auto agv_opt = working_state.GetAgv(agv_move->GetAgvId());
  if(!agv_opt.has_value()) {
    return false;
  }
  const uint16_t agv_id = agv_move->GetAgvId();
  const auto agv = agv_opt.value();
  const auto dest = dest_opt.value();
  const auto collision_id = volley::CollisionEntityIdFromAgvState(agv, working_state, *layout_);

  // True iff a feasible path agv.pose->dest exists with `ignore_agvs` treated as absent — the same
  // collision model SanityCheckEvents uses. Trays (slide-under), disabled nodes and bays are all
  // still honored.
  auto feasible_ignoring = [&](const std::unordered_set<uint16_t>& ignore_agvs) -> bool {
    auto filters = volley::GetStaticFilter(collision_id, gg_, working_state, table_,
        std::unordered_set<uint16_t>(), ignore_agvs, std::unordered_set<uint16_t>());
    return !volley::GetPosePath(gg_, agv.pose, dest, cost_model_, filters).empty();
  };

  // SanityCheckEvents ignores only the moving AGV. If that path is already feasible there is
  // nothing to repair.
  if(feasible_ignoring(std::unordered_set<uint16_t> {agv_id})) {
    return false;
  }

  // Would the move be feasible if every other AGV were gone? If not, the obstruction is
  // trays/disabled nodes, which reordering cannot fix — leave it for SanityCheckEvents.
  std::unordered_set<uint16_t> all_agvs {agv_id};
  for(const auto& [other_id, other_state] : working_state.GetAgvs()) {
    if(!other_state.disabled) {
      all_agvs.insert(other_id);
    }
  }
  if(!feasible_ignoring(all_agvs)) {
    return false;
  }

  // For each other AGV, if clearing it (alone) makes the path feasible, gate this move on that
  // AGV's first departure from its node. The cycle check drops blockers that can only move after
  // this very move (mutually-blocking chokepoints), so a route that can genuinely be freed is
  // chosen.
  for(const auto& [other_id, other_state] : working_state.GetAgvs()) {
    if(other_id == agv_id || other_state.disabled) {
      continue;
    }
    if(!feasible_ignoring(std::unordered_set<uint16_t> {agv_id, other_id})) {
      continue;
    }
    auto departure = FindAgvDepartureFromNode(ctx, topo, idx, other_id, other_state.pose.node_id);
    if(!departure || ctx->events.WouldCreateCycle(departure, event)) {
      // No departure event, or gating on it would deadlock (the blocker can only leave after this
      // very move — a mutually-blocking chokepoint). Try another blocker.
      continue;
    }
    if(ctx->events.AddDependency(departure, event)) {
      return true;
    }
  }
  return false;
}

stdx::Expected<bool> Scheduler::RunAgvPathRepairPass(ScheduleContextSPtr ctx) const {
  auto topo_opt = ctx->events.GetTopologicalOrdering();
  if(!topo_opt.has_value()) {
    return stdx::Unexpected("EnsureAgvMovePathsClear: failed to get topological ordering");
  }
  const auto& topo = topo_opt.value();
  auto working_state = ctx->initial_state;

  for(size_t idx = 0; idx < topo.size(); ++idx) {
    auto event = ctx->events.GetEventFromVertex(topo[idx]).value();
    if(TryClearBlockedAgvMove(ctx, topo, idx, event, working_state)) {
      // An edge was added; the topological order has changed, so the occupancy of every later
      // event is now stale. Stop and let the caller re-derive the order and replay.
      return true;
    }
    // Advance the simulated state. Discrete Apply only updates positions for these events.
    event->Apply(working_state);
  }
  return false;
}

stdx::Result Scheduler::EnsureAgvMovePathsClear(ScheduleContextSPtr ctx) const {
  // Each productive pass adds exactly one new edge, so the number of passes is bounded by the
  // number of edges we could ever add. Cap generously and fall through to SanityCheckEvents.
  const size_t max_iters = 256;
  for(size_t iter = 0; iter < max_iters; ++iter) {
    const auto added_edge = RunAgvPathRepairPass(ctx);
    if(!added_edge.has_value()) {
      return stdx::Unexpected(added_edge.error());
    }
    if(!added_edge.value()) {
      // A full replay completed with no further repairs needed.
      return {};
    }
  }
  return {};
}

BoolStringPair Scheduler::DoAgvAssignments(ScheduleContextSPtr ctx) const {
  // Need to store the "working" continuous state to get next available AGV
  // times and final locations from the currently planned trajectories
  auto working_state = ctx->initial_state;

  // If there are no tray moves, then nothing needs to get assigned
  bool no_tray_moves = true;
  for(auto [curr, end] = ctx->events.GetVertices(); curr != end; ++curr) {
    auto event = ctx->events.GetEventFromVertex(*curr).value();
    if(event->GetType() == volley::ScheduleEventType::TRAY_MOVE) {
      no_tray_moves = false;
      break;
    }
  }
  if(no_tray_moves) {
    return std::make_pair(true, "");
  }

  // Need to keep track of each AGV's next available time. This will be
  // updated as events get assigned
  // TODO(isabel) This should take into account currently assigned tasks (not
  // necessarily start at time now) but it doesn't since
  // GetAgvNextAvailableTime() isn't implemented right. Could alternatively as
  // a temporary method go through all events and any that have an AGV assigned
  // to it should get durations calculated and then added to the next
  // available times.
  std::unordered_map<uint16_t, volley::Interval::Duration> agv_occupied_durations;
  std::unordered_map<std::shared_ptr<volley::ScheduleEvent>, volley::Interval::Duration>
      event_occupied_durations;
  std::vector<uint16_t> agvs_to_assign;
  for(const auto& [agv_id, agv_state] : working_state.GetAgvs()) {
    if(agv_state.disabled) {
      continue;
    }
    agv_occupied_durations[agv_id] = GetAgvOccupiedDuration(agv_id, ctx);
    agvs_to_assign.push_back(agv_id);
  }
  if(agvs_to_assign.size() == 0) {
    // can't assign agvs if there are no agvs to assign
    return std::make_pair(false, "No available AGVs to attempt assignment");
  }

  auto event_dag_copy(ctx->events);

  // last_agv_event is a map keeps track of each AGV's latest event to
  // keep track of dependencies as new events are added.
  std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>> last_agv_event;

  std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>> last_move_to_tray_event;

  // Tracks the AGV currently at each node as DoAgvAssignments serially evolves
  // working_state. Initial-state occupants seed the map. When a new event
  // arrives at node N and a *different* AGV last occupied it, we add a
  // dependency on that AGV's last event so the topological order in the
  // emitted DAG respects "previous occupant must leave before next AGV
  // arrives" — without this, chugg's topo sort can interleave per-AGV chains
  // and try to apply an arrival before the prior occupant has departed
  // ("two AGVs at the same node" failure in InitializeEventOrder).
  std::unordered_map<uint32_t, uint16_t> current_node_occupant;
  for(const auto& [agv_id, agv_state] : working_state.GetAgvs()) {
    if(!agv_state.disabled) {
      current_node_occupant[agv_state.pose.node_id] = agv_id;
    }
  }

  // There are still events that need to get assigned
  while(event_dag_copy.GetRootEvents().size() > 0) {
    // SW2-377 Phase 1: Drain ALL non-tray roots first. Applying a non-tray root
    // (e.g. a BAY_TRANSITION) may expose new tray-move roots in the same outer
    // iteration; we need BottleneckAssignment to see every eligible tray-move
    // together so it can pick a feasible order (in the failing scenario, T3 was
    // hidden behind a BAY_TRANSITION parent and only T4 was visible — BA picked
    // T4 first, which is physically infeasible because t3 sits on a16's nav-path
    // to t4 and creates a cycle once T3 is matched in the next iteration).
    while(true) {
      bool applied_any_non_tray = false;
      auto current_roots = event_dag_copy.GetRootEvents();
      for(const std::shared_ptr<volley::ScheduleEvent>& root_event : current_roots) {
        if(root_event->GetType() == volley::ScheduleEventType::TRAY_MOVE) {
          continue;
        }
        const auto [success, message] = root_event->Apply(working_state);
        if(!success) {
          return std::make_pair(false, "Could not apply non-tray event: " + message);
        }
        // If it's an assigned AGV event, update the AGV's occupied time.
        if(root_event->GetType() == volley::ScheduleEventType::AGV_MOVE) {
          auto agv_move = dynamic_cast<volley::AgvMove*>(root_event.get());
          auto cost = volley::Interval::Duration::zero();
          if(std::holds_alternative<AgvLiftChangedMsg>(agv_move->GetDiscreteChange())) {
            auto lift_time = cost_model_.Params().events.agv_lift_down;
            auto lift_change = std::get<AgvLiftChangedMsg>(agv_move->GetDiscreteChange());
            if(lift_change.raised) {
              lift_time = cost_model_.Params().events.agv_lift_up;
            }
            cost += std::chrono::duration_cast<volley::Interval::Duration>(volley::cost::SecondsF(lift_time));
          }
          else if(std::holds_alternative<AgvPoseChangedMsg>(agv_move->GetDiscreteChange())) {
            auto pose_change = std::get<AgvPoseChangedMsg>(agv_move->GetDiscreteChange());
            GaragePoseMsg start_pose =
                volley::ConstructGaragePose(pose_change.node_id_curr, pose_change.heading_curr);
            GaragePoseMsg end_pose =
                volley::ConstructGaragePose(pose_change.node_id_next, pose_change.heading_next);
            const bool agv_loaded = working_state.GetAgv(agv_move->GetAgvId()).value().tray_id != 0;
            auto cost_opt =
                GetJustMovingCost(start_pose, end_pose, volley::AgvId(agv_move->GetAgvId()), agv_loaded);
            if(cost_opt.has_value()) {
              cost += cost_opt.value();
            }
          }
          else {
            ERRORS(logger_, "Unknown AGV Move Discrete Change " << agv_move->ToString());
          }

          auto agv_id = agv_move->GetAgvId();
          agv_occupied_durations[agv_id] += cost;
          if(last_agv_event.find(agv_id) != last_agv_event.end()) {
            ctx->events.AddDependency(last_agv_event[agv_id], root_event);
          }
          if(std::holds_alternative<AgvPoseChangedMsg>(agv_move->GetDiscreteChange())) {
            auto pose_change = std::get<AgvPoseChangedMsg>(agv_move->GetDiscreteChange());
            const auto [arrival_ok, arrival_msg] = AddNodeArrivalDeps(
                pose_change.node_id_next, agv_id, root_event, ctx, current_node_occupant, last_agv_event);
            if(!arrival_ok) {
              return std::make_pair(
                  false, "DoAgvAssignments: AGV pose-change arrival infeasible: " + arrival_msg);
            }
          }
          last_agv_event[agv_id] = root_event;
        }
        event_dag_copy.Remove(root_event);
        applied_any_non_tray = true;
      }
      if(!applied_any_non_tray) {
        break;
      }
    }

    // Phase 2: All remaining roots in event_dag_copy are tray-moves. Compute
    // edge_costs against this canonical set.
    std::vector<ScheduleEventSPtr> root_events = event_dag_copy.GetRootEvents();
    if(root_events.empty()) {
      continue;
    }

    std::unordered_map<AgvAssignmentEdgeKey, volley::Interval::Duration> edge_costs;
    for(const std::shared_ptr<volley::ScheduleEvent>& root_event : root_events) {
      auto tray_move = dynamic_cast<volley::TrayMove*>(root_event.get());
      for(const auto& agv_id : agvs_to_assign) {
        // Don't consider using AGVs that are stuck inside a bay
        auto bay_opt = working_state.GetBay(working_state.GetAgv(agv_id)->pose.node_id);
        if(bay_opt.has_value() && bay_opt->state != BayReportMsg::STATE_READY_TO_RETRIEVE) {
          continue;
        }
        // Get filters of where this AGV can't be
        std::unordered_set<uint16_t> all_enabled_agvs(agvs_to_assign.begin(), agvs_to_assign.end());
        auto filters =
            volley::GetStaticFilter(common::EnumInteger(volley::CollisionEntityId::AGV), gg_, working_state,
                table_, std::unordered_set<uint16_t>(), all_enabled_agvs, std::unordered_set<uint16_t>());
        auto adjusted_cost = max(agv_occupied_durations[agv_id] - event_occupied_durations[root_event],
            volley::Interval::Duration::zero());
        auto cost_opt = GetAgvToTrayAssignmentCost(agv_id, *tray_move, working_state, adjusted_cost, filters);
        // Only make it an edge if it's feasible to assign the AGV to the tray
        if(cost_opt.has_value()) {
          edge_costs[std::make_pair(agv_id, root_event)] = cost_opt.value();
        }
      }
    }

    // Assignment is guaranteed to fail if we have no edge costs or AGVs to assign
    if(edge_costs.size() == 0) {
      return std::make_pair(
          false, "Scheduler::DoAgvAssignments() The edge_costs.size() is zero. Empty edge costs!");
    }
    if(agvs_to_assign.size() == 0) {
      return std::make_pair(false,
          "Scheduler::DoAgvAssignments() The agvs_to_assign.size() is "
          "zero. No AGVs to assign!");
    }

    // Run bottleneck assignment w/ Left verts = AGVs; Right verts = root events
    // max_cost is Duration::max() since no edge will have that value
    auto assignment = volley::BottleneckAssignment(
        edge_costs, agvs_to_assign, root_events, volley::Interval::Duration::max());
    if(!assignment.has_value()) {
      return std::make_pair(false, "Scheduler::DoAgvAssignments() No complete assignment found!");
    }

    if(assignment.value().first.size() == 0) {
      return std::make_pair(false, "Scheduler::DoAgvAssignments() No AGVs assigned to any events!");
    }

    auto [matching, threshold] = assignment.value();

    auto agv_event_dag = GetEventDag(matching, working_state);

    // Pack the topological ordering into a vector to loop through
    std::optional<std::vector<uint64_t>> topo_order_opt = agv_event_dag.GetTopologicalOrdering();
    if(!topo_order_opt) {
      throw std::runtime_error("Scheduler::DoAgvAssignments() Failed to topologically sort the DAG");
    }

    std::vector<std::pair<uint16_t, std::optional<ScheduleEventSPtr>>> ordered_matching;
    for(const auto& vertex : topo_order_opt.value()) {
      uint16_t agv_id = *(agv_event_dag.GetFromVertex(vertex).value());
      ordered_matching.emplace_back(agv_id, matching.at(agv_id));
    }

    INFOS(logger_, "Ordered best AGV assignment matching:");
    for(const auto& [agv_id, root_event_opt] : ordered_matching) {
      if(!root_event_opt.has_value()) {
        INFOS(logger_, "\t" << "a" << std::to_string(agv_id) << " -> None");
        continue;
      }
      INFOS(logger_,
          "\t" << "a" << std::to_string(agv_id) << " -> " << std::to_string(*root_event_opt.value()));
    }

    // Assign AGVs to the events the bottleneck algorithm said to.
    for(const auto& [agv_id, root_event_opt] : ordered_matching) {
      // If root_event is null, that means that there was no AGV matched
      // to it (e.g., there are two AGVs but only one root event, so at
      // least one AGV will not be matched with an event). In this case,
      // don't remove the root_event and continue (i.e. do nothing)
      if(!root_event_opt.has_value()) {
        continue;
      }
      auto root_event = root_event_opt.value();
      const auto tray_move = dynamic_cast<volley::TrayMove*>(root_event.get());
      const auto tray = working_state.GetTray(tray_move->GetTrayId().value()).value();
      // Initialize the total time it takes for this AGV to complete the
      // event to 0.
      // NOTE/TODO(isabel): This is not necessarily ==
      // GetAgvToTrayAssignmentCost + JustMovingCost, because
      // GetAgvToTrayAssignmentCost might be (read: is) not completely
      // accurate yet, so we might need to take in additional
      // lifts/lowers/moves/etc.
      volley::Interval::Duration event_cost(0);

      const auto agv = working_state.GetAgv(agv_id).value();
      // Case: the AGV is not already holding the tray
      // NOTE: The AGV should only ever be carrying the desired tray or no
      // tray at all, because the cost functions right now don't allow for
      // an AGV carrying a different tray to be assigned to a tray move.
      if(agv.tray_id != tray.id) {
        // Move AGV to Tray, but only if it isn't already at the correct pose / orientation.
        if(tray.pose.node_id != agv.pose.node_id ||
            !volley::IsAngleOrReciprocal(agv.pose.heading, tray.pose.heading)) {
          auto [move_ok, move_msg] = MoveAgvToTrayPose(agv_id, agv, tray, root_event, agv_event_dag, ctx,
              working_state, last_agv_event, last_move_to_tray_event, current_node_occupant, event_cost);
          if(!move_ok) {
            return std::make_pair(false, move_msg);
          }
        }
        // Lift tray
        auto [lift_ok, lift_msg] = AppendAgvLiftEvent(
            agv_id, true, root_event->GetJobIndex(), ctx, working_state, last_agv_event, event_cost);
        if(!lift_ok) {
          return std::make_pair(false, lift_msg);
        }
      }

      // Assign AGV to tray move and remove it from the DAG copy
      tray_move->SetAgvId(agv.id);
      if(last_agv_event.find(agv_id) != last_agv_event.end()) {
        ctx->events.AddDependency(last_agv_event[agv_id], root_event);
      }
      // The tray-move event physically relocates the AGV to the tray's
      // destination; treat it as an arrival at that node for ordering.
      {
        const auto [arrival_ok, arrival_msg] = AddNodeArrivalDeps(tray_move->GetDest().value().node_id,
            agv_id, root_event, ctx, current_node_occupant, last_agv_event);
        if(!arrival_ok) {
          return std::make_pair(
              false, "DoAgvAssignments: tray-move destination arrival infeasible: " + arrival_msg);
        }
      }
      last_agv_event[agv_id] = root_event;

      const auto agv_for_cost_opt = working_state.GetAgv(agv_id);
      if(!agv_for_cost_opt.has_value()) {
        return std::make_pair(false, "DoAgvAssignments: assigned AGV missing from working state");
      }
      const auto& agv_for_cost = agv_for_cost_opt.value();

      auto root_event_cost_opt = GetJustMovingCost(
          agv_for_cost.pose, tray_move->GetDest().value(), volley::AgvId(agv_id), agv_for_cost.tray_id != 0);
      if(!root_event_cost_opt.has_value()) {
        // This shouldn't really happen
        return std::make_pair(false, "assigned event cost is infeasible");
      }
      event_cost += root_event_cost_opt.value();
      {
        auto [success, message] = root_event->Apply(working_state);
        if(!success) {
          std::string msg = "AGV Assignments post matching: Failed to apply " + root_event->ToString() +
                            " while assigning AGVs: " + message;
          ERRORS(logger_, msg);
          return std::make_pair(false, "AGV Assignment failure: " + msg);
        }
      }
      event_dag_copy.Remove(root_event);

      // Lower tray
      auto [lower_ok, lower_msg] = AppendAgvLiftEvent(
          agv_id, false, root_event->GetJobIndex(), ctx, working_state, last_agv_event, event_cost);
      if(!lower_ok) {
        return std::make_pair(false, lower_msg);
      }

      PropagateEventCostToChildren(root_event, event_cost, ctx, event_occupied_durations);
      // Update this AGV's next available time based on the estimate for
      // completing this newly assigned event
      agv_occupied_durations[agv_id] += event_cost;
    }  // end for root_event loop
       // NOTE: Not all current root events will necessarily be removed from
       // the DAG at the end of this loop.
  }  // end while event_dag not empty

  // Reorder AGV reposition moves so none is asked to drive through a node another AGV occupies in
  // the final topological order (see EnsureAgvMovePathsClear).
  {
    const auto clear_result = EnsureAgvMovePathsClear(ctx);
    if(!clear_result.has_value()) {
      return std::make_pair(false, clear_result.error());
    }
  }

  // Get rid of a extra edges.
  ctx->events.Reduce();

  INFOS(logger_, "AGV Assigned events:");
  auto new_total_ordering_opt = ctx->events.GetTopologicalOrdering();
  if(!new_total_ordering_opt.has_value()) {
    ERRORS(logger_, "Failed to get new total ordering. " << "AGV assignments introduced a loop!!!!");
    return std::make_pair(false, "Failed to get new total ordering");
  }

  for(const auto& event_vert : new_total_ordering_opt.value()) {
    auto event = ctx->events.GetEventFromVertex(event_vert).value();
    INFOS(logger_, "\t" << std::to_string(*event));

    // Change Tray dependencies to lift vs tray move
    // Add change bay & VECS dependencies to be on tray placement

    // event, node_id
    std::optional<std::pair<std::shared_ptr<volley::ScheduleEvent>, uint16_t>> event_and_id = std::nullopt;
    if(event->GetType() == volley::ScheduleEventType::BAY_TRANSITION) {
      auto bay_transition = dynamic_cast<volley::BayTransition*>(event.get());
      event_and_id = std::make_pair(event, bay_transition->GetSourceState().id);
    }
    else if(event->GetType() == volley::ScheduleEventType::VECS_TRANSITION) {
      auto vecs_transition = dynamic_cast<volley::VecsTransition*>(event.get());
      event_and_id = std::make_pair(event, vecs_transition->GetVecsId());
    }
    if(event_and_id.has_value()) {
      AddDepsAfterAmiga(ctx, event_and_id->first, event_and_id->second);
    }
  }

  // Clean up new redundant dependencies
  // TODO(Gunther): Re-add this once I'm confident in the new code
  // ctx->events.Reduce();
  return std::make_pair(true, "");
}

BoolStringPair Scheduler::SanityCheckEvents(ScheduleContextSPtr ctx) const {
  auto topo_opt = ctx->events.GetTopologicalOrdering();
  auto working_state = ctx->initial_state;
  if(!topo_opt.has_value()) {
    return std::make_pair(false, "Invalid topological ordering");
  }
  auto topo = topo_opt.value();
  for(auto& event_id : topo) {
    auto event_opt = ctx->events.GetEventFromVertex(event_id);
    if(!event_opt.has_value()) {
      return std::make_pair(false, "Couldn't get event from vertex " + std::to_string(event_id));
    }
    auto event = event_opt.value();

    if(event->GetType() == volley::ScheduleEventType::BAY_TRANSITION) {
      auto bay_transition = dynamic_cast<volley::BayTransition*>(event.get());
      auto bay_id = bay_transition->GetBayId();
      auto bay_pose = volley::ConstructGaragePose(
          bay_id, static_cast<int16_t>(layout_->GetBayInboundHeading(bay_id).value()));
      auto filters = volley::GetStaticFilter(common::EnumInteger(volley::CollisionEntityId::BAY_ODP), gg_,
          working_state, table_, std::unordered_set<uint16_t>(), std::unordered_set<uint16_t>(),
          std::unordered_set<uint16_t>());
      if(!filters.IsEnabled(gg_.GetVertexFromPose(bay_pose).value())) {
        return std::make_pair(false, "Invalid bay transition! " + std::to_string(*event));
      }
    }
    else if(event->GetType() == volley::ScheduleEventType::AGV_MOVE) {
      auto agv_move = dynamic_cast<volley::AgvMove*>(event.get());

      auto agv = working_state.GetAgv(agv_move->GetAgvId()).value();
      auto collision_id = volley::CollisionEntityIdFromAgvState(agv, working_state, *layout_);

      auto dest_opt = agv_move->GetDest();

      if(!dest_opt.has_value()) {
        // This means it's a lift change. Don't need to check anything else but apply
        auto [success, message] = event->Apply(working_state);
        if(!success) {
          return std::make_pair(
              false, "Failed to apply " + std::to_string(*event) + " to working state. Reason: " + message);
        }
        continue;
      }
      auto dest = dest_opt.value();

      auto [success, message] = IsMovePossible(ctx, working_state, collision_id,
          std::unordered_set<uint16_t>({agv.id}), std::unordered_set<uint16_t>(), agv.pose, dest);

      if(!success) {
        return std::make_pair(false, "Invalid destination for " + std::to_string(*event) + " .: " + message);
      }
    }
    else if(event->GetType() == volley::ScheduleEventType::TRAY_MOVE) {
      auto tray_move = dynamic_cast<volley::TrayMove*>(event.get());
      auto tray = working_state.GetTray(tray_move->GetTrayId().value()).value();
      auto collision_id = volley::CollisionEntityIdFromTrayState(tray, working_state, *layout_);

      auto dest_opt = tray_move->GetDest();
      if(!dest_opt.has_value()) {
        return std::make_pair(false, "Tray move doesn't have destination! " + std::to_string(*event));
      }
      auto dest = dest_opt.value();

      auto [success, message] =
          IsMovePossible(ctx, working_state, collision_id, std::unordered_set<uint16_t>({tray.agv_id}),
              std::unordered_set<uint16_t>({tray.id}), tray.pose, dest);

      if(!success) {
        return std::make_pair(false, "Invalid destination for " + std::to_string(*event) + " .: " + message);
      }
    }

    // Apply after doing checks
    auto [success, message] = event->Apply(working_state);
    if(!success) {
      return std::make_pair(
          false, "Failed to apply " + std::to_string(*event) + " to working state. Reason: " + message);
    }
  }

  return std::make_pair(true, "");
}

void Scheduler::AddDepsAfterAmiga(
    ScheduleContextSPtr ctx, std::shared_ptr<volley::ScheduleEvent> event, uint16_t node_id) const {
  auto event_vert_opt = ctx->events.GetVertexFromEvent(event);
  if(!event_vert_opt.has_value()) {
    WARNS(logger_,
        "AddDepsAfterAmiga got an input event that doesn't exist in the DAG: " << std::to_string(*event));
    return;
  }
  auto event_vert = event_vert_opt.value();
  // If this isn't a VECS or Bay transition then what is it?
  if(event->GetType() != volley::ScheduleEventType::BAY_TRANSITION &&
      event->GetType() != volley::ScheduleEventType::VECS_TRANSITION) {
    WARNS(logger_, "AddDepsAfterAmiga got an input event that isn't a Bay or VECS transition: "
                       << std::to_string(*event));
    return;
  }

  // For every event this bay or VECS transition depends on.
  for(const auto& dependency : boost::make_iterator_range(ctx->events.GetInEdges(event_vert))) {
    auto dependency_event = ctx->events.GetEventFromVertex(dependency.m_source).value();

    // If that dependency is a tray move
    if(dependency_event->GetType() == volley::ScheduleEventType::TRAY_MOVE) {
      auto tray_move = dynamic_cast<volley::TrayMove*>(dependency_event.get());

      auto tray_agv_id = tray_move->GetAgvId().value();
      if(tray_move->GetDest()->node_id == node_id) {
        for(const auto& tray_dependent :
            boost::make_iterator_range(ctx->events.GetOutEdges(dependency.m_source))) {
          auto tray_dependent_event = ctx->events.GetEventFromVertex(tray_dependent.m_target).value();

          if(tray_dependent_event->GetType() == volley::ScheduleEventType::AGV_MOVE) {
            auto agv_move = dynamic_cast<volley::AgvMove*>(tray_dependent_event.get());
            if(agv_move->GetAgvId() == tray_agv_id &&
                std::holds_alternative<AgvLiftChangedMsg>(agv_move->GetDiscreteChange()) &&
                !std::get<AgvLiftChangedMsg>(agv_move->GetDiscreteChange()).raised) {
              ctx->events.AddDependency(tray_dependent_event, event);
            }
          }
        }
      }
    }
  }
  for(const auto& dependency : boost::make_iterator_range(ctx->events.GetOutEdges(event_vert))) {
    auto dependency_event = ctx->events.GetEventFromVertex(dependency.m_target).value();

    // If that dependency is a tray move
    if(dependency_event->GetType() == volley::ScheduleEventType::TRAY_MOVE) {
      auto tray_move = dynamic_cast<volley::TrayMove*>(dependency_event.get());

      auto tray_agv_id = tray_move->GetAgvId().value();
      // Apply events up to the tray move to get the tray's src
      auto new_total_ordering_opt = ctx->events.GetTopologicalOrdering();
      auto working_state = ctx->initial_state;
      for(const auto& curr_event_vert : new_total_ordering_opt.value()) {
        auto curr_event = ctx->events.GetEventFromVertex(curr_event_vert).value();
        if(curr_event == dependency_event) {
          break;
        }
        curr_event->Apply(working_state);
      }

      if(working_state.GetTray(tray_move->GetTrayId().value())->pose.node_id == node_id) {
        for(const auto& tray_dependent :
            boost::make_iterator_range(ctx->events.GetInEdges(dependency.m_target))) {
          auto tray_dependent_event = ctx->events.GetEventFromVertex(tray_dependent.m_source).value();

          if(tray_dependent_event->GetType() == volley::ScheduleEventType::AGV_MOVE) {
            auto agv_move = dynamic_cast<volley::AgvMove*>(tray_dependent_event.get());
            if(agv_move->GetAgvId() == tray_agv_id &&
                std::holds_alternative<AgvLiftChangedMsg>(agv_move->GetDiscreteChange()) &&
                std::get<AgvLiftChangedMsg>(agv_move->GetDiscreteChange()).raised) {
              ctx->events.AddDependency(event, tray_dependent_event);
            }
          }
        }
      }
    }
  }
}

std::optional<volley::ContinuousState> Scheduler::PlanMotions(ScheduleContextSPtr ctx) const {
  // make initial trajectories for elements
  // all elements just stay at their initial state until right now
  volley::ContinuousState initial_trajectories(ctx->initial_state, table_, *layout_, ctx->start_time);

  // Construct edge costs and heuristic. The full Trapezoid edge_durations feed SippEnvironment
  // for "fresh-start" edge cost. The same map seeds the A* heuristic — under Ring 3b's
  // path-dependent run-extension cost this is *inadmissible* (per-edge sum can exceed the
  // coalesced cost-to-go), so A* may return suboptimal paths. We accept that for now in
  // exchange for fast search: GetEdgeMarginalDurations gives a strictly admissible lower
  // bound but is too loose. Tightening the heuristic so it's both admissible and tight is a Ring 3c
  // follow-up.
  auto edge_durations = volley::GetEdgeDurations(gg_, cost_model_);

  auto heuristics =
      volley::GetAllPairsMinCost(gg_, edge_durations, Interval::Duration(0), Interval::Duration::max());

  // This is CHUGG v0.1
  volley::Chugg motion_planner(
      gg_, table_, ctx->events, initial_trajectories, edge_durations, heuristics, cost_model_, logger_);

  // When cost_audit is enabled, capture an auditable per-segment breakdown of where time goes
  // and emit it as CSV INFO log lines (one row per segment + a header) so it can be copy-pasted
  // into a spreadsheet.
  cost::CostVector audit;
  cost::CostVector* audit_ptr = costaudit_ ? &audit : nullptr;
  auto trajectories_opt = motion_planner.SolveSequential(audit_ptr);

  if(audit_ptr && !audit.entries_.empty()) {
    audit.eval();
    const float total_seconds = audit.value().count();
    INFOS(logger_, "CHUGG cost audit total=" << total_seconds << "s entries=" << audit.entries_.size());
    INFOS(logger_, "audit_csv,index,seconds,cumulative,description");
    float running = 0.0f;
    size_t i = 0;
    for(const auto& e : audit.entries_) {
      // Snapshot the entry's duration into a local so the same float value feeds both the
      // running accumulator and the printed `seconds` column. Earlier code re-called
      // e.duration_.count() in the INFOS expression — when an audit row's "seconds" field
      // didn't match the cumulative-delta (the residual we tracked down on costfun22), this
      // is the safest read pattern.
      const float seconds = e.duration_.count();
      running += seconds;
      INFOS(logger_, "audit_csv," << i++ << "," << seconds << "," << running << "," << e.explanation_);
    }
    // Belt-and-suspenders invariant: the print loop's running total must agree with the
    // eval-computed total. If it ever doesn't, log a warning so the divergence is visible
    // instead of silently producing inconsistent CSV rows.
    if(std::abs(running - total_seconds) > 1e-3f) {
      WARNS(logger_, "audit print drift: running=" << running << " total=" << total_seconds
                                                   << " (entries=" << audit.entries_.size() << ")");
    }
  }

  if(trajectories_opt) {
    return trajectories_opt.value();
  }
  else {
    // TODO (mark): more informative errors and stats from Chugg, better error handling
    ERRORS(logger_, "CHUGG failed to find a solution, event dag may be infeasible");
    return std::nullopt;
  }
}

std::pair<std::optional<std::vector<ActionNodeMsg>>, std::string> Scheduler::ResponseFromTrajectories(
    ScheduleContextSPtr ctx, const volley::ContinuousState& final_state) const {
  std::set<Motion, MotionScheduleOrder> all_motions;
  if(auto err = CollectAndCollapseTrajectoryMotions(final_state, *layout_, all_motions); err) {
    ERRORS(logger_, *err);
    return std::make_pair(std::nullopt, *err);
  }

  // Maps action ID to a pair containing the first and last action.
  std::unordered_map<size_t, std::pair<ActionNodeMsg::SharedPtr, ActionNodeMsg::SharedPtr>> event_start_end;
  volley::DagBase<ActionNodeMsg> final_actions_dag;
  volley::GarageOccupancyChecker<std::shared_ptr<ActionNodeMsg>> freeing_moves(table_, gg_);
  if(auto err = BuildActionDagFromMotions(
         all_motions, ctx, final_actions_dag, freeing_moves, event_start_end, logger_);
      err) {
    return std::make_pair(std::nullopt, *err);
  }

  if(printdags_) {
    final_actions_dag.PrintGraph(ctx->request_id_str + "_after_freeing_moves", logger_);
  }
  final_actions_dag.Reduce();
  if(printdags_) {
    final_actions_dag.PrintGraph(ctx->request_id_str + "_after_freeing_moves_reduced", logger_);
  }

  // Transfer event-DAG dependencies to the action DAG. Tray-move deps end up on the lifts
  // rather than the motions themselves; freeing_moves handles motion conflicts directly.
  if(auto err = TransferEventDagDepsToActionDag(ctx, event_start_end, final_actions_dag, logger_); err) {
    return std::make_pair(std::nullopt, *err);
  }

  if(printdags_) {
    final_actions_dag.PrintGraph(ctx->request_id_str + "_after_event_dag_merge", logger_);
  }
  // Clean up the DAG, since we added a bunch of overkill dependencies.
  final_actions_dag.Reduce();
  if(printdags_) {
    final_actions_dag.PrintGraph(ctx->request_id_str + "_after_event_dag_merge_reduced", logger_);
  }

  const auto vrc_insertion_result =
      InsertVrcActionsIntoDag(final_actions_dag, *layout_, ctx->initial_state, cost_model_);
  if(!vrc_insertion_result.has_value()) {
    ERRORS(logger_, vrc_insertion_result.error());
    return std::make_pair(std::nullopt, vrc_insertion_result.error());
  }

  final_actions_dag.Reduce();
  if(printdags_) {
    final_actions_dag.PrintGraph(ctx->request_id_str + "_after_vrc_insertion", logger_);
  }

  const auto final_ordering = final_actions_dag.GetTopologicalOrdering();
  if(!final_ordering.has_value()) {
    ERRORS(logger_, "Failed to get final ordering for action DAG!");
    return std::make_pair(std::nullopt, "Failed to get final ordering for action DAG!");
  }

  return std::make_pair(BuildScheduledActionsArray(ctx, final_actions_dag, final_ordering.value()), "");
}

BoolStringPair Scheduler::IsMovePossible(ScheduleContextSPtr ctx,
    const volley::DiscreteGarageState& working_state, const volley::CollisionEntityId_t& collision_id,
    const std::unordered_set<uint16_t>& ignore_agvs, const std::unordered_set<uint16_t>& ignore_trays,
    const GaragePoseMsg& start_pose, const GaragePoseMsg& dest) const {
  // Check that destination isn't disabled
  auto dest_vert_opt = gg_.GetVertexFromPose(dest);
  if(!dest_vert_opt.has_value()) {
    return std::make_pair(
        false, "Tried to move to a destination that doesn't exist: " + std::to_string(dest));
  }
  auto dest_vert = dest_vert_opt.value();
  if(!ctx->disabledness_filters[collision_id].IsEnabled(dest_vert)) {
    return std::make_pair(false, "Tried to move to a disabled location: " + std::to_string(dest));
  }

  // Check that destination isn't occupied
  auto filters = volley::GetStaticFilter(
      collision_id, gg_, working_state, table_, ignore_trays, ignore_agvs, std::unordered_set<uint16_t>());
  if(!filters.IsEnabled(dest_vert)) {
    return std::make_pair(false, "Requested to move to " + std::to_string(dest) + " but it's occupied.");
  }

  // Check that a path exists to destination
  std::vector<GaragePoseMsg> pose_path = volley::GetPosePath(gg_, start_pose, dest, cost_model_, filters);
  if(pose_path.empty()) {
    return std::make_pair(false, "Scheduler::IsMovePossible() Cannot find path from " +
                                     std::to_string(start_pose) + " to " + std::to_string(dest));
  }

  return std::make_pair(true, "");
}

ScheduledJobDataMsg Scheduler::FailJob(
    const SchedulerJobMsg& job, const std::string& failure_message, bool retain_job) const {
  // TODO(Joe): Take a Context as well, and strip all the events which may be in the dag
  // for the now failed job
  ScheduledJobDataMsg scheduled_job {};
  scheduled_job.job = job;
  scheduled_job.job.retain_job = retain_job;
  scheduled_job.job.state = SchedulerJobMsg::STATE_ERROR;
  scheduled_job.job.state_name = "STATE_ERROR";
  scheduled_job.job.note = failure_message;

  WARNS(logger_, "Failed job: " << std::to_string(job) << " with message: " << failure_message);

  return scheduled_job;
}

bool Scheduler::SetBayReadinessRatioCallback(
    SetFloat32Srv::Request::SharedPtr request, SetFloat32Srv::Response::SharedPtr response) {
  INFOS(logger_, "Received request to set Bay Readiness Ratio to " << std::to_string(request->value));
  bool changed = false;
  if(request->value < 0.0 || request->value > 1.0) {
    response->success = false;
    response->message = "Cannot accept Bay Readiness Ratio: " + std::to_string(request->value) +
                        " must be between 0.0 and 1.0";
    WARNS(logger_, response->message);
    return changed;
  }

  if(request->value != bay_readiness_ratio_) {
    // publish message to dispatch, to enqueue a CleanGarage job
    changed = true;
  }
  bay_readiness_ratio_ = request->value;
  response->success = true;
  return changed;
}

