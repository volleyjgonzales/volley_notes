TEST(Scheduler, GetJustMovingCost) {
  volley::DiscreteGarageState state;
  auto [success, msg] = state.Set(YAML::Load(R"YML(
is_faulted: false
agvs:
-
  id: 1
  state: 4
  lift: false
  pose:
    node_id: 8
    heading: 0
trays:
-
  id: 1
  pose:
    node_id: 1
    heading: 90
bays: []
payloads: []
disabled_nodes: []
hash: 0)YML"));

  EXPECT_TRUE(success) << msg;

  const auto layout_filepath_or = GetLayoutPathByName(kTinyLotLayoutName);
  ASSERT_TRUE(layout_filepath_or.has_value()) << layout_filepath_or.error();
  const auto& layout_filepath = layout_filepath_or.value();

  auto logger = rclcpp::get_logger("scheduler");

  Scheduler scheduler(layout_filepath, logger, SchedulerParams {});

  GaragePoseMsg start_pose;
  GaragePoseMsg end_pose;
  auto agv_id = volley::AgvId(1u);
  {
    // Start and end are same; cost is 0
    start_pose.node_id = 1;
    start_pose.heading = 90;
    end_pose.node_id = 1;
    end_pose.heading = 90;
    auto cost_opt = scheduler.GetJustMovingCost(start_pose, end_pose, agv_id, false);
    EXPECT_TRUE(cost_opt.has_value());
    EXPECT_EQ(cost_opt.value(), volley::Interval::Duration::zero());
  }
  {
    // Start and end are two different poses; succeeds with nonzero cost
    start_pose.node_id = 8;
    start_pose.heading = 0;
    end_pose.node_id = 1;
    end_pose.heading = 90;
    auto cost_opt = scheduler.GetJustMovingCost(start_pose, end_pose, agv_id, false);
    EXPECT_TRUE(cost_opt.has_value());
    EXPECT_GT(cost_opt.value(), volley::Interval::Duration::zero());
  }
  {
    // Loaded AGV should take longer than unloaded over the same path
    start_pose.node_id = 8;
    start_pose.heading = 0;
    end_pose.node_id = 1;
    end_pose.heading = 90;
    auto unloaded = scheduler.GetJustMovingCost(start_pose, end_pose, agv_id, /*is_agv_loaded=*/false);
    auto loaded = scheduler.GetJustMovingCost(start_pose, end_pose, agv_id, /*is_agv_loaded=*/true);
    EXPECT_TRUE(unloaded.has_value());
    EXPECT_TRUE(loaded.has_value());
    EXPECT_GT(loaded.value(), unloaded.value());
  }
}

