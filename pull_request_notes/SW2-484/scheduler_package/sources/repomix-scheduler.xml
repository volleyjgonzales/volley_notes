  transition_2.state = SchedulerJobMsg::STATE_UNPLANNED;
  transition_2.guid = volley::MakeGuid(0u, 32u);
  transition_2.time_registered = now;
  transition_2.bay_id = 1;
  transition_2.type = SchedulerJobMsg::TYPE_TRANSITION_BAY_TO_INSERT;
  request_data.pending_jobs[0] = std::move(transition_2);

  {
    auto response = scheduler.Plan(request_data, now);

    EXPECT_EQ(response.success, true) << response.message;

    ASSERT_EQ(1u, response.scheduled_jobs.size());

    // incorrect transition type for bay state so fail to plan
    auto job = response.scheduled_jobs[0];
    EXPECT_EQ(SchedulerJobMsg::STATE_ERROR, job.job.state);
    EXPECT_EQ(0u, response.schedule.nodes.size());
