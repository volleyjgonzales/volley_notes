TEST(UtilsTests, ComputeBayRebalancingActions) {
  std::vector<uint16_t> prioritization = {1, 2, 3, 4};
  {
    int n_desired_insert = 2;
    int n_desired_retrieve = 2;

    std::unordered_map<uint16_t, BayClassification> classifications;
    classifications.insert({1u, BayClassification::INSERT_READY});
    classifications.insert({2u, BayClassification::INSERT_READY});
    classifications.insert({3u, BayClassification::RETRIEVE_READY});
    classifications.insert({4u, BayClassification::RETRIEVE_READY});

    auto [move_to_insert, move_to_retrieve] =
        ComputeBayRebalancingActions(classifications, prioritization, n_desired_insert, n_desired_retrieve);

    // Exactly as they should be
    EXPECT_EQ(0u, move_to_insert.size());
    EXPECT_EQ(0u, move_to_retrieve.size());
  }
  {
    int n_desired_insert = 2;
    int n_desired_retrieve = 2;

    std::unordered_map<uint16_t, BayClassification> classifications;
    classifications[1u] = BayClassification::WILL_BE_INSERT_READY;
    classifications[2u] = BayClassification::WILL_BE_INSERT_READY;
    classifications[3u] = BayClassification::WILL_BE_RETRIEVE_READY;
    classifications[4u] = BayClassification::WILL_BE_RETRIEVE_READY;

    auto [move_to_insert, move_to_retrieve] =
        ComputeBayRebalancingActions(classifications, prioritization, n_desired_insert, n_desired_retrieve);

    // Still nothing bc they all will be in the right state
    EXPECT_EQ(0u, move_to_insert.size());
    EXPECT_EQ(0u, move_to_retrieve.size());
  }
  {
    int n_desired_insert = 2;
    int n_desired_retrieve = 2;

    std::unordered_map<uint16_t, BayClassification> classifications;
    classifications[1u] = BayClassification::RETRIEVE_READY;
    classifications[2u] = BayClassification::RETRIEVE_READY;
    classifications[3u] = BayClassification::INSERT_READY;
    classifications[4u] = BayClassification::INSERT_READY;

    auto [move_to_insert, move_to_retrieve] =
        ComputeBayRebalancingActions(classifications, prioritization, n_desired_insert, n_desired_retrieve);

    // Even though this is opposite of the prioritization, the number of desired bays in each
    // direction are satisfied. So we don't plan to transition any of them
    EXPECT_EQ(0u, move_to_insert.size());
    EXPECT_EQ(0u, move_to_retrieve.size());
  }
  {
    int n_desired_insert = 3;
    int n_desired_retrieve = 1;

    std::unordered_map<uint16_t, BayClassification> classifications;
    classifications[1u] = BayClassification::RETRIEVE_READY;
    classifications[2u] = BayClassification::RETRIEVE_READY;
    classifications[3u] = BayClassification::INSERT_READY;
    classifications[4u] = BayClassification::INSERT_READY;

    auto [move_to_insert, move_to_retrieve] =
        ComputeBayRebalancingActions(classifications, prioritization, n_desired_insert, n_desired_retrieve);

    // Transition one to insert
    ASSERT_EQ(1u, move_to_insert.size());
    EXPECT_EQ(1u, move_to_insert[0]);
    EXPECT_EQ(0u, move_to_retrieve.size());
  }
  {
    int n_desired_insert = 1;
    int n_desired_retrieve = 3;

    std::unordered_map<uint16_t, BayClassification> classifications;
    classifications[1u] = BayClassification::RETRIEVE_READY;
    classifications[2u] = BayClassification::RETRIEVE_READY;
    classifications[3u] = BayClassification::INSERT_READY;
    classifications[4u] = BayClassification::INSERT_READY;

    auto [move_to_insert, move_to_retrieve] =
        ComputeBayRebalancingActions(classifications, prioritization, n_desired_insert, n_desired_retrieve);

    // Transition one to retrieve
    ASSERT_EQ(0u, move_to_insert.size());
    ASSERT_EQ(1u, move_to_retrieve.size());
    EXPECT_EQ(4u, move_to_retrieve[0]);
  }
  {
    int n_desired_insert = 2;
    int n_desired_retrieve = 2;

    std::unordered_map<uint16_t, BayClassification> classifications;
    classifications[1u] = BayClassification::RETRIEVE_READY_BUT_INVALID;
    classifications[2u] = BayClassification::RETRIEVE_READY_BUT_INVALID;
    classifications[3u] = BayClassification::INSERT_READY_BUT_INVALID;
    classifications[4u] = BayClassification::INSERT_READY_BUT_INVALID;

    auto [move_to_insert, move_to_retrieve] =
        ComputeBayRebalancingActions(classifications, prioritization, n_desired_insert, n_desired_retrieve);

    // They're all invalid so transition them all by order of prioritization
    ASSERT_EQ(2u, move_to_insert.size());
    EXPECT_EQ(1u, move_to_insert[0]);
    EXPECT_EQ(2u, move_to_insert[1]);
    ASSERT_EQ(2u, move_to_retrieve.size());
    EXPECT_EQ(4u, move_to_retrieve[0]);
    EXPECT_EQ(3u, move_to_retrieve[1]);
  }
  {
    int n_desired_insert = 2;
    int n_desired_retrieve = 2;

    std::unordered_map<uint16_t, BayClassification> classifications;
    classifications[1u] = BayClassification::WILL_BE_INSERT_READY;
    classifications[2u] = BayClassification::WILL_BE_INSERT_READY;
    classifications[3u] = BayClassification::WILL_BE_INSERT_READY;
    classifications[4u] = BayClassification::WILL_BE_RETRIEVE_READY;

    auto [move_to_insert, move_to_retrieve] =
        ComputeBayRebalancingActions(classifications, prioritization, n_desired_insert, n_desired_retrieve);

    // Even though these are the wrong numbers, do nothing bc they're all in transition
    EXPECT_EQ(0u, move_to_insert.size());
    EXPECT_EQ(0u, move_to_retrieve.size());
  }
}

}  // namespace volley
