namespace volley {

std::pair<std::optional<volley::DiscreteGarageState>, std::string> ValidateBaseState(
    const DiscreteGarageStateMsg& state, const volley::Layout& layout) {
  // First we make sure that the garage state message is valid (all entities can be added to a
  // DGS)
  volley::DiscreteGarageState garage_state;
  auto [success, message] = garage_state.Set(state);
  if(!success) {
    return std::make_pair(std::nullopt, message);
  }

  // Make sure that all payloads fit into a resource size window in the layout
  for(const auto& [payload_id, payload] : garage_state.GetPayloads()) {
    auto resource_idx_opt = layout.GetSmallestEnclosingResourceSizeIndex(
        payload.payload.length_m, payload.payload.width_m, payload.payload.height_m);
    if(!resource_idx_opt.has_value()) {
      return std::make_pair(
          std::nullopt, "Payload " + std::to_string(payload_id) +
                            " does not fit into any resource size windows for this layout! Length: " +
                            std::to_string(payload.payload.length_m) +
                            ", Width: " + std::to_string(payload.payload.width_m) +
                            ", Height: " + std::to_string(payload.payload.height_m));
    }
  }

  // Make sure AGVs and trays are on valid poses
  for(const auto& [agv_id, agv] : garage_state.GetAgvs()) {
    if(!layout.HasGaragePose(agv.pose)) {
      return std::make_pair(std::nullopt,
          std::to_string(volley::AgvId(agv_id)) + " is on non-existent pose: " + std::to_string(agv.pose));
    }
  }
  for(const auto& [tray_id, tray] : garage_state.GetTrays()) {
    if(!layout.HasGaragePose(tray.pose)) {
      return std::make_pair(std::nullopt,
          std::to_string(volley::TrayId(tray_id)) + " is on non-existent pose: " + std::to_string(tray.pose));
    }
  }

  return std::make_pair(garage_state, "");
}

BayClassification ClassifyBay(uint8_t state, bool tray_in_bay, bool payload_in_bay) {
  if(payload_in_bay && !tray_in_bay) {
    return BayClassification::NOT_USABLE;
  }

  bool occupied_indefinitely =
      state == BayReportMsg::STATE_PROCESSING_INSERT || state == BayReportMsg::STATE_PROCESSING_RETRIEVE;

  if(occupied_indefinitely) {
    // If the bay is occupied, predict the bay state after the corresponding job has finished
    // using the working state. If the bay is processing either an insert or a retrieve there
    // should be a tray and a payload in the bay. Big issue if not
    if(!(tray_in_bay && payload_in_bay)) {
      return BayClassification::NOT_USABLE;
    }
    if(state == BayReportMsg::STATE_PROCESSING_INSERT) {
      return BayClassification::WILL_BE_RETRIEVE_READY_BUT_INVALID;
    }
    else if(state == BayReportMsg::STATE_PROCESSING_RETRIEVE) {
      return BayClassification::WILL_BE_INSERT_READY;
    }
    else {
      // This should never happen
      return BayClassification::NOT_USABLE;
    }
  }
  else {
    if(state == BayReportMsg::STATE_READY_TO_INSERT) {
      if(tray_in_bay && !payload_in_bay) {
        // Only insert ready if RTI, tray, no payload
        return BayClassification::INSERT_READY;
      }
      else {
        return BayClassification::INSERT_READY_BUT_INVALID;
      }
    }
    else if(state == BayReportMsg::STATE_READY_TO_RETRIEVE) {
      if(!tray_in_bay && !payload_in_bay) {
        return BayClassification::RETRIEVE_READY;
      }
      else {
        return BayClassification::RETRIEVE_READY_BUT_INVALID;
      }
    }
    else {
      return BayClassification::NOT_USABLE;
    }
  }
}

std::unordered_map<uint16_t, BayClassification> ClassifyBays(const volley::DiscreteGarageState& state) {
  std::unordered_map<uint16_t, BayClassification> classification_map;

  for(const auto& [bay_id, bay] : state.GetBays()) {
    // Any disabled bay is not usable
    if(bay.disabled) {
      classification_map.emplace(bay_id, BayClassification::NOT_USABLE);
      continue;
    }
    auto tray_opt = state.GetTrayOnNode(bay_id);

    bool tray_in_bay = tray_opt.has_value();
    bool payload_in_bay = tray_in_bay and (tray_opt->payload_id != volley::kEmptyGuid);

    classification_map.emplace(bay_id, ClassifyBay(bay.state, tray_in_bay, payload_in_bay));
  }

  return classification_map;
}

std::pair<int, int> CalculateDesiredBaySplit(
    float desired_bay_readiness_ratio, int n_eligible_bays, int n_empty_trays) {
  // Number of bays we wish to move to ready-to-insert.
  // We bias to ready-to-insert in order to serve customers that arrive to insert. We cannot
  // actually detect customers that arrive, so in a one-bay system we want our bay to bias to
  // insert.
  auto n_desired_insert_ready_bays =
      static_cast<int>(std::ceil(desired_bay_readiness_ratio * static_cast<float>(n_eligible_bays)));

  // Clamp in case we have an invalid readiness ratio
  n_desired_insert_ready_bays = std::clamp(n_desired_insert_ready_bays, 0, n_eligible_bays);

  // We cannot transition more bays to insert than we have empty trays
  n_desired_insert_ready_bays = std::min(n_desired_insert_ready_bays, n_empty_trays);

  int n_desired_retrieve_ready_bays = n_eligible_bays - n_desired_insert_ready_bays;

  return std::make_pair(n_desired_insert_ready_bays, n_desired_retrieve_ready_bays);
}

std::pair<std::vector<uint16_t>, std::vector<uint16_t>> ComputeBayRebalancingActions(
    std::unordered_map<uint16_t, BayClassification> bay_classifications,
    const std::vector<uint16_t>& bay_prioritization, int n_desired_insert_ready_bays,
    int n_desired_retrieve_ready_bays) {
  // return value
  std::pair<std::vector<uint16_t>, std::vector<uint16_t>> bay_state_changes;
  bay_state_changes.first = std::vector<uint16_t>();
  bay_state_changes.second = std::vector<uint16_t>();

  // This basically validates the bay prioritization values. This will cause a silent failure.
  // Should probably live elsewhere
  for(const auto& bay_id : bay_prioritization) {
    if(!bay_classifications.count(bay_id)) {
      return bay_state_changes;
    }
  }

  // The set of bays that we do not want to change the state of, either because they are in
  // motion, already in a desired state, or have already been added to a list of bays to
  // transition.
  std::unordered_set<uint16_t> dont_change_these_bays;

  // 1. Loop over all bays and process the effect for all whose state we currently cannot affect
  // (i.e., the ones that are in transit).
  for(const auto& [bay_id, classification] : bay_classifications) {
    // NOTE: WILL_BE_INSERT_READY_BUT_INVALID and WILL_BE_RETRIEVE_READY_BUT_INVALID cannot be
    // currently affected either.
    if(classification == BayClassification::WILL_BE_INSERT_READY) {
      // Will satisfy one insert-ready bay
      dont_change_these_bays.emplace(bay_id);
      n_desired_insert_ready_bays--;
    }
    else if(classification == BayClassification::WILL_BE_RETRIEVE_READY) {
      // Will satisfy one retrieve-ready bay
      dont_change_these_bays.emplace(bay_id);
      n_desired_retrieve_ready_bays--;
    }
  }

  // NOTE: The reason step 2 is separated from step 4 and step 3 from step 5 is because we would
  // prefer having slightly suboptimal (relative to bay prioritization preferences) bay states
  // if that means fewer bay state changes are required.
  // For example: bay prioritization = {1, 2, 3, 4}. Bays 2 and 3 are in ready for insert, bays 1
  // and 4 are in ready for retrieve, and n_desired_insert_ready = n_desired_retrieve_ready = 2.
  // With the steps separated as they are, no bay state changes happen, which is preferred. If the
  // loops were combined, then bay 1 would transition to ready for insert and bay 3 would
  // transition to ready for retrieve, which is more aligned to our preferences but adds jobs

  // 2. Loop over bays in order of ready for insert prioritization. Process the effect of those
  // that are already in ready for insert and make sure it won't get changed
  for(const auto& bay_id : bay_prioritization) {
    // If we have enough bays in ready for insert, break out of the loop
    if(n_desired_insert_ready_bays <= 0) {
      break;
    }

    const auto& classification = bay_classifications.at(bay_id);
    if(classification == BayClassification::INSERT_READY) {
      dont_change_these_bays.emplace(bay_id);
      n_desired_insert_ready_bays--;
    }
  }

  // 3. Loop over bays in order of ready for retrieve prioritization. Process the effect of those
  // that are already in ready for retrieve and make sure it won't get changed
  for(auto it = bay_prioritization.rbegin(); it != bay_prioritization.rend(); ++it) {
    // If we have enough bays in ready for retrieve, break out of the loop
    if(n_desired_retrieve_ready_bays <= 0) {
      break;
    }
    const auto& bay_id = *it;

    const auto& classification = bay_classifications.at(bay_id);
    if(classification == BayClassification::RETRIEVE_READY) {
      dont_change_these_bays.emplace(bay_id);
      n_desired_retrieve_ready_bays--;
    }
  }

  // 4. Loop over bays in order of ready for insert prioritization and consider transitioning them
  // to ready for insert
  for(const auto& bay_id : bay_prioritization) {
    // If we have enough bays in ready for insert, don't consider changing any more
    if(n_desired_insert_ready_bays <= 0) {
      break;
    }
    // If this bay has already been determined to be in a correct state, don't consider changing
    // it
    if(dont_change_these_bays.count(bay_id)) {
      continue;
    }

    const auto& classification = bay_classifications.at(bay_id);
    if(classification == BayClassification::RETRIEVE_READY ||
        classification == BayClassification::INSERT_READY_BUT_INVALID ||
        classification == BayClassification::RETRIEVE_READY_BUT_INVALID) {
      bay_state_changes.first.push_back(bay_id);
      dont_change_these_bays.emplace(bay_id);
      n_desired_insert_ready_bays--;
    }
  }

  // 5. Loop over bays in order of ready for retrieve prioritization and consider transitioning
  // them to ready for retrieve
  for(auto it = bay_prioritization.rbegin(); it != bay_prioritization.rend(); ++it) {
    // If we have enough bays in ready for retrieve, don't consider changing any more
    if(n_desired_retrieve_ready_bays <= 0) {
      break;
    }
    const auto& bay_id = *it;
    // If this bay has already been determined to be in a correct state, don't consider changing
    // it
    if(dont_change_these_bays.count(bay_id)) {
      continue;
    }

    const auto& classification = bay_classifications.at(bay_id);
    if(classification == BayClassification::INSERT_READY ||
        classification == BayClassification::RETRIEVE_READY_BUT_INVALID ||
        classification == BayClassification::INSERT_READY_BUT_INVALID) {
      bay_state_changes.second.push_back(bay_id);
      dont_change_these_bays.emplace(bay_id);
      n_desired_retrieve_ready_bays--;
    }
  }

  // 6. Do a check to see if any bays in invalid states don't have a bay_state_changes match
  for(const auto& [bay_id, classification] : bay_classifications) {
    if(dont_change_these_bays.find(bay_id) != dont_change_these_bays.end()) {
      continue;
    }
    if(classification == BayClassification::INSERT_READY_BUT_INVALID ||
        classification == BayClassification::RETRIEVE_READY_BUT_INVALID) {
      // As a fallback, make bays in invalid states ready-to-retrieve
      bay_state_changes.second.push_back(bay_id);
    }
  }

  return bay_state_changes;
}

std::pair<std::vector<uint16_t>, std::vector<uint16_t>> ComputeBayRebalancingActions(
    const volley::DiscreteGarageState& state, const std::vector<uint16_t>& bay_prioritization,
    float desired_bay_readiness_ratio) {
  // Classify each bay.
  auto bay_classifications = ClassifyBays(state);

  // We cannot move more bays to READY_TO_INSERT than there are empty trays
  int n_empty_trays = CountEmptyTrays(state);

  // Count how many bays are eligible (denominator)
  int n_eligible_bays = 0;
  for(const auto& [bay_id, classification] : bay_classifications) {
    n_eligible_bays += (classification != BayClassification::NOT_USABLE);
  }

  // Determine desired number of INSERT_READY and RETRIEVE_READY bays
  auto [n_desired_insert_ready_bays, n_desired_retrieve_ready_bays] =
      CalculateDesiredBaySplit(desired_bay_readiness_ratio, n_eligible_bays, n_empty_trays);

  return ComputeBayRebalancingActions(
      bay_classifications, bay_prioritization, n_desired_insert_ready_bays, n_desired_retrieve_ready_bays);
}

GuidMsg CreateActionGuid() {
  static uint64_t guid_counter = 1;
  return volley::MakeGuid(0u, guid_counter++);
}

bool IsFloorTraversalMotion(const Motion& motion, const Layout& layout) {
  const auto delta = motion.GetDelta();
  if(!delta.has_value() || delta.value().type != "AgvPoseChanged") {
    return false;
  }

  const auto agv_pose_change = Deserialize<AgvPoseChangedMsg>(delta.value());
  if(!agv_pose_change) {
    return false;
  }

  const auto src_layout_node = layout.GetNodeById(agv_pose_change->node_id_curr);
  const auto dst_layout_node = layout.GetNodeById(agv_pose_change->node_id_next);
  if(!src_layout_node.has_value() || !dst_layout_node.has_value()) {
    return false;
  }

  return src_layout_node.value().floor != dst_layout_node.value().floor;
}

bool IsFloorTraversalAction(const ActionNodeMsg& action_node, const Layout& layout) {
  if(action_node.type != ActionNodeMsg::TYPE_AGV_COMMAND) {
    return false;
  }

  const auto src_layout_node = layout.GetNodeById(action_node.agv_command.src.pose.node_id);
  const auto dst_layout_node = layout.GetNodeById(action_node.agv_command.dst.pose.node_id);
  if(!src_layout_node.has_value() || !dst_layout_node.has_value()) {
    return false;
  }

  return src_layout_node.value().floor != dst_layout_node.value().floor;
}

namespace {
// Total VRC action duration (seconds): close start gate + carriage transit (trapezoid) + open
// destination gate. The same sequence applies whether the carriage is empty (approach) or
// carrying an AGV (move).
float VrcFloorTransitDuration(const Layout& layout, uint16_t src_floor_id, uint16_t dst_floor_id,
    const cost::MotionCostModel& cost_model) {
  if(src_floor_id == dst_floor_id) {
    return 0.0f;
  }
  auto src_z = layout.GetFloorZForFloorId(src_floor_id);
  auto dst_z = layout.GetFloorZForFloorId(dst_floor_id);
  if(!src_z || !dst_z) {
    return 0.0f;
  }
  const Transition transition {std::abs(dst_z.value() - src_z.value()), TransitionType::VRC_TRANSITION};
  const auto& events = cost_model.Params().events;
  return events.vrc_door_close + cost_model.Duration(transition).count() + events.vrc_door_open;
}
}  // namespace

stdx::Result InsertVrcActionsIntoDag(DagBase<ActionNodeMsg>& actions_dag, const Layout& layout,
    const DiscreteGarageState& initial_state, const cost::MotionCostModel& cost_model) {
  // Walk all AGV actions in topological order. For each AGV action whose src or dst is on a VRC,
  // emit an approach command if the simulated carriage floor does not match the required entry
  // floor, and additionally a move command for cross-floor actions. The earlier handler only fired
  // on cross-floor actions and missed same-floor visits (waypoint -> lift, lift -> parking on the
  // same floor) — that left the AGV at a VRC node while the carriage was elsewhere, which
  // simulation tolerated but real hardware would not.

  // Track the most recent action that touched each VRC. Subsequent VRC commands serialize behind
  // this so we don't move the carriage out from under an in-flight AGV transition.
  std::unordered_map<uint16_t, std::shared_ptr<ActionNodeMsg>> last_vrc_action;
  // Track the simulated VRC floor as commands are inserted, so multi-hop plans within a single
  // schedule correctly account for where the VRC will be at each step.
  std::unordered_map<uint16_t, uint16_t> vrc_simulated_floor;

  const auto pre_vrc_order = actions_dag.GetTopologicalOrdering();
  if(!pre_vrc_order.has_value()) {
    return stdx::Unexpected("Failed to get pre-VRC topological order for action DAG");
  }

  for(const auto& vert : pre_vrc_order.value()) {
    const auto action_opt = actions_dag.GetFromVertex(vert);
    if(!action_opt.has_value()) {
      continue;
    }
    const auto& action = action_opt.value();
    if(action->type != ActionNodeMsg::TYPE_AGV_COMMAND) {
      continue;
    }
    const auto src_node_opt = layout.GetNodeById(action->agv_command.src.pose.node_id);
    const auto dst_node_opt = layout.GetNodeById(action->agv_command.dst.pose.node_id);
    if(!src_node_opt.has_value() || !dst_node_opt.has_value()) {
      continue;
    }
    const GarageNodeMsg src_node = src_node_opt.value();
    const GarageNodeMsg dst_node = dst_node_opt.value();

    const auto src_vrc = layout.GetVrcForNodeId(src_node.id);
    const auto dst_vrc = layout.GetVrcForNodeId(dst_node.id);
    if(!src_vrc.has_value() && !dst_vrc.has_value()) {
      continue;  // doesn't touch any VRC
    }

    const bool cross_floor = (src_node.floor != dst_node.floor);
    if(cross_floor) {
      // Cross-floor implies an edge along a VRC, so both endpoints must be VRC nodes on the same
      // VRC.
      if(!src_vrc.has_value() || !dst_vrc.has_value() || src_vrc.value().id != dst_vrc.value().id) {
        return stdx::Unexpected(
            "Cannot process move across floors from node {} to node {} as they are not on the same VRC",
            src_node.id, dst_node.id);
      }
    }

    const Vrc vrc = src_vrc.has_value() ? src_vrc.value() : dst_vrc.value();
    // Floor the carriage must be at when the AGV action begins. If the AGV starts on the VRC node,
    // that's src.floor; if it starts on a same-floor neighbor and ends on the VRC node, the AGV's
    // floor is identical (same-floor case) so dst.floor works either way.
    const uint16_t required_start_floor = src_vrc.has_value() ? src_node.floor : dst_node.floor;
    // Floor the carriage will be at when the AGV action ends. For same-floor this equals the start
    // floor; for cross-floor (VRC ride) it's dst.floor.
    const uint16_t end_floor = dst_node.floor;

    if(!vrc_simulated_floor.contains(vrc.id)) {
      auto vrc_state = initial_state.GetVrc(vrc.id);
      vrc_simulated_floor[vrc.id] =
          vrc_state.has_value() ? vrc_state.value().current_floor : required_start_floor;
    }
    const uint16_t vrc_current_floor = vrc_simulated_floor.at(vrc.id);

    // Emit an approach command if the carriage is not at the AGV's start floor. This applies to
    // both same-floor visits (the bug fix) and cross-floor entries (the existing behavior).
    if(vrc_current_floor != required_start_floor) {
      auto vrc_approach_action = std::make_shared<ActionNodeMsg>();
      vrc_approach_action->guid = CreateActionGuid();
      vrc_approach_action->job_id = action->job_id;
      vrc_approach_action->type = ActionNodeMsg::TYPE_VRC_COMMAND;
      vrc_approach_action->vrc_id = vrc.id;
      vrc_approach_action->vrc_command.command_id = "VrcCommand";
      vrc_approach_action->vrc_command.command_type = VrcCommandMsg::COMMAND_TYPE_MOVE;
      vrc_approach_action->vrc_command.requested_floor = required_start_floor;
      vrc_approach_action->duration =
          VrcFloorTransitDuration(layout, vrc_current_floor, required_start_floor, cost_model);

      actions_dag.Add(vrc_approach_action);
      // Approach must complete before this AGV action begins.
      actions_dag.AddDependency(vrc_approach_action, action);
      // Serialize behind any prior VRC user. Skip this edge if it would close a cycle:
      // pre_vrc_order is a single topological order of the pre-VRC DAG and parallel branches
      // can be interleaved so that an AGV action processed in this iteration is actually
      // upstream of last_vrc_action in the post-VRC chain (e.g. via a prior cross-floor's
      // exit_vrc_action linking through this AGV's chain). In that case, vrc_simulated_floor
      // already reflects a later iteration's effect on the carriage, so this approach is
      // redundant for serialization — the existing edges already imply correct ordering.
      if(last_vrc_action.contains(vrc.id) &&
          !actions_dag.WouldCreateCycle(last_vrc_action.at(vrc.id), vrc_approach_action)) {
        actions_dag.AddDependency(last_vrc_action.at(vrc.id), vrc_approach_action);
      }
      last_vrc_action[vrc.id] = vrc_approach_action;
      vrc_simulated_floor[vrc.id] = required_start_floor;
    }

    if(cross_floor) {
      // Cross-floor: emit a move command paired with this AGV action.
      auto vrc_move_action = std::make_shared<ActionNodeMsg>();
      vrc_move_action->guid = CreateActionGuid();
      vrc_move_action->job_id = action->job_id;
      vrc_move_action->type = ActionNodeMsg::TYPE_VRC_COMMAND;
      vrc_move_action->vrc_id = vrc.id;
      vrc_move_action->vrc_command.command_id = "VrcCommand";
      vrc_move_action->vrc_command.command_type = VrcCommandMsg::COMMAND_TYPE_MOVE;
      vrc_move_action->vrc_command.requested_floor = end_floor;
      vrc_move_action->duration =
          VrcFloorTransitDuration(layout, required_start_floor, end_floor, cost_model);

      const auto agv_id = action->agv_id;
      actions_dag.Replace(action, std::move(vrc_move_action));

      // Locate enter (parent AGV action for same agv) and exit (child AGV action whose src is
      // dst_node).
      std::shared_ptr<ActionNodeMsg> exit_vrc_action = nullptr;
      for(const auto& edge : boost::make_iterator_range(actions_dag.GetOutEdges(vert))) {
        const auto child_action = actions_dag.GetFromVertex(edge.m_target).value();
        if(child_action->type == ActionNodeMsg::TYPE_AGV_COMMAND && child_action->agv_id == agv_id &&
            child_action->agv_command.src.pose.node_id == dst_node.id) {
          exit_vrc_action = child_action;
          break;
        }
      }

      // Skip the prior-VRC-user serialization edge if it would cycle (see same-floor approach
      // block above for the explanation; same mechanism applies to cross-floor moves).
      if(last_vrc_action.contains(vrc.id) &&
          !actions_dag.WouldCreateCycle(last_vrc_action.at(vrc.id), vrc_move_action)) {
        actions_dag.AddDependency(last_vrc_action.at(vrc.id), vrc_move_action);
      }

      // After the cross-floor AGV ride, the carriage is at end_floor and the AGV is still on it
      // until exit_vrc_action runs. Use exit_vrc_action as the next serialization point if found.
      last_vrc_action[vrc.id] = exit_vrc_action ? exit_vrc_action : vrc_move_action;
    }
    else {
      // Same-floor visit: the AGV occupies the carriage at one floor; subsequent VRC commands must
      // wait for this AGV action to complete before potentially moving the carriage.
      last_vrc_action[vrc.id] = action;
    }

    vrc_simulated_floor[vrc.id] = end_floor;
  }

  return {};
}

}  // namespace volley
