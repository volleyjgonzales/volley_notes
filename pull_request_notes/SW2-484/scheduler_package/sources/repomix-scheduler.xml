TEST(UtilsTests, CountEmptyTrays) {
  volley::DiscreteGarageState state;

  // Add 4 trays
  {
    TrayExistenceChangedMsg tray_added {};
    tray_added.added = true;
    tray_added.tray_id = 1;
    tray_added.node_id = 1;
    tray_added.heading = 0;
    EXPECT_TRUE(state.OnEvent(tray_added).first);
  }
  {
    TrayExistenceChangedMsg tray_added {};
    tray_added.added = true;
    tray_added.tray_id = 2;
    tray_added.node_id = 2;
    tray_added.heading = 0;
    EXPECT_TRUE(state.OnEvent(tray_added).first);
  }
  {
    TrayExistenceChangedMsg tray_added {};
    tray_added.added = true;
    tray_added.tray_id = 3;
    tray_added.node_id = 3;
    tray_added.heading = 0;
    EXPECT_TRUE(state.OnEvent(tray_added).first);
  }
  {
    TrayExistenceChangedMsg tray_added {};
    tray_added.added = true;
    tray_added.tray_id = 4;
    tray_added.node_id = 4;
    tray_added.heading = 0;
    EXPECT_TRUE(state.OnEvent(tray_added).first);
  }

  // All 4 trays are empty, nothing is disabled
  EXPECT_EQ(4, CountEmptyTrays(state));

  // Add 2 payloads
  {
    PayloadExistenceChangedMsg payload_added {};
    payload_added.payload_id = volley::MakeGuid(0, 1).bytes;
    payload_added.added = true;
    payload_added.tray_id = 1;
    EXPECT_TRUE(state.OnEvent(payload_added).first);
  }
  {
    PayloadExistenceChangedMsg payload_added {};
    payload_added.payload_id = volley::MakeGuid(0, 2).bytes;
    payload_added.added = true;
    payload_added.tray_id = 2;
    EXPECT_TRUE(state.OnEvent(payload_added).first);
  }

  // Now only 2 are empty
  EXPECT_EQ(2, CountEmptyTrays(state));

  // Disable a tray and a node
  {
    TrayDisablednessChangedMsg tray_disabled {};
    tray_disabled.tray_id = 1;
    tray_disabled.disable = true;
    EXPECT_TRUE(state.OnEvent(tray_disabled).first);
  }
  {
    NodeDisablednessChangedMsg node_disabled {};
    node_disabled.node_id = 15;
    node_disabled.disable = true;
    EXPECT_TRUE(state.OnEvent(node_disabled).first);
  }

  // Still 2 available trays
  EXPECT_EQ(2, CountEmptyTrays(state));

  // Disable an empty tray
  {
    TrayDisablednessChangedMsg tray_disabled {};
    tray_disabled.tray_id = 3;
    tray_disabled.disable = true;
    EXPECT_TRUE(state.OnEvent(tray_disabled).first);
  }

  // Now just 1 available tray
  EXPECT_EQ(1, CountEmptyTrays(state));

  // Disable the node of the remaining empty tray
  {
    NodeDisablednessChangedMsg node_disabled {};
    node_disabled.node_id = 4;
    node_disabled.disable = true;
    EXPECT_TRUE(state.OnEvent(node_disabled).first);
  }

  // 2 trays have payloads, 1 of the empty ones is disabled and the other empty one is on a
  // disabled node
  EXPECT_EQ(0, CountEmptyTrays(state));
}

