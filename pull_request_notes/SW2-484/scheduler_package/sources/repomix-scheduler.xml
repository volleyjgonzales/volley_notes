namespace volley {

using AgvAssignmentEdgeKey = std::pair<uint16_t, std::shared_ptr<volley::ScheduleEvent>>;

}  // namespace volley

template <>
struct std::hash<volley::AgvAssignmentEdgeKey> {
  std::size_t operator()(const volley::AgvAssignmentEdgeKey& k) const {
    std::size_t result = 0;
    boost::hash_combine(result, boost::hash_value(k.first));
    boost::hash_combine(result, boost::hash_value(k.second));
    return result;
  };
};

namespace volley {

// A single structure to pass in when constructing a Scheduler object, rather than
// passing in all of these values individually.
struct SchedulerParams {
  float bay_readiness_ratio = 0.0f;
  // When true, the scheduler builds a per-segment cost audit during PlanMotions and emits it as
  // CSV-formatted INFO log lines (one row per segment + a header). Independent of `verbose` so
  // operators can capture cost data without enabling all the other debug logging.
  bool cost_audit = true;
  cost::MotionCostParams motion_cost = {};
};

class ScheduleContext {
public:
  ScheduleContext(const GuidMsg& reqid, volley::DiscreteGarageState initial_state, const rclcpp::Time& now) :
      request_id(reqid),
      request_id_str(std::to_string(reqid)),
      initial_state(std::move(initial_state)),
      start_time(std::chrono::nanoseconds(now.nanoseconds())) { }

  void PushBackScheduledJob(const SchedulerJobMsg& job) {
    ScheduledJobDataMsg scheduled_job;
    scheduled_job.job = job;
    scheduled_jobs.push_back(scheduled_job);
  }

  // Handling last_entity_event
  void UpdateLastEntityEvent(const GarageEntityIdMsg& entity_id, ScheduleEventSPtr new_event) {
    // Add a dependency on the entity's last event, if it had one
    if(last_entity_event.find(entity_id) != last_entity_event.end()) {
      events.AddDependency(last_entity_event.at(entity_id), new_event);
    }
    // Update the last event for this entity
    last_entity_event[entity_id] = new_event;
  }

  // Adding a new child event to the leafs in the DAG.
  // Each leaf becomes a parent to the new child event.
  void UpdateLeafDependencies(const ScheduleEventSPtr& childevent, size_t job_index) {
    auto leaf_events = events.GetLeafEvents();
    for(const auto& leaf_event : leaf_events) {
      if(leaf_event == childevent) {
        continue;
      }
      if(leaf_event->GetJobIndex() == job_index) {
        events.AddDependency(leaf_event, childevent);
      }
    }
  }

public:
  GuidMsg request_id;
  std::string request_id_str;

  volley::DiscreteGarageState initial_state;
  volley::Interval::Timepoint start_time;

  using CollistionFilterMap = std::unordered_map<volley::CollisionEntityId_t, volley::GraphFilterProperties>;
  CollistionFilterMap disabledness_filters;

  volley::ScheduleEventDag events;
  std::vector<ScheduledJobDataMsg> scheduled_jobs;

  using GarageEntityEventMap = std::unordered_map<GarageEntityIdMsg, ScheduleEventSPtr>;
  GarageEntityEventMap last_entity_event;

  // For each tray, the first scheduled move that clears it from its initial-state position.
  // Used by DoAgvAssignments to add path-blocking dependencies: an AGV's navigation move
  // must wait for the blocker tray's first move to complete before traversing the blocker's
  // initial node. Cannot use the last move — that would create a cycle when a tray is moved
  // multiple times by the same AGV in one plan.
  std::unordered_map<uint16_t, ScheduleEventSPtr> first_tray_event;
};

using ScheduleContextSPtr = std::shared_ptr<ScheduleContext>;

class Scheduler {
public:
  explicit Scheduler(std::string layout_filepath, rclcpp::Logger logger, const SchedulerParams& params);

  /// @brief Attempts to cache the optimal retrieval heading for each parking spot in the layout. Parking
  /// spots that are skipped are not cached, leaving parking heading up to the planner at runtime.
  /// @note Currently, this method just caches the retrieval heading of the bay with the highest retrieve
  /// priority for each parking spot only if the spot allows that heading.
  void InitRetrievalHeadings();

  PlanResponseMsg Plan(const PlanRequestMsg& request_data, const rclcpp::Time& now) const;
  BoolStringPair PlanAgvMoveJob(ScheduleContextSPtr ctx, std::optional<uint16_t> agv_id, GaragePoseMsg dest,
      bool allow_recip, size_t job_index) const;

  // success, message, retain_job
  std::tuple<bool, std::string, bool> PlanRetrieveJob(
      ScheduleContextSPtr ctx, const GuidMsg& payload_id, size_t job_index) const;

  BoolStringPair PlanReparkTrayJob(ScheduleContextSPtr ctx, std::optional<uint16_t> tray_id, size_t job_index,
      bool allow_recip, std::optional<GaragePoseMsg> dest = std::nullopt) const;

  BoolStringPair PlanOpenBayDoor(
      ScheduleContextSPtr ctx, const DiscreteBayStateMsg& bay, size_t job_index) const;

  BoolStringPair PlanInsertJob(ScheduleContextSPtr ctx, uint16_t bay_id, size_t job_index) const;

  BoolStringPair PlanReadyForInsertJob(ScheduleContextSPtr ctx, uint16_t bay_id, size_t job_index) const;
  BoolStringPair PlanReadyForRetrieveJob(ScheduleContextSPtr ctx, uint16_t bay_id, size_t job_index) const;

  BoolStringPair PlanCleanGarageJob(ScheduleContextSPtr ctx, size_t job_index) const;
  BoolStringPair PlanRebalanceGarageJob(ScheduleContextSPtr ctx, size_t job_index) const;
  // For each tray currently sitting on a TYPE_WAYPOINT node (left there by the tier-2 stash
  // fallback in ResolveBlockingTrays), plan a repark to a TYPE_PARKING node. Failures per
  // tray are logged and skipped (best-effort, matching PlanRebalanceGarageJob).
  BoolStringPair PlanUnstashWaypointTraysJob(ScheduleContextSPtr ctx, size_t job_index) const;

  BoolStringPair PlanAgvChargeJob(ScheduleContextSPtr ctx, uint16_t agv_id, size_t job_index) const;

  BoolStringPair PlanBayTransitionJob(
      ScheduleContextSPtr ctx, uint16_t bay_id, uint8_t command_type, size_t job_index) const;

  BoolStringPair PlanChargePayloadJob(
      ScheduleContextSPtr ctx, const GuidMsg& payload_id, size_t job_index) const;

  std::vector<uint16_t> AgvMatchingEventDeps(
      const std::unordered_map<uint16_t, std::optional<ScheduleEventSPtr>>& event_map,
      const volley::DiscreteGarageState& working_state, const uint16_t agv_id) const;

  volley::DagBase<uint16_t> GetEventDag(
      const std::unordered_map<uint16_t, std::optional<ScheduleEventSPtr>>& event_map,
      const volley::DiscreteGarageState& working_state) const;

  std::vector<std::pair<uint16_t, std::optional<ScheduleEventSPtr>>> DagToVec(
      const volley::DagBase<uint16_t>& dag,
      const std::unordered_map<uint16_t, std::optional<ScheduleEventSPtr>>& event_map) const;

  std::optional<volley::ContinuousState> PlanMotions(ScheduleContextSPtr ctx) const;

  std::pair<std::optional<std::vector<ActionNodeMsg>>, std::string> ResponseFromTrajectories(
      ScheduleContextSPtr ctx, const volley::ContinuousState& final_state) const;

  VersionInfoMsg::UniquePtr GetVersionInfo(const rclcpp::Time& now) const {
    auto version_info = std::make_unique<VersionInfoMsg>();
    version_info->header.stamp = now;
    version_info->name = "scheduler";
    version_info->release = volley::GetRelease();
    version_info->gitsha = volley::GetGitsha();
    version_info->layout_md5sum = layout_->GetMD5Sum();
    return version_info;
  }

  std::unique_ptr<SchedulerReportMsg> GetSchedulerReport(const rclcpp::Time& now) const {
    auto report = std::make_unique<SchedulerReportMsg>();
    report->header.stamp = now;
    report->bay_readiness_ratio = bay_readiness_ratio_;
    return report;
  }

  BoolStringPair DoTrayAssignments(ScheduleContextSPtr ctx) const;

  // === Cost calculators for AMIGA (Arguably More Intelligent aGv Assignment) ===
  // Function to estimate the time it takes to go from one location to
  // another, without taking into account blocking moves. Returns nullopt if
  // infeasible, which only happens if the trajectory between the two poses is
  // empty.
  std::optional<volley::Interval::Duration> GetJustMovingCost(const GaragePoseMsg& start_pose,
      const GaragePoseMsg& end_pose, const GarageEntityIdMsg& agv_id, bool is_agv_loaded = false,
      std::optional<volley::GraphFilterProperties> filters = std::nullopt) const;
  // Gets the cost (time duration) for an AGV to get from its current pose to
  // a tray start pose given by an TrayMove. Naively does not take
  // into account any prior lower necessary (i.e. if the AGV is currently
  // carrying another tray), but it does include a lift cost after reaching
  // the tray pose. Calls GetJustMovingCost() under the hood. Returns nullopt
  // if infeasible, which happens if the trajectory between the AGV's current
  // pose and the tray's pose is empty.
  std::optional<volley::Interval::Duration> GetAgvCurrentPoseToTrayMoveCost(uint16_t agv_id,
      const volley::TrayMove& move, const volley::DiscreteGarageState& working_state,
      std::optional<volley::GraphFilterProperties> filters = std::nullopt) const;
  // Returns 0s if the AGV has nothing assigned to it, else returns the amount
  // of time time the AGV needs to complete its currently assigned tasks.
  // TODO(isabel) Currently only returns 0s. Implement for real
  volley::Interval::Duration GetAgvOccupiedDuration(uint16_t agv_id, ScheduleContextSPtr ctx) const;
  // Estimates the cost (duration) of assigning an AGV to a tray move. This
  // is computed as cost = (time until agv is free) + (time to get to tray)
  // and calls GetAgvCurrentPoseToTrayMoveCost under the hood. Returns
  // nullopt if infeasible, which occurs if the inputs are invalid, if the
  // AGV is currently holding a different tray, or if
  // GetAgvCurrentPoseToTrayMoveCost returns nullopt.
  std::optional<volley::Interval::Duration> GetAgvToTrayAssignmentCost(uint16_t agv_id,
      const volley::TrayMove& move, const volley::DiscreteGarageState& working_state,
      const volley::Interval::Duration& agv_occupied_duration,
      std::optional<volley::GraphFilterProperties> filters = std::nullopt) const;

  BoolStringPair DoAgvAssignments(ScheduleContextSPtr ctx) const;

  /// Post-assignment repair pass. Replays the emitted event DAG in topological order (the order
  /// SanityCheckEvents will use) and, when an AGV reposition move has no collision-free path
  /// because another AGV is parked on a node it must cross, adds a dependency forcing the move to
  /// wait until that blocker departs the node. DoAgvAssignments builds dependencies against its
  /// own serial assignment order, which diverges from the final topological order; this pass is
  /// the only place the actual execution-time AGV occupancy is known. Iterates until a full replay
  /// needs no further edges (or a safety cap is hit, leaving SanityCheckEvents as the backstop).
  stdx::Result EnsureAgvMovePathsClear(ScheduleContextSPtr ctx) const;

  /// One topological replay for EnsureAgvMovePathsClear: simulates AGV occupancy along the order
  /// and, at the first blocked AGV move it can repair, adds a single gating edge. Returns true iff
  /// an edge was added (so the caller must re-derive the order and replay, since the occupancy of
  /// every later event is now stale), or an error if the event DAG cannot be topologically sorted.
  stdx::Expected<bool> RunAgvPathRepairPass(ScheduleContextSPtr ctx) const;

  /// If `event` is an AGV reposition move that has no collision-free path because another AGV
  /// occupies a node it must cross, adds a dependency gating it on that blocker's departure and
  /// returns true. `working_state` is the simulated occupancy when `event` would execute (topo
  /// position `idx`). Non-AGV-move events, already-feasible moves, and tray/disabled obstructions
  /// (which reordering cannot fix) return false.
  bool TryClearBlockedAgvMove(ScheduleContextSPtr ctx, const volley::ScheduleEventDag::VertexVec& topo,
      size_t idx, const ScheduleEventSPtr& event, const volley::DiscreteGarageState& working_state) const;

  /// Returns AGV `agv_id`'s first event after topo position `after_idx` that departs `node`: its
  /// next pose-changing AgvMove out of `node`, or a tray-carry it is assigned to. Null if none.
  ScheduleEventSPtr FindAgvDepartureFromNode(ScheduleContextSPtr ctx,
      const volley::ScheduleEventDag::VertexVec& topo, size_t after_idx, uint16_t agv_id,
      uint32_t node) const;

  // Go over topological ordering of events. Asserts that each event can be applied to the DGS,
  // and that feasible motion plans exist for each move/transition
  BoolStringPair SanityCheckEvents(ScheduleContextSPtr ctx) const;

  // Add dependencies on AGV lift/lowers correctly after assigning AGVs to tray moves
  void AddDepsAfterAmiga(
      ScheduleContextSPtr ctx, std::shared_ptr<volley::ScheduleEvent> event, uint16_t node_id) const;

  // Service callbacks
  bool SetBayReadinessRatioCallback(
      SetFloat32Srv::Request::SharedPtr request, SetFloat32Srv::Response::SharedPtr response);

  LayoutSPtr GetLayout() const { return layout_; }
  const volley::GarageGraph& GetGarageGraph() const { return gg_; }
  const volley::CollisionTable& GetCollisionTable() const { return table_; }

  void PrintDags() { printdags_ = !printdags_; }

  // Returns a new destination pose for the blocking tray `tray_id` and a list of
  // moves required to allow the tray to be moved to the new destination.
  // The task id is the id of the task that is currently blocked by the tray.
  // The base_state is the state of the garage before the tray is moved -- note it is const and
  // not updated, if a dest is returned, the caller is responsible for updating the state with
  // all the moves in the returned list.
  // immobile_trays is a set of trays that are not allowed to be moved. Usually at least the root
  // tray, but possibly others if we run this as an iterative process eventually.
  // illegal_poses is a set of poses that the tray is not allowed to be moved to. This is used to
  // encode the critical path of the task that is blocked by the tray, and in the future maybe the
  // critical path of future moves.
  // Recurses into itself when a blocker's own resolution is blocked, marking the parent tray
  // immobile to prevent cycles. The recursion's prerequisite moves are flattened into the
  // returned move list in apply order.
  std::pair<std::optional<GaragePoseMsg>,
      std::vector<std::pair<std::shared_ptr<volley::TrayMove>, std::vector<GaragePoseMsg>>>>
  ResolveBlockingTrays(uint16_t tray_id, size_t job_index, const volley::DiscreteGarageState& base_state,
      const std::set<uint16_t>& immobile_trays = {}, const VertexCollisionIdMap& illegal_poses = {},
      bool enforce_retrieval_heading = false, bool allow_waypoint_stash = true) const;

private:
  std::function<void(void)> clean_garage_request_fn_;
  std::function<void(void)> rebalance_garage_request_fn_;
  std::function<void(uint16_t, uint16_t)> reset_bay_state_request_fn_;
  friend class SchedulerRos;

  // Prefer to use the optimal retrieval heading of the parking node. So
  // payloads can be retrieved faster.  Except if the attendant manually
  // moved the tray.
  void UsePreferredHeading(GaragePoseMsg& dest, const std::optional<DiscretePayloadStateMsg>& payload_opt,
      const std::optional<DiscreteTrayStateMsg>& tray) const;
  bool UseEvChargeHeading(GaragePoseMsg& dest) const;
  void UseRetrievalHeading(
      GaragePoseMsg& dest, const std::optional<DiscretePayloadStateMsg>& payload_opt) const;

  // === DoTrayAssignments helpers ===
  // Applies a non-tray-move event (BAY_TRANSITION / VECS_TRANSITION) to working_state and
  // registers its pose with the freeing_moves occupancy checker so subsequent tray moves into or
  // out of the bay/VECS depend on this transition. Returns success/error.
  BoolStringPair ApplyTransitionToFreeingMoves(const std::shared_ptr<volley::ScheduleEvent>& event,
      volley::DiscreteGarageState& working_state,
      volley::GarageOccupancyChecker<std::shared_ptr<volley::ScheduleEvent>>& freeing_moves) const;

  // Resolves an empty-tray request: when a TrayMove has a destination but no tray_id, find the
  // closest empty tray (by BFS) and set it as the move's tray. May also adjust the destination
  // heading to match the chosen tray when same-or-reciprocal, to avoid unnecessary rotations.
  BoolStringPair AssignTrayIdForEmptyMove(
      volley::TrayMove& move, const volley::DiscreteGarageState& working_state) const;

  // Resolves an untargeted tray move: when a TrayMove specifies a tray_id but no destination,
  // find an open parking destination via ResolveBlockingTrays, apply any required unblocking
  // moves, and update the event/dependency graph accordingly.
  BoolStringPair AssignDestForUntargetedMove(volley::TrayMove* move, ScheduleContextSPtr ctx,
      const std::shared_ptr<volley::ScheduleEvent>& event, volley::DiscreteGarageState& working_state,
      volley::GarageOccupancyChecker<std::shared_ptr<volley::ScheduleEvent>>& freeing_moves,
      std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>>& last_tray_event) const;

  // === DoAgvAssignments helpers ===
  // Creates and applies a lift (raised=true) or lower (raised=false) AgvMove event for the
  // given AGV. Adds dependencies on the AGV's prior event, applies to working_state, and
  // accumulates the lift duration into event_cost.
  BoolStringPair AppendAgvLiftEvent(uint16_t agv_id, bool raised, size_t job_index, ScheduleContextSPtr ctx,
      volley::DiscreteGarageState& working_state,
      std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>>& last_agv_event,
      volley::Interval::Duration& event_cost) const;

  // Propagates the cumulative cost of root_event to its children in the event DAG, used for
  // tracking the earliest time downstream events can begin executing.
  void PropagateEventCostToChildren(const std::shared_ptr<volley::ScheduleEvent>& root_event,
      volley::Interval::Duration event_cost, ScheduleContextSPtr ctx,
      std::unordered_map<std::shared_ptr<volley::ScheduleEvent>, volley::Interval::Duration>&
          event_occupied_durations) const;

  // When `arriving_agv_id` arrives at `dest_node_id` and a *different* AGV last occupied that
  // node, adds a dependency on the prior occupant's last event so the topological order in the
  // emitted DAG respects "previous occupant must leave before next AGV arrives" -- without this,
  // chugg's topo sort can interleave per-AGV chains and try to apply an arrival before the
  // prior occupant has departed ("two AGVs at the same node" failure in InitializeEventOrder).
  //
  // Returns infeasible when the prior occupant has no scheduled events at all (an idle AGV
  // squatting at the destination): with no event to depend on, the dispatcher would later
  // reject the plan with the same-node error. Returning the failure here lets the caller
  // pick a different assignment (or fail the job) before the bad plan is emitted, rather
  // than silently emitting an infeasible schedule.
  BoolStringPair AddNodeArrivalDeps(uint32_t dest_node_id, uint16_t arriving_agv_id,
      const std::shared_ptr<volley::ScheduleEvent>& new_event, ScheduleContextSPtr ctx,
      std::unordered_map<uint32_t, uint16_t>& current_node_occupant,
      const std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>>& last_agv_event) const;

  // Builds and applies an AgvMove event that relocates the assigned AGV to the tray's pose,
  // wiring up dependencies on prior-occupant events from agv_event_dag and on the destination
  // node's prior occupant. Accumulates the move duration into event_cost.
  BoolStringPair MoveAgvToTrayPose(uint16_t agv_id, const DiscreteAgvStateMsg& agv,
      const DiscreteTrayStateMsg& tray, const std::shared_ptr<volley::ScheduleEvent>& root_event,
      const volley::DagBase<uint16_t>& agv_event_dag, ScheduleContextSPtr ctx,
      volley::DiscreteGarageState& working_state,
      std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>>& last_agv_event,
      std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>>& last_move_to_tray_event,
      std::unordered_map<uint32_t, uint16_t>& current_node_occupant,
      volley::Interval::Duration& event_cost) const;

  // === ResolveBlockingTrays helpers ===
  // Result of the open-space search for the root tray: the target BlockingTrayState plus
  // illegal-pose extensions for blocking-tray reparking (intermediate path verts of the root
  // tray's critical path, excluding the target itself).
  struct OpenSpaceSearchResult {
    volley::BlockingTrayState target;
    VertexCollisionIdMap blocking_tray_illegal_poses;
  };

  // Resolution for one blocking tray. `prereq_moves` is non-empty only when the blocking tray
  // itself had blocking trays that had to be resolved recursively; the caller must apply each
  // prereq move (in order) before the blocking tray's own move. When `prereq_moves` is empty,
  // `path` contains the planned poses for the blocking tray's move; when populated by recursion,
  // intermediate path poses are not recoverable and `path` is left empty (sequencing
  // correctness is preserved via the ordering of moves the caller emits).
  struct BlockingTrayResolution {
    uint16_t tray_id;
    GaragePoseMsg dest;
    std::vector<GaragePoseMsg> path;
    std::vector<std::pair<std::shared_ptr<volley::TrayMove>, std::vector<GaragePoseMsg>>> prereq_moves;
  };

  // Runs an OpenSpaceSearch from `tray_id`'s current pose. Returns the best target along with
  // illegal-pose extensions, or nullopt if the search has no target. When
  // `allow_waypoint_stash` is true, TYPE_WAYPOINT nodes are also accepted as valid targets
  // (used as a Tier-2 fallback when no parking destination is reachable).
  std::optional<OpenSpaceSearchResult> FindOpenSpaceForRootTray(uint16_t tray_id,
      volley::CollisionEntityId_t collision_entity, const volley::DiscreteGarageState& working_state,
      const std::set<uint16_t>& immobile_trays, const std::unordered_set<uint16_t>& agvs,
      const VertexCollisionIdMap& illegal_poses, bool enforce_retrieval_heading,
      bool allow_waypoint_stash = false) const;

  // Finds an open space for one blocking tray. If the search returns a target with zero further
  // blocking trays, returns it directly with an empty prereq_moves list. If the target itself has
  // blocking trays, recursively calls ResolveBlockingTrays (with root_tray_id marked immobile) to
  // resolve them; the recursion's required moves become prereq_moves on the returned resolution.
  // Returns nullopt if no resolvable target can be found for this blocking tray.
  std::optional<BlockingTrayResolution> TryFindBlockingTrayResolution(uint16_t blocking_tray_id,
      uint16_t root_tray_id, size_t job_index, const volley::DiscreteGarageState& working_state,
      const std::set<uint16_t>& immobile_trays, const std::unordered_set<uint16_t>& agvs,
      const VertexCollisionIdMap& blocking_tray_illegal_poses, bool enforce_retrieval_heading) const;

  // Makes sure that destination is not disabled and there is a feasible path to get there
  BoolStringPair IsMovePossible(ScheduleContextSPtr ctx, const volley::DiscreteGarageState& working_state,
      const volley::CollisionEntityId_t& collision_id, const std::unordered_set<uint16_t>& ignore_agvs,
      const std::unordered_set<uint16_t>& ignore_trays, const GaragePoseMsg& start_pose,
      const GaragePoseMsg& dest) const;

  // Sets job state to error and adds error message
  ScheduledJobDataMsg FailJob(
      const SchedulerJobMsg& job, const std::string& failure_message, bool retain_job = false) const;

  LayoutSPtr layout_;
  volley::PoseGraph pg_;
  volley::GarageGraph gg_;
  volley::CollisionTable table_;
  rclcpp::Logger logger_;
  cost::MotionCostModel cost_model_;
  // The fraction of bays we prefer to be in ready-to-insert. Atomic because it is accessed (read/writes) by
  // multiple callback groups in the parent class (on multiple threads).
  std::atomic<float> bay_readiness_ratio_;

public:
  mutable bool costaudit_;  // Emit CSV cost-audit rows for each PlanMotions call

  // Log the schedule DAGs. Not high performance, so off by default.
  // Requires: sudo apt-get install libgraph-easy-perl
  mutable bool printdags_ = false;
};

using SchedulerSPtr = std::shared_ptr<Scheduler>;

}  // namespace volley
</file>

