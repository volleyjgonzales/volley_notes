  state: 4
  pose:
    node_id: 3
    heading: 0
bays:
-
  id: 1
  state: 3
  disabled: false
trays: []
payloads: []
disabled_nodes: []
hash: 0)YML"));

  const auto layout_filepath_or = GetLayoutPathByName(kTinyLotLayoutName);
  ASSERT_TRUE(layout_filepath_or.has_value()) << layout_filepath_or.error();
  const auto& layout_filepath = layout_filepath_or.value();

  auto logger = rclcpp::get_logger("scheduler");
  SchedulerParams params {};
  params.bay_readiness_ratio = 0.5;
  Scheduler scheduler(layout_filepath, logger, params);

  rclcpp::Time now = rclcpp::Time(0);

  SchedulerJobMsg rfr_job;
  rfr_job.type = SchedulerJobMsg::TYPE_READY_FOR_RETRIEVE;
  rfr_job.state = SchedulerJobMsg::STATE_UNPLANNED;
  rfr_job.guid = volley::MakeGuid(0u, 32u);
  rfr_job.time_registered = now;
  rfr_job.bay_id = 1;

  PlanRequestMsg request_data;

  request_data.id = volley::MakeGuid(0u, 16u);
  request_data.base_state = state.GetDiscreteGarageStateMessage();
  request_data.pending_jobs.emplace_back(std::move(rfr_job));

  {
    auto response = scheduler.Plan(request_data, now);

    EXPECT_EQ(response.success, true) << response.message;
    EXPECT_EQ(response.id, request_data.id);

    // Here we just have a bay that needs to be transitioned
    auto schedule = response.schedule.nodes;
    ASSERT_EQ(1u, schedule.size());
    EXPECT_EQ(ActionNodeMsg::TYPE_BAY_COMMAND, schedule[0].type);
    EXPECT_EQ(BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE, schedule[0].bay_command.command_type);
    EXPECT_EQ(1u, schedule[0].bay_id);
  }
  {
    // Put a tray and the AGV in the bay and do it again
    DiscreteTrayStateMsg tray {};
    tray.id = 1;
    tray.pose = volley::ConstructGaragePose(1, 90);
    request_data.base_state.trays.push_back(tray);
    request_data.base_state.agvs[0].pose = volley::ConstructGaragePose(1, 90);
  }
  {
    auto response = scheduler.Plan(request_data, now);

    EXPECT_EQ(response.success, true) << response.message;
    EXPECT_EQ(response.id, request_data.id);

    // Here we have to transition the bay, then move the tray out of the bay
    auto schedule = response.schedule.nodes;
    // Some root node should be transitioning the bay
    bool has_agv_as_child = false;
    bool has_bay_node = false;
    unsigned int bay_node_index = 0;
    for(unsigned int node_index = 0; node_index < schedule.size(); ++node_index) {
      auto& node = schedule[node_index];
      // Bay command should be a root
      if(node.type == ActionNodeMsg::TYPE_BAY_COMMAND) {
        EXPECT_EQ(BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE, node.bay_command.command_type);
        EXPECT_EQ(1, node.bay_id);
        EXPECT_EQ(0, node.parents.size());
        has_bay_node = true;
        bay_node_index = node_index;
        continue;
      }
      // Some AGV command should have the bay command as its parent
      EXPECT_EQ(ActionNodeMsg::TYPE_AGV_COMMAND, node.type);
      if(has_bay_node && !has_agv_as_child) {
        for(auto& parent : node.parents) {
          if(parent == bay_node_index) {
            has_agv_as_child = true;
            break;
          }
        }
      }
    }
    EXPECT_TRUE(has_agv_as_child);
    EXPECT_TRUE(has_bay_node);
  }
};

