  // There should be one lift and one lower.
  auto schedule = response.schedule.nodes;
  bool has_lift = false;
  bool has_lower = false;
  bool has_lower_with_payload_heading_180 = false;

  for(const auto& node : schedule) {
    bool is_agv_command = node.type == ActionNodeMsg::TYPE_AGV_COMMAND;
    bool is_bay_command = node.type == ActionNodeMsg::TYPE_BAY_COMMAND;
    EXPECT_TRUE(is_agv_command || is_bay_command);
    if(is_agv_command) {
      // This should be Fulton garage AGV 10 (moving the Tray from Bay 2).
      EXPECT_EQ(node.agv_id, 10);

      // printf("  - - - - -   AGV %d  src %s dst %s\n",
      //   node.agv_id,
      //   std::to_string(node.agv_command.dst.pose).c_str(),
      //   std::to_string(node.agv_command.dst.pose).c_str());

      // Is the AGV lowering the tray or lifting the tray?
      bool is_lower = IsLower(node.agv_command);
      bool is_lift = IsLift(node.agv_command);
      has_lower = has_lower || is_lower;
      has_lift = has_lift || is_lift;

      if(is_lift && !has_lower) {
        // printf("  - - - - -  FultonInsertBay1TrayOrientation0: AGV %d is_lift the
        // tray\n",
        //  node.agv_id);
        //  The AGV is now 2@0.  Lifting Tray 24 which is 2@180.
        EXPECT_EQ(node.agv_command.dst.pose.node_id, 2);
        EXPECT_EQ(node.agv_command.dst.pose.heading, 0);
      }

      if(has_lift && is_lower) {
        // printf(
        //     "  - - - - -  FultonInsertBay1TrayOrientation0: AGV %d has_lift and is_lower
        //     the tray\n",
        // node.agv_id);
        // The AGV is now lowering Tray 24.
        // The payload must be oriented for optimum retrieval. Which means Tray 24 has
        // heading 180 Which means the AGV now has heading 0.
        EXPECT_EQ(node.agv_command.dst.pose.heading, 0);
        has_lower_with_payload_heading_180 = true;
      }
    }
  }

  // A tray was lifted.  A tray was lowered.  The tray was lowered with the heading 180.
  EXPECT_TRUE(has_lift);
  EXPECT_TRUE(has_lower);
  EXPECT_TRUE(has_lower_with_payload_heading_180);
};

