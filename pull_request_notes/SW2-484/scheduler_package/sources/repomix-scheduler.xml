// Pins down the recursive blocking-tray resolution behavior. The scenario:
// triple_pick_lot is filled such that the only open parking node is P(14) at the
// deep end of the bottom row, and the path between the root tray and P(14) is
// chain-blocked. The cheapest path for the front blocker (T@P8) is itself blocked
// by the middle blocker (T@P11) — meaning the inner blocking-tray search for T@P8
// returns a target with non-empty blocking_trays.
//
// Before recursion was added: the search-with-blockers cap (max_blocking_trays=0)
// rejected such targets, and the inner search returned nullopt; ResolveBlockingTrays
// would fail to find any resolvable blocker and bail. After recursion:
// TryFindBlockingTrayResolution accepts the blocker-laden target, marks the parent
// immobile, and recurses into ResolveBlockingTrays for the blocker. The returned
// resolution carries the recursion's prereq_moves; the outer loop applies them in
// order before the blocker's own move.
//
// We assert: ResolveBlockingTrays returns a valid destination, and the required
// moves list contains at least two TrayMoves (the chain depth — one prereq plus
// the front blocker's own move at minimum).
TEST(Scheduler, ResolveBlockingTraysRecursivelyUnblocksChain) {
  volley::DiscreteGarageState state;
  // Trays fill triple_pick_lot except P(14). Root tray sits on P(6); to reach
  // the only open spot (P(14)) the search must move T@P8 out (front of bottom
  // row), whose own only escape passes through T@P11. Layout edges:
  //   P(6) - P(8); P(8) - P(11); P(11) - P(14). All other parking spots are filled.
  auto [success, msg] = state.Set(YAML::Load(R"YML(
is_faulted: false
agvs: []
trays:
- {id: 6,  pose: {node_id: 6,  heading: 0}}
- {id: 7,  pose: {node_id: 7,  heading: 0}}
- {id: 8,  pose: {node_id: 8,  heading: 0}}
- {id: 9,  pose: {node_id: 9,  heading: 0}}
- {id: 10, pose: {node_id: 10, heading: 0}}
- {id: 11, pose: {node_id: 11, heading: 0}}
- {id: 12, pose: {node_id: 12, heading: 0}}
- {id: 13, pose: {node_id: 13, heading: 0}}
bays: []
payloads: []
disabled_nodes: []
hash: 0)YML"));
  ASSERT_TRUE(success) << msg;

  const auto layout_filepath_or = GetLayoutPathByName(kTriplePickLotLayoutName);
  ASSERT_TRUE(layout_filepath_or.has_value()) << layout_filepath_or.error();
  const auto& layout_filepath = layout_filepath_or.value();

  auto logger = rclcpp::get_logger("scheduler");
  Scheduler scheduler(layout_filepath, logger, SchedulerParams {});

  // Root tray = the one on P(6). Job index is arbitrary for this unit test.
  constexpr uint16_t kRootTrayId = 6;
  constexpr size_t kJobIndex = 0u;
  auto [dest, required_moves] = scheduler.ResolveBlockingTrays(kRootTrayId, kJobIndex, state);

  ASSERT_TRUE(dest.has_value()) << "Recursive resolution should produce a destination for the root tray";

  // Recursion produces at least one prereq move + the front blocker's own move = 2 moves.
  // Without recursion, the inner search would have rejected the chain and ResolveBlockingTrays
  // would have returned an empty move list (or no dest at all).
  EXPECT_GE(required_moves.size(), 2u)
      << "Recursive resolution should produce at least two tray moves (one prereq + the front blocker)";

  // Sanity: all required moves are TrayMoves with valid destinations, and no two moves target
  // the same node (a chain produces distinct landing nodes).
  std::set<uint32_t> distinct_dest_nodes;
  for(const auto& [move, _path] : required_moves) {
    ASSERT_NE(move, nullptr);
    auto move_dest = move->GetDest();
    ASSERT_TRUE(move_dest.has_value()) << "Every move in a recursive chain must have a set destination";
    distinct_dest_nodes.insert(move_dest.value().node_id);
  }
  EXPECT_EQ(distinct_dest_nodes.size(), required_moves.size())
      << "Each move in a recursive chain should target a distinct node";
};

