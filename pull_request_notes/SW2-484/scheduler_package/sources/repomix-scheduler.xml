namespace volley {

static void ReadParams(cost::MotionCostParams& mc, NodeSPtr node) {
  mc.locomote.speed = node->Param<float>("agv.performance_limits.locomote.speed");
  mc.locomote.loaded_speed = node->Param<float>("agv.performance_limits.locomote.loaded_speed");
  mc.locomote.accel = node->Param<float>("agv.performance_limits.locomote.accel");
  mc.strafe.speed = node->Param<float>("agv.performance_limits.strafe.speed");
  mc.strafe.loaded_speed = node->Param<float>("agv.performance_limits.strafe.loaded_speed");
  mc.strafe.accel = node->Param<float>("agv.performance_limits.strafe.accel");
  mc.rotate.speed = node->Param<float>("agv.performance_limits.rotate.speed");
  mc.rotate.loaded_speed = node->Param<float>("agv.performance_limits.rotate.loaded_speed");
  mc.rotate.accel = node->Param<float>("agv.performance_limits.rotate.accel");
  mc.vrc_transit.speed = node->Param<float>("vrc.performance_limits.transit.speed");
  mc.vrc_transit.accel = node->Param<float>("vrc.performance_limits.transit.accel");
  mc.events.agv_lift_up = node->Param<float>("agv.lift.up_time");
  mc.events.agv_lift_down = node->Param<float>("agv.lift.down_time");
  mc.events.bay_door_open = node->Param<float>("bay.door.open_time");
  mc.events.bay_door_close = node->Param<float>("bay.door.close_time");
  mc.events.bay_wait_to_open = node->Param<float>("bay.door.wait_to_open_time");
  mc.events.vecs_transition = node->Param<float>("vecs.transition_time");
  mc.events.vrc_door_open = node->Param<float>("vrc.door.open_time");
  mc.events.vrc_door_close = node->Param<float>("vrc.door.close_time");
  mc.events.agv_wheel_turn = node->Param<float>("agv.wheel_turn_time");
}

class SchedulerComponent : public volley::Component {
public:
  explicit SchedulerComponent(const rclcpp::NodeOptions& options) {
    auto node = std::make_shared<volley::Node>("scheduler", options);
    const auto logger = node->get_logger();

    std::string layout_name;
    SchedulerParams params = {};
    try {
      layout_name = node->Param<std::string>("layout");
      params.cost_audit = node->Param<bool>("scheduler.cost_audit", true);
      params.bay_readiness_ratio = node->Param<float>("scheduler.bay_readiness_ratio");
      ReadParams(params.motion_cost, node);
    }
    catch(const std::exception& e) {
      ERRORF(logger, "Error in SchedulerNode constructor: %s", e.what());
      exit(EXIT_FAILURE);
    }

    const auto layout_filepath_or = GetLayoutPathByName(layout_name);
    if(!layout_filepath_or.has_value()) {
      ERRORS(logger, layout_filepath_or.error());
      exit(EXIT_FAILURE);
    }
    const auto& layout_filepath = layout_filepath_or.value();

    scheduler_node_ = std::make_unique<volley::SchedulerRos>(params, layout_filepath, node);

    SetNode(node);
  }

private:
  std::unique_ptr<volley::SchedulerRos> scheduler_node_;
};

}  // namespace volley

#include <rclcpp_components/register_node_macro.hpp>
RCLCPP_COMPONENTS_REGISTER_NODE(volley::SchedulerComponent)
