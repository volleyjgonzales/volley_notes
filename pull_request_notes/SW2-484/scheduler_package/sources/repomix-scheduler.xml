TEST(Scheduler, SetBayReadinessRatioService) {
  const auto layout_filepath_or = GetLayoutPathByName(kTinyLotLayoutName);
  ASSERT_TRUE(layout_filepath_or.has_value()) << layout_filepath_or.error();
  const auto& layout_filepath = layout_filepath_or.value();

  auto logger = rclcpp::get_logger("scheduler");
  SchedulerParams params {};
  params.bay_readiness_ratio = 0.5;

  // Construct the scheduler
  Scheduler scheduler(layout_filepath, logger, params);

  rclcpp::Time now = rclcpp::Time(0);
  EXPECT_EQ(scheduler.GetSchedulerReport(now)->bay_readiness_ratio, 0.5f);

  {
    // fails because ratio is below 0.0
    auto request = std::make_shared<SetFloat32Srv::Request>();
    request->value = -0.5f;
    auto response = std::make_shared<SetFloat32Srv::Response>();
    scheduler.SetBayReadinessRatioCallback(request, response);
    EXPECT_FALSE(response->success);
    EXPECT_EQ(scheduler.GetSchedulerReport(now)->bay_readiness_ratio, 0.5f);
  }

  {
    // fails because ratio is above 1.0
    auto request = std::make_shared<SetFloat32Srv::Request>();
    request->value = 1.5f;
    auto response = std::make_shared<SetFloat32Srv::Response>();
    scheduler.SetBayReadinessRatioCallback(request, response);
    EXPECT_FALSE(response->success);
    EXPECT_EQ(scheduler.GetSchedulerReport(now)->bay_readiness_ratio, 0.5f);
  }

  {
    // success
    auto request = std::make_shared<SetFloat32Srv::Request>();
    request->value = 0.8f;
    auto response = std::make_shared<SetFloat32Srv::Response>();
    scheduler.SetBayReadinessRatioCallback(request, response);
    EXPECT_TRUE(response->success);
    EXPECT_EQ(scheduler.GetSchedulerReport(now)->bay_readiness_ratio, 0.8f);
  }
}

TEST(Scheduler, UpdateLastEntityEvent) {
  const auto layout_filepath_or = GetLayoutPathByName(kTinyLotLayoutName);
  ASSERT_TRUE(layout_filepath_or.has_value()) << layout_filepath_or.error();
  const auto& layout_filepath = layout_filepath_or.value();

  auto logger = rclcpp::get_logger("scheduler");
  SchedulerParams params {};
  params.bay_readiness_ratio = 0.5;

  // Construct the scheduler
  Scheduler scheduler(layout_filepath, logger, params);
  GuidMsg request_id = volley::MakeGuid(0, 0xDEADBEEF);
  auto ctx = std::make_shared<ScheduleContext>(
      request_id, std::move(volley::DiscreteGarageState()), rclcpp::Time(0));

  DiscreteBayStateMsg bay {};
  bay.id = 1u;
  BayCommandMsg cmd {};
  cmd.command_type = 2;
  auto bay_transition = std::make_shared<volley::BayTransition>(0u, bay, cmd);
  ctx->events.AddEvent(bay_transition);
  ctx->UpdateLastEntityEvent(volley::BayId(bay.id), bay_transition);

  {
    // Should have one event
    EXPECT_EQ(1u, ctx->events.NumVertices());
    auto bay_last_event_it = ctx->last_entity_event.find(volley::BayId(bay.id));
    // Should have a last event for this bay.
    EXPECT_FALSE(bay_last_event_it == ctx->last_entity_event.end());
    auto last_entity_event = dynamic_cast<volley::BayTransition*>(bay_last_event_it->second.get());
    EXPECT_EQ(bay_transition->GetBayId(), last_entity_event->GetBayId());
    EXPECT_EQ(bay_transition->GetCommand(), last_entity_event->GetCommand());
  }

  bay.id = 2u;
  cmd.command_type = 2;
  auto bay_transition_2 = std::make_shared<volley::BayTransition>(0u, bay, cmd);
  ctx->events.AddEvent(bay_transition_2);
  ctx->UpdateLastEntityEvent(volley::BayId(bay.id), bay_transition_2);

  {
    // Should have two events
    EXPECT_EQ(2u, ctx->events.NumVertices());
    auto bay_last_event_it = ctx->last_entity_event.find(volley::BayId(bay.id));
    // Should have a last event for this bay.
    EXPECT_FALSE(bay_last_event_it == ctx->last_entity_event.end());
    auto last_entity_event = dynamic_cast<volley::BayTransition*>(bay_last_event_it->second.get());
    EXPECT_EQ(bay_transition_2->GetBayId(), last_entity_event->GetBayId());
    EXPECT_EQ(bay_transition_2->GetCommand(), last_entity_event->GetCommand());
  }

  bay.id = 1u;
  cmd.command_type = 2;
  auto bay_transition_3 = std::make_shared<volley::BayTransition>(0u, bay, cmd);
  ctx->events.AddEvent(bay_transition_3);
  ctx->UpdateLastEntityEvent(volley::BayId(bay.id), bay_transition_3);

  {
    // Should have three events
    EXPECT_EQ(3u, ctx->events.NumVertices());
    auto bay_last_event_it = ctx->last_entity_event.find(volley::BayId(bay.id));
    // Should have a last event for this bay.
    EXPECT_FALSE(bay_last_event_it == ctx->last_entity_event.end());
    auto last_entity_event = dynamic_cast<volley::BayTransition*>(bay_last_event_it->second.get());
    EXPECT_EQ(bay_transition_3->GetBayId(), last_entity_event->GetBayId());
    EXPECT_EQ(bay_transition_3->GetCommand(), last_entity_event->GetCommand());
    // Should have a dependency between this and first bay transition for bay 2
    EXPECT_TRUE(ctx->events.HasDependency(bay_transition, bay_transition_3));
  }
}

