namespace volley {

// Validate the base state of the garage. Right now we just check that:
// - the DGS message contains a valid DGS (no duplicate entities, etc.)
//      - Note this does not check for overlapping entities
// - entities are at valid locations in the layout
// - all payloads are valid sizes in the layout's resource size windows
std::pair<std::optional<volley::DiscreteGarageState>, std::string> ValidateBaseState(
    const DiscreteGarageStateMsg& state, const volley::Layout& layout);

// The bay rebalancing logic exists to determine when to get bays ready for retrieve and ready for
// insert. We achieve this by planning ReadyForInsertJobs and ReadyForRetrieveJobs.
enum class BayClassification : uint8_t {
  INSERT_READY,              // in READY_TO_INSERT with an empty tray
  WILL_BE_INSERT_READY,      // will be INSERT_READY after user interaction
  RETRIEVE_READY,            // in READY_TO_RETRIEVE with no tray
  WILL_BE_RETRIEVE_READY,    // will be RETRIEVE_READY after user interaction. Currently, we don't
                             // use this
  INSERT_READY_BUT_INVALID,  // in READY_TO_INSERT either with a payload or without a tray
  // Note that the real system should never be in this state
  // - it would error out.
  RETRIEVE_READY_BUT_INVALID,  // in READY_TO_RETRIEVE with a tray
  // Note that this is a valid configuration that occurs if,
  // for example, a customer fails to retrieve a car.
  WILL_BE_RETRIEVE_READY_BUT_INVALID,  // will be RETRIEVE_READY_BUT_INVALID after user
  // interaction
  NOT_USABLE,  // bay is in an error state, and cannot be used
};

// Classify a bay into a BayClassification given its necessary contextual information.
// `state` is the state the schedule plans the bay to be in once the schedule is done. See
// BayReport.msg
// Note: This does not check for disabledness. That logic is in ClassifyBays
BayClassification ClassifyBay(uint8_t state, bool tray_in_bay, bool payload_in_bay);

// Classify all bays in the given garage state.
std::unordered_map<uint16_t, BayClassification> ClassifyBays(const volley::DiscreteGarageState& state);

// Compute the desired number of insert-ready bays and the desired number of retrieve-ready bays.
// This method takes into account multiple factors.
// Inputs:
//  desired_bay_readiness_ratio - The target fraction of n_insert_ready_bays / n_bays.
//                                 For example, a value of 0.5 would nominally mean half of our bays
//                                 should be insert-ready.
//  n_eligible_bays              - The number of bays that can be commanded. Bays that are currently
//                                 doing something cannot be commanded. (i.e. the "WILL_BE" bays.)
//  n_empty_trays                - The number of empty trays. We cannot move more bays to
//                                 READY_TO_INSERT than there are empty trays.
std::pair<int, int> CalculateDesiredBaySplit(
    float desired_bay_readiness_ratio, int n_eligible_bays, int n_empty_trays);

// Return two lists of bay IDs. The first list is all the bays that should be transitioned to Ready
// for Insert. The second is bays to be transitioned to Ready for Retrieve A bay will not be in both
// of these lists. It is also not guaranteed to be in either list, if it's already in the desired
// state
std::pair<std::vector<uint16_t>, std::vector<uint16_t>> ComputeBayRebalancingActions(
    std::unordered_map<uint16_t, BayClassification> bay_classifications,
    const std::vector<uint16_t>& bay_prioritization, int n_desired_insert_ready_bays,
    int n_desired_retrieve_ready_bays);

// This method determines whether / which bays should be transitioned over to
// READY_TO_INSERT or READY_TO_RETRIEVE based on the execution plan and
// a desired bay split ratio. The return value is a pair of vectors of bay ids. The first vector is
// bays to transition to Ready for Insert, the second is bays to transition to Ready for Retrieve.
// Note: this is the function that actually gets called by the Scheduler. All others are helpers
std::pair<std::vector<uint16_t>, std::vector<uint16_t>> ComputeBayRebalancingActions(
    const volley::DiscreteGarageState& state, const std::vector<uint16_t>& bay_prioritization,
    float desired_bay_readiness_ratio);

//! @brief Creates a unique Action GUID using an internal static counter
GuidMsg CreateActionGuid();

//! @brief Returns true if the provided @c Motion represents an AGV command that moves from one floor to
//! another
bool IsFloorTraversalMotion(const Motion& motion, const Layout& layout);

//! @brief Returns true if the provided @c ActionNodeMsg represents an AGV command that moves from one floor
//! to another
bool IsFloorTraversalAction(const ActionNodeMsg& action_node, const Layout& layout);

//! @brief Inserts VRC command action nodes into the provided DAG for any AGV action that crosses floors via a
//! VRC
stdx::Result InsertVrcActionsIntoDag(DagBase<ActionNodeMsg>& actions_dag, const Layout& layout,
    const DiscreteGarageState& initial_state, const cost::MotionCostModel& cost_model);

}  // namespace volley
