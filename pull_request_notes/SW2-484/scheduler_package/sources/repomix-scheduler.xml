    ASSERT_EQ(job.job.state, SchedulerJobMsg::STATE_EXECUTING);
  }

  // every node should be an AGV command besides first and last one
  // sequential commands should match src and dst
  // should be one lift and one lower
  auto schedule = response.schedule.nodes;
  auto prev_dst = volley::ConstructGaragePose(9, 0);
  bool has_lift = false;
  bool has_lower = false;
  bool has_transition_to_retrieve = false;
  bool has_process_retrieve = false;
  for(auto node : schedule) {
    bool agv_command = node.type == ActionNodeMsg::TYPE_AGV_COMMAND;
    bool bay_command = node.type == ActionNodeMsg::TYPE_BAY_COMMAND;
    EXPECT_TRUE(agv_command || bay_command);
    if(bay_command) {
      has_transition_to_retrieve =
          has_transition_to_retrieve ||
          (node.bay_command.command_type == BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE);
      has_process_retrieve = has_process_retrieve or
                             (node.bay_command.command_type == BayCommandMsg::COMMAND_TYPE_PROCESS_RETRIEVE);
      continue;
    }
    EXPECT_EQ(prev_dst, node.agv_command.src.pose);
    prev_dst = node.agv_command.dst.pose;
    has_lower = has_lower || IsLower(node.agv_command);
    has_lift = has_lift || IsLift(node.agv_command);
  }
  EXPECT_EQ(volley::ConstructGaragePose(1, -90), schedule[schedule.size() - 2].agv_command.dst.pose);
  EXPECT_TRUE(has_lift);
  EXPECT_TRUE(has_lower);
  EXPECT_TRUE(has_transition_to_retrieve);
  EXPECT_TRUE(has_process_retrieve);
};

