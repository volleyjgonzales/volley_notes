#include "scheduler/scheduler.hpp"

#include <chrono>
#include <cmath>
#include <common_ros/discrete_garage_event_io.hpp>
#include <common_ros/garage_occupancy_checker.hpp>
#include <common_ros/roslog.hpp>
#include <interfaces/msg/plan_request.hpp>
#include <motion_planner/agv_hiding_search.hpp>
#include <motion_planner/blocking_tray_search.hpp>
#include <motion_planner/chugg.hpp>
#include <motion_planner/garage_graph_pathing.hpp>
#include <motion_planner/interval.hpp>
#include <task_planner/assignment.hpp>
#include <unordered_map>
#include <unordered_set>
#include <vrc_interfaces/msg/vrc_state.hpp>

#include "rclcppx/logging.hpp"
#include "scheduler/scheduler_msgs.hpp"

using std::chrono_literals::operator""s;

namespace volley {

namespace {

std::shared_ptr<ActionNodeMsg> ToActionNode(
    const volley::Motion& motion, GuidMsg job_id, const std::shared_ptr<volley::ScheduleEvent>& event) {
  using volley::Motion;

  // Ignore waits for the action dag
  auto delta = motion.GetDelta();
  if(!delta) {
    return nullptr;
  }

  auto result = std::make_shared<ActionNodeMsg>();
  result->guid = CreateActionGuid();
  result->job_id = job_id;
  result->duration = static_cast<float>(motion.GetInterval().GetDuration().count()) / 1e9f;

  // Consider refactoring
  if(delta->type == "AgvPoseChanged") {
    auto pose_change = volley::Deserialize<AgvPoseChangedMsg>(delta.value());
    if(!pose_change) {
      // Error here
      return nullptr;
    }

    result->type = ActionNodeMsg::TYPE_AGV_COMMAND;
    result->agv_id = pose_change->agv_id;
    result->agv_command.src.pose.node_id = pose_change->node_id_curr;
    result->agv_command.src.pose.heading = pose_change->heading_curr;
    result->agv_command.dst.pose.node_id = pose_change->node_id_next;
    result->agv_command.dst.pose.heading = pose_change->heading_next;
    // This means I need to progress through the motions and update the discrete state
    // and the same time
    result->agv_command.src.lift =
        motion.GetCollisionId() != common::EnumInteger(volley::CollisionEntityId::AGV);
    result->agv_command.dst.lift =
        motion.GetCollisionId() != common::EnumInteger(volley::CollisionEntityId::AGV);
  }
  else if(delta->type == "AgvLiftChanged") {
    auto lift_change = volley::Deserialize<AgvLiftChangedMsg>(delta.value());
    if(!lift_change) {
      // Error here
      return nullptr;
    }

    result->type = ActionNodeMsg::TYPE_AGV_COMMAND;
    result->agv_id = lift_change->agv_id;
    result->agv_command.src.pose = std::get<Motion::Pose>(motion.GetLocation());
    result->agv_command.dst.pose = std::get<Motion::Pose>(motion.GetLocation());
    result->agv_command.src.lift = !lift_change->raised;
    result->agv_command.dst.lift = lift_change->raised;
  }
  else if(delta->type == "BayStateChanged") {
    const auto bay_transition = dynamic_cast<const volley::BayTransition*>(event.get());
    if(!bay_transition) {
      return nullptr;
    }
    auto bay_change = volley::Deserialize<BayStateChangedMsg>(delta.value());
    if(!bay_change) {
      // Error here
      return nullptr;
    }
    result->type = ActionNodeMsg::TYPE_BAY_COMMAND;
    result->bay_id = bay_change->bay_id;
    result->bay_command = bay_transition->GetCommand();
  }
  else if(delta->type == "VecsStateChanged") {
    auto vecs_change = volley::Deserialize<VecsStateChangedMsg>(delta.value());
    if(!vecs_change) {
      // Error here
      return nullptr;
    }
    result->type = ActionNodeMsg::TYPE_VECS_COMMAND;
    result->vecs_id = vecs_change->vecs_id;
    VecsCommandMsg command {};
    command.command_id = std::to_string(result->guid);
    switch(vecs_change->state_next) {
    case VecsReportMsg::READY_TO_CHARGE: {
      command.command_type = VecsCommandMsg::COMMAND_TYPE_STOP_CHARGING;
    } break;
    case VecsReportMsg::CHARGING: {
      command.command_type = VecsCommandMsg::COMMAND_TYPE_START_CHARGING;
    } break;
    default:
      return nullptr;
    }
    result->vecs_command = command;
  }
  else if(delta->type == "VrcStateChanged") {
    auto vrc_change = volley::Deserialize<VrcStateChangedMsg>(delta.value());
    if(!vrc_change) {
      return nullptr;
    }
    result->type = ActionNodeMsg::TYPE_VRC_COMMAND;
    result->vrc_id = vrc_change->current_discrete_state.id;
    VrcCommandMsg command {};
    command.command_id = std::to_string(result->guid);
    command.command_type = VrcCommandMsg::COMMAND_TYPE_MOVE;
    command.requested_floor = vrc_change->next_discrete_state.current_floor;
    result->vrc_command = command;
  }
  else {
    return nullptr;
  }

  return result;
}

// Total order on Motions used to build the schedule: by start time, then by action id, then by
// hash. The final tiebreaker keeps std::set from collapsing distinct same-start same-job motions.
struct MotionScheduleOrder {
  bool operator()(const volley::Motion& a, const volley::Motion& b) const {
    if(a.GetInterval().GetTimes().first != b.GetInterval().GetTimes().first) {
      return a.GetInterval().GetTimes().first < b.GetInterval().GetTimes().first;
    }
    if(a.GetActionId() != b.GetActionId()) {
      return a.GetActionId() < b.GetActionId();
    }
    return volley::MotionHasher {}(a) < volley::MotionHasher {}(b);
  }
};

// Walks the per-entity trajectories and builds the combined ordered set of motions, collapsing
// runs of consecutive floor-traversal motions into a single motion. Wait/idle motions are
// skipped. Returns an empty optional on success, or an error message.
std::optional<std::string> CollectAndCollapseTrajectoryMotions(const volley::ContinuousState& final_state,
    const volley::Layout& layout, std::set<volley::Motion, MotionScheduleOrder>& all_motions) {
  using volley::Interval;
  using volley::Motion;
  for(const auto& [entity_id, traj] : final_state.GetTrajectories()) {
    std::optional<Motion> first_floor_traversal_motion;
    for(const auto& motion : traj) {
      if(IsFloorTraversalMotion(motion, layout)) {
        if(!first_floor_traversal_motion.has_value()) {
          first_floor_traversal_motion = motion;
        }
        continue;
      }
      else if(first_floor_traversal_motion.has_value()) {
        const Interval interval(
            first_floor_traversal_motion.value().GetInterval().GetBegin(), motion.GetInterval().GetBegin());
        Motion collapsed_floor_traversal_motion(motion.GetEntityId(), interval, motion.GetCollisionId(),
            motion.GetActionId(),
            {first_floor_traversal_motion.value().GetSourcePose(), motion.GetSourcePose()});

        if(!all_motions.insert(collapsed_floor_traversal_motion).second) {
          return std::format(
              "Failed to add {} to set of all motions", std::to_string(collapsed_floor_traversal_motion));
        }
        first_floor_traversal_motion = std::nullopt;
      }

      // Ignore wait trajectories; dependencies will be figured out by occupancy checker instead.
      auto delta = motion.GetDelta();
      if(!delta.has_value() || motion.IsIdle()) {
        continue;
      }
      // Idle bay state has a delta but no associated action; we already filtered above.
      if(!all_motions.insert(motion).second) {
        return std::format("Failed to add {} to set of all motions", std::to_string(motion));
      }
    }
  }
  return std::nullopt;
}

// Loops over the ordered motions and builds final_actions_dag: each motion becomes an
// ActionNode, tied to its event via event_start_end, ordered against the prior action for the
// same entity, and chained through freeing_moves so any prior occupant of the same pose is a
// dependency. Returns an error message on failure.
std::optional<std::string> BuildActionDagFromMotions(
    const std::set<volley::Motion, MotionScheduleOrder>& all_motions, ScheduleContextSPtr ctx,
    volley::DagBase<ActionNodeMsg>& final_actions_dag,
    volley::GarageOccupancyChecker<std::shared_ptr<ActionNodeMsg>>& freeing_moves,
    std::unordered_map<size_t, std::pair<ActionNodeMsg::SharedPtr, ActionNodeMsg::SharedPtr>>&
        event_start_end,
    const rclcpp::Logger& logger) {
  std::unordered_map<GarageEntityIdMsg, std::shared_ptr<ActionNodeMsg>, volley::GarageEntityIdHasher>
      last_entity_action;
  for(const auto& motion : all_motions) {
    const auto event_vert = static_cast<volley::ScheduleEventDag::Vertex>(motion.GetActionId());
    const auto event = ctx->events.GetEventFromVertex(event_vert).value();
    const auto action_node = ToActionNode(motion, ctx->scheduled_jobs[event->GetJobIndex()].job.guid, event);
    if(!action_node) {
      const std::string error_msg = std::format(
          "Failed to convert {} for event {} to ActionNode!", std::to_string(motion), event->ToString());
      ERRORS(logger, error_msg);
      return error_msg;
    }
    // Track first/last action node for this event. Tasks are linear, so a simple update of
    // `last` (overwriting on each subsequent motion) is sufficient.
    if(!event_start_end.contains(motion.GetActionId())) {
      event_start_end[motion.GetActionId()] = std::make_pair(action_node, action_node);
    }
    else {
      event_start_end[motion.GetActionId()].second = action_node;
    }
    final_actions_dag.Add(action_node);

    auto last_action = last_entity_action.find(motion.GetEntityId());
    if(last_action != last_entity_action.end()) {
      final_actions_dag.AddDependency(last_action->second, action_node);
    }
    last_entity_action[motion.GetEntityId()] = action_node;

    // We must consider "lifted" to be true when the collision ID is not AGV as a tray or payload can only
    // move if lifted by an AGV. Therefore, all collision IDs that are not AGVs are considered lifted.
    const bool lifted = motion.GetCollisionId() != common::EnumInteger(CollisionEntityId::AGV);
    auto blockers_opt = freeing_moves.GetBlockers(motion.GetLocation(), motion.GetCollisionId(), lifted);
    // Overkill but pruned later by Reduce(): every move into a space depends on every move
    // which has ever occluded that space previously.
    if(blockers_opt) {
      for(auto& blocker : blockers_opt.value()) {
        final_actions_dag.AddDependency(blocker, action_node);
      }
    }
    // TODO(Gunther): Not sure this works for Bay transitions
    freeing_moves.AddOccupant(motion.GetLocation(), motion.GetCollisionId(), action_node, lifted);
  }
  return std::nullopt;
}

// Walks the event DAG in topological order and transfers per-event dependencies to the
// finalized action DAG, tying the end of one event's actions to the start of each downstream
// event's actions. Returns an error on missing motion mapping or unordered events.
std::optional<std::string> TransferEventDagDepsToActionDag(ScheduleContextSPtr ctx,
    const std::unordered_map<size_t, std::pair<ActionNodeMsg::SharedPtr, ActionNodeMsg::SharedPtr>>&
        event_start_end,
    volley::DagBase<ActionNodeMsg>& final_actions_dag, const rclcpp::Logger& logger) {
  const auto total_ordering = ctx->events.GetTopologicalOrdering();
  if(!total_ordering.has_value()) {
    const std::string error_msg = "Failed to get total ordering for input events!";
    ERRORS(logger, error_msg);
    return error_msg;
  }
  for(const auto& event_vert : total_ordering.value()) {
    if(!event_start_end.contains(event_vert)) {
      auto event = ctx->events.GetEventFromVertex(event_vert).value();
      const std::string error_msg =
          std::format("Failed to transfer dependencies: {} ({}) has no associated motions!",
              event->ToString(), event_vert);
      ERRORS(logger, error_msg);
      return error_msg;
    }
    auto [start_node, end_node] = event_start_end.at(event_vert);
    for(const auto& dep_edge : boost::make_iterator_range(ctx->events.GetOutEdges(event_vert))) {
      auto dep_vert = dep_edge.m_target;
      auto dep_start_node = event_start_end.at(dep_vert).first;
      final_actions_dag.AddDependency(end_node, dep_start_node);
    }
  }
  return std::nullopt;
}

// Final pass: walks final_ordering once to assemble the output ActionNodeMsg vector. Each node
// gets its parents indices wired to ancestors in the action DAG plus a chain dep on the prior
// action for the same AGV/Bay/VRC. Updates ctx->scheduled_jobs in place with node_indices.
std::vector<ActionNodeMsg> BuildScheduledActionsArray(ScheduleContextSPtr ctx,
    volley::DagBase<ActionNodeMsg>& final_actions_dag,
    const std::vector<volley::DagBase<ActionNodeMsg>::Vertex>& final_ordering) {
  std::unordered_map<GuidMsg, size_t> action_node_to_index;

  // Should use refs here but that didn't compile, so just copy, then erase and replace once
  // we're done.
  std::unordered_map<GuidMsg, ScheduledJobDataMsg> job_id_to_job_data;
  for(const auto& scheduled_job : ctx->scheduled_jobs) {
    job_id_to_job_data[scheduled_job.job.guid] = scheduled_job;
  }

  std::unordered_map<GarageEntityIdMsg, unsigned int> entity_last_action;
  std::vector<ActionNodeMsg> scheduled_actions;
  for(unsigned int idx = 0; idx < final_ordering.size(); ++idx) {
    auto action_vert = final_ordering[idx];
    auto action_node = final_actions_dag.GetFromVertex(action_vert).value();
    job_id_to_job_data[action_node->job_id].node_indices.push_back(scheduled_actions.size());
    action_node_to_index[action_node->guid] = scheduled_actions.size();
    for(const auto& edge : boost::make_iterator_range(final_actions_dag.GetInEdges(action_vert))) {
      auto parent_action_node = final_actions_dag.GetFromVertex(edge.m_source).value();
      action_node->parents.push_back(action_node_to_index[parent_action_node->guid]);
    }

    GarageEntityIdMsg id {};
    if(action_node->type == ActionNodeMsg::TYPE_AGV_COMMAND) {
      id = volley::AgvId(action_node->agv_id);
    }
    else if(action_node->type == ActionNodeMsg::TYPE_BAY_COMMAND) {
      id = volley::BayId(action_node->bay_id);
    }
    else if(action_node->type == ActionNodeMsg::TYPE_VRC_COMMAND) {
      id = volley::VrcId(action_node->vrc_id);
    }

    auto last_action_it = entity_last_action.find(id);
    if(last_action_it == entity_last_action.end()) {
      entity_last_action.insert({id, idx});
    }
    else {
      const unsigned int last_action_idx = last_action_it->second;
      if(std::find(action_node->parents.begin(), action_node->parents.end(), last_action_idx) ==
          action_node->parents.end()) {
        action_node->parents.push_back(last_action_idx);
      }
      entity_last_action[id] = idx;
    }
    scheduled_actions.push_back(*action_node);
  }

  ctx->scheduled_jobs.clear();
  for(const auto& [_, job_data] : job_id_to_job_data) {
    ctx->scheduled_jobs.push_back(job_data);
  }
  return scheduled_actions;
}

