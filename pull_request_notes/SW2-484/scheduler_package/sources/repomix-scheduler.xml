void Scheduler::InitRetrievalHeadings() {
  // Bays are considered for retrieve in ascending bay_prioritization order (see PlanRetrieveJob),
  // so the back of the prioritization list is the bay a retrieve reaches for first.
  const std::vector<uint16_t>& bay_prioritization = layout_->GetBayPrioritization();
  // There is no bay, so there are no retrieval orientations (happens in sim/test)
  if(bay_prioritization.empty()) {
    return;
  }

  const uint16_t retrieve_bay_id = bay_prioritization.back();
  const auto inbound_heading_or = layout_->GetBayInboundHeading(retrieve_bay_id);
  if(!inbound_heading_or.has_value()) {
    LOG_ERROR(logger_, "Cannot calculate retrieval headings, bay {} has no inbound heading", retrieve_bay_id);
    return;
  }

  const auto retrieval_heading = static_cast<int16_t>(ReciprocalAngle(inbound_heading_or.value()));
  const GaragePoseMsg bay_pose = ConstructGaragePose(retrieve_bay_id, retrieval_heading);

  for(const GarageNodeMsg& node : layout_->GetNodes()) {
    if(node.type != GarageNodeMsg::TYPE_PARKING) {
      continue;
    }

    const std::vector<int16_t> headings = GetAllowedHeadings(node);

    // If the retrieval heading is not allowed for the spot, simply do not cache a heading and move on
    if(std::ranges::find(headings, retrieval_heading) == headings.end()) {
      LOG_DEBUG(logger_, "Parking node {} cannot hold retrieval heading {}", node.id, retrieval_heading);
      continue;
    }

    // A heading the layout allows is not necessarily one a tray can be moved into (specifically when a node's
    // edges have disallowed_edge_orientation values set). Therefore, confirm the pose can still reach the bay
    // on an otherwise empty graph before caching it.
    const GaragePoseMsg candidate_pose = ConstructGaragePose(node.id, retrieval_heading);
    if(GetPosePath(gg_, candidate_pose, bay_pose, cost_model_).empty()) {
      LOG_DEBUG(logger_, "{} cannot reach bay pose {}, skipping retrieval heading caching",
          std::to_string(candidate_pose), std::to_string(bay_pose));
      continue;
    }

    gg_.SetRetrievalHeading(node.id, retrieval_heading);
  }
}

Scheduler::Scheduler(std::string layout_filepath, rclcpp::Logger logger, const SchedulerParams& params) :
    layout_(std::make_shared<Layout>(layout_filepath)),
    pg_(layout_),
    gg_(pg_),
    table_(gg_, logger),
    logger_(logger),
    cost_model_(params.motion_cost),
    bay_readiness_ratio_(params.bay_readiness_ratio),
    costaudit_(params.cost_audit) {
  INFOF(logger_, "Scheduler initializing.");

  InitRetrievalHeadings();

  INFOF(logger_, "Scheduler initialized.");
}

PlanResponseMsg Scheduler::Plan(const PlanRequestMsg& request_data, const rclcpp::Time& now) const {
  PlanResponseMsg result;

  // Set Response ID to Request ID so Dispatch can validate the Response.
  result.id = request_data.id;

  // If there are any issues with the base state then we can't plan. Here we construct the base
  // state and run a few checks and return an unsuccessful plan response if any fail.
  auto [initial_state_opt, validate_message] = ValidateBaseState(request_data.base_state, *layout_);
  if(!initial_state_opt.has_value()) {
    result.success = false;
    result.message = "Invalid base state in plan request! " + validate_message;
    WARNS(logger_, result.message);
    return result;
  }
  volley::DiscreteGarageState initial_state = initial_state_opt.value();

  // Scheduler must handle the request base_schedule ActionNodes.
  // Set these as disabled in the initial_state, so they can not be used in planning.
  const auto& nodes = request_data.base_schedule.nodes;
  for(const auto& node : nodes) {
    if(node.type == ActionNodeMsg::TYPE_AGV_COMMAND) {
      // set the node.agv_id to disabled in the initial_state, so the AGV can't be assigned
      initial_state.SetAgvDisabled(node.agv_id);
      // set the pose node_id to disabled in the initial_state
      initial_state.SetNodeDisabled(node.agv_command.src.pose.node_id);
      initial_state.SetNodeDisabled(node.agv_command.dst.pose.node_id);
    }
    else if(node.type == ActionNodeMsg::TYPE_BAY_COMMAND) {
      // set the bay to disabled in the initial_state
      initial_state.SetBayDisabled(node.bay_id);
    }
    else if(node.type == ActionNodeMsg::TYPE_VECS_COMMAND) {
      // set the vecs to disabled in the initial_state
      initial_state.SetVecsDisabled(node.vecs_id);
    }
  }

  ScheduleContextSPtr plan_ctx =
      std::make_shared<ScheduleContext>(request_data.id, std::move(initial_state), now);

  // set disabledness filters from initial state
  plan_ctx->disabledness_filters =
      std::move(volley::GetDisabledEntitiesFilters(gg_, plan_ctx->initial_state, table_));

  INFOF(logger_, "Planning...");
  INFOS(logger_, "Plan request ID: " << std::to_string(request_data.id));

  LOG_INFO(logger_, "Discrete garage state from plan request:\n{}", std::to_string(plan_ctx->initial_state));

  for(const SchedulerJobMsg& job : request_data.pending_jobs) {
    INFOS(logger_, "Planning job " << std::to_string(job));
    switch(job.type) {
    case SchedulerJobMsg::TYPE_MOVE_AGV: {
      auto [success, message] =
          PlanAgvMoveJob(plan_ctx, job.agv_id, job.destination, false, plan_ctx->scheduled_jobs.size());
      if(!success) {
        result.scheduled_jobs.push_back(FailJob(job, message));
        break;
      }
      plan_ctx->PushBackScheduledJob(job);
    } break;
    case SchedulerJobMsg::TYPE_RETRIEVE: {
      auto [success, message, retain_job] =
          PlanRetrieveJob(plan_ctx, job.payload_id, plan_ctx->scheduled_jobs.size());
      if(!success) {
        result.scheduled_jobs.push_back(FailJob(job, message, retain_job));
        break;
      }
      plan_ctx->PushBackScheduledJob(job);
    } break;
    case SchedulerJobMsg::TYPE_REPARK_TRAY:
    case SchedulerJobMsg::TYPE_MOVE_TRAY: {
      auto [success, message] = PlanReparkTrayJob(
          plan_ctx, job.tray_id, plan_ctx->scheduled_jobs.size(), job.allow_reciprocal, job.destination);
      if(!success) {
        result.scheduled_jobs.push_back(FailJob(job, message));
        break;
      }
      plan_ctx->PushBackScheduledJob(job);
    } break;
    case SchedulerJobMsg::TYPE_INSERT: {
      auto [success, message] = PlanInsertJob(plan_ctx, job.bay_id, plan_ctx->scheduled_jobs.size());
      if(!success) {
        result.scheduled_jobs.push_back(FailJob(job, message));
        // If this is a failure, still make sure to clean up the garage.
        if(clean_garage_request_fn_) {
          clean_garage_request_fn_();
        }
        break;
      }
      plan_ctx->PushBackScheduledJob(job);
    } break;
    case SchedulerJobMsg::TYPE_READY_FOR_INSERT: {
      auto [success, message] = PlanReadyForInsertJob(plan_ctx, job.bay_id, plan_ctx->scheduled_jobs.size());
      if(!success) {
        result.scheduled_jobs.push_back(FailJob(job, message));
        break;
      }
      plan_ctx->PushBackScheduledJob(job);
    } break;
    case SchedulerJobMsg::TYPE_READY_FOR_RETRIEVE: {
      auto [success, message] =
          PlanReadyForRetrieveJob(plan_ctx, job.bay_id, plan_ctx->scheduled_jobs.size());
      if(!success) {
        result.scheduled_jobs.push_back(FailJob(job, message));
        break;
      }
      plan_ctx->PushBackScheduledJob(job);
    } break;
    case SchedulerJobMsg::TYPE_CLEAN_GARAGE: {
      auto [success, message] = PlanCleanGarageJob(plan_ctx, plan_ctx->scheduled_jobs.size());
      if(!success) {
        result.scheduled_jobs.push_back(FailJob(job, message));
        break;
      }
      plan_ctx->PushBackScheduledJob(job);
    } break;
    case SchedulerJobMsg::TYPE_REBALANCE_GARAGE: {
      auto [success, message] = PlanRebalanceGarageJob(plan_ctx, plan_ctx->scheduled_jobs.size());
      if(!success) {
        result.scheduled_jobs.push_back(FailJob(job, message));
        break;
      }
      plan_ctx->PushBackScheduledJob(job);
    } break;
    case SchedulerJobMsg::TYPE_CHARGE_AGV: {
      auto [success, message] = PlanAgvChargeJob(plan_ctx, job.agv_id, plan_ctx->scheduled_jobs.size());
      if(!success) {
        result.scheduled_jobs.push_back(FailJob(job, message));
        break;
      }
      plan_ctx->PushBackScheduledJob(job);
    } break;
    case SchedulerJobMsg::TYPE_TRANSITION_BAY_TO_INSERT: {
      auto [success, message] = PlanBayTransitionJob(plan_ctx, job.bay_id,
          BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT, plan_ctx->scheduled_jobs.size());
      if(!success) {
        result.scheduled_jobs.push_back(FailJob(job, message));
        break;
      }
      plan_ctx->PushBackScheduledJob(job);
    } break;
    case SchedulerJobMsg::TYPE_TRANSITION_BAY_TO_RETRIEVE: {
      auto [success, message] = PlanBayTransitionJob(plan_ctx, job.bay_id,
          BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE, plan_ctx->scheduled_jobs.size());
      if(!success) {
        result.scheduled_jobs.push_back(FailJob(job, message));
        break;
      }
      plan_ctx->PushBackScheduledJob(job);
    } break;
    case SchedulerJobMsg::TYPE_CHARGE_PAYLOAD: {
      auto [success, message] =
          PlanChargePayloadJob(plan_ctx, job.payload_id, plan_ctx->scheduled_jobs.size());
      if(!success) {
        result.scheduled_jobs.push_back(FailJob(job, message));
        break;
      }
      plan_ctx->PushBackScheduledJob(job);
    } break;
    default: {
      result.scheduled_jobs.push_back(
          FailJob(job, "Unknown job type " + std::to_string(job.type) + "(" + job.type_name + ")"));
    }
    }
    INFOS(logger_, "Done planning job " << std::to_string(job.guid));
  }

  if(plan_ctx->scheduled_jobs.empty()) {
    result.success = true;
    result.message = "No jobs succeeded to plan";
    return result;
  }

  INFOS(logger_, "Doing Tray Assignments");
  auto [success, message] = DoTrayAssignments(plan_ctx);
  if(!success) {
    result.success = true;
    result.message = "Failed tray assignments: " + message;
    for(const auto& job : request_data.pending_jobs) {
      result.scheduled_jobs.push_back(FailJob(job, message));
    }
    return result;
  }

  if(printdags_) {
    plan_ctx->events.PrintGraph(plan_ctx->request_id_str + "_after_tray_assignments", logger_);
  }
  INFOS(logger_, "Doing AGV assignments");
  std::tie(success, message) = DoAgvAssignments(plan_ctx);
  if(!success) {
    result.success = true;
    result.message = "Failed AGV assignments: " + message;
    for(const auto& job : request_data.pending_jobs) {
      result.scheduled_jobs.push_back(FailJob(job, message));
    }
    return result;
  }

  // TODO(any) Planning may fail if Reduce() is not called, likely because of
  // some redundant edges. This may have to do within Chugg in
  // GetDependencyCompletionTime() but needs to be looked into. Note that
  // this should not in theory have issues with redundant edges.
  plan_ctx->events.Reduce();
  if(printdags_) {
    plan_ctx->events.PrintGraph(plan_ctx->request_id_str + "_after_agv_assignments", logger_);
  }

  // Before sending the assigned events to the motion planner, sanity check the event ordering.
  // The motion planner doesn't fail in the most graceful ways, so we will just fail the plan call
  // here if there is an issue
  INFOS(logger_, "SanityCheckEvents");
  std::tie(success, message) = SanityCheckEvents(plan_ctx);
  if(!success) {
    message = "Pre-motion planning sanity check failed: " + message;
    result.success = true;
    result.message = message;
    for(const auto& job : request_data.pending_jobs) {
      result.scheduled_jobs.push_back(FailJob(job, message));
    }
    return result;
  }

  INFOS(logger_, "Running path planning");
  // Plan the trajectories to resolve this job.
  // This should not fail if job/tray planning is feasible
  auto final_trajectories_opt = PlanMotions(plan_ctx);
  if(!final_trajectories_opt.has_value()) {
    result.success = true;
    result.message = "CHUGG failed to find a solution, event dag may be infeasible";
    for(const auto& job : request_data.pending_jobs) {
      result.scheduled_jobs.push_back(
          FailJob(job, "CHUGG failed to find a solution, event dag may be infeasible"));
    }
    return result;
  }
  auto final_trajectories = final_trajectories_opt.value();
  const auto& trajectories = final_trajectories.GetTrajectories();

  if(logger_.get_effective_level() == rclcpp::Logger::Level::Debug) {
    LOG_DEBUG(logger_, "Planned trajectories:");
    for(const auto& [entity, traj] : trajectories) {
      LOG_DEBUG(logger_, "{}:", std::to_string(entity));
      for(const auto& motion : traj) {
        LOG_DEBUG(logger_, "{}", std::to_string(motion));
      }
    }
  }

  INFOS(logger_, "Building schedule response");
  // Sets the node indices in the `scheduled_jobs` list
  auto [schedule_opt, message2] = ResponseFromTrajectories(plan_ctx, final_trajectories);
  if(!schedule_opt.has_value()) {
    result.success = true;
    result.message = "ResponseFromTrajectories failed  " + message2;
    for(const auto& job : request_data.pending_jobs) {
      result.scheduled_jobs.push_back(FailJob(job, "ResponseFromTrajectories failed  " + message2));
    }
    return result;
  }
  auto action_nodes = schedule_opt.value();

  for(auto& scheduled_job : plan_ctx->scheduled_jobs) {
    // TODO (mark): Unplanned / Failed jobs output
    scheduled_job.job.state = SchedulerJobMsg::STATE_EXECUTING;
    scheduled_job.job.state_name = "STATE_EXECUTING";

    if(scheduled_job.job.type == SchedulerJobMsg::TYPE_RETRIEVE) {
      // Set bay id and arrival node guid.
      for(const auto& node : action_nodes) {
        if(node.type == ActionNodeMsg::TYPE_BAY_COMMAND && node.job_id == scheduled_job.job.guid &&
            node.bay_command.command_type == BayCommandMsg::COMMAND_TYPE_PROCESS_RETRIEVE) {
          scheduled_job.bay_id = node.bay_id;
          scheduled_job.bay_arrival_node_guid = node.guid;
          break;
        }
      }
      if(scheduled_job.bay_id == 0) {
        // TODO (mark): better error handling
        ERRORS(logger_, "No process retrieve action node found for retrieve job");
      }
    }
    result.scheduled_jobs.push_back(scheduled_job);
  }

  result.schedule.nodes = std::move(action_nodes);
  result.success = true;
  INFOF(logger_, "Done planning.");
  return result;
}

BoolStringPair Scheduler::PlanAgvMoveJob(ScheduleContextSPtr ctx, std::optional<uint16_t> agv_id,
    GaragePoseMsg dest, bool allow_recip, size_t job_index) const {
  volley::DiscreteGarageState working_state = ctx->initial_state;
  auto [success, message] = ctx->events.Apply(working_state);
  if(!success) {
    return std::make_pair(false, "Failed to apply event dag to state: " + message);
  }

  std::optional<DiscreteAgvStateMsg> agv_opt;
  if(agv_id) {
    agv_opt = working_state.GetAgv(agv_id.value());
  }
  else {
    // TODO(Gunther): Instead this can have an unscheduled destination or agv id and we
    // assign the AGV to the task later
    return std::make_pair(false, "Request to move any (unassigned) AGV not yet supported");
  }
  if(!agv_opt) {
    return std::make_pair(
        false, "Tried to move a" + std::to_string(agv_id.value()) + " which doesn't exist!");
  }

  if(agv_opt.value().disabled) {
    return std::make_pair(false, "Tried to move a disabled agv " + std::to_string(agv_id.value()));
  }

  // AGV is already at destination
  if(agv_opt->pose == dest) {
    return std::make_pair(true, "");
  }

  AgvPoseChangedMsg pose_change;
  pose_change.agv_id = agv_id.value();
  pose_change.node_id_curr = agv_opt->pose.node_id;
  pose_change.heading_curr = agv_opt->pose.heading;
  pose_change.node_id_next = dest.node_id;
  pose_change.heading_next = dest.heading;

  auto collision_id = volley::CollisionEntityIdFromAgvState(agv_opt.value(), working_state, *layout_);

  // check that destination isn't disabled
  auto dest_vert_opt = gg_.GetVertexFromPose(dest);
  if(!dest_vert_opt) {
    return std::make_pair(
        false, "Tried to move an agv to a destination that doesn't exist: " + std::to_string(dest));
  }

  if(!ctx->disabledness_filters[collision_id].IsEnabled(dest_vert_opt.value())) {
    return std::make_pair(false, "Tried to move an agv to a disabled location: " + std::to_string(dest));
  }

  // Assume that if we aren't angle or recip, that it costs the same amount of time
  // to go to one or the other, so like, might as well do the requested heading then
  if(allow_recip && volley::IsAngleOrReciprocal(agv_opt->pose.heading, dest.heading)) {
    pose_change.node_id_next = agv_opt->pose.node_id;
    pose_change.heading_next = agv_opt->pose.heading;
  }

  std::shared_ptr<volley::ScheduleEvent> new_event;
  if(agv_opt->tray_id == 0) {
    // Create an AgvMove if agv is not carrying a tray
    auto agv_move = std::make_shared<volley::AgvMove>(job_index, pose_change);
    ctx->events.AddEvent(agv_move);
    ctx->UpdateLastEntityEvent(agv_move->GetGarageEntityId().value(), agv_move);
    new_event = std::static_pointer_cast<volley::ScheduleEvent>(agv_move);
  }
  else {
    // Create TrayMove, with destination in tray coordinates.
    auto tray_move = std::make_shared<volley::TrayMove>(job_index);
    tray_move->SetTrayId(agv_opt.value().tray_id);
    tray_move->SetAgvId(agv_id.value());
    auto tray = working_state.GetTray(agv_opt.value().tray_id).value();
    bool is_recip = volley::IsReciprocal(agv_opt.value().pose.heading, tray.pose.heading);
    dest = is_recip ? volley::ReciprocalGaragePose(dest) : dest;
    // Prefer to use the optimal retrieval heading of the parking node.
    UsePreferredHeading(dest, working_state.GetPayload(tray.payload_id), tray);
    tray_move->SetDest(dest);
    ctx->events.AddEvent(tray_move);
    ctx->UpdateLastEntityEvent(tray_move->GetGarageEntityId().value(), tray_move);
    new_event = std::static_pointer_cast<volley::ScheduleEvent>(tray_move);
  }

  ctx->UpdateLeafDependencies(new_event, job_index);

  return std::make_pair(true, "");
}

std::tuple<bool, std::string, bool> Scheduler::PlanRetrieveJob(
    ScheduleContextSPtr ctx, const GuidMsg& payload_id, size_t job_index) const {
  volley::DiscreteGarageState working_state = ctx->initial_state;
  auto [success, message] = ctx->events.Apply(working_state);
  if(!success) {
    ERRORS(logger_, "Failed to apply event dag to state: " << message);
    return std::make_tuple(false, message, false);
  }

  auto payload_opt = working_state.GetPayload(payload_id);
  std::optional<DiscreteBayStateMsg> bay_opt;

  if(!payload_opt.has_value()) {
    return std::make_tuple(
        false, "Requested retrieve of unknown payload " + std::to_string(payload_id), false);
  }

  // Ensure payload's area is enabled
  auto tray = working_state.GetTray(payload_opt->tray_id).value();
  auto collision_id = volley::CollisionEntityIdFromPayloadState(payload_opt.value(), *layout_);
  if(!ctx->disabledness_filters[collision_id].IsEnabled(gg_.GetVertexFromPose(tray.pose).value())) {
    return std::make_tuple(
        false, "Payload requested for retrieve is in a disabled area " + std::to_string(tray.pose), false);
  }

  // Is it on a VECS? Fine if it's READY TO CHARGE. If it's CHARGING, then command it to stop. If
  // any other state, don't plan the job
  auto vecs_opt = working_state.GetVecs(working_state.GetTray(payload_opt->tray_id)->pose.node_id);
  if(vecs_opt.has_value() && vecs_opt->state != VecsReportMsg::READY_TO_CHARGE) {
    if(vecs_opt->state == VecsReportMsg::CHARGING) {
      // Transition the VECS
      VecsStateChangedMsg state_change {};
      state_change.vecs_id = vecs_opt->id;
      state_change.state_curr = VecsReportMsg::CHARGING;
      state_change.state_next = VecsReportMsg::READY_TO_CHARGE;
      auto vecs_transition = std::make_shared<volley::VecsTransition>(job_index, state_change);
      ctx->events.AddEvent(vecs_transition);
    }
    else {
      return std::make_tuple(false,
          "Requested retrieve of payload that is on a VECS: " + std::to_string(volley::VecsId(vecs_opt->id)) +
              " that is in state: " + std::to_string(vecs_opt->state),
          true);
    }
  }

  // At some point this will be done in some kind of BayAssignment function
  // For now, we look at bays in reverse bay prioritization order. I.e. going in order of most
  // to least desired to be in Ready for Retrieve
  for(auto it = layout_->GetBayPrioritization().rbegin(); it != layout_->GetBayPrioritization().rend();
      ++it) {
    const auto& bay_id = *it;

    auto bay_state_opt = working_state.GetBay(bay_id);
    // Should never happen
    if(!bay_state_opt.has_value()) {
      continue;
    }
    // Ignore disabled bays
    if(bay_state_opt.value().disabled) {
      continue;
    }
    // Skip bays whose parking-window cannot accommodate this payload's dimensions. For
    // height, sentinel 0 on either side means "no constraint."
    auto bay_node_opt = layout_->GetNodeById(bay_id);
    if(bay_node_opt.has_value()) {
      auto bay_window_opt = layout_->GetResourceWindow(bay_node_opt->max_resource_size_index);
      if(bay_window_opt.has_value()) {
        const float pl = payload_opt->payload.length_m;
        const float pw = payload_opt->payload.width_m;
        const float ph = payload_opt->payload.height_m;
        if(pl > bay_window_opt->length_m || pw > bay_window_opt->width_m) {
          continue;
        }
        if(ph > 0.0f && bay_window_opt->height_m > 0.0f && ph > bay_window_opt->height_m) {
          continue;
        }
      }
    }
    // Select a bay in the READY_TO_RETRIEVE state if there is one
    if(bay_state_opt->state == BayReportMsg::STATE_READY_TO_RETRIEVE) {
      bay_opt = bay_state_opt;
      break;
    }

    // Use a bay in READY_TO_INSERT if we don't find one in READY_TO_RETRIEVE.
    // When we have pre-bay sensing or a broader knowledge of the state of the world around
    // the garage, this will be more complicated and need a dedicated algorithm.
    // Alternatively a retrieve job will probably just specify a bay or set of bays to
    // use.
    if(!bay_opt.has_value() && (bay_state_opt->state == BayReportMsg::STATE_READY_TO_INSERT ||
                                   bay_state_opt->state == BayReportMsg::STATE_VEHICLE_INSERTED)) {
      bay_opt = bay_state_opt;
    }
  }

  if(!bay_opt.has_value()) {
    return std::make_tuple(false, "No Bay available for retrieve!", true);
  }

  // If we don't have any bays in Ready for Retrieve we will plan a transition here
  if(bay_opt->state == BayReportMsg::STATE_READY_TO_INSERT ||
      bay_opt->state == BayReportMsg::STATE_VEHICLE_INSERTED) {
    BayCommandMsg cmd;
    cmd.command_type = BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE;
    cmd.command_id = std::to_string(volley::MakeGuid(0, 1u));
    LOG_DEBUG(logger_, "Transitioning bay {} to READY_TO_RETRIEVE", bay_opt->id);

    auto bay_transition = std::make_shared<BayTransition>(job_index, *bay_opt, cmd);
    ctx->events.AddEvent(bay_transition);
    ctx->UpdateLastEntityEvent(bay_transition->GetGarageEntityId().value(), bay_transition);
    bay_opt->state = BayReportMsg::STATE_READY_TO_RETRIEVE;
  }

  // If a tray is already sitting on the bay node (without a vehicle on it), repark it before bringing in the
  // payload tray. Doing this explicitly here (rather than leaving it to ResolveBlockingTrays) ensures the
  // bay-clearing move is prioritized over other unblocking work during AGV assignment.
  // Depending on where the tray gets parked, it can still end up as a blocking tray,
  // but it is faster to handle a nearby blocking tray than to go back to the bay
  auto tray_in_bay = working_state.GetTrayOnNode(bay_opt->id);
  if(tray_in_bay.has_value()) {
    std::tie(success, message) = PlanReparkTrayJob(ctx, tray_in_bay->id, job_index, true);
    if(!success) {
      return std::make_tuple(false, "Failed to clear tray from bay before retrieve: " + message, false);
    }
  }

  GaragePoseMsg bay_pose;

  bay_pose.node_id = bay_opt->id;
  // Narrowing conversion is fine here because the heading is in the range [-90, 180]
  bay_pose.heading = static_cast<int16_t>(layout_->GetBayInboundHeading(bay_opt->id).value());

  auto dest_pose = payload_opt->reciprocal_to_tray ? bay_pose : volley::ReciprocalGaragePose(bay_pose);

  std::tie(success, message) = PlanReparkTrayJob(ctx, payload_opt->tray_id, job_index, false, dest_pose);
  if(!success) {
    return std::make_tuple(false, message, false);
  }

  BayCommandMsg cmd;
  LOG_DEBUG(logger_, "Ordering bay {} to PROCESS_RETRIEVE", bay_opt->id);
  cmd.command_type = BayCommandMsg::COMMAND_TYPE_PROCESS_RETRIEVE;
  cmd.command_id = std::to_string(volley::MakeGuid(0, 2u));

  auto bay_transition = std::make_shared<BayTransition>(job_index, *bay_opt, cmd);
  ctx->events.AddEvent(bay_transition);
  ctx->UpdateLastEntityEvent(bay_transition->GetGarageEntityId().value(), bay_transition);

  ctx->UpdateLeafDependencies(bay_transition, job_index);

  return std::make_tuple(true, "", false);
}

BoolStringPair Scheduler::PlanReparkTrayJob(ScheduleContextSPtr ctx, std::optional<uint16_t> tray_id,
    size_t job_index, bool allow_recip, std::optional<GaragePoseMsg> dest) const {
  if(!tray_id && !dest) {
    return std::make_pair(false, "Requested repark of tray with no tray_id or destination");
  }

  volley::DiscreteGarageState working_state = ctx->initial_state;
  auto [success, message] = ctx->events.Apply(working_state);
  if(!success) {
    ERRORS(logger_, "Failed to apply event dag to state: " << message);
    return std::make_pair(false, "Failed to apply event:" + message);
  }

  auto tray_move = std::make_shared<volley::TrayMove>(job_index);

  std::optional<DiscreteTrayStateMsg> tray_opt;
  if(tray_id) {
    tray_opt = ctx->initial_state.GetTray(tray_id.value());
    if(!tray_opt) {
      return std::make_pair(false, "Requested repark of tray " + std::to_string(tray_id.value()) +
                                       " which does not exist in discrete state");
    }
    if(tray_opt.value().disabled) {
      return std::make_pair(false, "Requested repark of disabled tray " + std::to_string(tray_id.value()));
    }

    // Is it on a VECS? Fine if it's READY TO CHARGE. If it's CHARGING, then command it to
    // stop. If any other state, don't plan the job
    auto vecs_opt = working_state.GetVecs(tray_opt->pose.node_id);
    if(vecs_opt.has_value() && vecs_opt->state != VecsReportMsg::READY_TO_CHARGE) {
      if(vecs_opt->state == VecsReportMsg::CHARGING) {
        // Transition the VECS
        VecsStateChangedMsg state_change {};
        state_change.vecs_id = vecs_opt->id;
        state_change.state_curr = VecsReportMsg::CHARGING;
        state_change.state_next = VecsReportMsg::READY_TO_CHARGE;
        auto vecs_transition = std::make_shared<volley::VecsTransition>(job_index, state_change);
        ctx->events.AddEvent(vecs_transition);
      }
      else {
        return std::make_pair(false,
            "Requested repark of tray that is on a VECS: " + std::to_string(volley::VecsId(vecs_opt->id)) +
                " that is in state: " + std::to_string(vecs_opt->state));
      }
    }

    tray_move->SetTrayId(tray_id.value());
  }
  if(dest) {
    auto vecs_opt = working_state.GetVecs(dest->node_id);
    auto bay_opt = working_state.GetBay(dest->node_id);
    // Optimal retrieval heading is not used for VECS or bays.
    if(!vecs_opt && !bay_opt) {
      std::optional<GarageNodeMsg> node_opt = layout_->GetNodeById(dest->node_id);
      if(node_opt && node_opt->type == GarageNodeMsg::TYPE_PARKING && allow_recip) {
        if(tray_opt) {
          auto payload_opt = working_state.GetPayload(tray_opt->payload_id);
          if(!payload_opt.has_value()) {
            // Tray orientation doesn't matter if there is no payload.
            if(volley::IsAngleOrReciprocal(tray_opt->pose.heading, dest->heading)) {
              dest->heading = tray_opt->pose.heading;
            }
          }
          else {
            // Prefer to use the optimal retrieval heading of the parking node. So
            // payloads can be retrieved faster.  Except if the attendant manually moved
            // the tray.
            const auto retrieval_angle_or = gg_.GetRetrievalHeading(dest->node_id);
            if(retrieval_angle_or.has_value()) {
              dest->heading = retrieval_angle_or.value();
              INFOF(logger_, "  PlanReparkTrayJob, Park with optimal retrieval heading %d", dest->heading);
              // What is the payload orientation on the tray?
              if(payload_opt->reciprocal_to_tray) {
                // Flip the tray around, so the payload is correct direction.
                dest->heading = volley::ReciprocalAngle(dest->heading);
              }
            }
            else {
              INFOF(logger_, "  PlanReparkTrayJob, No optimal heading for parking node %u", node_opt->id);
            }
          }
        }
      }
    }

    // Already at dest- do nothing
    if(tray_opt->pose == dest.value()) {
      return std::make_pair(true, "");
    }

    // For now let's just not allow Reparks onto VECS that are not Ready to Charge
    if(vecs_opt.has_value() && vecs_opt->state != VecsReportMsg::READY_TO_CHARGE) {
      return std::make_pair(false, "Requested repark to destination " + std::to_string(dest.value()) +
                                       " that has a VECS not in Ready to Charge!");
    }

    // Ensure destination is enabled
    auto collision_id = common::EnumInteger(volley::CollisionEntityId::TRAY);
    if(tray_id) {
      collision_id = volley::CollisionEntityIdFromTrayState(tray_opt.value(), working_state, *layout_);
    }
    auto dest_vert_opt = gg_.GetVertexFromPose(dest.value());
    if(!dest_vert_opt) {
      return std::make_pair(
          false, "Destination for repark tray does not exist " + std::to_string(dest.value()));
    }
    if(!ctx->disabledness_filters[collision_id].IsEnabled(dest_vert_opt.value())) {
      return std::make_pair(
          false, "Destination for repark tray is in a disabled area " + std::to_string(dest.value()));
    }

    if(bay_opt) {
      if(bay_opt->disabled) {
        return std::make_pair(
            false, "Destination for repark tray is in a disabled bay " + std::to_string(dest.value()));
      }
    }

    // Prefer to use the optimal retrieval heading of the parking node.
    if(tray_opt) {
      GaragePoseMsg dst = dest.value();
      UsePreferredHeading(dst, working_state.GetPayload(tray_opt->payload_id), tray_opt);
      dest = dst;
    }
    tray_move->SetDest(dest.value());
  }

  ctx->events.AddEvent(tray_move);
  if(tray_opt) {
    ctx->UpdateLastEntityEvent(tray_move->GetGarageEntityId().value(), tray_move);
  }

  // If reparking into a bay, ensure that we depend already on the last completed event for
  // that bay -- could either be a PROCESS_RETRIEVE or TRANSITION_TO_RETRIEVE
  if(tray_move->GetDest().has_value()) {
    auto bay_opt = working_state.GetBay(tray_move->GetDest()->node_id);
    if(bay_opt.has_value()) {
      if(ctx->last_entity_event.find(volley::BayId(bay_opt->id)) != ctx->last_entity_event.end()) {
        ctx->events.AddDependency(ctx->last_entity_event[volley::BayId(bay_opt->id)], tray_move);
      }
    }
  }
  // If reparking into a VECS, ensure that we depend already on its last completed event
  if(tray_move->GetDest().has_value()) {
    auto vecs_opt = working_state.GetVecs(tray_move->GetDest()->node_id);
    if(vecs_opt.has_value()) {
      if(ctx->last_entity_event.find(volley::VecsId(vecs_opt->id)) != ctx->last_entity_event.end()) {
        ctx->events.AddDependency(ctx->last_entity_event[volley::VecsId(vecs_opt->id)], tray_move);
      }
    }
  }

  // Tray move depends on all the leaf events for the job leading up to this
  // point, and the last event for the tray.
  ctx->UpdateLeafDependencies(tray_move, job_index);

  return std::make_pair(true, "");
}

BoolStringPair Scheduler::PlanOpenBayDoor(
    ScheduleContextSPtr ctx, const DiscreteBayStateMsg& bay, size_t job_index) const {
  // Command the bay to transition to Ready for Retrieve
  // Pick a retrieve floor
  auto system_floors_opt = layout_->GetBaySystemFloors(bay.id);
  if(!system_floors_opt.has_value()) {
    return std::make_pair(false, "PlanOpenBayDoor Requested to transition b" + std::to_string(bay.id) +
                                     " to READY_TO_RETRIEVE but it doesn't have a system floor");
  }
  auto system_floors = system_floors_opt.value();
  if(system_floors.size() == 0) {
    return std::make_pair(false, "PlanOpenBayDoor Requested to transition b" + std::to_string(bay.id) +
                                     " to READY_TO_RETRIEVE but it doesn't have any system floors.");
  }

  // Pick the first floor for now
  uint8_t target_floor = system_floors[0];
  BayCommandMsg cmd;
  cmd.command_type = BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE;
  cmd.command_id = std::to_string(volley::MakeGuid(0, 1u));
  cmd.floor = target_floor;
  auto bay_transition = std::make_shared<volley::BayTransition>(job_index, bay, cmd);
  ctx->events.AddEvent(bay_transition);
  ctx->UpdateLastEntityEvent(bay_transition->GetGarageEntityId().value(), bay_transition);
  ctx->UpdateLeafDependencies(bay_transition, job_index);

  return std::make_pair(true, "");
}

BoolStringPair Scheduler::PlanInsertJob(ScheduleContextSPtr ctx, uint16_t bay_id, size_t job_index) const {
  bool success = false;
  std::string message;

  volley::DiscreteGarageState working_state = ctx->initial_state;
  std::tie(success, message) = ctx->events.Apply(working_state);
  if(!success) {
    return std::make_pair(false, "PlanInsertJob Failed to apply event: " + message);
  }

  auto bay_opt = working_state.GetBay(bay_id);
  if(!bay_opt.has_value()) {
    return std::make_pair(false, "PlanInsertJob Requested InsertJob for bay " + std::to_string(bay_id) +
                                     " but the bay is not in discrete state");
  }

  if(bay_opt.value().disabled) {
    return std::make_pair(false, "PlanInsertJob Requested insert for disabled bay " + std::to_string(bay_id));
  }

  auto tray_opt = working_state.GetTrayOnNode(bay_opt->id);

  if(!tray_opt.has_value()) {
    return std::make_pair(false, "PlanInsertJob Requested InsertJob for bay " + std::to_string(bay_id) +
                                     " but the bay has no tray in discrete state.");
  }

  if(tray_opt->payload_id == volley::kEmptyGuid) {
    return std::make_pair(false, "PlanInsertJob Requested insert into bay " + std::to_string(bay_id) +
                                     " but tray " + std::to_string(tray_opt->id) +
                                     " does not have a payload");
  }

  if(bay_opt->state != BayReportMsg::STATE_VEHICLE_INSERTED &&
      bay_opt->state != BayReportMsg::STATE_READY_TO_RETRIEVE) {
    // If this happens, consider adding a transition for this state.
    return std::make_pair(false, "PlanInsertJob Requested InsertJob for bay " + std::to_string(bay_id) +
                                     " but bay state is " + std::to_string(bay_opt->state));
  }

  std::tie(success, message) = PlanOpenBayDoor(ctx, bay_opt.value(), job_index);
  if(!success) {
    return std::make_pair(false, message);
  }

  // Move tray, which does not yet have a destination open parking space.
  // After PlanInsertJob() returns, DoTrayAssignments() will
  // call ResolveBlockingTrays() to find a destination.
  std::tie(success, message) = PlanReparkTrayJob(ctx, tray_opt->id, job_index, true);
  if(!success) {
    return std::make_pair(false, message);
  }

  // It is possible that this InsertJob WAS the last empty tray, which WAS in the bay.
  // At this point, attempt to put the bay back into Insert mode, which needs to
  // find another empty tray. If there are no more empty trays in the garage, the bay
  // can not do another insert.  This InsertJob is not a failure, even if the bay
  // transition to insert fails.  So consider don't connect a failing tray move in
  // the schedule DAG dependency or the InsertJob would also be a failure.  Instead,
  // dispatcher sends a RebalanceGarageJob, which will take care of the bay transition back
  // to insert mode. Also dont fail this InsertJob because of AGVs conflicting while
  // cleaning the garage. It could be like a race condition.
  // Hence, CleanGarageJob can be deferred until after all inserts and retrieves are completed.
  // RebalanceGarageJob might not be deferred, especially if the bay_readiness_ratio is changing,
  // or if the dispatch queue is full of all retrieves, or full of all inserts.

  // Deferred rebalance just this one bay with a new job id.
  // So the bay does not get stuck in a retrieval state.
  if(reset_bay_state_request_fn_) {
    // Publish a message to dispatch, to enqueue a ResetBayJob.
    reset_bay_state_request_fn_(bay_id, BayReportMsg::STATE_READY_TO_INSERT);
  }

  return std::make_pair(true, "");
}

BoolStringPair Scheduler::PlanReadyForInsertJob(
    ScheduleContextSPtr ctx, uint16_t bay_id, size_t job_index) const {
  auto working_state = ctx->initial_state;
  auto [success, message] = ctx->events.Apply(working_state);
  if(!success) {
    return std::make_pair(false, "Failed to apply event dag: " + message);
  }

  auto bay_opt = working_state.GetBay(bay_id);

  if(!bay_opt) {
    return std::make_pair(false, "Requested unknown " + std::to_string(volley::BayId(bay_id)) +
                                     " to ready for insert but bay does not exist in discrete state");
  }

  if(bay_opt->state != BayReportMsg::STATE_READY_TO_RETRIEVE) {
    return std::make_pair(false, "Requested to transition " + std::to_string(volley::BayId(bay_id)) +
                                     " to ready for insert but bay state is not READY_TO_RETRIEVE. State: " +
                                     std::to_string(bay_opt->state));
  }

  auto tray_in_bay_opt = working_state.GetTrayOnNode(bay_opt->id);
  GaragePoseMsg bay_pose = volley::ConstructGaragePose(
      bay_opt->id, static_cast<int16_t>(layout_->GetBayInboundHeading(bay_opt->id).value()));

  if(!tray_in_bay_opt) {
    // Find an empty tray to put in the bay
    auto [success, message] = PlanReparkTrayJob(ctx, std::nullopt, job_index, true, bay_pose);
    if(!success) {
      return std::make_pair(false, message);
    }
  }
  else if(tray_in_bay_opt->payload_id != volley::kEmptyGuid) {
    // figure out if we're parking a payload intended for EV charging
    auto payload_opt = working_state.GetPayload(tray_in_bay_opt->payload_id);
    if(payload_opt.has_value() && payload_opt.value().payload.ev_charge_requested) {
      std::tie(success, message) = PlanChargePayloadJob(ctx, tray_in_bay_opt->payload_id, job_index);
      if(!success) {
        return std::make_pair(false, "Failed to plan a charge payload job: " + message);
      }
    }

    // Find an empty tray to put in the bay
    std::tie(success, message) = PlanReparkTrayJob(ctx, std::nullopt, job_index, true, bay_pose);
    if(!success) {
      return std::make_pair(false, message);
    }
  }

  // Assign a tray to move into the bay. Re-derive from ctx->events rather than reusing
  // working_state, which predates the repark(s) just queued above.
  {
    volley::DiscreteGarageState fill_state = ctx->initial_state;
    auto [fill_apply_ok, fill_apply_msg] = ctx->events.Apply(fill_state);
    if(!fill_apply_ok) {
      return std::make_pair(false, "PlanReadyForInsertJob Failed to apply event: " + fill_apply_msg);
    }
    auto total_ordering_opt = ctx->events.GetTopologicalOrdering();
    if(!total_ordering_opt.has_value()) {
      return std::make_pair(false, "PlanReadyForInsertJob Failed to get a topological ordering of events");
    }
    for(const auto& event_vert : total_ordering_opt.value()) {
      auto event = ctx->events.GetEventFromVertex(event_vert).value();
      if(event->GetType() != volley::ScheduleEventType::TRAY_MOVE || event->GetJobIndex() != job_index) {
        continue;
      }
      auto* move = dynamic_cast<volley::TrayMove*>(event.get());
      if(move->GetTrayId() || !move->GetDest()) {
        continue;
      }
      auto [assign_success, assign_message] = AssignTrayIdForEmptyMove(*move, fill_state);
      if(!assign_success) {
        // Best-effort: leave it unassigned for DoTrayAssignments() to resolve later, once it can
        // see trays freed up by other jobs too.
        WARNS(logger_,
            "PlanReadyForInsertJob deferring tray assignment for a bay-fill move: " << assign_message);
        continue;
      }
      ctx->UpdateLastEntityEvent(move->GetGarageEntityId().value(), event);
      auto [apply_move_success, apply_move_message] = move->Apply(fill_state);
      if(!apply_move_success) {
        return std::make_pair(
            false, "PlanReadyForInsertJob failed to apply a resolved tray move: " + apply_move_message);
      }
    }
  }

  // Now we have an empty tray in the bay, transition the bay to READY_TO_INSERT
  BayCommandMsg cmd;
  cmd.command_type = BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT;
  cmd.command_id = std::to_string(volley::MakeGuid(0, 1u));
  auto bay_transition = std::make_shared<volley::BayTransition>(job_index, bay_opt.value(), cmd);
  ctx->events.AddEvent(bay_transition);
  ctx->UpdateLastEntityEvent(bay_transition->GetGarageEntityId().value(), bay_transition);
  LOG_DEBUG(logger_, "Transitioning {} to READY_TO_INSERT", std::to_string(volley::BayId(bay_opt->id)));
  ctx->UpdateLeafDependencies(bay_transition, job_index);

  return std::make_pair(true, "");
}

BoolStringPair Scheduler::PlanReadyForRetrieveJob(
    ScheduleContextSPtr ctx, uint16_t bay_id, size_t job_index) const {
  auto working_state = ctx->initial_state;
  auto [success, message] = ctx->events.Apply(working_state);
  if(!success) {
    return std::make_pair(false, "Failed to apply event dag: " + message);
  }

  auto bay_opt = working_state.GetBay(bay_id);

  // Make sure bay exists
  if(!bay_opt.has_value()) {
    return std::make_pair(false, "Requested unknown " + std::to_string(volley::BayId(bay_id)) +
                                     " to ready for retrieve but bay does not exist in discrete state");
  }

  // Right now we are constraining this job to only be planned if the bay is in Ready for
  // Insert/Retrieve This is maybe a bit silly
  if(bay_opt->state != BayReportMsg::STATE_READY_TO_INSERT &&
      bay_opt->state != BayReportMsg::STATE_READY_TO_RETRIEVE) {
    return std::make_pair(false, "Requested to transition " + std::to_string(volley::BayId(bay_id)) +
                                     " to ready for retrieve but bay state is not "
                                     "READY_TO_INSERT or READY_TO_RETRIEVE. State: " +
                                     std::to_string(bay_opt->state));
  }

  if(bay_opt->state == BayReportMsg::STATE_READY_TO_INSERT) {
    std::tie(success, message) = PlanOpenBayDoor(ctx, bay_opt.value(), job_index);
    if(!success) {
      return std::make_pair(false, message);
    }
  }

  // If there's no tray in the bay this will be std::nullopt
  auto tray_in_bay_opt = working_state.GetTrayOnNode(bay_opt->id);

  if(tray_in_bay_opt.has_value()) {
    // figure out if we're parking a payload intended for EV charging
    auto payload_opt = working_state.GetPayload(tray_in_bay_opt->payload_id);
    if(payload_opt.has_value() && payload_opt.value().payload.ev_charge_requested) {
      auto [success, message] = PlanChargePayloadJob(ctx, tray_in_bay_opt->payload_id, job_index);
      if(!success) {
        return std::make_pair(false, "Failed to plan a charge payload job: " + message);
      }
    }
    else {
      // Otherwise, clear out the tray if there's one in the bay
      auto [success, message] = PlanReparkTrayJob(ctx, tray_in_bay_opt->id, job_index, true);
      if(!success) {
        return std::make_pair(false, "Failed to clear tray from bay: " + message);
      }
    }
  }

  return std::make_pair(true, "");
}

BoolStringPair Scheduler::PlanCleanGarageJob(ScheduleContextSPtr ctx, size_t job_index) const {
  auto working_state = ctx->initial_state;
  auto [success, message] = ctx->events.Apply(working_state);
  if(!success) {
    return std::make_pair(false, "PlanCleanGarageJob Failed to apply event: " + message);
  }

  // Hide AGVs. Only hide if this is the first job in the sequence job_index == 0.
  // Always start with a clean garage.
  if(job_index == 0) {
    auto [hide_success, hide_assignments] = volley::HideAgvs(working_state, table_);
    if(!hide_success) {
      return std::make_pair(false, "Failed to assign AGVs to tray hiding spots");
    }

    for(auto [agv_id, dest] : hide_assignments) {
      auto agv_state = working_state.GetAgv(agv_id).value();

      if(agv_state.pose != dest) {
        AgvPoseChangedMsg pose_change;
        pose_change.agv_id = agv_id;
        pose_change.node_id_curr = agv_state.pose.node_id;
        pose_change.heading_curr = agv_state.pose.heading;
        pose_change.node_id_next = dest.node_id;
        pose_change.heading_next = dest.heading;

        auto agv_move = std::make_shared<volley::AgvMove>(job_index, pose_change);
        ctx->events.AddEvent(agv_move);
        ctx->UpdateLastEntityEvent(agv_move->GetGarageEntityId().value(), agv_move);
        // If we hid the AGV under a bay's tray, chain this move into that bay's own
        // entity too. To ensure any bay transition has a dependency on the AGV actually arriving.
        if(working_state.HasBay(dest.node_id)) {
          ctx->UpdateLastEntityEvent(volley::BayId(dest.node_id), agv_move);
        }
        agv_move->Apply(working_state);
      }
    }
  }

  // Repark any trays that were left sitting on TYPE_WAYPOINT nodes. Best-effort: failures are
  // logged and skipped so CLEAN_GARAGE never regresses on this path.
  auto [unstash_ok, unstash_msg] = PlanUnstashWaypointTraysJob(ctx, job_index);
  if(!unstash_ok) {
    WARNS(logger_, "PlanCleanGarageJob unstash step failed: " << unstash_msg);
  }

  return std::make_pair(true, "");
}

BoolStringPair Scheduler::PlanUnstashWaypointTraysJob(ScheduleContextSPtr ctx, size_t job_index) const {
  volley::DiscreteGarageState working_state = ctx->initial_state;
  auto [apply_ok, apply_msg] = ctx->events.Apply(working_state);
  if(!apply_ok) {
    return std::make_pair(false, "PlanUnstashWaypointTraysJob Failed to apply event: " + apply_msg);
  }

  // Snapshot first; PlanReparkTrayJob mutates ctx and we want a stable iteration set.
  std::vector<uint16_t> stashed_tray_ids;
  for(const auto& [tray_id, tray] : working_state.GetTrays()) {
    if(tray.disabled) {
      continue;
    }
    auto node_opt = layout_->GetNodeById(tray.pose.node_id);
    if(node_opt && node_opt->type == GarageNodeMsg::TYPE_WAYPOINT) {
      stashed_tray_ids.push_back(tray_id);
    }
  }

  if(stashed_tray_ids.empty()) {
    return std::make_pair(true, "");
  }
  LOG_DEBUG(
      logger_, "PlanUnstashWaypointTraysJob: {} waypoint-stashed trays to repark", stashed_tray_ids.size());

  for(uint16_t tray_id : stashed_tray_ids) {
    // dest=nullopt: DoTrayAssignments + ResolveBlockingTrays pick a destination. Their
    // tier-1 pass requires a TYPE_PARKING; tier-2 (waypoint) only fires when no parking
    // is reachable, which preserves the existing best-effort "leave it" semantic.
    auto [ok, msg] = PlanReparkTrayJob(ctx, tray_id, job_index, /*allow_recip=*/true);
    if(!ok) {
      WARNS(logger_, "PlanUnstashWaypointTraysJob: skipping stashed tray "
                         << std::to_string(volley::TrayId(tray_id)) << ": " << msg);
      continue;
    }
  }
  return std::make_pair(true, "");
}

// Rebalance is for the bay ratio, and bay insert/retrive readiness states. Unlike CleanGarageJob,
// rebalance assumes there is more work to do, so do not hide the AGVs under trays.
BoolStringPair Scheduler::PlanRebalanceGarageJob(ScheduleContextSPtr ctx, size_t job_index) const {
  auto working_state = ctx->initial_state;
  auto [success, message] = ctx->events.Apply(working_state);
  if(!success) {
    return std::make_pair(false, "PlanRebalanceGarageJob Failed to apply event: " + message);
  }

  // Determine bays to be transitioned to each state. These lists may be empty
  // if no bay balancing is necessary
  auto [transition_to_insert_bays, transition_to_retrieve_bays] =
      ComputeBayRebalancingActions(working_state, layout_->GetBayPrioritization(), bay_readiness_ratio_);

  for(auto bay_id : transition_to_insert_bays) {
    LOG_DEBUG(logger_, "Rebalancing {} to READY_TO_INSERT", std::to_string(volley::BayId(bay_id)));
    auto [success, message] = PlanReadyForInsertJob(ctx, bay_id, job_index);
    if(!success) {
      WARNS(logger_, "Failed to rebalance " << std::to_string(volley::BayId(bay_id))
                                            << " to READY_TO_INSERT: " << message);
      continue;
    }
  }
  for(auto bay_id : transition_to_retrieve_bays) {
    LOG_DEBUG(logger_, "Rebalancing {} to READY_TO_RETRIEVE", std::to_string(volley::BayId(bay_id)));
    auto [success, message] = PlanReadyForRetrieveJob(ctx, bay_id, job_index);
    if(!success) {
      WARNS(logger_, "Failed to rebalance " << std::to_string(volley::BayId(bay_id))
                                            << " to READY_TO_RETRIEVE: " << message);
      continue;
    }
  }

  // This is successful every time. There is no failure condition.
  return std::make_pair(true, "");
}

BoolStringPair Scheduler::PlanAgvChargeJob(ScheduleContextSPtr ctx, uint16_t agv_id, size_t job_index) const {
  auto working_state = ctx->initial_state;
  auto [success, message] = ctx->events.Apply(working_state);
  if(!success) {
    return std::make_pair(false, "Failed to apply event: " + message);
  }

  auto agv_opt = working_state.GetAgv(agv_id);
  if(!agv_opt.has_value()) {
    return std::make_pair(false, "Cannot plan Charge AGV job: " + std::to_string(volley::AgvId(agv_id)));
  }
  auto agv = agv_opt.value();

  // Don't even try to plan if it's disabled
  if(agv.disabled) {
    return std::make_pair(
        false, "Can't charge " + std::to_string(volley::AgvId(agv_id)) + " because it's disabled.");
  }

  // Do nothing if it's already on a charge node
  auto curr_node = layout_->GetNodeById(agv.pose.node_id).value();
  if(curr_node.type == GarageNodeMsg::TYPE_AGV_CHARGE &&
      agv.pose.heading == volley::GetInboundHeading(curr_node)) {
    return std::make_pair(true, "");
  }

  // AGV might be stuck in a bay
  std::optional<DiscreteBayStateMsg> trapping_bay_opt = std::nullopt;
  if(curr_node.type == GarageNodeMsg::TYPE_BAY) {
    auto bay_state = working_state.GetBay(curr_node.id)->state;
    if(bay_state == BayReportMsg::STATE_READY_TO_INSERT) {
      // Plan a bay transition to free the AGV to go charge. We assume that if we receive
      // a Charge job that the AGV should be freed bc it's battery is so low Command the
      // bay to transition to Ready for Retrieve
      BayCommandMsg cmd;
      cmd.command_type = BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE;
      cmd.command_id = std::to_string(volley::MakeGuid(0, 1u));
      auto bay_transition =
          std::make_shared<volley::BayTransition>(job_index, working_state.GetBay(curr_node.id).value(), cmd);
      ctx->events.AddEvent(bay_transition);
      bay_transition->Apply(working_state);
      ctx->UpdateLastEntityEvent(bay_transition->GetGarageEntityId().value(), bay_transition);
      trapping_bay_opt = working_state.GetBay(curr_node.id);
    }
    else if(bay_state != BayReportMsg::STATE_READY_TO_RETRIEVE) {
      return std::make_pair(false, "Error. Can't charge " + std::to_string(volley::AgvId(agv_id)) +
                                       " because it's stuck in " +
                                       std::to_string(volley::BayId(curr_node.id)) + " which is in state " +
                                       std::to_string(bay_state));
    }
  }

  // Pick the empty charge node we can get to the fastest
  // NOTE: By empty this is just checking if there's one on the node, not if the charge node is
  // actually collision free!
  const auto& charge_nodes = layout_->GetNodeIdsOfType(GarageNodeMsg::TYPE_AGV_CHARGE);
  std::optional<GaragePoseMsg> best_charger = std::nullopt;
  volley::Interval::Duration best_cost = volley::Interval::Duration::max();
  for(unsigned int charge_node_id : charge_nodes) {
    auto agv_on_node_opt = working_state.GetAgvOnNode(charge_node_id);
    if(agv_on_node_opt.has_value()) {
      continue;
    }
    auto node = layout_->GetNodeById(charge_node_id).value();
    auto charge_pose = volley::ConstructGaragePose(
        charge_node_id, static_cast<int16_t>(volley::Wrap(volley::GetInboundHeading(node))));

    auto dest_vert_opt = gg_.GetVertexFromPose(charge_pose);
    if(!dest_vert_opt) {
      ERRORS(logger_,
          "Something went very wrong trying to plan an AGV charge job"
          " for AGV "
              << agv_id << " to charge node " << charge_node_id << "@" << charge_pose.heading
              << " which doesn't exist in the graph");
      continue;
    }

    // Make sure it's enabled. NOTE this does not check if the charge node conflicts with
    // anything (an entity or disabled node)
    // TODO(any) do that
    if(!ctx->disabledness_filters[common::EnumInteger(volley::CollisionEntityId::AGV)].IsEnabled(
           dest_vert_opt.value())) {
      continue;
    }
    // Charge node is empty. Now estimate the cost to get there
    // Use static filters to make sure there is a valid path to the charge node
    auto filters = volley::GetStaticFilter(common::EnumInteger(volley::CollisionEntityId::AGV), gg_,
        working_state, table_, std::unordered_set<uint16_t>(), std::unordered_set<uint16_t>({agv_id}),
        std::unordered_set<uint16_t>());
    auto duration_opt =
        GetJustMovingCost(agv.pose, charge_pose, volley::AgvId(agv_id), agv.tray_id != 0, filters);
    // We know the interval has value because we already checked that the AGV is not on a
    // charge pose, so the trajectory can't be empty. But maybe the path didn't exist so
    // let's check the optional anyway. See MVP 454
    if(!duration_opt.has_value()) {
      continue;
    }
    auto duration = duration_opt.value();
    if(duration < best_cost) {
      best_cost = duration;
      best_charger = charge_pose;
    }
  }

  if(!best_charger.has_value()) {
    return std::make_pair(false, "Caution: No available charge nodes for " +
                                     std::to_string(volley::AgvId(agv_id)) +
                                     ". AGV state of charge is at risk. Discharge may be imminent.");
  }

  std::tie(success, message) = PlanAgvMoveJob(ctx, agv_id, best_charger.value(), false, job_index);

  INFOS(logger_, "Planned AGV " << agv_id << " to charge at " << std::to_string(best_charger.value()));

  // If we can't plan the move job (or there is no trapping bay) then end here
  if(!success || !trapping_bay_opt.has_value()) {
    return std::make_pair(success, message);
  }

  // Need to transition bay back to ready for insert
  auto trapping_bay = trapping_bay_opt.value();
  return PlanBayTransitionJob(
      ctx, trapping_bay.id, BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT, job_index);
}

BoolStringPair Scheduler::PlanBayTransitionJob(
    ScheduleContextSPtr ctx, uint16_t bay_id, uint8_t command_type, size_t job_index) const {
  auto working_state = ctx->initial_state;
  auto [success, message] = ctx->events.Apply(working_state);
  if(!success) {
    return std::make_pair(false, "Failed to apply event dag: " + message);
  }

  auto bay_opt = working_state.GetBay(bay_id);
  std::string bay_name = std::to_string(volley::BayId(bay_id));

  // For transitions to retrieve, we need to know the target floor
  uint8_t target_floor = 0;

  // Make sure bay exists
  if(!bay_opt.has_value()) {
    return std::make_pair(
        false, "Requested to transition " + bay_name + " but bay does not exist in discrete state.");
  }
  auto bay = bay_opt.value();

  // Cannot command a disabled bay
  if(bay.disabled) {
    return std::make_pair(false, "Requested to transition " + bay_name + " but it's disabled.");
  }

  auto bay_pose = volley::ConstructGaragePose(
      bay_id, static_cast<int16_t>(layout_->GetBayInboundHeading(bay_id).value()));
  auto filters = volley::GetStaticFilter(common::EnumInteger(volley::CollisionEntityId::BAY_ODP), gg_,
      working_state, table_, std::unordered_set<uint16_t>(), std::unordered_set<uint16_t>(),
      std::unordered_set<uint16_t>());
  if(!filters.IsEnabled(gg_.GetVertexFromPose(bay_pose).value())) {
    return std::make_pair(false, "Requested to transition " + bay_name + " but the ODP's area is occupied.");
  }

  // Note: maybe we could make this more flexible to allow process retrieve commands too.
  if(command_type == BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT) {
    if(bay.state != BayReportMsg::STATE_READY_TO_RETRIEVE) {
      return std::make_pair(
          false, "Can't transition " + bay_name +
                     " to Ready for Insert because it's not in Ready for Retrieve, state: " +
                     std::to_string(bay.state));
    }
  }
  else if(command_type == BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE) {
    // Pick a retrieve floor
    auto system_floors_opt = layout_->GetBaySystemFloors(bay_id);
    if(!system_floors_opt.has_value()) {
      return std::make_pair(false,
          "Requested to transition " + bay_name + " to READY_TO_RETRIEVE but it doesn't have a system floor");
    }

    auto system_floors = system_floors_opt.value();
    if(system_floors.size() == 0) {
      return std::make_pair(false, "Requested to transition " + bay_name +
                                       " to READY_TO_RETRIEVE but it doesn't have any system floors.");
    }

    // Pick the first floor for now
    target_floor = system_floors[0];

    if(bay.state != BayReportMsg::STATE_READY_TO_INSERT &&
        bay.state != BayReportMsg::STATE_VEHICLE_INSERTED) {
      return std::make_pair(false, "Can't transition " + bay_name +
                                       " to Ready for Retrieve because it's not in Ready for "
                                       "Insert or vehicle inserted, state: " +
                                       std::to_string(bay.state));
    }
  }
  else {
    return std::make_pair(
        false, "Invalid bay transition type for " + bay_name + " : " + std::to_string(command_type));
  }

  // Command the bay to transition
  BayCommandMsg cmd;
  cmd.command_type = command_type;
  cmd.command_id = std::to_string(volley::MakeGuid(0, 1u));
  // Floor is only used for ready to retrieve commands
  cmd.floor = target_floor;
  auto bay_transition = std::make_shared<volley::BayTransition>(job_index, bay_opt.value(), cmd);
  ctx->events.AddEvent(bay_transition);

  // Make sure this depends on the last event for this entity
  auto bay_entity_id = volley::BayId(bay_id);
  ctx->UpdateLastEntityEvent(bay_entity_id, bay_transition);
  ctx->UpdateLeafDependencies(bay_transition, job_index);

  return std::make_pair(true, "");
}

BoolStringPair Scheduler::PlanChargePayloadJob(
    ScheduleContextSPtr ctx, const GuidMsg& payload_id, size_t job_index) const {
  auto working_state = ctx->initial_state;
  auto [success, message] = ctx->events.Apply(working_state);
  if(!success) {
    return std::make_pair(false, "Failed to apply event dag: " + message);
  }

  auto payload_opt = working_state.GetPayload(payload_id);
  std::string payload_name = std::to_string(payload_id);

  // Make sure payload exists
  if(!payload_opt.has_value()) {
    return std::make_pair(
        false, "Requested to charge " + payload_name + " but payload does not exist in discrete state.");
  }
  auto payload = payload_opt.value();
  auto tray = working_state.GetTray(payload.tray_id).value();

  // If the payload is already on an EV Charge node with a VECS ready to go, then we don't
  // need to move the tray.
  auto node = layout_->GetNodeById(tray.pose.node_id).value();
  auto vecs_opt = working_state.GetVecs(tray.pose.node_id);
  uint16_t vecs_id = 0u;
  if(node.type == GarageNodeMsg::TYPE_EV_CHARGE && vecs_opt.has_value() &&
      vecs_opt->state == VecsReportMsg::READY_TO_CHARGE) {
    vecs_id = vecs_opt->id;
  }
  else {
    RCLCPP_INFO_STREAM(logger_, "PlanChargePayloadJob at a non-VECS node! Attempting a backup search...");

    // Using ResolveBlockingTrays() allows us to use OpenSpaceSearch and related infrastructure
    // to locate the best VECS node to use, including any unblocking tray moves
    auto [dest_garage_pose_opt, _] = ResolveBlockingTrays(tray.id, job_index, working_state);
    if(!dest_garage_pose_opt.has_value()) {
      return std::make_pair(false, "Unable to ResolveBlockingTrays to a VECS location");
    }
    auto dest_garage_pose = dest_garage_pose_opt.value();
    RCLCPP_WARN_STREAM(logger_, "ResolveBlockingTrays selected garage pose "
                                    << dest_garage_pose.node_id << "@" << dest_garage_pose.heading);

    auto vecs_opt = working_state.GetVecs(dest_garage_pose.node_id);
    if(!vecs_opt.has_value()) {
      return std::make_pair(false,
          "ResolveBlockingTrays was supposed to find a VECS node here, but "
          "returned a non-VECS one");
    }
    vecs_id = vecs_opt->id;

    UseEvChargeHeading(dest_garage_pose);
    std::tie(success, message) = PlanReparkTrayJob(ctx, tray.id, job_index, false, dest_garage_pose);
    if(!success) {
      return std::make_pair(false, message);
    }
  }

  // Now transition the VECS
  VecsStateChangedMsg state_change {};
  state_change.vecs_id = vecs_id;
  state_change.state_curr = VecsReportMsg::READY_TO_CHARGE;
  state_change.state_next = VecsReportMsg::CHARGING;
  auto vecs_transition = std::make_shared<volley::VecsTransition>(job_index, state_change);
  ctx->events.AddEvent(vecs_transition);

  // Make sure this depends on the last event for this entity
  auto vecs_entity_id = volley::VecsId(vecs_id);
  ctx->UpdateLastEntityEvent(vecs_entity_id, vecs_transition);
  ctx->UpdateLeafDependencies(vecs_transition, job_index);

  return std::make_pair(true, "");
}

void Scheduler::UsePreferredHeading(GaragePoseMsg& dest,
    const std::optional<DiscretePayloadStateMsg>& payload_opt,
    const std::optional<DiscreteTrayStateMsg>& tray_opt) const {
  (void)tray_opt;
  if(UseEvChargeHeading(dest)) {
    return;
  }
  UseRetrievalHeading(dest, payload_opt);
}

bool Scheduler::UseEvChargeHeading(GaragePoseMsg& dest) const {
  // For the company demo: handle the EV charging tray and parking spaces at Headquarters.
  // After review and team discussion, it was determined that there was not a better way to
  // code this specific behavior.  It was considered 'not any better' to do this with a
  // script or a config file.

  // Is this the headquarters garage layout?
  if(strstr(layout_->GetName().c_str(), "576_eccles")) {
    // Is this one of the EV charging parking spaces?
    if(dest.node_id == 47 || dest.node_id == 46) {
      // For EV charging, the special EV charging trays are directional not symetrical,
      // and these EV charging parking spaces are directional.
      // The parking heading is 0 just for these parking nodes.
      dest.heading = 0;
      INFOF(logger_,
          "  UsePreferredHeading  node %d is  E V   C H A R G I N G   S P A C E ,  parking heading is "
          "%d ",
          dest.node_id, dest.heading);
      return true;
    }
  }
  return false;
}

void Scheduler::UseRetrievalHeading(
    GaragePoseMsg& dest, const std::optional<DiscretePayloadStateMsg>& payload_opt) const {
  if(!payload_opt.has_value()) {
    return;
  }

  const auto retrieval_heading_or = gg_.GetRetrievalHeading(dest.node_id);
  if(!retrieval_heading_or.has_value()) {
    LOG_INFO(logger_, "UseRetrievalHeading, No retrieval heading for dest node {}. Could be a waypoint.",
        dest.node_id);
    return;
  }

  const int16_t heading = retrieval_heading_or.value();

  // Check if the node and heading are valid and feasible
  const auto node_opt = layout_->GetNodeById(dest.node_id);
  if(!node_opt.has_value()) {
    LOG_WARN(logger_, "UseRetrievalHeading, node ID {} is not in layout", dest.node_id);
    return;
  }

  bool possible = false;
  for(const int16_t potential_heading : node_opt.value().headings) {
    if(IsAngleOrReciprocal(heading, potential_heading)) {
      possible = true;
      break;
    }
  }
  if(!possible) {
    LOG_WARN(logger_, "UseRetrievalHeading, retrieval heading {} is not possible for node {}", heading,
        dest.node_id);
    return;
  }

  dest.heading = heading;

  LOG_INFO(logger_, "UseRetrievalHeading, Park dest node {} with optimal retrieval heading {}", dest.node_id,
      dest.heading);
  // Flip the angle if the payload angle is reciprocal to the tray angle
  if(payload_opt->reciprocal_to_tray) {
    dest.heading = ReciprocalAngle(dest.heading);
  }
}

std::optional<Scheduler::OpenSpaceSearchResult> Scheduler::FindOpenSpaceForRootTray(uint16_t tray_id,
    volley::CollisionEntityId_t collision_entity, const volley::DiscreteGarageState& working_state,
    const std::set<uint16_t>& immobile_trays, const std::unordered_set<uint16_t>& agvs,
    const VertexCollisionIdMap& illegal_poses, bool enforce_retrieval_heading,
    bool allow_waypoint_stash) const {
  auto tray_opt = working_state.GetTray(tray_id);
  volley::BlockingTrayState source;
  source.vert = gg_.GetVertexFromPose(tray_opt->pose).value();

  // Allow pathing through all trays except the immobile ones (root trays farther back in the
  // search that we explicitly don't want to move).
  std::unordered_set<uint16_t> trays;
  for(auto [id, _] : working_state.GetTrays()) {
    if(immobile_trays.find(id) == immobile_trays.end()) {
      trays.insert(id);
    }
  }

  auto filters = volley::GetStaticFilter(collision_entity, gg_, working_state, table_, trays, agvs, {});
  volley::OpenSpaceSearchEnvironment search_env(tray_id, collision_entity, gg_, table_, working_state,
      cost_model_, illegal_poses, filters, std::nullopt, enforce_retrieval_heading, allow_waypoint_stash);
  auto solution = volley::SingleSourceSearch(source, volley::Interval::Duration(0), search_env);

  if(!solution.GetTarget().has_value()) {
    return std::nullopt;
  }

  // Prevent blocking trays from parking on any intermediate node of the original tray's path.
  // Without this, a blocking tray can park on an intermediate path node, causing the outer
  // loop to route through that node again on the next iteration and cycle indefinitely. The
  // destination itself is intentionally not blocked: a blocking tray parking there triggers
  // the outer loop to assign the original tray to a different destination instead of cycling.
  OpenSpaceSearchResult result {solution.GetTarget().value(), illegal_poses};
  const auto original_tray_path = solution.GetPath(result.target);
  if(original_tray_path.has_value()) {
    for(const auto& [state, _] : original_tray_path.value()) {
      if(state.vert == result.target.vert) {
        continue;
      }
      result.blocking_tray_illegal_poses[state.vert] = collision_entity;
    }
  }
  return result;
}

std::optional<Scheduler::BlockingTrayResolution> Scheduler::TryFindBlockingTrayResolution(
    uint16_t blocking_tray_id, uint16_t root_tray_id, size_t job_index,
    const volley::DiscreteGarageState& working_state, const std::set<uint16_t>& immobile_trays,
    const std::unordered_set<uint16_t>& agvs, const VertexCollisionIdMap& blocking_tray_illegal_poses,
    bool enforce_retrieval_heading) const {
  auto blocking_tray_state = working_state.GetTray(blocking_tray_id).value();
  volley::CollisionEntityId_t blocking_collision_entity =
      volley::CollisionEntityIdFromTrayState(blocking_tray_state, working_state, *(gg_.GetLayout()));

  volley::BlockingTrayState tray_source;
  tray_source.vert = gg_.GetVertexFromPose(blocking_tray_state.pose).value();

  std::unordered_set<uint16_t> trays;
  for(auto [id, _] : working_state.GetTrays()) {
    if(immobile_trays.find(id) == immobile_trays.end()) {
      trays.insert(id);
    }
  }

  auto filters =
      volley::GetStaticFilter(blocking_collision_entity, gg_, working_state, table_, trays, agvs, {});

  // No max_blocking_trays cap: we may accept a target whose own move has further blocking trays
  // and resolve them recursively via ResolveBlockingTrays below.
  auto run_search = [&](bool allow_waypoint_stash) {
    volley::OpenSpaceSearchEnvironment env(blocking_tray_id, blocking_collision_entity, gg_, table_,
        working_state, cost_model_, blocking_tray_illegal_poses, filters, std::nullopt,
        enforce_retrieval_heading, allow_waypoint_stash);
    return volley::SingleSourceSearch(tray_source, volley::Interval::Duration(0), env);
  };

  auto tray_solution = run_search(/*allow_waypoint_stash=*/false);
  if(!tray_solution.GetTarget().has_value()) {
    // Tier-2: no parking is reachable for this blocking tray, so allow a TYPE_WAYPOINT
    // stash. The shuffle case (clear C so the root tray can pass) succeeds even if the
    // stashed tray remains at the waypoint at end-of-plan; a follow-up plan iteration
    // is responsible for reparking it back to a real parking node.
    INFOS(logger_, "No parking destination for blocking tray t"
                       << blocking_tray_id << "; retrying open-space search with waypoint stash.");
    tray_solution = run_search(/*allow_waypoint_stash=*/true);
  }

  if(!tray_solution.GetTarget().has_value()) {
    WARNS(logger_, "Failed to find open space for blocking tray t"
                       << blocking_tray_id << " while finding open space for t" << root_tray_id);
    return std::nullopt;
  }
  auto best = tray_solution.GetTarget().value();

  if(best.blocking_trays.empty()) {
    auto path_opt = tray_solution.GetPath(best);
    if(!path_opt.has_value()) {
      WARNS(logger_, "Found open space for blocking tray t"
                         << blocking_tray_id << " at "
                         << std::to_string(gg_.GetPoseFromVertex(best.vert).value())
                         << " but failed to get path while finding open space for t" << root_tray_id);
      return std::nullopt;
    }
    std::vector<GaragePoseMsg> blocking_tray_path;
    for(const auto& [state, _] : path_opt.value()) {
      blocking_tray_path.push_back(gg_.GetPoseFromVertex(state.vert).value());
    }
    return BlockingTrayResolution {.tray_id = blocking_tray_id,
        .dest = gg_.GetPoseFromVertex(best.vert).value(),
        .path = std::move(blocking_tray_path),
        .prereq_moves = {}};
  }

  // Recursive case: the blocking tray's best target has further blocking trays. Mark the root
  // tray immobile (so the recursion can't reuse it to break the deadlock) and resolve the
  // chain. The recursion returns a dest + the moves required to make it reachable; those
  // become prereq_moves on this resolution.
  auto immobile_trays_with_root = immobile_trays;
  immobile_trays_with_root.insert(root_tray_id);
  auto [recursive_dest, recursive_prereqs] = ResolveBlockingTrays(blocking_tray_id, job_index, working_state,
      immobile_trays_with_root, blocking_tray_illegal_poses, enforce_retrieval_heading);
  if(!recursive_dest.has_value()) {
    WARNS(logger_, "Failed to recursively resolve blocking trays for t"
                       << blocking_tray_id << " while finding open space for t" << root_tray_id);
    return std::nullopt;
  }
  return BlockingTrayResolution {.tray_id = blocking_tray_id,
      .dest = recursive_dest.value(),
      .path = {},
      .prereq_moves = std::move(recursive_prereqs)};
}

std::pair<std::optional<GaragePoseMsg>,
    std::vector<std::pair<std::shared_ptr<volley::TrayMove>, std::vector<GaragePoseMsg>>>>
Scheduler::ResolveBlockingTrays(uint16_t tray_id, size_t job_index,
    const volley::DiscreteGarageState& base_state, const std::set<uint16_t>& immobile_trays,
    const VertexCollisionIdMap& illegal_poses, bool enforce_retrieval_heading,
    bool allow_waypoint_stash) const {
  using volley::TrayMove;

  auto working_state = base_state;
  auto tray_opt = base_state.GetTray(tray_id);
  const volley::CollisionEntityId_t collision_entity =
      volley::CollisionEntityIdFromTrayState(tray_opt.value(), working_state, *(gg_.GetLayout()));

  std::optional<GaragePoseMsg> dest;
  std::vector<std::pair<std::shared_ptr<volley::TrayMove>, std::vector<GaragePoseMsg>>> required_moves;

  if(!immobile_trays.empty()) {
    INFOS(logger_, "Immobile trays:");
    for(uint16_t immobile_tray : immobile_trays) {
      auto tray_pose = working_state.GetTray(immobile_tray).value().pose;
      INFOS(logger_, "t" << immobile_tray << " at " << std::to_string(tray_pose));
    }
  }
  if(!illegal_poses.empty()) {
    INFOS(logger_, "Illegal poses:");
    for(auto illegal_pose : illegal_poses) {
      INFOS(logger_, std::to_string(gg_.GetPoseFromVertex(illegal_pose.first).value()));
    }
  }

  // TODO(Gunther): Should this be a DGS member?
  std::unordered_set<uint16_t> agvs;
  for(auto [agv_id, _] : working_state.GetAgvs()) {
    agvs.insert(agv_id);
  }

  // Resolve blocking trays sequentially in the order of fewest extra blocking moves required.
  // Find a minimal parking space, then iterate over each blocking tray and find its best
  // repark move, before re-running the OpenSpaceSearch for the original tray. This densifies
  // nicely instead of reparking blocking trays halfway across the garage when we could just
  // push them deeper and park in a good spot.
  while(!dest) {
    // TODO(Any): If the search has no target, we could rerun allowing parking on a node
    // containing another tray and resolve that tray's blockers in the same way as below.
    // This would handle some funky edge cases with different-sized payloads.
    auto search_result = FindOpenSpaceForRootTray(tray_id, collision_entity, working_state, immobile_trays,
        agvs, illegal_poses, enforce_retrieval_heading, /*allow_waypoint_stash=*/false);
    if(!search_result.has_value() && allow_waypoint_stash) {
      // Tier-2 fallback: no parking destination is reachable, so accept a temporary stash
      // at a TYPE_WAYPOINT node. The stashed tray will be reparked to a real parking node
      // in a subsequent plan iteration (atomic in-plan repark would serialize before the
      // root-tray move and degenerate into a no-op).
      INFOS(logger_,
          "No parking destination for t" << tray_id << "; retrying open-space search with waypoint stash.");
      search_result = FindOpenSpaceForRootTray(tray_id, collision_entity, working_state, immobile_trays, agvs,
          illegal_poses, /*enforce_retrieval_heading=*/false, /*allow_waypoint_stash=*/true);
    }
    if(!search_result.has_value()) {
      WARNS(logger_, "Failed to find open space for t" << tray_id << " in ResolveBlockingTrays");
      return std::make_pair(std::nullopt,
          std::vector<std::pair<std::shared_ptr<volley::TrayMove>, std::vector<GaragePoseMsg>>> {});
    }
    const auto& open_space_result = search_result->target;
    if(open_space_result.blocking_trays.empty()) {
      dest = gg_.GetPoseFromVertex(open_space_result.vert).value();
      continue;
    }
    INFOS(logger_, "Found open space for t"
                       << tray_id << " at "
                       << std::to_string(gg_.GetPoseFromVertex(open_space_result.vert).value()) << " with "
                       << open_space_result.blocking_trays.size() << " blocking trays");

    // Find the first blocking tray we can resolve. TryFindBlockingTrayResolution may either
    // return a direct (zero-further-blockers) solution OR a recursive solution that includes
    // prereq_moves; in the latter case we apply the prereqs in order before the blocking
    // tray's own move below.
    std::optional<BlockingTrayResolution> resolution_opt;
    for(const auto& blocking_tray_id : open_space_result.blocking_trays) {
      INFOS(logger_, "Finding open space for blocking tray t" << blocking_tray_id);
      resolution_opt = TryFindBlockingTrayResolution(blocking_tray_id, tray_id, job_index, working_state,
          immobile_trays, agvs, search_result->blocking_tray_illegal_poses, enforce_retrieval_heading);
      if(resolution_opt) {
        break;
      }
    }
    if(!resolution_opt.has_value()) {
      ERRORS(logger_, "Failed to find open space for any blocking trays of t" << tray_id);
      return std::make_pair(std::nullopt,
          std::vector<std::pair<std::shared_ptr<volley::TrayMove>, std::vector<GaragePoseMsg>>> {});
    }

    // Apply any prerequisite moves produced by recursive resolution, in order, before the
    // blocking tray's own move. These are no-ops in the non-recursive case.
    for(auto& [prereq_move, prereq_path] : resolution_opt->prereq_moves) {
      auto [prereq_ok, prereq_msg] = prereq_move->Apply(working_state);
      if(!prereq_ok) {
        ERRORS(logger_, "Failed to apply recursive prereq move for blocking tray: " << prereq_msg);
        return std::make_pair(std::nullopt,
            std::vector<std::pair<std::shared_ptr<volley::TrayMove>, std::vector<GaragePoseMsg>>> {});
      }
      required_moves.emplace_back(std::move(prereq_move), std::move(prereq_path));
    }

    INFOS(logger_, "Moving blocking tray t" << resolution_opt->tray_id << " to "
                                            << std::to_string(resolution_opt->dest));

    auto new_move = std::make_shared<TrayMove>(job_index);
    new_move->SetTrayId(resolution_opt->tray_id);
    // FIX: Does using UsePreferredHeading on the blocking-tray dest break the triple-pick
    // test in the nightly Release Workflow? If payloads and empty spaces are buried, AGVs
    // can't get to the rotation node. See system_drain_garage.py layout:=1355_fulton
    // n_agvs:=2 n_empty_parking_spots:=2 retrieve_nodes:=[1115,2013,2016].
    new_move->SetDest(resolution_opt->dest);

    auto [success, message] = new_move->Apply(working_state);
    if(!success) {
      ERRORS(logger_, "Failed to apply new move: " << message);
      return std::make_pair(std::nullopt,
          std::vector<std::pair<std::shared_ptr<volley::TrayMove>, std::vector<GaragePoseMsg>>> {});
    }
    required_moves.emplace_back(std::move(new_move), std::move(resolution_opt->path));
  }

  // The Tier-2 fallback may have landed `dest` on a TYPE_WAYPOINT. Returning it as the
  // tray's destination is intentional: the caller proceeds with the stash, the shuffle
  // succeeds, and the stashed tray will be reparked in a subsequent plan iteration. An
  // atomic repark within this call would be applied sequentially before the root tray's
  // main move, producing a no-op (stash + immediate repark to the now-vacated source),
  // so it is deliberately omitted here.
  if(dest) {
    auto dest_node_opt = layout_->GetNodeById(dest->node_id);
    if(dest_node_opt && dest_node_opt->type == GarageNodeMsg::TYPE_WAYPOINT) {
      INFOS(logger_, "Stashed t" << tray_id << " at waypoint " << std::to_string(dest.value())
                                 << " (no parking destination reachable).");
    }
  }
  return std::make_pair(std::move(dest), std::move(required_moves));
}

// TODO(Gunther): We still need to apply these to the freeing moves for lift transitions when
// they exist too -- which means we need a more generic pose and entity id interface for the
// base ScheduleEvent class.
BoolStringPair Scheduler::ApplyTransitionToFreeingMoves(const std::shared_ptr<volley::ScheduleEvent>& event,
    volley::DiscreteGarageState& working_state,
    volley::GarageOccupancyChecker<std::shared_ptr<volley::ScheduleEvent>>& freeing_moves) const {
  using volley::ScheduleEventType;

  // Using TRAY entity id ensures anything moving into / out of a bay or VECS after this
  // transition depends on the transition.
  const auto tray_entity = common::EnumInteger(volley::CollisionEntityId::TRAY);

  if(event->GetType() == ScheduleEventType::BAY_TRANSITION) {
    auto bay_transition = dynamic_cast<volley::BayTransition*>(event.get());
    auto bay_pose = volley::ConstructGaragePose(bay_transition->GetBayId(),
        static_cast<int16_t>(gg_.GetLayout()->GetBayInboundHeading(bay_transition->GetBayId()).value()));
    LOG_DEBUG(logger_, "Adding {} to freeing moves {}", std::to_string(bay_pose), event->ToString());
    freeing_moves.AddOccupant(bay_pose, tray_entity, event);
    auto [success, message] = bay_transition->Apply(working_state);
    if(!success) {
      return std::make_pair(false, "Failed to apply event in TrayAssignments: " + message);
    }
  }
  else if(event->GetType() == ScheduleEventType::VECS_TRANSITION) {
    auto vecs_transition = dynamic_cast<volley::VecsTransition*>(event.get());
    auto vecs_pose = volley::ConstructGaragePose(vecs_transition->GetVecsId(),
        static_cast<int16_t>(
            volley::GetInboundHeading(layout_->GetNodeById(vecs_transition->GetVecsId()).value())));
    LOG_DEBUG(logger_, "Adding {} to freeing moves {}", std::to_string(vecs_pose), event->ToString());
    freeing_moves.AddOccupant(vecs_pose, tray_entity, event);
    auto [success, message] = vecs_transition->Apply(working_state);
    if(!success) {
      return std::make_pair(false, "Failed to apply event in TrayAssignments: " + message);
    }
  }
  return std::make_pair(true, "");
}

BoolStringPair Scheduler::AssignTrayIdForEmptyMove(
    volley::TrayMove& move, const volley::DiscreteGarageState& working_state) const {
  if(!move.GetDest()) {
    return std::make_pair(false, "Can't resolve a tray move with no tray id or dest");
  }
  auto source_vert_opt = gg_.GetVertexFromPose(move.GetDest().value());
  if(!source_vert_opt) {
    return std::make_pair(false, "Tray pose does not exist in garage graph");
  }
  // BFS from DestPose looking for an empty tray. Basically the inverse OpenSpaceSearch.
  // TODO(Any): Eventually make this selection based on also the critical path of all future
  // moves, so that we can select a tray that will be a future blocking tray anyway.
  volley::BlockingTrayState source;
  source.vert = source_vert_opt.value();
  INFOS(logger_, "Finding empty tray for move to " << std::to_string(move.GetDest().value()));

  std::unordered_set<uint16_t> trays;
  for(auto [id, _] : working_state.GetTrays()) {
    trays.insert(id);
  }
  std::unordered_set<uint16_t> agvs;
  for(auto [id, _] : working_state.GetAgvs()) {
    agvs.insert(id);
  }
  auto filters = volley::GetStaticFilter(
      common::EnumInteger(volley::CollisionEntityId::TRAY), gg_, working_state, table_, trays, agvs, {});

  volley::EmptyTraySearchEnvironment empty_search_env(gg_, table_, working_state, cost_model_, filters);
  auto solution = volley::SingleSourceSearch(source, volley::Interval::Duration(0), empty_search_env);

  if(!solution.GetTarget().has_value()) {
    return std::make_pair(
        false, "Failed to find empty tray to move to " + std::to_string(move.GetDest().value()));
  }

  auto tray_to_use =
      working_state.GetTrayOnNode(gg_.GetPoseFromVertex(solution.GetTarget().value().vert)->node_id).value();

  // Right now we continue (in the caller) to resolve the blocking trays, although we already
  // know which they are and the critical path, so we're redoing a tiny bit of work at the
  // moment. Leaving that as a future optimization.
  move.SetTrayId(tray_to_use.id);

  // If the empty tray heading is the same or reciprocal to the dest heading, prefer the tray's
  // heading to reduce irrelevant rotations and AGV motions.
  auto dst_opt = move.GetDest();
  if(dst_opt && volley::IsAngleOrReciprocal(tray_to_use.pose.heading, dst_opt.value().heading)) {
    auto node_opt = layout_->GetNodeById(dst_opt->node_id);
    if(node_opt) {
      GaragePoseMsg dstpose = dst_opt.value();
      if(tray_to_use.pose.heading != dstpose.heading) {
        dstpose.heading = tray_to_use.pose.heading;
        // Except if this is EV charging.
        UseEvChargeHeading(dstpose);
        INFOF(logger_, "Scheduler::DoTrayAssignments found empty tray %d, using tray heading %d",
            tray_to_use.id, tray_to_use.pose.heading);
        move.SetDest(dstpose);
      }
    }
  }
  return std::make_pair(true, "");
}

BoolStringPair Scheduler::AssignDestForUntargetedMove(volley::TrayMove* move, ScheduleContextSPtr ctx,
    const std::shared_ptr<volley::ScheduleEvent>& event, volley::DiscreteGarageState& working_state,
    volley::GarageOccupancyChecker<std::shared_ptr<volley::ScheduleEvent>>& freeing_moves,
    std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>>& last_tray_event) const {
  if(!move->GetTrayId()) {
    return std::make_pair(false, "Can't resolve a tray move with no tray id or dest");
  }
  auto tray_opt = working_state.GetTray(move->GetTrayId().value());
  if(!tray_opt) {
    return std::make_pair(false, std::string("DoTrayAssignments TrayMove with TrayId=") +
                                     std::to_string(move->GetTrayId().value()) +
                                     std::string("does not exist in working_state"));
  }
  auto payload_opt = working_state.GetPayload(tray_opt->payload_id);
  const bool enforce_retrieval_heading = payload_opt.has_value();
  auto [dest, required_moves] = ResolveBlockingTrays(
      move->GetTrayId().value(), move->GetJobIndex(), working_state, {}, {}, enforce_retrieval_heading);

  if(!dest) {
    return std::make_pair(
        false, "Failed to find open space for t" + std::to_string(move->GetTrayId().value()));
  }

  // Optimal retrieval heading is not used for VECS or bays.
  if(!working_state.GetVecs(dest->node_id) && !working_state.GetBay(dest->node_id)) {
    std::optional<GarageNodeMsg> node_opt = layout_->GetNodeById(dest->node_id);
    if(node_opt && node_opt->type == GarageNodeMsg::TYPE_PARKING) {
      if(!payload_opt.has_value()) {
        // Tray orientation doesn't matter if there is no payload.
        if(volley::IsAngleOrReciprocal(tray_opt->pose.heading, dest->heading)) {
          dest->heading = tray_opt->pose.heading;
        }
      }
      else {
        // Retrieval heading already set by ResolveBlockingTrays. UsePreferredHeading is a
        // no-op for retrieval heading but handles the EV charge special case.
        GaragePoseMsg dst = dest.value();
        UsePreferredHeading(dst, payload_opt, tray_opt);
        dest = dst;
      }
    }
  }
  UseEvChargeHeading(dest.value());
  move->SetDest(dest.value());

  std::shared_ptr<volley::TrayMove> last_move;
  for(auto& [new_move, new_move_path] : required_moves) {
    auto source_pose = working_state.GetTray(new_move->GetTrayId().value())->pose;
    auto [apply_success, apply_message] = new_move->Apply(working_state);
    if(!apply_success) {
      return std::make_pair(false, "Failed to apply unblocking move required: " + apply_message);
    }
    ctx->events.AddEvent(new_move);
    if(last_move) {
      ctx->events.AddDependency(last_move, new_move);
    }
    {
      const auto new_move_tray_id = new_move->GetTrayId().value();
      if(last_tray_event.find(new_move_tray_id) != last_tray_event.end()) {
        ctx->events.AddDependency(last_tray_event[new_move_tray_id], new_move);
      }
      else {
        ctx->first_tray_event[new_move_tray_id] = new_move;
      }
      last_move = new_move;
      last_tray_event[new_move_tray_id] = new_move;
    }

    // Add dependencies on any moves in the path -- this feels heavy handed but we need to
    // ensure that 2 moves in the same parking column end up with the right dependencies
    // without adding extra dependencies if there are 2 blocking trays across the garage from
    // one another. We also need to ensure we have a dependency on the source move, because
    // the bay transition will have been applied to the source pose and that dependency must
    // be preserved if the blocking tray is within a bay.
    for(auto& pose : new_move_path) {
      const auto entity_id = volley::CollisionEntityIdFromTrayState(
          working_state.GetTray(new_move->GetTrayId().value()).value(), working_state, *(gg_.GetLayout()));
      auto blockers_opt = freeing_moves.GetBlockers(pose, entity_id);
      if(blockers_opt) {
        for(auto& blocker : blockers_opt.value()) {
          if(blocker == new_move) {
            continue;
          }
          auto added = ctx->events.AddDependency(blocker, new_move);
          LOG_DEBUG_IF(logger_, added, "Adding dependency on move to {} on move to {}", new_move->ToString(),
              blocker->ToString());
        }
      }
      freeing_moves.AddOccupant(pose, entity_id, new_move, true);
    }

    LOG_DEBUG(logger_, "Adding {} to freeing moves {}", std::to_string(source_pose), new_move->ToString());
    freeing_moves.AddOccupant(source_pose,
        volley::CollisionEntityIdFromTrayState(
            working_state.GetTray(new_move->GetTrayId().value()).value(), working_state, *(gg_.GetLayout())),
        new_move, true);
  }

  auto [success, message] = move->Apply(working_state);
  if(!success) {
    return std::make_pair(false, message);
  }
  if(last_move) {
    ctx->events.AddDependency(last_move, event);
  }
  {
    const auto move_tray_id = move->GetTrayId().value();
    if(last_tray_event.find(move_tray_id) != last_tray_event.end()) {
      ctx->events.AddDependency(last_tray_event[move_tray_id], event);
    }
    else {
      ctx->first_tray_event[move_tray_id] = event;
    }
    last_tray_event[move_tray_id] = event;
  }
  return std::make_pair(true, "");
}

BoolStringPair Scheduler::AppendAgvLiftEvent(uint16_t agv_id, bool raised, size_t job_index,
    ScheduleContextSPtr ctx, volley::DiscreteGarageState& working_state,
    std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>>& last_agv_event,
    volley::Interval::Duration& event_cost) const {
  AgvLiftChangedMsg lift_change;
  lift_change.agv_id = agv_id;
  lift_change.raised = raised;
  auto lift_event = std::make_shared<volley::AgvMove>(job_index, lift_change);
  ctx->events.AddEvent(lift_event);
  if(last_agv_event.find(agv_id) != last_agv_event.end()) {
    ctx->events.AddDependency(last_agv_event[agv_id], lift_event);
  }
  last_agv_event[agv_id] = lift_event;

  const auto lift_seconds =
      raised ? cost_model_.Params().events.agv_lift_up : cost_model_.Params().events.agv_lift_down;
  event_cost += std::chrono::duration_cast<volley::Interval::Duration>(volley::cost::SecondsF(lift_seconds));

  auto [success, message] = lift_event->Apply(working_state);
  if(!success) {
    const std::string verb = raised ? "lifting" : "lowering";
    std::string msg =
        "Failed to apply " + lift_event->ToString() + " while AGV " + verb + " Tray: " + message;
    ERRORS(logger_, msg);
    return std::make_pair(false, "AGV Assignment failure: " + msg);
  }
  return std::make_pair(true, "");
}

void Scheduler::PropagateEventCostToChildren(const std::shared_ptr<volley::ScheduleEvent>& root_event,
    volley::Interval::Duration event_cost, ScheduleContextSPtr ctx,
    std::unordered_map<std::shared_ptr<volley::ScheduleEvent>, volley::Interval::Duration>&
        event_occupied_durations) const {
  auto root_event_vertex = ctx->events.GetVertex(root_event);
  if(!root_event_vertex.has_value()) {
    throw std::runtime_error("Failed to get AGV vertex in DAG");
  }
  auto out_edges = boost::make_iterator_range(ctx->events.GetOutEdges(root_event_vertex.value()));
  if(event_occupied_durations.find(root_event) == event_occupied_durations.end()) {
    event_occupied_durations[root_event] = volley::Interval::Duration::zero();
  }
  const auto event_dep_cost = event_cost + event_occupied_durations[root_event];
  for(const auto& edge : out_edges) {
    auto child_vertex = ctx->events.GetTargetVertex(edge);
    auto next_event = ctx->events.GetFromVertex(child_vertex);
    auto next_event_cost = event_occupied_durations[next_event.value()];
    if(next_event_cost < event_dep_cost) {
      event_occupied_durations[next_event.value()] = event_dep_cost;
    }
  }
}

BoolStringPair Scheduler::AddNodeArrivalDeps(uint32_t dest_node_id, uint16_t arriving_agv_id,
    const std::shared_ptr<volley::ScheduleEvent>& new_event, ScheduleContextSPtr ctx,
    std::unordered_map<uint32_t, uint16_t>& current_node_occupant,
    const std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>>& last_agv_event) const {
  auto it = current_node_occupant.find(dest_node_id);
  if(it != current_node_occupant.end() && it->second != arriving_agv_id) {
    auto prev_event_it = last_agv_event.find(it->second);
    if(prev_event_it == last_agv_event.end()) {
      // Prev occupant has no scheduled events at all. There is no event to gate this
      // arrival on; emitting it anyway would produce a plan the dispatcher rejects with
      // "a<arriving>'s destination pose is on the same node as a<prev>". Fail loudly here
      // so the caller can pick a different AGV or relocate the idle occupant first.
      return std::make_pair(false, "a" + std::to_string(arriving_agv_id) + " cannot arrive at node " +
                                       std::to_string(dest_node_id) + ": a" + std::to_string(it->second) +
                                       " is idle there with no scheduled departure");
    }
    ctx->events.AddDependency(prev_event_it->second, new_event);
  }
  current_node_occupant[dest_node_id] = arriving_agv_id;
  return std::make_pair(true, "");
}

BoolStringPair Scheduler::MoveAgvToTrayPose(uint16_t agv_id, const DiscreteAgvStateMsg& agv,
    const DiscreteTrayStateMsg& tray, const std::shared_ptr<volley::ScheduleEvent>& root_event,
    const volley::DagBase<uint16_t>& agv_event_dag, ScheduleContextSPtr ctx,
    volley::DiscreteGarageState& working_state,
    std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>>& last_agv_event,
    std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>>& last_move_to_tray_event,
    std::unordered_map<uint32_t, uint16_t>& current_node_occupant,
    volley::Interval::Duration& event_cost) const {
  AgvPoseChangedMsg pose_change;
  pose_change.agv_id = agv_id;
  pose_change.node_id_curr = agv.pose.node_id;
  pose_change.heading_curr = agv.pose.heading;
  pose_change.node_id_next = tray.pose.node_id;
  pose_change.heading_next =
      volley::IsAngleOrReciprocal(agv.pose.heading, tray.pose.heading) ? agv.pose.heading : tray.pose.heading;

  auto move_to_tray = std::make_shared<volley::AgvMove>(root_event->GetJobIndex(), pose_change);

  ctx->events.AddEvent(move_to_tray);  // adds it to the real DAG, not the local copy
  if(last_agv_event.find(agv_id) != last_agv_event.end()) {
    ctx->events.AddDependency(last_agv_event[agv_id], move_to_tray);
  }

  // Get the parent of the AGV vertex in the local agv_event_dag and mirror its prior
  // move-to-tray events as deps on this move (so cross-AGV ordering is preserved).
  auto verts_iter = agv_event_dag.GetVertices();
  std::optional<decltype(verts_iter.first)> agv_vertex;
  for(auto vert = verts_iter.first; vert != verts_iter.second; ++vert) {
    if(agv_event_dag.GetFromVertex(*vert) && *agv_event_dag.GetFromVertex(*vert).value() == agv_id) {
      agv_vertex = vert;
      break;
    }
  }
  if(!agv_vertex.has_value()) {
    throw std::runtime_error("Failed to find AGV vertex in DAG");
  }
  if(agv_vertex.value() != verts_iter.second) {
    auto in_edges = boost::make_iterator_range(agv_event_dag.GetInEdges(*agv_vertex.value()));
    for(const auto& edge : in_edges) {
      auto parent_vertex = agv_event_dag.GetSourceVertex(edge);
      auto parent_agv_id = *agv_event_dag.GetFromVertex(parent_vertex).value();
      if(last_move_to_tray_event.find(parent_agv_id) != last_move_to_tray_event.end()) {
        ctx->events.AddDependency(last_move_to_tray_event[parent_agv_id], move_to_tray);
      }
    }
  }

  {
    const auto [arrival_ok, arrival_msg] = AddNodeArrivalDeps(
        tray.pose.node_id, agv_id, move_to_tray, ctx, current_node_occupant, last_agv_event);
    if(!arrival_ok) {
      return std::make_pair(false, "MoveAgvToTrayPose: " + arrival_msg);
    }
  }

  // Add dependencies on any tray that occupies an intermediate node on the AGV's
  // navigation path. Without this, the scheduler can sequence move_to_tray to traverse
  // a node before the tray blocking it has been moved out — and SanityCheckEvents will
  // then reject the plan with "Cannot find path from <src> to <dst>". Ported from
  // jra/SW2-106-recursively-unblock-trays (PR #668, commit 71e60a4d).
  {
    auto nav_path = volley::GetPosePath(gg_, agv.pose, tray.pose, cost_model_);
    for(size_t path_i = 1; path_i < nav_path.size(); ++path_i) {
      const uint16_t path_node = nav_path[path_i].node_id;
      // Skip poses at the destination node — the tray being picked up lives there, and
      // rotation steps around it can appear as penultimate poses too.
      if(path_node == tray.pose.node_id) {
        continue;
      }
      for(const auto& [blocker_tray_id, blocker_tray] : ctx->initial_state.GetTrays()) {
        if(blocker_tray.pose.node_id != path_node) {
          continue;
        }
        auto it = ctx->first_tray_event.find(blocker_tray_id);
        if(it == ctx->first_tray_event.end()) {
          break;
        }
        // Adding (first_event -> move_to_tray) would create a cycle if the task-chain
        // edges (move_to_tray -> ... -> root_event) already imply root_event reaches
        // first_event in the DAG. move_to_tray has no descendants yet at this point, so
        // BFS from root_event (which move_to_tray transitively reaches via task-chain
        // edges added later) to detect that case.
        if(!ctx->events.WouldCreateCycle(it->second, root_event)) {
          ctx->events.AddDependency(it->second, move_to_tray);
        }
        break;
      }
    }
  }

  // Cross-floor / chokepoint AGV pathing (one AGV asked to drive through a node another AGV's body
  // still occupies) is handled by EnsureAgvMovePathsClear after all assignments are made. An
  // earlier attempt to gate that here proactively used current_node_occupant + last_agv_event,
  // but current_node_occupant reflects DoAgvAssignments' serial assignment order — which diverges
  // from the final topological order SanityCheckEvents replays — and is never cleared on
  // departure, so it both missed real blockers and added spurious cross-AGV edges. The post-pass
  // repair reasons on the actual topological order instead, where AGV occupancy is exact.

  last_move_to_tray_event[agv_id] = move_to_tray;
  last_agv_event[agv_id] = move_to_tray;

  auto move_to_tray_cost_opt =
      GetJustMovingCost(agv.pose, tray.pose, volley::AgvId(agv_id), agv.tray_id != 0);
  if(!move_to_tray_cost_opt.has_value()) {
    return std::make_pair(false, "assigned event cost is infeasible");
  }
  event_cost += move_to_tray_cost_opt.value();

  auto [success, message] = move_to_tray->Apply(working_state);
  if(!success) {
    std::string msg = "AGV Assignments post matching: Failed to apply " + move_to_tray->ToString() +
                      " while moving assigned AGV to Tray: " + message;
    ERRORS(logger_, msg);
    return std::make_pair(false, "AGV Assignment failure: " + msg);
  }
  return std::make_pair(true, "");
}

// NOLINTNEXTLINE(google-readability-function-size)
BoolStringPair Scheduler::DoTrayAssignments(ScheduleContextSPtr ctx) const {
  using volley::Interval;
  using volley::ScheduleEventType;
  using volley::TrayMove;

  auto working_state = ctx->initial_state;

  auto total_ordering_opt = ctx->events.GetTopologicalOrdering();

  if(!total_ordering_opt.has_value()) {
    return std::make_pair(false, "Failed to get total ordering");
  }

  std::vector<std::shared_ptr<volley::ScheduleEvent>> assigned_events;

  INFOS(logger_, "Base events:");
  for(const auto& event_vert : total_ordering_opt.value()) {
    auto event = ctx->events.GetEventFromVertex(event_vert).value();
    INFOS(logger_, "\t" << std::to_string(*event));
  }

  std::unordered_map<uint16_t, std::shared_ptr<volley::ScheduleEvent>> last_tray_event;

  // Keeps track of, for each pose and entity, which tray move frees up that spot
  // this is used to add the edges between cycle and non-cycle tray moves that don't
  // have any other explicit dependencies but does move into a space that was freed
  // by an earlier move. -- Need to check the entire path and not just the end poses
  volley::GarageOccupancyChecker<std::shared_ptr<volley::ScheduleEvent>> freeing_moves(table_, gg_);

  for(const auto& event_vert : total_ordering_opt.value()) {
    auto event = ctx->events.GetEventFromVertex(event_vert).value();
    if(event->GetType() != ScheduleEventType::TRAY_MOVE) {
      auto [success, message] = ApplyTransitionToFreeingMoves(event, working_state, freeing_moves);
      if(!success) {
        return std::make_pair(false, message);
      }
      continue;
    }

    auto move = dynamic_cast<volley::TrayMove*>(event.get());
    // Move any empty tray to a location
    if(!move->GetTrayId()) {
      auto [success, message] = AssignTrayIdForEmptyMove(*move, working_state);
      if(!success) {
        return std::make_pair(false, message);
      }
    }

    // Move specific tray anywhere
    if(!move->GetDest()) {
      auto [success, message] =
          AssignDestForUntargetedMove(move, ctx, event, working_state, freeing_moves, last_tray_event);
      if(!success) {
        return std::make_pair(false, message);
      }
      continue;
    }

    // This is the main blocking tray resolution loop.
    // First we find the critical path for the tray to its destination, then we find the
    // blocking trays along that path. We then attempt to resolve all blocking trays without
    // parking along the critical path or moving the root tray. If that fails, we attempt to
    // advance the root tray along its critical path until a waypoint or blocking tray is
    // reached, then try resolution again. If that doesn't work then instead allow parking
    // on the critical path after advancing the root tray so that we can fully resolve the
    // cycle cases.
    //
    // If we're forced to park on the critical path, then we need to continue the loop,
    // otherwise if we can't solve all blocking trays, then we fail to plan.

    uint16_t tray_id = move->GetTrayId().value();
    auto tray_opt = working_state.GetTray(tray_id);

    // Make sure that destination is free.
    // Note: we ignore all AGVs in this check because they will get moved around to carry
    // trays anyways. This does NOT ignore disabled AGVs. Note: we ignore all trays in this
    // check because if they block the destination they will get moved during tray
    // unblocking. This does NOT ignore disabled trays. We use TRAY entity ID so that this
    // checks against Bays and any other objects we may eventually add
    volley::CollisionEntityId_t tray_entity_id = common::EnumInteger(volley::CollisionEntityId::TRAY);
    std::unordered_set<uint16_t> agvs;
    for(auto [agv_id, _] : working_state.GetAgvs()) {
      agvs.insert(agv_id);
    }

    std::unordered_set<uint16_t> trays;
    for(auto [id, _] : working_state.GetTrays()) {
      trays.insert(id);
    }
    auto filters = volley::GetStaticFilter(
        tray_entity_id, gg_, working_state, table_, trays, agvs, std::unordered_set<uint16_t>());
    {
      auto garagepose = move->GetDest().value();
      auto vertex_opt = gg_.GetVertexFromPose(garagepose);
      if(vertex_opt) {
        if(!filters.IsEnabled(vertex_opt.value())) {
          return std::make_pair(false, "Requested to move tray to " +
                                           std::to_string(move->GetDest().value()) +
                                           " but it's occupied, or not enabled.");
        }
      }
      else {
        garagepose.heading = volley::ReciprocalAngle(garagepose.heading);
        auto vertex_opt = gg_.GetVertexFromPose(garagepose);
        if(vertex_opt) {
          if(!filters.IsEnabled(vertex_opt.value())) {
            return std::make_pair(false, "Requested to move tray " + std::to_string(tray_id) + " to " +
                                             std::to_string(move->GetDest().value()) +
                                             " but it's occupied, or not enabled.");
          }
        }
        else {
          return std::make_pair(
              false, "Requested to move tray to " + std::to_string(move->GetDest().value()) +
                         " but could not get a valid vertex from the pose " + std::to_string(garagepose));
        }
      }
    }

    INFOS(logger_, "Finding blocking trays for moving t" << move->GetTrayId().value() << " from "
                                                         << std::to_string(tray_opt->pose) << " to "
                                                         << std::to_string(move->GetDest().value()));

    const volley::CollisionEntityId_t root_collision_entity =
        volley::CollisionEntityIdFromTrayState(tray_opt.value(), working_state, *(gg_.GetLayout()));
    volley::BlockingTrayState source;
    source.vert = gg_.GetVertexFromPose(tray_opt->pose).value();
    volley::BlockingTraySearchEnvironment blocking_search_env(move->GetTrayId().value(),
        root_collision_entity, gg_, table_, working_state, cost_model_,
        gg_.GetVertexFromPose(move->GetDest().value()).value(), filters);
    auto blocking_solution =
        volley::SingleSourceSearch(source, volley::Interval::Duration(0), blocking_search_env);

    if(!blocking_solution.GetTarget().has_value()) {
      return std::make_pair(false, "Failed to find path for t" + std::to_string(move->GetTrayId().value()) +
                                       " from " + std::to_string(tray_opt->pose) + " to " +
                                       std::to_string(move->GetDest().value()));
    }

    // This is our critical path, don't allow blocking trays to be reparked on it
    auto result = blocking_solution.GetTarget().value();
    auto path = blocking_solution.GetPath(result).value();
    auto root_tray_it = path.begin();

    std::vector<uint16_t> blocking_trays;
    std::set<uint16_t> blocking_tray_set;

    VertexCollisionIdMap critical_path;

    // Destinations already assigned to a given blocking tray within this root-tray resolution
    // pass (across all outer-loop iterations below). Without this, two candidate spots can
    // alternately look "open" as each other's occupant gets moved out, shuffling the same tray
    // back and forth between them forever instead of making progress.
    std::unordered_map<uint16_t, VertexCollisionIdMap> blocking_tray_prior_dests;
    auto WithPriorDests = [&blocking_tray_prior_dests](uint16_t for_tray, VertexCollisionIdMap base) {
      auto it = blocking_tray_prior_dests.find(for_tray);
      if(it != blocking_tray_prior_dests.end()) {
        for(const auto& [vert, id] : it->second) {
          base.insert({vert, id});
        }
      }
      return base;
    };

    INFOS(logger_, "Critical path:");
    for(const auto& [path_state, _] : path) {
      INFOS(logger_, "\t" << std::to_string(gg_.GetPoseFromVertex(path_state.vert).value()));

      // call CollisionEntityIdFromTrayState() here?
      // only if needs to be called per path_state.vert of the blocking_solution path.
      critical_path[path_state.vert] = root_collision_entity;

      for(auto blocking_tray_id : path_state.blocking_trays) {
        if(blocking_tray_set.insert(blocking_tray_id).second) {
          blocking_trays.push_back(blocking_tray_id);
        }
      }
    }

    if(!blocking_trays.empty()) {
      INFOS(logger_, "Starting blocking tray resolution with tray t" << move->GetTrayId().value() << " at "
                                                                     << std::to_string(tray_opt->pose));
    }

    while(!blocking_trays.empty()) {
      INFOS(logger_, "Blocking trays:");
      for(const auto& blocking_tray : blocking_trays) {
        INFOS(logger_, "\tt" << blocking_tray);
      }
      auto blocking_tray_id = blocking_trays.front();

      INFOS(logger_, "Resolving blocking tray t" << blocking_tray_id << " for initial tray move");

      // Attempt to resolve all blocking trays in path of this tray without parking along
      // the critical path or moving along the root path.
      auto [dest, required_moves] = ResolveBlockingTrays(blocking_tray_id, move->GetJobIndex(), working_state,
          std::set<uint16_t> {move->GetTrayId().value()}, WithPriorDests(blocking_tray_id, critical_path));

      if(!dest) {
        // ResolveBlockingTrays already attempted a TYPE_WAYPOINT stash + repark internally.
        // If we land here, both Tier-1 (parking-only) and Tier-2 (waypoint-stash) failed
        // for this blocking tray under the critical-path constraint, so fall through to the
        // legacy "advance root tray" then "allow parking on critical path" fallbacks below.

        // Resolve cycles by first attempting to advance the root tray along its
        // critical path. For each step try resolution again, if that fails then allow
        // parking on the critical path. Repeat until we no longer can advance or we've
        // solved the puzzle.
        //
        // This is needed to resolve some funky possible edge cases.
        //
        // In these examples T are blocking trays and R is the root tray to be
        // retrieved.
        //
        // Example A:
        //      - - - + +
        //  B T - - - T T
        //              R
        // If we don't advance the root tray, we'll just shuffle the blocking tray back
        // and forth Example B:
        //        T T
        //   -----+ T
        //  |     + R
        //  B
        // Bay
        //
        // Here advancing all the way to the waypoint when retrieving R will prevent any
        // blocking tray resolution for the bay tray B.
        //
        //
        // Consider the following case:
        // B - - - + T T + + R
        //         T T T
        //
        //  After the first advance, blocking trays will be moved closer to the root
        //  tray, then moved back out as we advance the root tray. The reason we don't
        //  always advance all the way should be evident in example B Going to leave
        //  this as a
        //  TODO(Any): But we can solve this by only allowing parking on the critical
        //  path PAST where this blocking tray is. I'm just tired rn. We also can /
        //  should loop on advances if the critical path repark fails until either both
        //  fails or the critical path repark succeeds, so that we don't fail in the
        //  above case after the TODO is resolved.

        std::shared_ptr<volley::TrayMove> advance_move;

        auto next_step = std::next(root_tray_it);
        if(next_step == path.end()) {
          // Uh oh -- shouldn't happen, because if we can directly advance to the dest
          // then there aren't any blocking trays.
          return std::make_pair(false,
              "Failed to find blocking tray resolution. Logic "
              "error, we advanced to dest "
              "without having resolved all blocking trays.");
        }

        auto next_solution = next_step->first;
        auto next_pose = gg_.GetPoseFromVertex(next_solution.vert).value();
        auto next_node = gg_.GarageNodeFromVertex(next_solution.vert).value();

        INFOS(logger_,
            "Attempting to advance t" << move->GetTrayId().value() << " to " << std::to_string(next_pose));
        // If the next step is a blocking tray, we can't advance the root tray
        bool is_blocking = false;
        // This is stupid, I should have this info when I update the blocking tray list
        for(const auto& [other_tray_id, other_tray] : working_state.GetTrays()) {
          // Ignore root tray
          if(other_tray_id == tray_id) {
            continue;
          }
          volley::CollisionEntityId_t other_collision_id =
              volley::CollisionEntityIdFromTrayState(other_tray, working_state, *(gg_.GetLayout()));

          if(table_.Query(other_collision_id, root_collision_entity, other_tray.pose, next_pose)) {
            is_blocking = true;
            break;
          }
        }
        if(!is_blocking) {
          advance_move = std::make_shared<TrayMove>(move->GetJobIndex());
          advance_move->SetTrayId(move->GetTrayId().value());

          // FIX: Does this break triple pick test? system_single_triple_pick_retrieve.py.
          // {
          //     // Prefer to use the optimal retrieval heading of the parking node.
          //     auto tray_opt = working_state.GetTray(move->GetTrayId().value());
          //     if (tray_opt) {
          //         UsePreferredHeading(next_pose,
          //                             working_state.GetPayload(tray_opt->payload_id), tray_opt);
          //     }
          // }
          UseEvChargeHeading(next_pose);
          advance_move->SetDest(next_pose);
        }

        if(advance_move) {
          INFOS(logger_, "Advancing t" << move->GetTrayId().value() << " to "
                                       << std::to_string(advance_move->GetDest().value()));
          critical_path.erase(gg_.GetVertexFromPose(tray_opt->pose).value());

          auto [success, message] = advance_move->Apply(working_state);
          if(!success) {
            ERRORS(logger_, "Failed to apply advance move: " << advance_move->ToString() << ": " << message);
            return std::make_pair(
                false, "Failed to apply advance move: " + advance_move->ToString() + ": " + message);
          }
          tray_opt = working_state.GetTray(move->GetTrayId().value());
          root_tray_it = next_step;

          required_moves.emplace_back(std::move(advance_move),
              std::vector<GaragePoseMsg> {
                  gg_.GetVertexFromPose(tray_opt->pose).value(), advance_move->GetDest().value()});
          INFOS(logger_, "Attempting repark after advancing");

          std::vector<std::pair<std::shared_ptr<volley::TrayMove>, std::vector<GaragePoseMsg>>> repark_moves;

          // If the advance opened a space to cycle, do that.
          std::tie(dest, repark_moves) = ResolveBlockingTrays(blocking_tray_id, move->GetJobIndex(),
              working_state, std::set<uint16_t> {move->GetTrayId().value()},
              WithPriorDests(blocking_tray_id, critical_path));

          required_moves.insert(required_moves.end(), std::make_move_iterator(repark_moves.begin()),
              std::make_move_iterator(repark_moves.end()));
        }

        if(!dest) {
          INFOS(logger_, "Failed to find open space for blocking tray t" << blocking_tray_id
                                                                         << " avoiding critical path");

          std::vector<std::pair<std::shared_ptr<volley::TrayMove>, std::vector<GaragePoseMsg>>> repark_moves;

          std::tie(dest, repark_moves) =
              ResolveBlockingTrays(blocking_tray_id, move->GetJobIndex(), working_state,
                  std::set<uint16_t> {move->GetTrayId().value()}, WithPriorDests(blocking_tray_id, {}));

          required_moves.insert(required_moves.end(), std::make_move_iterator(repark_moves.begin()),
              std::make_move_iterator(repark_moves.end()));

          // If we can't resolve the blocking tray without parking on the critical
          // path then we just straight up can't resolve this blocking tray I suppose.
          //
          // TODO(Any): Instead we could try to recalculate the critical path at this
          // point, assuming other trays have been moved then we could potentially
          // resolve by skipping dealing with this, especially if we call it an
          // immobile tray.
          if(!dest) {
            return std::make_pair(
                false, "Failed to find open space for blocking tray t" + std::to_string(blocking_tray_id));
          }

          INFOS(logger_, "Found open space for blocking tray t" << blocking_tray_id << " at "
                                                                << std::to_string(dest.value())
                                                                << " allowing parking on critical path");
        }
      }

      // Remember this destination so a later iteration resolving the same blocking tray again
      // (e.g. because it got pushed back into the way) is forced to look elsewhere instead of
      // shuffling it back here. Use blocking_tray_id's own collision entity, not the root
      // tray's: it's blocking_tray_id that now occupies dest, and it may have a different
      // (often smaller) payload footprint than the root tray.
      blocking_tray_prior_dests[blocking_tray_id][gg_.GetVertexFromPose(dest.value()).value()] =
          volley::CollisionEntityIdFromTrayState(
              working_state.GetTray(blocking_tray_id).value(), working_state, *(gg_.GetLayout()));

      // Required moves are all moves required to resolve this blocking tray, and
      // are all entirely sequential, so we can just apply them all in order.

      std::shared_ptr<volley::TrayMove> last_move;

      auto new_move = std::make_shared<TrayMove>(move->GetJobIndex());
      new_move->SetTrayId(blocking_tray_id);

      // FIX: Does this break triple pick test? system_single_triple_pick_retrieve.py.
      // {
      //     // Prefer to use the optimal retrieval heading of the parking node.
      //     auto blocking_tray_opt = working_state.GetTray(blocking_tray_id);
      //     if (blocking_tray_opt) {
      //         GaragePoseMsg dst = dest.value();
      //         UsePreferredHeading(dst,
      //                             working_state.GetPayload(blocking_tray_opt->payload_id),
      //                             blocking_tray_opt);
      //         dest = dst;
      //     }
      // }
      UseEvChargeHeading(dest.value());
      new_move->SetDest(dest.value());

      std::vector<GaragePoseMsg> new_move_path;
      for(const auto& [vert, _] : critical_path) {
        new_move_path.push_back(gg_.GetPoseFromVertex(vert).value());
      }

      required_moves.push_back({new_move, new_move_path});

      for(auto& [unblock_move, unblock_path] : required_moves) {
        auto source_pose = working_state.GetTray(unblock_move->GetTrayId().value())->pose;
        blocking_tray_set.erase(unblock_move->GetTrayId().value());
        unblock_move->Apply(working_state);

        // TODO(Gunther): Need to fix the part where I already applied
        // auto [success, message] = unblock_move->Apply(working_state);
        // the advance move above
        // if (!success) {
        //     return std::make_pair(false, "Failed to apply unblocking move: " +
        //                                      unblock_move->ToString() + ": " +
        //                                      message);
        // }
        ctx->events.AddEvent(unblock_move);
        if(last_move) {
          ctx->events.AddDependency(last_move, unblock_move);
        }

        {
          const auto unblock_tray_id = unblock_move->GetTrayId().value();
          if(last_tray_event.find(unblock_tray_id) != last_tray_event.end()) {
            ctx->events.AddDependency(last_tray_event[unblock_tray_id], unblock_move);
          }
          else {
            ctx->first_tray_event[unblock_tray_id] = unblock_move;
          }
          last_move = unblock_move;
          last_tray_event[unblock_tray_id] = unblock_move;
        }

        for(auto& pose : unblock_path) {
          auto blockers_opt = freeing_moves.GetBlockers(
              pose, volley::CollisionEntityIdFromTrayState(
                        working_state.GetTray(unblock_move->GetTrayId().value()).value(), working_state,
                        *(gg_.GetLayout())));
          // This move depends on all other moves that make this space available
          // before now, probably an excessive amount of edges, but we can prune later
          if(blockers_opt) {
            for(auto& blocker : blockers_opt.value()) {
              if(blocker == unblock_move) {
                continue;
              }
              auto added = ctx->events.AddDependency(blocker, unblock_move);
              LOG_DEBUG_IF(logger_, added, "Adding dependency on move to {} on move to {}",
                  unblock_move->ToString(), blocker->ToString());
            }
          }

          freeing_moves.AddOccupant(pose,
              volley::CollisionEntityIdFromTrayState(
                  working_state.GetTray(unblock_move->GetTrayId().value()).value(), working_state,
                  *(gg_.GetLayout())),
              unblock_move, true);
        }

        LOG_DEBUG(
            logger_, "Adding {} to freeing moves {}", std::to_string(source_pose), new_move->ToString());

        freeing_moves.AddOccupant(
            source_pose, common::EnumInteger(volley::CollisionEntityId::TRAY), unblock_move, true);
      }

      ctx->events.AddDependency(new_move, event);

      // Find new set of blocking trays along critical path, still ordered by appearance
      // on critical path
      blocking_trays.clear();
      blocking_tray_set.clear();

      // This isn't super efficient, given that this info _should_ follow from the above
      // steps, but I'm too tired to figure that out right now, and in the grand scheme of
      // things its pretty dang cheap.

      for(auto it = root_tray_it; it != path.end(); ++it) {
        auto critical_vertex = it->first.vert;
        auto critical_pose = gg_.GetPoseFromVertex(critical_vertex).value();
        for(const auto& [other_tray_id, other_tray] : working_state.GetTrays()) {
          // Ignore root tray
          if(other_tray_id == tray_id) {
            continue;
          }

          volley::CollisionEntityId_t other_collision_id =
              volley::CollisionEntityIdFromTrayState(other_tray, working_state, *(gg_.GetLayout()));

          if(table_.Query(other_collision_id, root_collision_entity, other_tray.pose, critical_pose)) {
            // This resolution step remains on the critical path, and still needs to
            // be resolved again
            if(blocking_tray_set.insert(other_tray_id).second) {
              blocking_trays.push_back(other_tray_id);
            }
          }
        }
      }
    }

    auto blockers_opt = freeing_moves.GetBlockers(
        move->GetDest().value(), common::EnumInteger(volley::CollisionEntityId::TRAY));
    if(blockers_opt) {
      for(auto& blocker : blockers_opt.value()) {
        LOG_DEBUG(
            logger_, "Adding dependency on move to {} to move to {}", event->ToString(), blocker->ToString());
        ctx->events.AddDependency(blocker, event);
      }
    }
    // Add dependencies on the source too -- this is wonky and can
    // be handled better, but right now bay transitions add a
    // blocker on the pose in the bay and so any tray move to /
    // from a bay must depend on the last transitions for that bay.
    blockers_opt = freeing_moves.GetBlockers(tray_opt->pose,
        // TODO(Gunther): Use Isabels magic function here
        common::EnumInteger(volley::CollisionEntityId::TRAY));
    if(blockers_opt) {
      for(auto& blocker : blockers_opt.value()) {
        LOG_DEBUG(
            logger_, "Adding dependency on move to {} to move to {}", event->ToString(), blocker->ToString());
        ctx->events.AddDependency(blocker, event);
      }
    }

    LOG_DEBUG(logger_, "Adding {} to freeing moves {}", std::to_string(tray_opt->pose), event->ToString());

    freeing_moves.AddOccupant(
        tray_opt->pose, common::EnumInteger(volley::CollisionEntityId::TRAY), event, true);

    auto [apply_success, message] = event->Apply(working_state);
    if(!apply_success) {
      return std::make_pair(
          false, "Failed to apply event during tray assignment: " + event->ToString() + ": " + message);
    }
    {
      const auto tray_event_id = move->GetTrayId().value();
      if(last_tray_event.find(tray_event_id) != last_tray_event.end()) {
        ctx->events.AddDependency(last_tray_event[tray_event_id], event);
      }
      else {
        ctx->first_tray_event[tray_event_id] = event;
      }
      last_tray_event[tray_event_id] = event;
    }
    assigned_events.emplace_back(std::move(event));
  }

  // TODO(Any): Here we can iterate the Dag and collapse any chains of moves into a single
  // move if there are no dependencies on the intermediate moves. This will allow us to stop
  // plopping trays down and picking them right back up again if we don't need to.

  INFOS(logger_, "Tray Assigned events:");
  auto new_total_ordering_opt = ctx->events.GetTopologicalOrdering();
  if(!new_total_ordering_opt.has_value()) {
    ERRORS(logger_, "Failed to get new total ordering. " << "Tray assignments introduced a loop!!!!");
    return std::make_pair(false, "Failed to get new total ordering");
  }

  for(const auto& event_vert : new_total_ordering_opt.value()) {
    auto event = ctx->events.GetEventFromVertex(event_vert).value();
    INFOS(logger_, "\t" << std::to_string(*event));
  }

  // Clean up a ton of redundant dependencies
  // TODO(Gunther): Reduce here breaks the AgvAssignments for some reason.
  // ctx->events.Reduce();
  // All tray moves in DAG now have trays and dests
  return std::make_pair(true, "");
}

std::optional<volley::Interval::Duration> Scheduler::GetJustMovingCost(const GaragePoseMsg& start_pose,
    const GaragePoseMsg& end_pose, const GarageEntityIdMsg& agv_id, bool is_agv_loaded,
    std::optional<volley::GraphFilterProperties> filters) const {
  if(start_pose == end_pose) {
    INFOF(logger_, "Scheduler::GetJustMovingCost  start and end pose are the same");
    return volley::Interval::Duration::zero();
  }
  // NOTE: collision_id is hardcoded here as an AGV because it shouldn't
  // really matter what collision body we use for finding the time it takes to
  // get from one pose to another.
  const auto collision_id = static_cast<volley::CollisionEntityId_t>(volley::CollisionEntityId::AGV);
  std::vector<GaragePoseMsg> pose_path = volley::GetPosePath(gg_, start_pose, end_pose, cost_model_, filters);
  if(pose_path.empty()) {
    auto src_v = gg_.GetVertexFromPose(start_pose);
    auto dst_v = gg_.GetVertexFromPose(end_pose);
    WARNS(logger_, "Scheduler::GetJustMovingCost empty path for "
                       << std::to_string(agv_id) << " " << std::to_string(start_pose) << " -> "
                       << std::to_string(end_pose) << " src_vertex_valid=" << src_v.has_value()
                       << " dst_vertex_valid=" << dst_v.has_value()
                       << " filters=" << (filters.has_value() ? "yes" : "no"));
    if(filters.has_value() && src_v.has_value() && dst_v.has_value()) {
      // Re-run unfiltered to distinguish "graph disconnected" from "filter blocks".
      auto unfiltered = volley::GetPosePath(gg_, start_pose, end_pose, cost_model_, std::nullopt);
      if(unfiltered.empty()) {
        WARNS(logger_, "  graph itself has no path " << std::to_string(start_pose) << " -> "
                                                     << std::to_string(end_pose));
      }
      else {
        std::ostringstream path_os;
        for(size_t i = 0; i < unfiltered.size(); ++i) {
          path_os << std::to_string(unfiltered[i]);
          if(i + 1 < unfiltered.size())
            path_os << " -> ";
        }
        WARNS(logger_, "  unfiltered path (" << unfiltered.size() << " hops): " << path_os.str());
        // Identify the first hop blocked by the filter.
        for(size_t i = 0; i + 1 < unfiltered.size(); ++i) {
          auto edge_opt = gg_.EdgeFromPoses(unfiltered[i], unfiltered[i + 1]);
          if(!edge_opt.has_value())
            continue;
          if(!filters->IsEnabled(edge_opt.value())) {
            WARNS(logger_, "  first filter-blocked edge: " << std::to_string(unfiltered[i]) << " -> "
                                                           << std::to_string(unfiltered[i + 1]));
            break;
          }
          auto v_dst = gg_.GetVertexFromPose(unfiltered[i + 1]);
          if(v_dst.has_value() && !filters->IsEnabled(v_dst.value())) {
            WARNS(logger_, "  first filter-blocked vertex: " << std::to_string(unfiltered[i + 1]));
            break;
          }
        }
      }
      // List the AGV's reachable neighbors (edges out of start) and which are filter-blocked.
      std::ostringstream out_os;
      for(auto [it, end] = gg_.GetOutEdges(src_v.value()); it != end; ++it) {
        auto edge = *it;
        auto dst_pose = gg_.GetPoseFromVertex(boost::target(edge, gg_.GetBaseGraph()));
        bool edge_ok = filters->IsEnabled(edge);
        bool vert_ok = filters->IsEnabled(boost::target(edge, gg_.GetBaseGraph()));
        out_os << std::to_string(dst_pose.value()) << "[edge=" << (edge_ok ? "ok" : "BLOCKED")
               << ",vertex=" << (vert_ok ? "ok" : "BLOCKED") << "] ";
      }
      WARNS(logger_, "  out-edges from start: " << out_os.str());
    }
    return std::nullopt;
  }
  auto trajectory = volley::ConvertPosePathToTrajectory(pose_path, gg_, cost_model_,
      volley::Interval::Timepoint(), agv_id, collision_id, 0, nullptr, is_agv_loaded);

  auto interval_opt = trajectory.GetInterval();
  if(!interval_opt.has_value()) {
    WARNF(logger_, "Scheduler::GetJustMovingCost  the interval_opt  does not have a value");
    return std::nullopt;
  }
  return interval_opt->GetDuration();
}

std::optional<volley::Interval::Duration> Scheduler::GetAgvCurrentPoseToTrayMoveCost(uint16_t agv_id,
    const volley::TrayMove& move, const volley::DiscreteGarageState& working_state,
    std::optional<volley::GraphFilterProperties> filters) const {
  // Note: This function assumes that the tray move has a tray ID, that that
  // tray exists, and that it is on a valid node. It also assumes that the AGV
  // exists and is on a valid node.
  auto tray = working_state.GetTray(move.GetTrayId().value()).value();
  auto agv = working_state.GetAgv(agv_id).value();
  // The AGV should only rotate itself to the tray's heading if it's not at
  // the right orientation already. If it's just 180* off then the AGV should
  // not rotate.
  auto heading = tray.pose.heading;
  if(volley::IsAngleOrReciprocal(agv.pose.heading, heading)) {
    heading = agv.pose.heading;
  }
  auto tray_pose = volley::ConstructGaragePose(tray.pose.node_id, heading);
  auto moving_cost_opt =
      GetJustMovingCost(agv.pose, tray_pose, volley::AgvId(agv_id), agv.tray_id != 0, filters);
  if(!moving_cost_opt.has_value()) {
    return std::nullopt;
  }
  // If the AGV isn't currently holding this tray, take into account the time
  // it would take to lift it
  auto lift_cost = volley::Interval::Duration::zero();
  if(agv.tray_id != tray.id) {
    lift_cost = std::chrono::duration_cast<volley::Interval::Duration>(
        volley::cost::SecondsF(cost_model_.Params().events.agv_lift_up));
  }
  return moving_cost_opt.value() + lift_cost;
}

