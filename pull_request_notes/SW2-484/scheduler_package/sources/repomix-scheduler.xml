    ASSERT_EQ(1u, response.scheduled_jobs.size());
    // succeed
    auto job = response.scheduled_jobs[0];
    EXPECT_EQ(SchedulerJobMsg::STATE_EXECUTING, job.job.state);
    ASSERT_EQ(1u, response.schedule.nodes.size());
    // should be a bay command
    auto node = response.schedule.nodes[0];
    EXPECT_EQ(ActionNodeMsg::TYPE_BAY_COMMAND, node.type);
    EXPECT_EQ(1u, node.bay_id);
    EXPECT_EQ(BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT, node.bay_command.command_type);
  }
}

