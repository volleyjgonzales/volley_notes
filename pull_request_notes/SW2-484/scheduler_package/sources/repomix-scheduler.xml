// CLEAN_GARAGE must repark trays that were stashed on Waypoints by the tier-2
// fallback in ResolveBlockingTrays. tiny_lot waypoints are nodes 2, 3, 5; parkings are
// nodes 6, 8, 9; node 1 is the only bay.
TEST(Scheduler, CleanGarageUnstashesTrayFromWaypoint) {
  volley::DiscreteGarageState state;
  auto [success, msg] = state.Set(YAML::Load(R"YML(
is_faulted: false
agvs:
-
  id: 1
  state: 5
  pose:
    node_id: 8
    heading: 0
trays:
-
  id: 2
  pose:
    node_id: 1
    heading: 90
-
  id: 3
  pose:
    node_id: 3
    heading: 0
bays:
- id: 1
  state: 3
  disabled: false
payloads: []
disabled_nodes: []
hash: 0)YML"));

  EXPECT_TRUE(success) << msg;

  const auto layout_filepath_or = GetLayoutPathByName(kTinyLotLayoutName);
  ASSERT_TRUE(layout_filepath_or.has_value()) << layout_filepath_or.error();
  const auto& layout_filepath = layout_filepath_or.value();

  auto logger = rclcpp::get_logger("scheduler");
  SchedulerParams params {.bay_readiness_ratio = 1};
  Scheduler scheduler(layout_filepath, logger, params);

  rclcpp::Time now = rclcpp::Time(0);

  PlanRequestMsg request_data;
  SchedulerJobMsg clean_garage;
  clean_garage.type = SchedulerJobMsg::TYPE_CLEAN_GARAGE;
  clean_garage.type_name = "TYPE_CLEAN_GARAGE";
  clean_garage.state = SchedulerJobMsg::STATE_UNPLANNED;
  clean_garage.state_name = "STATE_UNPLANNED";
  clean_garage.guid = volley::MakeGuid(0u, 33u);
  clean_garage.time_registered = now;
  clean_garage.note = "unstash tray 3 from waypoint 3";
  request_data.pending_jobs.emplace_back(std::move(clean_garage));
  request_data.id = volley::MakeGuid(0u, 16u);
  request_data.base_state = state.GetDiscreteGarageStateMessage();

  auto response = scheduler.Plan(request_data, now);
  EXPECT_EQ(response.success, true) << response.message;
  ASSERT_EQ(response.scheduled_jobs.size(), 1u);
  EXPECT_EQ(response.scheduled_jobs[0].job.state, SchedulerJobMsg::STATE_EXECUTING);

  // The schedule should contain at least one AGV_COMMAND that picks the tray up at the
  // waypoint (src.node_id == 3) and ends at a parking (dst.node_id in {6, 8, 9}) while
  // carrying the tray (dst.lift == true).
  const std::set<uint32_t> parkings = {6u, 8u, 9u};
  bool found_unstash_move = false;
  for(const auto& action : response.schedule.nodes) {
    if(action.type != ActionNodeMsg::TYPE_AGV_COMMAND) {
      continue;
    }
    const auto& cmd = action.agv_command;
    if(cmd.src.pose.node_id == 3 && parkings.count(cmd.dst.pose.node_id) > 0 && cmd.dst.lift) {
      found_unstash_move = true;
      break;
    }
  }
  EXPECT_TRUE(found_unstash_move)
      << "CLEAN_GARAGE did not produce an AGV move from waypoint 3 to a parking node";
};

