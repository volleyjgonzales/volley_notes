namespace volley {

template <typename T>
class DagBase {
public:
  // Define the Graph type using Boost's adjacency_list with custom Vertex (ScheduleEvent)
  // properties
  using DagT = boost::adjacency_list<boost::vecS, boost::vecS, boost::bidirectionalS, std::shared_ptr<T>>;
  using Vertex = typename DagT::vertex_descriptor;
  using Edge = typename DagT::edge_descriptor;
  using Iterator = typename DagT::vertex_iterator;

  DagBase() = default;
  virtual ~DagBase() = default;
  // thx clang
  DagBase(DagBase const&) = default;
  DagBase& operator=(DagBase const&) = default;
  DagBase(DagBase&&) = default;
  DagBase& operator=(DagBase&&) = default;

  // General properties of the DAG
  unsigned int NumVertices() const { return boost::num_vertices(dag_); }
  unsigned int NumEdges() const { return boost::num_edges(dag_); }

  bool Has(const std::shared_ptr<T>& ptr) const { return ptr_to_vertex_.find(ptr) != ptr_to_vertex_.end(); }
  bool HasVertex(const Vertex& vertex) const { return vertex < NumVertices(); }

  bool HasDependency(const std::shared_ptr<T>& parent, const std::shared_ptr<T>& child) const {
    if(!Has(parent) || !Has(child)) {
      return false;
    }
    return boost::edge(ptr_to_vertex_.at(parent), ptr_to_vertex_.at(child), dag_).second;
  }
  bool HasDependency(const Vertex& parent, const Vertex& child) const {
    if(!HasVertex(parent) || !HasVertex(child)) {
      return false;
    }
    return boost::edge(parent, child, dag_).second;
  }

  std::optional<std::shared_ptr<T>> GetFromVertex(const Vertex& vertex) const {
    if(!HasVertex(vertex)) {
      return std::nullopt;
    }
    return boost::get(boost::vertex_bundle, dag_)[vertex];
  }
  std::optional<Vertex> GetVertex(const std::shared_ptr<T>& ptr) const {
    if(!Has(ptr)) {
      return std::nullopt;
    }
    return ptr_to_vertex_.at(ptr);
  }

  Vertex GetSourceVertex(const Edge& edge) const { return source(edge, dag_); }
  Vertex GetTargetVertex(const Edge& edge) const { return target(edge, dag_); }

  const DagT& GetBaseGraph() const { return dag_; }

  // Remove vertex and all in/out edges
  // NOTE: If you remove a vertex, all vertex IDs larger than the removed vertex will decrement
  // by 1. Thanks boost! So any DagBase::Vertex references you have will be inaccurate after the
  // removal. This shouldn't be a huge issue since we mostly use the template class to interact
  // with the DAG anyways
  void RemoveVertex(const Vertex& vertex) {
    auto ptr_opt = GetFromVertex(vertex);
    if(ptr_opt.has_value()) {
      RemoveVertexHelper(vertex, ptr_opt.value());
    }
  }
  void Remove(const std::shared_ptr<T>& ptr) {
    auto vert_opt = GetVertex(ptr);
    if(vert_opt.has_value()) {
      RemoveVertexHelper(vert_opt.value(), ptr);
    }
  }

  // Note: These functions return a pair consisting of (iterator_start, iterator_end)
  // Vertex Iterator
  std::pair<Iterator, Iterator> GetVertices() const { return boost::vertices(dag_); }

  // Get In/Out Edges, throws an exception if the vertex does not exist
  std::pair<typename DagT::in_edge_iterator, typename DagT::in_edge_iterator> GetInEdges(
      const Vertex& vertex) const {
    if(!HasVertex(vertex)) {
      throw std::invalid_argument("Vertex does not exist: " + std::to_string(vertex));
    }
    return boost::in_edges(vertex, dag_);
  }
  std::pair<typename DagT::out_edge_iterator, typename DagT::out_edge_iterator> GetOutEdges(
      const Vertex& vertex) const {
    if(!HasVertex(vertex)) {
      throw std::invalid_argument("Vertex does not exist: " + std::to_string(vertex));
    }
    return boost::out_edges(vertex, dag_);
  }

  // Add vertex, returns vertex if added, nullopt if not
  std::optional<Vertex> Add(const std::shared_ptr<T>& ptr) {
#pragma GCC diagnostic push
// disable boost::optional ... m_storage may be used uninitialized
// This is related to GCC.
// See also:  https://github.com/boostorg/function/issues/27
// See also:
// https://stackoverflow.com/questions/21755206/how-to-get-around-gcc-void-b-4-may-be-used-uninitialized-in-this-funct
// See also:  https://gcc.gnu.org/bugzilla/show_bug.cgi?id=106922
#pragma GCC diagnostic ignored "-Wmaybe-uninitialized"
    if(Has(ptr)) {
      return std::nullopt;
    }
    Vertex vertex = boost::add_vertex(ptr, dag_);
    ptr_to_vertex_[ptr] = vertex;
    return vertex;
#pragma GCC diagnostic pop
  }

  // Add dependency, returns false if not added
  // Our dependency goes parent -> child. Parent is source, child is target
  bool AddDependency(const std::shared_ptr<T>& parent, const std::shared_ptr<T>& child) {
    if(!Has(parent) || !Has(child)) {
      return false;
    }
    Vertex parent_vertex = ptr_to_vertex_.at(parent);
    Vertex child_vertex = ptr_to_vertex_.at(child);
    return AddDependency(parent_vertex, child_vertex);
  }
  bool AddDependency(const Vertex& parent, const Vertex& child) {
    if(!HasVertex(parent) || not HasVertex(child)) {
      return false;
    }
    if(HasDependency(parent, child)) {
      return false;
    }
    boost::add_edge(parent, child, dag_);
    return true;
  }

  // Add dependent, does the opposite of the above functions
  bool AddDependent(const std::shared_ptr<T>& child, const std::shared_ptr<T>& parent) {
    if(!Has(parent) || !Has(child)) {
      return false;
    }
    Vertex parent_vertex = ptr_to_vertex_.at(parent);
    Vertex child_vertex = ptr_to_vertex_.at(child);
    return AddDependency(parent_vertex, child_vertex);
  }

  // Returns true if adding the edge parent -> child would create a cycle, i.e. child can
  // already reach parent in the current DAG. Uses BFS over out-edges.
  bool WouldCreateCycle(const Vertex& parent, const Vertex& child) const {
    if(!HasVertex(parent) || !HasVertex(child)) {
      return false;
    }
    if(parent == child) {
      return true;
    }
    std::unordered_set<Vertex> visited;
    std::queue<Vertex> bfs;
    bfs.push(child);
    visited.insert(child);
    while(!bfs.empty()) {
      auto curr = bfs.front();
      bfs.pop();
      for(auto [e, e_end] = boost::out_edges(curr, dag_); e != e_end; ++e) {
        auto next = boost::target(*e, dag_);
        if(next == parent) {
          return true;
        }
        if(visited.insert(next).second) {
          bfs.push(next);
        }
      }
    }
    return false;
  }
  bool WouldCreateCycle(const std::shared_ptr<T>& parent, const std::shared_ptr<T>& child) const {
    if(!Has(parent) || !Has(child)) {
      return false;
    }
    return WouldCreateCycle(ptr_to_vertex_.at(parent), ptr_to_vertex_.at(child));
  }

  /// @brief Replace the value stored at the vertex containing old_ptr with new_ptr
  /// @param old_ptr the current value to find the vertex by
  /// @param new_ptr the new value to store at that vertex
  /// @return true if the vertex was found and updated, false otherwise
  bool Replace(const std::shared_ptr<T>& old_ptr, const std::shared_ptr<T>& new_ptr) {
    auto vert_opt = GetVertex(old_ptr);
    if(!vert_opt.has_value()) {
      return false;
    }
    return Replace(vert_opt.value(), old_ptr, new_ptr);
  }

  /// @brief Replace the value stored at a vertex with new_ptr
  /// @param vertex the vertex to update
  /// @param new_ptr the new value to store at that vertex
  /// @return true if the vertex was found and updated, false otherwise
  bool Replace(const Vertex& vertex, const std::shared_ptr<T>& new_ptr) {
    auto old_ptr_opt = GetFromVertex(vertex);
    if(!old_ptr_opt.has_value()) {
      return false;
    }
    return Replace(vertex, old_ptr_opt.value(), new_ptr);
  }

  /// @brief Get the direct children of a node
  /// @param ptr shared_ptr to the node
  /// @return vector of shared_ptrs to the direct children, empty if node not found
  std::vector<std::shared_ptr<T>> GetChildren(const std::shared_ptr<T>& ptr) const {
    auto vert_opt = GetVertex(ptr);
    if(!vert_opt.has_value()) {
      return {};
    }
    return GetChildren(vert_opt.value());
  }

  /// @brief Get the direct children of a vertex
  /// @param vertex the vertex descriptor
  /// @return vector of shared_ptrs to the direct children, empty if vertex not found
  std::vector<std::shared_ptr<T>> GetChildren(const Vertex& vertex) const {
    if(!HasVertex(vertex)) {
      return {};
    }
    std::vector<std::shared_ptr<T>> children;
    for(auto [ei, ei_end] = boost::out_edges(vertex, dag_); ei != ei_end; ++ei) {
      children.push_back(boost::get(boost::vertex_bundle, dag_)[target(*ei, dag_)]);
    }
    return children;
  }

  /// @brief Get the direct parents of a node
  /// @param ptr shared_ptr to the node
  /// @return vector of shared_ptrs to the direct parents, empty if node not found
  std::vector<std::shared_ptr<T>> GetParents(const std::shared_ptr<T>& ptr) const {
    auto vert_opt = GetVertex(ptr);
    if(!vert_opt.has_value()) {
      return {};
    }
    return GetParents(vert_opt.value());
  }

  /// @brief Get the direct parents of a vertex
  /// @param vertex the vertex descriptor
  /// @return vector of shared_ptrs to the direct parents, empty if vertex not found
  std::vector<std::shared_ptr<T>> GetParents(const Vertex& vertex) const {
    if(!HasVertex(vertex)) {
      return {};
    }
    std::vector<std::shared_ptr<T>> parents;
    for(auto [ei, ei_end] = boost::in_edges(vertex, dag_); ei != ei_end; ++ei) {
      parents.push_back(boost::get(boost::vertex_bundle, dag_)[source(*ei, dag_)]);
    }
    return parents;
  }

  // Get Leaf vertices. Vertices with no children (no dependents)
  std::vector<Vertex> GetLeafVertices() const {
    std::vector<Vertex> leaves;
    for(const auto& vertex : boost::make_iterator_range(GetVertices())) {
      if(boost::out_degree(vertex, dag_) == 0) {
        leaves.push_back(vertex);
      }
    }
    return leaves;
  }

  // Get Root vertices. Vertices with no parents (no dependencies)
  std::vector<Vertex> GetRootVertices() const {
    std::vector<Vertex> roots;
    for(const auto& vertex : boost::make_iterator_range(GetVertices())) {
      if(boost::in_degree(vertex, dag_) == 0) {
        roots.push_back(vertex);
      }
    }
    return roots;
  }

  // Create a topological ordering of the graph. If the graph is not a DAG, nullopt will be
  // returned.
  virtual std::optional<std::vector<Vertex>> GetTopologicalOrdering() const {
    std::vector<Vertex> topo_ordering;
    try {
      // NOLINTNEXTLINE
      boost::topological_sort(dag_, std::back_inserter(topo_ordering));
      std::reverse(topo_ordering.begin(), topo_ordering.end());
    }
    catch(const std::exception& e) {
      // TODO(Joe) log e.what() in case it's not "The graph must be a DAG."
      return std::nullopt;
    }
    return topo_ordering;
  }

  BoolStringPair Reduce() {
    // Note this is complete
    const size_t num_v = num_vertices(dag_);
    auto topo_opt = GetTopologicalOrdering();
    if(!topo_opt.has_value()) {
      return {false, "The graph must be a DAG."};
    }

    auto topo_order = topo_opt.value();

    // Get topological ordering - O(V + E)
    std::vector<int> vertex_order(num_v);
    for(size_t i = 0; i < num_v; ++i) {
      vertex_order[topo_order[i]] = i;
    }
    // Create reachability matrix using dynamic programming - O(V * E)
    std::vector<std::vector<bool>> reachable(num_v, std::vector<bool>(num_v, false));
    // Process vertices in reverse topological order
    for(auto it = topo_order.rbegin(); it != topo_order.rend(); ++it) {
      Vertex u = *it;
      // Direct successors are reachable
      for(auto [ei, ei_end] = boost::out_edges(u, dag_); ei != ei_end; ++ei) {
        Vertex v = target(*ei, dag_);
        reachable[u][v] = true;
        // If v can reach w, then u can reach w
        for(size_t w = 0; w < num_v; ++w) {
          if(reachable[v][w]) {
            reachable[u][w] = true;
          }
        }
      }
    }
    // Store edges to remove
    std::vector<Edge> edges_to_remove;
    // Check each edge for redundancy - O(E * V)
    for(auto [ei, ei_end] = edges(dag_); ei != ei_end; ++ei) {
      Vertex u = source(*ei, dag_);
      Vertex v = target(*ei, dag_);
      // Remove edge temporarily
      bool is_redundant = false;
      // Check if u can still reach v through other paths
      for(auto [out_i, out_end] = boost::out_edges(u, dag_); out_i != out_end && !is_redundant; ++out_i) {
        if(*out_i == *ei) {
          continue;
        }
        Vertex w = boost::target(*out_i, dag_);
        if(vertex_order[w] < vertex_order[v] && reachable[w][v]) {
          is_redundant = true;
        }
      }
      if(is_redundant) {
        edges_to_remove.push_back(*ei);
      }
    }
    // Remove redundant edges
    for(const Edge& e : edges_to_remove) {
      boost::remove_edge(e, dag_);
    }
    return {true, "Success"};
  }

  std::string DrawGraph(std::string name = "dag") const {
    struct VertexLabelWriter {
      void operator()(std::ostream& out, const Vertex& vertex) const {
        out << " [label=\"" << "Vert: " << vertex << std::to_string(*GetFromVertex(vertex)) << "\"]";
      }
      // NOLINTNEXTLINE
      std::function<std::shared_ptr<T>(const Vertex&)> GetFromVertex;
    } vertex_label_writer;
    vertex_label_writer.GetFromVertex = [this](const Vertex& vertex) -> std::shared_ptr<T> {
      return GetFromVertex(vertex).value_or(nullptr);
    };

    std::string filename = "/tmp/" + name + ".dot";
    std::ofstream dotfile(filename);

    // TODO(Gunther): Custom Label Writer
    boost::write_graphviz(dotfile, dag_, vertex_label_writer);
    dotfile.close();
    return filename;
  }

  std::string to_str(const BayCommandMsg& command) const {
    std::ostringstream os;
    switch(command.command_type) {
    case BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_INSERT:
      os << "toInsrt";
      break;
    case BayCommandMsg::COMMAND_TYPE_PROCESS_RETRIEVE:
      os << "PrcsRtrv";
      break;
    case BayCommandMsg::COMMAND_TYPE_TRANSITION_TO_RETRIEVE:
      os << "toRtrv";
      break;
    default:
      os << "Unknown BayCommand type: " << std::to_string(command.command_type);
      break;
    }

    return os.str();
  }

  std::string to_str(const GaragePoseMsg& pose) const {
    return std::to_string(pose.node_id);
    // + "@" + std::to_string(pose.heading);
  }

  std::string to_str(const AgvGoalMsg& goal) const { return to_str(goal.pose); }

  std::string to_str(const AgvCommandMsg& command) const { return "->" + to_str(command.dst); }
  std::string to_str(const VecsCommandMsg& command) const {
    std::ostringstream os;
    switch(command.command_type) {
    case VecsCommandMsg::COMMAND_TYPE_START_CHARGING:
      os << "Startcharging";
      break;
    case VecsCommandMsg::COMMAND_TYPE_STOP_CHARGING:
      os << "Stopcharging";
      break;
    default:
      os << "Unknown VecsCommand type: " << std::to_string(command.command_type);
      break;
    }

    return os.str();
  }
  std::string to_str(const ActionNodeMsg& node) const {
    std::ostringstream os;
    switch(node.type) {
    case ActionNodeMsg::TYPE_AGV_COMMAND:
      // os << "AGV ";
      os << std::to_string(volley::AgvId(node.agv_id)) << " ";
      os << to_str(node.agv_command);
      break;
    case ActionNodeMsg::TYPE_BAY_COMMAND:
      // os << "Bay ";
      os << std::to_string(volley::BayId(node.bay_id)) << " ";
      os << to_str(node.bay_command);
      break;
    case ActionNodeMsg::TYPE_VECS_COMMAND:
      // os << "VECS ";
      os << std::to_string(volley::VecsId(node.vecs_id)) << " ";
      os << to_str(node.vecs_command);
      break;
    case ActionNodeMsg::TYPE_VRC_COMMAND:
      os << std::to_string(volley::VrcId(node.vrc_id)) << " ";
      os << "floor->" << std::to_string(node.vrc_command.requested_floor);
      break;
    default:
      os << "Unknown: " << std::to_string(node.type);
      break;
    }
    return os.str();
  }
  std::string to_str(const volley::ScheduleEvent& event) const {
    switch(event.GetType()) {
    case ScheduleEventType::AGV_MOVE:
      return std::to_string(event.GetJobIndex()) + "AM";
    case ScheduleEventType::BAY_TRANSITION:
      return std::to_string(event.GetJobIndex()) + "BT";
    case ScheduleEventType::TRAY_MOVE:
      return std::to_string(event.GetJobIndex()) + "TM";
    case ScheduleEventType::VECS_TRANSITION:
      return std::to_string(event.GetJobIndex()) + "VT";
    default:
      return std::to_string(event.GetJobIndex()) + "Unknown event type ";
    }
    return std::to_string(event.GetJobIndex());
  }

  std::string ToDotFormatString(bool left_right = true) const {
    // Build the dot file contents using dot file syntax.
    auto g_writer = [&](std::ostream& out) {
      if(left_right) {
        out << "  rankdir=LR;\n";
      }
    };
    auto v_writer = [this](std::ostream& out, const Vertex& vertex) {
      out << " [label=\"" << to_str(*(GetFromVertex(vertex).value()))  // ptr.value()->GetJobIndex()
          << "\"]";
    };
    auto e_no_writer = [](std::ostream& out, const Edge&) { (void)out; };

    // Write the dot file contents to a string.
    std::ostringstream dotcontents;
    boost::write_graphviz(dotcontents, dag_, v_writer, e_no_writer, g_writer);
    std::string content = dotcontents.str();
    return content;
  }

  // Print this graph to the log
  void PrintGraph(const std::string& label, rclcpp::Logger logger = rclcpp::get_logger("")) const {
    std::string dotcontents = ToDotFormatString();
    const char* color = "\033[1;93m";  // High Intensity Yellow
    volley::PrintGraph(label, dotcontents, logger, color);
  }

protected:
  bool Replace(const Vertex& vertex, const std::shared_ptr<T>& old_ptr, const std::shared_ptr<T>& new_ptr) {
    boost::get(boost::vertex_bundle, dag_)[vertex] = new_ptr;
    ptr_to_vertex_.erase(old_ptr);
    ptr_to_vertex_[new_ptr] = vertex;
    return true;
  }

  // Helper function that removes the vertex and its in/out edges. We assume that the vertex
  // exists at this point
  void RemoveVertexHelper(const Vertex& vert, const std::shared_ptr<T>& ptr) {
    // Remove all edges, because boost doesn't do this automatically.
    std::vector<Edge> edges;
    for(auto [curr, end] = GetInEdges(vert); curr != end; ++curr) {
      edges.push_back(*curr);
    }
    for(auto [curr, end] = GetOutEdges(vert); curr != end; ++curr) {
      edges.push_back(*curr);
    }
    for(auto edge : edges) {
      boost::remove_edge(edge, dag_);
    }

    // Decrement the ID of the vertices that events point to if their ID is higher than the ID
    // of the vertex we are removing. This keeps ptr_to_vertex_ map up to date. See comment
    // below for further explanation
    for(unsigned int vert_id = 0u; vert_id < NumVertices(); ++vert_id) {
      auto curr_vert = static_cast<Vertex>(vert_id);
      auto curr_ptr = GetFromVertex(curr_vert).value();
      if(curr_vert > vert) {
        ptr_to_vertex_[curr_ptr] = static_cast<Vertex>(vert_id - 1);
      }
    }

    // We call remove_vertex last because it can shift the vertex IDs of other vertices. If we
    // have a graph with 5 vertices, the IDs will be 0, 1, 2, 3, 4. If we remove vertex 1, boost
    // shifts the vertices as so: 1 is gone. 2 -> 1. 3 -> 2. 4 -> 3. The IDs are then 0, 1,
    // 2, 3. Boost ensures that the IDs are 0, 1, ..., n-1 for n vertices
    boost::remove_vertex(vert, dag_);
    ptr_to_vertex_.erase(ptr);
  }

  // Boost graph representation of the DAG
  DagT dag_;

  // Mapping of shared_ptr to vertex index
  std::unordered_map<std::shared_ptr<T>, Vertex> ptr_to_vertex_;
};

// Specialization for ScheduleEvent.
class ScheduleEventDag : public DagBase<ScheduleEvent> {
public:
  using VertexVec = std::vector<Vertex>;

  // Apply this DAG of events to the DiscreteGarageState.
  // This calls event->Apply() in topological order, to correctly mutate the DGS.
  // Example usage: copy the intial DGS, then apply this DAG to mutate the copy.
  BoolStringPair Apply(volley::DiscreteGarageState& state) const;

  bool AddEvent(const ScheduleEventSPtr& event) { return Add(event).has_value(); }
  bool HasEvent(const ScheduleEventSPtr& event) const { return Has(event); }

  std::optional<ScheduleEventSPtr> GetEventFromVertex(const Vertex& vertex) const {
    return GetFromVertex(vertex);
  }
  std::optional<Vertex> GetVertexFromEvent(const ScheduleEventSPtr& event) const { return GetVertex(event); }

  std::vector<ScheduleEventSPtr> GetLeafEvents() const;
  std::vector<ScheduleEventSPtr> GetRootEvents() const;

  // Create a topological ordering of the graph. If the graph is not a DAG, nullopt will be
  // returned. We override the DagBase class implementation to incorporate job ordering
  std::optional<VertexVec> GetTopologicalOrdering() const override;
};

}  // namespace volley
