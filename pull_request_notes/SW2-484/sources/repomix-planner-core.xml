#include "planner_core/event_dag.hpp"

namespace volley {

// Apply this DAG of events to the DiscreteGarageState.
// This calls event->Apply() in topological order, to correctly mutate the DGS.
// Example usage: copy the intial DGS, then apply this DAG to mutate the copy.
BoolStringPair ScheduleEventDag::Apply(volley::DiscreteGarageState& state) const {
  // NOLINTNEXTLINE
  auto topo_ordering = GetTopologicalOrdering();
  if(!topo_ordering.has_value()) {
    return {false, "The graph must be a DAG."};
  }

  for(auto vertex : topo_ordering.value()) {
    auto event = GetEventFromVertex(vertex).value();
    auto [success, error] = event->Apply(state);
    if(!success) {
      return {false, "Event " + std::to_string(*event) + ": " + error};
    }
  }
  return {true, ""};
}

std::vector<ScheduleEventSPtr> ScheduleEventDag::GetLeafEvents() const {
  std::vector<ScheduleEventSPtr> leaf_events;
  auto verts = GetLeafVertices();
  for(const auto& vertex : verts) {
    leaf_events.push_back(GetEventFromVertex(vertex).value());
  }
  return leaf_events;
}

std::vector<ScheduleEventSPtr> ScheduleEventDag::GetRootEvents() const {
  std::vector<ScheduleEventSPtr> root_events;
  auto verts = GetRootVertices();
  for(const auto& vertex : verts) {
    root_events.push_back(GetEventFromVertex(vertex).value());
  }
  // Sort so it's in ascending order of job index
  std::sort(root_events.begin(), root_events.end(),
      [](const ScheduleEventSPtr& event_a, const ScheduleEventSPtr& event_b) {
        return event_a->GetJobIndex() < event_b->GetJobIndex();
      });
  return root_events;
}

// Create a topological ordering of the graph. If the graph is not a DAG, nullopt will be
// returned. We override the DagBase class implementation to incorporate job ordering
std::optional<ScheduleEventDag::VertexVec> ScheduleEventDag::GetTopologicalOrdering() const {
  ScheduleEventDag::VertexVec topo_ordering;

  // Using lambda to compare vertices by the corresponding event's job index
  // We are using a min priority queue so that lower job indices appear first. That way the
  // earlier job's events get prioritized
  auto vert_cmp = [this](Vertex left, Vertex right) {
    return (GetEventFromVertex(left).value()->GetJobIndex()) >
           (GetEventFromVertex(right).value()->GetJobIndex());
  };
  std::priority_queue<Vertex, VertexVec, decltype(vert_cmp)> priority_q(vert_cmp);

  std::unordered_map<Vertex, int> live_in_degree_ctr;
  for(const auto& vert : boost::make_iterator_range(GetVertices())) {
    live_in_degree_ctr.insert({vert, boost::in_degree(vert, GetBaseGraph())});
    if(boost::in_degree(vert, GetBaseGraph()) == 0) {
      priority_q.push(vert);
    }
  }

  // If there's a cycle, not all the vertices will get visited. Count them as we go
  unsigned int count = 0;
  while(!priority_q.empty()) {
    Vertex u = priority_q.top();
    priority_q.pop();
    topo_ordering.push_back(u);

    for(const auto& edge : boost::make_iterator_range(GetOutEdges(u))) {
      auto dst = static_cast<Vertex>(edge.m_target);
      if(--live_in_degree_ctr[dst] == 0) {
        priority_q.push(dst);
      }
    }
    ++count;
  }

  // got a cycle
  if(count != NumVertices()) {
    return std::nullopt;
  }

  return topo_ordering;
}

}  // namespace volley
</file>

