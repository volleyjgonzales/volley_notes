private:
  // Discrete state change
  VecsStateChangedMsg state_change_;
};

// A VrcTransition represents a desired VRC floor change. It stores the from/to VRC
// node IDs so that any entity riding the VRC can be teleported in the discrete state simulation.
class VrcTransition : public ScheduleEvent {
public:
  explicit VrcTransition(unsigned int job_index, const VrcStateChangedMsg& state_change,
      uint32_t from_vrc_node_id, uint32_t to_vrc_node_id);

  const VrcStateChangedMsg& GetStateChange() const { return state_change_; }
  uint16_t GetVrcId() const { return state_change_.current_discrete_state.id; }
  uint16_t GetRequestedFloor() const { return state_change_.next_discrete_state.current_floor; }
  uint32_t GetFromVrcNodeId() const { return from_vrc_node_id_; }
  uint32_t GetToVrcNodeId() const { return to_vrc_node_id_; }

  std::optional<GarageEntityIdMsg> GetGarageEntityId() const override { return volley::VrcId(GetVrcId()); }

  // Apply to DiscreteGarageState (two-step: IDLE→MOVING then MOVING→IDLE@new_floor + entity teleport)
  // NOLINTNEXTLINE(google-runtime-references)
  BoolStringPair Apply(volley::DiscreteGarageState& state) const override;

  std::string ToString() const override {
    std::string result = ScheduleEvent::ToString();
    result += " Vrc " + std::to_string(GetVrcId());
    result += " floor " + std::to_string(state_change_.current_discrete_state.current_floor);
    result += " -> " + std::to_string(state_change_.next_discrete_state.current_floor);
    return result;
  }

private:
  VrcStateChangedMsg state_change_;
  uint32_t from_vrc_node_id_;
  uint32_t to_vrc_node_id_;
};

