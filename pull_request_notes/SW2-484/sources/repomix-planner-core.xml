enum class ScheduleEventType : uint8_t {
  UNDEFINED = 0,
  AGV_MOVE = 1,
  BAY_TRANSITION = 2,
  TRAY_MOVE = 3,
  VECS_TRANSITION = 4,
  VRC_TRANSITION = 5,
};

// A ScheduleEvent represents a node in the Action DAG.
class ScheduleEvent {
private:
  // C++ "Rule-of-5" is not needed.
  ScheduleEvent& operator=(ScheduleEvent const&) = default;
  ScheduleEvent& operator=(ScheduleEvent&&) = default;

public:
  explicit ScheduleEvent(ScheduleEventType type, unsigned int job_index) :
      type_(type), job_idx_(job_index) { }

  ScheduleEvent() = delete;
  virtual ~ScheduleEvent() = default;

  // C++ "Rule-of-5"
  ScheduleEvent(ScheduleEvent&&) = default;
  ScheduleEvent(ScheduleEvent const&) = default;

  virtual BoolStringPair Apply(volley::DiscreteGarageState& state) const = 0;
  virtual std::optional<GarageEntityIdMsg> GetGarageEntityId() const = 0;
  unsigned int GetJobIndex() const { return job_idx_; }
  ScheduleEventType GetType() const { return type_; }

  virtual std::string ToString() const {
    return "Task ID: " + std::to_string(GetJobIndex()) + " " + common::EnumNameString(GetType());
  }

private:
  // The type of Schedule Event of this instance
  ScheduleEventType type_;

  // The ID of the task that this event is associated with
  unsigned int job_idx_;
};

using ScheduleEventSPtr = std::shared_ptr<ScheduleEvent>;

// An AgvMove represents a desired AGV move that is either a lift/lower or a move. If it's a
// move, it's simply the source and destination; the intermediate moves are still to be planned.
class AgvMove : public ScheduleEvent {
public:
  explicit AgvMove(unsigned int job_index, const std::variant<AgvLiftChangedMsg, AgvPoseChangedMsg>& change);

  const std::variant<AgvLiftChangedMsg, AgvPoseChangedMsg>& GetDiscreteChange() const {
    return discrete_change_;
  }
  void SetDiscreteChange(const std::variant<AgvLiftChangedMsg, AgvPoseChangedMsg>& discrete_change) {
    discrete_change_ = discrete_change;
  }

  uint16_t GetAgvId() const;

  std::optional<GarageEntityIdMsg> GetGarageEntityId() const override { return volley::AgvId(GetAgvId()); }

  // TODO(any) these aren't implemented anywhere
  // also if all we store is AgvLiftChanged for a lift discrete event then
  // there's nowhere to get the AGV's pose from
  void SetDest(AgvGoalMsg goal);
  void SetSrc(AgvGoalMsg src);

  // Returns nullopt if it's a lift change
  std::optional<GaragePoseMsg> GetSrc() const;
  std::optional<GaragePoseMsg> GetDest() const;

  std::string ToString() const override {
    std::string result = ScheduleEvent::ToString();
    result += " Agv ID: ";
    result += std::to_string(GetAgvId());
    std::visit(
        [&result](auto&& arg) { result += " Discrete Change: " + std::to_string(arg); }, discrete_change_);
    return result;
  }

  // Apply to DiscreteGarageState
  // NOLINTNEXTLINE(google-runtime-references)
  BoolStringPair Apply(volley::DiscreteGarageState& state) const override;

private:
  // This class is either a lift/lower or a move, which is easily encapsulated in a
  // std::variant<AgvLiftChangedMsg, AgvPoseChangedMsg>
  std::variant<AgvLiftChangedMsg, AgvPoseChangedMsg> discrete_change_;
};

// An TrayMove represents a desired Tray move that has a source and
// destination defined, but the intermediate moves are still to be planned. It can
// be either expanded or not. If it is NOT expanded, the tray is moved (teleported)
// directly to the destination with no regard for any blocking trays, etc. If it is
// expanded, then it stores the sequence of underlying AGV moves that correspond to
// the desired tray move.  Note that the correctness of the underlying AGV moves is
// not checked.
class TrayMove : public ScheduleEvent {
public:
  explicit TrayMove(unsigned int job_index);

  bool Assigned() const { return tray_id_ && dest_; }

  std::optional<uint16_t> GetTrayId() const { return tray_id_; }
  void SetTrayId(uint16_t id) { tray_id_ = id; }

  // Not sure this is safe, have to see where we have an unassigned tray move, we might
  // end up missing some needed dependency if the tray selected in tray assignments has
  // some other moves before and after it. Will need to splice but won't know our position
  // in the total order I believe. If there are any bugs caused by this, I'm sorry.
  std::optional<GarageEntityIdMsg> GetGarageEntityId() const override {
    if(tray_id_) {
      return volley::TrayId(GetTrayId().value());
    }
    return std::nullopt;
  }

  std::optional<GaragePoseMsg> GetDest() const { return dest_; }
  void SetDest(GaragePoseMsg dest) { dest_ = dest; }

  std::optional<uint16_t> GetAgvId() const { return agv_id_; }
  void SetAgvId(uint16_t id) { agv_id_ = id; }

  // Apply to DiscreteGarageState
  // NOLINTNEXTLINE(google-runtime-references)
  BoolStringPair Apply(volley::DiscreteGarageState& state) const override;

  std::string ToString() const override;

private:
  std::optional<uint16_t> tray_id_;
  std::optional<uint16_t> agv_id_;
  std::optional<GaragePoseMsg> dest_;
};

// An BayTransition represents a desired Bay Transition from source state to destination
// state, but the dependencies of this action are not yet determined
class BayTransition : public ScheduleEvent {
public:
  explicit BayTransition(
      unsigned int job_index, const DiscreteBayStateMsg& src_state, const BayCommandMsg& command);

  const DiscreteBayStateMsg& GetSourceState() const { return src_state_; }
  const BayCommandMsg& GetCommand() const { return command_; }
  uint16_t GetBayId() const { return src_state_.id; }

  std::optional<GarageEntityIdMsg> GetGarageEntityId() const override { return volley::BayId(GetBayId()); }

  void SetSourceState(const DiscreteBayStateMsg& src_state) { src_state_ = src_state; }
  void SetCommand(const BayCommandMsg& command) { command_ = command; }

  // Apply to DiscreteGarageState
  // NOLINTNEXTLINE(google-runtime-references)
  BoolStringPair Apply(volley::DiscreteGarageState& state) const override;

  std::string ToString() const override {
    std::string result = ScheduleEvent::ToString();
    result += " Bay Id: " + std::to_string(GetBayId());
    result += " State: " + std::to_string(src_state_.state);
    result += " Command: " + std::to_string(command_.command_type);
    return result;
  }

private:
  // The source state of the bay and the command to take it to it's desired destination state
  DiscreteBayStateMsg src_state_;
  BayCommandMsg command_;
};

// An VecsTransition represents a desired VECS Transition from source state to destination
// state, but the dependencies of this action are not yet determined
class VecsTransition : public ScheduleEvent {
public:
  explicit VecsTransition(unsigned int job_index, const VecsStateChangedMsg& state_change);

  const VecsStateChangedMsg& GetStateChange() const { return state_change_; }
  uint16_t GetVecsId() const { return state_change_.vecs_id; }
