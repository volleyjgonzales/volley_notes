<file path="test/math_test.cpp">
#include "vis/math.hpp"

#include <gtest/gtest.h>

#include <common/constants.hpp>
#include <geometry_msgs/msg/point.hpp>
#include <geometry_msgs/msg/pose.hpp>
#include <geometry_msgs/msg/quaternion.hpp>

namespace volley::vis {
constexpr double kEpsilon = 1e-6;

TEST(GeometryUtils, Point) {
  geometry_msgs::msg::Point point = Point(1.0, 2.0, 3.0);
  EXPECT_EQ(point.x, 1.0);
  EXPECT_EQ(point.y, 2.0);
  EXPECT_EQ(point.z, 3.0);
}

TEST(GeometryUtils, Quaternion) {
  geometry_msgs::msg::Quaternion quat = Quaternion(0.0, 0.0, 0.0);
  EXPECT_EQ(quat.w, 1.0);
  EXPECT_EQ(quat.x, 0.0);
  EXPECT_EQ(quat.y, 0.0);
  EXPECT_EQ(quat.z, 0.0);

  quat = Quaternion(0.0, 0.0, 90.0 * kDeg2Rad);
  EXPECT_NEAR(quat.w, 0.707107, kEpsilon);
  EXPECT_EQ(quat.x, 0.0);
  EXPECT_EQ(quat.y, 0.0);
  EXPECT_NEAR(quat.z, 0.707107, kEpsilon);

  quat = Quaternion(0.4, 0.6, 0.8);
  EXPECT_NEAR(quat.w, 0.885246, kEpsilon);
  EXPECT_NEAR(quat.x, 0.062026, kEpsilon);
  EXPECT_NEAR(quat.y, 0.340676, kEpsilon);
  EXPECT_NEAR(quat.z, 0.310534, kEpsilon);
}

TEST(GeometryUtils, QuatToQuatd) {
  geometry_msgs::msg::Quaternion quat = Quaternion(0.1, -0.2, 0.3);
  Eigen::Quaterniond quatd = QuatToQuatd(quat);
  EXPECT_EQ(quatd.w(), quat.w);
  EXPECT_EQ(quatd.x(), quat.x);
  EXPECT_EQ(quatd.y(), quat.y);
  EXPECT_EQ(quatd.z(), quat.z);
}

TEST(GeometryUtils, QuatdToQuat) {
  Eigen::Quaterniond quatd {0.1, 0.2, 0.3, -0.4};
  geometry_msgs::msg::Quaternion quat = QuatdToQuat(quatd);
  EXPECT_EQ(quatd.w(), quat.w);
  EXPECT_EQ(quatd.x(), quat.x);
  EXPECT_EQ(quatd.y(), quat.y);
  EXPECT_EQ(quatd.z(), quat.z);
}

TEST(GeometryUtils, PoseMultiplication) {
  geometry_msgs::msg::Pose pose_global, pose_local;
  pose_global.position = Point(1.0, 2.0, 3.0);
  pose_global.orientation = Quaternion(0.1, 0.2, 0.3);
  pose_local.position = Point(0, 0, 0);
  pose_local.orientation = Quaternion(0, 0, 0);

  // Identity local pose moved by a global pose results in the global pose.
  geometry_msgs::msg::Pose pose_total = pose_global * pose_local;
  EXPECT_EQ(pose_total.position.x, pose_global.position.x);
  EXPECT_EQ(pose_total.position.y, pose_global.position.y);
  EXPECT_EQ(pose_total.position.z, pose_global.position.z);
  EXPECT_EQ(pose_total.orientation.w, pose_global.orientation.w);
  EXPECT_EQ(pose_total.orientation.x, pose_global.orientation.x);
  EXPECT_EQ(pose_total.orientation.y, pose_global.orientation.y);
  EXPECT_EQ(pose_total.orientation.z, pose_global.orientation.z);

  pose_global.orientation = Quaternion(0, 0, 0);
  pose_local.position = Point(4, -5, 6);
  pose_local.orientation = Quaternion(0, 0, 0);

  // Without rotation, positions are additive.
  pose_total = pose_global * pose_local;
  EXPECT_EQ(pose_total.position.x, pose_global.position.x + pose_local.position.x);
  EXPECT_EQ(pose_total.position.y, pose_global.position.y + pose_local.position.y);
  EXPECT_EQ(pose_total.position.z, pose_global.position.z + pose_local.position.z);
  EXPECT_EQ(pose_total.orientation.w, pose_global.orientation.w);
  EXPECT_EQ(pose_total.orientation.x, pose_global.orientation.x);
  EXPECT_EQ(pose_total.orientation.y, pose_global.orientation.y);
  EXPECT_EQ(pose_total.orientation.z, pose_global.orientation.z);

  pose_global.orientation = Quaternion(0, 0, 0.5);
  pose_local.position = Point(0, 0, 0);
  pose_local.orientation = Quaternion(0, 0, 0.5);
  geometry_msgs::msg::Quaternion expected_orientation = Quaternion(0, 0, 1);

  // Without positions, rotations are additive.
  pose_total = pose_global * pose_local;
  EXPECT_EQ(pose_total.position.x, pose_global.position.x + pose_local.position.x);
  EXPECT_EQ(pose_total.position.y, pose_global.position.y + pose_local.position.y);
  EXPECT_EQ(pose_total.position.z, pose_global.position.z + pose_local.position.z);
  EXPECT_DOUBLE_EQ(pose_total.orientation.w, expected_orientation.w);
  EXPECT_EQ(pose_total.orientation.x, expected_orientation.x);
  EXPECT_EQ(pose_total.orientation.y, expected_orientation.y);
  EXPECT_DOUBLE_EQ(pose_total.orientation.z, expected_orientation.z);

  pose_global.orientation = Quaternion(0, 0, 0.1);
  pose_local.position = Point(4, 5, 6);
  pose_local.orientation = Quaternion(0, 0, 0.2);
  expected_orientation = Quaternion(0, 0, 0.3);

  // Full rotation and translation.
  pose_total = pose_global * pose_local;
  EXPECT_NEAR(pose_total.position.x, 4.48085, 1e-4);
  EXPECT_NEAR(pose_total.position.y, 7.37435, 1e-4);
  EXPECT_EQ(pose_total.position.z, 9);
  EXPECT_DOUBLE_EQ(pose_total.orientation.w, expected_orientation.w);
  EXPECT_EQ(pose_total.orientation.x, expected_orientation.x);
  EXPECT_EQ(pose_total.orientation.y, expected_orientation.y);
  EXPECT_DOUBLE_EQ(pose_total.orientation.z, expected_orientation.z);
}

}  // namespace volley::vis
</file>

