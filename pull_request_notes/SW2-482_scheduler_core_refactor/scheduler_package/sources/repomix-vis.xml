#include "vis/visualizer/layout_visualizer.hpp"

#include <common/constants.hpp>
#include <common/geometry_utils.hpp>
#include <common_ros/tape_layout.hpp>

#include "vis/math.hpp"
#include "vis/models.hpp"
#include "vis/topics.hpp"
#include "vis/utils.hpp"
#include "vis/vis_context.hpp"
#include "vis/visualizer/i_visualizer.hpp"

namespace volley::vis {

LayoutVisualizer::LayoutVisualizer(VisContextSPtr context) :
    IVisualizer(std::move(context)),
    garage_layout_(context_->GetLayout()->GetGarageLayout()),
    tape_edges_(ComputeAllConsolidatedTapeSegments(*(context_->GetLayout()))) {
}

std::vector<VisMessage> LayoutVisualizer::GetVisMessages() {
  if(vis_messages_.has_value()) {
    return vis_messages_.value();
  }

  vis_messages_ = {
      {.topic_name = topics::kEdges, .marker_array = CreateEdgesMarkerArray()},
      {.topic_name = topics::kTape, .marker_array = CreateTapeMarkerArray()},
      {.topic_name = topics::kNodes, .marker_array = CreateNodesMarkerArray()},
      {.topic_name = topics::kLayoutSpaces, .marker_array = CreateLayoutSpacesMarkerArray()},
      {.topic_name = topics::kChargers, .marker_array = CreateChargersMarkerArray()},
      {.topic_name = topics::kEnvironment, .marker_array = CreateEnvironmentMarkerArray()},
  };

  return vis_messages_.value();
}

visualization_msgs::msg::MarkerArray LayoutVisualizer::CreateEdgesMarkerArray() {
  static constexpr float kEdgeLineWidthM = 0.15;

  visualization_msgs::msg::Marker marker = CreateDefaultMarker(context_->GetTimeNow(), topics::kEdges, 0);
  marker.type = visualization_msgs::msg::Marker::LINE_LIST;
  marker.scale.x = kEdgeLineWidthM;
  marker.color = CreateColorRGBA(0, 0.5, 1, 0.5);
  marker.pose.position.x = 0.0;
  marker.pose.position.y = 0.0;
  marker.pose.position.z = 0.0;

  for(const auto& edge : garage_layout_.edges) {
    const auto& src_node = garage_layout_.nodes.at(edge.src);
    const auto& dst_node = garage_layout_.nodes.at(edge.dst);
    const float src_z = context_->GetLayout()->GetFloorZForNodeId(src_node.id).value_or(0);
    const float dst_z = context_->GetLayout()->GetFloorZForNodeId(dst_node.id).value_or(0);
    marker.points.emplace_back(Point(src_node.x, src_node.y, src_z));
    marker.points.emplace_back(Point(dst_node.x, dst_node.y, dst_z));
  }

  visualization_msgs::msg::MarkerArray marker_array;
  marker_array.markers.push_back(std::move(marker));
  return marker_array;
}

visualization_msgs::msg::MarkerArray LayoutVisualizer::CreateTapeMarkerArray() {
  static constexpr float kTapeLineWidthM = 0.05;
  static constexpr float kTapeZOffsetM = 0.01;

  visualization_msgs::msg::Marker marker = CreateDefaultMarker(context_->GetTimeNow(), topics::kEdges, 0);
  marker.type = visualization_msgs::msg::Marker::LINE_LIST;
  marker.scale.x = kTapeLineWidthM;
  marker.color = CreateColorRGBA(1.0, 1.0, 0.0);
  for(const auto& edge : tape_edges_) {
    const float tape_z = context_->GetLayout()->GetFloorZForFloorId(edge.floor).value_or(0) + kTapeZOffsetM;
    marker.points.emplace_back(Point(edge.p1.x(), edge.p1.y(), tape_z));
    marker.points.emplace_back(Point(edge.p2.x(), edge.p2.y(), tape_z));
  }

  visualization_msgs::msg::MarkerArray marker_array;
  marker_array.markers.push_back(std::move(marker));
  return marker_array;
}

visualization_msgs::msg::MarkerArray LayoutVisualizer::CreateNodesMarkerArray() {
  visualization_msgs::msg::MarkerArray marker_array;

  for(const auto& node : garage_layout_.nodes) {
    const visualization_msgs::msg::Marker node_marker = CreateNodeCenterMarker(node);
    marker_array.markers.push_back(node_marker);

    if(node.rotation_allowed) {
      // Render a cylinder to indicate rotation
      visualization_msgs::msg::Marker rotation_marker =
          CreateDefaultMarker(context_->GetTimeNow(), topics::kNodes + "_rotation", node.id);
      rotation_marker.type = visualization_msgs::msg::Marker::CYLINDER;
      rotation_marker.pose = node_marker.pose;
      rotation_marker.color = CreateColorRGBA(0.0, 0.5, 1.0, 0.5);
      rotation_marker.scale.x = 1.0;
      rotation_marker.scale.y = 1.0;
      rotation_marker.scale.z = node_marker.scale.z;
      marker_array.markers.push_back(std::move(rotation_marker));
    }

    // Add the node id text on the node
    visualization_msgs::msg::Marker text_marker =
        CreateDefaultMarker(context_->GetTimeNow(), topics::kNodes + "_text", node.id);
    text_marker.type = visualization_msgs::msg::Marker::TEXT_VIEW_FACING;
    text_marker.text = std::to_string(node.id);
    text_marker.color = node_marker.color;
    text_marker.pose = node_marker.pose;
    text_marker.pose.position.z += 0.25;
    text_marker.scale.z = 0.5f;
    marker_array.markers.push_back(std::move(text_marker));
  }

  return marker_array;
}

visualization_msgs::msg::MarkerArray LayoutVisualizer::CreateLayoutSpacesMarkerArray() {
  visualization_msgs::msg::MarkerArray marker_array;

  for(const auto& node : garage_layout_.nodes) {
    if(node.rotation_allowed) {
      marker_array.markers.push_back(CreationRotationalLayoutSpaceMarker(node));
    }
    else {
      for(const int heading : node.headings) {
        marker_array.markers.push_back(CreateRectangularLayoutSpaceMarker(node, heading));
      }
    }
  }

  return marker_array;
}

visualization_msgs::msg::MarkerArray LayoutVisualizer::CreateChargersMarkerArray() {
  visualization_msgs::msg::MarkerArray marker_array;

  for(const auto& node : garage_layout_.nodes) {
    if(node.type != interfaces::msg::GarageNode::TYPE_AGV_CHARGE) {
      continue;
    }

    visualization_msgs::msg::Marker marker =
        CreateDefaultMarker(context_->GetTimeNow(), topics::kChargers, node.id);
    marker.type = visualization_msgs::msg::Marker::CUBE;
    marker.color = CreateColorRGBA(1.0, 0.65, 0.0);

    const double charger_yaw = GetInboundHeading(node) * kDeg2Rad;

    // Get the center of the charger relative to its charge node pose
    // The charger is located in the direction opposite of the charge node's orientation
    geometry_msgs::msg::Pose charger_pose;
    charger_pose.position.x = (kChargerLateralOffsetFromAgv + kAgvWidth / 2 + kChargerDepth / 2);

    // Rotate the pose relative to the charger frame
    geometry_msgs::msg::Pose node_pose {};
    node_pose.position.x = node.x;
    node_pose.position.y = node.y;
    node_pose.position.z =
        context_->GetLayout()->GetFloorZForNodeId(node.id).value_or(0) + kChargerHeight / 2;
    node_pose.orientation = Quaternion(0.0, 0.0, charger_yaw);

    marker.pose = node_pose * charger_pose;
    marker.scale.z = kChargerHeight;
    marker.scale.x = kChargerDepth;
    marker.scale.y = kChargerWidth;

    marker_array.markers.push_back(std::move(marker));
  }

  return marker_array;
}

visualization_msgs::msg::MarkerArray LayoutVisualizer::CreateEnvironmentMarkerArray() {
  visualization_msgs::msg::MarkerArray marker_array;

  static constexpr float kBoundsLineWidthM = 0.05;

  float min_x = std::numeric_limits<float>::max();
  float min_y = std::numeric_limits<float>::max();
  float max_x = std::numeric_limits<float>::min();
  float max_y = std::numeric_limits<float>::min();

  for(const auto& node : garage_layout_.nodes) {
    min_x = std::min(min_x, node.x);
    min_y = std::min(min_y, node.y);
    max_x = std::max(max_x, node.x);
    max_y = std::max(max_y, node.y);
  }

  const float floor_width_m = fabsf(max_x - min_x);
  const float floor_length_m = fabsf(max_y - min_y);

  // Draw the garage layout bounding box.
  for(const auto& floor : context_->GetLayout()->GetFloors()) {
    visualization_msgs::msg::Marker bounds_marker =
        CreateDefaultMarker(context_->GetTimeNow(), topics::kEnvironment + "_bounds", floor.id);
    bounds_marker.type = visualization_msgs::msg::Marker::LINE_STRIP;
    bounds_marker.scale.x = kBoundsLineWidthM;
    bounds_marker.color = CreateColorRGBA(1.0, 0.0, 1.0, 0.5);
    bounds_marker.pose.position = Point(0.0, 0.0, 0.0);
    bounds_marker.pose.orientation = Quaternion(0.0, 0.0, 0.0);
    bounds_marker.points.push_back(Point(min_x, min_y, floor.z));
    bounds_marker.points.push_back(Point(max_x, min_y, floor.z));
    bounds_marker.points.push_back(Point(max_x, max_y, floor.z));
    bounds_marker.points.push_back(Point(min_x, max_y, floor.z));
    bounds_marker.points.push_back(Point(min_x, min_y, floor.z));
    marker_array.markers.push_back(std::move(bounds_marker));

    // Floor
    visualization_msgs::msg::Marker floor_marker =
        CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kEnvironment + "_floor", floor.id);
    floor_marker.mesh_resource = context_->GetMeshResourcePrefix() + kFloorModelFilename;
    floor_marker.color = CreateColorRGBA(0.7, 0.7, 0.7, 0.1);
    floor_marker.pose.orientation = Quaternion(0.0, 0.0, 0.0);
    const float with_margin = 1.35;
    const float half_margin = 0.175;
    floor_marker.scale.x = floor_width_m * with_margin;
    floor_marker.scale.y = floor_length_m * with_margin;
    floor_marker.scale.z = 1.0f;
    floor_marker.pose.position = Point(
        min_x - (floor_width_m * half_margin), min_y - (floor_length_m * half_margin), floor.z - 0.025f);
    marker_array.markers.push_back(std::move(floor_marker));
  }

  return marker_array;
}

visualization_msgs::msg::Marker LayoutVisualizer::CreateNodeCenterMarker(
    const interfaces::msg::GarageNode& node) {
  visualization_msgs::msg::Marker marker =
      CreateDefaultMarker(context_->GetTimeNow(), topics::kNodes, node.id);
  marker.type = visualization_msgs::msg::Marker::CYLINDER;
  marker.pose.position =
      Point(node.x, node.y, context_->GetLayout()->GetFloorZForFloorId(node.floor).value_or(0));
  marker.pose.orientation = Quaternion(0.0, 0.0, 0.0);
  marker.scale.z = 0.2f;
  marker.scale.x = 0.25f;
  marker.scale.y = 0.25f;
  marker.color = CreateColorRGBA(1.0, 1.0, 0.0);

  // TODO(justin): handle disabled node
  bool disabled = false;
  // if(*ctx_.has_dgs) {
  //   disabled = ctx_.state->IsNodeDisabled(node.id);
  // }

  if(disabled) {
    marker.color = CreateColorRGBA(1.0, 0.0, 0.5);
  }
  else {
    if(node.type == interfaces::msg::GarageNode::TYPE_PARKING) {
      marker.color = CreateColorRGBA(0.1, 0.63, 0.91);  // Blue
    }
    else if(node.type == interfaces::msg::GarageNode::TYPE_LIFT) {
      marker.color = CreateColorRGBA(0.7, 0.0, 0.6);  // Purple-ish
    }
    else if(node.type == interfaces::msg::GarageNode::TYPE_BAY) {
      marker.color = CreateColorRGBA(1.0, 0.64, 0.0);  // Orange
    }
    else if(node.type == interfaces::msg::GarageNode::TYPE_AGV_CHARGE) {
      marker.color = CreateColorRGBA(0.0, 1.0, 0.0);  // Green
    }
    else if(node.type == interfaces::msg::GarageNode::TYPE_EV_CHARGE) {
      marker.color = CreateColorRGBA(0.1, 0.82, 0.92);  // sky blue
    }
  }

  return marker;
}

visualization_msgs::msg::Marker LayoutVisualizer::CreateRectangularLayoutSpaceMarker(
    const interfaces::msg::GarageNode& node, const int heading) {
  const std::string marker_ns = topics::kLayoutSpaces + "_rectangular_" + std::to_string(node.id);
  visualization_msgs::msg::Marker marker = CreateDefaultMarker(context_->GetTimeNow(), marker_ns, heading);
  marker.type = visualization_msgs::msg::Marker::CUBE;
  marker.pose.position =
      Point(node.x, node.y, context_->GetLayout()->GetFloorZForNodeId(node.id).value_or(0));
  marker.pose.orientation = Quaternion(0.0, 0.0, heading * kDeg2Rad);
  marker.scale.z = 0.05;

  marker.color = CreateColorRGBA(0.67, 0.67, 0.67);
  // Make parking spots a bit darker for visibility
  marker.color.a = node.type == interfaces::msg::GarageNode::TYPE_PARKING ? 0.5 : 0.25;

  // Note that we add our parking window buffer to show the collision volume used when
  // computing overlaps
  const auto window_opt = context_->GetLayout()->GetBufferedResourceWindow(node.max_resource_size);
  if(window_opt.has_value()) {
    marker.scale.x = window_opt.value().width_m;
    marker.scale.y = window_opt.value().length_m;
  }

  return marker;
}

visualization_msgs::msg::Marker LayoutVisualizer::CreationRotationalLayoutSpaceMarker(
    const interfaces::msg::GarageNode& node) {
  const int heading = !node.headings.empty() ? node.headings.at(0) : 0;
  // Start by copying any parking space marker for this node with any heading
  visualization_msgs::msg::Marker marker = CreateRectangularLayoutSpaceMarker(node, heading);
  marker.ns = topics::kLayoutSpaces + "_rotational_" + std::to_string(node.id);
  marker.id = 0;
  marker.type = visualization_msgs::msg::Marker::CYLINDER;

  double radius = 1.0;  // Default to a small radius
  const auto window_opt = context_->GetLayout()->GetBufferedResourceWindow(node.max_resource_size);
  if(window_opt.has_value()) {
    radius = std::hypot(window_opt.value().width_m, window_opt.value().length_m);
  }

  marker.scale.x = radius;
  marker.scale.y = marker.scale.x;
  return marker;
}

}  // namespace volley::vis
</file>

