namespace volley::vis {

TrayVisualizer::TrayVisualizer(VisContextSPtr context) : IVisualizer(std::move(context)) {
}

std::vector<VisMessage> TrayVisualizer::GetVisMessages() {
  return {{.topic_name = topics::kTrays, .marker_array = CreateTraysMarkerArray()},
      {.topic_name = topics::kPayloads, .marker_array = CreatePayloadsMarkerArray()}};
}

void TrayVisualizer::HandleGarageSnapshot(interfaces::msg::GarageSnapshot::ConstSharedPtr garage_snapshot) {
  payloads_.clear();
  for(const auto& garage_payload : garage_snapshot->payloads) {
    const std::string id_str = GuidToString(garage_payload.payload.id);
    payloads_[id_str] = garage_payload;
  }

  trays_.clear();
  for(const auto& garage_tray : garage_snapshot->trays) {
    trays_[garage_tray.id] = garage_tray;

    const uint32_t tray_node_id = garage_tray.pose.node_id;

    // Check if the tray is on a node that belongs to a VRC. If so, update the VRC height to be the carriage
    // height from the garage_snapshot, nullopt otherwise
    std::optional<float> vrc_height_m = std::nullopt;
    for(const auto& vrc_report : garage_snapshot->vrcs) {
      const auto vrc_layout = context_->GetLayout()->GetVrc(vrc_report.id);
      if(!vrc_layout.has_value()) {
        continue;
      }

      for(const auto& vrc_node : vrc_layout.value().nodes) {
        if(tray_node_id == vrc_node.id) {
          vrc_height_m = vrc_report.carriage_height_m;
        }
      }
    }

    tray_to_vrc_height_[garage_tray.id] = vrc_height_m;
    payload_to_vrc_height_[garage_tray.payload_id] = vrc_height_m;
  }
}

visualization_msgs::msg::MarkerArray TrayVisualizer::CreateTraysMarkerArray() {
  visualization_msgs::msg::MarkerArray marker_array;

  const auto GetTrayZ = [&](const interfaces::msg::GarageTray tray) {
    if(tray_to_vrc_height_.contains(tray.id) && tray_to_vrc_height_.at(tray.id).has_value()) {
      return tray_to_vrc_height_.at(tray.id).value();
    }
    else {
      return context_->GetLayout()->GetFloorZForFloorId(tray.floor).value_or(0);
    }
  };

  for(const auto& [tray_id, tray] : trays_) {
    const geometry_msgs::msg::Point tray_position =
        Point(tray.geometric_pose.x, tray.geometric_pose.y, GetTrayZ(tray));

    visualization_msgs::msg::Marker tray_marker =
        CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kTrays, tray_id);
    tray_marker.mesh_resource = context_->GetMeshResourcePrefix() + kTrayModelFilename;

    tray_marker.pose.position = tray_position;
    tray_marker.pose.orientation = Quaternion(0.0, 0.0, tray.geometric_pose.yaw);

    marker_array.markers.push_back(tray_marker);

    visualization_msgs::msg::Marker text_marker =
        CreateDefaultMarker(context_->GetTimeNow(), topics::kTrays + "_text", tray_id);
    text_marker.type = visualization_msgs::msg::Marker::TEXT_VIEW_FACING;
    text_marker.text = std::to_string(tray_id);
    text_marker.pose.position = tray_position;
    text_marker.pose.position.z += 0.65;
    text_marker.scale.x = 0.25;
    text_marker.scale.y = 0.25;
    text_marker.scale.z = 0.25;
    text_marker.color = CreateColorRGBA(1.0, 1.0, 1.0, 0.9);

    marker_array.markers.push_back(text_marker);
  }

  return marker_array;
}

visualization_msgs::msg::MarkerArray TrayVisualizer::CreatePayloadsMarkerArray() {
  visualization_msgs::msg::MarkerArray marker_array;

  const auto GetPayloadZ = [&](const interfaces::msg::GaragePayload payload) {
    const auto guid = payload.payload.id;
    if(payload_to_vrc_height_.contains(guid) && payload_to_vrc_height_.at(guid).has_value()) {
      return payload_to_vrc_height_.at(guid).value();
    }
    else {
      return context_->GetLayout()->GetFloorZForFloorId(payload.floor).value_or(0);
    }
  };

  for(const auto& [payload_id, payload] : payloads_) {
    const auto z = static_cast<float>(GetPayloadZ(payload) + kAgvHeightRaised + (kTrayThickness / 2));
    const auto position = Point(payload.geometric_pose.x, payload.geometric_pose.y, z);
    const auto orientation = Quaternion(0.0, 0.0, payload.geometric_pose.yaw);
    for(auto& m : CreatePayloadMarkers(context_->GetTimeNow(), context_->GetMeshResourcePrefix(),
            std::format("{}_{}", topics::kPayloads, payload_id), 0, GetCarModelFromGuid(payload.payload.id),
            position, orientation, GetColorFromGuid(payload.payload.id))) {
      marker_array.markers.push_back(std::move(m));
    }
  }

  return marker_array;
}

}  // namespace volley::vis
