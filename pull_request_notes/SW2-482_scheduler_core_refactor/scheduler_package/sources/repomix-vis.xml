#include "vis/visualizer/i_visualizer.hpp"

namespace volley::vis {

BayVisualizer::BayVisualizer(VisContextSPtr context) : IVisualizer(std::move(context)) {
}

std::vector<VisMessage> BayVisualizer::GetVisMessages() {
  return {VisMessage {.topic_name = topics::kBays, .marker_array = CreateBaysMarkerArray()}};
}

void BayVisualizer::HandleGarageSnapshot(interfaces::msg::GarageSnapshot::ConstSharedPtr garage_snapshot) {
  for(const auto& bay_state : garage_snapshot->bays) {
    bay_states_[bay_state.id] = bay_state;
  }
}

visualization_msgs::msg::MarkerArray BayVisualizer::CreateBaysMarkerArray() {
  visualization_msgs::msg::MarkerArray marker_array;

  for(const auto& node_id : context_->GetLayout()->GetBayLikeNodeIds()) {
    const auto node = context_->GetLayout()->GetNodeById(node_id);
    if(!node.has_value()) {
      continue;
    }

    const std::vector<visualization_msgs::msg::Marker> markers = CreateBayMarkers(node.value());
    marker_array.markers.insert(marker_array.markers.end(), markers.begin(), markers.end());
  }

  return marker_array;
}

std::vector<visualization_msgs::msg::Marker> BayVisualizer::CreateBayMarkers(
    const interfaces::msg::GarageNode& node) {
  std::vector<visualization_msgs::msg::Marker> markers;

  if(!bay_states_.contains(node.id)) {
    return markers;
  }

  const interfaces::msg::BayState& bay_state = bay_states_.at(node.id);
  const LayoutSPtr& layout = context_->GetLayout();

  const int bay_heading_deg = node.headings.at(0) + 180 * node.faces_reciprocal;
  geometry_msgs::msg::Pose bay_pose;
  bay_pose.position = Point(node.x, node.y, layout->GetFloorZForFloorId(node.floor).value_or(0));
  bay_pose.orientation = Quaternion(0.0, 0.0, bay_heading_deg * kDeg2Rad);
  const bool is_blift = (node.type == GarageNodeMsg::TYPE_BLIFT);

  // Overdrive plate. Slides linearly between its in (offset 0) and out
  // (offset kModelOriginOffsetM) positions while the bay's door state machines report any
  // ODP/system door as MOVING or OPEN. The animation runs at a fixed speed matching the
  // sim's bay.door.{open,close}_time so the marker reaches its destination right around
  // when the door state machine settles.
  const auto odp_filename = GetBayPieceFilename(BayPiece::FLOOR_OVERDRIVE_PLATE, is_blift);
  if(odp_filename.has_value()) {
    static constexpr float kModelOriginOffsetM = 2.4384f;  // 8 feet in meters
    static constexpr float kOdpTravelTimeS = 4.0f;         // matches bay.door.open_time
    static constexpr float kOdpSpeedMps = kModelOriginOffsetM / kOdpTravelTimeS;

    visualization_msgs::msg::Marker marker =
        CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kBays + "_overdrive_plate", node.id);
    marker.pose = bay_pose;
    marker.mesh_resource = context_->GetMeshResourcePrefix() + odp_filename->string();

    const bool odp_open = bay_state.overdrive_left_state == interfaces::msg::DoorReport::DOOR_STATE_OPEN ||
                          bay_state.overdrive_left_state == interfaces::msg::DoorReport::DOOR_STATE_MOVING ||
                          bay_state.overdrive_right_state == interfaces::msg::DoorReport::DOOR_STATE_OPEN ||
                          bay_state.overdrive_right_state == interfaces::msg::DoorReport::DOOR_STATE_MOVING ||
                          bay_state.system_door_state == interfaces::msg::DoorReport::DOOR_STATE_OPEN ||
                          bay_state.system_door_state == interfaces::msg::DoorReport::DOOR_STATE_MOVING ||
                          bay_state.patron_light_state > 1u;

    // Integrate the offset toward its target each frame at kOdpSpeedMps. Naturally handles
    // direction reversals (e.g. the bay flips back to closed mid-slide).
    const float target_offset_m = odp_open ? kModelOriginOffsetM : 0.0f;
    OdpAnimState& anim = odp_anim_states_[node.id];
    const rclcpp::Time now = context_->GetTimeNow();
    if(anim.last_update_time.has_value()) {
      const float dt = static_cast<float>((now - anim.last_update_time.value()).seconds());
      const float max_step = kOdpSpeedMps * dt;
      if(target_offset_m > anim.current_offset_m) {
        anim.current_offset_m = std::min(target_offset_m, anim.current_offset_m + max_step);
      }
      else if(target_offset_m < anim.current_offset_m) {
        anim.current_offset_m = std::max(target_offset_m, anim.current_offset_m - max_step);
      }
    }
    anim.last_update_time = now;

    const float current_offset = anim.current_offset_m;
    switch(bay_heading_deg) {
    case 0:
    case 360:
      marker.pose.position.x += current_offset;
      break;
    case 90:
    case -270:
      marker.pose.position.y += current_offset;
      break;
    case 180:
    case -180:
      marker.pose.position.x -= current_offset;
      break;
    case -90:
    case 270:
      marker.pose.position.y -= current_offset;
      break;
    default:
      break;
    }

    markers.push_back(marker);
  }

  // Front part of the walkway
  {
    const auto floor_front_filename = GetBayPieceFilename(BayPiece::FLOOR_FRONT_WALKWAY, is_blift);
    if(floor_front_filename.has_value()) {
      visualization_msgs::msg::Marker marker =
          CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kBays + "_floor_front", node.id);
      marker.pose = bay_pose;
      marker.mesh_resource = context_->GetMeshResourcePrefix() + floor_front_filename->string();
      markers.push_back(marker);
    }
  }

  // Right side of the walkway
  {
    const auto floor_right_filename = GetBayPieceFilename(BayPiece::FLOOR_RIGHT_WALKWAY, is_blift);
    if(floor_right_filename.has_value()) {
      visualization_msgs::msg::Marker marker =
          CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kBays + "_floor_right", node.id);
      marker.pose = bay_pose;

      marker.mesh_resource = context_->GetMeshResourcePrefix() + floor_right_filename->string();
      markers.push_back(marker);
    }
  }

  // Left side of the walkway
  {
    const auto floor_left_filename = GetBayPieceFilename(BayPiece::FLOOR_LEFT_WALKWAY, is_blift);
    if(floor_left_filename.has_value()) {
      visualization_msgs::msg::Marker marker =
          CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kBays + "_floor_left", node.id);
      marker.pose = bay_pose;
      marker.mesh_resource = context_->GetMeshResourcePrefix() + floor_left_filename->string();
      markers.push_back(marker);
    }
  }

  // Rear part of the walkway
  {
    const auto rear_walkway_filename = GetBayPieceFilename(BayPiece::FLOOR_REAR_WALKWAY, is_blift);
    if(rear_walkway_filename.has_value()) {
      visualization_msgs::msg::Marker marker =
          CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kBays + "_floor_rear", node.id);
      marker.pose = bay_pose;
      marker.mesh_resource = context_->GetMeshResourcePrefix() + rear_walkway_filename->string();
      markers.push_back(marker);
    }
  }

  // Ramp
  {
    const auto ramp_filename = GetBayPieceFilename(BayPiece::RAMP, is_blift);
    if(ramp_filename.has_value()) {
      visualization_msgs::msg::Marker marker =
          CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kBays + "_ramp", node.id);
      marker.pose = bay_pose;
      marker.mesh_resource = context_->GetMeshResourcePrefix() + ramp_filename->string();
      markers.push_back(marker);
    }
  }

  // Walls
  {
    const auto walls_filename = GetBayPieceFilename(BayPiece::WALLS, is_blift);
    if(walls_filename.has_value()) {
      visualization_msgs::msg::Marker marker =
          CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kBays + "_walls", node.id);
      marker.pose = bay_pose;
      marker.color = CreateColorRGBA(1.0, 1.0, 1.0, 0.5);
      marker.mesh_resource = context_->GetMeshResourcePrefix() + walls_filename->string();
      markers.push_back(marker);
    }
  }

  // Patron garage door mechanism
  {
    const auto door_mechanism_filename = GetBayPieceFilename(BayPiece::GARAGE_DOOR_MECHANISM, is_blift);
    if(door_mechanism_filename.has_value()) {
      visualization_msgs::msg::Marker marker =
          CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kBays + "_door_mechanism", node.id);
      marker.pose = bay_pose;
      marker.mesh_resource = context_->GetMeshResourcePrefix() + door_mechanism_filename->string();
      markers.push_back(marker);
    }
  }

  // Patron garage door
  {
    const bool door_open =
        bay_state.patron_door_state == interfaces::msg::DoorReport::DOOR_STATE_OPEN ||
        bay_state.patron_light_state == bay_interfaces::srv::PatronLightControl::Request::LIGHT_GREEN;
    const auto door_filename =
        GetBayPieceFilename(door_open ? BayPiece::GARAGE_DOOR_OPEN : BayPiece::GARAGE_DOOR_CLOSED, is_blift);
    if(door_filename.has_value()) {
      visualization_msgs::msg::Marker marker =
          CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kBays + "_door", node.id);
      marker.pose = bay_pose;
      marker.mesh_resource = context_->GetMeshResourcePrefix() + door_filename->string();
      markers.push_back(marker);
    }
  }

  // Patron Light
  {
    const auto patron_light_filename = GetBayPieceFilename(BayPiece::TRAFFIC_LIGHT, is_blift);
    if(patron_light_filename.has_value()) {
      visualization_msgs::msg::Marker marker =
          CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kBays + "_patron_light", node.id);
      marker.pose = bay_pose;
      marker.mesh_resource = context_->GetMeshResourcePrefix() + patron_light_filename->string();
      markers.push_back(marker);
    }
  }

  // Patron Light
  {
    visualization_msgs::msg::Marker marker =
        CreateDefaultMarker(context_->GetTimeNow(), topics::kBays + "_patron_light_sphere", node.id);
    marker.type = visualization_msgs::msg::Marker::SPHERE;

    marker.scale.x = 0.5;
    marker.scale.y = 0.1;
    marker.scale.z = 0.5;

    static constexpr float walkway_width_m = (kBayWidth - kTrayWidth) / 2;
    static constexpr float wall_thickness_m = 0.1;
    marker.pose.position.x = -((kTrayWidth + walkway_width_m) / 2) - 0.15f;
    marker.pose.position.y = -(kBayLength / 2 - wall_thickness_m / 2) - 0.15f;
    marker.pose.position.z = (kGarageDoorHeight / 2 + kTrayHeight) + 0.75f;

    marker.pose = bay_pose * marker.pose;

    if(bay_state.patron_light_state == bay_interfaces::srv::PatronLightControl::Request::LIGHTS_OFF) {
      marker.color = CreateColorRGBA(0.5, 0.5, 0.5);
    }
    else if(bay_state.patron_light_state == bay_interfaces::srv::PatronLightControl::Request::LIGHT_GREEN) {
      marker.color = CreateColorRGBA(0.0, 1.0, 0.0);
    }
    else {
      marker.color = CreateColorRGBA(1.0, 0.0, 0.0);
    }

    markers.push_back(marker);
  }

  return markers;
}

}  // namespace volley::vis
