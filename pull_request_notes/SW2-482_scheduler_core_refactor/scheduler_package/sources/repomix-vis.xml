<file path="include/vis/math.hpp">
#pragma once

#include <Eigen/Geometry>
#include <geometry_msgs/msg/point.hpp>
#include <geometry_msgs/msg/pose.hpp>
#include <geometry_msgs/msg/quaternion.hpp>

namespace volley::vis {

// Construct a quaternion given roll, pitch, and yaw [rad], in ZYX order.
geometry_msgs::msg::Quaternion Quaternion(double roll, double pitch, double yaw);

// Convenient Point constructor
geometry_msgs::msg::Point Point(double x, double y, double z);

// Eigen to ROS types and vice versa conversions
Eigen::Quaterniond QuatToQuatd(const geometry_msgs::msg::Quaternion& quat);
geometry_msgs::msg::Quaternion QuatdToQuat(const Eigen::Quaterniond& quat);

// Pose multiplication operator
// P1 is the pose from O to P specified in frame O
// P2 is the pose from P to Q specified in frame Q
// Then P1*P2 is the pose from O to Q specified in frame O
geometry_msgs::msg::Pose operator*(const geometry_msgs::msg::Pose& p1, const geometry_msgs::msg::Pose& p2);

}  // namespace volley::vis
</file>

