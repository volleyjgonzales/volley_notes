#include "vis/models.hpp"
#include "vis/vis_context.hpp"
#include "vis/visualizer/i_visualizer.hpp"

namespace volley::vis {

class BayVisualizer : public IVisualizer {
public:
  explicit BayVisualizer(VisContextSPtr context);

  std::vector<VisMessage> GetVisMessages() override;

  void HandleGarageSnapshot(interfaces::msg::GarageSnapshot::ConstSharedPtr garage_snapshot) override;

private:
  visualization_msgs::msg::MarkerArray CreateBaysMarkerArray();

  std::vector<visualization_msgs::msg::Marker> CreateBayMarkers(const interfaces::msg::GarageNode& node);

  std::unordered_map<uint32_t, interfaces::msg::BayState> bay_states_;

  // Per-bay animation state for the overdrive plate slide. The marker offset is
  // integrated toward `target` (0 when the bay reports the ODP as in, kModelOriginOffsetM
  // when it reports the ODP as out) at a fixed speed each frame, so the plate slides
  // smoothly during the sim's MOVING window instead of snapping.
  struct OdpAnimState {
    float current_offset_m = 0.0f;
    std::optional<rclcpp::Time> last_update_time;
  };
  std::unordered_map<uint32_t, OdpAnimState> odp_anim_states_;
};

}  // namespace volley::vis
</file>

