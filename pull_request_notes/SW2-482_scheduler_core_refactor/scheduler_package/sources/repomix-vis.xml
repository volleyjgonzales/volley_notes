namespace volley::vis {

AgvVisualizer::AgvVisualizer(VisContextSPtr context) : IVisualizer(std::move(context)) {
}

std::vector<VisMessage> AgvVisualizer::GetVisMessages() {
  return {VisMessage {.topic_name = topics::kAgvs, .marker_array = CreateAgvsMarkerArray()},
      VisMessage {.topic_name = topics::kAgvCommands, .marker_array = CreateCommandsMarkerArray()}};
}

void AgvVisualizer::HandleGarageSnapshot(interfaces::msg::GarageSnapshot::ConstSharedPtr garage_snapshot) {
  for(const interfaces::msg::AgvSimState& agv_sim_state : garage_snapshot->agvs) {
    agv_states_[agv_sim_state.agv_id] = agv_sim_state.state;

    const uint32_t agv_node_id = agv_sim_state.state.garage_pose.node_id;

    // Check if the AGV is on a node that belongs to a VRC. If so, update the corresponding vrc height to be
    // the carriage height from the garage_snapshot, nullopt otherwise
    std::optional<float> vrc_height_m = std::nullopt;
    for(const auto& vrc_report : garage_snapshot->vrcs) {
      const auto vrc_layout = context_->GetLayout()->GetVrc(vrc_report.id);
      if(!vrc_layout.has_value()) {
        continue;
      }

      for(const auto& vrc_node : vrc_layout.value().nodes) {
        if(agv_node_id == vrc_node.id) {
          vrc_height_m = vrc_report.carriage_height_m;
        }
      }
    }

    agv_to_vrc_height_[agv_sim_state.agv_id] = vrc_height_m;
  }
}

void AgvVisualizer::HandleAgvCommandReportList(
    const uint32_t agv_id, interfaces::msg::AgvCommandReportList::ConstSharedPtr command_report_list) {
  command_report_lists_[agv_id] = command_report_list;
}

visualization_msgs::msg::MarkerArray AgvVisualizer::CreateAgvsMarkerArray() {
  visualization_msgs::msg::MarkerArray marker_array;

  for(const auto& [agv_id, agv_state] : agv_states_) {
    marker_array.markers.push_back(CreateAgvMarker(agv_id, agv_state));
  }

  return marker_array;
}

visualization_msgs::msg::MarkerArray AgvVisualizer::CreateCommandsMarkerArray() {
  visualization_msgs::msg::MarkerArray marker_array;

  for(const auto& [agv_id, command_report_list] : command_report_lists_) {
    const std::string marker_base_ns = topics::kAgvCommands + std::to_string(agv_id);
    if(!command_report_list) {
      continue;
    }

    for(size_t i = 0; i < command_report_list->command_queue.size(); i++) {
      const auto& command_report = command_report_list->command_queue.at(i);
      const auto agv_markers = CreateAgvCommandMarkers({.agv_command = command_report.command,
          .timestamp = context_->GetTimeNow(),
          .layout = context_->GetLayout(),
          .marker_base_ns = marker_base_ns,
          .marker_id = static_cast<int32_t>(i)});

      marker_array.markers.insert(marker_array.markers.end(), agv_markers.begin(), agv_markers.end());
    }
  }

  return marker_array;
}

visualization_msgs::msg::Marker AgvVisualizer::CreateAgvMarker(
    const uint32_t agv_id, const interfaces::msg::AgvState& agv_state) {
  visualization_msgs::msg::Marker agv_marker =
      CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kAgvs, agv_id);
  agv_marker.mesh_resource = context_->GetMeshResourcePrefix() + kAgvModelFilename;

  const auto GetAgvZ = [&]() {
    if(agv_to_vrc_height_.contains(agv_id) && agv_to_vrc_height_.at(agv_id).has_value()) {
      return agv_to_vrc_height_.at(agv_id).value();
    }
    else {
      return context_->GetLayout()->GetFloorZForFloorId(agv_state.floor).value_or(0);
    }
  };

  agv_marker.pose.position = Point(agv_state.geometric_pose.x, agv_state.geometric_pose.y, GetAgvZ());
  agv_marker.pose.orientation = Quaternion(0, 0, Wrap(agv_state.geometric_pose.yaw + radians(180.0)));

  agv_marker.mesh_use_embedded_materials = true;
  agv_marker.color = CreateColorRGBA(0.0, 0.0, 0.0);

  // Color the AGV based on its lift fraction.
  const float lift_fraction = *std::ranges::max_element(agv_state.lift_fractions);
  if(lift_fraction > 0.1) {
    const std_msgs::msg::ColorRGBA lifting_color = CreateColorRGBA(1.0, 1.0, 0.0);
    agv_marker.color = volley::Lerp(agv_marker.color, lifting_color, lift_fraction);
  }

  return agv_marker;
}

}  // namespace volley::vis
</file>

