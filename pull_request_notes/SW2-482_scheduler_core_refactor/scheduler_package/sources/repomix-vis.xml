#include "vis/visualizer/queue_visualizer.hpp"

#include <cmath>
#include <common/constants.hpp>
#include <common_ros/layout.hpp>
#include <interfaces/msg/payload.hpp>
#include <interfaces/msg/scheduler_job.hpp>
#include <visualization_msgs/msg/marker.hpp>

#include "vis/math.hpp"
#include "vis/models.hpp"
#include "vis/topics.hpp"
#include "vis/utils.hpp"
#include "vis/vis_context.hpp"
#include "vis/visualizer/i_visualizer.hpp"

namespace volley::vis {

namespace {
constexpr auto kRequestQueueNs = "inserts_and_requests";
constexpr double kRetrieveQueueCarSpacingM = 1.0;
constexpr double kInsertQueueCarSpacingM = 2.5;
constexpr double kRetrieveQueueOffsetM = 5.0;
constexpr double kInsertQueueOffsetM = 5.0;
constexpr double kQueueOffset = -1.0;
}  // namespace

QueueVisualizer::QueueVisualizer(VisContextSPtr context) : IVisualizer(std::move(context)) {
}

std::vector<VisMessage> QueueVisualizer::GetVisMessages() {
  return {{.topic_name = topics::kRequestQueue, .marker_array = CreateRequestQueueMarkerArray()}};
}

void QueueVisualizer::HandleSimReport(interfaces::msg::SimReport::ConstSharedPtr sim_report) {
  std::unordered_map<std::string, interfaces::msg::Payload> inserts_to_display;
  for(const auto& payload : sim_report->payloads) {
    const std::string id_str = GuidToString(payload.id);
    inserts_to_display[id_str] = payload;
  }

  std::vector<std::string> to_remove;
  for(const auto& id_str : insert_queue_order_) {
    if(!inserts_to_display.count(id_str)) {
      to_remove.push_back(id_str);
    }
  }
  for(const auto& id_str : to_remove) {
    RemoveInsertMarker(id_str);
  }

  for(const auto& [id_str, payload] : inserts_to_display) {
    if(!insert_markers_.count(id_str)) {
      AddInsertMarker(id_str, payload);
    }
  }
}

void QueueVisualizer::HandleDispatchReport(interfaces::msg::DispatchReport::ConstSharedPtr dispatch_report) {
  // Retrieves require the patron to wait until the job is completely finished, so keep the marker
  // in the queue while the job is unplanned OR executing. Inserts are sourced from SimReport instead.
  std::unordered_map<std::string, interfaces::msg::SchedulerJob> retrieves_to_display;
  for(const auto& job : dispatch_report->jobs) {
    const bool retrieve_job_not_finished = (job.type == interfaces::msg::SchedulerJob::TYPE_RETRIEVE &&
                                            (job.state == interfaces::msg::SchedulerJob::STATE_UNPLANNED ||
                                                job.state == interfaces::msg::SchedulerJob::STATE_EXECUTING));
    if(retrieve_job_not_finished) {
      const std::string id_str = GuidToString(job.payload_id);
      retrieves_to_display[id_str] = job;
    }
  }

  std::vector<std::string> to_remove;
  for(const auto& id_str : retrieve_queue_order_) {
    if(!retrieves_to_display.count(id_str)) {
      to_remove.push_back(id_str);
    }
  }
  for(const auto& id_str : to_remove) {
    RemoveRetrieveMarker(id_str);
  }

  for(const auto& [id_str, job] : retrieves_to_display) {
    if(!retrieve_markers_.count(id_str)) {
      AddRetrieveMarker(id_str, job);
    }
  }
}

visualization_msgs::msg::MarkerArray QueueVisualizer::CreateRequestQueueMarkerArray() {
  visualization_msgs::msg::MarkerArray marker_array;
  const auto now = context_->GetTimeNow();

  for(auto& marker : pending_deletions_) {
    marker_array.markers.push_back(marker);
  }
  pending_deletions_.clear();

  for(const auto& id_str : retrieve_queue_order_) {
    for(auto marker : retrieve_markers_.at(id_str)) {
      marker.header.stamp = now;
      marker_array.markers.push_back(marker);
    }
  }

  for(const auto& id_str : insert_queue_order_) {
    for(auto marker : insert_markers_.at(id_str)) {
      marker.header.stamp = now;
      marker_array.markers.push_back(marker);
    }
  }

  return marker_array;
}

void QueueVisualizer::AddRetrieveMarker(
    const std::string& payload_id_str, const interfaces::msg::SchedulerJob& job) {
  const auto& bay_node_ids = context_->GetLayout()->GetBayLikeNodeIds();
  if(bay_node_ids.empty()) {
    return;
  }
  const auto bay_node_opt = context_->GetLayout()->GetNodeById(bay_node_ids[0]);
  if(!bay_node_opt.has_value()) {
    return;
  }
  const auto& bay_node = bay_node_opt.value();

  const double outbound_rad = (GetInboundHeading(bay_node) + 180.0) * volley::kDeg2Rad;
  const double dx = std::cos(outbound_rad);
  const double dy = std::sin(outbound_rad);
  const int slot = static_cast<int>(retrieve_queue_order_.size()) + 1;
  const double along = slot * kRetrieveQueueCarSpacingM + kRetrieveQueueOffsetM;

  const auto position =
      Point(bay_node.x + dx * along - dy * kQueueOffset, bay_node.y + dy * along + dx * kQueueOffset, 0.0);
  const auto orientation = Quaternion(0.0, 0.0, outbound_rad);

  auto markers = CreatePayloadMarkers(context_->GetTimeNow(), context_->GetMeshResourcePrefix(),
      std::format("{}_{}", kRequestQueueNs, payload_id_str), 0, GetCarModelFromGuid(job.payload_id), position,
      orientation, GetColorFromGuid(job.payload_id));
  for(auto& m : markers) {
    m.scale.x = 0.5;
    m.scale.y = 0.5;
    m.scale.z = 0.5;
  }
  retrieve_markers_[payload_id_str] = std::move(markers);
  retrieve_queue_order_.push_back(payload_id_str);
}

void QueueVisualizer::RemoveRetrieveMarker(const std::string& payload_id_str) {
  auto it = retrieve_markers_.find(payload_id_str);
  if(it == retrieve_markers_.end()) {
    return;
  }

  const auto now = context_->GetTimeNow();
  for(auto delete_marker : it->second) {
    delete_marker.action = visualization_msgs::msg::Marker::DELETE;
    delete_marker.header.stamp = now;
    pending_deletions_.push_back(delete_marker);
  }

  retrieve_markers_.erase(it);
  std::erase(retrieve_queue_order_, payload_id_str);

  RecalculateRetrieveMarkerPositions();
}

void QueueVisualizer::RecalculateRetrieveMarkerPositions() {
  const auto& bay_node_ids = context_->GetLayout()->GetBayLikeNodeIds();
  if(bay_node_ids.empty()) {
    return;
  }
  const auto bay_node_opt = context_->GetLayout()->GetNodeById(bay_node_ids[0]);
  if(!bay_node_opt.has_value()) {
    return;
  }
  const auto& bay_node = bay_node_opt.value();

  const double outbound_rad = (GetInboundHeading(bay_node) + 180.0) * volley::kDeg2Rad;
  const double dx = std::cos(outbound_rad);
  const double dy = std::sin(outbound_rad);

  int slot = 1;
  for(const auto& id_str : retrieve_queue_order_) {
    const double along = slot * kRetrieveQueueCarSpacingM + kRetrieveQueueOffsetM;
    for(auto& marker : retrieve_markers_.at(id_str)) {
      marker.pose.position.x = bay_node.x + dx * along - dy * kQueueOffset;
      marker.pose.position.y = bay_node.y + dy * along + dx * kQueueOffset;
      marker.header.stamp = context_->GetTimeNow();
    }
    ++slot;
  }
}

void QueueVisualizer::AddInsertMarker(
    const std::string& payload_id_str, const interfaces::msg::Payload& payload) {
  const auto& bay_node_ids = context_->GetLayout()->GetBayLikeNodeIds();
  if(bay_node_ids.empty()) {
    return;
  }
  const auto bay_node_opt = context_->GetLayout()->GetNodeById(bay_node_ids[0]);
  if(!bay_node_opt.has_value()) {
    return;
  }
  const auto& bay_node = bay_node_opt.value();

  const double inbound_rad = GetInboundHeading(bay_node) * volley::kDeg2Rad;
  const double dx = std::cos(inbound_rad);
  const double dy = std::sin(inbound_rad);
  const int slot = static_cast<int>(insert_queue_order_.size()) + 1;
  const double offset = slot * kInsertQueueCarSpacingM + kInsertQueueOffsetM;

  const auto position = Point(bay_node.x + dx * offset, bay_node.y + dy * offset, 0.0);
  const auto orientation = Quaternion(0.0, 0.0, inbound_rad);

  auto markers = CreatePayloadMarkers(context_->GetTimeNow(), context_->GetMeshResourcePrefix(),
      std::format("{}_{}", kRequestQueueNs, payload_id_str), 0, GetCarModelFromGuid(payload.id), position,
      orientation, GetColorFromGuid(payload.id));

  insert_markers_[payload_id_str] = std::move(markers);
  insert_queue_order_.push_back(payload_id_str);
}

void QueueVisualizer::RemoveInsertMarker(const std::string& payload_id_str) {
  auto it = insert_markers_.find(payload_id_str);
  if(it == insert_markers_.end()) {
    return;
  }

  const auto now = context_->GetTimeNow();
  for(auto delete_marker : it->second) {
    delete_marker.action = visualization_msgs::msg::Marker::DELETE;
    delete_marker.header.stamp = now;
    pending_deletions_.push_back(delete_marker);
  }

  insert_markers_.erase(it);
  std::erase(insert_queue_order_, payload_id_str);

  RecalculateInsertMarkerPositions();
}

void QueueVisualizer::RecalculateInsertMarkerPositions() {
  const auto& bay_node_ids = context_->GetLayout()->GetBayLikeNodeIds();
  if(bay_node_ids.empty()) {
    return;
  }
  const auto bay_node_opt = context_->GetLayout()->GetNodeById(bay_node_ids[0]);
  if(!bay_node_opt.has_value()) {
    return;
  }
  const auto& bay_node = bay_node_opt.value();

  const double inbound_rad = GetInboundHeading(bay_node) * volley::kDeg2Rad;
  const double dx = std::cos(inbound_rad);
  const double dy = std::sin(inbound_rad);

  int slot = 1;
  for(const auto& id_str : insert_queue_order_) {
    const double offset = slot * kInsertQueueCarSpacingM + kInsertQueueOffsetM;
    for(auto& marker : insert_markers_.at(id_str)) {
      marker.pose.position.x = bay_node.x + dx * offset;
      marker.pose.position.y = bay_node.y + dy * offset;
      marker.header.stamp = context_->GetTimeNow();
    }
    ++slot;
  }
}

}  // namespace volley::vis
