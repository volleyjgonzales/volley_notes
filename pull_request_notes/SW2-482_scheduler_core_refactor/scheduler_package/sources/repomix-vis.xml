namespace {
// Initializes a static random value once per process
uint64_t GetProcessSalt() {
  static const uint64_t salt = std::random_device {}();
  return salt;
}

// Hashes a GUID to a uint64_t value that is deterministic within the same process (using FNV-1a)
uint64_t HashGuid(const GuidMsg& guid) {
  static constexpr uint64_t kFnvOffsetBasis = 14695981039346656037ULL;
  static constexpr uint64_t kFnvPrime = 1099511628211ULL;
  uint64_t hash = kFnvOffsetBasis;
  for(uint8_t byte : guid.bytes) {
    hash ^= byte;
    hash *= kFnvPrime;
  }
  return hash ^ GetProcessSalt();
}
}  // namespace

