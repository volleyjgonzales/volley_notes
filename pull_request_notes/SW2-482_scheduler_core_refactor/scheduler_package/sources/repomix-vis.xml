namespace volley::vis {

class QueueVisualizer : public IVisualizer {
public:
  explicit QueueVisualizer(VisContextSPtr context);

  std::vector<VisMessage> GetVisMessages() override;

  void HandleGarageSnapshot(interfaces::msg::GarageSnapshot::ConstSharedPtr) override { }

  void HandleDispatchReport(interfaces::msg::DispatchReport::ConstSharedPtr dispatch_report);

  void HandleSimReport(interfaces::msg::SimReport::ConstSharedPtr sim_report);

private:
  visualization_msgs::msg::MarkerArray CreateRequestQueueMarkerArray();

  void AddRetrieveMarker(const std::string& payload_id_str, const interfaces::msg::SchedulerJob& job);

  void RemoveRetrieveMarker(const std::string& payload_id_str);

  void RecalculateRetrieveMarkerPositions();

  void AddInsertMarker(const std::string& payload_id_str, const interfaces::msg::Payload& payload);

  void RemoveInsertMarker(const std::string& payload_id_str);

  void RecalculateInsertMarkerPositions();

  // Insertion-ordered list of payload_id_strs in the retrieve queue
  std::vector<std::string> retrieve_queue_order_;

  // Maps payload_id_str to its active retrieve queue markers (body, wheels, windows)
