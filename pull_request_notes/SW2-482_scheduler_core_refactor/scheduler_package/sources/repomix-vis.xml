#include "vis/utils.hpp"

#include <cmath>
#include <common_ros/agv_motion_type.hpp>
#include <rclcpp/time.hpp>
#include <std_msgs/msg/color_rgba.hpp>
#include <visualization_msgs/msg/marker.hpp>

#include "vis/math.hpp"

namespace volley::vis {

namespace {
static constexpr float kArrowLengthM = 1.0;
static constexpr float kArrowWidth = 0.15;
}  // namespace

std_msgs::msg::ColorRGBA CreateColorRGBA(float r, float g, float b, float a) {
  std_msgs::msg::ColorRGBA color;
  color.r = r;
  color.g = g;
  color.b = b;
  color.a = a;
  return color;
}

visualization_msgs::msg::Marker CreateDefaultMarker(
    const rclcpp::Time& time, const std::string& ns, int32_t id) {
  visualization_msgs::msg::Marker marker;
  marker.header.stamp = time;
  marker.header.frame_id = "map";
  marker.ns = ns;
  marker.id = id;
  marker.action = visualization_msgs::msg::Marker::ADD;
  marker.lifetime = rclcpp::Duration(1, 0);
  marker.scale.x = 1.0f;
  marker.scale.y = 1.0f;
  marker.scale.z = 1.0f;
  marker.color = CreateColorRGBA(0, 0, 0);
  return marker;
}

visualization_msgs::msg::Marker CreateDefaultMeshMarker(
    const rclcpp::Time& time, const std::string& ns, int32_t id) {
  visualization_msgs::msg::Marker marker = CreateDefaultMarker(time, ns, id);
  marker.type = visualization_msgs::msg::Marker::MESH_RESOURCE;
  marker.mesh_use_embedded_materials = true;
  return marker;
}

std::vector<visualization_msgs::msg::Marker> CreateAgvCommandMarkers(const VisAgvCommandConfig& config) {
  std::vector<visualization_msgs::msg::Marker> markers;

  const volley::AgvMotionType command_type = volley::GetMotionType(config.agv_command, *config.layout);
  std::string command_text_label = volley::AgvMotionTypeStr(command_type);

  const std::optional<interfaces::msg::GarageNode> src_node =
      config.layout->GetNodeById(config.agv_command.src.pose.node_id);
  const std::optional<interfaces::msg::GarageNode> dst_node =
      config.layout->GetNodeById(config.agv_command.dst.pose.node_id);

  if(!src_node.has_value() || !dst_node.has_value()) {
    return markers;
  }

  const float dst_z = config.layout->GetFloorZForFloorId(dst_node->floor).value_or(0) + config.z_offset_m;

  // Point and distance between src and dst nodes
  const float px = std::min(dst_node->x, src_node->x);
  const float py = std::min(dst_node->y, src_node->y);
  const float dx = dst_node->x - src_node->x;
  const float dy = dst_node->y - src_node->y;

  // Midpoint between src and dst nodes.
  const float mid_x = px + fabsf(dx * 0.5f);
  const float mid_y = py + fabsf(dy * 0.5f);
  const auto midpoint = Point(mid_x, mid_y, dst_z);

  visualization_msgs::msg::Marker marker =
      CreateDefaultMarker(config.timestamp, config.marker_base_ns, config.marker_id);
  marker.color = config.base_color;

  switch(command_type) {
  case volley::AgvMotionType::ROTATE: {
    marker.type = visualization_msgs::msg::Marker::CYLINDER;
    marker.ns += "_rotate";
    marker.color.a = 0.5;
    marker.pose.position = Point(dst_node->x, dst_node->y, dst_z);

    double radius = 1.0;  // Default to a small radius
    auto window_opt = config.layout->GetBufferedResourceWindow(dst_node->max_resource_size);
    if(window_opt.has_value()) {
      radius = std::hypot(window_opt.value().width_m, window_opt.value().length_m);
    }
    marker.scale.x = radius;
    marker.scale.y = radius;
    marker.scale.z = 0.25f;
    markers.push_back(marker);

    command_text_label += std::format("_{}to{}", std::to_string(config.agv_command.src.pose.heading),
        std::to_string(config.agv_command.dst.pose.heading));
    break;
  }
  case volley::AgvMotionType::CENTER: {
    marker.type = visualization_msgs::msg::Marker::SPHERE;
    marker.ns += "_center";
    marker.pose.position = Point(dst_node->x, dst_node->y, dst_z);
    marker.scale.x = 0.75f;
    marker.scale.y = 0.75f;
    marker.scale.z = 0.25f;
    markers.push_back(marker);
    break;
  }
  case volley::AgvMotionType::LIFT: {
    if(config.agv_command.dst.lift) {
      command_text_label = "LIFT_TRAY";
    }
    else {
      command_text_label = "LOWER_TRAY";
    }

    marker.type = visualization_msgs::msg::Marker::CYLINDER;
    marker.ns += "_lift";
    marker.pose.position = Point(dst_node->x, dst_node->y, dst_z - 0.15f);
    marker.scale.x = 1.0f;
    marker.scale.y = 1.0f;
    marker.scale.z = 0.15f;
    markers.push_back(marker);
    break;
  }
  case volley::AgvMotionType::LOCOMOTE:
  case volley::AgvMotionType::STRAFE: {
    visualization_msgs::msg::Marker move_marker = marker;
    move_marker.type = visualization_msgs::msg::Marker::CUBE;
    move_marker.color.a = 0.5;
    move_marker.ns += "_move";
    move_marker.pose.position = midpoint;
    move_marker.scale.x = std::max(fabsf(dx), 2.0f);
    move_marker.scale.y = std::max(fabsf(dy), 2.0f);
    move_marker.scale.z = 0.15;
    markers.push_back(move_marker);

    // Add an arrow to show movement direction
    const auto angle_rad = std::atan2(dst_node->y - src_node->y, dst_node->x - src_node->x);

    visualization_msgs::msg::Marker arrow_marker = marker;
    arrow_marker.ns += "_movement_arrow";
    arrow_marker.type = visualization_msgs::msg::Marker::ARROW;
    arrow_marker.pose.position = midpoint;
    arrow_marker.pose.position.z -= 0.3f;
    arrow_marker.pose.orientation = Quaternion(0.0, 0.0, angle_rad);
    arrow_marker.color.a = 1.0f;
    arrow_marker.scale.x = kArrowLengthM;
    arrow_marker.scale.y = kArrowWidth;
    arrow_marker.scale.z = kArrowWidth;

    markers.push_back(arrow_marker);
    break;
  }
  default: {
    visualization_msgs::msg::Marker between_marker = marker;
    between_marker.type = visualization_msgs::msg::Marker::CUBE;
    between_marker.ns += "_between";
    between_marker.pose.position = midpoint;
    between_marker.scale.x = std::max(dx, 2.0f);
    between_marker.scale.y = std::max(dy, 2.0f);
    between_marker.scale.z = 0.25f;
    between_marker.color.a = 0.5;
    markers.push_back(between_marker);
    break;
  }
  }

  // Add text label
  visualization_msgs::msg::Marker text_marker = marker;
  text_marker.type = visualization_msgs::msg::Marker::TEXT_VIEW_FACING;
  text_marker.ns += "_text_label";
  text_marker.text = command_text_label;
  text_marker.pose.position = midpoint;
  text_marker.pose.position.z -= 0.6f;
  text_marker.scale.z = 0.25f;
  text_marker.color.a = 1.0;
  markers.push_back(text_marker);

  return markers;
}

std::vector<visualization_msgs::msg::Marker> CreatePayloadMarkers(const rclcpp::Time& time,
    const std::string& mesh_resource_prefix, const std::string& ns, int32_t marker_id,
    const CarModel& car_model, const geometry_msgs::msg::Point& position,
    const geometry_msgs::msg::Quaternion& orientation, const std_msgs::msg::ColorRGBA& body_color) {
  auto make = [&](const std::string& ns_suffix, const std::string& mesh_file,
                  const std_msgs::msg::ColorRGBA& color) {
    auto marker = CreateDefaultMeshMarker(time, ns + ns_suffix, marker_id);
    marker.mesh_resource = mesh_resource_prefix + mesh_file;
    marker.mesh_use_embedded_materials = true;
    marker.color = color;
    marker.pose.position = position;
    marker.pose.orientation = orientation;
    return marker;
  };

  return {
      // Make the wheels the same transparency as the body
      make("_car", car_model.body_filename.string(), body_color),
      make("_wheels", car_model.wheels_trim_filename.string(),
          CreateColorRGBA(0.0f, 0.0f, 0.0f, body_color.a)),
      make("_windows", car_model.windows_filename.string(), CreateColorRGBA(0.15f, 0.15f, 0.15f, 0.85f)),
  };
}

}  // namespace volley::vis
</file>

<file path="src/vis_manager.cpp">
#include "vis/vis_manager.hpp"

#include <common_ros/layout.hpp>
#include <cstdlib>
#include <interfaces/msg/sim_report.hpp>
#include <memory>

#include "vis/models.hpp"
#include "vis/visualizer/schedule_visualizer.hpp"

namespace volley::vis {

using namespace std::chrono_literals;

static constexpr auto kRenderPeriod = 50ms;

namespace {
VisContextSPtr BuildVisContext(const NodeSPtr& node) {
  const std::string layout_param_name = "layout";
  const auto layout_filepath_or = GetLayoutPathByName(node->Param<std::string>(layout_param_name));
  if(!layout_filepath_or.has_value()) {
    ERRORS(node->get_logger(), layout_filepath_or.error());
    exit(EXIT_FAILURE);
  }
  const auto& layout_filepath = layout_filepath_or.value();

  const LayoutSPtr layout = std::make_shared<volley::Layout>(layout_filepath);

  const std::string use_remote_meshes_param_name = "use_remote_meshes";
  const bool use_remote_meshes = node->Param<bool>(use_remote_meshes_param_name, true);

  const std::string remote_mesh_prefix_param_name = "remote_mesh_prefix";
  const auto remote_mesh_prefix =
      node->Param<std::string>(remote_mesh_prefix_param_name, kMeshResourcePrefixRemoteDefault);

  const std::string mesh_resource_prefix = use_remote_meshes ? remote_mesh_prefix : kMeshResourcePrefixLocal;

  INFOS(node->get_logger(), "Starting VisManager with context:\n\t"
                                << layout_param_name << ": " << layout_filepath << "\n\t"
                                << use_remote_meshes_param_name << ": " << std::boolalpha << use_remote_meshes
                                << "\n\t" << remote_mesh_prefix_param_name << ": " << remote_mesh_prefix);

  return std::make_shared<VisContext>(layout, std::move(mesh_resource_prefix), node->get_clock());
}
}  // namespace

VisManager::VisManager(NodeSPtr node) :
    node_(node), context_(BuildVisContext(node_)), queue_visualizer_(nullptr) {
  visualizers_.push_back(std::make_unique<BayVisualizer>(context_));
  visualizers_.push_back(std::make_unique<LayoutVisualizer>(context_));
  visualizers_.push_back(std::make_unique<TrayVisualizer>(context_));
  visualizers_.push_back(std::make_unique<VrcVisualizer>(context_));

  // Construct queue visualizer
  {
    auto queue_visualizer = std::make_unique<QueueVisualizer>(context_);
    queue_visualizer_ = queue_visualizer.get();
    visualizers_.push_back(std::move(queue_visualizer));
  }

  // Construct AGV visualizer
  {
    auto agv_visualizer = std::make_unique<AgvVisualizer>(context_);
    agv_visualizer_ = agv_visualizer.get();
    visualizers_.push_back(std::move(agv_visualizer));
  }

  // Construct schedule visualizer
  {
    auto schedule_visualizer = std::make_unique<ScheduleVisualizer>(context_);
    schedule_visualizer_ = schedule_visualizer.get();
    visualizers_.push_back(std::move(schedule_visualizer));
  }

  garage_snapshot_sub_ = node_->create_subscription<interfaces::msg::GarageSnapshot>(
      "/central/garage_snapshot", volley::GetBestEffortQoS(1),
      [&](interfaces::msg::GarageSnapshot::ConstSharedPtr msg) { HandleGarageSnapshot(msg); });

  schedule_sub_ =
      node_->create_subscription<interfaces::msg::Schedule>("/central/schedule", volley::GetBestEffortQoS(1),
          [&](interfaces::msg::Schedule::ConstSharedPtr msg) { schedule_visualizer_->HandleSchedule(msg); });

  dispatch_report_sub_ = node_->create_subscription<interfaces::msg::DispatchReport>("/central/report",
      volley::GetBestEffortQoS(1), [&](interfaces::msg::DispatchReport::ConstSharedPtr msg) {
        queue_visualizer_->HandleDispatchReport(msg);
      });

  sim_report_sub_ =
      node_->create_subscription<interfaces::msg::SimReport>("/sim/report", volley::GetBestEffortQoS(1),
          [&](interfaces::msg::SimReport::ConstSharedPtr msg) { queue_visualizer_->HandleSimReport(msg); });

  render_timer_ = rclcpp::create_timer(node_->get_node_base_interface(), node_->get_node_timers_interface(),
      node_->get_clock(), kRenderPeriod, [this] { Render(); });
}

void VisManager::HandleGarageSnapshot(interfaces::msg::GarageSnapshot::ConstSharedPtr garage_snapshot) {
  for(const auto& visualizer : visualizers_) {
    visualizer->HandleGarageSnapshot(garage_snapshot);
  }

  for(const auto& agv_sim_state : garage_snapshot->agvs) {
    const uint8_t agv_id = agv_sim_state.agv_id;
    if(!agv_command_subs_.contains(agv_sim_state.agv_id)) {
      const std::string topic_name = "/agv/a" + std::to_string(agv_id) + "/command_list";
      agv_command_subs_[agv_sim_state.agv_id] =
          node_->create_subscription<interfaces::msg::AgvCommandReportList>(topic_name,
              volley::GetBestEffortQoS(1),
              [this, agv_id](interfaces::msg::AgvCommandReportList::ConstSharedPtr msg) {
                agv_visualizer_->HandleAgvCommandReportList(agv_id, msg);
              });
    }
  }
}

void VisManager::Render() {
  for(const auto& visualizer : visualizers_) {
    Publish(visualizer->GetVisMessages());
  }
}

bool VisManager::Publish(const VisMessage& vis_message) {
  if(publishers_.find(vis_message.topic_name) == publishers_.end()) {
    AddPublisher(vis_message.topic_name);
  }

  publishers_.at(vis_message.topic_name)->publish(vis_message.marker_array);
  return true;
}

bool VisManager::Publish(const std::vector<VisMessage>& vis_messages) {
  bool success = true;
  for(const auto& msg : vis_messages) {
    success &= Publish(msg);
  }
  return success;
}

bool VisManager::AddPublisher(const std::string& topic_name) {
  if(publishers_.find(topic_name) != publishers_.end()) {
    ERRORS(node_->get_logger(), "Failed to add publisher, one already exists for topic name: " << topic_name);
    return false;
  }

  publishers_[topic_name] = node_->create_publisher<visualization_msgs::msg::MarkerArray>(topic_name, 1);
  return true;
}

}  // namespace volley::vis
</file>

