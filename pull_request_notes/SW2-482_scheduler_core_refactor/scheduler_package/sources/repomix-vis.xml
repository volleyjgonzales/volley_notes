namespace volley::vis {

ScheduleVisualizer::ScheduleVisualizer(VisContextSPtr context) : IVisualizer(std::move(context)) {
}

std::vector<VisMessage> ScheduleVisualizer::GetVisMessages() {
  return {VisMessage {.topic_name = topics::kScheduleDag, .marker_array = CreateScheduleMarkerArray()}};
}

void ScheduleVisualizer::HandleSchedule(interfaces::msg::Schedule::ConstSharedPtr schedule) {
  schedule_ = schedule;
}

visualization_msgs::msg::MarkerArray ScheduleVisualizer::CreateScheduleMarkerArray() {
  visualization_msgs::msg::MarkerArray marker_array;

  if(!schedule_) {
    return marker_array;
  }

  for(size_t i = 0; i < schedule_->nodes.size(); i++) {
    const auto& action_node = schedule_->nodes.at(i);

    if(action_node.type == interfaces::msg::ActionNode::TYPE_AGV_COMMAND) {
      const uint32_t agv_id = action_node.agv_id;
      const std::string marker_base_ns = topics::kScheduleDag + "_agv" + std::to_string(agv_id);
      const std::vector<visualization_msgs::msg::Marker> markers = CreateAgvCommandMarkers({
          .agv_command = action_node.agv_command,
          .timestamp = context_->GetTimeNow(),
          .layout = context_->GetLayout(),
          .marker_base_ns = marker_base_ns,
          .marker_id = static_cast<int32_t>(i),
          .base_color = CreateColorRGBA(1.0, 0.0, 0.25),
          .z_offset_m = -1.0,
      });
      marker_array.markers.insert(marker_array.markers.end(), markers.begin(), markers.end());
    }
  }

  return marker_array;
}

}  // namespace volley::vis
