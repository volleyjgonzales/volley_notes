<file path="src/visualizer/vrc_visualizer.cpp">
#include "vis/visualizer/vrc_visualizer.hpp"

#include <chrono>
#include <cmath>
#include <common_ros/roslog.hpp>
#include <interfaces/msg/garage_node.hpp>
#include <numbers>
#include <rclcpp/time.hpp>
#include <std_msgs/msg/header.hpp>

#include "vis/math.hpp"
#include "vis/topics.hpp"
#include "vis/utils.hpp"
#include "vis/vis_context.hpp"
#include "vis/visualizer/i_visualizer.hpp"

namespace volley::vis {

namespace {
constexpr float kDefaultFloorHeightM = 3.6;
constexpr float kDefaultVrcWindowLengthM = 6.0;
constexpr float kDefaultVrcWindowWidthM = 2.5;

constexpr float kVrcBufferX = 1.0;
constexpr float kVrcBufferY = 1.0;
constexpr float kVrcCarriageMeshScaleZ = 0.5;
constexpr float kVrcDoorThicknessM = 0.1;
constexpr float kVrcModelScaleX = 4.8484;
constexpr float kVrcModelScaleY = 6.2915;
constexpr float kVrcModelScaleZ = 2.7408;

constexpr std::chrono::seconds kDoorMoveDuration(3);

constexpr auto kVrcShaftModelFileName = "vrc_shaft.dae";
constexpr auto kVrcLiftModelFileName = "vrc_tracks.dae";
constexpr auto kVrcCarriageModelFileName = "vrc_lift_plate.dae";
}  // namespace

VrcVisualizer::VrcVisualizer(VisContextSPtr context) : IVisualizer(std::move(context)) {
}

void VrcVisualizer::HandleGarageSnapshot(interfaces::msg::GarageSnapshot::ConstSharedPtr garage_snapshot) {
  for(const auto& vrc_report : garage_snapshot->vrcs) {
    vrc_reports_[vrc_report.id] = vrc_report;
  }
}

std::vector<VisMessage> VrcVisualizer::GetVisMessages() {
  return {{.topic_name = topics::kVrcs, .marker_array = CreateVrcsMarkerArray()}};
}

visualization_msgs::msg::MarkerArray VrcVisualizer::CreateVrcsMarkerArray() {
  visualization_msgs::msg::MarkerArray marker_array;

  for(const auto& vrc : context_->GetLayout()->GetVrcs()) {
    const std::vector<visualization_msgs::msg::Marker> markers = CreateVrcMarkers(vrc);
    marker_array.markers.insert(marker_array.markers.end(), markers.begin(), markers.end());
  }

  return marker_array;
}

std::vector<visualization_msgs::msg::Marker> VrcVisualizer::CreateVrcMarkers(const Vrc& vrc) {
  std::vector<visualization_msgs::msg::Marker> markers;

  if(vrc.nodes.empty()) {
    return markers;
  }

  const LayoutSPtr& layout = context_->GetLayout();

  // Use dimensions from bottom node for lift
  const interfaces::msg::GarageNode& first_node = vrc.nodes.at(0);

  // Get lift footprint dimensions (i.e. the max allowable parking window size from the layout)
  const auto window = layout->GetBufferedResourceWindow(first_node.max_resource_size);
  const float vrc_width_m =
      window.has_value() ? (window.value().width_m + kVrcBufferX) : kDefaultVrcWindowWidthM;
  const float vrc_length_m =
      window.has_value() ? (window.value().length_m + kVrcBufferY) : kDefaultVrcWindowLengthM;

  // Iterate through nodes in VRC layout object
  // Note: `floor_index` does not equal floor "number" but rather index into the nodes vector
  for(size_t floor_index = 0; floor_index < vrc.nodes.size(); floor_index++) {
    const interfaces::msg::GarageNode node = vrc.nodes.at(floor_index);
    // BLift terminals share a node with a Bay; the BayVisualizer draws walls,
    // doors, etc. at that node, so skip the VRC shaft/tracks/door meshes here
    // to avoid stacking two structures at the same pose.
    if(node.type == interfaces::msg::GarageNode::TYPE_BLIFT) {
      continue;
    }
    // Get the z value of the bottom of the floor
    const float floor_z_m = layout->GetFloorZForNodeId(node.id).value_or(0);
    // Get the height of the floor (floor to ceiling)
    const auto current_floor = layout->GetFloorById(node.floor);
    const auto next_floor = layout->GetFloorById(node.floor + 1);
    const float floor_to_ceiling_height_m = (current_floor.has_value() && next_floor.has_value())
                                                ? (next_floor.value().z - current_floor.value().z)
                                                : kDefaultFloorHeightM;

    geometry_msgs::msg::Pose base_pose;
    base_pose.position = Point(node.x, node.y, floor_z_m);
    const float heading_rad = GetInboundHeading(node) * volley::kDeg2Rad;
    base_pose.orientation = Quaternion(0.0, 0.0, heading_rad);

    visualization_msgs::msg::Marker base_marker =
        CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kVrcs, node.id);
    base_marker.pose = base_pose;
    base_marker.color = CreateColorRGBA(0.5, 0.5, 0.5);
    base_marker.scale.x = vrc_width_m / kVrcModelScaleX;
    base_marker.scale.y = vrc_length_m / kVrcModelScaleY;
    base_marker.scale.z = floor_to_ceiling_height_m / kVrcModelScaleZ;

    visualization_msgs::msg::Marker lift_shaft_marker = base_marker;
    lift_shaft_marker.ns += "_vrc_shaft";
    lift_shaft_marker.mesh_resource = context_->GetMeshResourcePrefix() + kVrcShaftModelFileName;
    markers.push_back(lift_shaft_marker);

    visualization_msgs::msg::Marker lift_shaft_tracks = base_marker;
    lift_shaft_tracks.ns = "vrc_tracks";
    lift_shaft_tracks.mesh_resource = context_->GetMeshResourcePrefix() + kVrcLiftModelFileName;
    markers.push_back(lift_shaft_tracks);

    const float vrc_yaw_wrt_map = heading_rad + (std::numbers::pi / 2);
    visualization_msgs::msg::Marker door_marker =
        CreateDefaultMarker(context_->GetTimeNow(), topics::kVrcs + "_door", node.id);
    door_marker.type = visualization_msgs::msg::Marker::CUBE;
    door_marker.pose.position = Point(node.x + (vrc_length_m / 2.0) * std::cos(vrc_yaw_wrt_map),
        node.y + (vrc_length_m / 2.0) * std::sin(vrc_yaw_wrt_map),
        floor_z_m + floor_to_ceiling_height_m / 2.0);
    door_marker.pose.orientation = Quaternion(0, 0, vrc_yaw_wrt_map);
    door_marker.scale.x = kVrcDoorThicknessM;
    door_marker.scale.y = vrc_width_m;
    door_marker.scale.z = floor_to_ceiling_height_m;
    door_marker.color = CreateColorRGBA(0.3, 0.1, 0.1, 0.7);

    vrc_interfaces::msg::GateState gate_state;
    gate_state.value = vrc_interfaces::msg::GateState::STATE_CLOSED;
    if(vrc_reports_.contains(vrc.id) && floor_index < vrc_reports_.at(vrc.id).gates.size()) {
      gate_state = vrc_reports_.at(vrc.id).gates.at(floor_index).state;
    }

    const float door_height_m = GetDoorHeightAtVrcNode(node.id, gate_state, floor_to_ceiling_height_m);
    door_marker.scale.z = door_height_m;
    door_marker.pose.position.z = (floor_z_m + floor_to_ceiling_height_m) - door_height_m / 2.0f;
    markers.push_back(std::move(door_marker));
  }

  // Render VRC carriage using height from VRCReport if available, bottom floor if not
  visualization_msgs::msg::Marker marker =
      CreateDefaultMeshMarker(context_->GetTimeNow(), topics::kVrcs + "_carriage", vrc.id);
  marker.scale.x = vrc_width_m / kVrcModelScaleX;
  marker.scale.y = vrc_length_m / kVrcModelScaleY;
  marker.scale.z = 1.0;

  marker.mesh_resource = context_->GetMeshResourcePrefix() + kVrcCarriageModelFileName;

  const float heading_rad = GetInboundHeading(first_node) * volley::kDeg2Rad;
  marker.pose.orientation = Quaternion(0.0, 0.0, heading_rad);
  marker.pose.position = Point(first_node.x, first_node.y, 0);

  if(vrc_reports_.contains(vrc.id)) {
    marker.pose.position.z = vrc_reports_.at(vrc.id).carriage_height_m;
  }

  marker.pose.position.z -= kVrcCarriageMeshScaleZ;

  markers.push_back(std::move(marker));

  return markers;
}

float VrcVisualizer::GetDoorHeightAtVrcNode(const uint32_t node_id,
    const vrc_interfaces::msg::GateState gate_state, const float floor_to_ceiling_height_m) {
  if(gate_state.value == vrc_interfaces::msg::GateState::STATE_OPEN) {
    door_start_time_[node_id] = std::nullopt;
    return 0;
  }
  if(gate_state.value == vrc_interfaces::msg::GateState::STATE_CLOSED) {
    door_start_time_[node_id] = std::nullopt;
    return floor_to_ceiling_height_m;
  }

  const rclcpp::Time time_now = context_->GetTimeNow();

  if(!door_start_time_.contains(node_id) || !door_start_time_.at(node_id).has_value()) {
    door_start_time_[node_id] = time_now;
    return (vrc_interfaces::msg::GateState::STATE_OPENING) ? floor_to_ceiling_height_m : 0.0;
  }

  const rclcpp::Time door_move_start_time = door_start_time_.at(node_id).value();
  const auto door_move_duration = (time_now - door_move_start_time).to_chrono<std::chrono::milliseconds>();

  float move_ratio =
      static_cast<float>(door_move_duration.count()) /
      static_cast<float>(std::chrono::duration_cast<std::chrono::milliseconds>(kDoorMoveDuration).count());

  move_ratio = std::max(std::min(move_ratio, 1.0f), 0.0f);

  if(gate_state.value == vrc_interfaces::msg::GateState::STATE_OPENING) {
    return floor_to_ceiling_height_m * (1.0 - move_ratio);
  }

  // STATE_CLOSING
  return move_ratio * floor_to_ceiling_height_m;
}

}  // namespace volley::vis
</file>

<file path="src/math.cpp">
#include "vis/math.hpp"

#include <cmath>

namespace volley::vis {

geometry_msgs::msg::Point Point(double x, double y, double z) {
  geometry_msgs::msg::Point point;
  point.x = x;
  point.y = y;
  point.z = z;
  return point;
}

geometry_msgs::msg::Quaternion Quaternion(double roll, double pitch, double yaw) {
  double cy = std::cos(yaw / 2);
  double sy = std::sin(yaw / 2);
  double cp = std::cos(pitch / 2);
  double sp = std::sin(pitch / 2);
  double cr = std::cos(roll / 2);
  double sr = std::sin(roll / 2);

  geometry_msgs::msg::Quaternion q;
  q.w = cr * cp * cy + sr * sp * sy;
  q.x = sr * cp * cy - cr * sp * sy;
  q.y = cr * sp * cy + sr * cp * sy;
  q.z = cr * cp * sy - sr * sp * cy;
  return q;
}

Eigen::Vector3d PointToVector3d(const geometry_msgs::msg::Point& point) {
  return Eigen::Vector3d {point.x, point.y, point.z};
}

geometry_msgs::msg::Point Vector3dToPoint(const Eigen::Vector3d& vector) {
  return Point(vector.x(), vector.y(), vector.z());
}

Eigen::Quaterniond QuatToQuatd(const geometry_msgs::msg::Quaternion& quat) {
  return Eigen::Quaterniond {quat.w, quat.x, quat.y, quat.z};
}

geometry_msgs::msg::Quaternion QuatdToQuat(const Eigen::Quaterniond& quatd) {
  geometry_msgs::msg::Quaternion quat;
  quat.w = quatd.w();
  quat.x = quatd.x();
  quat.y = quatd.y();
  quat.z = quatd.z();
  return quat;
}

std::pair<Eigen::Vector3d, Eigen::Quaterniond> PoseToVector3dAndQuatd(const geometry_msgs::msg::Pose& pose) {
  return std::make_pair(PointToVector3d(pose.position), QuatToQuatd(pose.orientation));
}

geometry_msgs::msg::Pose Vector3dAndQuatdToPose(
    const Eigen::Vector3d& vector, const Eigen::Quaterniond& quat) {
  geometry_msgs::msg::Pose pose;
  pose.position = Vector3dToPoint(vector);
  pose.orientation = QuatdToQuat(quat);
  return pose;
}

geometry_msgs::msg::Pose operator*(const geometry_msgs::msg::Pose& p1, const geometry_msgs::msg::Pose& p2) {
  auto [v1, q1] = PoseToVector3dAndQuatd(p1);
  auto [v2, q2] = PoseToVector3dAndQuatd(p2);

  // Rotate, then translate
  Eigen::Vector3d v3 = q1 * v2;
  v3 += v1;
  Eigen::Quaterniond q3 = q1 * q2;
  return Vector3dAndQuatdToPose(v3, q3);
}

}  // namespace volley::vis
</file>

