#include "sim/patrons.hpp"

namespace volley::sim {

Patrons::Patrons(const rclcpp::Logger& logger) : logger_(logger) {
}

std::optional<PayloadMsg> Patrons::GetWaitingPayload() const {
  if(insert_queue_.IsEmpty()) {
    return {};
  }

  return insert_queue_.Front();
}

bool Patrons::EnterInsertQueueCallback(const PayloadMsg& payload) {
  if(!insert_queue_.Push(payload)) {
    WARNS(logger_, "Cannot place " + std::to_string(payload.id) +
                       " into the insert queue because that payload_id already exists in the queue.");
    return false;
  }

  GarageEventMsg event {};
  event.type = GarageEventMsg::EVENT_PATRON_ENQUEUE;
  event.payload_id = std::to_string(payload.id);
  volley::PrintEvent(logger_, event);

  return true;
}

std::vector<PayloadMsg> Patrons::GetInsertQueue() const {
  // Publish insert queue. The copy is obviously inefficient but for the sizes
  // of queues we are dealing with, it shouldn't matter
  return insert_queue_.GetElements();
}

}  // namespace volley::sim
