#include "sim/tray.hpp"

#include <cmath>

namespace volley::sim {

GeometricPoseMsg GetPayloadPose(const Tray& tray) {
  auto payload_pose = tray.geometric_pose;
  payload_pose.yaw += static_cast<float>(tray.reciprocal_to_payload * M_PI);
  return payload_pose;
}

}  // namespace volley::sim
