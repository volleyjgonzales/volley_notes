// Triggers a call to the dispatcher to set the auto planner.
// Note, this makes a blocking call to the dispatcher node.
bool SimClients::SetAutoPlanner(bool plan_ready_jobs) {
  auto request = std::make_shared<TriggerSrv::Request>();
  std::optional<TriggerSrv::Response::SharedPtr> res_opt;
  if(plan_ready_jobs) {
    res_opt = volley::Call<TriggerSrv::Response>(start_planner_cli_, request, logger_);
  }
  else {
    res_opt = volley::Call<TriggerSrv::Response>(stop_planner_cli_, request, logger_);
  }

  return res_opt && res_opt.value()->success;
}

void SimClients::CallPlanner(const rclcpp::Time&) {
  volley::CallAsync<TriggerSrv::Response>(
      trigger_plan_cli_, std::make_shared<TriggerSrv::Request>(), logger_);
