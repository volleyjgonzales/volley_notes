#pragma once

#include <bay/doors_interface_base.hpp>
#include <bay/garage_door_ros.hpp>
#include <bay/sim/garage_door_sim.hpp>
#include <common_ros/node.hpp>
#include <common_ros/print_utils.hpp>
#include <rclcpp/logger.hpp>

#include "sim/sim_msgs.hpp"

namespace volley::sim {

struct Tray;

using BayDoors = std::unordered_map<bay::doors::Door, bay::open_close::DoorState>;

// The simulated Bay. Publishes the bay's simulated sensor streams (load cells, IO-link break beams,
// vehicle prox, radar, ODP observer) and simulates the door hardware, so the real bay state machine node
// can boot and run. Driven by Tick(), which advances the sensors/doors and, in auto-confirm mode,
// confirms the patron insert on the bay's behalf.
class BaySim {
public:
  BaySim(
      unsigned int bay_id, const bay::sim::BayDoorTimes& door_times, bool auto_confirm_insert, NodeSPtr node);

  BaySim(BaySim const&) = delete;
  BaySim& operator=(BaySim const&) = delete;

  //! Main tick function used to update the simulated bay. `tray_opt` is the tray, if any, that is currently
  //! in the bay.
  void Tick(const std::optional<Tray>& tray_opt, const rclcpp::Time& now);

  // Set a payload as inserting to this bay. Only allowed when there isn't already a payload being inserted
  // and the bay is in the ready to insert state.
  bool SetInsertingPayload(const std::optional<PayloadMsg>& payload);

  BayDoors GetDoors() const;
  const BayStateMsg& GetState() const { return state_; };
  BayReportMsg GetReport() const { return report_; };

  uint8_t GetPatronLight() const { return patron_light_state_; }
  void SetPatronLight(uint8_t new_state) { patron_light_state_ = new_state; }

private:
  void ResetInsertingPayload() { inserting_payload_.reset(); }
  void SetState(const BayStateMsg& state) { state_ = state; }
  unsigned int GetId() const { return bay_id_; }
  const rclcpp::Logger& GetLogger() const { return logger_; }
  const std::optional<PayloadMsg>& GetInsertingPayload() const { return inserting_payload_; }

  unsigned int bay_id_;

  // Whether the sim confirms the patron insert automatically, rather than waiting for an external confirm.
  bool auto_confirm_insert_;

  // Store the light state. Used to render the state of the light in the visualizer and control patron
  // assignment.
  uint8_t patron_light_state_ = 0;

  // A patron currently in the insertion process in the bay
  std::optional<PayloadMsg> inserting_payload_ = std::nullopt;

  // The true state of the bay
  BayStateMsg state_;

  rclcpp::Logger logger_;

  // Whether there is a pending payload awaiting insertion in the bay. This will be true when the bay state
  // machine is awaiting the vehicle to be verified but before it appears on the tray in the garage snapshot.
  bool pending_insert_payload_ = false;

  // Whether there is a payload in the bay awaiting exit from the bay during a retrieval. This will be true
  // when the bay state machine is awaiting the patron to retrieve the payload but before the vehicle exits
  // (and the load cells report 0).
  bool awaiting_payload_removal_ = false;

  // Whether we've already auto-confirmed the current retrieve from the sim side. Prevents the blocking
  // confirm_retrieve call from re-firing every tick while the bay finishes opening the patron door.
  bool retrieve_confirm_sent_ = false;

  // When we need to model the tire trip sensor, use this counter to send a few messages where the sensor is
  // broken.
  std::optional<unsigned int> tire_trip_counter_;

  // The last received bay report
  BayReportMsg report_;

  // The last received vehicle pose message
  VehicleBayPoseMsg vehicle_pose_;

  // The last updated true door state
  std::unordered_map<bay::doors::InterfaceBase::DoorId, bay::open_close::DoorState> true_door_state_;

  // Simulated door hardware
  std::vector<std::unique_ptr<bay::GarageDoorRos>> bay_doors_;

  // Subscribers
  rclcpp::Subscription<BayReportMsg>::SharedPtr report_sub_;
  rclcpp::Subscription<VehicleBayPoseMsg>::SharedPtr vehicle_pose_sub_;

  // Publishers
  rclcpp::Publisher<LoadCellsMsg>::SharedPtr load_cells_pub_;
  rclcpp::Publisher<IoLinkSensorsMsg>::SharedPtr io_link_sensors_pub_;
  rclcpp::Publisher<VehicleProxSensorMsg>::SharedPtr vehicle_prox_sensor_pub_;
  rclcpp::Publisher<RadarMsg>::SharedPtr radar_pub_;
  rclcpp::Publisher<OdpObserverMsg>::SharedPtr observer_pub_;

  // Services
  rclcpp::Service<PatronLightControlSrv>::SharedPtr light_control_srv_;
  rclcpp::Service<TriggerSrv>::SharedPtr reset_hardware_srv_;

  // Clients
  rclcpp::Client<SetPayloadInfoSrv>::SharedPtr confirm_insert_cli_;
  rclcpp::Client<TriggerSrv>::SharedPtr confirm_retrieve_cli_;
  rclcpp::CallbackGroup::SharedPtr client_cb_group_;
};

}  // namespace volley::sim
</file>

<file path="include/sim/collision_detector.hpp">
#pragma once

#include <iostream>
#include <map>
#include <optional>
#include <vector>

#include "sim/collision_utils.hpp"
#include "sim/sim_msgs.hpp"

namespace volley::sim {

// An enum that distinguished between collision body types.
enum class BodyType : uint8_t {
  UNKNOWN = CollisionBodyMsg::TYPE_UNKNOWN,
  AGV = CollisionBodyMsg::TYPE_AGV,
  TRAY = CollisionBodyMsg::TYPE_TRAY,
  BAY = CollisionBodyMsg::TYPE_BAY,
  PAYLOAD = CollisionBodyMsg::TYPE_PAYLOAD,
  CHARGER = CollisionBodyMsg::TYPE_CHARGER,
  OBSTRUCTION = CollisionBodyMsg::TYPE_OBSTRUCTION,
  // TODO(any): TYPE_EV_CHARGE_RIG when dimentions are known
};

// An identifer that uniquely identifies a collision body.
// This identifier lets us back out the original object, be it
// an AGV, tray, etc.
// The combination of id and type must be unique.
struct BodyIdentifier {
  unsigned int id = 0;  // Agv id, bay id, tray id, etc.
  BodyType type = BodyType::UNKNOWN;
};

BodyIdentifier AgvIdentifier(unsigned int id);
BodyIdentifier TrayIdentifier(unsigned int id);
BodyIdentifier BayIdentifier(unsigned int id);
BodyIdentifier PayloadIdentifier(unsigned int id);
BodyIdentifier ChargerIdentifier(unsigned int id);
BodyIdentifier ObstructionIdentifier(unsigned int id);

std::ostream& operator<<(std::ostream& os, const BodyIdentifier& iden);
bool operator<(const BodyIdentifier& a, const BodyIdentifier& b);

// Struct used internally in the collision detector.
struct BodyData {
  BodyIdentifier iden;
  OrientedBoundingBox3D volume {};
};

// A collection of collision volumes and identifiers to them.
// All collision volumes are 3D boxes that can rotate in yaw.
// This class allows us to detect collisions between these volumes.
class CollisionDetector {
public:
  CollisionDetector() = default;

  // Add a body to the collision detector. Returns when it was successul.
  bool AddBody(const BodyIdentifier& iden, const OrientedBoundingBox3D& volume);

  // Update the position and orientation of a collision volume. Returns when it was successul.
  bool UpdateVolume(const BodyIdentifier& iden, const GeometricPoseMsg& pose);

  // Overwrite a collision volume.  Returns when it was successul.
  bool SetVolume(const BodyIdentifier& iden, const OrientedBoundingBox3D& volume);

  // Remove a body.  Returns when it was successul.
  bool RemoveBody(const BodyIdentifier& iden);

  std::optional<OrientedBoundingBox3D> GetVolume(const BodyIdentifier& iden);

  // Find any pairwise collisions between objects. Each pair contains the names of the two
  // intersecting bodies.
  // This method is a fairly crude O(n^2) approach.
  std::vector<std::pair<BodyIdentifier, BodyIdentifier>> FindCollisions();

  // Contstruct a list of collision body ROS messages.
  std::vector<CollisionBodyMsg> ConstructBodyMessages() const;

private:
  // Map of name to data.
  // NOTE: std::map imposes an ordering according to the key's inequality check.
  std::map<BodyIdentifier, BodyData> body_data_;
};

}  // namespace volley::sim
</file>

<file path="include/sim/collision_utils.hpp">
#pragma once

#include "sim/oriented_bounding_box.hpp"

namespace volley::sim {

using BoxVertices = std::array<std::pair<double, double>, 4>;
BoxVertices GetBoxVertices(const OrientedBoundingBox& box);

std::pair<double, double> GetProjectionExtents(
    double bx, double by, double ux, double uy, const BoxVertices& box_vertices);

// Run the seprating axis theorem check on each of box a's normal directions.
// Returns true if every axis intersected, and false otherwise.
// NOTE: Abutting is _not_ considered a collision, but floating point imprecision makes this
// finicky.
bool RunSeparatingAxisTest(const OrientedBoundingBox& box_a, const OrientedBoundingBox& box_b);

// True iff box_a intersects with box_b
// The separated axis theorem states that for two convex 2D polygons to intersect,
// their projection on every axis must overlap.
// It is sufficient to project along the normal of every face of the two polygons.
// Find the minimum and maximum extents (largest and smallest value) of the projection of all the
// vertex corner points of both shapes onto that axis If they don't overlap, no intersection.
bool DoesIntersect(const OrientedBoundingBox& box_a, const OrientedBoundingBox& box_b);

// True if the interval [a_lo, a_hi] overlaps with the interval [b_lo, b_hi].
// Note, abutting is not considered overlapping.
// We assume a_hi > a_lo and b_hi > b_lo.
bool IntervalOverlaps(double a_lo, double a_hi, double b_lo, double b_hi);

// True iff box_a intersects with box_b
bool DoesIntersect(const OrientedBoundingBox3D& box_a, const OrientedBoundingBox3D& box_b);

};  // namespace volley::sim
</file>

<file path="include/sim/oriented_bounding_box.hpp">
#pragma once

#include "sim/sim_msgs.hpp"

namespace volley::sim {
// A 2D box with a location and orientation, often call OBB in the literature.
struct OrientedBoundingBox {
  double x;
  double y;
  double yaw;  // [rad]
  double half_x_len;
  double half_y_len;
};

// A 3D rectangular volume with a position and yaw.
struct OrientedBoundingBox3D {
  OrientedBoundingBox box;
  double z_lo;
  double z_hi;
};

// Constructors for entity oriented bounding boxes.
OrientedBoundingBox MakeBoundingBox(const GeometricPoseMsg& pose, double len_x, double len_y);
OrientedBoundingBox3D MakeBoundingBoxForAGV(const AgvStateMsg& agv_state, double ground_z = 0);
OrientedBoundingBox3D MakeBoundingBoxForTray(const GeometricPoseMsg& pose, double ground_z = 0);
OrientedBoundingBox3D MakeBoundingBoxForBay(
    const GarageNodeMsg& bay_node, bool system_open, double ground_z = 0);
OrientedBoundingBox3D MakeBoundingBoxForPayload(
    const GeometricPoseMsg& pose, const PayloadMsg& payload, double ground_z = 0);
OrientedBoundingBox3D MakeBoundingBoxForCharger(const GarageNodeMsg& charge_node, double ground_z = 0);

}  // namespace volley::sim
</file>

<file path="include/sim/patrons.hpp">
#pragma once

#include <common_ros/node.hpp>
#include <common_ros/print_utils.hpp>
#include <common_ros/ros_utils.hpp>
#include <structures/unique_queue.hpp>

#include "sim/sim_msgs.hpp"

namespace volley::sim {

struct PayloadComparator {
  bool operator()(const PayloadMsg& lhs, const PayloadMsg& rhs) const {
    return volley::GuidComparator()(lhs.id, rhs.id);
  }
};

// This class models all the patrons currently interacting with the volley sim. It maintains an
// insert queue accounting for patrons waiting to store vehicles in the garage. It also maintains
// and calls the simulated bay patron entities that model when a patron confirms insert/retrieve.
class Patrons {
public:
  explicit Patrons(const rclcpp::Logger& logger);

  // Returns the payload at the front of the insert queue if it exists.
  std::optional<PayloadMsg> GetWaitingPayload() const;

  // Removes the payload at the front of the insert queue if it exists.
  void PopWaitingPayload() { insert_queue_.PopFront(); }

  // Enter the back of the insert queue.
  bool EnterInsertQueueCallback(const PayloadMsg& payload);

  unsigned int GetNumWaitingPatrons() const { return insert_queue_.Size(); }

  // Get the current insert queue
  std::vector<PayloadMsg> GetInsertQueue() const;

private:
  // A queue of patron payloads
  volley::UniqueQueue<PayloadMsg, std::numeric_limits<size_t>::max(), PayloadComparator> insert_queue_;

  rclcpp::Logger logger_;
};

}  // namespace volley::sim
</file>

<file path="include/sim/scenario_runner.hpp">
#pragma once

#include <common/enum.hpp>
#include <common_ros/layout.hpp>
#include <queue>
#include <string>
#include <vector>

#include "sim/collision_utils.hpp"
#include "sim/sim_msgs.hpp"

namespace volley::sim {

// AGVs, Trays, and Payloads that should be initially loaded into the sim
struct InitialConditions {
  std::vector<AddAgvSrv::Request> agvs;
  std::vector<AddTraySrv::Request> trays;
  std::vector<AddPayloadSrv::Request> payloads;
  std::vector<std::pair<uint16_t, OrientedBoundingBox3D>> obstructions;
  void Clear() {
    agvs.clear();
    trays.clear();
    payloads.clear();
  }
  bool IsEmpty() const { return agvs.empty() && trays.empty() && payloads.empty(); }
};

// A single event in a scenario. Must contain a time and a type. Other fields may be used depending
// on the event type.
struct Event {
  enum class Type {
    MOVE_AGV,
    MOVE_TRAY,
    REMOVE_AGV,
    SET_AGV_BATTERY_FRACTION,
    SET_NODE_DISABLEDNESS,
    SET_TRAY_DISABLEDNESS,
    SET_DISPATCH_MODE,
    START_DISPATCH,
    STOP_DISPATCH,
    PAUSE_DISPATCH,
    PATRON_ARRIVAL,
    REPARK_TRAY,
    RETRIEVE_REQUEST,
    SET_BAY_READINESS_RATIO,
    SET_AUTO_PLANNER,
    CALL_PLANNER,
    TRANSITION_BAY_TO_INSERT,
    TRANSITION_BAY_TO_RETRIEVE,
    CHARGE_PAYLOAD,
  };

  Event() = delete;
  Event(Type type, double time) : type(type), time(time) { }
  explicit Event(const SimEventSrv::Request::SharedPtr ev) {
    auto type_opt = common::EnumCastCaseInsensitive<Type>(ev->type);
    if(!type_opt) {
      throw std::runtime_error("Failed to construct Event from type " + ev->type);
    }
    type = type_opt.value();
    time = ev->time;
    resource_id = ev->resource_id;
    garage_pose = ev->pose;
    float_value = ev->float_value;
    uint_value = ev->uint_value;
    bool_value = ev->bool_value;
    payload = ev->payload;
  }

  // Note: because a priority queue by default sorts items in descending order, we reverse the
  // comparison operator here to ensure we get a priority queue of events in ascending order.
  bool operator<(const Event& rhs) const { return time > rhs.time; }

  // Required fields for each event type
  Type type;
  double time;  // The simulated time at which this event should occur

  // Possible fields for each event type
  unsigned int resource_id = 0;
  GaragePoseMsg garage_pose {};
  float float_value = 0.0f;
  unsigned int uint_value = 0;
  bool bool_value = false;
  PayloadMsg payload {};
};

// TODO(Gunther) Just parse directly into a DiscreteGarageState just like from mysql
// In fact, doesn't even need to be just discrete, starting the sim mid-action would
// be rad.
std::tuple<std::vector<Event>, InitialConditions, LayoutSPtr> ParseScenarioFile(
    const std::string& scenario_file);

// A simple class for processing a scenario file, creating the initial conditions and processing the
// requested events as needed.
class ScenarioRunner {
public:
  explicit ScenarioRunner(const std::vector<Event>& events);

  // Based on the time since the simulation started, return the number of new events that should
  // be processed. Once an event is returned by this function, it will not be processed again.
  std::vector<Event> GetNextEvents(double seconds_since_start);

  unsigned int GetNumRemainingEvents() const { return events_.size(); }

  // Adds events to the priority queue based on the event time.
  // Events timed before the last tick are automatically executed on the
  // next Tick, in timing order.
  void AddEvent(Event&& ev) { events_.emplace(ev); }

private:
  // Events are sorted by time in the priority queue. Why it wasn't just a vector, sorted
  // once at creation time is lost on me, but ends up working in our favor perhaps for adding
  // events on the fly.
  std::priority_queue<Event> events_;
};

}  // namespace volley::sim
</file>

