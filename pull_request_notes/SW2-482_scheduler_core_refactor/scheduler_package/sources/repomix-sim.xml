#include "sim/collision_detector.hpp"

#include <vis/math.hpp>

namespace volley::sim {

BodyIdentifier AgvIdentifier(unsigned int id) {
  return BodyIdentifier {id, BodyType::AGV};
}
BodyIdentifier TrayIdentifier(unsigned int id) {
  return BodyIdentifier {id, BodyType::TRAY};
}
BodyIdentifier BayIdentifier(unsigned int id) {
  return BodyIdentifier {id, BodyType::BAY};
}
BodyIdentifier PayloadIdentifier(unsigned int id) {
  return BodyIdentifier {id, BodyType::PAYLOAD};
}
BodyIdentifier ChargerIdentifier(unsigned int id) {
  return BodyIdentifier {id, BodyType::CHARGER};
}
BodyIdentifier ObstructionIdentifier(unsigned int id) {
  return BodyIdentifier {id, BodyType::OBSTRUCTION};
}
// TODO(any): Ev Charge Rig

std::ostream& operator<<(std::ostream& os, const BodyIdentifier& iden) {
  if(iden.type == BodyType::AGV) {
    os << "a";
  }
  else if(iden.type == BodyType::TRAY) {
    os << "t";
  }
  else if(iden.type == BodyType::BAY) {
    os << "b";
  }
  else if(iden.type == BodyType::PAYLOAD) {
    os << "p";
  }
  else if(iden.type == BodyType::CHARGER) {
    os << "c";
  }
  else if(iden.type == BodyType::OBSTRUCTION) {
    os << "o";
  }
  else {
    os << "u";
  }

  os << iden.id;

  return os;
}

bool operator<(const BodyIdentifier& a, const BodyIdentifier& b) {
  if(a.type != b.type) {
    return a.type < b.type;
  }
  return a.id < b.id;
}

bool CollisionDetector::AddBody(const BodyIdentifier& iden, const OrientedBoundingBox3D& volume) {
  if(body_data_.find(iden) != body_data_.end()) {
    // Already have a body with this identifier.
    return false;
  }

  BodyData data;
  data.iden = iden;
  data.volume = volume;
  body_data_.emplace(iden, data);

  return true;
}

bool CollisionDetector::UpdateVolume(const BodyIdentifier& iden, const GeometricPoseMsg& pose) {
  auto it = body_data_.find(iden);
  if(it == body_data_.end()) {
    return false;  // not found
  }

  OrientedBoundingBox3D& volume = it->second.volume;
  volume.box.x = pose.x;
  volume.box.y = pose.y;
  volume.box.yaw = pose.yaw;
  return true;
}

bool CollisionDetector::SetVolume(const BodyIdentifier& iden, const OrientedBoundingBox3D& volume) {
  auto it = body_data_.find(iden);
  if(it == body_data_.end()) {
    return false;  // not found
  }

  it->second.volume = volume;
  return true;
}

bool CollisionDetector::RemoveBody(const BodyIdentifier& iden) {
  auto it = body_data_.find(iden);
  if(it == body_data_.end()) {
    return false;  // not found
  }

  body_data_.erase(it);
  return true;
}

std::optional<OrientedBoundingBox3D> CollisionDetector::GetVolume(const BodyIdentifier& iden) {
  auto it = body_data_.find(iden);
  if(it != body_data_.end()) {
    return it->second.volume;
  }
  return std::nullopt;
}

std::vector<std::pair<BodyIdentifier, BodyIdentifier>> CollisionDetector::FindCollisions() {
  std::vector<std::pair<BodyIdentifier, BodyIdentifier>> collisions;

  auto it = body_data_.begin();
  while(it != body_data_.end()) {
    const auto& data_a = it->second;
    auto jt = it;
    std::advance(jt, 1);
    while(jt != body_data_.end()) {
      const auto& data_b = jt->second;

      if(DoesIntersect(data_a.volume, data_b.volume)) {
        collisions.emplace_back(std::make_pair(data_a.iden, data_b.iden));
      }

      std::advance(jt, 1);
    }
    std::advance(it, 1);
  }

  return collisions;
}

std::vector<CollisionBodyMsg> CollisionDetector::ConstructBodyMessages() const {
  std::vector<CollisionBodyMsg> bodies(body_data_.size());

  size_t i = 0;
  for(const auto& [iden, data] : body_data_) {
    auto& body = bodies.at(i);
    body.id = iden.id;
    body.type = static_cast<uint8_t>(iden.type);
    body.yaw = static_cast<float>(data.volume.box.yaw);
    body.center =
        volley::vis::Point(data.volume.box.x, data.volume.box.y, (data.volume.z_lo + data.volume.z_hi) / 2);
    body.scale = volley::vis::Point(
        2 * data.volume.box.half_x_len, 2 * data.volume.box.half_y_len, data.volume.z_hi - data.volume.z_lo);
    i++;
  }

  return bodies;
}

}  // namespace volley::sim
</file>

<file path="src/collision_utils.cpp">
#include "sim/collision_utils.hpp"

#include <cmath>

namespace volley::sim {

using BoxVertices = std::array<std::pair<double, double>, 4>;
BoxVertices GetBoxVertices(const OrientedBoundingBox& box) {
  double x_x = box.half_x_len * std::cos(box.yaw);
  double x_y = box.half_x_len * std::sin(box.yaw);
  double y_x = box.half_y_len * std::cos(box.yaw + M_PI / 2);
  double y_y = box.half_y_len * std::sin(box.yaw + M_PI / 2);
  auto pt_front_left = std::make_pair(box.x + x_x + y_x, box.y + x_y + y_y);
  auto pt_back_left = std::make_pair(box.x - x_x + y_x, box.y - x_y + y_y);
  auto pt_back_right = std::make_pair(box.x - x_x - y_x, box.y - x_y - y_y);
  auto pt_front_right = std::make_pair(box.x + x_x - y_x, box.y + x_y - y_y);

  BoxVertices vertices {pt_front_left, pt_back_left, pt_back_right, pt_front_right};
  return vertices;
}

std::pair<double, double> GetProjectionExtents(
    double bx, double by, double ux, double uy, const BoxVertices& box_vertices) {
  double proj_lo = std::numeric_limits<double>::infinity();
  double proj_hi = -std::numeric_limits<double>::infinity();
  for(auto [vx, vy] : box_vertices) {
    double proj = (vx - bx) * ux + (vy - by) * uy;
    proj_lo = std::min(proj_lo, proj);
    proj_hi = std::max(proj_hi, proj);
  }
  return std::make_pair(proj_lo, proj_hi);
}

bool RunSeparatingAxisTest(const OrientedBoundingBox& box_a, const OrientedBoundingBox& box_b) {
  // We only have two normals, along box_a yaw and along box_a yaw + pi/2
  auto vertices_b = GetBoxVertices(box_b);

  // Project along x
  double ux = std::cos(box_a.yaw);
  double uy = std::sin(box_a.yaw);
  auto [proj_lo, proj_hi] = GetProjectionExtents(box_a.x, box_a.y, ux, uy, vertices_b);
  if(proj_lo > box_a.half_x_len || proj_hi < -box_a.half_x_len) {
    return false;  // separated!
  }

  // Project along y
  std::swap(ux, uy);
  ux = -ux;
  std::tie(proj_lo, proj_hi) = GetProjectionExtents(box_a.x, box_a.y, ux, uy, vertices_b);
  if(proj_lo > box_a.half_y_len || proj_hi < -box_a.half_y_len) {
    return false;  // separated!
  }

  return true;
}

bool DoesIntersect(const OrientedBoundingBox& box_a, const OrientedBoundingBox& box_b) {
  return RunSeparatingAxisTest(box_a, box_b) && RunSeparatingAxisTest(box_b, box_a);
}

bool IntervalOverlaps(double a_lo, double a_hi, double b_lo, double b_hi) {
  return a_hi > b_lo && b_hi > a_lo;
}

bool DoesIntersect(const OrientedBoundingBox3D& a, const OrientedBoundingBox3D& b) {
  return DoesIntersect(a.box, b.box) && IntervalOverlaps(a.z_lo, a.z_hi, b.z_lo, b.z_hi);
}

}  // namespace volley::sim
</file>

<file path="src/oriented_bounding_box.cpp">
#include "sim/oriented_bounding_box.hpp"

#include <common/constants.hpp>
#include <common_ros/layout.hpp>
#include <geometry_msgs/msg/pose.hpp>
#include <vis/math.hpp>

namespace volley::sim {
using namespace vis;

OrientedBoundingBox MakeBoundingBox(const GeometricPoseMsg& pose, double len_x, double len_y) {
  return OrientedBoundingBox {pose.x, pose.y, pose.yaw, len_x / 2.0f, len_y / 2.0f};
}

OrientedBoundingBox3D MakeBoundingBoxForAGV(const AgvStateMsg& agv_state, double ground_z) {
  OrientedBoundingBox3D box_3d {};
  box_3d.box = MakeBoundingBox(agv_state.geometric_pose, kAgvWidth, kAgvLength);
  box_3d.z_lo = ground_z;
  // Use the highest lift to determine the bounding box for the AGV (worse case)
  box_3d.z_hi = ground_z + (kAgvHeightLowered + (kAgvHeightRaised - kAgvHeightLowered) *
                                                    *std::max_element(agv_state.lift_fractions.begin(),
                                                        agv_state.lift_fractions.end()));
  return box_3d;
}

OrientedBoundingBox3D MakeBoundingBoxForTray(const GeometricPoseMsg& pose, double ground_z) {
  OrientedBoundingBox3D box_3d {};
  box_3d.box = MakeBoundingBox(pose, kTrayWidth, kTrayLength);
  box_3d.z_lo = ground_z + (kTrayHeight - kTrayThickness);
  box_3d.z_hi = ground_z + kTrayHeight;
  return box_3d;
}

OrientedBoundingBox3D MakeBoundingBoxForBay(
    const GarageNodeMsg& bay_node, bool system_open, double ground_z) {
  OrientedBoundingBox3D box_3d {};
  // Given the location of the node, create a bounding box for the overdrive plate and the system
  // interior door. For the sake of collisions, we will have the overdrive plate be "in place" if
  // the system interior door is closed so we don't have to additionally check for collisions with
  // the door.
  double buffer = 0.0064;  // model ~1/4" between tray and overdrive plate
  double overdrive_y_length = (kBayLength - kTrayLength) / 2 - buffer;
  double overdrive_yaw = volley::GetInboundHeading(bay_node) * kDeg2Rad;

  // Get the center of the overdrive plate relative to a bay at the origin with zero heading
  geometry_msgs::msg::Pose overdrive_pose {};
  overdrive_pose.position.x = 0;
  overdrive_pose.position.y = kTrayLength / 2 + overdrive_y_length / 2 + 2 * buffer;

  geometry_msgs::msg::Pose bay_pose {};
  bay_pose.position.x = bay_node.x;
  bay_pose.position.y = bay_node.y;
  bay_pose.orientation = Quaternion(0.0, 0.0, overdrive_yaw);

  // Rotate the overdrive pose into the bay frame
  overdrive_pose = bay_pose * overdrive_pose;

  GeometricPoseMsg overdrive_xy {};
  overdrive_xy.x = static_cast<float>(overdrive_pose.position.x);
  overdrive_xy.y = static_cast<float>(overdrive_pose.position.y);
  overdrive_xy.yaw = static_cast<float>(overdrive_yaw);
  box_3d.box = MakeBoundingBox(overdrive_xy, kTrayWidth, overdrive_y_length);
  box_3d.z_lo = ground_z;
  // Assume it is slightly below the tray to avoid false collisions with payloads
  box_3d.z_hi = ground_z + (kTrayHeight - buffer);

  // If the system door and overdrive plate are fully open, we make the bounding box very small
  // and slightly underground so that there are no collisions
  if(system_open) {
    box_3d.z_lo = ground_z - 0.2;
    box_3d.z_hi = ground_z - 0.1;
  }
  return box_3d;
}

OrientedBoundingBox3D MakeBoundingBoxForPayload(
    const GeometricPoseMsg& pose, const PayloadMsg& payload, double ground_z) {
  OrientedBoundingBox3D box_3d {};
  box_3d.box = MakeBoundingBox(pose, payload.width_m, payload.length_m);
  box_3d.z_lo = ground_z + kTrayHeight;
  box_3d.z_hi = box_3d.z_lo + payload.height_m;
  return box_3d;
}

// TYPE_AGV_CHARGE
OrientedBoundingBox3D MakeBoundingBoxForCharger(const GarageNodeMsg& charge_node, double ground_z) {
  double charger_yaw = volley::GetInboundHeading(charge_node) * kDeg2Rad;

  // Get the center of the charger relative to its charge node pose
  // The charger is located in the direction opposite of the charge node's orientation
  geometry_msgs::msg::Pose charger_pose {};
  charger_pose.position.x = (kChargerLateralOffsetFromAgv + kAgvWidth / 2 + kChargerDepth / 2);

  // Rotate the pose relative to the charger frame
  geometry_msgs::msg::Pose node_pose {};
  node_pose.position.x = charge_node.x;
  node_pose.position.y = charge_node.y;
  node_pose.orientation = Quaternion(0.0, 0.0, charger_yaw);
  charger_pose = node_pose * charger_pose;

  GeometricPoseMsg charger_xy {};
  charger_xy.x = static_cast<float>(charger_pose.position.x);
  charger_xy.y = static_cast<float>(charger_pose.position.y);
  charger_xy.yaw = static_cast<float>(charger_yaw);

  OrientedBoundingBox3D box_3d {};
  box_3d.box = MakeBoundingBox(charger_xy, kChargerDepth, kChargerWidth);
  box_3d.z_lo = ground_z;
  box_3d.z_hi = ground_z + kChargerHeight;

  return box_3d;
}

}  // namespace volley::sim
</file>

