time: 0.0
resource_id: 0
pose:
  node_id: 0
  heading: 0
float_value: 0.0
uint_value: 0
bool_value: false
payload:
  id:
    bytes: ${uuid_array}
  mass: 1500.0
  length_m: 5.0
  width_m: 2.0
  height_m: 3.0"
