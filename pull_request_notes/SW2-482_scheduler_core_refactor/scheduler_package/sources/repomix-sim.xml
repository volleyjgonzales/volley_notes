<file path="src/bay_sim_component.cpp">
#include <chrono>
#include <common/topics_sim.hpp>
#include <common_ros/component.hpp>
#include <common_ros/node.hpp>
#include <common_ros/ros_utils.hpp>
#include <memory>
#include <optional>
#include <rclcppx/interface_factories.hpp>
#include <string>

#include "sim/bay_sim.hpp"
#include "sim/tray.hpp"

namespace volley::sim {

using namespace std::chrono_literals;

// How often the bay hardware sim advances, in simulated time (scales with real_time_factor via /clock).
constexpr auto kBayTickPeriod = 50ms;

// Self-contained per-bay hardware simulator. It wraps the BaySim, which publishes the bay's simulated sensor
// streams (load cells, IO-link break beams, vehicle prox, ODP observer) and serves the reset_hardware /
// patron_light / door services that the REAL bay state machine node needs in order to boot and operate.
class BaySimComponent : public volley::Component {
public:
  explicit BaySimComponent(const rclcpp::NodeOptions& options) {
    node_ = std::make_shared<volley::Node>("bay_sim", options);
    SetNode(node_);

    bay_id_ = static_cast<unsigned int>(volley::RequiredParam<int64_t>(*node_, "bay_id"));

    bay::sim::BayDoorTimes door_times;
    door_times.open = bay::sim::SecondsF {node_->Param<float>("bay.door.open_time")};
    door_times.close = bay::sim::SecondsF {node_->Param<float>("bay.door.close_time")};

    // When false, the sim leaves the insert for something outside it to confirm (the app, the REST API, or
    // a manual `/bay/b{bay_id}/confirm_insert` call) rather than auto confirming on the patron's behalf
    const bool auto_confirm_insert = node_->Param<bool>("simulator.auto_confirm_insert", true);

    bay_sim_ = std::make_unique<BaySim>(bay_id_, door_times, auto_confirm_insert, node_);

    // Simulator (which owns the patron queue) offers a waiting payload here. SetInsertingPayload
    // only accepts when this bay is READY_TO_INSERT and not already inserting, so Simulator can
    // offer to every bay and rely on this to land it in the one that's actually ready.
    offer_inserting_payload_srv_ = rclcppx::CreateService<PlacePayloadInBaySrv>(node_,
        "/bay/b" + std::to_string(bay_id_) + "/sim_offer_inserting_payload",
        [this](PlacePayloadInBaySrv::Request::SharedPtr request,
            PlacePayloadInBaySrv::Response::SharedPtr response) {
          response->success = bay_sim_->SetInsertingPayload(request->payload);
          response->message = response->success ? "accepted" : "bay not ready to insert";
        });

    snapshot_sub_ = node_->create_subscription<GarageSnapshotMsg>(
        "/central/" + volley::TopicGarageSnapshot().Name(), volley::GetBestEffortQoS(1),
        [this](GarageSnapshotMsg::ConstSharedPtr msg) { snapshot_ = std::move(msg); });

    tick_timer_ =
        rclcpp::create_timer(node_, node_->get_clock(), kBayTickPeriod, [this]() { Tick(node_->now()); });
  }

private:
  // Find the tray currently parked in this bay (and join its payload), from the latest snapshot.
  std::optional<Tray> GetTrayInBay() const {
    if(!snapshot_) {
      return std::nullopt;
    }
    for(const auto& garage_tray : snapshot_->trays) {
      if(garage_tray.pose.node_id != bay_id_) {
        continue;
      }
      Tray tray {};
      tray.id = garage_tray.id;
      tray.garage_pose = garage_tray.pose;
      tray.geometric_pose = garage_tray.geometric_pose;
      tray.reciprocal_to_payload = garage_tray.reciprocal_to_payload;
      if(garage_tray.payload_id != volley::kEmptyGuid) {
        for(const auto& garage_payload : snapshot_->payloads) {
          if(garage_payload.payload.id == garage_tray.payload_id) {
            tray.payload = garage_payload.payload;
            break;
          }
        }
      }
      return tray;
    }
    return std::nullopt;
  }

  void Tick(const rclcpp::Time& now) {
    const std::optional<Tray> tray_opt = GetTrayInBay();
    bay_sim_->Tick(tray_opt, now);
  }

  NodeSPtr node_;
  unsigned int bay_id_ = 0;
  std::unique_ptr<BaySim> bay_sim_;

  GarageSnapshotMsg::ConstSharedPtr snapshot_;

  rclcpp::Subscription<GarageSnapshotMsg>::SharedPtr snapshot_sub_;
  rclcpp::Service<PlacePayloadInBaySrv>::SharedPtr offer_inserting_payload_srv_;
  rclcpp::TimerBase::SharedPtr tick_timer_;
};

}  // namespace volley::sim

#include <rclcpp_components/register_node_macro.hpp>
RCLCPP_COMPONENTS_REGISTER_NODE(volley::sim::BaySimComponent)
</file>

<file path="src/bay_sim.cpp">
#include "sim/bay_sim.hpp"

#include <bay/bay_floor_spec.hpp>
#include <bay/bay_insert_state_machine.hpp>
#include <bay/bay_retrieve_state_machine.hpp>
#include <bay/sim/garage_door_sim.hpp>
#include <bay_interfaces/topics.hpp>
#include <common/constants.hpp>
#include <common/enum.hpp>
#include <common/topics_bay.hpp>
#include <common_ros/ros_utils.hpp>
#include <rclcppx/interface_factories.hpp>
#include <site_config/paths.hpp>

#include "sim/tray.hpp"

namespace volley::sim {

using namespace std::chrono_literals;

// When mocking a tire sensor, this is the number of times it will return broken.
constexpr int kTireSensorBrokenCounts = 6;

namespace {

// Returns true when the bay insert state machine reports a state that can only reach once the insert has been
// confirmed. Used when `auto_confirm_insert` is false so the sim can watch for one of these to learn that
// something outside the sim confirmed the patron's insert.
bool InsertConfirmedExternally(int internal_state) {
  const auto state = common::EnumCast<bay::insert::State>(internal_state);
  if(!state.has_value()) {
    return false;
  }
  switch(state.value()) {
  case bay::insert::State::PATRON_DOOR_CLOSING:
  case bay::insert::State::VERIFYING_VEHICLE:
  case bay::insert::State::VEHICLE_VETTED:
    return true;
  default:
    return false;
  }
}

}  // namespace

BaySim::BaySim(
    unsigned int bay_id, const bay::sim::BayDoorTimes& door_times, bool auto_confirm_insert, NodeSPtr node) :
    bay_id_(bay_id), auto_confirm_insert_(auto_confirm_insert), logger_(node->get_logger()) {
  if(!auto_confirm_insert_) {
    INFOS(node->get_logger(),
        "Bay " << bay_id << " will wait for an external confirm_insert instead of auto-confirming.");
  }
  // Construct our simulated doors

  std::string floor_spec_name;
  try {
    floor_spec_name = node->Param<std::string>("bay.floor_spec");
  }
  catch(const std::exception& exception) {
    ERRORS(node->get_logger(), "Failed to load bay floor spec: " << exception.what());
    exit(1);
  }

  INFOS(
      node->get_logger(), "Loading floor spec: " << (floor_spec_name.empty() ? "default" : floor_spec_name));

  std::vector<bay::FloorSpec> floor_specs = {bay::DefaultFloorSpec()};
  if(!floor_spec_name.empty()) {
    const auto floor_spec_path_or = site_config::GetFloorSpecPathByName(floor_spec_name);
    if(!floor_spec_path_or.has_value()) {
      ERRORS(node->get_logger(), floor_spec_path_or.error());
      exit(1);
    }
    std::string msg;
    std::tie(floor_specs, msg) = bay::LoadFloorSpec(floor_spec_path_or.value());
    if(floor_specs.empty()) {
      ERRORS(node->get_logger(), "Failed to load floor spec: " << msg);
      exit(1);
    }
  }

  for(const auto& floor : floor_specs) {
    for(const auto& door : floor.patron_doors) {
      bay_doors_.emplace_back(std::make_unique<bay::GarageDoorRos>(node,
          std::make_unique<bay::sim::GarageDoorSimRt>(node, door_times, bay_id, door.name,
              [this, door](const bay::open_close::DoorState& state) { true_door_state_[door.id] = state; }),
          bay_id));
    }
    for(const auto& door : floor.system_doors) {
      bay_doors_.emplace_back(std::make_unique<bay::GarageDoorRos>(node,
          std::make_unique<bay::sim::GarageDoorSimRt>(node, door_times, bay_id, door.name,
              [this, door](const bay::open_close::DoorState& state) { true_door_state_[door.id] = state; }),
          bay_id));
    }
  }

  // Subscriptions
  vehicle_pose_sub_ = node->create_subscription<VehicleBayPoseMsg>(
      volley::TopicBayVehiclePose().Name(), 1, [this](VehicleBayPoseMsg::UniquePtr msg) {
        // Reset the tire trip counter if we've seen a change in the number of estimated axles
        if(msg->num_axles_on_tray != vehicle_pose_.num_axles_on_tray) {
          tire_trip_counter_.reset();
        }
        vehicle_pose_ = *msg;
      });
  report_sub_ = node->create_subscription<BayReportMsg>(volley::TopicBayReport().Name(),
      volley::GetReliableQoS(1), [this](BayReportMsg::UniquePtr msg) { report_ = *msg; });

  // Publishers
  load_cells_pub_ = rclcppx::CreatePublisher(node, bay_interfaces::kLoadCellsTopic);
  io_link_sensors_pub_ = rclcppx::CreatePublisher(node, bay_interfaces::kIoLinkSensorsTopic);
  vehicle_prox_sensor_pub_ = rclcppx::CreatePublisher(node, bay_interfaces::kVehicleProxSensorTopic);
  radar_pub_ = rclcppx::CreatePublisher(node, bay_interfaces::kRadarTopic);
  observer_pub_ = node->create_publisher<OdpObserverMsg>(
      volley::TopicBayOdpObserver(bay::doors::OdpDoor::OVERDRIVE_LEFT).Name(), 1);

  // Services
  reset_hardware_srv_ = rclcppx::CreateService<TriggerSrv>(
      node, "reset_hardware", [](TriggerSrv::Request::SharedPtr, TriggerSrv::Response::SharedPtr response) {
        response->success = true;
        response->message = "Successful simulated hardware reset.";
      });
  light_control_srv_ = rclcppx::CreateService<PatronLightControlSrv>(node, "patron_light_control",
      [this](const PatronLightControlSrv::Request::SharedPtr request,
          PatronLightControlSrv::Response::SharedPtr response) {
        SetPatronLight(request->light_state);
        response->success = true;
        response->message = "";
      });

  // Clients
  // Use a separate callback group so we can use blocking service calls
  client_cb_group_ = node->create_callback_group(rclcpp::CallbackGroupType::MutuallyExclusive);
  confirm_insert_cli_ =
      node->create_client<SetPayloadInfoSrv>("confirm_insert", rclcpp::ServicesQoS(), client_cb_group_);
  confirm_retrieve_cli_ =
      node->create_client<TriggerSrv>("confirm_retrieve", rclcpp::ServicesQoS(), client_cb_group_);
}

void BaySim::Tick(const std::optional<Tray>& tray_opt, const rclcpp::Time& now) {
  // Assume all break beam sensors are open until shown otherwise
  auto io_link_sensors = std::make_unique<IoLinkSensorsMsg>();
  io_link_sensors->lidar_patron = io_link_sensors->BREAK_BEAM_OPEN;
  io_link_sensors->lidar_system = io_link_sensors->BREAK_BEAM_OPEN;
  io_link_sensors->lidar_left = io_link_sensors->BREAK_BEAM_OPEN;
  io_link_sensors->lidar_right = io_link_sensors->BREAK_BEAM_OPEN;
  io_link_sensors->lidar_height_tall = io_link_sensors->BREAK_BEAM_OPEN;
  io_link_sensors->lidar_height_mid = io_link_sensors->BREAK_BEAM_OPEN;
  io_link_sensors->lidar_height_short = io_link_sensors->BREAK_BEAM_OPEN;
  io_link_sensors->tire_system = io_link_sensors->BREAK_BEAM_OPEN;
  io_link_sensors->tire_patron = io_link_sensors->BREAK_BEAM_OPEN;

  auto vehicle_prox_sensor = std::make_unique<VehicleProxSensorMsg>();
  vehicle_prox_sensor->activation_detection = false;
  vehicle_prox_sensor->presence_detection = false;

  // Calculate simulated sensor values
  double load_cell_total_mass = 0.0;  // [kg]
  if(tray_opt.has_value()) {
    // We have a tray in the bay!
    load_cell_total_mass = kTrayMass;

    if(tray_opt->payload.has_value() && !awaiting_payload_removal_) {
      // Model the payload as in place if the dispatcher knows about a payload in the bay.
      load_cell_total_mass = tray_opt->payload->mass + kTrayMass;
    }
    else if(GetInsertingPayload().has_value()) {
      // If a patron is inserting, model them as coming onto the tray and properly parking

      // Have the vehicle proximity sensor detect the patron
      vehicle_prox_sensor->activation_detection = true;
      vehicle_prox_sensor->presence_detection = true;

      load_cell_total_mass =
          GetInsertingPayload()->mass * static_cast<double>(vehicle_pose_.num_axles_on_tray) / 2.0 +
          kTrayMass;

      // Until we have two axles on the tray, mimic a vehicle driving onto the tray
      if(vehicle_pose_.num_axles_on_tray < 2) {
        // Start the tire trip counter if we haven't already
        if(!tire_trip_counter_.has_value()) {
          tire_trip_counter_ = 0;
        }
        // Once we are halfway through the broken count, increase the load cell mass
        if(tire_trip_counter_.value() > kTireSensorBrokenCounts / 2) {
          load_cell_total_mass =
              GetInsertingPayload()->mass * static_cast<double>(vehicle_pose_.num_axles_on_tray + 1) / 2.0 +
              kTrayMass;
        }
      }
    }
  }

  // Break the patron tire sensor if needed
  if(report_.state == report_.STATE_PROCESSING_INSERT && tire_trip_counter_.has_value() &&
      tire_trip_counter_.value()++ < kTireSensorBrokenCounts) {
    io_link_sensors->tire_patron = io_link_sensors->BREAK_BEAM_BROKEN;
  }

  auto load_cells = std::make_unique<LoadCellsMsg>();
  load_cells->header.stamp = now;
  double load_cell_mass = load_cell_total_mass / static_cast<double>(load_cells->mass.size());
  load_cells->mass.fill(static_cast<float>(load_cell_mass));
  load_cells_pub_->publish(std::move(load_cells));

  // Send io link sensors
  io_link_sensors->header.stamp = now;
  io_link_sensors_pub_->publish(std::move(io_link_sensors));

  // Send vehicle prox sensor
  vehicle_prox_sensor->header.stamp = now;
  vehicle_prox_sensor_pub_->publish(std::move(vehicle_prox_sensor));

  // The radar is always modeled as valid and clear
  auto radar = std::make_unique<RadarMsg>();
  radar->header.stamp = now;
  radar->valid = true;
  radar->tripped = false;
  radar_pub_->publish(std::move(radar));

  // Send Odp data
  auto observer = std::make_unique<OdpObserverMsg>();
  observer->header.stamp = now;
  observer_pub_->publish(std::move(observer));

  DoorsReportMsg patron_floor_doors_report {};
  for(const auto& doors_report : report_.doors_reports) {
    if(doors_report.floor == report_.insert_floor) {
      patron_floor_doors_report = doors_report;
      break;
    }
  }

  // If we are waiting for the patron to come and drive their vehicle away, assume the vehicle leaves
  // immediately after the patron door opens
  if(report_.state == report_.STATE_PROCESSING_RETRIEVE &&
      report_.internal_state == common::EnumInteger(bay::retrieve::State::AWAITING_VEHICLE_RETRIEVAL) &&
      patron_floor_doors_report.state == DoorsReportMsg::DOORS_PATRON_OPEN && tray_opt.has_value() &&
      tray_opt->payload.has_value()) {
    awaiting_payload_removal_ = true;
  }

  // Once Insert has been confirmed, add the payload to the system. We deliberately do NOT clear the inserting
  // payload here. The payload only lands in the snapshot a few ticks later (after the place-payload service
  // round-trip), and until it does the block above falls back to tray-only mass on the load cells. That mass
  // dip makes the bay's axle counter forget the parked vehicle, which then fails the VERIFYING_VEHICLE step.
  // So we keep simulating the inserting payload's mass and only release it below, once the snapshot confirms
  // the payload is on the tray.
  const bool insert_machine_running = report_.internal_state_string.rfind("Insert State:", 0) == 0;
  if(report_.state == report_.STATE_PROCESSING_INSERT && insert_machine_running &&
      GetInsertingPayload().has_value() && !pending_insert_payload_) {
    if(auto_confirm_insert_ &&
        report_.internal_state == static_cast<int>(bay::insert::State::VEHICLE_INSERTED)) {
      // Let the bay know that we are confirming insert. Pass through the patron's actual
      // dimensions from the scenario so the bay records the real per-payload height/length/
      // width (the bay's vehicle_estimator can only sense L/W and hardcodes height).
      auto set_payload_request = std::make_shared<SetPayloadInfoSrv::Request>();
      set_payload_request->payload_id = GetInsertingPayload().value().id;
      set_payload_request->ev_charge_requested = GetInsertingPayload().value().ev_charge_requested;
      set_payload_request->length_m = GetInsertingPayload().value().length_m;
      set_payload_request->width_m = GetInsertingPayload().value().width_m;
      set_payload_request->height_m = GetInsertingPayload().value().height_m;
      set_payload_request->mass = GetInsertingPayload().value().mass;
      volley::Call<SetPayloadInfoSrv::Response>(confirm_insert_cli_, set_payload_request, GetLogger());
      pending_insert_payload_ = true;
    }
    else if(!auto_confirm_insert_ && InsertConfirmedExternally(report_.internal_state)) {
      INFOS(GetLogger(), "Bay " << GetId() << " saw an external confirmation for payload "
                                << std::to_string(GetInsertingPayload().value().id));
      pending_insert_payload_ = true;
    }
  }

  // Release the inserting payload once the placed payload shows up in the snapshot. From here the
  // tray-payload branch above carries the load-cell mass, so the simulated vehicle never disappears.
  if(pending_insert_payload_ && tray_opt.has_value() && tray_opt->payload.has_value()) {
    ResetInsertingPayload();
    pending_insert_payload_ = false;
  }

  // Release the retrieving-payload flag once the payload leaves the garage snapshot. While the retrieve runs,
  // the snapshot still shows the payload on the tray, and we deliberately suppress its mass (tray-only) so
  // the bay sees the vehicle depart and completes the retrieve. Once the dispatcher drops the payload from
  // the snapshot, the flag has done its job. Then we must clear it so the NEXT payload registers on the load
  // cells (otherwise the tray-payload branch above stays gated off forever).
  if(awaiting_payload_removal_ && (!tray_opt.has_value() || !tray_opt->payload.has_value())) {
    awaiting_payload_removal_ = false;
  }

  // Auto-confirm the patron retrieve from the sim side. The bay only accepts confirm_retrieve after
  // StartRetrieve has constructed the internal retrieve state machine which happens when the bay-transition
  // state machine reaches DONE and the retrieve state machine enters AWAITING_PATRON. While the bay is in
  // PROCESSING_RETRIEVE but still running its pre-retrieve transition (close current-floor doors, move lift),
  // the retrieve state machine does not yet exist. See the "fake hidden state" comment at BayStateMachine
  // transition READY_TO_RETRIEVE -> PROCESSING_RETRIEVE.
  //
  // Gating on the report's internal_state INTEGER alone is not safe. When the transition state machine is
  // alive its enum int (CLOSING=0) collides with the retrieve state machine's enum int (AWAITING_PATRON=0).
  // The internal_state_string carries the discriminator, "Retrieve State: ..." vs "Transition State: ...",
  // so we use that. Pre-fix the call fired during the transition window and produced ~10 noisy ERROR lines
  // per retrieve cycle.
  const bool retrieve_machine_running = report_.internal_state_string.rfind("Retrieve State:", 0) == 0;
  if(report_.state == report_.STATE_PROCESSING_RETRIEVE && retrieve_machine_running &&
      !retrieve_confirm_sent_) {
    for(const auto& door_report : report_.doors_reports) {
      if(door_report.floor == report_.current_floor && door_report.state == DoorsReportMsg::DOORS_CLOSED) {
        auto request = std::make_shared<TriggerSrv::Request>();
        volley::Call<TriggerSrv::Response>(confirm_retrieve_cli_, request, GetLogger());
        retrieve_confirm_sent_ = true;
        break;
      }
    }
  }

  // Reset once the bay leaves PROCESSING_RETRIEVE, so the next retrieve cycle can track confirm set
  if(retrieve_confirm_sent_ && report_.state != report_.STATE_PROCESSING_RETRIEVE) {
    retrieve_confirm_sent_ = false;
  }

  // Set the true door states
  BayStateMsg bay_state {};
  bay_state.id = GetId();
  // TODO(Gunther): Get full door information from the doors reports so we don't rely
  // on the doors interface to tell us where the doors are.
  bay_state.system_doors_closed = report_.state != report_.STATE_READY_TO_RETRIEVE;
  bay_state.patron_light_state = GetPatronLight();
  SetState(bay_state);
}

BayDoors BaySim::GetDoors() const {
  // TODO(Gunther): These need to be made generic for the new bay state machine doors
  BayDoors doors;
  doors[bay::doors::Door::PATRON] = common::EnumCast<bay::open_close::DoorState>(state_.patron_door_state)
                                        .value_or(bay::open_close::DoorState::ERROR);
  doors[bay::doors::Door::OVERDRIVE_LEFT] =
      common::EnumCast<bay::open_close::DoorState>(state_.overdrive_left_state)
          .value_or(bay::open_close::DoorState::ERROR);
  doors[bay::doors::Door::OVERDRIVE_RIGHT] =
      common::EnumCast<bay::open_close::DoorState>(state_.overdrive_right_state)
          .value_or(bay::open_close::DoorState::ERROR);
  doors[bay::doors::Door::SYSTEM] = common::EnumCast<bay::open_close::DoorState>(state_.system_door_state)
                                        .value_or(bay::open_close::DoorState::ERROR);
  return doors;
}

bool BaySim::SetInsertingPayload(const std::optional<PayloadMsg>& payload) {
  // Accept a waiting payload only if the bay is ready to insert and there isn't already a payload
  // inserting.
  auto report = GetReport();
  if(!payload.has_value() || report.state != report.STATE_READY_TO_INSERT || inserting_payload_.has_value()) {
    return false;
  }

  inserting_payload_ = payload;

  GarageEventMsg event {};
  event.type = GarageEventMsg::EVENT_BAY_ENQUEUE;
  event.payload_id = std::to_string(payload->id);
  event.bay_id = bay_id_;
  volley::PrintEvent(logger_, event);

  return true;
}

}  // namespace volley::sim
</file>

