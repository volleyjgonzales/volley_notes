namespace volley::sim {

//! @brief Thin component wrapper that loads the scenario and creates a Simulator that runs the simulation
class SimulatorComponent : public volley::Component {
public:
  explicit SimulatorComponent(const rclcpp::NodeOptions& options) {
    const auto node = std::make_shared<volley::Node>("simulator", "sim", options);
    SetNode(node);

    const auto scenario_file = volley::RequiredParam<std::string>(*node, "simulator.scenario");
    auto [events, initial_conditions, layout] = ParseScenarioFile(scenario_file);

    simulator_ =
        std::make_unique<Simulator>(node, layout, std::move(initial_conditions), ScenarioRunner(events));
  }

private:
  std::unique_ptr<Simulator> simulator_;
};

}  // namespace volley::sim

