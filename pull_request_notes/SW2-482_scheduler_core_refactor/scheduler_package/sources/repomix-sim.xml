#pragma once

#include <common_ros/layout.hpp>
#include <common_ros/node.hpp>
#include <map>
#include <memory>
#include <unordered_map>

#include "sim/collision_detector.hpp"
#include "sim/patrons.hpp"
#include "sim/scenario_runner.hpp"
#include "sim/sim_clients.hpp"
#include "sim/sim_msgs.hpp"

namespace volley::sim {

//! @brief A class that manages the simulation based on a provided scenario file. This class also manages
//! "events" that get sent to the dispatcher to create jobs as well as a collision detector to validate all
//! simulated entities do not collide.
class Simulator {
public:
  Simulator(
      NodeSPtr node, LayoutSPtr layout, InitialConditions initial_conditions, ScenarioRunner scenario_runner);

private:
  //! @brief Update the simulation based on the time provided by @c now by handling active events and updating
  //! the collision detector
  void Update(const rclcpp::Time& now);

  //! @brief Pop events whose time is at or before @c now and "handle" each event by requesting the
  //! corresponding service from the dispatcher
  void HandleEvents(const rclcpp::Time& now);

  //! @brief Register the collision bodies that never move and never appear in a snapshot (chargers,
  //! obstructions)
  //! @note Dynamic bodies (AGVs, trays, etc) are added/updated using the snapshot in @c RunCollisionCheck
  void RegisterStaticCollisionBodies();

  //! @brief Update collision volumes from the latest snapshot and fault if anything in the garage collides
  void RunCollisionCheck();

  //! @brief Updates the body's collision volume if the body is already tracked by the collision detector,
  //! otherwise register the body with the collision detector for the first time
  void UpsertCollisionBody(const BodyIdentifier& iden, const OrientedBoundingBox3D& volume);

  //! @brief Returns whether the two collision bodies @c a and @c b represent an AGV carrying a tray and thus
  //! should not be treated as a collision
  bool IsCarriedTrayCollision(const BodyIdentifier& a, const BodyIdentifier& b,
      const std::unordered_map<unsigned int, GeometricPoseMsg>& agv_pose_by_id,
      const std::unordered_map<unsigned int, GeometricPoseMsg>& tray_pose_by_id) const;

  //! @brief Offer the front of the patron insert queue to each simulated bay. A bay will accept the payload
  //! only when it is @c READY_TO_INSERT so we can offer blindly to all bays and pop from the patron queue
  //! once a bay accepts the payload.
  void OfferWaitingPayloadsToBays();

  //! @brief Publish the @c SimReport for the current time @c now
  void PublishReport(const rclcpp::Time& now);

  //! @brief Returns whether the dispatcher state is valid and also stopped
  //! @note This is used to determine when we can start sending event jobs to the dispatcher
  bool IsDispatchStopped(const rclcpp::Time& now) const;

  NodeSPtr node_;
  LayoutSPtr layout_;

  CollisionDetector collision_detector_;
  Patrons patrons_;
  ScenarioRunner scenario_runner_;
  InitialConditions initial_conditions_;

  std::unique_ptr<SimClients> sim_clients_;

  GarageSnapshotMsg::ConstSharedPtr snapshot_;
  DispatchReportMsg::ConstSharedPtr dispatch_report_;

  // The set of payload collision body IDs from the previous snapshot that are being tracked by the collision
  // detector. This is used to remove payloads in the case where a previously tracked payload does not appear
  // in the current snapshot.
  std::set<BodyIdentifier> tracked_payloads_;

  // The scenario clock starts once dispatch reaches a stable stopped/consistent state
  bool running_ = false;
  rclcpp::Time start_time_ {0, 0, RCL_ROS_TIME};

  rclcpp::Publisher<SimReportMsg>::SharedPtr report_pub_;
  rclcpp::Subscription<GarageSnapshotMsg>::SharedPtr snapshot_sub_;
  rclcpp::Subscription<DispatchReportMsg>::SharedPtr dispatch_sub_;
  rclcpp::Service<SimEventSrv>::SharedPtr event_srv_;
  rclcpp::TimerBase::SharedPtr update_timer_;

  // Per-bay "offer inserting payload" clients (one per bay-like node in the layout). On a separate
  // callback group so the blocking offer calls can complete while the update callback waits.
  rclcpp::CallbackGroup::SharedPtr bay_offer_cb_group_;
  std::map<unsigned int, rclcpp::Client<PlacePayloadInBaySrv>::SharedPtr> bay_offer_clients_;
};

}  // namespace volley::sim
</file>

