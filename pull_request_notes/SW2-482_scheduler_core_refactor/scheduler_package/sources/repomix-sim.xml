<file path="src/scenario_runner.cpp">
#include "sim/scenario_runner.hpp"

#include <yaml-cpp/yaml.h>

#include <algorithm>
#include <common/enum.hpp>
#include <common_ros/layout.hpp>
#include <common_ros/ros_utils.hpp>

namespace {
// Default Payload constants
constexpr float kDefaultPayloadMassKg = 1800.0;
constexpr float kDefaultPayloadLengthM = 4.5;
constexpr float kDefaultPayloadWidthM = 2.0;
constexpr float kDefaultPayloadHeightM = 1.4;
}  // namespace

// Helper YAML function for decoding a garage pose message
namespace YAML {  // NOLINT(readability-identifier-naming)
template <>
// NOLINTNEXTLINE(readability-identifier-naming)
struct convert<GaragePoseMsg> {
  // NOLINTNEXTLINE(readability-identifier-naming,google-runtime-references)
  static bool decode(const Node& node, GaragePoseMsg& rhs) {
    if(!node.IsMap() || !node["node_id"] || !node["heading"]) {
      return false;
    }

    rhs.node_id = node["node_id"].as<uint32_t>();
    rhs.heading = node["heading"].as<int16_t>();
    return true;
  }
};
}  // namespace YAML

namespace volley::sim {

template <typename T>
T GetValue(const YAML::Node& node, const std::string& key, const T& default_value = T {}) {
  if(node[key].IsDefined()) {
    return node[key].as<T>();
  }
  return default_value;
}

Event YamlToEvent(const YAML::Node& node) {
  // Note: we intentionally do not check if each expected entry exists in the YAML file. If a
  // required field does not exist, we'll throw an exception in here and the
  // scenario will not start.

  auto type = common::EnumCastCaseInsensitive<Event::Type>(node["type"].as<std::string>()).value();
  auto time = node["time"].as<double>();

  Event event(type, time);

  switch(event.type) {
  case Event::Type::MOVE_AGV:
    event.resource_id = node["agv_id"].as<unsigned int>();
    event.garage_pose = node["pose"].as<GaragePoseMsg>();
    break;
  case Event::Type::MOVE_TRAY:
    event.resource_id = node["tray_id"].as<unsigned int>();
    event.garage_pose = node["pose"].as<GaragePoseMsg>();
    break;
  case Event::Type::REMOVE_AGV:
    event.resource_id = node["agv_id"].as<unsigned int>();
    break;
  case Event::Type::SET_AGV_BATTERY_FRACTION:
    event.resource_id = node["agv_id"].as<unsigned int>();
    event.float_value = node["battery_fraction"].as<float>();
    break;
  case Event::Type::SET_NODE_DISABLEDNESS:
    event.resource_id = node["node_id"].as<unsigned int>();
    event.bool_value = node["disable"].as<bool>();
    break;
  case Event::Type::SET_TRAY_DISABLEDNESS:
    event.resource_id = node["tray_id"].as<unsigned int>();
    event.bool_value = node["disable"].as<bool>();
    break;
  case Event::Type::SET_DISPATCH_MODE:
    event.uint_value = node["mode"].as<unsigned int>();
    break;
  case Event::Type::SET_AUTO_PLANNER:
    event.bool_value = node["enabled"].as<bool>();
  case Event::Type::START_DISPATCH:
  case Event::Type::STOP_DISPATCH:
  case Event::Type::PAUSE_DISPATCH:
  case Event::Type::CALL_PLANNER:
    // No parameters
    break;
  case Event::Type::PATRON_ARRIVAL:
    event.payload.id = volley::ParseGuid(node["payload_id"].as<std::string>()).value();
    event.payload.length_m = GetValue<float>(node, "length_m", kDefaultPayloadLengthM);
    event.payload.width_m = GetValue<float>(node, "width_m", kDefaultPayloadWidthM);
    event.payload.height_m = GetValue<float>(node, "height_m", kDefaultPayloadHeightM);
    event.payload.mass = GetValue<float>(node, "mass", kDefaultPayloadMassKg);
    event.payload.ev_charge_requested = GetValue<bool>(node, "ev_charge_requested", false);
    break;
  case Event::Type::REPARK_TRAY:
    event.resource_id = node["tray_id"].as<unsigned int>();
    event.garage_pose = node["pose"].as<GaragePoseMsg>();
    event.bool_value = GetValue<bool>(node, "allow_reciprocal", false);
    break;
  case Event::Type::RETRIEVE_REQUEST:
  case Event::Type::CHARGE_PAYLOAD:
    event.payload.id = volley::ParseGuid(node["payload_id"].as<std::string>()).value();
    break;
  case Event::Type::SET_BAY_READINESS_RATIO:
    event.float_value = node["bay_readiness_ratio"].as<float>();
    break;
  case Event::Type::TRANSITION_BAY_TO_INSERT:
  case Event::Type::TRANSITION_BAY_TO_RETRIEVE:
    event.resource_id = node["bay_id"].as<unsigned int>();
    break;
  }

  return event;
}

std::tuple<std::vector<Event>, InitialConditions, LayoutSPtr> ParseScenarioFile(
    const std::string& scenario_file) {
  // Note: we intentionally do not check if each expected entry exists in the YAML file. If a
  // required field does not exist, we'll throw an exception in here and the
  // scenario will not start.

  // Read the YAML scenario file
  YAML::Node scenario = YAML::LoadFile(scenario_file);

  // Load the layout
  const auto layout_name = scenario["layout"].as<std::string>();
  const auto layout_filepath_or = GetLayoutPathByName(layout_name);
  if(!layout_filepath_or.has_value()) {
    throw std::runtime_error(layout_filepath_or.error());
  }
  const auto& layout_filepath = layout_filepath_or.value();

  LayoutSPtr layout = std::make_shared<volley::Layout>(layout_filepath);

  // Load the initial conditions. These are either specified directly in the scenario file, or as
  // a separate file to be loaded.
  auto initial_conditions_yaml = scenario["initial_conditions"];
  if(initial_conditions_yaml.IsScalar()) {
    const auto initial_conditions_name = initial_conditions_yaml.as<std::string>();
    const auto initial_conditions_path_or = GetLayoutPathByName(initial_conditions_name);
    if(!initial_conditions_path_or.has_value()) {
      throw std::runtime_error(initial_conditions_path_or.error());
    }
    initial_conditions_yaml = YAML::LoadFile(initial_conditions_path_or.value());
  }

  InitialConditions initial_conditions;
  for(const auto& tray : initial_conditions_yaml["trays"]) {
    AddTraySrv::Request tray_request {};
    tray_request.id = tray["id"].as<uint16_t>();
    tray_request.agv_id = GetValue<uint16_t>(tray, "agv_id");
    tray_request.reciprocal_to_agv = GetValue<bool>(tray, "reciprocal_to_agv");
    tray_request.garage_pose = GetValue<GaragePoseMsg>(tray, "garage_pose");
    tray_request.disabled = GetValue<bool>(tray, "disabled");
    if(tray["payload"]) {
      auto payload = tray["payload"];
      AddPayloadSrv::Request payload_request {};
      payload_request.payload.id = volley::ParseGuid(payload["id"].as<std::string>()).value();
      payload_request.payload.length_m = GetValue<float>(payload, "length_m", kDefaultPayloadLengthM);
      payload_request.payload.width_m = GetValue<float>(payload, "width_m", kDefaultPayloadWidthM);
      payload_request.payload.height_m = GetValue<float>(payload, "height_m", kDefaultPayloadHeightM);
      payload_request.payload.mass = GetValue<float>(payload, "mass", kDefaultPayloadMassKg);
      payload_request.tray_id = tray_request.id;
      payload_request.reciprocal_to_tray = GetValue<bool>(payload, "reciprocal_to_tray", false);
      initial_conditions.payloads.emplace_back(std::move(payload_request));
    }
    initial_conditions.trays.emplace_back(std::move(tray_request));
  }

  for(const auto& agv : initial_conditions_yaml["agvs"]) {
    AddAgvSrv::Request agv_request {};
    agv_request.id = agv["id"].as<uint16_t>();
    agv_request.garage_pose = GetValue<GaragePoseMsg>(agv, "garage_pose");
    agv_request.lift_fraction = GetValue<float>(agv, "lift_fraction", 0.0f);
    agv_request.battery_fraction = GetValue<float>(agv, "battery_fraction", 1.0f);
    initial_conditions.agvs.emplace_back(std::move(agv_request));
  }

  // Load scenario specific obstructions, such as poles or new non-garage elements
  // to the collision detector.
  for(const auto& obstruction : initial_conditions_yaml["obstructions"]) {
    OrientedBoundingBox3D bb3D {};  // NOLINT(readability-identifier-naming)
    auto& bb = bb3D.box;
    auto obstruct_id = obstruction["id"].as<uint16_t>();

    bb.x = obstruction["x_loc"].as<double>();
    bb.y = obstruction["y_loc"].as<double>();
    bb.yaw = obstruction["yaw"].as<double>();
    bb.half_x_len = obstruction["x_len"].as<double>() / 2;
    bb.half_y_len = obstruction["y_len"].as<double>() / 2;
    // Default z is from floor (0.0) to max parking window height + tray height.
    bb3D.z_lo = GetValue<double>(obstruction, "z_loc", 0.0);
    bb3D.z_hi = bb3D.z_lo + GetValue<double>(obstruction, "z_len", kHeightDefault + kTrayHeight);
    initial_conditions.obstructions.emplace_back(std::make_pair(obstruct_id, std::move(bb3D)));
  }

  std::vector<Event> events;

  for(const auto&& event : scenario["events"]) {
    events.emplace_back(YamlToEvent(event));
  }

  return {events, initial_conditions, layout};
}

ScenarioRunner::ScenarioRunner(const std::vector<Event>& events) {
  for(const auto& event : events) {
    events_.push(event);
  }
}

std::vector<Event> ScenarioRunner::GetNextEvents(double seconds_since_start) {
  std::vector<Event> events;
  while(!events_.empty() && events_.top().time <= seconds_since_start) {
    events.push_back(events_.top());
    events_.pop();
  }
  return events;
}

}  // namespace volley::sim
</file>

