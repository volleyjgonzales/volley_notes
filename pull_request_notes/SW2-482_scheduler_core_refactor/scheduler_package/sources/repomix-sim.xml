<file path="src/simulator.cpp">
#include "sim/simulator.hpp"

#include <chrono>
#include <cmath>
#include <common/topics_agv.hpp>
#include <common/topics_central.hpp>
#include <common/topics_sim.hpp>
#include <common_ros/print_utils.hpp>
#include <common_ros/ros_utils.hpp>
#include <rclcpp/create_timer.hpp>
#include <rclcppx/interface_factories.hpp>
#include <sstream>
#include <utility>

#include "sim/collision_detector.hpp"
#include "sim/oriented_bounding_box.hpp"
#include "sim/sim_clients.hpp"
#include "sim/tray.hpp"

namespace volley::sim {
using namespace std::chrono_literals;

// How often the simulator updates (in simulated time)
constexpr auto kUpdatePeriod = 50ms;

// A tray carried by an AGV is kept co-located with it by the tracker, so an AGV/tray pair within this
// distance is treated as "carried" rather than a collision.
constexpr double kCarriedTrayXyToleranceM = 0.15;

Simulator::Simulator(
    NodeSPtr node, LayoutSPtr layout, InitialConditions initial_conditions, ScenarioRunner scenario_runner) :
    node_(std::move(node)),
    layout_(std::move(layout)),
    patrons_(node_->get_logger()),
    scenario_runner_(std::move(scenario_runner)),
    initial_conditions_(std::move(initial_conditions)) {
  sim_clients_ = std::make_unique<SimClients>(node_);

  report_pub_ = node_->create_publisher<SimReportMsg>(volley::TopicSimReport().Name(), 1);

  snapshot_sub_ =
      node_->create_subscription<GarageSnapshotMsg>("/central/" + volley::TopicGarageSnapshot().Name(),
          volley::GetBestEffortQoS(1), [this](GarageSnapshotMsg::ConstSharedPtr msg) { snapshot_ = msg; });

  dispatch_sub_ = node_->create_subscription<DispatchReportMsg>(
      "/central/" + volley::TopicCentralReport().Name(), volley::GetBestEffortQoS(1),
      [this](DispatchReportMsg::ConstSharedPtr msg) { dispatch_report_ = msg; });

  // Lets external tools / tests enqueue scenario events at runtime.
  event_srv_ = rclcppx::CreateService<SimEventSrv>(node_, "/sim/enqueue_garage_event",
      [this](const SimEventSrv::Request::SharedPtr req, SimEventSrv::Response::SharedPtr resp) {
        try {
          scenario_runner_.AddEvent(Event(req));
        }
        catch(const std::runtime_error& e) {
          resp->success = false;
          resp->message = e.what();
          return;
        }
        resp->success = true;
      });

  // One "offer inserting payload" client per bay-like node, on a dedicated callback group so the blocking
  // offer calls in OfferWaitingPayloadsToBays() can complete while the tick waits.
  bay_offer_cb_group_ = node_->create_callback_group(rclcpp::CallbackGroupType::MutuallyExclusive);
  for(const auto& bay_id : layout_->GetBayLikeNodeIds()) {
    bay_offer_clients_[bay_id] = node_->create_client<PlacePayloadInBaySrv>(
        "/bay/b" + std::to_string(bay_id) + "/sim_offer_inserting_payload", rclcpp::ServicesQoS(),
        bay_offer_cb_group_);
  }

  RegisterStaticCollisionBodies();

  update_timer_ =
      rclcpp::create_timer(node_, node_->get_clock(), kUpdatePeriod, [this]() { Update(node_->now()); });

  INFOS(node_->get_logger(), "Simulator initialized with "
                                 << initial_conditions_.trays.size() << " trays, "
                                 << initial_conditions_.payloads.size() << " payloads, "
                                 << scenario_runner_.GetNumRemainingEvents() << " scenario events.");
}

void Simulator::Update(const rclcpp::Time& now) {
  // Seed the garage tracker with the initial AGVs/trays/payloads. This uses blocking service calls, so it may
  // take a few ticks until central's services are up, so retry until it succeeds.
  if(!initial_conditions_.IsEmpty()) {
    if(sim_clients_->ProcessInitialConditions(initial_conditions_)) {
      initial_conditions_.Clear();
    }
    else {
      return;
    }
  }

  if(running_) {
    HandleEvents(now);
    OfferWaitingPayloadsToBays();
  }

  RunCollisionCheck();
  PublishReport(now);

  // Start the scenario clock once dispatch settles into a stopped, consistent state, so event times are
  // measured from a well-defined zero.
  if(!running_ && IsDispatchStopped(now)) {
    running_ = true;
    start_time_ = now;
    INFOS(node_->get_logger(), "Simulator running; scenario clock started.");
  }
}

void Simulator::HandleEvents(const rclcpp::Time& now) {
  auto events = scenario_runner_.GetNextEvents((now - start_time_).seconds());
  while(!events.empty()) {
    Event event = events.back();
    events.pop_back();
    switch(event.type) {
    case Event::Type::MOVE_AGV:
      sim_clients_->MoveAgv(event.resource_id, event.garage_pose, now);
      break;
    case Event::Type::MOVE_TRAY:
      sim_clients_->MoveTray(event.resource_id, event.garage_pose, now);
      break;
    case Event::Type::REMOVE_AGV:
      sim_clients_->RemoveAgv(event.resource_id);
      collision_detector_.RemoveBody(AgvIdentifier(event.resource_id));
      break;
    case Event::Type::SET_AGV_BATTERY_FRACTION: {
      ERRORS(node_->get_logger(), "set_agv_battery_fraction event is not implemented");
      break;
    }
    case Event::Type::SET_NODE_DISABLEDNESS:
      sim_clients_->SetNodeDisabledness(event.resource_id, event.bool_value);
      break;
    case Event::Type::SET_TRAY_DISABLEDNESS:
      sim_clients_->SetTrayDisabledness(event.resource_id, event.bool_value);
      break;
    case Event::Type::SET_DISPATCH_MODE:
      sim_clients_->SetMode(event.uint_value);
      break;
    case Event::Type::START_DISPATCH:
      sim_clients_->Start(now);
      break;
    case Event::Type::STOP_DISPATCH:
      sim_clients_->Stop();
      break;
    case Event::Type::PAUSE_DISPATCH:
      sim_clients_->Pause();
      break;
    case Event::Type::PATRON_ARRIVAL:
      patrons_.EnterInsertQueueCallback(event.payload);
      break;
    case Event::Type::REPARK_TRAY:
      sim_clients_->ReparkTray(event.resource_id, event.garage_pose, event.bool_value, now);
      break;
    case Event::Type::RETRIEVE_REQUEST:
      sim_clients_->Retrieve(event.payload.id, now);
      break;
    case Event::Type::SET_BAY_READINESS_RATIO:
      sim_clients_->SetBayReadinessRatio(event.float_value);
      break;
    case Event::Type::SET_AUTO_PLANNER:
      sim_clients_->SetAutoPlanner(event.bool_value);
      break;
    case Event::Type::CALL_PLANNER:
      sim_clients_->CallPlanner(now);
      break;
    case Event::Type::TRANSITION_BAY_TO_INSERT:
      sim_clients_->TransitionBayToInsert(event.resource_id, now);
      break;
    case Event::Type::TRANSITION_BAY_TO_RETRIEVE:
      sim_clients_->TransitionBayToRetrieve(event.resource_id, now);
      break;
    case Event::Type::CHARGE_PAYLOAD:
      sim_clients_->ChargePayload(event.payload.id, now);
      break;
    }
  }
}

void Simulator::OfferWaitingPayloadsToBays() {
  for(const auto& [bay_id, client] : bay_offer_clients_) {
    if(patrons_.GetNumWaitingPatrons() == 0) {
      break;
    }
    const auto payload = patrons_.GetWaitingPayload();
    if(!payload.has_value() || !client->service_is_ready()) {
      continue;
    }
    auto request = std::make_shared<PlacePayloadInBaySrv::Request>();
    request->payload = payload.value();
    request->bay_id = bay_id;
    // A sim bay will only accept a "payload offer" if it is READY_TO_INSERT. Once a bay accepts the payload,
    // pop the patron off the queue.
    const auto response = volley::Call<PlacePayloadInBaySrv::Response>(client, request, node_->get_logger());
    if(response.has_value() && response.value()->success) {
      patrons_.PopWaitingPayload();
    }
  }
}

void Simulator::RegisterStaticCollisionBodies() {
  for(const auto& charger_id : layout_->GetNodeIdsOfType(GarageNodeMsg::TYPE_AGV_CHARGE)) {
    const auto charge_node = layout_->GetNodeById(charger_id);
    if(!charge_node.has_value()) {
      continue;
    }
    const float floor_z = layout_->GetFloorZForNodeId(charger_id).value_or(0);
    collision_detector_.AddBody(
        ChargerIdentifier(charger_id), MakeBoundingBoxForCharger(charge_node.value(), floor_z));
  }

  for(const auto& [id, body] : initial_conditions_.obstructions) {
    collision_detector_.AddBody(ObstructionIdentifier(id), body);
  }
}

void Simulator::UpsertCollisionBody(const BodyIdentifier& iden, const OrientedBoundingBox3D& volume) {
  if(collision_detector_.GetVolume(iden).has_value()) {
    collision_detector_.SetVolume(iden, volume);
  }
  else {
    collision_detector_.AddBody(iden, volume);
  }
}

bool Simulator::IsCarriedTrayCollision(const BodyIdentifier& a, const BodyIdentifier& b,
    const std::unordered_map<unsigned int, GeometricPoseMsg>& agv_pose_by_id,
    const std::unordered_map<unsigned int, GeometricPoseMsg>& tray_pose_by_id) const {
  const BodyIdentifier* agv = nullptr;
  const BodyIdentifier* tray = nullptr;
  if(a.type == BodyType::AGV && b.type == BodyType::TRAY) {
    agv = &a;
    tray = &b;
  }
  else if(a.type == BodyType::TRAY && b.type == BodyType::AGV) {
    agv = &b;
    tray = &a;
  }
  else {
    return false;
  }

  const auto agv_it = agv_pose_by_id.find(agv->id);
  const auto tray_it = tray_pose_by_id.find(tray->id);
  if(agv_it == agv_pose_by_id.end() || tray_it == tray_pose_by_id.end()) {
    return false;
  }
  return std::abs(agv_it->second.x - tray_it->second.x) < kCarriedTrayXyToleranceM &&
         std::abs(agv_it->second.y - tray_it->second.y) < kCarriedTrayXyToleranceM;
}

void Simulator::RunCollisionCheck() {
  if(!snapshot_) {
    return;
  }

  // Update (or first-register) the volume of every dynamic body from the snapshot, recording AGV/tray poses
  // so we can exempt an AGV from colliding with the tray it is carrying.
  std::unordered_map<unsigned int, GeometricPoseMsg> agv_pose_by_id;
  for(const auto& agv : snapshot_->agvs) {
    const float floor_z = layout_->GetFloorZForNodeId(agv.state.garage_pose.node_id).value_or(0);
    UpsertCollisionBody(AgvIdentifier(agv.agv_id), MakeBoundingBoxForAGV(agv.state, floor_z));
    agv_pose_by_id.emplace(agv.agv_id, agv.state.geometric_pose);
  }

  // The payload body is keyed by its tray id (see PayloadIdentifier), so map payload GUID -> tray to recover
  // the tray id when iterating payloads below.
  std::unordered_map<GuidMsg, GarageTrayMsg> payload_guid_to_tray;
  std::unordered_map<unsigned int, GeometricPoseMsg> tray_pose_by_id;
  for(const auto& tray : snapshot_->trays) {
    const float floor_z = layout_->GetFloorZForNodeId(tray.pose.node_id).value_or(0);
    UpsertCollisionBody(TrayIdentifier(tray.id), MakeBoundingBoxForTray(tray.geometric_pose, floor_z));
    tray_pose_by_id.emplace(tray.id, tray.geometric_pose);
    if(tray.payload_id != volley::kEmptyGuid) {
      payload_guid_to_tray[tray.payload_id] = tray;
    }
  }

  // Create a copy of the tracked_payloads_ and remove new payloads from this snapshot in order to get a set
  // of payloads that are no longer in the garage (in order to remove payloads from the collision detector).
  std::set<BodyIdentifier> payloads_to_remove = tracked_payloads_;
  tracked_payloads_.clear();
  for(const auto& payload : snapshot_->payloads) {
    if(!payload_guid_to_tray.contains(payload.payload.id)) {
      continue;
    }
    const GarageTrayMsg& garage_tray = payload_guid_to_tray[payload.payload.id];
    Tray tray {};
    tray.geometric_pose = garage_tray.geometric_pose;
    tray.reciprocal_to_payload = garage_tray.reciprocal_to_payload;
    const float floor_z = layout_->GetFloorZForNodeId(payload.pose.node_id).value_or(0);
    const BodyIdentifier payload_body_id = PayloadIdentifier(garage_tray.id);
    UpsertCollisionBody(
        payload_body_id, MakeBoundingBoxForPayload(GetPayloadPose(tray), payload.payload, floor_z));

    tracked_payloads_.insert(payload_body_id);
    payloads_to_remove.erase(payload_body_id);
  }

  // Remove payloads that are no longer in the garage
  for(const auto& body_id : payloads_to_remove) {
    collision_detector_.RemoveBody(body_id);
  }

  for(const auto& bay_state : snapshot_->bays) {
    const auto bay_node = layout_->GetNodeById(bay_state.id);
    if(!bay_node.has_value()) {
      continue;
    }
    const bool system_open = !bay_state.system_doors_closed;
    const float floor_z = layout_->GetFloorZForNodeId(bay_state.id).value_or(0);
    UpsertCollisionBody(
        BayIdentifier(bay_state.id), MakeBoundingBoxForBay(bay_node.value(), system_open, floor_z));
  }

  std::string collision_msg;
  for(const auto& [iden_a, iden_b] : collision_detector_.FindCollisions()) {
    if(IsCarriedTrayCollision(iden_a, iden_b, agv_pose_by_id, tray_pose_by_id)) {
      continue;
    }
    std::ostringstream stream;
    stream << "Collision: " << iden_a << " collided with " << iden_b << "!\n";
    collision_msg += stream.str();
  }

  if(!collision_msg.empty()) {
    RCLCPP_FATAL_STREAM(node_->get_logger(), collision_msg);
    // TODO(SW2-306): tear the stack down cleanly instead of killing the process.
    rclcpp::shutdown();
  }
}

void Simulator::PublishReport(const rclcpp::Time& now) {
  auto report = std::make_unique<SimReportMsg>();
  report->header.stamp = now;
  report->num_remaining_events = scenario_runner_.GetNumRemainingEvents();
  report->running = running_;
  report->payloads = patrons_.GetInsertQueue();
  report_pub_->publish(std::move(report));
}

bool Simulator::IsDispatchStopped(const rclcpp::Time&) const {
  return dispatch_report_ && dispatch_report_->status == dispatch_report_->STATUS_STOPPED &&
         dispatch_report_->consistent;
}

}  // namespace volley::sim
