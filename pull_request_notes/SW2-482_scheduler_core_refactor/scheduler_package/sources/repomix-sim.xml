<file path="src/sim_clock_ros.cpp">
#include "sim/sim_clock_ros.hpp"

#include <chrono>
#include <limits>
#include <memory>
#include <rclcpp/clock.hpp>
#include <rclcpp/create_timer.hpp>
#include <rclcppx/parameter.hpp>
#include <utility>
#include <vector>

namespace volley::sim {

using namespace std::chrono_literals;

namespace {

using FractionalMilliseconds = std::chrono::duration<double, std::milli>;

constexpr FractionalMilliseconds kDefaultPublishPeriod = 5.0ms;
constexpr auto kDefaultStartTime = 0ns;

constexpr auto kRealTimeFactorParam = "real_time_factor";

}  // namespace

SimClockRos::SimClockRos(rclcpp::Node::SharedPtr node) : node_(std::move(node)) {
  // Directly use declare_parameter so the parameter can be updated
  rclcppx::ParameterDescriptor real_time_factor_desc;
  real_time_factor_desc.description = "Simulated time per wall time, 0 pauses the sim";
  real_time_factor_desc.floating_point_range.resize(1);
  real_time_factor_desc.floating_point_range[0].from_value = 0.0;
  real_time_factor_desc.floating_point_range[0].to_value = std::numeric_limits<double>::max();
  real_time_factor_ = node_->declare_parameter(kRealTimeFactorParam, 1.0, real_time_factor_desc);

  publish_period_ = FractionalMilliseconds(
      rclcppx::DeclareOptionalParameter(node_, "clock_publish_period_ms", kDefaultPublishPeriod.count()));

  // Absolute "/clock" so it lands on the global topic, not under the node's namespace
  clock_pub_ = node_->create_publisher<rosgraph_msgs::msg::Clock>("/clock", rclcpp::ClockQoS());

  sim_time_ = rclcpp::Time(
      rclcppx::DeclareOptionalParameter(node_, "start_time_ns", kDefaultStartTime.count()), RCL_ROS_TIME);

  // Set a callback that fires when the real time factor parameter is changed at runtime
  param_cb_ = node_->add_post_set_parameters_callback([this](const std::vector<rclcpp::Parameter>& params) {
    for(const auto& p : params) {
      if(p.get_name() == kRealTimeFactorParam) {
        real_time_factor_ = p.as_double();
      }
    }
  });

  // Create a timer to publish time
  // Note that this timer must use wall time (steady time) as it should run at a fixed, steady interval
  // independent of sim time
  timer_ = rclcpp::create_timer(
      node_, std::make_shared<rclcpp::Clock>(RCL_STEADY_TIME), publish_period_, [this]() { Tick(); });
}

void SimClockRos::Tick() {
  sim_time_ += rclcpp::Duration(publish_period_ * real_time_factor_.load());
  Publish();
}

void SimClockRos::Publish() {
  auto msg = std::make_unique<rosgraph_msgs::msg::Clock>();
  msg->clock = sim_time_;
  clock_pub_->publish(std::move(msg));
}

}  // namespace volley::sim
</file>

