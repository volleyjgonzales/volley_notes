#! /bin/bash
# shellcheck source=/dev/null
# shellcheck disable=SC2154
. "/opt/ros/${ROS_DISTRO}/setup.bash"

# Suppress warnings for the colcon install setup script, which only exists after the workspace is built.
# shellcheck source=/dev/null
. "$(dirname "$0")/../../../../install/setup.bash"

# 75 is the simulation domain ID default if not set
export ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-75}

# Generate a new UUID and convert it to a byte array
uuid=$(uuidgen)
