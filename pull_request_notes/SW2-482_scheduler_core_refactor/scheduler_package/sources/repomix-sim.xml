bool SimClients::ProcessInitialConditions(const InitialConditions& initial_conditions) {
  // Make sure all services are available before calling anything
  bool all_services_available = add_agv_cli_->service_is_ready() && add_tray_cli_->service_is_ready() &&
                                add_payload_cli_->service_is_ready();
  if(!all_services_available) {
    return false;
  }

  for(const auto& agv_request : initial_conditions.agvs) {
    auto request = std::make_shared<SetUInt16Srv::Request>();
    request->value = agv_request.id;

    auto response_opt = volley::Call<SetUInt16Srv::Response>(add_agv_cli_, request, logger_);
    if(!response_opt.has_value() || !response_opt.value()->success) {
      throw std::runtime_error("Failed to add AGV to the tracker");
    }
  }
  for(const auto& tray_request : initial_conditions.trays) {
    auto request = std::make_shared<AddTraySrv::Request>(tray_request);
    auto response_opt = volley::Call<AddTraySrv::Response>(add_tray_cli_, request, logger_);
    if(!response_opt.has_value() || !response_opt.value()->success) {
      throw std::runtime_error("Failed to add Tray to the tracker");
    }
  }
  for(const auto& payload_request : initial_conditions.payloads) {
    auto request = std::make_shared<AddPayloadSrv::Request>(payload_request);
    auto response_opt = volley::Call<AddPayloadSrv::Response>(add_payload_cli_, request, logger_);
    if(!response_opt.has_value() || !response_opt.value()->success) {
      throw std::runtime_error("Failed to add Payload to the tracker");
    }
  }

  return true;
}

